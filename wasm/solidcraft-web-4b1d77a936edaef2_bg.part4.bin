ui.agent_chat_ctx_elements":"Elementi","ui.agent_chat_ctx_features":"Značajke","ui.agent_chat_ctx_more":"+još {n}","ui.agent_chat_ctx_other":"Ostalo","ui.agent_chat_custom_hint":"Bilo koji program koji govori Agent Client Protocol na stdin i stdout. Ne pokreće ga nikakva ljuska.","ui.agent_chat_denied":"Odbijeno","ui.agent_chat_deny":"Odbij","ui.agent_chat_desktop_only":"Razgovor s agentom zahtijeva desktop aplikaciju.","ui.agent_chat_detecting":"Traženje agenata…","ui.agent_chat_dock":"Pričvrsti u bočni panel","ui.agent_chat_dock_left":"Pričvrsti lijevo","ui.agent_chat_dock_right":"Pričvrsti desno","ui.agent_chat_drop_hint":"Ispustite kako biste priložili uz sljedeću poruku","ui.agent_chat_edit":"Uredi","ui.agent_chat_exited":"Agent se zaustavio.","ui.agent_chat_failed_start":"Agent se nije mogao pokrenuti: {error}","ui.agent_chat_file_cad_not_read":"{name}: CAD datoteka se uvozi u dizajn, ne čita se","ui.agent_chat_file_empty_picture":"{name}: prazna slika","ui.agent_chat_file_error":"{name}: {error}","ui.agent_chat_file_heic":"{name}: HEIC slike ne mogu se ovdje čitati; najprije je izvezite kao JPEG ili PNG","ui.agent_chat_file_importing":"Uvoz u dizajn…","ui.agent_chat_file_kinds":"{name}: mogu se priložiti slike (PNG, JPEG, GIF, WebP, BMP, TIFF), tekstualne datoteke (i SVG) i CAD datoteke (STEP, IGES, FreeCAD, Rhino, STL, 3MF, OBJ, glTF)","ui.agent_chat_file_loading":"Čitanje datoteke…","ui.agent_chat_file_not_a_file":"{name}: nije datoteka","ui.agent_chat_file_not_a_picture":"{name}: nije slika","ui.agent_chat_file_not_utf8":"{name}: nije UTF-8 tekst","ui.agent_chat_file_picture_too_big":"{name}: slika može imati najviše {max} MB","ui.agent_chat_file_text_too_big":"{name}: tekstualna datoteka može imati najviše {max} KB","ui.agent_chat_file_too_large":"{name}: prevelika","ui.agent_chat_file_too_large_to_send":"{name}: prevelika za slanje, čak i smanjena","ui.agent_chat_file_unreadable_picture":"{name}: nije slika koju ovo može pročitati","ui.agent_chat_files":"Datoteke: {files}","ui.agent_chat_files_left_out":"Uz jednu poruku ide najviše {max} datoteka; izostavljene: {files}","ui.agent_chat_files_loading":"Čeka se čitanje datoteka","ui.agent_chat_files_max":"Najviše {max} datoteka uz jednu poruku","ui.agent_chat_flatpak_none_found":"Nije pronađen nijedan agent za kodiranje. Flatpak sandbox ne vidi agente instalirane u vašoj kućnoj mapi i zadano nema pristup mreži. Kako biste dopustili Claude Code i njegov ACP adapter instalirane preko nvm ili ~/.local/bin, pokrenite ovu naredbu u terminalu, a zatim ponovno pokrenite SolidCraft. Ona daje pristup navedenom programu i datotekama za prijavu, kao i pristup mreži:","ui.agent_chat_import_failed":"{name}: uvoz nije uspio: {error}","ui.agent_chat_intro":"Razgovarajte s agentom za kodiranje koji već koristite ili s krajnjom točkom modela koju odaberete. Radi na otvorenom dizajnu pomoću SolidCraft alata: njegove promjene prikazuju se dok ih radi i poništavaju se kao jedan korak po poruci. Što smije raditi bez pitanja postavlja se u Postavke > AI.","ui.agent_chat_key_in_env":"ključ postavljen","ui.agent_chat_last_missing":"Posljednje korišteni agent ({agent}) više nije dostupan. Odaberite agent, a zatim pritisnite Pokušaj ponovno.","ui.agent_chat_left":"Lijevo","ui.agent_chat_limit":"Agent je dosegao ograničenje od {limit} promjena za jednu poruku. Pošaljite novu poruku kako biste mu dopustili da nastavi.","ui.agent_chat_login_found":"prijava pronađena","ui.agent_chat_minimize":"Smanji u traku","ui.agent_chat_mode_all":"Sve","ui.agent_chat_mode_ask":"Pitaj","ui.agent_chat_mode_edits":"Izmjene","ui.agent_chat_model_no_tools":"{model} ne može koristiti SolidCraft alate, pa može samo razgovarati. Odaberite model s podrškom za alate.","ui.agent_chat_model_tip":"Model koji agent koristi. Vaš odabir pamti se za ovog agenta.","ui.agent_chat_new":"Novi razgovor","ui.agent_chat_new_confirm":"Započeti novi razgovor? Trenutni će biti obrisan.","ui.agent_chat_next_picture":"Sljedeća slika","ui.agent_chat_no_cli":"solidcraft-cli nije pronađen pored aplikacije, pa agent ne može pristupiti dizajnu.","ui.agent_chat_no_control":"Krajnja točka razgovora s agentom nije se pokrenula, pa agent ne može pristupiti dizajnu.","ui.agent_chat_no_images":"Ovaj agent ne prima slike","ui.agent_chat_no_picture":"U međuspremniku nema slike","ui.agent_chat_no_tool_call":"Model nije koristio SolidCraft alate, pa dizajn nije promijenjen. Odaberite model koji podržava pozivanje alata; pogledajte Lokalni modeli u vodiču za razgovor s agentom.","ui.agent_chat_none_found":"Nije pronađen nijedan agent za kodiranje. Instalirajte jedan od ovih, a zatim pritisnite Osvježi:","ui.agent_chat_none_found_short":"Nije pronađen nijedan agent","ui.agent_chat_not_installed":"Nije instalirano","ui.agent_chat_not_signed_in":"niste prijavljeni","ui.agent_chat_open_settings":"Otvori Postavke","ui.agent_chat_own_window":"Zaseban prozor","ui.agent_chat_paste_picture":"Zalijepi sliku","ui.agent_chat_permission":"Agent traži da pokrene: {title}","ui.agent_chat_pick":"Agent","ui.agent_chat_pick_context":"Odaberi kontekst","ui.agent_chat_pick_context_tip":"Odaberite lica, bridove, značajke i tijela u modelu koje agent treba pogledati, a zatim pritisnite U redu","ui.agent_chat_placeholder":"Zamolite agenta da promijeni dizajn…","ui.agent_chat_placeholder_busy":"Stavi poruku u red za kada agent završi (Ctrl+Enter: pošalji odmah)","ui.agent_chat_pop_out":"Otvori u zasebnom prozoru, koji možete premjestiti na drugi zaslon","ui.agent_chat_previous_picture":"Prethodna slika","ui.agent_chat_privacy":"Ništa ne ide nikamo osim agentu kojeg pokrenete, pod vašim vlastitim računom.","ui.agent_chat_privacy_note":"Sam razgovor ne šalje ništa nikamo: agent kojeg pokrenete razgovara sa svojom uslugom pod vašim vlastitim računom. SolidCraft nikad ne vidi niti čuva ključ ili lozinku.","ui.agent_chat_provider_models":"Modeli: {count}","ui.agent_chat_provider_other":"Ostalo","ui.agent_chat_provider_tip":"Pružatelj čije modele prikazuje sljedeći popis.","ui.agent_chat_queue":"Red","ui.agent_chat_queue_full":"Previše poruka čeka: uklonite jednu ili pričekajte agenta.","ui.agent_chat_queued":"U redu čekanja","ui.agent_chat_queued_stopped":"U redu čekanja (zaustavljeno, nije poslano)","ui.agent_chat_refresh":"Osvježi","ui.agent_chat_refused":"Nije dopušteno agentu: {reason}","ui.agent_chat_reinstall":"{agent} je instaliran ({program}), ali se nije pokrenuo kad ga je SolidCraft provjerio: {error}\nInstalacija je možda nepotpuna ili izrađena za drugu vrstu računala. Ponovno ga instalirajte naredbom `{install}`, provjerite ispisuje li u terminalu svoju verziju, a zatim pritisnite Osvježi.","ui.agent_chat_remove":"Ukloni iz reda","ui.agent_chat_remove_file":"Skini s ove poruke","ui.agent_chat_remove_imported":"Skini s ove poruke; dio ostaje u dizajnu (Poništi ga uklanja)","ui.agent_chat_reply_cut_off":"Odgovor je dosegnuo ograničenje duljine prije nego što je završio pa je možda nepotpun. Zamolite agenta da nastavi ili da odgovori kraće.","ui.agent_chat_reply_declined":"Model je odbio odgovoriti na ovu poruku.","ui.agent_chat_retry":"Pokušaj ponovno","ui.agent_chat_right":"Desno","ui.agent_chat_save":"Spremi","ui.agent_chat_send":"Pošalji","ui.agent_chat_send_now":"Pošalji odmah","ui.agent_chat_send_now_tip":"Zaustavi trenutni korak agenta i pošalji ovo sljedeće (Ctrl+Enter)","ui.agent_chat_setup_body":"SolidCraft razgovara s agentom za kodiranje instaliranim na ovom računalu. Odaberite jednog u Postavke › AI.","ui.agent_chat_setup_title":"Postavi asistenta","ui.agent_chat_side":"Strana razgovora s agentom","ui.agent_chat_signed_in":"prijavljeni ste","ui.agent_chat_state_auth":"Potrebna je prijava","ui.agent_chat_state_busy":"Radi se…","ui.agent_chat_state_exited":"Agent je zaustavljen","ui.agent_chat_state_failed":"Povezivanje nije uspjelo","ui.agent_chat_state_off":"Nije povezano","ui.agent_chat_state_ready":"Spremno","ui.agent_chat_state_starting":"Pokretanje…","ui.agent_chat_stop":"Zaustavi","ui.agent_chat_stop_tip":"Zaustavi agenta i sve što je pokrenuo","ui.agent_chat_stop_turn_tip":"Zaustavi agenta (Esc). Poruke u redu ostaju u redu.","ui.agent_chat_turn_limit":"Promjene po poruci","ui.agent_chat_turn_unlimited":"Neograničeno","ui.agent_chat_undo_changes":"Poništi ove promjene","ui.agent_chat_undo_label":"Razgovor s agentom: {message}","ui.agent_chat_undone":"(poništeno)","ui.agent_chat_view_attached":"Prikaz priložen","ui.agent_chat_waiting":"Čeka vas","ui.agent_cursor":"Pokazivač agenta","ui.agent_cursor_speed":"Brzina pokazivača agenta","ui.agent_off_thread":"Zadrži odziv prozora dok agenti izvršavaju naredbe","ui.agent_off_thread_note":"Spore naredbe agenta (iz AI ploče ili MCP klijenta) računaju se pored prozora: možete nastaviti okretati i pregledavati prikaz, a jednu možete zaustaviti s oznake u prikazu. Isključeno: svaka se izvršava na niti prozora i prozor je čeka.","ui.ai_add":"Dodaj","ui.ai_add_agent":"Dodaj agenta…","ui.ai_add_agent_title":"Dodaj agenta","ui.ai_add_anthropic":"API kompatibilan s Anthropicom","ui.ai_add_api":"API kompatibilan s OpenAI","ui.ai_add_custom":"Prilagođena naredba","ui.ai_add_endpoint":"API krajnja točka","ui.ai_add_installed":"Instalirani agent","ui.ai_add_installed_note":"Vaš vlastiti unos za instaliranog agenta, na primjer s drugim argumentima. Instalirani agenti navedeni su zasebno.","ui.ai_added":"dodano","ui.ai_agent_mode_tip":"Vlastiti način rada agenta: njime se ravnaju njegovi vlastiti alati (ljuska, izmjene datoteka). SolidCraft alati slijede dopuštenja u Postavke > AI.","ui.ai_agents":"Agenti","ui.ai_always_allow":"Uvijek dopusti","ui.ai_always_allow_tip":"Od sada dopusti {tool} za ovog agenta, bez pitanja","ui.ai_always_allowed":"Uvijek dopušteno","ui.ai_always_allowed_none":"Još ništa nije uvijek dopušteno. Ovdje se navode odgovori \"Uvijek dopusti\" koje date u razgovoru.","ui.ai_auto_allowed":"Automatski dopušteno: {title} ({why})","ui.ai_auto_mode":"vaša postavka dopuštenja","ui.ai_auto_ours":"SolidCraft sam provjerava svoje alate","ui.ai_auto_remembered":"odabrali ste Uvijek dopusti","ui.ai_bad_url":"Unesite URL koji počinje s http:// ili https://","ui.ai_base_url":"Osnovni URL","ui.ai_button":"AI","ui.ai_command_hint":"my-agent --acp","ui.ai_copy_suffix":"kopiraj","ui.ai_custom_url":"Prilagođeni URL","ui.ai_default":"Zadano","ui.ai_edit":"Uredi","ui.ai_edit_agent_title":"Uredi agenta","ui.ai_edit_gone":"Ovaj agent je uklonjen pa nema što spremiti.","ui.ai_edit_tip":"Promijenite naziv, naredbu ili krajnju točku ovog agenta. Spremljeni ključ ostaje skriven.","ui.ai_http_busy":"krajnja točka je zauzeta ili je preko ograničenja; pokušajte ponovno kasnije","ui.ai_http_key":"krajnja točka odbila je ključ: provjerite ga u Postavke > AI","ui.ai_http_not_found":"nema takve krajnje točke ili modela: provjerite osnovni URL i naziv modela","ui.ai_http_too_large":"razgovor je prevelik za ovu krajnju točku; započnite novi razgovor","ui.ai_key":"API ključ","ui.ai_key_hint":"neobavezno; čuva se u sustavskom privjesku ključeva","ui.ai_key_keep_hint":"ostavite prazno kako biste zadržali spremljeni ključ","ui.ai_key_needs_https":"Ključ se šalje samo preko HTTPS-a ili na ovo računalo.","ui.ai_key_note":"Čuva se u sustavskom privjesku ključeva, nikad u postavkama SolidCrafta. Za lokalni poslužitelj ostavite prazno.","ui.ai_keychain_error":"Sustavski privjesak ključeva odbio je: {error}","ui.ai_kind":"Vrsta","ui.ai_mode_all":"Dopusti sve","ui.ai_mode_all_note":"Ništa ne pita unaprijed. Izvješća o rušenju ostaju nedostupna i ograničenja mapa i dalje vrijede.","ui.ai_mode_all_warning":"Agent može spremiti, prebrisati, izvesti i zamijeniti vaš dizajn bez pitanja. Koristite ovo samo s agentom kojem vjerujete, na dizajnima koje ste spremili.","ui.ai_mode_ask":"Pitaj svaki put","ui.ai_mode_ask_note":"Svaka promjena dizajna i svaka radnja s datotekom čeka vaše Dopusti.","ui.ai_mode_edits":"Automatski dopusti izmjene modela","ui.ai_mode_edits_note":"Naredbe modeliranja izvršavaju se bez pitanja; spremanje, otvaranje, izvoz i druge radnje s datotekama ili destruktivne radnje i dalje traže potvrdu.","ui.ai_mode_global":"Kako je postavljeno iznad","ui.ai_model":"Model","ui.ai_model_hint":"qwen3:14b","ui.ai_modes_scope":"Ove postavke pokrivaju SolidCraft alate. Vlastiti alati agenta (njegova ljuska, njegove izmjene datoteka) prate vlastiti način rada agenta, koji odabirete u zaglavlju ploče razgovora kad agent ima načine rada.","ui.ai_name":"Naziv","ui.ai_name_hint":"Moj agent","ui.ai_need_command":"Unesite naredbu koja pokreće agenta","ui.ai_need_model":"Unesite naziv modela","ui.ai_no_answer":"Agent nije odgovorio na vrijeme","ui.ai_no_http":"Ovo izdanje ne može pristupiti API krajnjim točkama","ui.ai_no_keychain":"Sustavski privjesak ključeva nije dostupan, pa se ključ ne može spremiti. Lokalni poslužitelj bez ključa i dalje radi.","ui.ai_panel":"Ploča","ui.ai_permissions":"Dopuštenja","ui.ai_preset":"Unaprijed zadano","ui.ai_protocol":"Protokol","ui.ai_remove":"Ukloni","ui.ai_request_timed_out":"Model je trajao dulje od {seconds} s. Vremensko ograničenje zahtjeva za ovu krajnju točku možete povećati u Postavke › Asistent.","ui.ai_request_timeout":"Vremensko ograničenje zahtjeva","ui.ai_request_timeout_hint":"Koliko dugo jedan zahtjev modelu na ovoj krajnjoj točki smije trajati, od 30 s do jednog sata. Povećajte za spori lokalni model.","ui.ai_reset":"Vrati zadano","ui.ai_save":"Spremi","ui.ai_settings":"AI postavke…","ui.ai_show_features":"Prikaži AI funkcije","ui.ai_show_features_note":"Razgovor s agentom: ploča u kojoj agent za kodiranje koji već koristite ili krajnja točka modela koju odaberete radi na otvorenom dizajnu. Isključeno: nema AI gumba, prečaca, stavke izbornika ni ploče, i ništa se ne traži niti pokreće.","ui.ai_switch_tip":"Promijeni agenta za ovaj razgovor","ui.ai_test":"Testiraj","ui.ai_test_acp_ok":"Odgovara: {agent}","ui.ai_test_acp_tip":"Nakratko pokreće agenta i traži od njega sesiju; zatim je ponovno završava","ui.ai_t