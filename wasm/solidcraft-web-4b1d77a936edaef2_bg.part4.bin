ומות חייבות להיות בסקיצה אחת","the direction must be an axis, a sketch line or a straight edge":"הכיוון חייב להיות ציר, קו סקיצה או מקצוע ישר","the duration must be a number of seconds, 0.001 or more":"משך הזמן חייב להיות מספר שניות, 0.001 או יותר","the line's sketch is gone":"הסקיצה של הקו כבר לא קיימת","the lines must be in one sketch":"הקווים חייבים להיות בסקיצה אחת","the lines must be in one sketch, not the section's":"הקווים חייבים להיות בסקיצה אחת, ולא בסקיצת החתך","the parts library is empty":"ספריית החלקים ריקה","the parts library is not available":"ספריית החלקים אינה זמינה","the path curves must be in one other sketch":"עקומות המסלול חייבות להיות בסקיצה אחרת אחת","the path's sketch is gone":"הסקיצה של המסלול כבר לא קיימת","the position must be a number":"המיקום חייב להיות מספר","the preview failed":"התצוגה המקדימה נכשלה","the profiles and curves must be in one sketch":"הפרופילים והעקומות חייבים להיות בסקיצה אחת","the reference face must be on the edges' body":"פאת הייחוס חייבת להיות על הגוף של המקצועות","the scale must be above 0":"קנה המידה חייב להיות גדול מ־0","the section's profiles must be in one sketch":"הפרופילים של החתך חייבים להיות בסקיצה אחת","the two origins are on the same component":"שתי הראשיות נמצאות על אותו רכיב","thread.automatic_size":"גודל אוטומטי","thread.designation":"סימון","thread.direction":"כיוון ההברגה","thread.iso_metric":"ISO מטרי","thread.left_hand":"שמאלית","thread.right_hand":"ימנית","thread.select_size":"בחירת גודל","timeline.delete_after_marker_one":"מחיקת פיצ'ר אחד אחרי סמן ציר הזמן","timeline.delete_after_marker_other":"מחיקת {count} פיצ'רים אחרי סמן ציר הזמן","timeline.delete_folders_tip":"שמירת הפיצ'רים והתיקיות המקוננות שלהן בציר הזמן","timeline.delete_folders_with_features_tip":"מחיקת התיקיות עם כל הפיצ'רים שבהן והתיקיות המקוננות בהן","timeline.delete_many":"מחיקת {count} הפיצ'רים שנבחרו","timeline.edited_rolled_back":"{name} שונה, אך הוא אחרי סמן ההיסטוריה ולכן לא נבנה: הזיזו את הסמן אל מעבר אליו כדי לראות את התוצאה","timeline.feature_error":"שגיאה: {message}","timeline.feature_hint":"לחיצה כפולה לעריכה · גרירה לשינוי הסדר · לחיצה ימנית לעוד","timeline.feature_rolled_back":"בוטל: אחרי סמן ההיסטוריה, ולכן לא נבנה","timeline.feature_warning":"אזהרה: {message}","timeline.group":"תיקיית פיצ'רים חדשה","timeline.move_many":"הזזת פריטים בציר הזמן","timeline.move_to_group":"העברת פיצ'רים לתיקייה","timeline.rename_group":"שינוי שם תיקיית פיצ'רים","timeline.reorder_many":"שינוי סדר פיצ'רים","timeline.suppress_features":"השבתת פיצ'רים","timeline.suppress_folders_tip":"השבתה או ביטול השבתה של כל הפיצ'רים בתיקיות ובתיקיות המקוננות בהן","timeline.ungroup":"הסרת תיקיות פיצ'רים","timeline.unsuppress_features":"ביטול השבתת פיצ'רים","to the face":"עד הפאה","to the next face":"עד הפאה הבאה","toolbar.customize_note":"לשונית {tab}. סימון פקודה מוסיף לה לחצן בסרגל הכלים. אפשר גם לגרור שורה מהרשימה הנפתחת של חלונית אל סרגל הכלים, לגרור לחצן אל מחוץ לסרגל הכלים כדי להסיר אותו, או להשתמש בנעץ שבשורה של רשימה נפתחת.","toolbar.image":"תמונה","toolbar.render":"הדמיה","toolbar.render_appearance":"מראה","toolbar.render_camera":"מצלמה","toolbar.render_environment":"סביבה","toolbar.render_lighting":"תאורה","toolbar.render_lights":"אורות","toolbar.render_result":"תוצאה","toolbar.render_scene":"סצנה","toolbar.render_stage":"שלב","toolbar.render_studio":"סטודיו","trace.points":"{count} נקודות לאורך המסלול","trace.stopped_by_contact":"מסתיים בדגימה {sample}: {a} היה עובר דרך {b}","trace.stopped_by_loop":"מסתיים בדגימה {sample}: הלולאה דרך {joint} לא יכולה להיסגר יותר","trim by sketch curves, or by one plane or face":"יש לגזום באמצעות עקומות סקיצה, או באמצעות מישור אחד או פאה אחת","ui.1_degree_of_freedom":"דרגת חופש אחת","ui.3d_mouse_axes_reassigned":"הקצאת הצירים מחדש בהעדפות עדיין חלה בנוסף לכיול הזה.","ui.3d_mouse_button":"לחצן {number}","ui.3d_mouse_button_nothing":"ללא","ui.3d_mouse_button_settings":"הגדרות עכבר תלת־ממדי","ui.3d_mouse_buttons":"לחצנים","ui.3d_mouse_buttons_hint":"יש ללחוץ על לחצן בעכבר התלת־ממדי כדי למצוא אותו כאן, ואז לבחור מה הוא עושה.","ui.3d_mouse_buttons_no_device":"יש לחבר עכבר תלת־ממדי כדי להגדיר מה עושים הלחצנים שלו.","ui.3d_mouse_buttons_reset":"שחזור לחצני ברירת המחדל","ui.3d_mouse_calibrate":"כיול…","ui.3d_mouse_calibrate_tip":"יש להזיז את הכיפה לפי ההנחיות בחלון, כדי ש־SolidCraft ילמד לאיזה כיוון ועד כמה נע כל ציר של העכבר התלת־ממדי הזה. נשמר עבור עכבר תלת־ממדי זה.","ui.3d_mouse_calibrate_title":"כיול עכבר תלת־ממדי","ui.3d_mouse_calibrate_wait":"יש להזיז את העכבר התלת־ממדי פעם אחת כדי ש־SolidCraft יזהה אותו.","ui.3d_mouse_calibrated":"מכויל","ui.3d_mouse_calibration":"כיול","ui.3d_mouse_calibration_done":"הכיול הושלם. יש לשמור אותו כדי להשתמש בו בכל פעם שעכבר תלת־ממדי זה מחובר.","ui.3d_mouse_calibration_no_response":"אחד הצירים כמעט לא זז, ולכן אי אפשר לכייל אותו. יש להתחיל מחדש ולהזיז את הכיפה רחוק יותר בכל פעם.","ui.3d_mouse_circles_help":"העיגולים מראים מה ההתקן שולח, אחרי הכיול. מודל הבדיקה מראה מה המבט עושה עם זה, אחרי ההיפוך, המהירות והקצאת הצירים.","ui.3d_mouse_dead_zone":"אזור מת","ui.3d_mouse_dead_zone_tip":"כמה צריך להזיז את הכיפה לפני שהמבט זז, כחלק מהמהלך המלא שלה. כדאי להגדיל אם המבט נסחף כשהכיפה במנוחה.","ui.3d_mouse_denied":"SolidCraft מזהה עכבר תלת־ממדי אבל אין לו הרשאה לקרוא ממנו. כלל ה־udev מופיע בהערות ההתקנה של העכבר התלת־ממדי.","ui.3d_mouse_denied_short":"נמצא, אבל אי אפשר לקרוא ממנו","ui.3d_mouse_driven_by":"איזו תנועה מכוילת של ההתקן מפעילה את הציר הזה. בחירת תנועה שציר אחר כבר משתמש בה מחליפה בין השניים.","ui.3d_mouse_driven_by_label":"מופעל על ידי","ui.3d_mouse_driver":"מנהל התקן","ui.3d_mouse_driver_auto":"אוטומטי","ui.3d_mouse_driver_direct":"ישיר (hidraw)","ui.3d_mouse_driver_fallback":"קריאה דרך spacenavd בינתיים: לא ניתן היה לפתוח את ההתקן עצמו.","ui.3d_mouse_driver_only_direct":"קריאה ישירה מההתקן; spacenavd אינו פועל","ui.3d_mouse_driver_only_spacenavd":"קריאה דרך spacenavd, הדרך היחידה הזמינה","ui.3d_mouse_forget":"מחיקת הכיול","ui.3d_mouse_ghost_left_viewport":"צד שמאל של אזור התצוגה","ui.3d_mouse_ghost_left_window":"צד שמאל של החלון","ui.3d_mouse_ghost_position":"מיקום","ui.3d_mouse_ghost_right_viewport":"צד ימין של אזור התצוגה","ui.3d_mouse_hint":"הזזה וסיבוב של המבט יחד; בסקיצות רק הזזה וזום.","ui.3d_mouse_kind_cap":"חזרה למרכז","ui.3d_mouse_kind_question":"איזה סוג עכבר תלת־ממדי זה?","ui.3d_mouse_kind_trackball":"כדור עקיבה","ui.3d_mouse_looks_like_cap":"הקריאה נשארת במקומה כל עוד מחזיקים, כמו בהתקן חזרה למרכז.","ui.3d_mouse_looks_like_trackball":"הקריאה חוזרת לאפס ברגע שמפסיקים להזיז, כמו בכדור עקיבה.","ui.3d_mouse_motion_rotation_x":"סיבוב X","ui.3d_mouse_motion_rotation_y":"סיבוב Y","ui.3d_mouse_motion_rotation_z":"סיבוב Z","ui.3d_mouse_motion_translation_x":"הזזה X","ui.3d_mouse_motion_translation_y":"הזזה Y","ui.3d_mouse_motion_translation_z":"הזזה Z","ui.3d_mouse_navigate":"ניווט באמצעות העכבר התלת־ממדי","ui.3d_mouse_none":"לא נמצא עכבר תלת־ממדי","ui.3d_mouse_not_calibrated":"לא מכויל","ui.3d_mouse_offer":"כיול העכבר התלת־ממדי מתקן צירים מוחלפים או הפוכים וקובע את המהירות והתחושה שלו.","ui.3d_mouse_offer_never":"לא להציג שוב","ui.3d_mouse_offer_swap":"מעבר ל־Hidraw (מנהל ישיר)","ui.3d_mouse_orbit":"סיבוב","ui.3d_mouse_orbit_classic":"קלאסי","ui.3d_mouse_orbit_tip":"במעקב: העכבר התלת־ממדי מסובב את המבט סביב החלק של המודל שבמרכז המבט כשהסיבוב מתחיל, ומסמן אותו בכדור חיוור. קלאסי: סביב מרכז המבט","ui.3d_mouse_orbit_traced":"במעקב","ui.3d_mouse_reading":"קריאה","ui.3d_mouse_reset_axes":"איפוס הקצאת הצירים","ui.3d_mouse_reset_view":"איפוס המבט","ui.3d_mouse_restore":"איפוס לברירות המחדל","ui.3d_mouse_restore_ask":"להחזיר את הגדרות העכבר התלת־ממדי לברירות המחדל? הכיול ומיפוי הלחצנים נשמרים.","ui.3d_mouse_section":"עכבר תלת־ממדי","ui.3d_mouse_show_in_view":"הצגת העכבר התלת־ממדי בתצוגה התלת־ממדית","ui.3d_mouse_show_in_view_tip":"תמונה של העכבר התלת־ממדי בפינה השמאלית התחתונה, שזזה כשמזיזים אותו.","ui.3d_mouse_sketch_orbit":"סיבוב סקיצות בעכבר התלת־ממדי","ui.3d_mouse_sketch_orbit_tip":"העכבר התלת־ממדי מסובב את התצוגה גם כשסקיצה פתוחה ונראית חזיתית, כמו שהעכבר יכול. כבוי: הוא מזיז ומגדיל את הסקיצה עד שתטה את התצוגה.","ui.3d_mouse_skip":"ההתקן שלי לא יכול לעשות את זה","ui.3d_mouse_skip_tip":"מדלג על התנועה הזאת בשני הכיוונים, והכיול משמיט אותה.","ui.3d_mouse_speed":"מהירות עכבר תלת־ממדי","ui.3d_mouse_step_lift":"יש להרים את הכיפה, להחזיק ואז לשחרר.","ui.3d_mouse_step_press":"יש ללחוץ את הכיפה למטה, להחזיק ואז לשחרר.","ui.3d_mouse_step_pull":"יש למשוך את הכיפה לכיוונך, להחזיק ואז לשחרר.","ui.3d_mouse_step_push":"יש לדחוף את הכיפה הרחק ממך, להחזיק ואז לשחרר.","ui.3d_mouse_step_rest":"יש להוריד את היד מהכיפה ולהשאיר אותה ללא תזוזה.","ui.3d_mouse_step_rest_trackball":"יש להוריד את היד מהכדור ולהשאיר אותו ללא תזוזה.","ui.3d_mouse_step_ring_clockwise":"יש לסובב את טבעת הגלילה בכיוון השעון כמה נקישות.","ui.3d_mouse_step_ring_counterclockwise":"יש לסובב את טבעת הגלילה נגד כיוון השעון כמה נקישות.","ui.3d_mouse_step_roll_away":"יש לגלגל את הכדור הרחק ממך כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_roll_left":"יש לגלגל את הכדור שמאלה כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_roll_right":"יש לגלגל את הכדור ימינה כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_roll_toward":"יש לגלגל את הכדור לכיוונך כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_slide_left":"יש להסיט את הכיפה שמאלה, להחזיק ואז לשחרר.","ui.3d_mouse_step_slide_right":"יש להסיט את הכיפה ימינה, להחזיק ואז לשחרר.","ui.3d_mouse_step_spin_clockwise":"יש לסובב את הכדור בכיוון השעון כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_spin_counterclockwise":"יש לסובב את הכדור נגד כיוון השעון כמה פעמים, ואז לתת לו לעצור.","ui.3d_mouse_step_tilt_away":"יש להטות את ראש הכיפה הרחק ממך (הקצה הקרוב אליך עולה), להחזיק ואז לשחרר.","ui.3d_mouse_step_tilt_left":"יש להטות את הכיפה שמאלה (הקצה השמאלי למטה), להחזיק ואז לשחרר.","ui.3d_mouse_step_tilt_right":"יש להטות את הכיפה ימינה (הקצה הימני למטה), להחזיק ואז לשחרר.","ui.3d_mouse_step_tilt_toward":"יש להטות את ראש הכיפה לכיוונך (הקצה הקרוב אליך יורד), להחזיק ואז לשחרר.","ui.3d_mouse_step_touch":"יש להניח את היד על הכיפה בלי לדחוף אותה.","ui.3d_mouse_step_twist_clockwise":"יש לסובב את הכיפה בכיוון השעון, להחזיק ואז לשחרר.","ui.3d_mouse_step_twist_counterclockwise":"יש לסובב את הכיפה נגד כיוון השעון, להחזיק ואז לשחרר.","ui.3d_mouse_switch_cap":"כיול כהתקן חזרה למרכז","ui.3d_mouse_switch_trackball":"כיול ככדור עקיבה","ui.3d_mouse_use_direct":"שימוש במנהל ישיר","ui.3d_mouse_use_direct_tip":"קריאת העכבר התלת־ממדי ישירות (hidraw) במקום דרך spacenavd.","ui.3d_mouse_view_axis":"ציר מבט","ui.3d_mouse_view_off":"כבוי","ui.3d_mouse_view_off_tip":"הפרופיל של מנהל ההתקן לעכבר התלת־ממדי מכבה את הציר הזה, ולכן התנועה שלו לא מזיזה את המבט. בחירה כאן בתנועה של ציר אחר מחליפה בין השניים, והתנועה ההיא מפסיקה להזיז את המבט.","ui.3d_mouse_view_orbit_sideways":"סיבוב מבט Y","ui.3d_mouse_view_orbit_up_down":"סיבוב מבט X","ui.3d_mouse_view_pan_sideways":"הזזת מבט X","ui.3d_mouse_view_pan_up_down":"הזזת מבט Y","ui.3d_mouse_view_roll":"גלגול","ui.3d_mouse_view_unmapped":"ציר {n}","ui.3d_mouse_view_zoom":"זום","ui.3d_mouse_waiting":"ממתין לתנועה","ui.3d_mouse_wiggle":"אם יש אחד מחובר, יש להזיז אותו מעט.","ui.3d_sketch":"סקיצה תלת־ממדית","ui.activate":"הפעלה","ui.active_component":"רכיב פעיל","ui.add_configuration":"הוספת תצורה","ui.add_parameter":"הוספת פרמטר","ui.agent_chat":"צ'אט עם סוכן","ui.agent_chat_add":"צירוף קבצים","ui.agent_chat_add_file":"בחירת קובץ…","ui.agent_chat_allow":"התרה","ui.agent_chat_allow_once":"התרה פעם אחת","ui.agent_chat_allowed":"הותר","ui.agent_chat_answered":"תשובה: {option}","ui.agent_chat_approval":"לאפשר לסוכן לעשות זאת?","ui.agent_chat_attach_selection":"צירוף הבחירה","ui.agent_chat_attach_selection_tip":"שליחת מה שנבחר במודל (פאות, מקצועות, פיצ'רים, גופים) עם ההודעה, כדי שהסוכן יבין למה הכוונה","ui.agent_chat_attach_view":"צירוף התצוגה","ui.agent_chat_attach_view_tip":"שליחת תמונה של התצוגה הנוכחית עם ההודעה","ui.agent_chat_attachable":"תמונות, PDF, טקסט וקובצי CAD","ui.agent_chat_auth_agent":"התחברות עם {name}","ui.agent_chat_auth_env":"יש להגדיר את {vars} בסביבה ולהפעיל מחדש את SolidCraft.","ui.agent_chat_auth_needed":"הסוכן מבקש להתחבר. ההתחברות נעשית מול הסוכן עצמו; SolidCraft לעולם אינו רואה את הסיסמה או המפתחות.","ui.agent_chat_auth_none":"הסוכן לא מציע כאן שיטת התחברות: יש להתחבר כפי שמתואר בתיעוד שלו.","ui.agent_chat_auth_retry":"התחברתי: חיבור מחדש","ui.agent_chat_auth_terminal":"יש להריץ את זה במסוף ואז ללחוץ שוב על התחברות:","ui.agent_chat_auth_title":"התחברות לסוכן","ui.agent_chat_cancel":"ביטול","ui.agent_chat_cannot_start":"מותקן, אך אינו מופעל: {error}","ui.agent_chat_changes":"שינויים: {n}, צעד ביטול אחד","ui.agent_chat_changes_n":"{n} שינויים","ui.agent_chat_changes_of":"{n}/{limit} שינויים","ui.agent_chat_choose_model":"יש לבחור מודל","ui.agent_chat_close":"סגירה","ui.agent_chat_command":"פקודת הסוכן","ui.agent_chat_connect":"התחברות","ui.agent_chat_copy":"העתקה","ui.agent_chat_ctx_bodies":"גופים","ui.agent_chat_ctx_elements":"אלמנטים","ui.agent_chat_ctx_features":"פיצ'רים","ui.agent_chat_ctx_more":"+{n} נוספים","ui.agent_chat_ctx_other":"אחר","ui.agent_chat_custom_hint":"כל תוכנה שמדברת Agent Client Protocol דרך stdin ו־stdout. היא לא מורצת דרך מעטפת (shell).","ui.agent_chat_denied":"נדחה","ui.agent_chat_deny":"דחייה","ui.agent_chat_desktop_only":"הצ'אט עם הסוכן דורש את אפליקציית שולחן העבודה.","ui.agent_chat_detecting":"מחפש סוכנים…","ui.agent_chat_dock":"עגינה בחלונית הצד","ui.agent_chat_dock_left":"עגינה משמאל","ui.agent_chat_dock_right":"עגינה מימין","ui.agent_chat_drop_hint":"יש לשחרר כדי לצרף להודעה הבאה","ui.agent_chat_edit":"עריכה","ui.agent_chat_exited":"הסוכן נעצר.","ui.agent_chat_failed_start":"לא ניתן להפעיל את הסוכן: {error}","ui.agent_chat_file_cad_not_read":"{name}: קובץ CAD מיובא לתכן, ולא נקרא","ui.agent_chat_file_empty_picture":"{name}: תמונה ריקה","ui.agent_chat_file_error":"{name}: {error}","ui.agent_chat_file_heic":"{name}: לא ניתן לקרוא כאן תמונות HEIC; יש לייצא אותה תחילה כ־JPEG או PNG","ui.agent_chat_file_importing":"מייבא לתכן…","ui.agent_chat_file_kinds":"{name}: ניתן לצרף תמונות (PNG, JPEG, GIF, WebP, BMP, TIFF), קובצי טקסט (כולל SVG) וקובצי CAD (STEP, IGES, FreeCAD, Rhino, STL, 3MF, OBJ, glTF)","ui.agent_chat_file_loading":"קורא את הקובץ…","ui.agent_chat_file_not_a_file":"{name}: אינו קובץ","ui.agent_chat_file_not_a_picture":"{name}: אינו תמונה","ui.agent_chat_file_not_utf8":"{name}: אינו טקסט UTF-8","ui.agent_chat_file_picture_too_big":"{name}: תמונה יכולה להיות לכל היותר {max} MB","ui.agent_chat_file_text_too_big":"{name}: קובץ טקסט יכול להיות לכל היותר {max} KB","ui.agent_chat_file_too_large":"{name}: גדול מדי","ui.agent_chat_file_too_large_to_send":"{name}: גדול מדי לשליחה, גם לאחר הקטנה","ui.agent_chat_file_unreadable_picture":"{name}: תמונה בפורמט שלא ניתן לקרוא כאן","ui.agent_chat_files":"קבצים: {files}","ui.agent_chat_files_left_out":"ניתן לצרף לכל היותר {max} קבצים להודעה אחת; לא צורפו: {files}","ui.agent_chat_files_loading":"ממתין לקריאת הקבצים","ui.agent_chat_files_max":"לכל היותר {max} קבצים בהודעה אחת","ui.agent_chat_flatpak_none_found":"לא נמצא סוכן קוד. ארגז החול של Flatpak לא רואה סוכנים שהותקנו בתיקיית הבית, ואין לו גישה לרשת כברירת מחדל. כדי לאפשר את Claude Code ואת מתאם ה־ACP שלו שהותקנו דרך nvm או ~/.local/bin, יש להריץ את הפקודה הזו במסוף ואז להפעיל מחדש את SolidCraft. היא מעניקה גישה לתוכנה ולקובצי ההתחברות שברשימה, וגם גישה לרשת:","ui.agent_chat_import_failed":"{name}: הייבוא נכשל: {error}","ui.agent_chat_intro":"צ'אט עם סוכן קוד שכבר נמצא בשימוש, או עם נקודת קצה של מודל לבחירתך. הסוכן עובד על התכן הפתוח דרך הכלים של SolidCraft: השינויים מוצגים תוך כדי ביצוע, וכל הודעה מתבטלת כצעד אחד. מה מותר לו לעשות בלי לשאול נקבע בהעדפות > AI.","ui.agent_chat_key_in_env":"מפתח מוגדר","ui.agent_chat_last_missing":"הסוכן שבו השתמשת לאחרונה ({agent}) כבר אינו זמין. בחר סוכן ולחץ על „ניסיון חוזר”.","ui.agent_chat_left":"שמאל","ui.agent_chat_limit":"הסוכן הגיע למגבלה של {limit} שינויים להודעה אחת. יש לשלוח הודעה נוספת כדי שימשיך.","ui.agent_chat_login_found":"נמצאה התחברות","ui.agent_chat_minimize":"מזעור לפס","ui.agent_chat_mode_all":"הכול","ui.agent_chat_mode_ask":"שאלה","ui.agent_chat_mode_edits":"עריכות","ui.agent_chat_model_no_tools":"{model} לא יכול להשתמש בכלים של SolidCraft, ולכן הוא יכול רק לשוחח. יש לבחור מודל שתומך בכלים.","ui.agent_chat_model_tip":"המודל שבו הסוכן משתמש. הבחירה נשמרת עבור הסוכן הזה.","ui.agent_chat_new":"צ'אט חדש","ui.agent_chat_new_confirm":"להתחיל צ'אט חדש? הצ'אט הנוכחי יימחק.","ui.agent_chat_next_picture":"התמונה הבאה","ui.agent_chat_no_cli":"solidcraft-cli לא נמצא לצד האפליקציה, ולכן הסוכן לא יכול לגשת לתכן.","ui.agent_chat_no_control":"נקודת הקצה של הצ'אט עם הסוכן לא הופעלה, ולכן הסוכן לא יכול לגשת לתכן.","ui.agent_chat_no_images":"הסוכן הזה לא מקבל תמונות","ui.agent_chat_no_picture":"אין תמונה בלוח","ui.agent_chat_no_tool_call":"המודל לא השתמש בכלים של SolidCraft, ולכן התכן לא השתנה. יש לבחור מודל שתומך בקריאה לכלים; ראו „מודלים מקומיים” במדריך צ'אט הסוכן.","ui.agent_chat_none_found":"לא נמצא סוכן קוד. יש להתקין אחד מאלה ואז ללחוץ על רענון:","ui.agent_chat_none_found_short":"לא נמצא סוכן","ui.agent_chat_not_installed":"לא מותקן","ui.agent_chat_not_signed_in":"לא מחובר","ui.agent_chat_open_settings":"פתיחת ההעדפות","ui.agent_chat_own_window":"חלון נפרד","ui.agent_chat_paste_picture":"הדבקת תמונה","ui.agent_chat_permission":"הסוכן מבקש להריץ: {title}","ui.agent_chat_pick":"סוכן","ui.agent_chat_pick_context":"בחירת הקשר","ui.agent_chat_pick_context_tip":"יש לבחור פאות, מקצועות, פיצ'רים וגופים במודל כדי שהסוכן יבחן אותם, ואז ללחוץ על אישור","ui.agent_chat_placeholder":"לבקש מהסוכן לשנות את התכן…","ui.agent_chat_placeholder_busy":"הודעה לתור עד שהסוכן יסיים (Ctrl+Enter: שליחה מיד)","ui.agent_chat_pop_out":"פתיחה בחלון נפרד, שאפשר להעביר למסך אחר","ui.agent_chat_previous_picture":"התמונה הקודמת","ui.agent_chat_privacy":"שום דבר לא נשלח לשום מקום מלבד לסוכן שמורץ, תחת החשבון שלך.","ui.agent_chat_privacy_note":"SolidCraft לא שולח דבר לשום מקום: הסוכן שמורץ מתקשר עם השירות שלו תחת החשבון שלך. SolidCraft לעולם אינו רואה או שומר מפתח או סיסמה.","ui.agent_chat_provider_models":"{count} מודלים","ui.agent_chat_provider_other":"אחר","ui.agent_chat_provider_tip":"הספק שהרשימה הבאה מציגה את המודלים שלו.","ui.agent_chat_queue":"לתור","ui.agent_chat_queue_full":"יותר מדי הודעות ממתינות: יש להסיר אחת או להמתין לסוכן.","ui.agent_chat_queued":"בתור","ui.agent_chat_queued_stopped":"בתור (נעצר, לא נשלח)","ui.agent_chat_refresh":"רענון","ui.agent_chat_refused":"אסור לסוכן: {reason}","ui.agent_chat_reinstall":"{agent} מותקן ({program}), אך לא הופעל כאשר SolidCraft בדק אותו: {error}\nייתכן שההתקנה שלו חלקית, או שהיא מיועדת לסוג אחר של מחשב. יש להתקין אותו מחדש עם `{install}`, לוודא שהוא מציג את הגרסה שלו במסוף, ואז ללחוץ על רענון.","ui.agent_chat_remove":"הסרה מהתור","ui.agent_chat_remove_file":"הסרה מההודעה הזו","ui.agent_chat_remove_imported":"הסרה מההודעה הזו; החלק נשאר בתכן (ביטול מסיר אותו)","ui.agent_chat_reply_cut_off":"התשובה הגיעה למגבלת האורך שלה לפני שהסתיימה, ולכן ייתכן שהיא חלקית. יש לבקש מהסוכן להמשיך, או לענות בקצרה יותר.","ui.agent_chat_reply_declined":"המודל סירב לענות על ההודעה הזו.","ui.agent_chat_retry":"ניסיון חוזר","ui.agent_chat_right":"ימין","ui.agent_chat_save":"שמירה","ui.agent_chat_send":"שליחה","ui.agent_chat_send_now":"שליחה מיד","ui.agent_chat_send_now_tip":"עצירת הצעד הנוכחי של הסוכן ושליחת הודעה זו כבאה בתור (Ctrl+Enter)","ui.agent_chat_setup_body":"SolidCraft מדבר עם סוכן קוד שמותקן במחשב הזה. אפשר לבחור אחד בהעדפות › AI.","ui.agent_chat_setup_title":"הגדרת עוזר","ui.agent_chat_side":"צד הצ'אט עם הסוכן","ui.agent_chat_signed_in":"מחובר","ui.agent_chat_state_auth":"נדרשת התחברות","ui.agent_chat_state_busy":"עובד…","ui.agent_chat_state_exited":"הסוכן נעצר","ui.agent_chat_state_failed":"ההתחברות נכשלה","ui.agent_chat_state_off":"לא מחובר","ui.agent_chat_state_ready":"מוכן","ui.agent_chat_state_starting":"מופעל…","ui.agent_chat_stop":"עצירה","ui.agent_chat_stop_tip":"עצירת הסוכן וכל מה שהוא הפעיל","ui.agent_chat_stop_turn_tip":"עצירת הסוכן (Esc). הודעות בתור נשארות בתור.","ui.agent_chat_turn_limit":"שינויים להודעה","ui.agent_chat_turn_unlimited":"ללא הגבלה","ui.agent_chat_undo_changes":"ביטול השינויים האלה","ui.agent_chat_undo_label":"צ'אט עם סוכן: {message}","ui.agent_chat_undone":"(בוטל)","ui.agent_chat_view_attached":"התצוגה צורפה","ui.agent_chat_waiting":"ממתין לך","ui.agent_cursor":"סמן הסוכן","ui.agent_cursor_speed":"מהירות סמן הסוכן","ui.agent_off_thread":"שמירה על תגובתיות החלון בזמן שסוכנים מריצים פקודות","ui.agent_off_thread_note":"פקודות איטיות של סוכן (מחלונית ה־AI או מלקוח MCP) מחושבות לצד החלון: אפשר להמשיך לסובב ולבחון את התצוגה, ולעצור פקודה מהתג שבתצוגה. כבוי: כל פקודה רצה בתהליכון של החלון, והחלון ממתין לה.","ui.ai_add":"הוספה","ui.ai_add_agent":"הוספת סוכן…","ui.ai_add_agent_title":"הוספת סוכן","ui.ai_add_anthropic":"API תואם Anthropic","ui.ai_add_api":"API תואם OpenAI","ui.ai_add_custom":"פקודה מותאמת אישית","ui.ai_add_endpoint":"נקודת קצה של API","ui.ai_add_installed":"סוכן מותקן","ui.ai_add_installed_note":"רשומה משלך עבור סוכן מותקן, למשל עם ארגומנטים אחרים. סוכנים מותקנים מופיעים ברשימה מעצמם.","ui.ai_added":"נוסף","ui.ai_agent_mode_tip":"המצב של הסוכן עצמו: הכלים שלו (מעטפת, עריכת קבצים) כפופים לו. הכלים של SolidCraft כפופים להרשאות בהעדפות > AI.","ui.ai_agents":"סוכנים","ui.ai_always_allow":"התרה תמיד","ui.ai_always_allow_tip":"התרת {tool} לסוכן הזה מעתה, בלי לשאול","ui.ai_always_allowed":"מותר תמיד","ui.ai_always_allowed_none":"עדיין אין דבר שמותר תמיד. תשובות \"התרה תמיד\" שניתנות בצ'אט מופיעות כאן.","ui.ai_auto_allowed":"הותר אוטומטית: {title} ({why})","ui.ai_auto_mode":"הגדרת ההרשאות שלך","ui.ai_auto_ours":"SolidCraft בודק את הכלים שלו בעצמו","ui.ai_auto_remembered":"נבחר \"התרה תמיד\"","ui.ai_bad_url":"יש להזין URL שמתחיל ב־http:// או ב־https://","ui.ai_base_url":"URL בסיס","ui.ai_button":"AI","ui.ai_command_hint":"my-agent --acp","ui.ai_copy_suffix":"עותק","ui.ai_custom_url":"URL מותאם אישית","ui.ai_default":"ברירת מחדל","ui.ai_edit":"עריכה","ui.ai_edit_agent_title":"עריכת סוכן","ui.ai_edit_gone":"הסוכן הזה הוסר, ולכן אין מה לשמור.","ui.ai_edit_tip":"שינוי השם, הפקודה או נקודת הקצה של סוכן זה. מפתח שמור נשאר מוסתר.","ui.ai_http_busy":"נקודת הקצה עמוסה או חרגה מהמגבלה שלה; יש לנסות שוב מאוחר יותר","ui.ai_http_key":"נקודת הקצה דחתה את המפתח: יש לבדוק אותו בהעדפות > AI","ui.ai_http_not_found":"נקודת הקצה או המודל לא קיימים: יש לבדוק את URL הבסיס ואת שם המודל","ui.ai_http_too_large":"השיחה גדולה מדי עבור נקודת קצה זו; יש להתחיל צ'אט חדש","ui.ai_key":"מפתח API","ui.ai_key_hint":"רשות; נשמר במחזיק המפתחות של המערכת","ui.ai_key_keep_hint":"יש להשאיר ריק כדי לשמור על המפתח השמור","ui.ai_key_needs_https":"מפתח נשלח רק דרך HTTPS, או למחשב הזה.","ui.ai_key_note":"נשמר במחזיק המפתחות של המערכת, לעולם לא בהגדרות של SolidCraft. יש להשאיר ריק עבור שרת מקומי.","ui.ai_keychain_error":"מחזיק המפתחות של המערכת סירב: {error}","ui.ai_kind":"סוג","ui.ai_mode_all":"התרת הכול","ui.ai_mode_all_note":"שום דבר לא שואל קודם. דוחות קריסה נשארים חסומים ומגבלות התיקיות עדיין חלות.","ui.ai_mode_all_warning":"הסוכן יכול לשמור, לדרוס, לייצא ולהחליף את התכן בלי לשאול. יש להשתמש בזה רק עם סוכן אמין, ועל תכנים שנשמרו.","ui.ai_mode_ask":"שאלה בכל פעם","ui.ai_mode_ask_note":"כל שינוי בתכן, וכל פעולת קובץ, ממתינים לאישור התרה.","ui.ai_mode_edits":"התרה אוטומטית של עריכות מודל","ui.ai_mode_edits_note":"פקודות מידול רצות בלי לשאול; שמירה, פתיחה, ייצוא ופעולות קובץ או פעולות הרסניות אחרות עדיין שואלות.","ui.ai_mode_global":"כפי שהוגדר למעלה","ui.ai_model":"מודל","ui.ai_model_hint":"qwen3:14b","ui.ai_modes_scope":"ההגדרות האלה חלות על הכלים של SolidCraft. הכלים של הסוכן עצמו (המעטפת שלו, עריכת הקבצים שלו) כפופים למצב של הסוכן, שנבחר בכותרת חלונית הצ'אט כשלסוכן יש מצבים.","ui.ai_name":"שם","ui.ai_name_hint":"הסוכן שלי","ui.ai_need_command":"יש להזין את הפקודה שמפעילה את הסוכן","ui.ai_need_model":"יש להזין את שם המודל","ui.ai_no_answer":"הסוכן לא ענה בזמן","ui.ai_no_http":"הגרסה הזו לא יכולה לגשת לנקודות קצה של API","ui.ai_no_keychain":"מחזיק המפתחות של המערכת אינו זמין, ולכן לא ניתן לשמור מפתח. שרת מקומי ללא מפתח עדיין עובד.","ui.ai_panel":"חלונית","ui.ai_permissions":"הרשאות","ui.ai_preset":"תצורה מוכנה","ui.ai_protocol":"פרוטוקול","ui.ai_reasoning_effort":"מאמץ ההסקה","ui.ai_reasoning_effort_field_hint":"ריק = ברירת המחדל של הספק","ui.ai_reasoning_effort_hint":"אופציונלי. נשלח לנקודת הקצה כ־`reasoning_effort`; הערכים המקובלים שונים מספק לספק (למשל `low`, `high` או `max`). SolidCraft לעולם לא תחליף את הערך שבחרת כאן. השאירו ריק כדי לא לשלוח דבר ולשמור על ברירת המחדל של הספק.","ui.ai_remove":"הסרה","ui.ai_request_timed_out":"המודל נזקק ליותר מ־{seconds} שניות. ניתן להגדיל את זמן ההמתנה לבקשה עבור נקודת קצה זו בהעדפות › עוזר.","ui.ai_request_timeout":"זמן המתנה לבקשה","ui.ai_request_timeout_hint":"כמה זמן מותר לבקשה אחת למודל בנקודת קצה זו, מ־30 שניות עד שעה. כדאי להגדיל עבור מודל מקומי איטי.","ui.ai_reset":"איפוס","ui.ai_save":"שמירה","ui.ai_settings":"הגדרות AI…","ui.ai_show_features":"הצגת תכונות AI","ui.ai_show_features_note":"הצ'אט עם הסוכן: חלונית שבה סוכן קוד שכבר נמצא בשימוש, או נקודת קצה של מודל לבחירתך, עובדים על התכן הפתוח. כבוי: אין לחצן AI, קיצור דרך, פריט תפריט או חלונית, ושום דבר לא מחופש או מופעל.","ui.ai_switch_tip":"החלפת הסוכן לשיחה הזו","ui.ai_test":"בדיקה","ui.ai_test_acp_ok":"עונה: {agent}","ui.ai_test_acp_tip":"מפעיל את הסוכן לרגע ומבקש ממנו הפעלה (session); ואז מסיים אותו","ui.ai_test_answered":"הושג חיבור: {model} ענה","ui.ai_test_anthropic_tip":"שולח הודעה קצרה לנקודת הקצה","ui.ai_test_api_tip":"מבקש מנקודת הקצה את רשימת המודלים שלה","ui.ai_test_no_model":"הושג חיבור: {count} מודלים, אך לא {model}","ui.ai_test_ok":"הושג חיבור: {count} מודלים","ui.ai_testing":"בודק…","ui.ai_tool_arguments":"ארגומנטים","ui.ai_tool_details":"פרטים","ui.ai_tool_done":"הסתיים","ui.ai_tool_failed":"נכשל","ui.ai_tool_result":"תוצאה","ui.ai_tool_running":"רץ","ui.ai_tool_sum_bodies_one":"גוף {count}","ui.ai_tool_sum_bodies_other":"{count} גופים","ui.ai_tool_sum_by":"ב־{value}","ui.ai_tool_sum_edges_one":"מקצוע {count}","ui.ai_tool_sum_edges_other":"{count} מקצועות","ui.ai_tool_sum_faces_one":"פאה {count}","ui.ai_tool_sum_faces_other":"{count} פאות"