e_many":"{count} ausgewählte Merkmale löschen","timeline.edited_rolled_back":"{name} geändert, liegt aber hinter der Verlaufsmarke und wird daher nicht erzeugt: Marke dahinter ziehen, um das Ergebnis zu sehen","timeline.feature_error":"Fehler: {message}","timeline.feature_hint":"Doppelklicken zum Bearbeiten · Ziehen zum Neuordnen · Rechtsklicken für weitere Optionen","timeline.feature_rolled_back":"Zurückgesetzt: hinter der Verlaufsmarke, daher nicht erzeugt","timeline.feature_warning":"Warnung: {message}","timeline.group":"Neuen Merkmalsordner anlegen","timeline.move_many":"Zeitleistenelemente verschieben","timeline.move_to_group":"Merkmale in Ordner verschieben","timeline.rename_group":"Merkmalsordner umbenennen","timeline.reorder_many":"Merkmale neu ordnen","timeline.suppress_features":"Merkmale unterdrücken","timeline.suppress_folders_tip":"Unterdrückt alle Features in den Ordnern und ihren Unterordnern oder hebt die Unterdrückung auf","timeline.ungroup":"Merkmalsordner entfernen","timeline.unsuppress_features":"Unterdrückung der Merkmale aufheben","to the face":"bis zur Fläche","to the next face":"bis zur nächsten Fläche","toolbar.customize_note":"Registerkarte {tab}. Markieren Sie einen Befehl, um ihm eine Schaltfläche in der Werkzeugleiste zu geben. Sie können auch eine Zeile aus dem Aufklappmenü eines Panels auf die Werkzeugleiste ziehen, eine Schaltfläche zum Entfernen aus der Werkzeugleiste ziehen oder die Stecknadel einer Menüzeile verwenden.","toolbar.image":"BILD","toolbar.render":"RENDERN","toolbar.render_appearance":"ERSCHEINUNG","toolbar.render_camera":"KAMERA","toolbar.render_environment":"UMGEBUNG","toolbar.render_lighting":"BELEUCHTUNG","toolbar.render_lights":"LICHTER","toolbar.render_result":"ERGEBNIS","toolbar.render_scene":"SZENE","toolbar.render_stage":"BÜHNE","toolbar.render_studio":"STUDIO","trace.points":"{count} Punkte entlang der Bahn","trace.stopped_by_contact":"Endet bei Probe {sample}: {a} würde {b} durchdringen","trace.stopped_by_loo