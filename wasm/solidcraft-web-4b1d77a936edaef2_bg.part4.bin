t_chat_mode_ask":"Ask","ui.agent_chat_mode_edits":"Edits","ui.agent_chat_model_no_tools":"{model} can't use SolidCraft's tools, so it can only chat. Pick a model with tool support.","ui.agent_chat_model_tip":"The model the agent uses. Your choice is remembered for this agent.","ui.agent_chat_new":"New chat","ui.agent_chat_new_confirm":"Start a new chat? The current one is cleared.","ui.agent_chat_next_picture":"Next picture","ui.agent_chat_no_cli":"solidcraft-cli was not found next to the app, so the agent can't reach the design.","ui.agent_chat_no_control":"The agent chat's endpoint did not start, so the agent can't reach the design.","ui.agent_chat_no_images":"This agent doesn't take pictures","ui.agent_chat_no_picture":"There is no picture on the clipboard","ui.agent_chat_no_tool_call":"The model didn't use SolidCraft's tools, so the design wasn't changed. Choose a model that supports tool calling; see Local models in the agent chat guide.","ui.agent_chat_none_found":"No coding agent found. Install one of these, then press Refresh:","ui.agent_chat_none_found_short":"No agent found","ui.agent_chat_not_installed":"Not installed","ui.agent_chat_not_signed_in":"not signed in","ui.agent_chat_open_settings":"Open Preferences","ui.agent_chat_own_window":"Own window","ui.agent_chat_paste_picture":"Paste a picture","ui.agent_chat_permission":"The agent asks to run: {title}","ui.agent_chat_pick":"Agent","ui.agent_chat_pick_context":"Pick context","ui.agent_chat_pick_context_tip":"Choose faces, edges, features and bodies in the model for the agent to look at, then press OK","ui.agent_chat_placeholder":"Ask the agent to change the design…","ui.agent_chat_placeholder_busy":"Queue a message for when the agent is done (Ctrl+Enter: send now)","ui.agent_chat_pop_out":"Open in its own window, which you can move to another screen","ui.agent_chat_previous_picture":"Previous picture","ui.agent_chat_privacy":"Nothing goes anywhere except to the agent you run, under your own account.","ui.agent_chat_privacy_note":"The chat itself sends nothing anywhere: the agent you run talks to its own service under your own account. SolidCraft never sees or stores a key or password.","ui.agent_chat_provider_models":"{count} models","ui.agent_chat_provider_other":"Other","ui.agent_chat_provider_tip":"The provider whose models the next list shows.","ui.agent_chat_queue":"Queue","ui.agent_chat_queue_full":"Too many messages are waiting: remove one or wait for the agent.","ui.agent_chat_queued":"Queued","ui.agent_chat_queued_stopped":"Queued (stopped, not sent)","ui.agent_chat_refresh":"Refresh","ui.agent_chat_refused":"Not allowed for the agent: {reason}","ui.agent_chat_reinstall":"{agent} is installed ({program}), but it did not start when SolidCraft checked it: {error}\nIts installation may be incomplete, or made for another kind of computer. Install it again with `{install}`, check that it prints its version in a terminal, then press Refresh.","ui.agent_chat_remove":"Remove from the queue","ui.agent_chat_remove_file":"Take it off this message","ui.agent_chat_remove_imported":"Take it off this message; the part stays in the design (Undo removes it)","ui.agent_chat_reply_cut_off":"The reply reached its length limit before it finished, so it may be incomplete. Ask the agent to go on, or for a shorter answer.","ui.agent_chat_reply_declined":"The model declined to answer this message.","ui.agent_chat_retry":"Retry","ui.agent_chat_right":"Right","ui.agent_chat_save":"Save","ui.agent_chat_send":"Send","ui.agent_chat_send_now":"Send now","ui.agent_chat_send_now_tip":"Stop the agent's current step and send this next (Ctrl+Enter)","ui.agent_chat_setup_body":"SolidCraft talks to a coding agent installed on this computer. Pick one in Preferences › AI.","ui.agent_chat_setup_title":"Set up an assistant","ui.agent_chat_side":"Agent chat side","ui.agent_chat_signed_in":"signed in","ui.agent_chat_state_auth":"Sign-in needed","ui.agent_chat_state_busy":"Working…","ui.agent_chat