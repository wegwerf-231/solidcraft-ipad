se":"Několikrát roztočte kuličku proti směru hodinových ručiček, pak ji nechte zastavit.","ui.3d_mouse_step_tilt_away":"Nakloňte vršek hlavice od sebe (okraj nejblíž vám jde nahoru), podržte a pusťte.","ui.3d_mouse_step_tilt_left":"Nakloňte hlavici doleva (levá hrana dolů), podržte a pusťte.","ui.3d_mouse_step_tilt_right":"Nakloňte hlavici doprava (pravá hrana dolů), podržte a pusťte.","ui.3d_mouse_step_tilt_toward":"Nakloňte vršek hlavice k sobě (okraj nejblíž vám jde dolů), podržte a pusťte.","ui.3d_mouse_step_touch":"Položte ruku na hlavici, ale netlačte na ni.","ui.3d_mouse_step_twist_clockwise":"Otočte hlavici po směru hodinových ručiček, podržte a pusťte.","ui.3d_mouse_step_twist_counterclockwise":"Otočte hlavici proti směru hodinových ručiček, podržte a pusťte.","ui.3d_mouse_switch_cap":"Kalibrovat jako návrat do středu","ui.3d_mouse_switch_trackball":"Kalibrovat jako trackball","ui.3d_mouse_use_direct":"Použít přímý ovladač","ui.3d_mouse_use_direct_tip":"Číst 3D myš přímo (hidraw) místo přes spacenavd.","ui.3d_mouse_view_axis":"Osa pohledu","ui.3d_mouse_view_off":"Vypnuto","ui.3d_mouse_view_off_tip":"Profil ovladače 3D myši tuto osu vypíná, takže její pohyb s pohledem nehýbe. Když tu vyberete pohyb jiné osy, prohodí se s ní a s pohledem přestane hýbat.","ui.3d_mouse_view_orbit_sideways":"Orbit vlevo / vpravo","ui.3d_mouse_view_orbit_up_down":"Orbit nahoru / dolů","ui.3d_mouse_view_pan_sideways":"Posun vlevo / vpravo","ui.3d_mouse_view_pan_up_down":"Posun nahoru / dolů","ui.3d_mouse_view_roll":"Natočení","ui.3d_mouse_view_unmapped":"Osa {n}","ui.3d_mouse_view_zoom":"Zoom","ui.3d_mouse_waiting":"Čeká na pohyb","ui.3d_mouse_wiggle":"Pokud máte nějakou připojenou, zahýbejte s ní.","ui.3d_sketch":"3D náčrt","ui.activate":"Aktivovat","ui.active_component":"Aktivní komponenta","ui.add_configuration":"Přidat konfiguraci","ui.add_parameter":"Přidat parametr","ui.agent_chat":"Chat s agentem","ui.agent_chat_add":"Připojit soubory","ui.agent_chat_add_file":"Vybrat soubor…","ui.agent_chat_allow":"Povolit","ui.agent_chat_allow_once":"Povolit jednou","ui.agent_chat_allowed":"Povoleno","ui.agent_chat_answered":"Odpověď: {option}","ui.agent_chat_approval":"Povolit agentovi tuto akci?","ui.agent_chat_attach_selection":"Přiložit výběr","ui.agent_chat_attach_selection_tip":"Odešle se zprávou to, co je v modelu vybráno (plochy, hrany, prvky, tělesa), aby agent věděl, co máte na mysli","ui.agent_chat_attach_view":"Přiložit pohled","ui.agent_chat_attach_view_tip":"Odeslat se zprávou obrázek aktuálního pohledu","ui.agent_chat_attachable":"Obrázky, PDF, text a soubory CAD","ui.agent_chat_auth_agent":"Přihlásit se přes {name}","ui.agent_chat_auth_env":"Nastavte {vars} v proměnných prostředí a restartujte SolidCraft.","ui.agent_chat_auth_needed":"Agent žádá o přihlášení. Přihlašujete se přímo u agenta; SolidCraft vaše heslo ani klíče nikdy nevidí.","ui.agent_chat_auth_none":"Agent zde nenabízí žádný způsob přihlášení: přihlaste se podle jeho vlastní dokumentace.","ui.agent_chat_auth_retry":"Přihlásil(a) jsem se: připojit znovu","ui.agent_chat_auth_terminal":"Spusťte toto v terminálu a pak znovu stiskněte Připojit:","ui.agent_chat_auth_title":"Přihlásit se k agentovi","ui.agent_chat_cancel":"Zrušit","ui.agent_chat_cannot_start":"Nainstalováno, ale nespouští se: {error}","ui.agent_chat_changes":"Změny: {n}, jeden krok zpět","ui.agent_chat_changes_n":"Změn: {n}","ui.agent_chat_changes_of":"Změny: {n}/{limit}","ui.agent_chat_choose_model":"Vybrat model","ui.agent_chat_close":"Zavřít","ui.agent_chat_command":"Příkaz agenta","ui.agent_chat_connect":"Připojit","ui.agent_chat_copy":"Kopírovat","ui.agent_chat_ctx_bodies":"Tělesa","ui.agent_chat_ctx_elements":"Elementy","ui.agent_chat_ctx_features":"Prvky","ui.agent_chat_ctx_more":"+{n} dalších","ui.agent_chat_ctx_other":"Jiné","ui.agent_chat_custom_hint":"Jakýkoli program, který komunikuje protokolem Agent Client Protocol přes stdin a stdout. Nespouští se přes shell.","ui.agent_chat_denied":"Zamítnuto","