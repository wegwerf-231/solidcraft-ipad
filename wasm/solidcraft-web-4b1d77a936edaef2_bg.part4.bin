ender.lighting_used":"{used} / {limit}","render.lighting_width":"Chiều rộng U","render.lighting_world_position":"Thế giới X Y Z","render.lights_fixed_to":"Đèn gắn cố định với","render.linear_help":"Giữ lại bản gốc RGBA số thực 32-bit trước khi khử nhiễu, phơi sáng, ánh xạ sắc điệu, lọc và phông nền. Tuyến tính sRGB/D65; nhân trước với độ phủ. Bộ nhớ bổ sung được tiếp nhận rõ ràng. Không nén hay thêm kênh phụ.","render.linear_retain":"Giữ lại tệp EXR tuyến tính thô","render.linear_unavailable":"Khung hình đã hoàn thành được chọn không giữ lại EXR. Hãy bật tính năng lưu giữ trước khi kết xuất; ảnh PNG cũ không thể khôi phục lại suất bức xạ thô.","render.look_add":"Thêm phong cách màu sắc","render.look_applied":"Đã áp dụng {name}","render.look_bleach":"Phong cách bỏ qua tẩy trắng (Bleach Bypass)","render.look_cool":"Tông lạnh","render.look_cyanotype":"Phong cách in xanh (Cyanotype)","render.look_faded":"Ảnh in bạc màu","render.look_material":"Vật liệu","render.look_mono":"Đơn sắc (Trắng đen)","render.look_pasted":"Đã dán diện mạo","render.look_sepia":"Nâu đỏ (Sepia)","render.look_strength":"Cường độ phong cách","render.look_teal_orange":"Xanh mòng két / Cam (Teal & Orange)","render.look_title":"Chồng lớp phong cách sáng tạo","render.look_warm":"Tông ấm","render.mapping_scale":"Hệ số nhân lặp lại vật lý","render.material_absorption":"Độ hấp thụ R · G · B (trên mỗi mm)","render.material_add":"Thêm hoặc chỉnh sửa khối này","render.material_assignments":"Gán cho khối","render.material_binding_enable":"Bao gồm cài đặt khối này","render.material_box":"Hộp căn chỉnh theo trục","render.material_browse":"Chọn hình ảnh…","render.material_certification":"Thủy tinh kín sử dụng khoảng cách hình học. Tô pô, hướng, giao cắt và ranh giới quang học được xác thực trong quá trình chuẩn bị GPU; Lệnh kiểm tra chỉ xác nhận tiếp nhận yêu cầu.","render.material_choose_body":"Chọn một khối trong cảnh","render.material_closed":"Lưới khối đặc kín","render.material_coat":"Lớp phủ bóng trong suốt trên vật liệu cơ sở","render.material_coat_enable":"Bật lớp phủ bóng","render.material_coat_help":"Lớp phủ điện môi minh họa trên diện mạo đục hiện có. Trọng số bằng 0 giữ nguyên vật liệu cơ sở.","render.material_color_map":"Ảnh màu cơ sở (sRGB)","render.material_color_replace":"Bản đồ cơ sở thay thế màu khối","render.material_custom":"Quang học minh họa tùy chỉnh","render.material_enable":"Sử dụng các ghi đè vật liệu GPU này","render.material_filter":"Lọc các khối trong cảnh…","render.material_filter_help":"Hiển thị tối đa 128 khối phù hợp. Thu hẹp bộ lọc cho các cảnh lớn.","render.material_glass":"Thủy tinh và độ hấp thụ quang học","render.material_glass_enable":"Sử dụng thủy tinh vật lý trên khối này","render.material_glass_exclusive":"Trong bộ kết xuất này, thủy tinh không thể cùng dùng trên một khối với lớp phủ bóng hoặc bản đồ thời gian chạy.","render.material_glass_help":"Công thức minh họa gốc. Ô màu hiển thị độ truyền qua, không phải bản xem trước kết xuất. Độ hấp thụ là −ln(độ truyền qua tuyến tính) / khoảng cách tham chiếu; alpha không đổi.","render.material_gpu_required":"Các ghi đè vật liệu đang hoạt động này yêu cầu dò đường truyền tia GPU. Hãy chọn GPU hoặc tắt các ghi đè trước khi Kiểm tra hoặc Bắt đầu.","render.material_ior":"Chiết suất (IOR)","render.material_limits":"Tối đa 128 ghi đè khối, 32 khối thủy tinh rời nhau, 64 lớp phủ bóng và 128 liên kết kết cấu. Bản đồ giống nhau chia sẻ bộ nhớ; giới hạn thiết bị và tổng bộ nhớ thực tế vẫn áp dụng.","render.material_map_invalid":"Đường dẫn bản đồ phải là đường dẫn cục bộ có giới hạn; cường độ pháp tuyến phải hữu hạn và trong khoảng 0 đến 1.","render.material_map_required":"Chọn ảnh màu hoặc ảnh pháp tuyến trước khi sử dụng bản đồ.","render.material_maps":"Bản đồ phẳng màu và pháp tuyến","render.material_maps_enable":"Bật bản đồ cho khối đục này","render.material_maps_help":"Định dạng PNG/JPEG tối đa 1024×1024; tổng dữ liệu mã hóa tối đa 16 MiB. U và V là các véc-tơ lặp lại trực giao theo mm thế giới (tối đa 128 lần lặp). Màu sắc là sRGB; dữ liệu pháp tuyến dùng OpenGL +Y. Tệp được ghi nhận khi Kiểm tra/Bắt đầu.","render.material_metallic_map":"Bản đồ độ kim loại (tuyến tính)","render.material_normal_map":"Ảnh pháp tuyến (OpenGL, +Y)","render.material_normal_strength":"Cường độ pháp tuyến (0–1)","render.material_origin":"Gốc ánh xạ X · Y · Z (mm)","render.material_refresh":"Làm mới danh sách khối cảnh","render.material_refresh_needed":"Khung cảnh đã thay đổi. Hãy làm mới danh sách khối trước khi thêm mục tiêu.","render.material_remove":"Xóa phép gán này","render.material_repeat_u":"Một chu kỳ U X · Y · Z (mm)","render.material_repeat_v":"Một chu kỳ V X · Y · Z (mm)","render.material_revalidate":"Xác thực lại khối này","render.material_revalidate_needed":"Phép gán này thuộc về phiên bản cảnh trước đó. Hãy xác thực lại danh tính khối chính xác trước khi kết xuất.","render.material_roughness":"Độ nhám lớp phủ bóng (0.045–1)","render.material_roughness_map":"Bản đồ độ nhám (tuyến tính)","render.material_shadow":"Truyền các tia bóng đổ thẳng","render.material_target_missing":"Thứ tự khối và tên không còn khớp. Hãy xóa phép gán này và chọn lại khối mong muốn một cách rõ ràng.","render.material_thickness":"Độ dày tấm mỏng (mm)","render.material_thin":"Tấm mỏng","render.material_title":"Vật liệu hình ảnh GPU","render.material_transient":"Ghi đè quang học tạm thời cho tab tài liệu này. Chúng không được lưu trong thiết kế, thiết lập kết xuất hoặc thư viện vật liệu.","render.material_v_up":"Trục V kết cấu hướng lên trên trong ảnh","render.material_weight":"Trọng số lớp phủ bóng (0–1)","render.method_cpu":"Dò tia trên CPU","render.method_gpu":"Dò đường truyền tia trên GPU (Path Tracing)","render.method_limit_raster":"Quét mảng (Raster) dùng bản xem trước studio đục cố định. Chọn phương thức dò tia rõ ràng để dùng các điều khiển quang học được hỗ trợ.","render.method_raster":"Quét mảng CPU (Raster)","render.navigation_help":"Camera di chuyển tương tự như trong Thiết kế (Tùy chọn cài đặt › Điều hướng). Lưu thiết lập sẽ ghi lại camera hiện tại.","render.nested_enable":"Chất điện môi lồng nhau đã xác thực","render.nested_help":"Tối đa 16 lớp chứa nhau; mỗi khối cha phải là khối lồi và mọi khối con phải nằm hoàn toàn bên trong. Từ chối giao cắt, bề mặt tiếp xúc, tấm mỏng và bóng đổ thẳng. Trạng thái camera bên trong tuân theo hệ thống phân cấp đã xác thực. Không tạo bề mặt chất lỏng hoặc hợp nhất các ranh giới CAD tiếp xúc.","render.opaque_image_summary":"Xem trước PNG · PBR không trong suốt · trộn độ trong suốt","render.opaque_preview_help":"PBR không trong suốt và màu sắc đơn giản; trộn độ trong suốt. Khúc xạ, HDRI và kết xuất cuối cùng hiện chưa khả dụng.","render.optics_remove":"Xóa cài đặt quang học đã lưu","render.optics_replace":"Chủ động thay thế cài đặt quang học đã lưu của mục tiêu này","render.optics_save":"Lưu cài đặt quang học này vào thiết lập","render.optics_saved":"Các mục tiêu quang học đã lưu","render.optics_saved_help":"Định danh chính xác về định nghĩa, tính năng và thực thể được duy trì sau khi mở lại ngoại tuyến. Từ chối các mục tiêu bị thiếu/thay thế/ẩn; vật liệu kỹ thuật không đổi. Hãy lưu hoặc hủy các chỉnh sửa số trước khi xóa mục tiêu đã lưu.","render.outer_half_angle":"Nửa góc ngoài","render.output_advanced":"Nâng cao","render.output_backend_ready":"Sẵn sàng","render.output_check":"Kiểm tra","render.output_check_failed":"Kiểm tra · lỗi","render.output_check_help":"Chạy Kiểm tra để xem lại yêu cầu này mà không bắt đầu kết xuất.","render.output_check_summary":"Kiểm tra · Ghi chú: {count}","render.output_copy":"Sao chép","render.output_copy_report":"Sao chép báo cáo","render.output_destination":"Đích","render.output_destination_help":"Chọn tệp đích khi xuất ảnh đã hoàn tất.","render.output_dimensions":"Kích thước","render.output_effects":"Hiệu ứng","render.output_export":"Xuất PNG…","render.output_exr_unavailable":"Thiết lập đầu ra EXR không khả dụng ở đây. Xuất EXR tuyến tính cần ảnh GPU đã hoàn tất với bản gốc tuyến tính được giữ lại.","render.output_fit":"Vừa khít","render.output_format":"Định dạng","render.output_format_status":"PNG là hình ảnh hiển thị hoàn chỉnh chính xác. EXR tùy chọn trên GPU giữ lại suất bức xạ FLOAT32 tuyến tính cảnh thô trước các bộ lọc hiển thị. Xuất không bao giờ thay thế bằng bộ nhớ đệm xem trước hoặc tác vụ khác.","render.output_grading":"Chỉnh màu","render.output_image":"Ảnh","render.output_largest":"Tối đa {width} × {height}","render.output_lock_ratio":"Khóa tỷ lệ khung hình","render.output_over_budget":"Hình ảnh yêu cầu vượt quá giới hạn tài nguyên đã chọn. Hãy chủ động chọn kích thước hoặc cấu hình tương thích; không tự động hạ cấp chất lượng.","render.output_presets_help":"Định dạng, chất lượng và danh sách Kiểm tra nằm trong trình chỉnh Đầu ra.","render.output_quality":"Chất lượng","render.output_quality_waiting":"đang chờ hợp đồng chất lượng","render.output_ratio_refused":"Kích thước liên kết vượt quá giới hạn của phương thức này. Kích thước cũ được giữ lại; hãy mở khóa tỷ lệ hoặc chọn giá trị nhỏ hơn.","render.output_ready":"Sẵn sàng kết xuất","render.output_run_check":"Chạy kiểm tra","render.output_size_limit":"{method}: tối đa {dimension} px mỗi cạnh và {pixels} điểm ảnh. Kích thước lớn nhất vừa khít: {width} × {height}.","render.output_size_method_profile":"Để kết xuất {width} × {height}, hãy chọn {method} với cấu hình tài nguyên CPU {profile} hoặc một kích thước nhỏ hơn.","render.output_size_ok":"Kích thước ổn · {width} × {height} px","render.output_size_profile":"Để kết xuất {width} × {height}, hãy chọn cấu hình tài nguyên CPU {profile} hoặc một kích thước nhỏ hơn.","render.output_swap_orientation":"Hoán đổi chiều rộng và chiều cao","render.output_tools_inspector":"Chỉnh kích thước và định dạng trong bảng thuộc tính Đầu ra.","render.output_view_image":"Xem ảnh","render.page_aging":"Lão hóa và bám bẩn","render.page_all":"Tất cả điều khiển","render.page_appearance":"Diện mạo","render.page_background":"Hình nền","render.page_camera":"Camera","render.page_diagnostics":"Chẩn đoán","render.page_effects":"Ống kính và hiệu ứng hoàn thiện","render.page_environment":"Môi trường","render.page_lighting":"Chiếu sáng","render.page_output":"Đầu ra","render.page_scene":"Khung cảnh","render.paint_label":"Tô","render.painting_with":"Đang tô bằng {name}","render.passive_stage":"Mặt sàn và sân khấu thụ động","render.passive_stage_help":"Các tấm thụ động hữu hạn chỉ thuộc về hình ảnh kết xuất. Chúng không thêm khối CAD hay khối lượng. Vị trí được cố định sau khi áp dụng; giao cắt với ranh giới sản phẩm sẽ bị từ chối. CPU không cung cấp ánh sáng nảy khuếch tán.","render.perspective":"Camera phối cảnh","render.physical_acknowledge":"Tôi hiểu rằng tham chiếu một phần này cần xem xét mác thép/vật liệu, điều kiện và nguồn gốc","render.physical_associations":"Ứng viên vật lý và vai trò","render.physical_background_help":"Sàn và tường thụ động thực tế, tách biệt với phông nền camera. Phông cong vô cực (Cyclorama) sử dụng 24 dải đa giác; không phải bề mặt vô hạn hay mượt mà giải tích. Chỉ thay thế sân khấu đã lưu khi có sự đồng ý của bạn.","render.physical_copy_plan":"Sao chép kế hoạch kèm nguồn gốc và các mục lược bỏ","render.physical_cyclorama":"Khớp phông cong vô cực đa giác","render.physical_floor_wall":"Khớp sàn và tường vật lý","render.physical_material_name":"Tên vật liệu tham chiếu đề xuất","render.physical_omissions":"Các đặc tính không thể biểu diễn trong thẻ vật liệu gốc","render.physical_plan_only":"Đã chuẩn bị kế hoạch chỉ đọc. Chưa có vật liệu nào được tạo hoặc gán. Hãy giữ lại hồ sơ mở rộng và các mục lược bỏ khi xem xét thẻ gốc.","render.physical_prepare_plan":"Chuẩn bị kế hoạch tạo (không áp dụng)","render.physical_separate":"Diện mạo không phải là định danh vật liệu. Đây là các tham chiếu có nguồn gốc, không phải đặc tính hiệu dụng được chứng nhận. Khối lượng, vật liệu kỹ thuật và quang học hiện có giữ nguyên.","render.physical_unknown":"Chưa xác định ứng viên số học. Phải chỉ định mác, công thức hoặc cấu tạo; chưa rõ không có nghĩa là bằng 0.","render.pick_body":"Thân","render.pick_component":"Thành phần","render.pick_face":"Mặt","render.pick_help":"Chọn Thân, Mặt hoặc Thành phần. Bấm vào chỗ trống để bỏ chọn; Shift hoặc Ctrl để thêm hoặc đảo. Phần tô sáng chỉ hiện ở chế độ xem sản phẩm trực tiếp.","render.pick_label":"Chọn","render.pick_up_label":"Lấy","render.pick_up_prompt":"Bấm vào một đối tượng để lấy diện mạo của nó","render.pick_waiting":"Chưa hỗ trợ chọn sản phẩm.","render.post_contrast":"Độ tương phản","render.post_gain_b":"Khuếch đại xanh lam (Blue)","render.post_gain_g":"Khuếch đại xanh lục (Green)","render.post_gain_r":"Khuếch đại đỏ (Red)","render.post_help":"Chỉ dùng cho hiển thị sáng tạo. Độ khuếch đại RGB áp dụng trước ánh xạ sắc điệu; độ tương phản, độ bão hòa và tối góc áp dụng sau trong ánh sáng tuyến tính hiển thị. Bắt đầu kết xuất sẽ tạo các mẫu truyền dẫn mới. Chỉnh màu lại sử dụng bản gốc thô được chọn mà không cần khử nhiễu hay dò tia mới.","render.post_reset":"Đặt lại bộ lọc trình chiếu","render.post_saturation":"Độ bão hòa","render.post_title":"Bộ lọc trình chiếu","render.post_vignette":"Hiệu ứng tối góc (Vignette)","render.preview":"Xem trước tích hợp","render.preview_help":"Đổ bóng raster và trộn độ trong suốt. Khúc xạ, HDRI và kết xuất cuối cùng hiện chưa khả dụng.","render.preview_image_settings_help":"Xem trước trực tiếp giữ nguyên ánh sáng studio cố định. Độ phơi sáng và ánh sáng hình ảnh sẽ áp dụng cho tác vụ khi bạn Kiểm tra hoặc Bắt đầu.","render.preview_lighting_help":"Bản xem trước trực tiếp chỉ hiện ánh sáng trực tiếp và không có bóng đổ.","render.preview_retry":"Thử lại xem trước trực tiếp","render.preview_unavailable_help":"Bản xem trước trực tiếp không khả dụng. Các thiết lập đã lưu và điều khiển tác vụ ảnh vẫn có thể truy cập. Hãy thay đổi cảnh hoặc thử lại; cảnh bị từ chối sẽ không được dựng lại trên mỗi khung hình.","render.preview_upload":"Dung lượng đỉnh xem trước trực tiếp","render.preview_upload_help":"Số byte đỉnh xem trước chính xác, không phải tổng bộ nhớ GPU hay tiến trình. Hình học không bị đơn giản hóa. Các tác vụ hình ảnh dùng kiểm tra tiếp nhận và ánh sáng riêng.","render.progressive_image_summary":"PNG xem trước · PBR và thủy tinh · mẫu lũy tiến","render.property_conditions":"Điều kiện: {value}","render.property_fallback":"thuộc tính","render.property_qualifier":"Bộ định tính: {value}","render.property_source":"Nguồn: {id} - {locator}","render.property_uncertainty":"Độ bất định: {value}","render.property_unknown":"không rõ","render.quality_ack":"Xác nhận phép chiếu định mức cố định và các mục lược bỏ","render.quality_apply":"Sử dụng định mức lấy mẫu cố định này","render.quality_balanced":"Cân bằng","render.quality_custom":"Tùy chỉnh","render.quality_draft":"Bản nháp","render.quality_high":"Cao","render.quality_projection_help":"Các thiết lập sẵn Q bao gồm các yêu cầu tương lai. Hành động này chỉ chiếu định mức mẫu PNG cố định được hỗ trợ và lược bỏ rõ ràng việc dừng thích ứng, đầu ra tuyến tính thô và các giới hạn truyền dẫn độc lập.","render.quality_review":"Xem xét định mức lấy mẫu","render.queue_pending":"Không có hàng đợi sản xuất tự động hay bộ kết xuất hoạt hình trong giao diện này. Ảnh tĩnh đã hoàn thành vẫn có thể xuất riêng lẻ.","render.radial_assign":"Gán diện mạo","render.radial_compare":"So sánh","render.radial_distortion":"Độ méo hướng tâm","render.radial_fit":"Vừa sản phẩm","render.radial_save":"Lưu cảnh chụp","render.recent_looks":"Diện mạo gần đây","render.regrade_action":"Chỉnh màu lại bản gốc thô (không khử nhiễu)","render.regrade_help":"Tạo một ảnh PNG riêng biệt từ bản gốc thô đã hoàn thành được chọn, sử dụng các điều khiển trình chiếu này. Không dò lại tia, không đổi kích thước/camera/ánh sáng đã ghi nhận, và không ghi đè tệp EXR. Bộ khử nhiễu không áp dụng lại do bản gốc thô không giữ dữ liệu dẫn hướng. Bản phái sinh vẫn có thể xuất qua cùng điều khiển tác vụ.","render.regrade_label":"Chỉnh lại màu","render.reload_settings":"Tải lại cài đặt đã lưu","render.remove_override":"Gỡ ghi đè","render.replace_all":"Thay tất cả","render.replace_ground":"Xác nhận thay thế sân khấu hiện có","render.replace_label":"Thay","render.replace_saved_surface":"Thay thế liên kết đã lưu hiện có cho mục tiêu này","render.replace_with":"Thay bằng","render.restore_camera":"Khôi phục camera đã lưu","render.result_actual":"100%","render.result_actual_help":"Một pixel hình ảnh tương ứng một pixel màn hình hiển thị.","render.result_actual_size":"100%","render.result_capture":"Phiên bản đã ghi nhận","render.result_current":"Phiên bản mô hình đã ghi nhận là phiên bản hiện tại.","render.result_empty":"Chưa có hình ảnh nào hoàn thành. Hãy kiểm tra cài đặt rồi bắt đầu kết xuất.","render.result_fit":"Vừa khung hình","render.result_job":"Tác vụ","render.result_navigation":"Thu phóng và lia theo tùy chọn Điều hướng. Nhấn phím cách + kéo rê để lia.","render.result_open":"Mở hình ảnh đã hoàn thành trong khung vẽ chính.","render.result_preview":"Xem trước trực tiếp","render.result_provisional":"Hình ảnh CPU tạm thời","render.result_provisional_help":"Điểm kiểm tra trung gian này không thể xuất. Lệnh xuất giữ lại kết quả hoàn thành gần nhất; hủy bỏ sẽ quay lại kết quả đó.","render.result_reduced_display":"Bản xem trước hiển thị bị thu nhỏ theo giới hạn bộ nhớ đệm/thiết bị của khung nhìn. Tệp PNG được giữ lại và tệp xuất vẫn giữ nguyên độ phân giải đầy đủ; chế độ kiểm tra gốc 100% không khả dụng cho chế độ xem thu nhỏ này.","render.result_retained":"Đang hiển thị hình ảnh hoàn thành gần nhất; kết xuất mới hơn chưa thay thế nó.","render.result_sequence":"Điểm kiểm tra trung gian","render.result_title":"Kết quả kết xuất","render.return_design":"Quay lại thiết kế","render.review_stale":"Kết quả xem xét này đã cũ. Hãy xử lý hoặc kiểm tra lại trước khi áp dụng.","render.ribbon_aging":"Lão hóa","render.ribbon_backgrounds":"Hình nền","render.ribbon_check":"Kiểm tra","render.ribbon_check_help":"Xác thực bản nháp hiện tại chính xác mà lệnh Kết xuất sẽ gửi đi. Không tự động chuyển bộ kết xuất, thu nhỏ kích thước hay thay thế tài nguyên.","render.ribbon_edit_lights":"Chỉnh sửa ánh sáng","render.ribbon_effects":"Hiệu ứng","render.ribbon_environment_help":"Chiếu sáng HDR, phông nền chỉ cho camera và bề mặt sân khấu vật lý là các điều khiển riêng biệt cần sự đồng ý rõ ràng khi thay thế.","render.ribbon_finish_dialog":"Hãy hoàn tất hộp thoại tệp hoặc xác nhận hiện tại trước.","render.ribbon_frame":"Căn khung","render.ribbon_hdr_library":"Thư viện HDR","render.ribbon_job_active":"Một tác vụ kết xuất đang chạy; hãy chủ động hủy nó trước khi bắt đầu tác vụ khác.","render.ribbon_light_rigs":"Bộ đèn chiếu sáng","render.ribbon_lights_help":"Kiểm tra bộ đèn đã tạo hoặc chỉnh sửa nguồn sáng được hỗ trợ mà không thay thế thiết lập hiện tại cho đến khi bạn chủ động áp dụng thay đổi.","render.ribbon_materials":"Vật liệu","render.ribbon_materials_help":"Mở bảng kiểm tra diện mạo dùng chung và thư viện bề mặt gốc. Chỉnh sửa quang học không bao giờ âm thầm thay đổi đặc tính kỹ thuật.","render.ribbon_no_active_job":"Không có tác vụ kết xuất nào đang hoạt động để hủy.","render.ribbon_no_result":"Hoàn tất kết xuất trước khi xuất hình ảnh chính xác của nó.","render.ribbon_no_saved_camera":"Lưu khung hình trước khi khôi phục camera của nó.","render.ribbon_saved_camera":"Camera đã lưu","render.ribbon_shots":"Khung hình (Shots)","render.ribbon_studios":"Studio","render.ribbon_studios_help":"Duyệt các bố cục studio đã triển khai và xem xét nội dung thay thế trước khi áp dụng. Khung cảnh chỉ mang tính ý niệm vẫn được gắn nhãn rõ ràng.","render.ribbon_surface_maps":"Bản đồ bề mặt","render.sampling_title":"Lấy mẫu thích ứng và truyền dẫn","render.save_continue":"Lưu và tiếp tục","render.save_setup":"Lưu thiết lập","render.save_shot":"Lưu cảnh chụp","render.saved_maps_runtime_conflict":"Liên kết bề mặt đã lưu không thể kết hợp với ghi đè quang học tạm thời hoặc tệp HDR chưa lưu. Hãy lưu HDR hoặc chủ động xóa các đầu vào tạm thời.","render.saved_surface_remove":"Xóa liên kết đã lưu","render.saved_surfaces":"Liên kết bề mặt đã lưu","render.saved_surfaces_help":"Bản đồ tích hợp được ghim sẽ đi theo thực thể đã chọn theo đơn vị milimét cục bộ. Mục tiêu bị thay thế hoặc thiếu là một lỗi, tuyệt đối không tự động gán lại.","render.scene_all_shots":"Mọi cảnh chụp ({count})","render.scene_apply":"Áp dụng studio đã xem xét","render.scene_batch_reason":"Mọi cảnh chụp cần hàng đợi kết xuất cảnh chụp đã lưu, chưa khả dụng.","render.scene_check_now":"Kiểm tra ngay","render.scene_check_passed":"Kiểm tra đạt · {notes} ghi chú","render.scene_check_stale":"Kết quả kiểm tra đã cũ · hãy kiểm tra lại","render.scene_check_unchecked":"Chưa kiểm tra · 0 ghi chú","render.scene_consent":"Xác nhận thay thế chiếu sáng, môi trường, độ phơi sáng và sân khấu","render.scene_light_summary":"{environment} · {lights} đèn","render.scene_look_summary":"{looks} diện mạo · {overrides} ghi đè","render.scene_open_check":"Mở kiểm tra","render.scene_preserved_fields":"Camera, lấy mẫu, kích thước, liên kết quang học, hình học CAD và vật liệu kỹ thuật được giữ nguyên.","render.scene_preserves_design":"Bố cục ánh sáng và sân khấu thụ động cho chủ thể hiển thị. Hình học, vật liệu kỹ thuật và camera luôn giữ tách biệt.","render.scene_ready":"Sẵn sàng kết xuất","render.scene_reminder":"Cảnh giữ nguyên thiết kế. Hình học, thuộc tính kỹ thuật và CAD không bao giờ bị đổi từ Kết xuất.","render.scene_reminders":"Nhắc nhở","render.scene_renderer_ready":"{renderer} sẵn sàng","render.scene_replaces":"Nội dung thay thế","render.scene_review":"Xử lý và xem xét","render.scene_review_help":"Xem xét toàn bộ tổ hợp gốc trước khi áp dụng. Không tự động thay thế bằng các thông số kỹ thuật SCENE nâng cao chưa liên kết.","render.scene_scope_details":"Phạm vi tổ hợp","render.scene_stages":"Giai đoạn","render.search_appearances":"Tìm trong {count} diện mạo","render.setup_legacy_environment":"Thiết lập cũ này sử dụng góc xoay hoặc cường độ môi trường kiểu cũ. Các giá trị đó được giữ lại; hãy chủ động chuyển đổi trước khi lưu toàn bộ tác vụ hình ảnh.","render.setup_name":"Tên thiết lập","render.setup_numeric_help":"Lưu sẽ ghi lại phương thức tạo ảnh đang hoạt động và tất cả cài đặt số của nó. Tải lại hoặc chọn thiết lập khác sẽ thay thế bản nháp này; khôi phục camera riêng biệt.","render.setup_offline_help":"Bạn có thể chỉnh sửa và lưu phương thức này mà không cần bộ kết xuất của nó. Kiểm tra và Bắt đầu yêu cầu một máy chủ thực thi khả dụng.","render.setup_runtime_unsupported":"Toàn bộ tác vụ này chưa thể lưu: nó chứa bản đồ hoặc liên kết khối trong cảnh. Hãy xóa các đầu vào tạm thời đó trước khi lưu thiết lập di động.","render.setup_save_missing":"Không tìm thấy cấu hình kết xuất đã lưu sau khi lệnh hoàn tất.","render.sharpening":"Làm sắc nét chi tiết","render.shell_tab_appearance":"DIỆN MẠO KẾT XUẤT","render.shell_tab_camera":"MÁY ẢNH KẾT XUẤT","render.shell_tab_lighting":"ÁNH SÁNG","render.shell_tab_scene":"CẢNH KẾT XUẤT","render.shot_aperture":"Khẩu độ","render.shot_distance":"Khoảng cách","render.shot_dof":"Độ sâu trường ảnh","render.shot_duplicate":"Nhân bản khung hình đã lưu","render.shot_edit_output":"Sửa trong Đầu ra","render.shot_exposure_reason":"Phơi sáng cần dò tia bằng CPU hoặc dò đường đi của tia bằng GPU.","render.shot_exposure_section":"Phơi sáng","render.shot_focus_distance":"Khoảng cách lấy nét","render.shot_fov_reason":"Trường nhìn cần phép chiếu phối cảnh.","render.shot_frame_subject":"Lấy khung đối tượng","render.shot_invalid_camera":"Giá trị máy ảnh phải hữu hạn và trong phạm vi.","render.shot_lens":"Ống kính","render.shot_lens_enable_reason":"Bật độ sâu trường ảnh để chỉnh khẩu độ và khoảng cách lấy nét.","render.shot_lens_gpu_reason":"Độ sâu trường ảnh cần dò đường đi của tia bằng GPU.","render.shot_lens_perspective_reason":"Độ sâu trường ảnh cần phép chiếu phối cảnh.","render.shot_look_selection":"Nhìn vào vùng chọn","render.shot_manager":"Khung hình đã lưu","render.shot_new_name":"Tên khung hình mới","render.shot_remove":"Xóa khung hình đã lưu","render.shot_remove_help":"Chỉ xóa thiết lập đã lưu này. Hình học nguồn và hình ảnh hoàn thành được giữ nguyên; thao tác có thể hoàn tác.","render.shot_remove_title":"Xóa khung hình đã lưu?","render.shot_rename":"Đổi tên khung hình đã lưu","render.shot_saved_only":"Hãy lưu bản nháp hiện tại trước. Nhân bản và đổi tên sẽ giữ nguyên các tùy chọn đã lưu và tham chiếu tài nguyên chính xác.","render.shot_selection_reason":"Chọn một thân hoặc mặt để nhắm tới.","render.shot_size":"Kích thước","render.shot_target":"Mục tiêu","render.shots_camera_changed":"Máy ảnh đã đổi kể từ khi lưu cảnh chụp này","render.shots_name_help":"Nhập tên duy nhất cho cảnh chụp hiện tại.","render.shots_no_result":"Chưa kết xuất","render.shots_result":"Kết xuất {number} · {width} × {height}","render.shots_revert":"Hoàn nguyên","render.shots_save":"Lưu cảnh chụp","render.shots_update":"Cập nhật cảnh chụp","render.show_shots_label":"Hiện dải cảnh chụp","render.size_4k":"4K","render.size_4k_uhd":"4K UHD","render.size_custom":"Tùy chỉnh…","render.size_full_hd":"Full HD","render.size_hd":"HD","render.size_needs_profile":"{size} · cần {profile}","render.size_presets":"Cỡ đặt sẵn","render.size_presets_pending":"Sẽ có cùng trình chỉnh Đầu ra","render.size_preview":"Xem trước","render.size_square":"Vuông","render.sky_ground":"Mặt đất · RGB tuyến tính","render.sky_horizon":"Đường chân trời · RGB tuyến tính","render.sky_zenith":"Thiên đỉnh · RGB tuyến tính","render.soft_focus":"Lấy nét mềm (Soft focus)","render.spot_cone":"Chóp đèn rọi","render.stage_frame":"Khung","render.stage_layout.appearance_note":"Bấm để áp dụng cho vùng chọn.","render.stage_layout.studio_note":"Bấm để xem xét trước khi áp dụng.","render.stage_light":"Ánh sáng","render.stage_look":"Giao diện","render.stage_orthographic":"Trực giao","render.stage_output":"Đầu ra","render.stage_panel_count":"Các tấm panel đã lưu","render.stage_panels.acknowledge":"Tôi xác nhận việc thay thế và các giới hạn","render.stage_panels.appearance_note":"Bấm để áp dụng cho vùng chọn. Kéo lên mô hình. Khi không chọn gì, bấm để kích hoạt công cụ Tô.","render.stage_panels.apply":"Áp dụng","render.stage_panels.apply_studio":"Áp dụng studio","render.stage_panels.badge_blocked":"bị chặn","render.stage_panels.badge_native":"gốc","render.stage_panels.badge_projection":"phép chiếu","render.stage_panels.badge_reference":"tham chiếu","render.stage_panels.badge_specification":"chỉ thông số","render.stage_panels.candidate_summary":"Ứng viên: {count} giá trị có nguồn. Cần xem xét mác vật liệu và lớp hoàn thiện.","render.stage_panels.captured_bounds":"Sử dụng ranh giới cảnh đã ghi nhận","render.stage_panels.centre":"Tâm","render.stage_panels.depth":"độ sâu","render.stage_panels.environments":"Môi trường","render.stage_panels.extent":"Phạm vi","render.stage_panels.fit_save":"Khớp và lưu","render.stage_panels.gpu_required":"Cần dò đường đi của tia bằng GPU","render.stage_panels.keep":"Giữ lại","render.stage_panels.kept":"Được giữ lại","render.stage_panels.kept_fields":"Camera, lấy mẫu, kích thước, liên kết quang học, hình học CAD và đặc tính kỹ thuật.","render.stage_panels.kept_quality":"Phương thức, camera, ánh sáng, môi trường, sân khấu, cài đặt quang học, phơi sáng và ánh xạ sắc điệu.","render.stage_panels.mine":"Của tôi","render.stage_panels.mine_pending":"Chưa hỗ trợ lưu studio cá nhân.","render.stage_panels.omits":"Lược bỏ","render.stage_panels.paint_pending":"Chưa hỗ trợ tô và gán bằng cách kéo. Chọn mục tiêu để áp dụng diện mạo.","render.stage_panels.partial_reference":"Ứng viên: chỉ gồm các giá trị có nguồn; hãy xem xét mác vật liệu, điều kiện và nguồn. Giá trị chưa rõ vẫn được giữ là chưa rõ.","render.stage_panels.plane":"Mặt phẳng","render.stage_panels.prepare_plan":"Chuẩn bị kế hoạch tạo","render.stage_panels.projects":"Chiếu","render.stage_panels.quality_ack":"Tôi xác nhận ngân sách cố định và các mục bị lược bỏ","render.stage_panels.quality_omissions":"Dừng thích ứng và mục tiêu sai số, độ sâu truyền dẫn riêng, quy tắc roulette Nga, đầu ra tuyến tính thô, bản gốc EXR và chứng nhận hội tụ.","render.stage_panels.reference":"Tham chiếu","render.stage_panels.references":"Các tham chiếu","render.stage_panels.remove_optics":"Xóa cài đặt quang học","render.stage_panels.remove_optics_help":"Xóa cài đặt quang học đã lưu khỏi khung hình này. Hình học nguồn được giữ lại.","render.stage_panels.remove_optics_title":"Xóa cài đặt quang học đã lưu?","render.stage_panels.remove_shot":"Xóa khung hình","render.stage_panels.remove_stage":"Xóa sân khấu","render.stage_panels.remove_stage_help":"Xóa các tấm thụ động đã lưu khỏi khung hình này. Phông nền camera được giữ lại.","render.stage_panels.remove_stage_title":"Xóa sân khấu đã lưu?","render.stage_panels.repeat":"Lặp lại","render.stage_panels.replaces":"Thay thế","render.stage_panels.replaces_environment":"Môi trường","render.stage_panels.replaces_maps":"Các bản đồ tạm thời trên khối được chọn; có thể xung đột với cài đặt quang học đã lưu.","render.stage_panels.replaces_physical":"Không thay thế gì. Kế hoạch này chỉ đọc.","render.stage_panels.replaces_quality":"Kích thước ảnh, số mẫu cố định, độ sâu đường đi, hạt giống ngẫu nhiên và khử nhiễu.","render.stage_panels.replaces_rig":"Ánh sáng, môi trường và sân khấu","render.stage_panels.replaces_saved_maps":"Các bản đồ bề mặt đã lưu trên khối được chọn; có thể xung đột với ghi đè tạm thời.","render.stage_panels.replaces_stage":"Mặt sàn và các tấm sân khấu thụ động đã lưu","render.stage_panels.replaces_studio":"Ánh sáng, môi trường, phơi sáng và sân khấu","render.stage_panels.replaces_uniform":"Diện mạo đục trên khối được chọn. Các bản đồ không gian được xấp xỉ bằng giá trị đồng nhất.","render.stage_panels.review_environment":"Xem xét môi trường","render.stage_panels.review_maps":"Xem xét bản đồ GPU","render.stage_panels.review_physical":"Kế hoạch tham chiếu vật lý","render.stage_panels.review_quality":"Sử dụng ngân sách lấy mẫu cố định","render.stage_panels.review_rig":"Khớp bộ đ