it_solo":"încă neacceptat: vizibilitatea luminilor și comenzile solo","render.wear_applies_to":"Se aplică la","render.wear_layer_count":"{count} straturi","render.wear_layer_one":"{count} strat","render.wear_layers":"Straturi","render.wear_no_layers":"Niciun strat","render.wear_selected_layer":"Stratul selectat","render.wear_title":"Uzură","sample.bracket.about":"Flanșă de bază cu flanșe pe margini și o pliere de margine, cu regulă de 2 mm","sample.bracket.name":"Suport din tablă","sample.enclosure.about":"Cutie scobită cu buză, bosaje pentru șuruburi, un reazem și o prindere cu clichet","sample.enclosure.name":"Carcasă din plastic","sample.flange.about":"Butuc și flanșă cu matrice circulară condusă de un parametru","sample.flange.name":"Flanșă cu șuruburi","sample.hinge.about":"Două componente și o îmbinare de revoluție, acționată la 60°","sample.hinge.name":"Ansamblu balama","sample.plate.about":"Placă parametrică cu racordări, găuri și un bosaj alezat","sample.plate.name":"Placă exemplu","sample.vents.about":"Canale într-o matrice dreptunghiulară: rândurile, coloanele și pasul sunt parametri","sample.vents.name":"Placă de ventilație","search.command_keys":"Enter execută     Shift+Enter execută și păstrează deschis     Esc închide","search.commands":"Comenzi","search.design":"În acest proiect","search.feature":"Operație","search.invalid":"Nevalid","search.keys":"↑ ↓ alege     Enter execută     Tab completează numele     Esc închide","search.no_match":"Nicio comandă nu corespunde cu „{query}”","search.parameter":"Parametru","search.recent":"Recente","search.run":"Execută comanda","search.suggest":"Ați vrut să spuneți {label}?","search.try":"Tastați numele unei comenzi, o operație din acest proiect sau un parametru. Pentru a executa o comandă cu valori, tastați id-ul ei și un obiect JSON: {example}","search.valid":"Valid","section.off_hint":"Niciun plan ales: OK dezactivează secțiunea.","select a direction (an axis, a sketch line or a straight edge) first":"selectați mai întâi o direcție (o axă, o linie de schiță sau o muchie dreaptă)","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"selectați o direcție (o axă, o linie de schiță sau o muchie dreaptă) pe care să o urmeze profilul","select a point on a component":"selectați un punct de pe o componentă","select a profile, edges or sketch lines first":"selectați mai întâi un profil, muchii sau linii de schiță","select an axis":"selectați o axă","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"selectați mai întâi o axă, o muchie dreaptă sau circulară ori o față de cilindru, de con sau de tor","select bodies first":"selectați mai întâi corpurile","select components first":"selectați mai întâi componentele","select corner points, or the two lines of one corner":"selectați punctele colțurilor sau cele două linii ale unui colț","select one corner point, or the two lines of one corner":"selectați un punct de colț sau cele două linii ale unui colț","select sheet edges first":"selectați mai întâi muchiile tablei","select the bend line (a sketch line) first":"selectați mai întâi linia de îndoire (o linie de schiță)","select the cam's profile (a sketch profile or the cam's edges)":"selectați profilul camei (un profil de schiță sau muchiile camei)","select the corner to cut first":"selectați mai întâi colțul de tăiat","select the corners to round first":"selectați mai întâi colțurile de rotunjit","select the fixed face first (a plate's large face)":"selectați mai întâi fața fixă (fața mare a unei plăci)","select the frame sketch's lines first":"selectați mai întâi liniile schiței cadrului","select the path (sketch lines across the edge)":"selectați traseul (linii de schiță de-a lungul muchiei)","select the rim face first":"selectați mai întâi fața de margine","select the sheet edge first":"selectați mai întâi muchia tablei","select two components":"selectați două componente","set by the sketch's lines":"stabilit de liniile schiței","settings.display_quality_note":"Nivelurile mai fine desenează fețele și muchiile curbe mai neted și durează mai mult la generarea plasei. Se schimbă doar fereastra de vizualizare, niciodată proiectul sau exporturile.","settings.double_click_components":"Faceți dublu clic pe o componentă pentru a o activa sau pentru a edita pe loc una legată","settings.frame_rate_details_note":"Adaugă un grafic cu timpii ultimelor cadre, cu triunghiurile desenate deasupra, o histogramă a timpilor de cadru și ce a desenat GPU-ul. Faceți clic pe rata de cadre din vizualizare pentru a le afișa sau a le ascunde.","settings.frame_rate_note":"Afișează cadrele pe secundă în colțul din dreapta jos al vizualizării.","settings.insert_lists_open_designs":"Inserează proiect listează mai întâi proiectele deschise în alte file","settings.measure_axis_distances":"Afișează distanțele X/Y/Z","settings.measure_axis_distances_help":"Afișează cotele pe axele globale alături de distanța totală cât timp Măsurare este deschis.","settings.msaa_applies_on_restart":"Anti-aliasing se aplică la următoarea pornire a SolidCraft","settings.msaa_reset":"{setting}: {requested}× nu este acceptat de acest dispozitiv grafic; acum este {reset}× (acceptat: {supported}).","settings.msaa_unsupported":"Neacceptat de acest dispozitiv grafic","settings.reference_geometry_through_bodies":"Afișează geometria de referință prin corpuri","settings.reference_geometry_through_bodies_help":"Desenează contururile schițelor inactive și planele de referință peste corpurile umbrite","settings.reset_intro":"Aceste setări nu funcționează pe acest calculator și ar împiedica pornirea SolidCraft, deci au fost modificate:","settings.reset_title":"Setările au fost modificate","settings.supersampling_note":"Desenează vizualizarea la o rezoluție mai mare și o filtrează în jos: muchii, linii și grilă mai netede pe ecrane sub 4K. Costă timp GPU: aproximativ 2,25× pixeli la 1,5× și 4× la 2×.","settings.update_changed_links":"Actualizează proiectele legate modificate la revenirea la o filă","settings.window_system_details":"Detalii","settings.window_system_note_now":"Se aplică după repornire. Acum: {now}.","settings.window_system_wayland_limited":"Unele funcții sunt limitate în Wayland nativ.","sheet.flange_type_base":"Bază","sheet.flange_type_contour":"Contur","sheet.flange_type_edge":"Muchie","sheet.no_body":"nu există un corp din tablă: începeți unul cu Flanșă > Bază sau transformați o placă în tablă cu Convertește în tablă (alegeți fața ei mare și plată)","sheet.personal_rules.confirm_delete":"Confirmă ștergerea","sheet.personal_rules.delete":"Șterge","sheet.personal_rules.delete_prompt":"Ștergeți această regulă personală? Regulile deja existente în proiecte rămân neschimbate.","sheet.personal_rules.full":"Biblioteca personală conține deja 64 de reguli.","sheet.personal_rules.invalid_name":"Introduceți un nume scurt, fără întreruperi de rând sau caractere de control.","sheet.personal_rules.invalid_values":"Completați valorile regulii: fiecare trebuie să poată fi calculată în acest proiect, cu o grosime pozitivă și un factor K între 0 și 1.","sheet.personal_rules.missing":"Regula personală selectată nu mai este disponibilă.","sheet.personal_rules.name":"Numele regulii","sheet.personal_rules.name_exists":"Există deja o regulă personală cu acest nume. Folosiți alt nume.","sheet.personal_rules.name_hint":"Un nume unic","sheet.personal_rules.overwrite":"Salvează modificările în regula personală selectată","sheet.personal_rules.rename":"Redenumește","sheet.personal_rules.rule":"Regulă personală","sheet.personal_rules.save":"Salvează ca nouă","sheet.personal_rules.scope":"Salvată în profil, pentru toate proiectele.","sheet.personal_rules.select":"Alegeți o regulă","sheet.personal_rules.title":"Reguli personale","sheet.personal_rules.unsupported":"Această regulă are valori pe care această versiune nu le poate folosi.","shortcut.json_error":"parametrii trebuie să fie JSON: {error}","shortcut.