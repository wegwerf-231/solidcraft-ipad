kutnom glavom","parts.family.hex_nut":"Šesterokutna matica","parts.family.set_screw":"Bezglavi vijak s unutarnjim šesterokutom, ravni vrh","parts.family.socket_head_cap_screw":"Vijak s cilindričnom glavom i unutarnjim šesterokutom","parts.family.washer":"Obična podloška","parts.holes":"Provrti (neobavezno)","parts.placement_hint":"odaberite jedan ili više provrta kako biste u svaki smjestili dio, ili U redu postavlja dio u ishodište","pattern.alignment_2":"Poravnanje 2","pattern.alignment_hint":"Broj uključuje izvornik. Središte ravnomjerno raspoređuje kopije; Obrni bira dodatnu stranu za parne ukupne brojeve.","pattern.direction_1":"Smjer 1","pattern.direction_2":"Smjer 2","pattern.flip_direction":"Obrni smjer","perf.click_for_details":"Kliknite za pojedinosti: graf vremena okvira, histogram i što je GPU iscrtao","perf.draw_calls":"Pozivi crtanja","perf.line_segments":"Segmenti linija","perf.low_1":"1% najsporijih","perf.renderer":"Iscrtavač","perf.scene_build":"Izgradnja scene","perf.triangles":"Trokuti","perf.ui_time":"Vrijeme sučelja","perf.viewport":"Prozor prikaza","perf.worst":"najgore","pick a body or some of its faces":"odaberite tijelo ili neka njegova lica","pick a hole to seat it, or OK places it at the origin":"odaberite provrt kako biste ga postavili ili ga U redu postavlja u ishodište","pick a planar face":"odaberite ravno lice","pick a plane or a face as the tool":"odaberite ravninu ili lice kao alat","pick a size":"odaberite veličinu","pick edges of a body":"odaberite bridove tijela","pick edges of one body":"odaberite bridove jednog tijela","pick edges of the holes to remove":"odaberite bridove provrta koje treba ukloniti","pick faces of one body":"odaberite lica jednog tijela","pick faces to offset":"odaberite lica za odmak","pick lines of one sketch":"odaberite linije jedne skice","pick one or two vertices, edges or faces":"odaberite jedan ili dva vrha, brida ili lica","pick one plane or face as the tool, or sketch curves":"odaberite jednu ravninu ili lice kao alat ili krivulje skice","pick sections in two or more sketches":"odaberite presjeke u dvije ili više skica","pick sketch curves or edges":"odaberite krivulje skice ili bridove","pick the face to untrim":"odaberite lice za poništavanje odsijecanja","pick the path":"odaberite putanju","pick what to keep":"odaberite što zadržati","pick what to keep of the other surface":"odaberite što zadržati od druge plohe","prefs.add_item":"Dodaj stavku","prefs.alt_frees_manipulators":"Alt / Option također oslobađa strelice manipulatora","prefs.anti_aliasing_amd_dx12":"Zaglađivanje rubova koristi 1× jer početna provjera nije ništa iscrtala s višestrukim uzorkovanjem, a prošla je s 1×. Iznad možete odabrati drugu postavku; ponovno pokrenite program kako biste je primijenili ako provjera prođe.","prefs.anti_aliasing_note":"Zaglađuje nazubljene rubove.","prefs.applies_on_restart":"Primjenjuje se nakon ponovnog pokretanja","prefs.assistant":"Asistent","prefs.auto_operation":"Odaberi operaciju automatski","prefs.auto_operation_note":"Prozori značajki biraju Spoji, Novo tijelo ili Oduzmi prema onome što novi materijal dodiruje, dok sami ne odaberete jedno. Isključeno: zadržavaju operaciju s kojom se otvaraju.","prefs.axes":"Osi","prefs.axis":"Os","prefs.bodies_folders":"Mape tijela","prefs.bodies_folders_always":"Uvijek","prefs.bodies_folders_never":"Nikad","prefs.bodies_folders_several":"Samo za više tijela","prefs.bottom":"Dolje","prefs.bottom_centre":"Dolje u sredini","prefs.bottom_right":"Dolje desno","prefs.browser":"Stablo modela","prefs.browser_eye_left":"Oko pored strelice za sažimanje","prefs.browser_eye_left_note":"Redci stabla modela prikazuju oko za prikazivanje/skrivanje pored strelice za sažimanje, kao prije, umjesto u stupcu na desnom kraju redaka.","prefs.browser_reveal_on_hover":"Prikaži pri prelasku mišem","prefs.browser_show_note":"Prikazano drži stablo modela na zaslonu. Prikaži pri prelasku mišem skriva ga dok pokazivač ne dođe na njegovo mjesto ili na tanku karticu uz njegov lijevi rub, a ostaje otvoreno dok je pokazivač unutar njega ili dok je otvoren izbornik iz njega.","prefs.browser_shown":"Prikazano","prefs.built_in":"Ugrađeno","prefs.button_left":"Povlačenje lijevom tipkom","prefs.button_middle":"Povlačenje srednjom tipkom","prefs.button_right":"Povlačenje desnom tipkom","prefs.choose_font":"Odaberi datoteku fonta…","prefs.click":"Klik","prefs.contact_shading":"Meko sjenčanje dodira","prefs.contact_shading_note":"Meko sjenčanje gdje se dijelovi približavaju.","prefs.context_menu":"Kontekstni izbornik","prefs.context_menu_ring":"Kontekstni izbornik · držite za radijalni izbornik","prefs.cpu":"CPU (programski)","prefs.crash_reports":"Otvori izvješća o rušenju…","prefs.crash_reports_note":"Izvješća se čuvaju na ovom računalu, zajedno s dizajnom i naredbama koje ponavljaju problem.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Zakrivljene plohe","prefs.curves":"Zakrivljene plohe","prefs.dead_zone_note":"Šrafirana traka je mrtva zona: kretanje unutar nje se zanemaruje.","prefs.default":"zadano","prefs.design":"Zadane postavke dizajna","prefs.design_note":"S čime novi dizajni počinju. Otvoreni dizajni zadržavaju svoje.","prefs.devices":"3D miš","prefs.dialog_buttons":"Gumbi dijaloga","prefs.dialogs":"Dijalozi","prefs.dialogs_edge":"Uz rub prikaza","prefs.dialogs_left_column":"U lijevom stupcu","prefs.dialogs_note":"Gdje se otvaraju dijalozi naredbi: usidreni uz rub prikaza ili u lijevom stupcu umjesto stabla modela i vremenske trake, koji se vraćaju kakvi su bili kad se dijalog zatvori.","prefs.display":"Prikaz","prefs.edges":"Bridovi i sjenčanje","prefs.extend":"Produži","prefs.extra_navigation":"Ctrl + povlačenje lijevom tipkom po praznom prostoru orbitira; držite razmaknicu za pomicanje.","prefs.follows_os":"Prati operacijski sustav","prefs.font":"Font","prefs.font_fallback":"Znakovi koji nedostaju odabranom fontu prikazuju se ugrađenim fontom, tako da nijedna oznaka ne prikazuje prazan kvadrat.","prefs.font_sample":"Fijuče vjetar u šiblju, ledi pasaže i kuće iza njih i gunđa · Ø12,50 mm · 45,0° · 0123456789","prefs.font_unreadable":"Odabrani font nije moguće pročitati.","prefs.general":"Općenito","prefs.general_note":"Jezik, spremanje i ažuriranja.","prefs.gesture_orbit":"Orbitiranje","prefs.gesture_pan":"Pomicanje","prefs.gesture_zoom":"Zumiranje","prefs.graphics":"Grafika","prefs.graphics_card":"Grafička kartica","prefs.graphics_card_auto":"Automatski","prefs.graphics_card_missing":"Spremljena grafička kartica nije dostupna; koristi se Automatski.","prefs.graphics_card_restart":"Stupa na snagu nakon ponovnog pokretanja SolidCrafta. WGPU_ADAPTER_NAME ima prednost nad ovim odabirom.","prefs.graphics_note":"Žrtvujte brzinu za glatkoću. Svaki odabir pokazuje svoj učinak na primjeru.","prefs.graphics_presets_note":"Unaprijed zadane vrijednosti postavljaju sve odabire ispod odjednom.","prefs.hide_constraint_glyphs_zoomed_out":"Sakrij simbole ograničenja kada je prikaz umanjen","prefs.hide_constraint_glyphs_zoomed_out_note":"Simboli ograničenja nestaju iz prikaza kada je skica toliko umanjena da bi je zatrpali. Isključeno: ostaju fiksne veličine na zaslonu pri svakom zumiranju.","prefs.history":"Vremenska traka","prefs.history_origin_bodies":"Prikaži ishodište i tijela na vrhu","prefs.history_origin_bodies_note":"Vremenska traka lijevo ili ispod stabla modela počinje mapom Tijela aktivne komponente i Ishodištem, s njihovim okom i izbornicima kao u stablu modela. Vremenska traka na dnu ostaje nepromijenjena.","prefs.history_play_button":"Tipka Reproduciraj vremensku traku u kontrolama vremenske trake","prefs.history_play_button_note":"Postavlja Reproduciraj vremensku traku između tipki Jedan korak natrag i Jedan korak naprijed u kontrolama vremenske trake. Možete i desnim klikom na kontrole prikazati ili sakriti tipku.","prefs.history_sketches":"Skice","prefs.history_sketches_in_order":"Po redoslijedu","prefs.history_sketches_note":"Kad je Skice postavljeno na Ispod svoje značajke, vremenska traka lijevo prikazuje svaku skicu jednu razinu uvučeno, ispod prve značajke izrađene iz nje, kad god je dovoljno široka za nazive. Vremenska traka na dnu uvijek zadržava redoslijed nastanka.","prefs.history_sketches_under_feature":"Ispod svoje značajke","prefs.hold_stop_snapping":"Držite kako biste isključili privlačenje","prefs.icons_only":"Samo ikone","prefs.imported_file":"Uvezena datoteka","prefs.in_browser":"U stablu modela","prefs.input":"Unos","prefs.interface":"Sučelje","prefs.interface_language":"Jezik sučelja","prefs.interface_note":"Kako SolidCraft izgleda i gdje su njegovi dijelovi.","prefs.interval_minutes":"{n} min","prefs.labels":"Oznake","prefs.layout":"Raspored","prefs.layout_note":"Kompaktno pričvršćuje panele uz rubove prozora. Prozirnost stabla modela dostupna je u opciji Plutajuće. Stranu Asistenta promijenite na stranici Asistent.","prefs.left":"Lijevo","prefs.left_click":"Lijevi klik","prefs.line_drag_draws_one":"Pritisak i povlačenje crta jednu liniju","prefs.line_drag_draws_one_note":"U alatu Linija pritisak, povlačenje i otpuštanje crta jednu liniju od mjesta pritiska do mjesta otpuštanja i ondje završava. Klikovi i dalje crtaju lanac. Isključeno: povlačenje postavlja točku ondje gdje se otpusti, kao i klik.","prefs.linked_designs":"Povezani dizajni","prefs.live_input":"Ulaz uživo","prefs.live_preview":"Pregled uživo","prefs.logo":"Logotip","prefs.logo_accent":"Naglasak","prefs.logo_theme":"Boje teme","prefs.max_file_size":"Najveća datoteka za otvaranje","prefs.max_file_size_design":"Datoteke dizajna","prefs.max_file_size_flag":"Ovo je pokretanje započelo s --max-file-size {size}, što vrijedi dok se SolidCraft ne zatvori. Ove postavke vrijede kad se pokrene bez toga.","prefs.max_file_size_note":"Zadano: 512 MB i 256 MB; najviše 16 GB. Za otvaranje datoteke potrebno je nekoliko puta više memorije od njezine veličine. Dizajnu koji zadržava veliki uvoz može trebati veća granica za datoteke dizajna da bi se spremio i ponovno otvorio.","prefs.max_file_size_step":"STEP i uvezene datoteke","prefs.max_file_size_web":"Web aplikacija otvara STEP i uvezene datoteke do 512 MB te dizajne do 256 MB: kartica preglednika ne može primiti veće datoteke. Desktop aplikacija može podići ove granice.","prefs.megabytes":"MB","prefs.menu_grid":"Velike ikone","prefs.menu_list":"Popis","prefs.menus":"Izbornici","prefs.minutes":"minuta","prefs.minutes_suffix":" min","prefs.mouse":"Miš i dodirna pločica","prefs.mouse_heading":"Miš","prefs.mouse_mapping":"Mapiranje miša","prefs.navigation":"Navigacija","prefs.navigation_note":"Kako miš, dodirna pločica i 3D miš pomiču prikaz.","prefs.network_host_remove":"Ukloni","prefs.network_locations":"Dopusti mrežne lokacije u dizajnima","prefs.network_locations_note":"Isključeno: povezane datoteke dizajna na drugom računalu (\\\\server\\share) otvaraju se samo s poslužitelja navedenih ovdje ili nakon što ga dopustite kad se to zatraži.","prefs.network_locations_section":"Mrežne lokacije","prefs.not_on_gpu":"nije dostupno na ovom GPU-u","prefs.on":"Uključeno","prefs.opaque":"Neprozirno","prefs.orbit_snap":"Držite Shift tijekom orbitiranja za privlačenje na os.","prefs.orientation":"Orijentacija","prefs.origin_plane_names":"Nazivi ravnina ishodišta","prefs.origin_plane_names_note":"Nazivi prikazani u stablu modela, dijalozima i popisima. {top} je XY, {front} je XZ, a {right} je YZ, sa Z prema gore. Naredbe, skripte i spremljeni dizajni zadržavaju XY, XZ i YZ.","prefs.overall_speed":"Ukupna brzina","prefs.parameter_list_rows":"Retci popisa parametara","prefs.parameter_list_rows_tip":"Strelica prema dolje u praznom polju vrijednosti prikazuje popis parametara, prvo favorite, do ovoliko njih. Manje održava popis laganim u velikom dizajnu.","prefs.persistent_ribbon_pressed":"Istakni aktivne naredbe na vrpci","prefs.persistent_ribbon_pressed_help":"Ističe naredbe na vrpci dok su njihovi efekti uključeni. Isključite kako biste zadržali prethodni neutralni izgled i pomoć za naredbe.","prefs.perspective_fov":"Vidno polje","prefs.placement":"Postavljanje","prefs.prefer_free_sketch_points":"Daj prednost pomičnim točkama skice kad se točke preklapaju","prefs.preview_choices":"Pregled vaših odabira","prefs.print_face_highlight":"Isticanje plohe ispisa","prefs.print_face_highlight_tip":"Koliko se jako ploha ispisa tijela boji i obrubljuje u prikazu. 0 % ne prikazuje isticanje.","prefs.profile_active":"Aktivni profil","prefs.profile_applied":"Profil je primijenjen.","prefs.profile_changed":"Postavke su se promijenile otkako je profil spremljen. Spremi ih zadržava u njemu.","prefs.profile_deleted":"Profil je izbrisan.","prefs.profile_export":"Izvezi…","prefs.profile_exported":"Profil je izvezen.","prefs.profile_imported":"Profil je uvezen. Odaberite ga pod Aktivni profil kako biste se prebacili na njega.","prefs.profile_name_hint":"Naziv profila, npr. Prijenosnik","prefs.profile_rename":"Preimenuj","prefs.profile_renamed":"Profil je preimenovan.","prefs.profile_save":"Spremi","prefs.profile_saved":"Trenutne postavke spremljene su u profil.","prefs.profile_skipped":"Profil je primijenjen; postavke koje su zadržale trenutnu vrijednost: {n} (pogledajte zapisnik).","prefs.profiles":"Profili postavki","prefs.profiles_note":"Prečaci, alatna traka, navigacija, radijalni izbornik i postavke sučelja, spremljeni zajedno pod jednim nazivom i mijenjani odjednom.","prefs.project_options_dialog":"Dijalog opcija projiciranja","prefs.project_options_dialog_note":"Uključeno: prije projiciranja odaberite Geometrija ili Tijela i Veza projekcije. Isključeno: zadržava se prethodni način rada s izravnim odabirom.","prefs.quality_default":"zadano","prefs.quality_fastest":"najbrže","prefs.quality_slowest":"najsporije","prefs.quality_smoother":"glađe","prefs.quick_measure":"Brzo mjerenje u kutu prikaza","prefs.quick_measure_note":"Veličina odabira u donjem desnom kutu prikaza: duljina brida, ili Ø i R za okrugli, površina lica, položaj točke, udaljenost i kut dviju stavki, zbroj više bridova ili lica. Klik ga kopira.","prefs.render_previous_geometry_budget":"Koristi prethodni proračun geometrije za pregled renderiranja","prefs.render_previous_geometry_budget_help":"Vrati prethodnu fiksnu granicu geometrije (512 MiB na 64-bitnom desktopu, 128 MiB drugdje) umjesto proračuna prema uređaju.","prefs.reports_saved":"Spremljeno: {n}","prefs.ribbon_reveal":"Prikaži rezultate pretraživanja na vrpci","prefs.ribbon_reveal_note":"Zadržavanje pokazivača iznad rezultata u Pretraži naredbe pokazuje gdje se naredba nalazi na vrpci: njezinu karticu, gumb ili redak u padajućem izborniku panela. Naredba pokrenuta iz pretraživanja ondje zatreperi, a pokrenuta naredba iz padajućeg izbornika označava svoj panel.","prefs.right_click":"Desni klik","prefs.saving":"Automatsko spremanje i oporavak","prefs.scale_note":"Također Ctrl + / Ctrl − u prozoru. Gumbi su 28 px pri 100 %.","prefs.scale_text":"Mjerilo i tekst","prefs.search":"Pretraži postavke","prefs.search_empty":"Nema odgovarajućih postavki","prefs.select":"Odabir","prefs.select_one_item":"Odaberi jednu stavku","prefs.select_other_hidden":"Odaberi skrivenu geometriju pomoću Odaberi drugo","prefs.select_other_hidden_help":"Uključeno: obuhvaća skrivena tijela, skice i zaklonjene bridove u blizini pokazivača. Isključeno: koristi se izvorni popis vidljive geometrije ispod pokazivača.","prefs.selecting":"Odabiranje","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift samo dodaje; Ctrl / Cmd uključuje i isključuje","prefs.shift_add_note":"Uključeno: Shift dodaje, Ctrl / Cmd uključuje i isključuje. Isključeno (zadano): oba uključuju i isključuju.","prefs.shortcuts":"Prečaci","prefs.single_surface_analysis":"Koristi samo jednu analizu ploha","prefs.single_surface_analysis_help":"Kad je isključeno, sjenčanje ploha i Kontinuitet mogu ostati uključeni zajedno. Kad je uključeno, zadržava se posljednja pokrenuta ili promijenjena analiza.","prefs.sketch_align_points":"Poravnaj s drugim točkama skice tijekom crtanja","prefs.sketch_align_points_note":"Tijekom crtanja točka se istodobno poravnava vodoravno s jednom točkom skice i okomito s drugom, uz točkastu vodilicu, a klik zadržava oba poravnanja. Isključeno: samo s prethodnom točkom, po jedna os.","prefs.sketch_conflict_colour":"Geometrija u sukobu u boji sukoba","prefs.sketch_conflict_colour_note":"Dok su ograničenja skice u sukobu, krivulje i točke koje drži neuspjelo ograničenje crtaju se i u boji sukoba, a ne samo njegov simbol ili kota. Isključeno: zadržavaju uobičajene boje.","prefs.sketch_construction_lines":"Prošireni alati za pomoćne pravce","prefs.sketch_exit_view":"Kad se skica završi","prefs.sketch_exit_view.keep":"Zadrži trenutni prikaz","prefs.sketch_exit_view.previous":"Vrati se na prethodni prikaz","prefs.sketch_exit_view.unless_rotated":"Vrati se osim ako je rotirano","prefs.sketch_exit_view_note":"Kamo prikaz ide nakon Završi skicu, Odustani ili dvostrukog Esc.","prefs.sketch_open_look_at":"Okreni kameru prema skici pri otvaranju","prefs.sketch_open_look_at_note":"Isključeno: kad izradite ili uredite skicu, prikaz ostaje onakav kakav jest. Pogledaj okreće prikaz prema skici kad to želite.","prefs.sketch_recent_snap":"Automatski privlači na nedavna središta i središnje točke","prefs.sketch_recent_snap_note":"Tijekom crtanja pokazivač se privlači ondje gdje se sijeku vodilice dvaju posljednjih središta kružnica ili središnjih točaka ravnih bridova. Isključeno: te vodilice služe samo za prikaz i pokazivač se ne pomiče.","prefs.sketch_selection":"Skica i odabir","prefs.sketch_selection_heading":"Skica i odabir","prefs.sketch_selection_note":"Kako se skice privlače i kako klikovi odabiru.","prefs.sketch_state_icons":"Ikone skica u boji njihova stanja","prefs.sketch_state_icons_note":"U vremenskoj traci i stablu modela ikona skice poprima boju njezina stanja (nedovoljno ograničena, potpuno ograničena ili u sukobu), a njezin opis imenuje stanje. Isključeno: sve skice imaju istu ikonu.","prefs.sketch_tab_always":"Uvijek prikaži karticu Skica","prefs.sketch_tab_always_note":"Kartica Skica ostaje na vrpci, odmah iza kartice Model, dok nijedna skica nije otvorena. Njezini alati za crtanje tada pokreću skicu na odabranoj ravnini ili licu, ili na ravnini koju sljedeću odaberete, s alatom spremnim u njoj.","prefs.sketch_tracking_guides":"Vodilice poravnanja središta i središnje točke","prefs.sketch_tracking_guides_note":"Zadržite pokazivač iznad središta kružnice ili središnje točke ravnog brida, zatim se pomaknite vodoravno ili okomito da se prikaže privremena točkasta vodilica.","prefs.sketch_tracking_points":"Vodilice poravnanja iz krajnjih točaka i kutova tijekom crtanja","prefs.sketch_tracking_points_note":"Dok alat za crtanje čeka točku, zadržavanje pokazivača iznad kraja linije ili luka, kuta pravokutnika ili slobodne točke prikazuje istu privremenu točkastu vodilicu kao i za središte ili središnju točku. Isključeno: samo središta i središnje točke.","prefs.sketching":"Skiciranje","prefs.snap_drawing_note":"Tijekom crtanja ili povlačenja točke skice.","prefs.source":"Izvor","prefs.speed":"Brzina","prefs.stand_up_note":"Nakon što se STEP ili IGES datoteka otvori sa Z prema gore, ponudi četvrtinu okreta oko X.","prefs.stand_up_unknown":"Za datoteke iz nepoznatih programa","prefs.stand_up_unknown.ask":"Pitaj u dijalogu","prefs.stand_up_unknown.note":"Prikaži napomenu","prefs.stand_up_unknown.off":"Ne nudi","prefs.stand_up_unknown_note":"Kako se ponuda daje kad zaglavlje datoteke ne navodi nijedan program za koji se zna da sprema s Y prema gore. Napomena se prikazuje samo kad se čini da datoteka leži na leđima; Pitaj u dijalogu pita za svaku takvu datoteku, kao i prije.","prefs.status_bar":"Statusna traka","prefs.status_bar_note":"Tanka traka uz donji rub prozora prikazuje što se uređuje, stanje otvorene skice u njegovoj boji i jedinice dizajna; klik na jedinice mijenja ih. Stanje skice tada se više ne prikazuje u kutu prikaza.","prefs.status_done":"Gotovo","prefs.status_error":"Pogreška","prefs.status_selected":"Odabrano","prefs.status_warning":"Upozorenje","prefs.supersampling_brief":"Iscrtava prikaz većim i smanjuje ga filtriranjem: vrlo oštro i zahtjevnije.","prefs.tab_accent_note":"Naglasna boja prati aktivnu karticu","prefs.theme_file":"datoteka teme","prefs.theme_file_or_paste":"datoteka ili lijepljenje","prefs.theme_follow":"Prati datoteku teme","prefs.theme_follow_error":"Nije primijenjeno: {error}. Posljednja ispravna tema ostaje uključena.","prefs.theme_follow_launch":"Prati se samo za ovo pokretanje (--theme-file); ponovno se učitava kad god je drugi alat prepiše.","prefs.theme_follow_note":"Ponovno se učitava kad god je drugi alat prepiše. Odabir teme prekida praćenje.","prefs.theme_follow_off":"Isključeno","prefs.theme_follow_stop":"Prestani pratiti","prefs.theme_import_hint":"Kliknite za odabir datoteke teme, ispustite je ovdje ili pritisnite Ctrl+V (Cmd+V na Macu) s kopiranom temom","prefs.theme_option_opacity":"Neprozirnost","prefs.theme_option_opacity_help":"Podešava neprozirnost plutajućih panela. Donja granica čitljivosti štiti tekst preko boja prozora prikaza.","prefs.theme_option_tab_colours":"Boje kartica","prefs.theme_option_tab_colours_help":"Koristi boje panela i prozora prikaza ove teme za svaku karticu vrpce.","prefs.theme_option_tab_fade_ms":"Prijelaz kartica","prefs.theme_option_tab_fade_ms_help":"Postupno prelijeva boje panela i prozora prikaza pri promjeni kartice. Nula mijenja trenutno.","prefs.theme_options_badge":"Opcije","prefs.theme_options_more":"Više · {count}","prefs.theme_options_reset":"Vrati zadano","prefs.theme_options_unavailable":"Nedostupno na ovom uređaju","prefs.theme_paste":"Zalijepi temu","prefs.theme_paste_none":"Međuspremnik ne sadrži SolidCraft temu","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"sada","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Obavijesti","prefs.toggle_item":"Dodaj stavku ili je ponovno ukloni","prefs.toolbar":"Alatna traka","prefs.toolbar_tabs":"Kartice alatne trake","prefs.top":"Gore","prefs.trackpad_zoom_modifier":"Zumiranje pomicanjem s dva prsta uz držanje tipke","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Držite samo ovu tipku kako biste okomitim pomicanjem zumirali prema pokazivaču. Isključeno zadržava postojeće ponašanje pomicanja.","prefs.trackpad_zoom_modifier.off":"Isključeno","prefs.translucent":"Prozirno","prefs.under_browser":"Ispod stabla modela","prefs.under_cursor":"Ispod pokazivača","prefs.units_precision":"Jedinice i preciznost","prefs.updates":"Ažuriranja","prefs.value_boxes_in_view":"Prikaži vrijednosti pokraj njihovih ručica u prikazu","prefs.value_boxes_in_view_tip":"Vrijednost naredbe (Udaljenost, Polumjer…) u okviru pokraj njezine ručice, preko modela. Isključeno: upisujete je u prozor naredbe, koji preuzima tipkovnicu nakon odabira, i ništa ne prekriva model.","prefs.view":"Ponašanje prikaza","prefs.view_confirm_corner":"U redu i Odustani u kutu prikaza","prefs.view_confirm_corner_note":"Dok je otvoren dijalog ili skica, kvačica i križić gore desno u prikazu rade isto što i gumbi U redu i Odustani u dijalogu, odnosno završavaju i poništavaju skicu. Navigator prikaza pomiče se ispod njih.","prefs.viewport":"Prozor prikaza","prefs.viewport_analysis_status":"Prikaži status analize u prozoru prikaza","prefs.viewport_analysis_status_help":"Prikazuje aktivne analize iznad prozora prikaza, otvara njihove legende iz svake stavke, a tipka Esc isključuje najnoviju analizu. Isključite kako biste vratili legende u kutovima i prethodno ponašanje tipke Esc.","prefs.viewport_background":"Pozadina","prefs.viewport_background_colour":"Boja","prefs.viewport_background_theme":"Gradijent teme","prefs.viewport_section_status":"Prikaži status presjeka u prozoru prikaza","prefs.viewport_section_status_help":"Prikazuje postavku presjeka u prozoru prikaza. Escape i aktivni gumb na vrpci isključuju je. Isključite kako biste zadržali prethodne kontrole presjeka.","prefs.viewport_status_details":"Detalji prozora prikaza uživo","prefs.viewport_status_details_help":"Uređuje postavke aktivne analize i presjeka u standardnim karticama detalja. Isključite kako biste vratili legende analize samo za čitanje i dijaloški prozor Presjek.","prefs.viewport_status_summary":"Sažmi statusne stavke prozora prikaza","prefs.viewport_status_summary_help":"Sažima tri ili više statusnih stavki prozora prikaza u jednu zbirnu oznaku. Isključite kako bi svaka stavka ostala u punom retku.","prefs.wheel":"Kotačić","prefs.wheel_trackpad":"Kotačić i dodirna pločica","prefs.workspace":"Radni prostor","prefs.zoom_stop_at_model":"Zaustavi zumiranje na modelu","prefs.zoom_stop_at_model_tip":"3D miš i aplikacija uređaja zumiraju prema površini u sredini prikaza; zumiranje povlačenjem zadržava točku na kojoj je povlačenje počelo. Isključeno: zumiranje može proći kroz model. Kotačić i štipanje zasebno koriste Zumiranje prema pokazivaču","prefs.zoom_toward_cursor":"Zumiranje prema pokazivaču","properties.title":"Svojstva: {name}","recovery.days_ago":"prije {count} dana","recovery.detail":"{file} · značajki: {features} · automatski spremljeno {when}","recovery.discard_all":"Odbaci sve","recovery.discard_all_detail":"Ovo se ne može poništiti.","recovery.discard_all_title":"Odbaciti automatska spremanja ({count})?","recovery.discard_all_title_one":"Odbaciti 1 automatsko spremanje?","recovery.hours_ago":"prije {count} h","recovery.just_now":"upravo","recovery.min_ago":"prije {count} min","recovery.never_saved":"nikad spremljeno","render.adaptive_absolute":"Apsolutni donji prag RGB pogreške","render.adaptive_coverage":"Ciljana pogreška pokrivenosti","render.adaptive_enable":"Raspodijeli uzorke s neovisnim probnim uzorcima","render.adaptive_help":"Samo GPU. Neovisni probni uzorci odbacuju se, a zatim se dodjeljuje 16 ili više produkcijskih uzoraka po pikselu, do vrijednosti Uzoraka po pikselu. Varijanca RGB-a i pokrivenosti usmjerava raspodjelu; rijetke putanje mogu biti propuštene, a ograničeni pikseli mogu ostati šumoviti. Završno izvješće broji stvarni rad. Nema potvrđenog jamstva za šum ili vrijeme.","render.adaptive_minimum":"Minimalni broj produkcijskih uzoraka","render.adaptive_pending":"Dostupni su GPU prilagodljiva raspodjela s neovisnim probnim uzorcima i uvjetni Fresnelovi slojevi. Potvrđena konvergencija, jamstva za rijetke događaje i CPU prilagodljivi prijenos i dalje nisu dostupni.","render.adaptive_pilots":"Probni uzorci po pikselu","render.adaptive_relative":"Ciljana relativna RGB pogreška","render.add_ground":"Dodaj prilagođenu podlogu u postavku","render.advanced_material_scope":"Dostupan je jedan konačan homogeni GPU medij uz izričita ograničenja. Mreže gustoće, ugniježđene kombinacije stakla i volumena, potpovršinsko raspršenje, pomak površine, spektralni prijenos i nevezani napredni koncepti materijala i dalje nisu dostupni.","render.aging_add":"Dodaj sloj starenja","render.aging_airborne":"Prašina u zraku / medij koji sudjeluje","render.aging_airborne_help":"Prašina u zraku zaseban je konačan homogeni volumen raspršenja. Mijenja prijenos svjetlosti i sirovi EXR, a ne niz slojeva starenja površine. Postojeća ograničenja za volumen, staklo i uklanjanje šuma ostaju izričita; atmosfera se ne dodaje automatski.","render.aging_all_bodies":"Sva prikladna neprozirna tijela","render.aging_chips":"Oljuštena boja","render.aging_class_any":"Sve klase neprozirnih materijala","render.aging_class_dielectric":"Samo nemetalne površine","render.aging_class_metal":"Samo metalne površine","render.aging_color":"Boja sloja · sRGB","render.aging_coverage":"Pokrivenost","render.aging_dust":"Nataložena prašina","render.aging_empty":"Nema slojeva starenja: izvorne površine ostaju nepromijenjene.","render.aging_fading":"Izblijedjeli premaz","render.aging_grime":"Prljavština i mrlje","render.aging_help":"Kombinirajte do osam optičkih slojeva, redom. Hrđa i patina autorski su izgledi, a ne simulacije starenja ili korozije. Mjerilo je u svjetskim milimetrima. Ne mijenjaju se geometrija, masa niti inženjerska svojstva; staklo i pasivne scene isključeni su.","render.aging_metallic":"Metalni udio sloja","render.aging_origin":"Ishodište polja · svjetski mm","render.aging_patina":"Bakarnozelena patina","render.aging_refresh_targets":"Pregledaj trenutna tijela","render.aging_roughness":"Hrapavost sloja","render.aging_rust":"Oksidirano željezo / hrđa","render.aging_scale":"Mjerilo uzorka","render.aging_scratches":"Fine ogrebotine","render.aging_target":"Cilj i koordinate","render.aging_target_help":"Imenovani cilj i dalje mora odgovarati zabilježenom indeksu i nazivu. Globalne maske vezane su za svijet; ne prate pokretne dijelove. Ovo nije ni otkrivanje šupljina ni stvarno trošenje bridova. Filtrirajte popis kako biste došli do dodatnih tijela.","render.aging_target_search":"Filtriraj nazive tijela","render.aging_upward":"Taloženje na površinama okrenutim prema gore","render.all_controls_help":"Detaljan pregled svih trenutnih kontrola. Stranice odjeljaka omogućuju usmjereno uređivanje bez mijenjanja osnovnog zahtjeva.","render.all_shots_label":"Svi kadrovi","render.appearance_editor.absorption":"Apsorpcija","render.appearance_editor.base_colour":"Osnovna boja","render.appearance_editor.body_reason":"Optičke veze ciljaju jedno cijelo tijelo. Odaberite Tijelo za uređivanje ovih kontrola.","render.appearance_editor.boundary":"Granica","render.appearance_editor.box":"Kutija","render.appearance_editor.choose_image":"Odaberi sliku…","render.appearance_editor.closed":"Zatvoreno puno tijelo","render.appearance_editor.coat":"Prozirni lak","render.appearance_editor.cpu_reason":"Zahtijeva CPU ray tracing.","render.appearance_editor.glass":"Staklo i apsorpcija","render.appearance_editor.glass_enable":"Koristi fizičko staklo na ovom tijelu","render.appearance_editor.glass_note":"Zatvoreno staklo koristi geometrijsku udaljenost. Ne može dijeliti tijelo s prozirnim lakom ni mapama.","render.appearance_editor.gpu_reason":"Zahtijeva GPU path tracing.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Mape","render.appearance_editor.normal":"Normalna","render.appearance_editor.normal_strength":"Jačina normale","render.appearance_editor.origin":"Ishodište","render.appearance_editor.recipe":"Recept","render.appearance_editor.reflection_sampling":"Uzorkovanje za sva reflektirajuća tijela","render.appearance_editor.reflections":"Refleksije","render.appearance_editor.remove":"Ukloni spremljeno","render.appearance_editor.remove_note":"Uklonite spremljenu optiku iz ovog kadra. Geometrija i dodijeljeni izgledi ostaju.","render.appearance_editor.remove_title":"Ukloniti spremljenu optiku?","render.appearance_editor.replace":"Zamijeni spremljenu optiku ovog tijela","render.appearance_editor.revalidate":"Ponovno provjeri ovo tijelo","render.appearance_editor.save":"Spremi ovu optiku","render.appearance_editor.save_reason":"Spremanje ove optike zahtijeva fizičko staklo na trenutnom GPU tijelu. Prozirni lak i lokalne mape slika ostaju privremeni.","render.appearance_editor.saved":"Spremljeno s ovim kadrom","render.appearance_editor.saved_state":"Ova je optika spremljena s ovim kadrom.","render.appearance_editor.scatter_reason":"Raspršenje u unutrašnjosti zahtijeva granicu zatvorenog punog tijela.","render.appearance_editor.temporary":"Ova je optika privremena na ovoj kartici. Spremite je da je zadržite uz kadar.","render.appearance_editor.thickness":"Debljina","render.appearance_editor.thickness_reason":"Debljina se primjenjuje na tanke listove; zatvoreno staklo koristi geometrijsku udaljenost.","render.appearance_editor.thin":"Tanak list","render.appearance_editor.u_repeat":"Ponavljanje U","render.appearance_editor.v_repeat":"Ponavljanje V","render.appearance_editor.v_up":"V teksture pokazuje prema gore","render.appearance_editor.weight":"Težina","render.appearance_physics_separate":"Vizualni izgled ne dodjeljuje gustoću, toplinske podatke niti druga inženjerska svojstva.","render.appearances":"Izgledi","render.assign_help":"Kliknite za primjenu na odabir; povucite za pregled i ispustite ili, kad ništa nije odabrano, kliknite za bojenje.","render.availability_native":"Izvorni sastav; pregledajte prije primjene","render.availability_projection":"Podržana projekcija; pogledajte opseg i izostavke","render.availability_reference":"Referentni podaci; nije automatska dodjela","render.backdrop_alpha_conflict":"Odaberite ovu pozadinu ili prozirni PNG izlaz; iscrtavač neće tiho zanemariti nijednu od te dvije postavke.","render.backdrop_enable":"Koristi gradijentnu pozadinu samo za kameru","render.backdrop_first":"Početna / središnja boja","render.backdrop_help":"Ova pozadina u prostoru zaslona ne osvjetljava, ne baca sjene, ne reflektira i ne predstavlja teren. Isključena je iz sirovog EXR-a. Geometrija, svjetla i HDR okruženje ostaju neovisni.","render.backdrop_horizontal":"Vodoravni gradijent","render.backdrop_radial":"Radijalni gradijent","render.backdrop_radius":"Polumjer","render.backdrop_second":"Krajnja / rubna boja","render.backdrop_vertical":"Okomiti gradijent","render.backdrop_x":"Središte X","render.backdrop_y":"Središte Y","render.background":"Pozadina scene","render.background_camera_section":"Pozadina kamere · PNG prikaz","render.background_completed_frozen":"Prikazani rezultat zamrznuta je dovršena slika. Uređivanje pozadine ne iscrtava taj rezultat ponovno automatski. Koristite Ponovna gradacija za promjene samo na kameri ili Renderiraj za novu fizičku scenu.","render.background_hdr_separate":"Trenutni HDR resursi osvjetljavaju površine i reflektiraju se na njima; ne prikazuju se automatski kao panorama iza predmeta. Promjena gradijenta ne rotira i ne mijenja boju osvjetljenja.","render.background_lighting_section":"HDR osvjetljenje · odvojeno od pozadine kamere","render.background_no_alpha_override":"Pozadina kamere ne dodaje se tiho prozirnom izlazu. Ponovna gradacija sirovog mastera koristi zabilježenu pokrivenost i ne primjenjuje ponovno uklanjanje šuma; izvorni EXR ostaje nepromijenjen.","render.background_not_light":"Boja pozadine služi za prikaz, a ne kao dodatni izvor svjetla.","render.background_regrade":"Primijeni na zadržani sirovi master","render.background_stage_occlusion":"Ovaj kadar uključuje geometriju fizičke scene. Veliki pod ili zid može ispuniti kadar i sakriti pozadinu samo za kameru. Namjerno očistite scenu ili joj promijenite veličinu ili promijenite njezinu fizičku refleksiju. Ponovna gradacija ne može ukloniti zabilježenu geometriju.","render.background_workflow":"Odaberite pozadinu koju želite: boju ili gradijent samo za kameru, fizičku scenu koja prima svjetlo ili HDR osvjetljenje. Međusobno su neovisni. Pregled uživo prikaz je za modeliranje; renderirajte novu sliku ili ponovno gradirajte zadržani master kako biste vidjeli završnu obradu kamere.","render.base_appearance":"Izgled tijela koji se može uređivati","render.base_apply":"Primijeni izgled tijela","render.base_apply_help":"Jedna vizualna dodjela koja se može poništiti, za točno pregledano tijelo. Postojeći izgledi pojedinih lica i inženjerski materijali ostaju odvojeni.","render.base_color":"Osnovna boja · sRGB","render.base_metallic":"Metalni udio","render.base_opaque_only":"Ovaj uređivač čuva semantiku neprozirnih tijela. Za optičko propuštanje upotrijebite izričite kontrole stakla.","render.bloom_enable":"Sjaj prikaza","render.bloom_help":"Kreativni sjaj samo na izlazu iz pozitivnih linearnih svijetlih dijelova, raširen kroz tri normalizirana prolaza kutijastog filtra. Polumjer je u pikselima izlaza. Dodaje se u linearnoj svjetlosti prikaza prije sRGB-a; nije objektiv, volumetrijski efekt niti poboljšanje konvergencije. Sirovi EXR ostaje nepromijenjen.","render.bloom_opaque":"Sjaj zahtijeva neprozirni izlaz. Prozirni PNG odbija se, a ne spljoštava tiho.","render.bloom_radius":"Polumjer sjaja","render.bloom_strength":"Jačina sjaja","render.bloom_threshold":"Prag linearnih svijetlih dijelova","render.browse_capabilities":"Pregledaj potpuni katalog mogućnosti","render.browse_environments":"Pregledaj izvorna HDR okruženja","render.browse_looks":"Pregledaj…","render.browse_native_scenes":"Pregledaj izvorne studije","render.browse_physical":"Pregledaj fizičke reference","render.browse_quality":"Pregledaj specifikacije kvalitete","render.browse_rigs":"Pregledaj autorske postave svjetala","render.browse_scene_specs":"Pregledaj napredne specifikacije scene","render.browse_surfaces":"Pregledaj autorske površine","render.browser_library":"Biblioteka","render.browser_model":"Model","render.camera_distance":"Udaljenost od oka do cilja","render.camera_exact_help":"Svjetski milimetri; kutovi se prikazuju u stupnjevima, a spremaju u radijanima. Navigacija koristi istu kameru kao prozor prikaza.","render.camera_fov":"Okomito vidno polje","render.camera_pitch":"Nagib kamere","render.camera_roll":"Valjanje","render.camera_set":"Postavi kameru renderiranja","render.camera_target":"Položaj cilja · mm","render.camera_yaw":"Skretanje","render.category_metal":"Metal","render.category_paint":"Boja","render.category_plastic":"Plastika","render.category_wood":"Drvo","render.check_opaque":"Prozirnost: samo neprozirne površine; alfa pozadine je podržana.","render.check_sorted_alpha":"Prozirnost: sortirana aproksimacija alfe.","render.check_transmission":"Prozirnost: fizičko propuštanje svjetlosti.","render.children.absolute_floor":"Apsolutni donji prag","render.children.adaptive":"Prilagodljivo","render.children.add_look_reason":"Dodajte izgled kako biste uredili njegovo uključeno stanje i jačinu.","render.children.all_shots":"Svi kadrovi","render.children.bloom":"Sjaj","render.children.check":"Provjera","render.children.check_now":"Provjeri sada","render.children.chromatic":"Kromatski pomak","render.children.compact":"Kompaktno","render.children.contrast":"Kontrast","render.children.copy_image":"Kopiraj","render.children.copy_job":"Kopiraj JSON posla","render.children.copy_request":"Kopiraj JSON zahtjeva","render.children.coverage_error":"Pogreška pokrivenosti","render.children.cpu":"CPU praćenje zraka","render.children.denoise":"Smanji šum na dovršenoj slici","render.children.depth":"Dubina putanje","render.children.distortion":"Izobličenje","render.children.edge_samples":"Uzorci rubova","render.children.effects_banner":"Ovi efekti zahtijevaju GPU praćenje putanja. Otvaranje ovoga nikad ne mijenja metodu.","render.children.enable_adaptive":"Omogućite neovisne probne uzorke kako biste uredili prilagodljiva ograničenja.","render.children.enable_bloom":"Omogućite sjaj kako biste uredili njegovu jačinu, prag i polumjer.","render.children.finishing":"Završna obrada","render.children.flare":"Odsjaj","render.children.fresnel":"Fresnelovi slojevi","render.children.ghosts":"Duhovi prstenova","render.children.glass":"Prijenos kroz staklo","render.children.go_to":"Idi na {editor}","render.children.grain":"Zrno","render.children.halo":"Oreol","render.children.hdr":"HDR","render.children.keep_master":"Zadrži sirovi linearni master","render.children.last_result":"Posljednje: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Efekti objektiva","render.children.look_summary":"{tone} · izgledi: {count}","render.children.looks":"Kreativni izgledi","render.children.memory":"Memorija","render.children.method":"Metoda","render.children.minimum":"Minimum","render.children.needs_cpu":"Zahtijeva CPU praćenje zraka. Otvaranje ovoga nikad ne mijenja metodu.","render.children.nested":"Potvrđeni ugniježđeni dielektrici","render.children.not_checked":"Nije provjereno","render.children.path":"Praćenje putanja","render.children.pilots":"Probni uzorci","render.children.preview":"Podaci pregleda","render.children.progressive_reason":"Odaberite CPU progresivno kako biste uredili broj uzoraka i sjeme.","render.children.radius":"Polumjer","render.children.reflect_depth":"Dubina refleksije","render.children.reflect_samples":"Uzorci refleksije","render.children.regrade":"Ponovna gradacija","render.children.relative_error":"Relativna pogreška","render.children.render":"Renderiranje","render.children.render_shot":"Renderiraj kadar","render.children.renderer":"Iscrtavač","render.children.renderers":"Iscrtavači","render.children.request":"Ovaj zahtjev","render.children.reset_finishing":"Vrati zadanu završnu obradu","render.children.review_quality":"Pregledaj specifikaciju kvalitete…","render.children.rgb_gain":"RGB pojačanje","render.children.samples":"Uzorci","render.children.sampling":"Uzorkovanje","render.children.saturation":"Zasićenost","render.children.scene_summary":"Tijela: {bodies} · trokuti: {triangles}","render.children.seed":"Sjeme","render.children.sharpening":"Izoštravanje","render.children.single_image":"Jedna slika","render.children.soft_focus":"Meki fokus","render.children.streak":"Pruga","render.children.strength":"Jačina","render.children.studio":"Studio","render.children.threshold":"Prag","render.children.tone":"Ton","render.children.under_hood":"Ispod haube","render.children.vignette":"Vinjeta","render.children.workstation":"Radna stanica","render.choose_look":"Najprije odaberite izgled u Izgledima","render.chromatic_offset":"Kromatski pomak rubova","render.clear_stage":"Ukloni spremljenu scenu","render.copy_request":"Kopiraj JSON","render.cpu_aa_help":"Prostorni uzorci: više uzoraka poboljšava rubove i produljuje renderiranje.","render.cpu_area_add":"Dodaj pravokutno CPU svjetlo","render.cpu_area_editor":"Pravokutna CPU svjetla","render.cpu_area_editor_help":"Puni vektori stranica u milimetrima; U × V pokazuje prema strani koja emitira. Ovo se razlikuje od GPU vektora polurubova.","render.cpu_area_full_u":"Puna stranica U · mm","render.cpu_area_full_v":"Puna stranica V · mm","render.cpu_area_samples":"Uzorci površinskog svjetla","render.cpu_binding_confirm":"Potvrdi ovo tijelo","render.cpu_binding_stale":"Scena se promijenila. Ponovno potvrdite ovaj cilj refleksije prije renderiranja.","render.cpu_body_choose":"Odaberite tijelo","render.cpu_body_filter":"Filtriraj tijela po nazivu","render.cpu_body_filter_more":"Suzite filtar kako biste vidjeli više tijela.","render.cpu_body_missing":"Cilj refleksije nedostaje, skriven je, dvosmislen ili ima naziv dulji od 128 bajtova. Ponovno ga odaberite.","render.cpu_budget":"CPU profil resursa","render.cpu_budget_bodies":"Gornja granica tijela","render.cpu_budget_compact":"Kompaktno (stara ograničenja)","render.cpu_budget_details":"Ograničenja resursa","render.cpu_budget_help":"Veća ograničenja odaberite izričito. Razlučivost i uzorci nikad se ne smanjuju automatski.","render.cpu_budget_memory":"Gornja granica memorije posla","render.cpu_budget_not_guarantee":"Ovo su gornje granice prihvata, a ne rezervacija RAM-a ni jamstvo brzine. Geometrija, film i zadržani pregledi dijele memorijski proračun; renderiranje se uvijek može prekinuti.","render.cpu_budget_resize":"Nacrt premašuje ovaj CPU profil ili njegov proračun uzoraka kamere. Izričito prihvatite manje dimenzije ili odaberite veći profil.","render.cpu_budget_studio":"Studio (velike slike)","render.cpu_budget_triangles":"Gornja granica trokuta","render.cpu_budget_workstation":"Radna stanica (zahtjevne scene)","render.cpu_captured_hdr":"HDR zabilježen za ovu sliku","render.cpu_check_capture_help":"Provjera i Pokreni potvrđuju isti sažetak datoteke ili koriste ugrađeni HDR. Svaka slika zadržava svoj zabilježeni izvor.","render.cpu_check_changed":"Kontrole ili model promijenili su se nakon ove provjere. Ponovno provjerite prije renderiranja.","render.cpu_constant_help":"Konstantna radijancija vidljiva je reflektiranim ili propuštenim zrakama. Ne daje izravno difuzno osvjetljenje.","render.cpu_custom_directions":"Zamijeni postavku prilagođenim usmjerenim svjetlima","render.cpu_direction":"Smjer prema svjetlu (X, Y, Z)","render.cpu_directional":"Usmjereno svjetlo","render.cpu_directional_add":"Dodaj usmjereno svjetlo","render.cpu_environment":"CPU okruženje","render.cpu_environment_background":"Pozadina slike ostaje odvojena od osvjetljenja okruženja.","render.cpu_environment_bounds":"CPU intenzitet mora biti 0–64, HDR rotacija konačna unutar ±1.000.000 radijana, a HDR uzorci 1, 4, 16 ili 64.","render.cpu_environment_constant":"Okruženje konstantno za sekundarne zrake","render.cpu_environment_none":"Bez CPU okruženja","render.cpu_environment_samples":"Uzorci HDR osvjetljenja","render.cpu_exposure_help":"CPU ekspozicija mora biti između −16 i 16 EV. GPU ekspozicija izvan tog raspona zadržava se dok je ne promijenite.","render.cpu_fixed":"Jedna slika","render.cpu_hdr_help":"Radiance .hdr, panorama 2:1, do 2048 × 1024 i 16 MiB. CPU zahtijeva izričite sRGB/D65 primarne boje u datoteci; nenavedene primarne boje i EXR odbijaju se.","render.cpu_hdr_reflection_help":"HDR hrapave refleksije zahtijevaju potpuno metalne površine tijela i lica. Provjera prijavljuje nepodržane kombinacije.","render.cpu_key_rim":"Glavno i rubno","render.cpu_last_check":"Posljednja CPU provjera","render.cpu_light_help":"Do osam usmjerenih svjetala. Prazan prilagođeni popis isključuje ih; odabir postavke vraća njezina svjetla. Boje su linearni RGB, a intenzitet je relativan, ne u vatima.","render.cpu_light_intensity":"Relativni intenzitet (0–64)","render.cpu_light_minimum":"Minimalna udaljenost za slabljenje","render.cpu_light_position":"Svjetski položaj (X, Y, Z)","render.cpu_light_reference":"Referentna udaljenost za intenzitet","render.cpu_light_remove":"Ukloni svjetlo","render.cpu_lighting":"Postavka osvjetljenja","render.cpu_lights":"CPU svjetla","render.cpu_linear_color":"Linearna boja (R, G, B)","render.cpu_neutral":"Neutralno","render.cpu_opaque_required":"CPU praćenje zraka zahtijeva neprozirnu pozadinu. Isključite Prozirna pozadina kako biste nastavili.","render.cpu_options_pending":"Ovaj CPU panel još ne može uređivati emisiju, efekte površine, staklo ni anizotropiju. Prije uporabe očistite te API opcije.","render.cpu_point":"Točkasto svjetlo","render.cpu_point_add":"Dodaj točkasto svjetlo","render.cpu_point_help":"Do osam točkastih svjetala, dodanih odabranom usmjerenom osvjetljenju. Udaljenosti su u mm; minimalna ne smije premašiti referentnu udaljenost.","render.cpu_primary_samples":"Uzorci rubova po pikselu","render.cpu_progressive":"CPU progresivno","render.cpu_progressive_help":"Akumulira postojeći CPU integrator u prolazima od po jednog primarnog uzorka. Odabrane refleksije zahtijevaju jedan uzorak; površinska svjetla, dielektrici i anizotropija zahtijevaju Jedna slika.","render.cpu_progressive_limits":"Najviše 1.048.576 piksela i 16.777.216 izračuna piksel × uzorak. Promjena uzoraka nikad automatski ne mijenja veličinu slike.","render.cpu_progressive_seed":"CPU sjeme uzorkovanja","render.cpu_progressive_spp":"uzoraka po pikselu","render.cpu_reflection_add":"Dodaj hrapavu refleksiju","render.cpu_reflection_depth":"Dubina refleksije (1–8)","render.cpu_reflection_empty":"Nijedno tijelo nije odabrano: refleksije scene isključene su.","render.cpu_reflection_help":"Odaberite tijela i postavite Isključeno, Zrcalo ili Hrapavo. Hrapavo koristi dodijeljenu hrapavost površine. Više uzoraka i odbijanja produljuje vrijeme; ovo je ograničeni spekularni prijenos, a ne globalno osvjetljenje.","render.cpu_reflection_limit":"Podržano je do 64 reflektirana tijela.","render.cpu_reflection_mirror":"Zrcalo","render.cpu_reflection_off":"Isključeno","render.cpu_reflection_rough":"Hrapavo","render.cpu_reflection_samples":"Uzorci refleksije (1–64)","render.cpu_reflections":"CPU refleksije","render.cpu_runtime_help":"Brojčane postavke svjetla i okruženja spremaju se s postavkom. Refleksije tijela i HDR datoteke ostaju privremene. Postojeće vrijednosti površinskih svjetala i stožaca reflektora zadržavaju se.","render.cpu_sampling_mode":"CPU način uzorkovanja","render.cpu_shadows":"Baci sjene","render.cpu_summary":"CPU praćenje zraka · refleksije · HDR · usmjerena i točkasta svjetla","render.cpu_warm_cool":"Toplo i hladno","render.diag_bodies":"Vidljiva tijela","render.diag_job_details":"Zabilježene pojedinosti posla","render.diag_last_check":"Posljednja predprovjera","render.diag_memory":"Logička procjena prihvata","render.diag_not_implemented":"Izričite granice mogućnosti","render.diag_preflight_details":"Pojedinosti predprovjere","render.diag_request":"Točan trenutni zahtjev","render.diag_triangles":"Trokuti","render.discard_continue":"Odbaci nacrt i nastavi","render.draft_confirm_help":"Trenutni nacrt renderiranja ima neprimijenjene izmjene. Spremite ih prije prebacivanja, izričito ih odbacite ili nastavite uređivanje.","render.draft_confirm_title":"Spremi uređene postavke renderiranja","render.effects_gpu_only":"Ovi efekti zahtijevaju GPU praćenje putanja. Promjena stranice nikad automatski ne mijenja iscrtavač.","render.effects_help":"Kombinirajte poredane izglede boja i efekte objektiva u prostoru slike. Renderiranje i ponovna gradacija sirovog mastera koriste iste spremljene postavke. Sirovi EXR ostaje nepromijenjen. Ovo su izvorne umjetničke kontrole, a ne kalibrirane emulacije objektiva ili markiranih filmova.","render.effects_reset_lens":"Vrati zadane efekte objektiva","render.effects_seed":"Sjeme uzorka","render.emitted_axis":"Os emitiranja","render.env_advanced":"Napredno","render.env_backdrop":"Pozadina","render.env_backdrop_pending":"Iscrtavač još ne podržava vidljivost okruženja i zamućenje pozadine.","render.env_blur":"Zamućenje","render.env_change":"Promijeni","render.env_choose_source":"Prije uređivanja osvjetljenja odaberite okruženje u odjeljku Studiji i okruženja.","render.env_clear":"Očisti","render.env_colour":"Boja","render.env_environments":"Okruženja","render.env_ground":"Podloga","render.env_ground_pending":"Fizička podloga prima sjene kao konačna difuzna ploha. Hvatanje samo sjena i refleksije podloge još nisu podržani.","render.env_intensity":"Intenzitet","render.env_invalid_edit":"Neispravna izmjena okruženja.","render.env_physical_ground":"Fizička podloga","render.env_preview_help":"Ilustrativni uzorak kugle; nije pregled odabranog okruženja.","render.env_reflection":"Refleksija","render.env_ring_help":"Povucite prsten za rotiranje osvjetljenja. Držite Shift za privlačenje na 15°.","render.env_rotate":"Rotiraj","render.env_set":"Postavi okruženje renderiranja","render.env_shadow_catcher":"Hvatač sjena","render.env_show_environment":"Prikaži okruženje","render.env_source":"Izvor","render.env_stage_details":"Uređivanje podloge zahtijeva praćenje zraka i jedan panel podloge. Za uređivanje ostalih panela scene upotrijebite Scenu.","render.env_studios":"Studiji","render.environment.albedo":"Albedo","render.environment.atmosphere":"Atmosfera","render.environment.backdrop_note":"Pozadinu vidi samo kamera. Nikad ne osvjetljava, ne baca sjene i ne reflektira se, a s prozirnim izlazom se odbija.","render.environment.blur_pending":"Zamućenje nije dostupno: iscrtavač nema postavku zamućenja pozadine.","render.environment.builtin":"Ugrađeni HDR","render.environment.check":"Provjeri datoteku","render.environment.checked":"HDR datoteka je provjerena. Spremanje ugrađuje ove bajtove.","render.environment.choose":"Odaberi HDR…","render.environment.constant":"Konstantno","render.environment.cyclorama":"Ciklorama","render.environment.embedded":"Spremljeno unutar ovog dizajna","render.environment.end":"Kraj","render.environment.extinction":"Ekstinkcija","render.environment.file":"Datoteka","render.environment.fit":"Uklopi i spremi podlogu","render.environment.floor_wall":"Pod i zid","render.environment.gap":"Zazor","render.environment.gradient":"Gradijent","render.environment.gradient_gpu":"Gradijentna pozadina zahtijeva GPU praćenje putanja.","render.environment.ground":"Podloga i scena","render.environment.hdr":"HDR","render.environment.hdr_file":"HDR datoteka","render.environment.horizon":"Obzor","render.environment.horizontal":"Vodoravno","render.environment.keep":