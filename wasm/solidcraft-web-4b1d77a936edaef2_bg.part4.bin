tiske bindinger","cmd.sketch_fit_curves_to_section":"Tilpass kurver til mesh-snitt","cmd.sketch_glyphs":"Bindingssymboler","cmd.sketch_include_3d":"Inkluder 3D-geometri","cmd.sketch_infinite":"Uendelig linje","cmd.sketch_insert_dxf":"Sett inn DXF","cmd.sketch_insert_svg":"Sett inn SVG","cmd.sketch_inspect":"Inspiser skisse","cmd.sketch_intersection_curve":"Skjæringskurve","cmd.sketch_isoparametric_curve":"Isoparametrisk kurve","cmd.sketch_line3d":"3D-linje","cmd.sketch_line_midpoint":"Linje fra midtpunkt","cmd.sketch_loose_ends":"Løse ender","cmd.sketch_loose_ends_tie":"Bind sammen løse ender","cmd.sketch_move":"Flytt/kopier skisseobjekter","cmd.sketch_move3d":"Flytt 3D-punkt","cmd.sketch_move_point":"Dra skissepunkt","cmd.sketch_offset_break":"Bryt offset-kobling","cmd.sketch_options":"Alternativer for skissepaletten","cmd.sketch_paste":"Lim inn skisseobjekter","cmd.sketch_point3d":"3D-punkt","cmd.sketch_polygon_circumscribed":"Omskreven mangekant","cmd.sketch_polygon_edge":"Mangekant fra kant","cmd.sketch_polygon_inscribed":"Innskrevet mangekant","cmd.sketch_project_to_surface":"Projiser til flate","cmd.sketch_rectangle_center":"Senterrektangel","cmd.sketch_rectangle_rounded":"Avrundet rektangel","cmd.sketch_rectangle_three_point":"3-punktsrektangel","cmd.sketch_rectangle_two_point":"2-punktsrektangel","cmd.sketch_redefine":"Omdefiner skisseplan","cmd.sketch_slot_arc_center":"Buespor med senterpunkt","cmd.sketch_slot_arc_three_point":"Buespor gjennom tre punkter","cmd.sketch_slot_center_point":"Rett spor fra senterpunkt","cmd.sketch_slot_center_to_center":"Senter-til-senter-spor","cmd.sketch_slot_overall":"Spor med totallengde","cmd.sketch_snap":"Punktfangst","cmd.sketch_solve":"Løs skisse","cmd.sketch_spline3d":"3D-spline","cmd.sketch_spline_control_point":"Spline med kontrollpunkter","cmd.sketch_spline_control_point_5":"Spline med kontrollpunkter (grad 5)","cmd.sketch_spline_fit_point":"Spline gjennom punkter","cmd.sketch_spline_insert_point":"Legg til splinepunkt","cmd.sketch_spline_reverse":"Reverser splineretning","cmd.sketch_spun_profile":"Dreid profil","cmd.sketch_toggle_diameter":"Veksle mellom radius / diameter","cmd.sketch_toggle_driven":"Veksle referansemål","cmd.sketch_transform":"Transformer","cmd.sketch_trim_path":"Trim langs bane","cmd.solid_align":"Juster","cmd.solid_boundary_fill":"Grensefyll","cmd.solid_bounding_solid":"Omsluttende volumkropp","cmd.solid_emboss":"Preg","cmd.solid_move":"Flytt/kopier","cmd.solid_offset_face":"Forskyv flate","cmd.solid_press_pull":"Trykk/trekk","cmd.solid_remove":"Fjern","cmd.solid_replace_face":"Erstatt flate","cmd.solid_rib":"Ribbe","cmd.solid_split_face":"Del flate","cmd.solid_web":"Steg","cmd.surface_blend":"Overgangsflate","cmd.surface_boundary":"Grenseflate","cmd.surface_extrude":"Flateekstrudering","cmd.surface_fair":"Jevn flate","cmd.surface_fillet":"Flateavrunding","cmd.surface_loft":"Flateloft","cmd.surface_match":"Tilpass flate","cmd.surface_offset":"Forskyv flate","cmd.surface_patch":"Lapp","cmd.surface_reverse_normal":"Snu flatenormal","cmd.surface_revolve":"Flateomdreining","cmd.surface_ruled":"Regelflate","cmd.surface_stitch":"Sy sammen","cmd.surface_sweep":"Flatesweep","cmd.surface_thicken":"Fortyk","cmd.surface_unstitch":"Opphev sammensying","cmd.surface_untrim":"Fjern trim","cmd.timeline_add":"Legg til registrert funksjon","cmd.timeline_compute_all":"Beregn alle","cmd.timeline_copy":"Kopier funksjoner","cmd.timeline_dependents":"Avhengige funksjoner","cmd.timeline_export_script":"Eksporter kommandoskript","cmd.timeline_inspect":"Inspiser funksjon","cmd.timeline_paste":"Lim inn funksjoner","cmd.timeline_play":"Spill av tidslinje","cmd.timeline_redefine":"Rediger funksjon","cmd.timeline_rename":"Gi nytt navn","cmd.timeline_reorder":"Omorganiser funksjon","cmd.timeline_roll_to":"Flytt tidslinjemarkør","cmd.timeline_rollback":"Flytt tidslinjemarkør","cmd.timeline_stop":"Stopp avspilling av tidslinje","cmd.timeline_suppress":"Undertrykk funksjon","cmd.view.render_browser":"Rendringsutforsker","cmd.view.render_dock":"Flytt rendringspanel","cmd.view.render_focus":"Rendringsfokusvisning","cmd.view.status_details":"Statusdetaljer i visningsområdet","cmd.view.status_items":"Statuselementer i visningsområdet","cmd.view_ambient_occlusion":"Ambient occlusion","cmd.view_angle_readout":"Visningsvinkler","cmd.view_apply":"Gjenopprett navngitt visning","cmd.view_back":"Bakvisning","cmd.view_bottom":"Bunnvisning","cmd.view_delete":"Slett navngitt visning","cmd.view_fit":"Tilpass","cmd.view_front":"Frontvisning","cmd.view_graphics_preset":"Grafikkforhåndsinnstilling","cmd.view_grid":"Rutenett","cmd.view_ground_shadow":"Bakkeskygge","cmd.view_home":"Hjemvisning","cmd.view_isometric":"Isometrisk visning","cmd.view_left":"Venstrevisning","cmd.view_list":"Vis navngitte visninger","cmd.view_navigate":"Naviger visning","cmd.view_navigation_bar":"Navigasjonslinje","cmd.view_next_tab":"Neste fane","cmd.view_normal_to":"Vinkelrett på valg","cmd.view_previous_tab":"Forrige fane","cmd.view_rename":"Gi nytt navn til navngitt visning","cmd.view_render_frame":"Hjelpelinjer for rendringsbilderute","cmd.view_right":"Høyrevisning","cmd.view_save":"Ny navngitt visning","cmd.view_shots_strip":"Opptaksstrimmel","cmd.view_spin":"Kontinuerlig rotasjon","cmd.view_tool":"Navigasjonsverktøy","cmd.view_top":"Toppvisning","cmd.view_visual_style":"Visuell stil","color.copy":"Klikk for å kopiere fargeverdier","color.edit":"Klikk for å redigere farge","color.gamma":"Viser gammakorrigerte fargeverdier i området 0–255","color.hex":"Hex","color.hex_help":"Skriv inn #rrggbb eller #rrggbbaa; seks sifre beholder opasiteten","color.hex_hint":"#rrggbb","color.hue":"Kulør","color.linear":"Viser lineære fargeverdier i området 0–1","color.saturation_value":"Metning og lysverdi","color.selected":"Valgt farge","config.column_filter_empty":"Ingen samsvarende kolonner","contact.components_count":"{count} komponenter","contact.enabled_label":"aktivert","coupling.gear_1":"Tannhjul 1","coupling.gear_1_pick":"Tannhjul 1 (valgfritt)","coupling.gear_2":"Tannhjul 2","coupling.gear_2_pick":"Tannhjul 2 (valgfritt)","coupling.internal":"Innvendig fortanning","coupling.needs_turn_and_slide":"trenger ett ledd med rotasjon og ett med glidebevegelse","coupling.needs_turns":"trenger to ledd med rotasjon","coupling.not_round":"ikke en rund flate","coupling.nut":"Mutter","coupling.picked":"valgt","coupling.pinion":"Drev","coupling.pinion_pick":"Drev (valgfritt)","coupling.pitch":"Stigning","coupling.rack":"Tannstang","coupling.radius_1":"Radius 1","coupling.radius_2":"Radius 2","crash.announce":"SolidCraft ble avsluttet uventet eller fikk en intern feil i forrige økt. En krasjrapport ble lagret (Hjelp > Krasjrapporter…).","crash.copy_folder":"Kopier mappesti","crash.copy_path":"Kopier sti","crash.deleted":"Slettet {count} rapport(er).","crash.detected_time":"Oppdaget {time} UTC","crash.intro":"Krasjrapporter blir på denne datamaskinen og sendes aldri noe sted. Rapporter… åpner et utkast du gjennomgår før noe deles.","crash.kind_command":"Intern feil i en kommando","crash.kind_internal":"Intern feil","crash.kind_kernel":"Kjernefeil (gjenopprettet)","crash.kind_unclean":"Lukket uventet","crash.previous_session":"En tidligere SolidCraft-økt ble avsluttet uventet eller fikk en intern feil. Rapporter om unormale avslutninger opprettes ved oppstart. Se Hjelp > Krasjrapporter… for detaljer.","crash.replayable":"kan kjøres på nytt","crash.report":"Rapporter…","crash.unclean_explanation":"Oppdaget ved en senere oppstart. Det nøyaktige avslutningstidspunktet ble ikke registrert. Avslutning av systemet eller tvungen stopp kan også føre til en unormal avslutning.","delete.and_more":"… og {count} til","diagnostic.empty_boolean_component":"det finnes ingen kropp å klippe ut fra eller ta snitt av i komponenten '{component}'; verktøyet kan overlappe '{body}' i komponenten '{other}' — aktiver den komponenten eller velg kroppen som mål","dialog.bodies_count":"{count} kropper","dialog.clearance_invalid":"klaringen må være en lengde på 0 eller mer","dialog.compute":"Beregn","dialog.compute_again":"Beregn igjen","dialog.computing":"Beregner… {seconds} s","dialog.could_not_be_checked":"kunne ikke sjekkes","dialog.custom_axis":"↖ Tilpasset akse","dialog.dimension_insert_hint":"Klikk på et annet styrende mål for å sette inn navnet","dialog.dimension_name":"Mål: {name}","dialog.edit_title":"REDIGER {title}","dialog.no_shown_body":"Ingen synlig kropp å endre: vis en, eller velg Ny kropp","dialog.select":"↖ Velg","dialog.selected_count":"↖ {count} valgt","dialog.selection_guidance":"Velg et felt for å endre det. Klikk på valgte objekter for å fjerne dem fra utvalget; Ctrl/Cmd+klikk veksler også mellom valgt og ikke valgt. Se over forhåndsvisningen, og trykk deretter OK.","dialog.selection_step":"{step} av {total}: Velg {input}","dialog.step":"Trinn","document.changed_on_disk":"{name} er endret på disken","document.changed_on_disk_detail":"{name} er endret av et annet program eller en annen datamaskin siden du åpnet eller sist lagret den. Overskriv erstatter disse endringene med dine; Lagre en kopi beholder begge.","document.copy_name":"{name} kopi","document.open_anyway":"Åpne likevel","document.open_elsewhere":"{name} er allerede åpen","document.open_elsewhere_detail":"{name} er åpen i SolidCraft {app} på {who}, åpnet {when}. Hvis dere begge lagrer, mister én av dere arbeid. Åpne den skrivebeskyttet for å se på den uten å lagre over den.","document.open_read_only":"Åpne skrivebeskyttet","document.opened_read_only":"Åpnet skrivebeskyttet: Lagre ber om en ny fil","document.overwrite":"Overskriv","document.read_only_save":"Dette designet ble åpnet skrivebeskyttet: lagre det som en ny fil","document.save_changes":"Lagre endringer i {name}?","document.save_copy":"Lagre en kopi…","document.unsaved_changes":"{name} har ulagrede endringer. Hvis du ikke lagrer, går de tapt.","drive.rigid":"{joint} er et stivt ledd: det holder delene i ro, så det har ingenting å drive. For å la dem bevege seg, endre typen i Rediger ledd: Roterende for å rotere, Glider for å gli, Sylindrisk for begge deler.","drive.stopped_by_contact":"Stoppet ved {value}: {a} ville trenge gjennom {b}","drive.stopped_by_loop":"Stoppet ved {value}: leddsløyfen gjennom {joint} kan ikke lukkes videre","drive.unconnected":"Flytter ingenting: {part} er ikke koblet til en komponent med festet posisjon","dxf.cancel_wait":"Venter på at eksporten skal stoppe…","dxf.cancelled":"DXF-eksport avbrutt","dxf.cancelling":"Avbryter DXF-eksport","dxf.exporting":"Eksporterer DXF","dxf.invalid_tolerance":"Kurvetoleranse må være mellom 0,0001 og 1 mm.","dxf.progress.index":"Forbereder flater (2/5)","dxf.progress.meshes":"Forbereder mesher (1/5)","dxf.progress.occlusion":"Løser skjulte linjer (4/5)","dxf.progress.projection":"Projiserer geometri (3/5)","dxf.progress.write":"Skriver DXF (5/5)","dxf.tolerance":"Kurvetoleranse","dxf.tolerance_help":"Bare synlige kropper og viste skisser. Kurver bruker rette segmenter. Mindre toleranse gir finere kurver og bruker mer tid og minne.","each rail's curves must be in one sketch":"kurvene til hver føringskurve må ligge i én skisse","feature computation ended without a result":"funksjonsberegningen endte uten resultat","file.open.drawing_filter":"Design, CAD-filer, meshfiler og tegninger","file_load.built":"Bygget så langt: {built} av {total} funksjoner.","file_load.converting":"Konverterer volumkropp {done} av {total}","file_load.inserting":"Setter inn geometri","file_load.link_item":"{name} ({done} av {total})","file_load.opening":"Åpner design","file_load.preparing_thumbnail":"Forbereder miniatyrbildet...","file_load.preparing_view":"Forbereder visningen...","file_load.preview_note":"Lagret forhåndsvisning. Geometrien kontrolleres før redigering.","file_load.reading":"Leser filen...","file_load.reading_percent":"Leser filen... {percent} %","file_load.rebuilding":"Bygger funksjon {done} av {total} på nytt","file_load.recovering":"Gjenoppretter design","file_load.stopping":"Venter på at forrige operasjon skal stoppe...","file_load.updating_links":"Oppdaterer koblinger","file_load.waiting":"Venter på filoperasjon","fits the face, e.g. M8":"passer flaten, f.eks. M8","from the profile":"fra profilen","from the rule":"fra regelen","help.apache":"Apache-lisens 2.0","help.appearance.assign":"Gir de valgte kroppene, flatene eller komponentene en farge eller et materialutseende, uten å endre vekten deres. Bruk det til å skille deler fra hverandre eller til å forhåndsvise en overflatebehandling.","help.assembly.bom":"Lister opp delene i designet eller en komponent med antall, gruppert etter delenummer, og kan lagre listen som CSV eller JSON. Bruk det som stykkliste ved bestilling og montering.","help.attributions":"Opphav og lisenser (ATTRIBUTION.md)","help.build":"Versjon {version} · commit {commit} · bygget {date}","help.canvas.decal":"Plasserer et bilde på en plan flate av modellen, som et klistremerke. Bruk det til å vise en etikett, en logo eller et trykt mønster på en del.","help.canvas.edit":"Endrer et lerret: posisjon, størrelse, vinkel, opasitet, speiling, synlighet eller navn. Bruk det til å justere et referansebilde mot skissen du tegner over det.","help.canvas.insert":"Plasserer et PNG- eller JPEG-bilde på et plan eller en flate som en gjennomsiktig referanse. Bruk det til å tegne av et foto eller en tegning i en skisse, med bildet skalert til en kjent størrelse.","help.component.break_link":"Løsner en koblet komponent fra designfilen sin og beholder kroppene som de er. Bruk det når delen ikke lenger skal følge endringer i originalfilen.","help.component.capture_position":"Beholder posisjonene til delene du har flyttet for hånd, slik at de blir der delene står. Bruk det etter at du har dratt deler på plass som ikke holdes av noe ledd.","help.component.create":"Legger til en ny, tom komponent i designet, inni den aktive komponenten med mindre du velger en annen overordnet komponent. Bruk det til å gi en ny del av en sammenstilling sin egen plass for kropper og skisser.","help.component.finish_edit":"Lagrer delen du redigerer på stedet, går tilbake til sammenstillingen og oppdaterer sammenstillingen fra den. Bruk den når endringene dine i den koblede delen er ferdige.","help.component.from_bodies":"Gjør hver valgte kropp til en egen komponent, oppkalt etter kroppen. Bruk det når et design bygget av løse kropper skal bli en sammenstilling der delene kan kobles sammen med ledd og flyttes.","help.component.insert_design":"Setter inn et annet lagret design som en komponent koblet til filen sin, med volumkroppene plassert som de står der. Bruk det til å gjenbruke en del i en sammenstilling og få med senere endringer med Oppdater koblinger.","help.component.properties":"Viser volum, masse, massesenter og treghetsmomenter for en komponent, ut fra materialene til kroppene. Bruk det til å sjekke vekt og balanse i en sammenstilling.","help.component.revert_position":"Setter delene du har flyttet for hånd tilbake dit de var, og forkaster flyttinger som ikke ble registrert. Bruk det til å angre prøveflyttinger i en sammenstilling.","help.component.update_links":"Leser de koblede designfilene på nytt og erstatter kropper som er endret. Bruk det etter at du har redigert en del som denne sammenstillingen bruker.","help.config.configure":"Legger til parametere, funksjoner, materialer eller utseender som kolonner i konfigurasjonstabellen. Bruk det til å bygge varianter av ett design, for eksempel størrelser av en del.","help.config.preview":"Sjekker at en rad i konfigurasjonstabellen kan bygges på nytt, uten å endre designet eller historikken. Bruk det før du bytter til en variant du er usikker på.","help.config.rules":"Viser reglene i konfigurasjonstabellen, radene og hvilken rad som er aktiv. Bruk det til å se hvordan variantene av et design er satt opp.","help.config.table":"Viser konfigurasjonstabellen: én rad per variant, én kolonne per parameter eller funksjon, og om designet fortsatt samsvarer med den aktive raden. Bruk det til å gå gjennom variantene av et design.","help.connect_note":"Start hver assistent på nytt for å laste inn SolidCraft-serveren. Hver fil ble sikkerhetskopiert som .bak før den ble endret.","help.connect_title":"Koble til AI-assistenter","help.construct.axis.edge":"Oppretter en hjelpeakse langs en rett kant eller skisselinje. Bruk den som akse for en omdreining, et sirkulært mønster eller et ledd.","help.construct.axis.normal_to_face":"Oppretter en hjelpeakse gjennom et punkt, vinkelrett på en flate. Bruk den som en akse som står rett ut fra en overflate.","help.construct.axis.through_cylinder":"Oppretter en hjelpeakse gjennom senteret av en sylinder-, kjegle- eller torusflate, eller en sirkulær kant. Bruk den til å dreie funksjoner eller lage mønster av dem rundt en rund del.","help.construct.axis.two_planes":"Oppretter en hjelpeakse der to plan eller plane flater møtes. Bruk den når aksen du trenger er linjen mellom to flater.","help.construct.axis.two_points":"Oppretter en hjelpeakse gjennom to punkter, hjørner eller skissepunkter. Bruk den til en akse mellom to kjente posisjoner.","help.construct.plane.along_path":"Oppretter et hjelpeplan vinkelrett på en kant eller kurve, på en posisjon langs den. Bruk det til å skisse en profil for en sweep eller et snitt av en bane.","help.construct.plane.at_angle":"Oppretter et hjelpeplan vridd med en vinkel fra et plan eller en flate, om en akse eller kant. Bruk det til skråstilte skisser, for eksempel en vinklet brakett.","help.construct.plane.midplane":"Oppretter et hjelpeplan midt mellom to plan eller plane flater, eller som halverer dem der de møtes i en vinkel. Bruk det som symmetriplan for speiling.","help.construct.plane.offset":"Oppretter et hjelpeplan parallelt med et plan eller en plan flate, i en avstand eller gjennom et punkt. Bruk det til å skisse i en bestemt høyde over en flate.","help.construct.plane.perpendicular":"Oppretter et hjelpeplan som inneholder en linje eller kant og står vinkelrett på et plan eller en flate. Bruk det til å skisse oppreist på en modell langs en kant.","help.construct.plane.tangent":"Oppretter et hjelpeplan som berører en sylinder, kjegle, kule eller torus i et punkt. Bruk det til å skisse på siden av en rund del.","help.construct.plane.three_points":"Oppretter et hjelpeplan gjennom tre punkter. Bruk det til et plan som bestemmes av posisjoner på modellen, for eksempel tre hjørner.","help.construct.plane.two_edges":"Oppretter et hjelpeplan gjennom to rette kanter eller linjer som ligger i ett plan. Bruk det til et plan på tvers av en del, for eksempel gjennom to motstående kanter.","help.construct.point.along_path":"Oppretter et hjelpepunkt på en posisjon langs en kant eller kurve. Bruk det som referanse et stykke ut langs en bane.","help.construct.point.center":"Oppretter et hjelpepunkt i senteret av en sirkulær kant, skissesirkel eller bue, kule eller torus. Bruk det som referanse for hull, akser og ledd.","help.construct.point.edge_plane":"Oppretter et hjelpepunkt der en kant eller linje går gjennom et plan eller en plan flate. Bruk det til å markere hvor en bane krysser et plan.","help.construct.point.three_planes":"Oppretter et hjelpepunkt der tre plan eller plane flater møtes. Bruk det som hjørnereferanse, selv der modellen ikke har noe hjørne.","help.construct.point.two_edges":"Oppretter et hjelpepunkt der to kanter eller linjer møtes, eller kommer nærmest hverandre. Bruk det som referanse i et virtuelt hjørne.","help.construct.point.vertex":"Oppretter et hjelpepunkt på et hjørne eller skissepunkt. Bruk det som en referanse som blir stående når skissen eller kroppen rundt er skjult.","help.contact.check":"Lister opp parene av deler i kontaktsett som går gjennom hverandre i gjeldende posisjon. Bruk det til å finne kollisjoner før du driver ledd eller kjører en bevegelsesanalyse.","help.contact.create":"Grupperer to eller flere deler i et kontaktsett, der kroppene hindres i å gå gjennom hverandre mens leddene beveger seg. Bruk det til deler som skal stoppe når de berører hverandre, for eksempel en spak mot stoppen sin.","help.contact.disable_all":"Slår av kontakt, slik at drevne ledd og bevegelsesanalyser ikke lenger stopper der delene berører hverandre. Bruk det til å flytte delene fritt igjen, eller til å holde en stor sammenstilling responsiv.","help.contact.edit":"Endrer et kontaktsett: delene det inneholder, navnet eller om det er undertrykt; det kan også slette settet. Bruk det til å justere hvilke deler som hindres i å gå gjennom hverandre.","help.contact.enable_all":"Legger alle delene i sammenstillingen i ett kontaktsett, slik at ingen to deler kan gå gjennom hverandre mens leddene beveger seg. Bruk det til en rask kontroll av en hel mekanisme.","help.contact.enable_sets":"Slår på kontakt for kontaktsettene du har definert, slik at drevne ledd og bevegelsesanalyser stopper der delene deres ville gått gjennom hverandre. Bruk det til å få tilbake settene dine etter at du har slått av kontakt.","help.contact.list":"Lister opp kontaktsettene i designet, delene i hvert av dem og om kontakt er slått på. Bruk det til å sjekke hvordan kontakt er satt opp før du driver sammenstillingen.","help.document.inspect":"Viser en oversikt over designet: komponenter, kropper, skisser, funksjoner og parametere. Bruk det til å få oversikt i et design du ikke har bygget selv.","help.document.units":"Endrer enhetene designet viser lengder i, for eksempel mm eller tommer. Geometrien beholder størrelsen sin; bare visningen og vanlige tall følger med.","help.edit.checkpoint":"Husker designet, den aktive skissen og angrehistorikken slik de er nå. Bruk det før du prøver noe risikabelt som du kanskje vil gå tilbake fra.","help.edit.restore_checkpoint":"Går tilbake til et sjekkpunkt, inkludert angrehistorikken. Bruk det til å forkaste alt som er gjort siden sjekkpunktet, i ett trinn.","help.explode.create":"Oppretter en eksplodert visning som skyver delene bort fra sentrum av sammenstillingen, eller etter flyttingene du angir. Bruk det til å vise hvordan en sammenstilling settes sammen, i veiledninger eller presentasjoner.","help.face.delete":"Fjerner de valgte flatene og lar naboflatene lukke åpningen, eller lar åpningen stå igjen som en flate. Bruk det til å fjerne en avrundet kant, et hull eller en forhøyning som er i veien.","help.file.insert_mesh":"Legger en 3MF-, STL-, OBJ-, PLY- eller glTF-fil til i designet som nettkropper i en ny komponent. Bruk det til å plassere en nedlastet eller skannet modell ved siden av designet ditt som referanse.","help.file.insert_step":"Legger en STEP-, IGES-, FreeCAD- eller Rhino-fil til i designet som volumkropper i en ny komponent; delene i en sammenstilling blir nestede komponenter. Bruk det til å hente inn modeller fra leverandører eller andre CAD-programmer.","help.file.save_mesh":"Lagrer kropper som et STL-, 3MF- eller OBJ-mesh, med den jevnheten på krumme flater du velger. Bruk det til å forberede deler for 3D-printing eller for programmer som leser mesher.","help.file.send_to_slicer":"Lagrer de valgte kroppene som en 3MF-fil og åpner den i slicer-programmet du velger. Bruk det til å gå fra modell til utskrift i ett trinn.","help.font_details":"Grensesnittet bruker de innebygde skriftene i egui (Ubuntu Light og Hack, under Ubuntu Font Licence og MIT/Bitstream Vera-lisensen; Noto Emoji og skriften med emoji-ikoner, under OFL og MIT). Skissetekst bruker Liberation Sans (SIL OFL 1.1). Crafting Apps sin valgfrie skriftpakke, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), følger ikke med i SolidCraft.","help.fonts":"Skrifter","help.frame.member":"Plasserer en profil, for eksempel et rør eller en aluminiumsprofil, langs linjene i en rammeskisse, ett element per linje. Bruk det til å bygge rammer, stativer og sveisede konstruksjoner.","help.inspect.accessibility":"Fargelegger flatene et verktøy kan nå fra én retning, og de det ikke kan nå. Bruk det til å sjekke en del for maskinering eller støping fra den siden.","help.inspect.center_of_mass":"Viser massesenteret til kropper, hver for seg og alle samlet, ved jevn tetthet. Bruk det til å sjekke balansen og hvor en del vil velte.","help.inspect.colored_components":"Gir hver komponent sin egen midlertidige farge, uten å endre utseender. Bruk det til å se forskjell på delene i en sammenstilling med et blikk.","help.inspect.compare":"Sammenligner to kropper og viser hvor den ene har materiale som den andre ikke har, med volum og avvik. Bruk det til å sjekke en endret eller importert del mot originalen.","help.inspect.continuity":"Sjekker hvor jevnt flater møtes langs kantene sine: mellomrom, knekk eller krumningssprang, og fargelegger skjøtene. Bruk det til å finne hvor flater ikke går rent sammen.","help.inspect.curvature_comb":"Tegner kammer langs kurver, kanter eller flater, der tennene viser hvor sterkt de bøyer. Bruk det til å oppdage flate partier, knekk og ujevn krumning.","help.inspect.curvature_map":"Fargelegger flater etter hvor sterkt de krummer, rødt der radiusen er liten. Bruk det til å finne trange partier og vurdere hvor jevn en flate er.","help.inspect.draft":"Fargelegger flater etter slippvinkelen til en trekkretning og markerer de som har for liten. Bruk det til å sjekke en del før støping.","help.inspect.environment_map":"Viser modellen med en reflekterende, speillignende finish. Bruk det til å vurdere hvordan flatene flyter, ut fra hvordan refleksjonene løper over dem.","help.inspect.interference":"Finner kropper som overlapper og viser hver overlapping med volum. Bruk det til å sjekke en sammenstilling for deler som kolliderer.","help.inspect.isocurve":"Tegner de isoparametriske kurvene på flater, rutenettet flaten er bygget på. Bruk det til å se hvordan en flate flyter og hvor kurvene samler seg tett.","help.inspect.measure":"Måler lengder, avstander, vinkler, areal og radier mellom det du velger, eller volumet og massen til kropper. Bruk det til å sjekke størrelser og klaringer.","help.inspect.minimum_radius":"Finner den minste krumningsradiusen til kurver, kanter eller flater, og hvor den er. Bruk det til å sjekke at et verktøy eller en dyse kan følge formen.","help.inspect.section":"Skjærer visningen åpen langs et plan og skraverer snittflatene, uten å endre modellen. Bruk det til å se inn i deler og sammenstillinger.","help.inspect.zebra":"Viser svarte og hvite striper reflektert på flatene til modellen. Bruk det til å vurdere jevnheten: striper som brytes eller knekker ved en kant, viser en dårlig overgang.","help.joint.as_built":"Forbinder to deler der de allerede står, uten å flytte noen av dem, og angir hvordan de fortsatt kan bevege seg. Bruk det til deler du allerede har plassert i sluttposisjonen.","help.joint.cam":"Kobler en dreiende kam til en følger, slik at følgeren glir eller svinger når kamprofilen passerer under den. Bruk det til kammer, eksentre og ventildrifter.","help.joint.create":"Forbinder to deler ved leddorigoene du velger og flytter den andre delen på plass; leddtypen bestemmer hvordan de fortsatt kan bevege seg. Bruk det til å bygge en sammenstilling der delene beveger seg som den virkelige mekanismen.","help.joint.drive":"Setter vinkelen eller avstanden til et ledd og flytter delene med det, innenfor grensene; koblede ledd og lukkede sløyfer følger med. Bruk det til å sjekke at en mekanisme beveger seg som tenkt.","help.joint.gear":"Kobler to dreiende ledd med et utvekslingsforhold, slik at drift av det ene dreier det andre. Bruk det til rette tannhjul og ringhjul, med forholdet fra delesirkelradier eller tannantall.","help.joint.limits":"Setter hvor langt et ledd kan dreie eller gli, som minimum og maksimum, eller fjerner grensene. Bruk det til å holde et hengsel, et glidende ledd eller en spak innenfor det virkelige bevegelsesområdet.","help.joint.motion_link":"Kobler to ledd med et forhold og en forskyvning, slik at drift av det ene flytter det andre. Bruk det til en fast sammenheng mellom ledd som Tannhjul, Tannstang og drev eller Skrue ikke dekker.","help.joint.origin":"Plasserer en navngitt leddorigo på en del: i senteret av en flate eller rund ende, midt på en kant, i et hjørne eller i et punkt. Bruk det til å forberede hvor ledd festes; en valgt på en flate følger flaten når delen endrer størrelse.","help.joint.rack_pinion":"Kobler et dreiende drev til en glidende tannstang, slik at stangen flytter seg like langt som delesirkelen drevet ruller gjennom. Bruk det til tannstangdrifter, styring og lineære akser.","help.joint.reach":"Flytter et punkt på en del mot et mål ved å endre leddene i kjeden, innenfor grensene deres. Bruk det til å stille en mekanisme etter hvor enden skal være, for eksempel spissen på en robotarm.","help.joint.rigid_group":"Låser de valgte delene sammen slik de er, så de beveger seg som én. Bruk det til deler som hører sammen og ikke skal bevege seg i forhold til hverandre.","help.joint.screw":"Kobler dreining og glidning med en stigning, slik at hver omdreining flytter like langt som stigningen. Bruk det til ledeskruer, bolter og gjengede spindler.","help.library.apply":"Bruker et materiale eller utseende fra en lokal bibliotekfil på kropper, flater eller komponenter. Bruk det til å gjenbruke materialer du har lagret fra et annet design.","help.library.export":"Lagrer materialene og utseendene i designet til en bibliotekfil. Bruk det til å dele dem eller gjenbruke dem i andre design.","help.library.inspect":"Sjekker en bibliotekfil og lister opp materialene og utseendene i den, uten å endre designet. Bruk det til å se hva et bibliotek inneholder før du bruker det.","help.licences":"Lisenser","help.material.assign":"Angir hva de valgte kroppene er laget av, for eksempel stål, aluminium eller ABS. Bruk det slik at masse og vekt stemmer med den virkelige delen.","help.material.properties.validate":"Sjekker et materialdatakort for konsistente tall og manglende verdier. Bruk det før du stoler på dataene for masse eller stivhet.","help.mesh.convert":"Bygger en nettkropp, for eksempel en STL, om til en redigerbar volumkropp med plane og sylindriske flater. Bruk det til å endre importerte mekaniske deler som en modellert kropp.","help.mit":"MIT-lisens","help.motion.study":"Setter leddverdier ved trinn langs en tidslinje og spiller dem av som en animasjon. Bruk det til å se en mekanisme bevege seg gjennom en sekvens og sjekke klaringer underveis.","help.motion.trace":"Sporer banen et punkt på en del følger mens en bevegelsesanalyse spilles av eller et ledd drives, og beholder den som en kurve i en 3D-skisse når du bekrefter. Bruk det til å se hvor en mekanisme når, eller til å bygge videre på banen.","help.notice":"NOTICE","help.occurrence.ground":"Fester en del på plass, eller frigjør den igjen, slik at ledd flytter de andre delene rundt den. Bruk det til rammen eller basen resten av sammenstillingen bygges på.","help.occurrence.move":"Flytter en del i en sammenstilling bare langs frihetsgradene som leddene tillater. Velg en flate på delen, og dra deretter en tilgjengelig pil eller bue.","help.parameters.change":"Åpner tabellen over navngitte verdier og uttrykk som styrer målene i designet. Bruk den til å endre en størrelse ett sted og la alle funksjoner som bruker den følge med.","help.parameters.export":"Lagrer parameterne i designet som CSV eller JSON. Bruk det til å redigere dem i et regneark eller flytte dem til et annet design.","help.parameters.graph":"Viser hvilke parametere og funksjoner som bruker hvilke andre, og eventuelle sløyfer eller feil blant dem. Bruk det til å se hva en endring av en parameter vil påvirke.","help.parameters.import":"Leser parametere fra CSV eller JSON inn i designet, alle eller ingen. Bruk det til å hente inn verdier fra et regneark eller et annet design.","help.parameters.move":"Flytter en brukerparameter før eller etter en annen i listen. Bruk det til å holde relaterte parametere sammen.","help.parts.fastener":"Legger til en standard skrue, bolt, mutter, skive, stift eller et lager i størrelsen du velger. Plassert på et hull sitter det i hullet med et ledd, så du slipper å modellere festemidler selv.","help.parts.insert":"Setter inn en standarddel i familien, størrelsen og lengden du velger. Plassert på kanten eller veggen av et hull sitter den på hullet med et stivt ledd.","help.parts.library":"Åpner standarddelene: skruer, bolter, muttere, skiver, settskruer, passtifter og lagre i standardstørrelser. Bruk det til å legge til en standarddel i stedet for å modellere den selv.","help.parts.resize":"Endrer størrelsen eller lengden på en innsatt standarddel og bygger den på nytt; leddene holder den på plass. Bruk det når en skrue viser seg å være for lang eller et hull trenger en annen størrelse.","help.plastic.assign_rule":"Tildeler en plastregel til kropper, slik at plastfunksjonene deres bruker slippvinkelen og klaringen fra den som standard. Bruk det til å sette opp en støpt del én gang for alle funksjonene.","help.plastic.boss":"Legger til et skruefeste på en flate: en stolpe med valgfritt hull, slippvinkel, avrunding i foten og støttende ribber. Bruk det til skruepunkter i støpte eller utskrevne hus.","help.plastic.lip":"Legger til en leppekant eller et tilsvarende spor langs kanten av en uthulet kropp. Bruk det slik at to husdeler plasserer seg mot hverandre og lukker tett.","help.plastic.manage_rules":"Oppretter og redigerer plastregler: materiale, veggtykkelse, radier, klaring og slippvinkel. Bruk dem til å holde funksjonene i en støpt del konsistente.","help.plastic.rest":"Legger til et anlegg på en flate: en rund eller rektangulær pute, massiv eller hul, med slippvinkel. Bruk det som støtte eller avstandsstykke i et støpt hus.","help.plastic.snap_fit":"Legger til en snap-fit-krok på en flate, med lengde, tykkelse og hake. Bruk det til å klikke deler sammen uten skruer.","help.pointcloud.insert":"Sett inn en PLY-, XYZ- eller PTS-skanning som en punktsky ved siden av modellen. Bruk den som referanse når du bygger en modell fra måledata.","help.sheet.convert":"Gjør en plate eller en uthulet kropp med jevn tykkelse om til en platekropp, med bøyninger ved kantene du velger. Bruk det til å gjøre en eksisterende del utbrettbar.","help.sheet.export_bend_table":"Lagrer bøyetabellen til en platekropp som CSV eller JSON: vinkler, radier og bøyeposisjoner i utbrettingen. Bruk det til kantpressen eller verkstedet.","help.sheet.export_dxf":"Lagrer utbrettingen som en DXF, med konturer, bøyelinjer og valgfrie bøyenotater. Bruk det til laser-, plasma- eller vannskjæring.","help.sheet.flange":"Legger til en flens: en grunnplate fra en skisse, en vegg langs en åpen skissekontur eller en bøyd vegg på platekanter. Bruk det til å bygge opp platedeler.","help.sheet.flat_pattern":"Oppretter utbrettingen av en platekropp, med størrelse, utsparinger og bøyelinjer. Bruk det til å sjekke emnet før du skjærer det ut.","help.sheet.fold":"Bøyer en plate langs en skisselinje med en vinkel og en radius. Bruk det til å brette en flat plate etter at du har lagt utskjæringer i den.","help.sheet.hem":"Bretter en platekant tilbake over seg selv. Bruk det til trygge, stive kanter uten skarpe grater.","help.sheet.manage_rules":"Oppretter og redigerer plateregler: tykkelse, bøyeradius, K-faktor, avlastninger og mellomrom. Bruk dem til å tilpasse materialet og verktøyene i verkstedet ditt.","help.sheet.path_flange":"Legger til en kjede av flenser langs en platekant, etter en åpen kjede av skisselinjer. Bruk det til profiler som en U- eller Z-form i ett trinn.","help.sheet.perforate":"Legger til et felt av hull over hele den flate platen, i et forskjøvet eller kvadratisk mønster. Bruk det til ventilasjon, gitter og lettere paneler.","help.sheet.refold":"Bretter en utbrettet platekropp sammen igjen. Bruk det etter at du har lagt funksjoner til den flate platen.","help.sheet.unfold":"Bretter ut alle bøyninger i en platekropp. Bruk det til å legge til hull eller skjæringer som må krysse en bøyning, og brett deretter sammen igjen.","help.sketch.arc.center_point":"Tegner en sirkelbue rundt et senterpunkt, fra et startpunkt til et sluttpunkt. Bruk det når buens senter er kjent, for eksempel en radius rundt et hull eller en dreietapp.","help.sketch.arc.tangent":"Tegner en bue som starter ved enden av en linje eller bue og fortsetter tangentielt. Bruk det til å føre en kjede videre med en jevn bøy i stedet for et hjørne.","help.sketch.arc.three_point":"Tegner en bue fra et startpunkt til et sluttpunkt gjennom et tredje punkt. Bruk det når buen må gå gjennom gitte punkter i stedet for rundt et kjent senter.","help.sketch.arc3d":"Tegner en eksakt sirkelbue i rommet gjennom tre punkter, med 3D-skisse slått på. Bruk det til svinger i baner og føringskurver som forlater skisseplanet.","help.sketch.auto_constrain":"Legger til bindingene skissen nesten har fra før, som vannrett, parallell eller sammenfallende, og setter deretter mål på den til den er fullt bestemt. Bruk det til å låse en grovt tegnet skisse i ett trinn.","help.sketch.auto_constrain_from_datum":"Fungerer som Automatiske bindinger, men måler posisjonene fra et referansepunkt du velger i stedet for origo. Bruk det når delen er lagt ut fra ett referansepunkt, for eksempel et hjørne eller et hull.","help.sketch.blend_curve":"Forbinder endene på to kurver med en jevn spline som er tangent til begge, eller også krumningskontinuerlig hvis du velger det. Bruk det til å bygge bro over et mellomrom mellom kurver uten knekk.","help.sketch.break":"Deler en kurve i biter der andre kurver krysser den, eller ved punkter du plasserer på den. Bruk det når en del av en kurve trenger sin egen binding eller skal slettes for seg.","help.sketch.cancel":"Forlater skissen og forkaster alt som er endret siden den ble opprettet eller åpnet for redigering. Angre henter endringene tilbake.","help.sketch.centerline":"Bytter linjer mellom vanlige linjer og senterlinjer, akser som profiler utelater. Bruk en senterlinje som akse for en omdreining, en speiling eller en symmetribinding.","help.sketch.chamfer.distance_angle":"Lager en fas på hjørnet mellom to linjer, bestemt av en avstand langs den første linjen og en vinkel. Bruk det når en tegning oppgir fasen som en lengde og en vinkel, for eksempel 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Lager en fas på hjørnet mellom to linjer, like langt tilbake langs begge. Bruk det til den vanlige 45°-fasen på en kontur.","help.sketch.chamfer.two_distance":"Lager en fas på hjørnet mellom to linjer, bestemt av en egen avstand langs hver linje. Bruk det til faser som ikke er 45°, oppgitt som to lengder.","help.sketch.circle.center":"Tegner en sirkel fra senteret og diameteren. Bruk det til hull, skruefester og andre runde former med kjent senter.","help.sketch.circle.three_point":"Tegner en sirkel gjennom tre punkter. Bruk det når sirkelen må gå gjennom gitte punkter, for eksempel på eksisterende geometri.","help.sketch.circle.three_tangent":"Tegner en sirkel som berører tre linjer, sirkler eller buer. Bruk det til å passe en sirkel inn i rommet mellom tre kurver, for eksempel den innskrevne sirkelen i en trekant.","help.sketch.circle.two_point":"Tegner en sirkel fra de to endene av diameteren. Bruk det når kantpunktene på sirkelen er kjent i stedet for senteret.","help.sketch.circle.two_tangent":"Tegner en sirkel i en gitt størrelse som berører to linjer, sirkler eller buer. Bruk det til en avrunding med fast radius mellom to kurver.","help.sketch.conic":"Tegner en kjeglesnittkurve mellom to endepunkter, formet av et toppunkt og en rho-verdi. Bruk det til jevne overganger der du vil justere fyldigheten, fra flat til nesten et skarpt hjørne.","help.sketch.constrainer":"Bruker bindingen som en eller to valgte kurver nesten har fra før, som vannrett, parallell, tangent eller lik. Bruk det til å rydde opp i en håndtegnet skisse én relasjon om gangen.","help.sketch.constraint.coincident":"Får et punkt til å ligge på et annet punkt, en kurve eller en skisseakse. Bruk det til å lukke mellomrom i en profil eller til å legge et punkt på en linje.","help.sketch.constraint.collinear":"Får to linjer til å ligge på én rett linje. Bruk det til å rette opp avbrutte kanter, for eksempel begge sidene av en utsparing.","help.sketch.constraint.concentric":"Gir to sirkler eller buer samme senter. Bruk det til ringer, sylindriske forsenkninger og aksler med skuldre.","help.sketch.constraint.curvature":"Får to kurver som møtes i et endepunkt til å fortsette med samme krumning (G2). Bruk det der en tangentforbindelse ikke er jevn nok, for eksempel på synlige flater.","help.sketch.constraint.equal":"Gjør linjer like lange, eller sirkler og buer like store i radius. Bruk det slik at ett mål styrer flere tilsvarende former.","help.sketch.constraint.fix":"Fikserer punkter eller kurver der de er, eller frigjør dem igjen. Bruk det til geometri som ikke må flytte seg når du drar i eller løser skissen.","help.sketch.constraint.horizontal_vertical":"Gjør en linje, eller linjen mellom to punkter, vannrett eller loddrett, avhengig av hva som er nærmest. Bruk det til å rette opp en kontur mot skisseaksene.","help.sketch.constraint.midpoint":"Legger et punkt midt på en linje, eller får midtpunktene til to linjer til å møtes. Bruk det til å sentrere geometri på en kant.","help.sketch.constraint.parallel":"Gjør to linjer parallelle. Bruk det til sider som må forbli parallelle når andre mål endres.","help.sketch.constraint.perpendicular":"Får to linjer til å møtes i rett vinkel. Bruk det til rette hjørner mellom linjer som ikke ligger på skisseaksene.","help.sketch.constraint.polygon":"Gjør en lukket kjede av linjer til en regulær mangekant: like sider, med hvert hjørne på én sirkel. Bruk det til å gjøre en håndtegnet mangekant regulær og holde den slik.","help.sketch.constraint.symmetry":"Får to punkter eller kurver til å speile hverandre om en linje eller et punkt. Bruk det til å holde en profil symmetrisk når du endrer den ene siden.","help.sketch.constraint.tangent":"Får to kurver til å berøre hverandre tangentielt, for eksempel en linje og en bue. Bruk det til jevne forbindelser uten knekk.","help.sketch.construction":"Bytter kurver mellom vanlig geometri og konstruksjonsgeometri, som profiler utelater. Bruk konstruksjonskurver som hjelp til utlegg, referanser og mål.","help.sketch.construction_line":"Opprett en uendelig hjelpelinje gjennom to punkter. Bruk den til å legge opp en skisse uten å dele opp profilene.","help.sketch.construction_line.angle":"Opprett en uendelig hjelpelinje i en vinkel fra skissens X-akse. Velg punktet og skriv inn vinkelen, eller velg retningen.","help.sketch.construction_line.bisector":"Velg to rette skisselinjer som krysser hverandre, og velg deretter en av vinkelhalveringslinjene. Resultatet følger kildelinjene sine.","help.sketch.construction_line.horizontal":"Opprett en uendelig vannrett hjelpelinje gjennom et punkt. Den vannrette bindingen følger med ved senere endringer.","help.sketch.construction_line.parallel":"Velg en rett skisselinje, og plasser deretter en parallell uendelig hjelpelinje. Høyreklikk for å velge en annen referanse.","help.sketch.construction_line.perpendicular":"Velg en rett skisselinje, og plasser deretter en vinkelrett uendelig hjelpelinje. Høyreklikk for å velge en annen referanse.","help.sketch.construction_line.tangent_at":"Opprett en tangent i et punkt på en sirkel eller sirkelbue, eller i endepunktet på en åpen spline eller kjeglesnittkurve. Velg kurven, og deretter berøringspunktet.","help.sketch.construction_line.tangent_external":"Velg en sirkel eller sirkelbue, deretter et eksternt punkt og en tangentløsning. Forhåndsvisningene viser bare berøringspunkter på den tegnede buen.","help.sketch.construction_line.tangent_two":"Velg to sirkler eller sirkelbuer, og velg deretter en felles tangent i forhåndsvisningen. Berøringspunktene må ligge på de tegnede kurvene.","help.sketch.construction_line.vertical":"Opprett en uendelig loddrett hjelpelinje gjennom et punkt. Den loddrette bindingen følger med ved senere endringer.","help.sketch.copy":"Kopierer de valgte skissekurvene og punktene, sammen med bindingene og målene mellom dem. Lim dem inn i denne skissen eller en annen.","help.sketch.create":"Starter en ny 2D-skisse på et plan eller på en plan flate av modellen. Hver ekstrudering, omdreining og sweep begynner med en skisse.","help.sketch.cut":"Kopierer den valgte skissegeometrien og sletter den fra skissen, i ett angretrinn. Lim den inn et annet sted i denne skissen eller i en annen.","help.sketch.dimension":"Legger til et styrende mål: en lengde, avstand, vinkel, radius eller diameter, avhengig av hva du velger. Skriv inn en verdi eller et parameternavn, så følger skissen det.","help.sketch.edit":"Åpner en eksisterende skisse for redigering. Funksjonene som er bygget på den, oppdateres når du fullfører skissen.","help.sketch.ellipse":"Tegner en ellipse fra senteret, enden av storaksen og et punkt på den korte siden. Bruk det til ovale åpninger, kammer og andre avlange runde former.","help.sketch.equation_curve":"Tegner en kurve ut fra formler: x(t) og y(t), eller y = f(x), over et intervall. Formlene kan bruke parametere, og kurven følger dem: bruk den til en sinusbølge, en spiral eller evolventen til en tannhjulstann.","help.sketch.extend":"Forlenger en linje eller bue til nærmeste kurve i veien, eller lar to kurver vokse til de møtes. Bruk det til å lukke mellomrom i en profil etter trimming eller redigering.","help.sketch.fillet":"Runder av hjørnet der to linjer eller buer møtes, med en bue med gitt radius. Flere hjørner som avrundes sammen, deler én radius.","help.sketch.finish":"Forlater skissen og går tilbake til modellen. De lukkede profilene er da klare for Ekstrudering, Omdreining og andre funksjoner.","help.sketch.finish_auto_constrain":"Kjører Automatiske bindinger på skissen og fullfører den deretter. Bruk det til å la en skisse være fullt bestemt i ett trinn.","help.sketch.fit_curves_to_section":"Skjærer en nettkropp eller volumkropp med skisseplanet og tilpasser linjer og buer til snittet. Bruk det til å gjenoppbygge en skannet eller importert del som en redigerbar skisse.","help.sketch.include_3d":"Henter modellkanter, hjørner og kurver fra andre skisser inn i denne skissen som koblede referanser, og flater ut de som ligger utenfor planet på det. Bruk det til å bygge på geometri som ikke ligger i skisseplanet.","help.sketch.infinite":"Bytter linjer mellom vanlige linjer og uendelige hjelpelinjer som går over hele visningen. Bruk dem som utleggsreferanser som aldri ender for kort.","help.sketch.insert_dxf":"Leser kurvene fra en DXF-tegning inn i en skisse, skalert, dreid og plassert slik du angir. Bruk det til å bygge på en 2D-tegning fra et annet program, for eksempel en kontur for laserskjæring.","help.sketch.insert_svg":"Leser banene fra en SVG-tegning inn i en skisse, skalert, dreid og plassert slik du angir. Bruk det til å gjøre en logo eller vektorkontur om til kurver du kan ekstrudere.","help.sketch.inspect":"Åpner en rapport om den åpne skissen: hvor mange frihetsgrader som gjenstår og om den er fullstendig bundet. Bruk det til å finne ut hva som fortsatt beveger seg før du fullfører skissen.","help.sketch.intersect":"Legger til kurvene eller punktene der kropper, flater, kanter eller andre skisser krysser skisseplanet. De forblir koblet og følger modellen når den endres.","help.sketch.intersection_curve":"Oppretter 3D-kurver der to kropper eller flater møtes, koblet til dem. Bruk dem som baner eller føringskurver som følger modellen.","help.sketch.isoparametric_curve":"Oppretter en 3D-kurve langs U- eller V-retningen til en flate gjennom et punkt du velger, koblet til flaten. Bruk den som en bane eller delelinje som følger flaten.","help.sketch.line":"Tegner sammenhengende linjer punkt for punkt, som en åpen kjede eller en lukket kontur. Det er det grunnleggende verktøyet for de fleste profiler.","help.sketch.line.midpoint":"Tegner en linje fra midtpunktet og ut til den ene enden, med den andre enden speilet. Bruk det til linjer sentrert på et punkt, for eksempel en symmetrisk kant.","help.sketch.line3d":"Tegner sammenhengende rette linjer mellom punkter i rommet, med 3D-skisse slått på. Bruk det til baner og rammer som forlater skisseplanet.","help.sketch.mirror":"Speiler skissekurver og punkter om en linje eller akse og legger til symmetribindinger. Bruk det til å tegne halvparten av en symmetrisk profil og fullføre den.","help.sketch.move":"Flytter eller roterer skissekurver og punkter, eller en kopi av dem. Bruk det til å plassere geometri på nytt og beholde formen og bindingene.","help.sketch.offset":"Lager en kopi av en kjede av kurver i en gitt avstand, på den ene siden eller begge. Bruk det til vegger, konturer og klaringer; avstanden forblir et redigerbart mål.","help.sketch.paste":"Limer inn skissegeometri du har kopiert eller klippet ut i den aktive skissen. Plasser den i et punkt eller forskyv den med en offset.","help.sketch.pattern.circular":"Kopierer skissegeometri rundt et senterpunkt, over en full sirkel eller en gitt vinkel. Bruk det til hullsirkler, eiker og tenner.","help.sketch.pattern.rectangular":"Kopierer skissegeometri i rader og kolonner med gitte avstander. Bruk det til rutenett av hull, spor eller ventilasjonsåpninger.","help.sketch.point":"Plasserer et skissepunkt. Bruk det som referanse for mål, bindinger, hullsentre eller senere funksjoner.","help.sketch.point3d":"Plasserer et punkt i rommet, med 3D-skisse slått på. Bruk det som referanse for 3D-kurver og baner.","help.sketch.polygon.circumscribed":"Tegner en regulær mangekant rundt en sirkel, dimensjonert fra senteret til midten av en side. Bruk det når bredden over flatene er kjent, som for en sekskantmutter.","help.sketch.polygon.edge":"Tegner en regulær mangekant fra de to endene av én side. Bruk det når lengden og posisjonen til en side er kjent.","help.sketch.polygon.inscribed":"Tegner en regulær mangekant inni en sirkel, dimensjonert fra senteret til et hjørne. Bruk det når målet over hjørnene er kjent.","help.sketch.project":"Henter modellkanter, flater, hjørner og kurver fra andre skisser inn i denne skissen, projisert på planet. De forblir koblet og følger modellen når den endres.","help.sketch.project_to_surface":"Projiserer kurver fra andre skisser langs normalen til denne skissen på en flate, som koblede 3D-kurver. Bruk det til å legge en logo, delelinje eller bane på en kurvet flate.","help.sketch.rectangle.center":"Tegner et rektangel fra senteret og ett hjørne. Bruk det til konturer sentrert på et punkt, for eksempel origo.","help.sketch.rectangle.rounded":"Tegner et rektangel med alle fire hjørnene avrundet til én radius. Bruk det til plater, lokk og åpninger med avrundede hjørner.","help.sketch.rectangle.three_point":"Tegner et rektangel fra én kant og et punkt på motsatt side. Bruk det til rektangler i vinkel mot skisseaksene.","help.sketch.rectangle.two_point":"Tegner et rektangel fra to motstående hjørner. Bruk det til konturene av plater, blokker og lommer.","help.sketch.scale":"Skalerer skissekurver og punkter med en faktor om et basepunkt. Bruk det til å endre størrelsen på en del av en skisse uten å tegne den på nytt.","help.sketch.slot.arc_center":"Tegner et buet spor med gitt bredde langs en bue bestemt av senteret, starten og slutten. Bruk det til justeringsspor rundt en dreietapp.","help.sketch.slot.arc_three_point":"Tegner et buet spor med gitt bredde langs en bue gjennom tre punkter. Bruk det når sporets bane må gå gjennom gitte punkter.","help.sketch.slot.center_point":"Tegner et rett spor med gitt bredde fra senteret til senteret av den ene endebuen. Bruk det til spor sentrert på et punkt.","help.sketch.slot.center_to_center":"Tegner et rett spor med gitt bredde mellom sentrene til de to endebuene. Bruk det til spor målsatt senter til senter, for eksempel justeringsspor for skruer.","help.sketch.slot.overall":"Tegner et rett spor med gitt bredde fra den ene ytterenden til den andre. Bruk det når sporets totale lengde er det som teller.","help.sketch.spline.control_point":"Tegner en kubisk spline formet av kontrollpunkter som den ikke går gjennom. Bruk det til jevne, flytende kurver som du former ved å flytte punktene.","help.sketch.spline.control_point_5":"Tegner en spline av grad 5 formet av kontrollpunkter. Bruk det der kurver må henge sammen med jevnere krumning, for eksempel på synlige designflater.","help.sketch.spline.fit_point":"Tegner en jevn spline som går gjennom hvert punkt du plasserer, åpen eller lukket. Bruk det til å tegne en form gjennom kjente punkter.","help.sketch.spline3d":"Tegner en jevn kurve i rommet gjennom punkter, med 3D-skisse slått på. Bruk det til sweep-baner og kabelføringer som forlater skisseplanet.","help.sketch.spun_profile":"Oppretter i skisseplanet omrisset en kropp tegner ut når den dreier om en akse. Bruk det til å få silhuetten av en dreiedel for en omdreining eller en tegning.","help.sketch.text":"Skriver tekst i skissen i en valgt skrift, høyde og vinkel; ordene kan følge parametere. Ekstruder eller preg den for etiketter og skrift.","help.sketch.transform":"Skalerer, dreier og flytter skissegeometri om et senterpunkt i ett trinn. Bruk det til å plassere og endre størrelsen på et utvalg samtidig.","help.sketch.trim":"Fjerner delen av en kurve mellom de nærmeste kryssingene rundt stedet du klikker. Bruk det til å rydde overlappende linjer til en lukket profil.","help.solid.align":"Flytter de valgte kroppene slik at et punkt, en flate eller et plan på dem møter et punkt, en flate eller et plan et annet sted. Bruk det til å plassere en del mot en annen uten å måle forskyvningen.","help.solid.boundary_fill":"Lager volumkropper av områdene som omsluttes av overlappende verktøykropper, og fyller bare områdene du velger. Bruk det til å bygge en form av rommet flere kropper avgrenser sammen.","help.solid.bounding_solid":"Oppretter en boks som omslutter de valgte kroppene, med en valgfri margin. Bruk det til å se den samlede størrelsen på en del, eller som råemnet den freses ut av.","help.solid.box":"Oppretter en boks fra lengde, bredde og høyde, fra et hjørnepunkt eller sentrert på et punkt. Bruk det til en rask blokk, en plassholder eller en kropp å skjære funksjoner inn i.","help.solid.chamfer":"Lager en plan fas langs de valgte kantene med avstanden du angir. Bruk verktøyet til å fjerne skarpe kanter eller gjøre det lettere å føre inn en pinne eller skrue.","help.solid.coil":"Oppretter en spiralformet kropp, for eksempel en fjær, fra en diameter, vindinger, høyde eller stigning og et rundt eller kvadratisk tverrsnitt. Bruk det til fjærer, spoler og spiralformede rygger.","help.solid.combine":"Slår sammen kropper, trekker dem fra en målkropp eller beholder bare volumet de har felles, og kan beholde verktøykroppene. Bruk det til å slå sammen deler, til å skjære en form med en annen eller til å finne hvor to kropper overlapper.","help.solid.cone":"Oppretter en kjegle fra en grunnsirkel og en høyde, eller en avkortet kjegle når toppen også har en radius. Bruk det til tilspissinger, traktere, koniske forsenkninger og spisser.","help.solid.cylinder":"Oppretter en sylinder fra en radius eller diameter og en høyde, stående på et punkt langs en akse. Bruk det til aksler, stifter, skruefester og runde emner.","help.solid.draft":"Tilter de valgte flatene med vinkelen du angir, målt fra et nøytralt plan. Bruk det på støpte eller formsprøytede deler slik at de glir ut av formen.","help.solid.emboss":"Hever skisseprofiler, for eksempel tekst eller en logo, ut fra en flate, eller senker dem ned i den. Bruk det til skrift, etiketter og merking på plane eller runde flater.","help.solid.extrude":"Trekker en skisseprofil ut i 3D over en angitt avstand og legger til eller fjerner materiale. Bruk verktøyet til å gjøre et flatt omriss til en blokk, en knast eller en lomme.","help.solid.fillet":"Runder av de valgte kantene med en jevn, sirkulær overgang med radiusen du angir. Bruk verktøyet til å avrunde skarpe kanter av hensyn til styrke, komfort eller utseende.","help.solid.hole":"Lager et rundt hull med diameteren du angir, ved et valgt punkt på en flate. Bruk verktøyet til klaringshull for skruer, hull for pinner og andre enkle, runde åpninger.","help.solid.loft":"Lager en jevn volumkropp mellom to eller flere skisseprofiler, eller fra en profil til et punkt. Bruk det til overganger, traktere, håndtak og alle former som endrer tverrsnitt langs lengden.","help.solid.mirror":"Lager en speilet kopi av de valgte kroppene eller funksjonene om et plan, og kan slå den sammen med originalen. Bruk det til symmetriske deler, slik at du modellerer den ene halvdelen og får begge.","help.solid.move":"Flytter eller roterer de valgte kroppene, eller en kopi av dem, med avstanden og vinkelen du angir. Bruk det til å flytte en kropp eller lage en til på et annet sted.","help.solid.offset_face":"Skyver de valgte flatene inn eller ut med avstanden du angir, og flatene rundt følger med. Bruk det til å gjøre en vegg tykkere, en lomme dypere eller en forhøyning høyere uten å redigere skissen.","help.solid.pattern.circular":"Gjentar de valgte objektene rundt en akse, med antallet og totalvinkelen du angir. Bruk det til boltesirkler, eiker, finner og tenner.","help.solid.pattern.path":"Kopierer funksjoner eller kropper langs en skissebane, etter antall og avstand. Bruk det til hull langs en kurvet kant eller deler langs en skinne.","help.solid.pattern.rectangular":"Gjentar de valgte objektene i én eller to retninger med antallet og avstanden du angir. Bruk det til rader og rutenett av hull, ribber, pinner eller føtter.","help.solid.pipe":"Oppretter et rundt rør langs en bane av skissekurver, massivt eller hult med en veggtykkelse. Bruk det til rør, ledninger, kabler og skinner.","help.solid.press_pull":"Legger til eller fjerner materiale når du drar i en flate, eller avrunder kanter når du drar i dem. Bruk det til raske endringer rett på modellen.","help.solid.remove":"Tar de valgte kroppene ut av designet fra dette punktet i tidslinjen og utover; tidligere trinn beholder dem. Bruk det til å fjerne en hjelpekropp, for eksempel et skjæreverktøy du ikke trenger lenger.","help.solid.replace_face":"Flytter de valgte plane flatene til et plan eller en parallell flate, og kroppen vokser eller krymper for å møte det. Bruk det til å få en flate på linje med en annen del eller et konstruksjonsplan.","help.solid.revolve":"Dreier en skisseprofil rundt en akse for å lage en rotasjonssymmetrisk volumkropp. Bruk verktøyet til aksler, knotter, skåler og andre deler som er runde rundt en senterlinje.","help.solid.rib":"Legger til en tynn vegg langs en åpen skissekurve, fylt ut til de neste flatene på kroppen. Bruk det til å avstive vegger og hjørner, for eksempel i støpte eller utskrevne deler.","help.solid.scale":"Gjør de valgte kroppene større eller mindre med en faktor, lik i alle retninger eller én per akse. Bruk det til å endre størrelsen på en importert form eller til å ta hensyn til krymping.","help.solid.shell":"Huler ut en volumkropp og lager vegger med tykkelsen du angir. Flatene du velger, fjernes for å lage åpninger. Bruk verktøyet til bokser, deksler og andre tynnveggede deler.","help.solid.sphere":"Oppretter en kule fra en radius eller diameter rundt et senterpunkt. Bruk det til kuler, knotter og avrundede ender.","help.solid.split_body":"Deler en kropp i separate kropper med et plan, flaten til en annen kropp eller en skisselinje. Bruk det til å lage deler som skal skrives ut, maskineres eller farges hver for seg.","help.solid.split_face":"Deler de valgte flatene langs et plan, flaten til en annen kropp eller skisserte kurver, uten å dele kroppen. Bruk det til å gi en del av en flate sin egen slippvinkel, farge eller forskyvning.","help.solid.sweep":"Drar en skisseprofil langs en bane for å lage en volumkropp. Bruk det til rør, skinner, håndtak og alle deler med konstant tverrsnitt som følger en kurve.","help.solid.thread":"Legger til en ISO-metrisk gjenge på en sylindrisk flate, enten som en kosmetisk gjenge eller skåret inn i kroppen. Bruk det til bolter, gjengede hull og utskrevne skrudeler.","help.solid.torus":"Oppretter en ring fra en storradius rundt aksen og en lilleradius for det runde tverrsnittet. Bruk det til O-ringer, håndtak og runde perler.","help.solid.web":"Legger til en tynn vegg langs hver åpne skissekurve, hver fylt ut til de neste flatene på kroppen. Bruk det til et rutenett av støttevegger inni hus og brett.","help.surface.blend":"Oppretter en flate som bygger bro mellom kantene på to kropper, tangent- eller krumningskontinuerlig mot begge. Bruk det til å forbinde to flater jevnt over et mellomrom.","help.surface.boundary":"Oppretter en flate som fyller en sløyfe av to til fire skissekurver, eller et nett av kurver. Bruk det til frie paneler definert av kantene sine.","help.surface.extend":"Forlenger en flate forbi kantene, med en avstand eller opp til et plan eller en flate. Bruk det slik at flater overlapper før du trimmer eller syr dem sammen.","help.surface.extrude":"Skyver skissekurver eller profiler en avstand ut til en flate, bare vegger, uten lokk. Bruk det til tynne vegger og til skjære- eller delingsverktøy.","help.surface.fair":"Jevner ut innsiden av frie flater mens kantene blir stående. Bruk det til å jevne ut bulker og bølgete refleksjoner i en flate.","help.surface.loft":"Oppretter en flate som går gjennom to eller flere profiler i rekkefølge, uten lokk. Bruk det til skall og overganger mellom ulike former.","help.surface.match":"Bygger kanten av en flate på nytt slik at den møter kanten til en annen kropp, med samsvarende tangent eller krumning. Bruk det til å lukke en skjøt jevnt mellom to flater.","help.surface.offset":"Lager en kopi av flater i en avstand langs normalene deres, som en ny flatekropp. Bruk det til hud, klaringer eller den andre siden av en vegg.","help.surface.patch":"Fyller et skisseområde eller en lukket sløyfe av kanter med en flate, plan eller jevnt krum. Bruk det til å lukke hull i en flatekropp.","help.surface.reverse_normal":"Snur flatene i en flatekropp, slik at utsiden vender den andre veien. Bruk det før fortykning eller sammensying når flatene peker innover.","help.surface.revolve":"Dreier skissekurver eller profiler om en akse til en flate, uten lokk. Bruk det til runde skall som lampeskjermer, boller og dyser.","help.surface.ruled":"Oppretter en stripe av rette linjer ut fra en kjede av kanter, langs flatens normal, tangent eller i en vinkel. Bruk det til slippvegger, utløp og delingsflater.","help.surface.stitch":"Syr flatekropper sammen langs de felles kantene, til en volumkropp når de lukker seg. Bruk det til å gjøre et sett flater om til én kropp.","help.surface.sweep":"Fører skissekurver eller profiler langs en bane til en flate, uten lokk. Bruk det til renner, lister og andre tynne former som følger en bane.","help.surface.thicken":"Gir en flatekropp en tykkelse og gjør den til en volumkropp. Bruk det til å lage utskrivbare eller maskinerbare deler av flater.","help.surface.trim":"Skjærer en flate med et plan, en annen flate eller skissekurver, og beholder siden du velger. Bruk det til å skjære flater til form før sammensying.","help.surface.unstitch":"Skiller flatene til en kropp ut i egne flatekropper; en volumkropp faller fra hverandre til flater. Bruk det til å bearbeide enkeltflater på en kropp.","help.surface.untrim":"Fjerner hull fra en flate, eller gjenoppretter ytterkanten til flatens naturlige grenser. Bruk det til å få tilbake hele flaten etter en trimming.","help.third_party":"Tredjepartslisenser","help.timeline.compute_all":"Bygger alle funksjoner i tidslinjen på nytt fra begynnelsen. Bruk det til å oppdatere modellen og se hvilke funksjoner som feiler.","help.timeline.delete":"Sletter de valgte funksjonene fra tidslinjen; sletting av en skisse sletter også funksjonene som er bygget på den. Bruk det til å fjerne et trinn som ikke lenger er ønsket.","help.timeline.dependents":"Lister opp funksjonene som ville blitt slettet sammen med en funksjon, og de som ville feilet uten den. Bruk det før du sletter eller endrer en funksjon.","help.timeline.play":"Spill av de gjenstående funksjonene én om gangen, med en halv sekunds pause etter hver gjenoppbygging. Kjør denne kommandoen igjen eller trykk Escape for å stoppe; Gå til slutten hopper umiddelbart.","help.view.apply":"Dreier visningen til en standardretning som front, topp eller iso, eller til en lagret navngitt visning. Bruk det til å se på modellen fra en fast vinkel.","help.view.delete":"Sletter en lagret navngitt visning. Modellen endres ikke.","help.view.fit":"Zoomer og panorerer slik at hele modellen, eller utvalget, fyller visningen. Bruk det når modellen har kommet ut av syne.","help.view.grid":"Viser eller skjuler rutenettet i visningsområdet. Bruk det som en størrelses- og orienteringshjelp under modellering.","help.view.ground_shadow":"Viser eller skjuler skyggen til modellen på bakken. Bruk det til å vurdere høyde og posisjon lettere.","help.view.home":"Dreier visningen tilbake til hjemretningen og tilpasser modellen. Bruk det til raskt å komme tilbake til en kjent visning.","help.view.list":"Lister opp de navngitte visningene som er lagret i designet. Bruk det til å finne en visning du lagret tidligere.","help.view.navigate":"Dreier, panorerer eller zoomer visningen i trinn, for eksempel en kvart omdreining til venstre. Bruk det til å flytte kameraet presist i stedet for å dra.","help.view.navigation_bar":"Viser eller skjuler navigasjonslinjen nederst i visningsområdet. Skjul den for mer plass, vis den for å nå visningsverktøyene med musen.","help.view.rename":"Gir en lagret navngitt visning et nytt navn. Selve visningen forblir den samme.","help.view.save":"Lagrer gjeldende kameraposisjon som en navngitt visning i designet. Bruk det til å komme tilbake til samme vinkel senere, for eksempel for skjermbilder.","help.view.spin":"Roterer visningen rundt modellen kontinuerlig til neste klikk eller tast. Bruk det til å presentere en modell fra alle sider.","help.view.tool":"Låser et kameraverktøy, rotering, panorering eller zoom, slik at det å dra med venstre museknapp flytter visningen til du slår det av. Bruk det på en styreflate eller uten midtre museknapp.","help.view.visual_style":"Bytter hvordan modellen tegnes: skyggelagt med eller uten kanter, trådmodell eller med skjulte kanter. Bruk trådmodell for å se inn i modellen, skyggelagt for et rent utseende.","history.sketch_under_constrained":"Underbestemt ({count} frihetsgrader)","history.sketch_under_constrained_one":"Underbestemt ({count} frihetsgrad)","hole_presets.confirm_delete":"Bekreft sletting","hole_presets.delete":"Slett","hole_presets.delete_prompt":"Slette denne personlige forhåndsinnstillingen? Eksisterende hull endres ikke.","hole_presets.full":"Det personlige biblioteket inneholder allerede 64 forhåndsinnstillinger.","hole_presets.invalid_name":"Skriv inn et kort navn uten linjeskift eller kontrolltegn.","hole_presets.invalid_parameters":"Fullfør hullparameterne med gyldige uttrykk av rimelig lengde.","hole_presets.missing":"Den valgte forhåndsinnstillingen er ikke lenger tilgjengelig.","hole_presets.name":"Navn på forhåndsinnstilling","hole_presets.name_exists":"En forhåndsinnstilling med dette navnet finnes allerede. Bruk et annet navn.","hole_presets.name_hint":"Et unikt navn","hole_presets.overwrite":"Lagre endringer i valgt forhåndsinnstilling","hole_presets.preset":"Forhåndsinnstilling","hole_presets.recall":"Hent frem","hole_presets.rename":"Gi nytt navn","hole_presets.save":"Lagre ny","hole_presets.scope":"Lagret i profilen din for alle prosjekter.","hole_presets.select":"Velg en forhåndsinnstilling","hole_presets.title":"Personlige forhåndsinnstillinger","hole_presets.unsupported_options":"Denne forhåndsinnstillingen bruker gjengealternativer som denne versjonen ikke kan hente frem.","hole_presets.unsupported_overwrite":"Denne forhåndsinnstillingen inneholder alternativer som ikke kan overskrives på en trygg måte.","home.back":"Tilbake til {name}","home.crashes":"Krasjrapporter","home.design_workspace":"Design","home.documentation":"Dokumentasjon","home.export":"Eksporter","home.export_hint":"Velg et format for gjeldende design.","home.export_json_hint":"Redigerbart design og kommandohistorikk","home.export_mesh_hint":"Nett for utskrift eller deling","home.export_step_hint":"Nøyaktig solid geometri","home.import":"Importer…","home.import_hint":"STEP, IGES eller nett til et nytt design","home.in_this_browser":"i denne nettleseren","home.missing":"mangler","home.month_01":"jan.","home.month_02":"feb.","home.month_03":"mars","home.month_04":"apr.","home.month_05":"mai","home.month_06":"juni","home.month_07":"juli","home.month_08":"aug.","home.month_09":"sep.","home.month_10":"okt.","home.month_11":"nov.","home.month_12":"des.","home.new_inches":"Nytt design, tommer","home.new_inches_hint":"Tommer · åpnes i Design","home.new_mm":"Nytt design","home.new_mm_hint":"Millimeter · åpnes i Design","home.open":"Åpne…","home.open_hint":"Et .sc-design ({shortcut})","home.open_now":"Åpne nå","home.opened_days_ago":"for {count} dager siden","home.opened_hours_ago":"for {count} t siden","home.opened_just_now":"Akkurat nå","home.opened_minutes_ago":"for {count} min siden","home.opening":"åpner…","home.properties":"Designegenskaper","home.recent":"Nylige","home.recent_empty":"Design du åpner eller lagrer, vises her.","home.recovery_count":"Design som kan gjenopprettes: {count}","home.recovery_empty":"Ingen design å gjenopprette.","home.recovery_hint":"SolidCraft ble avsluttet før disse designene ble lagret.","home.report_issue":"Rapporter et problem","home.samples":"Eksempler","home.settings":"Innstillinger","home.short_date":"{day}. {month}","home.shortcuts":"Tastatursnarveier","home.start_hint":"Opprett et design, åpne en nylig fil eller utforsk et eksempel.","home.whats_new":"Hva er nytt","home.yesterday":"I går","install.button_tip":"Installer SolidCraft som en app: den åpnes i sitt eget vindu og fungerer frakoblet","install.dock_1":"Velg Fil › Legg til i Dock.","install.dock_2":"Klikk på Legg til.","install.dock_after":"SolidCraft åpnes deretter i sitt eget vindu fra Dock, og fungerer frakoblet.","install.done":"Ferdig","install.home_screen_1":"Trykk på Del (i …-menyen hvis knappen ikke er på verktøylinjen).","install.home_screen_2":"Velg Legg til på Hjem-skjerm.","install.home_screen_3":"Trykk på Legg til.","install.home_screen_after":"SolidCraft åpnes deretter fra ikonet på Hjem-skjermen, uten Safaris verktøylinjer, og fungerer frakoblet.","install.menu":"Installer app…","install.steps_intro":"Safari installerer nettapper fra sine egne menyer:","install.title":"Installer SolidCraft","issue.body_label":"Rapporttekst","issue.note_changed_while_waiting":"Innstillinger eller modell ble endret mens du ventet på forhåndsvisningen. Ta skjermbildet på nytt for å oppdatere de tekniske detaljene for gjeldende visning.","issue.note_details_kept":"Skjermbildet er tatt lokalt. De redigerte tekniske detaljene dine er beholdt: kontroller at de fortsatt stemmer med gjeldende visning.","issue.note_details_updated":"De tekniske detaljene er oppdatert slik at de stemmer med gjeldende visning. Skjermbildet er tatt lokalt. Se det over før du legger det ved på GitHub.","issue.note_image_copied":"Lim inn bildet i GitHub-utkastet, eller lagre PNG-filen hvis bildekopiering ikke er tilgjengelig.","issue.note_opened":"Gjennomgå GitHub-utkastet og legg ved skjermbildet. GitHubs Submit new issue-knapp publiserer det.","issue.note_opened_copied":"Rapport kopiert. Lim inn i GitHub-utkastet, legg ved skjermbildet, og klikk deretter Submit new issue på GitHub.","issue.note_removed":"Skjermbilde fjernet fra dette utkastet.","issue.note_report_copied":"Rapport kopiert. Lim den inn i GitHub-utkastet om nødvendig.","issue.note_save_failed":"Kunne ikke lagre skjermbilde: {error}","issue.note_saved":"Skjermbilde lagret. Legg ved PNG-filen i GitHub-utkastet.","issue.save_screenshot":"Lagre skjermbilde…","joint.from_bodies_hint":"Hver valgt kropp flyttes inn i en egen ny komponent og blir der den er.","joint.one_body":"Begge valg er på {body}. Velg det andre på en annen del.","joint.one_component":"Disse delene er kropper i én komponent: {bodies}. Et ledd beveger én komponent i forhold til en annen, så hver del trenger sin egen komponent.","joint.rigid_group_one_component":"Disse {count} kroppene ligger alle i én komponent (eller i selve designet): bruk {command} først.","joint.rigid_group_select_components":"Velg to eller flere komponenter.","joint_move.blocked_hint":"Kontroller leddtypen (for eksempel Stiv), om posisjonen er festet, leddgrenser og parameterstyrte verdier.","joint_move.blocked_title":"Kan ikke flytte denne delen","joint_move.coarse":"Rotasjonstrinn nær aksen (°)","joint_move.distance":"Avstand fra start","joint_move.done":"Ferdig","joint_move.fine":"Rotasjonstrinn langt fra aksen (°)","joint_move.fixed":"Denne delen har ingen bevegelig leddakse.","joint_move.help":"Flytt — dra en pil eller en ring. Esc avbryter gjeldende drag.","joint_move.legacy_hint":"Slå av for å bruke det forrige Flytt-panelet.","joint_move.precision":"Dra utenfor den stiplede hjelpelinjen for finrotasjon.","joint_move.rotation":"Rotasjon fra start","joint_move.select":"Velg en flate eller én del i sammenstillingen, og velg deretter Flytt.","joint_move.settings":"Flytting i sammenstilling","joint_move.step":"Trinn","joint_move.use_handles":"Bruk håndtak for leddbevegelse ved Flytt i sammenstillinger","keymap.command_id":"Kommando-ID","keymap.empty":"Ingen kommandoer samsvarer med søket","keymap.use_anyway":"Bruk {key} her likevel","label.move_to_left_side":"Flytt til venstre side","label.move_to_right_side":"Flytt til høyre side","manage.appearance_hint":"Velg et utseende for utvalget, eller dra en fargeprøve på en kropp eller flate.","manage.assign_hint":"Velg kropper og tildel dem en plastregel.","manage.config_hint":"Rediger konfigurasjonsrader, kolonner og regler, og aktiver eller forhåndsvis deretter en rad.","manage.empty":"Ingen rader samsvarer med søket.","manage.material_hint":"Velg kropper og tildel dem et fysisk materiale.","manage.parameters_hint":"Rediger uttrykk og enheter. Endringer brukes ved Enter eller når du forlater et felt.","manage.rules_hint":"Velg en regel å redigere, eller opprett en ny. Bekreft for å lagre regelen.","material.editor.add_property":"Legg til egenskap","material.editor.add_source":"Legg til kilde","material.editor.assigned_density":"Tildelt tetthet","material.editor.axes":"Materialakser","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Kopi av {name}","material.editor.density_range":"Tildelt tetthet må være over 0 og høyst 1000 g/cm³.","material.editor.designation":"Betegnelse","material.editor.duplicate":"Dupliser","material.editor.engineering_card":"Teknisk egenskapskort","material.editor.family":"Materialfamilie","material.editor.glass":"Glass","material.editor.illustrative":"Illustrerende","material.editor.invalid_property":"Egenskapstypen støttes ikke.","material.editor.isotropic":"Isotrop","material.editor.measurement":"Måling","material.editor.metal":"Metall","material.editor.moisture":"Fuktighet, tørrbasis","material.editor.name_required":"Skriv inn et navn på 1–128 tegn.","material.editor.no_draft":"Ingen materialutkast er åpent.","material.editor.number_required":"Skriv inn en endelig tallverdi.","material.editor.orthotropic":"Ortotrop","material.editor.other":"Annet","material.editor.polymer":"Polymer","material.editor.preserved_appearance":"Bevart utseende","material.editor.public_reference":"Offentlig referanse","material.editor.reference":"Referanse","material.editor.save_or_discard":"Lagre eller forkast materialutkastet før du tildeler et materiale.","material.editor.saved":"Materialet er lagret. Kroppstildelinger er uendret.","material.editor.scope":"Ved lagring lagres materialet uten at det tildeles kropper. Tomme egenskaper og betingelser forblir ukjente. Tettheten på kortet endrer ikke tildelt tetthet eller masse.","material.editor.source_id":"Kilde-ID","material.editor.source_kind":"Kildetype","material.editor.source_title":"Kildetittel","material.editor.sources":"Kilder","material.editor.stale":"Dette materialet ble endret mens utkastet var åpent. Forkast utkastet og åpne det på nytt før du lagrer.","material.editor.state":"Materialtilstand","material.editor.strain_rate":"Tøyningshastighet","material.editor.symmetry":"Elastisk symmetri","material.editor.temperature":"Temperatur","material.editor.unknown_card":"De tekniske egenskapene er ukjente. Ved lagring kan bare tildelt tetthet og eksisterende utseende bli beholdt.","material.editor.user_supplied":"Oppgitt av bruker","material.editor.wood":"Tre","material.selection.choose":"Velg et materiale","material.selection.mixed":"Ulike materialer","measure.at":"Ved","measure.item":"Element {number}","measure.quick_copied":"Målet er kopiert","measure.quick_copy":"Klikk for å kopiere målet","measure.quick_edges":"{count} kanter","measure.quick_faces":"{count} flater","messages.ago_h":"for {n} t siden","messages.ago_min":"for {n} min siden","messages.ago_s":"for {n} s siden","messages.chip_hint":"Klikk for alle meldinger i denne økten","messages.clear":"Tøm","messages.copy_all":"Kopier alle","messages.menu":"Meldinger…","messages.none":"Ingen meldinger ennå.","messages.title":"Meldinger","motion.checked_to":"Kontrollert til trinn {step}: grensen for beregningsarbeid er nådd","motion.collision":"{a} · {b}: trinn {steps}","motion.delete_key":"Slett nøkkelbilde","motion.duration_hint":"sekunder (tomt felt: per trinn)","motion.key_here":"Nøkkelbilde her","motion.key_here_hint":"Legg til et nøkkelbilde på dette trinnet med leddets nåværende verdi","motion.no_collisions":"Ingen kollisjoner i analysen","motion.plot_quantity":"Storhet","motion.step_back":"Ett trinn tilbake","motion.step_forward":"Ett trinn frem","motion.to_end":"Til slutten","motion.to_start":"Til starten","motion.track_name":"Spor {number}","nav.alias.help":"Shift+Alt+venstredrag roterer, Shift+Alt+midtdrag panorerer, Shift+Alt+høyredrag zoomer; midtdrag panorerer og høyredrag roterer også","nav.blender.help":"Midtdrag roterer, Shift+midtdrag panorerer, Ctrl+midtdrag zoomer; høyredrag lar kameraet stå i ro","nav.free_orbit.help":"Mus og 3D-mus roterer gjennom begge polene og bevarer rulling. Aksefangst med Shift er deaktivert.","nav.free_orbit.label":"Fri rotasjon","nav.free_orbit.snap_help":"Mus og 3D-mus roterer gjennom begge polene og bevarer rull. Hold Shift mens du drar for å rotere, så låses visningsretningen og rullen til faste trinn.","nav.free_orbit_upright.help":"Sidelengs musedrag dreier modellen rundt verdens vertikale akse; drag opp og ned vipper den over toppen uten begrensning.","nav.free_orbit_upright.label":"Drei rundt den vertikale aksen","nav.fusion.help":"Midtdrag panorerer, Shift+midtdrag roterer, høyredrag roterer","nav.hfss.help":"Alt+venstredrag panorerer, Shift+Alt+venstredrag zoomer, Ctrl+venstredrag fra tomt område roterer","nav.inventor.help":"Midtdrag panorerer, Shift+midtdrag roterer, Ctrl+midtdrag zoomer, høyredrag roterer","nav.maya.help":"Alt+venstredrag roterer, Alt+midtdrag panorerer, Alt+høyredrag zoomer; midtdrag panorerer også","nav.openscad.help":"Venstredrag i tomt område roterer, Shift+venstredrag velger med ramme, dra i skissegeometri for å redigere; høyre- eller midtdrag panorerer, Shift+høyredrag eller Shift+midtdrag zoomer","nav.perspective.sketch":"Skisseredigering bruker ortografisk visning. Fullfør skissen for å bytte til perspektiv.","nav.right_drag_orbits.help":"Av: et høyredrag lar kameraet stå i ro, og høyre museknapp åpner bare kontekstmenyen. Når du velger SolidWorks-museoppsettet, slås dette av.","nav.right_drag_orbits.label":"Høyredrag roterer","