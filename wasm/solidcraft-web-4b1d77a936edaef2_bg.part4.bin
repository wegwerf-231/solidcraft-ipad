stom.title":"Pasek nawigacji","navbar.custom.unknown":"To miejsce jest niedostępne.","navbar.description.ambient_occlusion":"Przyciemnia zagłębienia i narożniki, dodając głębi.","navbar.description.display":"Zawiera ustawienia widoku: ustawienie wstępne grafiki, siatkę, cień na podłożu, okluzję otoczenia i rzutowanie.","navbar.description.fit":"Kadruje zaznaczenie lub cały model, jeśli nic nie jest zaznaczone.","navbar.description.grid":"Pokazuje lub ukrywa siatkę podłoża.","navbar.description.ground_shadow":"Pokazuje lub ukrywa cień pod modelem.","navbar.description.home":"Wraca do widoku izometrycznego całego modelu.","navbar.description.look_at":"Obraca widok przodem do zaznaczonej ściany, płaszczyzny lub otwartego szkicu.","navbar.description.orbit":"Obraca widok wokół modelu.","navbar.description.pan":"Przesuwa widok w bok, w górę lub w dół.","navbar.description.projection":"Przełącza między widokiem ortogonalnym a perspektywicznym.","navbar.description.separator":"Cienka linia grupująca sąsiednie miejsca.","navbar.description.spin":"Obraca widok bez przerwy, aż klikniesz lub naciśniesz klawisz.","navbar.description.visual_style":"Przełącza sposób rysowania modelu: cieniowany, krawędziowy lub z krawędziami niewidocznymi.","navbar.description.zoom":"Przybliża lub oddala widok od modelu.","navbar.display":"Wyświetlanie","navbar.fit":"Dopasuj","navbar.graphics":"Grafika","navbar.grid":"Siatka","navbar.ground_shadow":"Cień na podłożu","navbar.home":"Widok główny","navbar.later":"Później","navbar.look_at":"Patrz na","navbar.more":"Więcej","navbar.orbit":"Obracanie widoku","navbar.orthographic":"Ortogonalny","navbar.pan":"Przesuwanie","navbar.perspective":"Perspektywiczny","navbar.preset":"Ustawienie wstępne","navbar.projection":"Rzutowanie","navbar.projection_heading":"Rzutowanie","navbar.separator":"Separator","navbar.show":"Pokaż","navbar.spin":"Ciągłe obracanie","navbar.style.shaded":"Cieniowany","navbar.style.shaded_with_edges":"Cieniowany z krawędziami","navbar