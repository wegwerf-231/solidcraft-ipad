rves must be in one sketch":"kurvene må ligge i én skisse","the direction must be an axis, a sketch line or a straight edge":"retningen må være en akse, en skisselinje eller en rett kant","the duration must be a number of seconds, 0.001 or more":"varigheten må være et antall sekunder, 0,001 eller mer","the line's sketch is gone":"linjens skisse finnes ikke lenger","the lines must be in one sketch":"linjene må ligge i én skisse","the lines must be in one sketch, not the section's":"linjene må ligge i én skisse, ikke i tverrsnittets","the parts library is empty":"delbiblioteket er tomt","the parts library is not available":"delbiblioteket er ikke tilgjengelig","the path curves must be in one other sketch":"banekurvene må ligge i én annen skisse","the path's sketch is gone":"banens skisse finnes ikke lenger","the position must be a number":"posisjonen må være et tall","the preview failed":"forhåndsvisningen mislyktes","the profiles and curves must be in one sketch":"profilene og kurvene må ligge i én skisse","the reference face must be on the edges' body":"referanseflaten må ligge på kantenes kropp","the scale must be above 0":"skalaen må være større enn 0","the section's profiles must be in one sketch":"tverrsnittets profiler må ligge i én skisse","the two origins are on the same component":"de to origoene ligger på samme komponent","thread.automatic_size":"Automatisk størrelse","thread.designation":"Betegnelse","thread.direction":"Gjengeretning","thread.iso_metric":"ISO-metrisk","thread.left_hand":"Venstregjenget","thread.right_hand":"Høyregjenget","thread.select_size":"Velg størrelse","timeline.delete_after_marker_one":"Slett 1 funksjon etter historikkmarkøren","timeline.delete_after_marker_other":"Slett {count} funksjoner etter historikkmarkøren","timeline.delete_folders_tip":"Behold funksjonene og de nestede mappene i tidslinjen","timeline.delete_folders_with_features_tip":"Slett mappene med alle funksjonene i dem og de nestede mappene deres","timeline.delete_many":"Slett {count} valgte funksjoner","timeline.edited_rolled_back":"{name} er endret, men ligger etter tidslinjemarkøren og bygges derfor ikke: flytt markøren forbi den for å se resultatet","timeline.feature_error":"Feil: {message}","timeline.feature_hint":"Dobbeltklikk for å redigere · dra for å endre rekkefølge · høyreklikk for mer","timeline.feature_rolled_back":"Rullet tilbake: etter tidslinjemarkøren, så den bygges ikke","timeline.feature_warning":"Advarsel: {message}","timeline.group":"Ny funksjonsgruppe","timeline.move_many":"Flytt tidslinjeelementer","timeline.move_to_group":"Flytt funksjoner til gruppe","timeline.rename_group":"Gi nytt navn til funksjonsgruppe","timeline.reorder_many":"Omorganiser funksjoner","timeline.suppress_features":"Undertrykk funksjoner","timeline.suppress_folders_tip":"Undertrykk eller opphev undertrykking av alle funksjoner i mappene og de nestede mappene deres","timeline.ungroup":"Opphev funksjonsgruppering","timeline.unsuppress_features":"Opphev undertrykking av funksjoner","to the face":"til flaten","to the next face":"til neste flate","toolbar.customize_note":"Fanen {tab}. Kryss av for en kommando for å legge til en knapp på verktøylinjen. Du kan også dra en rad fra panelets nedtrekksmeny til verktøylinjen, dra en knapp ut av verktøylinjen for å fjerne den, eller feste en kommando fra nedtrekksmenyen.","toolbar.image":"BILDE","toolbar.render":"RENDRING","toolbar.render_appearance":"UTSEENDE","toolbar.render_camera":"KAMERA","toolbar.render_environment":"MILJØ","toolbar.render_lighting":"BELYSNING","toolbar.render_lights":"LYS","toolbar.render_result":"RESULTAT","toolbar.render_scene":"SCENE","toolbar.render_stage":"SCENE","toolbar.render_studio":"STUDIO","trace.points":"{count} punkter langs banen","trace.stopped_by_contact":"Stoppet ved prøve {sample}: {a} ville trenge gjennom {b}","trace.stopped_by_loop":"Stoppet ved prøve {sample}: leddsløyfen gjennom {joint} kan ikke lukkes videre","trim by sketch curves, or by one plane or 