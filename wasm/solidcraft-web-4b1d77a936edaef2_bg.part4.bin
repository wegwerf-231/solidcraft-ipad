ires calibration","render.library_capabilities":"Capability specifications","render.library_center":"Rig center","render.library_clear_search":"Clear","render.library_details":"Specification and provenance","render.library_emitters_only_ack":"Use emitters only; omit the documented passive cards","render.library_empty":"No matching resources. Try a different query or availability filter.","render.library_environment_concepts":"Environment concepts","render.library_extent":"Subject extent","render.library_favorite":"Add favorite","render.library_favorites":"Favorites","render.library_filters":"Catalog and availability","render.library_grid":"Grid","render.library_hdr":"Built-in HDR environments","render.library_hdr_help":"Embeds the original HDR in the saved setup. The authored longitude origin is converted explicitly; no external file is needed after saving.","render.library_in_design":"In Design","render.library_inspect_only":"Select to inspect; nothing is applied automatically. Favorites and recent history belong to this open document session.","render.library_ior":"IOR","render.library_light_concepts":"Lighting concepts","render.library_list":"List","render.library_maps_help":"Built-in maps can be saved with pinned sources and local occurrence mapping. Temporary optical overrides remain a separate mode.","render.library_material_concepts":"Material concepts","render.library_metallic":"Metallic","render.library_native_scenes":"Native studios","render.library_next":"Next page","render.library_omitted":"Not included","render.library_opacity":"Opacity","render.library_other":"Other appearances","render.library_physical_profiles":"Physical reference profiles","render.library_previous":"Previous page","render.library_quality_concepts":"Quality specifications","render.library_recent":"Recent","render.library_replace_environment":"Replace the existing environment explicitly","render.library_replace_studio":"Replace saved lighting, environment and stage","render.library_re