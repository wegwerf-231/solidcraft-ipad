ender.cpu_budget_help":"יש לבחור מגבלות גדולות יותר במפורש. הרזולוציה והדגימות לעולם אינן מופחתות אוטומטית.","render.cpu_budget_memory":"תקרת זיכרון למשימה","render.cpu_budget_not_guarantee":"אלה תקרות קבלה, לא הקצאת RAM ולא ערובה למהירות. הגאומטריה, הפילם והתצוגות המקדימות השמורות חולקים את תקציב הזיכרון; ניתן תמיד לבטל את ההדמיה.","render.cpu_budget_resize":"הטיוטה חורגת מפרופיל ה־CPU הזה או מתקציב דגימות המצלמה שלו. יש לקבל במפורש ממדים קטנים יותר או לבחור פרופיל גדול יותר.","render.cpu_budget_studio":"סטודיו (תמונות גדולות)","render.cpu_budget_triangles":"תקרת משולשים","render.cpu_budget_workstation":"תחנת עבודה (סצנות כבדות)","render.cpu_captured_hdr":"HDR שנלכד לתמונה זו","render.cpu_check_capture_help":"בדיקה והתחלה מאמתות את אותו תקציר קובץ או משתמשות ב־HDR המוטמע. כל תמונה שומרת את המקור שנלכד עבורה.","render.cpu_check_changed":"הפקדים או המודל השתנו אחרי הבדיקה הזאת. יש לבדוק שוב לפני ההדמיה.","render.cpu_constant_help":"קרינה קבועה נראית לקרניים מוחזרות או מועברות. היא אינה מספקת תאורה מפוזרת ישירה.","render.cpu_custom_directions":"החלפת הפרופיל המוכן באורות כיווניים מותאמים","render.cpu_direction":"כיוון אל האור (X, Y, Z)","render.cpu_directional":"אור כיווני","render.cpu_directional_add":"הוספת אור כיווני","render.cpu_environment":"סביבת CPU","render.cpu_environment_background":"רקע התמונה נשאר נפרד מתאורת הסביבה.","render.cpu_environment_bounds":"עוצמת CPU חייבת להיות 0–64, סיבוב HDR סופי בטווח ±1,000,000 רדיאנים, ודגימות HDR 1, 4, 16 או 64.","render.cpu_environment_constant":"סביבה קבועה לקרניים משניות","render.cpu_environment_none":"ללא סביבת CPU","render.cpu_environment_samples":"דגימות תאורת HDR","render.cpu_exposure_help":"חשיפת CPU חייבת להיות בין −16 ל־16 EV. חשיפת GPU מחוץ לטווח הזה נשמרת עד שמשנים אותה.","render.cpu_fixed":"תמונה בודדת","render.cpu_hdr_help":"קובץ Radiance .hdr, פנורמה 2:1, עד 2048 × 1024 ו־16 MiB. CPU דורש בקובץ צבעי יסוד sRGB/D65 מפורשים; צבעי יסוד לא מוגדרים וקובצי EXR נדחים.","render.cpu_hdr_reflection_help":"החזרות HDR מחוספסות דורשות משטחי גופים ופאות מתכתיים לחלוטין. הבדיקה מדווחת על צירופים שאינם נתמכים.","render.cpu_key_rim":"ראשי ושוליים","render.cpu_last_check":"בדיקת CPU אחרונה","render.cpu_light_help":"עד שמונה אורות כיווניים. רשימה מותאמת ריקה מכבה אותם; בחירת פרופיל מוכן משחזרת את האורות שלו. הצבעים הם RGB ליניארי והעוצמה יחסית, לא בוואטים.","render.cpu_light_intensity":"עוצמה יחסית (0–64)","render.cpu_light_minimum":"מרחק מינימלי להנחתה","render.cpu_light_position":"מיקום בעולם (X, Y, Z)","render.cpu_light_reference":"מרחק ייחוס לעוצמה","render.cpu_light_remove":"הסרת האור","render.cpu_lighting":"פרופיל תאורה מוכן","render.cpu_lights":"אורות CPU","render.cpu_linear_color":"צבע ליניארי (R, G, B)","render.cpu_neutral":"ניטרלי","render.cpu_opaque_required":"מעקב קרניים ב־CPU דורש רקע אטום. יש לבטל את „רקע שקוף” כדי להמשיך.","render.cpu_options_pending":"לוח CPU זה עדיין אינו יכול לערוך פליטה, אפקטי משטח, זכוכית או אנאיזוטרופיה. יש לנקות את אפשרויות ה־API האלה לפני השימוש בו.","render.cpu_point":"אור נקודתי","render.cpu_point_add":"הוספת אור נקודתי","render.cpu_point_help":"עד שמונה אורות נקודתיים, המתווספים לתאורה הכיוונית שנבחרה. המרחקים במילימטרים; המינימום אינו יכול לעלות על מרחק הייחוס.","render.cpu_primary_samples":"דגימות קצה לכל פיקסל","render.cpu_progressive":"CPU הדרגתי","render.cpu_progressive_help":"צבירה של אינטגרטור ה־CPU הקיים במעברים של דגימה ראשית אחת. החזרות שנבחרו דורשות דגימה אחת; אורות שטח, דיאלקטריים ואנאיזוטרופיה דורשים תמונה בודדת.","render.cpu_progressive_limits":"לכל היותר 1,048,576 פיקסלים ו־16,777,216 הערכות פיקסל × דגימה. שינוי הדגימות לעולם אינו משנה את גודל התמונה אוטומטית.","render.cpu_progressive_seed":"זרע דגימה ב־CPU","render.cpu_progressive_spp":"דגימות לכל פיקסל","render.cpu_reflection_add":"הוספת החזרה מחוספסת","render.cpu_reflection_depth":"עומק החזרה (1–8)","render.cpu_reflection_empty":"לא נבחרו גופים: החזרות הסצנה כבויות.","render.cpu_reflection_help":"יש לבחור גופים ולהגדיר כבוי, ראי או מחוספס. מחוספס משתמש בחספוס המשטח המוקצה. יותר דגימות והחזרות מאריכות את הזמן; זו העברה ספקולרית מוגבלת, לא תאורה גלובלית.","render.cpu_reflection_limit":"נתמכים עד 64 גופים מוחזרים.","render.cpu_reflection_mirror":"ראי","render.cpu_reflection_off":"כבוי","render.cpu_reflection_rough":"מחוספס","render.cpu_reflection_samples":"דגימות החזרה (1–64)","render.cpu_reflections":"החזרות CPU","render.cpu_runtime_help":"הגדרות האור והסביבה המספריות נשמרות עם ההגדרה. החזרות גופים וקובצי HDR נשארים זמניים. ערכי אורות שטח וקונוסי זרקורים קיימים נשמרים.","render.cpu_sampling_mode":"מצב דגימה ב־CPU","render.cpu_shadows":"הטלת צללים","render.cpu_summary":"מעקב קרניים ב־CPU · החזרות · HDR · אורות כיווניים ונקודתיים","render.cpu_warm_cool":"חם וקר","render.diag_bodies":"גופים גלויים","render.diag_job_details":"פרטי המשימה שנלכדו","render.diag_last_check":"בדיקה מקדימה אחרונה","render.diag_memory":"הערכת קבלה לוגית","render.diag_not_implemented":"גבולות יכולת מפורשים","render.diag_preflight_details":"פרטי הבדיקה המקדימה","render.diag_request":"הבקשה הנוכחית המדויקת","render.diag_triangles":"משולשים","render.discard_continue":"ביטול הטיוטה והמשך","render.draft_confirm_help":"בטיוטת ההדמיה הנוכחית יש עריכות שלא הוחלו. יש לשמור אותן לפני המעבר, לבטל אותן במפורש או להמשיך לערוך.","render.draft_confirm_title":"שמירת הגדרות ההדמיה שנערכו","render.effects_gpu_only":"אפקטים אלה דורשים מעקב מסלולים ב־GPU. החלפת הדף לעולם אינה מחליפה את מנוע ההדמיה אוטומטית.","render.effects_help":"ניתן לשלב מראות צבע מסודרים ואפקטי עדשה במרחב התמונה. ההדמיה ותיקון הצבע מחדש של המאסטר הגולמי משתמשים באותן הגדרות שמורות. ה־EXR הגולמי אינו משתנה. אלה פקדים אמנותיים מקוריים, לא חיקויים מכוילים של עדשות או של סרטי צילום ממותגים.","render.effects_reset_lens":"איפוס אפקטי העדשה","render.effects_seed":"זרע הדוגמה","render.emitted_axis":"ציר פליטה","render.env_advanced":"מתקדם","render.env_backdrop":"רקע","render.env_backdrop_pending":"נראות סביבה וטשטוש רקע אינם נתמכים עדיין במעבד הרינדור.","render.env_blur":"טשטוש","render.env_change":"שנה","render.env_choose_sou