":"Skizze bearbeiten","cmd.sketch_edit_text":"Text bearbeiten","cmd.sketch_equation_curve":"Gleichungskurve","cmd.sketch_equation_curve_edit":"Gleichungskurve bearbeiten","cmd.sketch_export_dxf":"Als DXF speichern","cmd.sketch_finish_auto_constrain":"Mit Auto-Bedingung fertigstellen","cmd.sketch_fit_curves_to_section":"Kurven an Netzquerschnitt anpassen","cmd.sketch_glyphs":"Bedingungssymbole","cmd.sketch_include_3d":"3D-Geometrie einbeziehen","cmd.sketch_infinite":"Unendliche Linie","cmd.sketch_insert_dxf":"DXF einfügen","cmd.sketch_insert_svg":"SVG einfügen","cmd.sketch_inspect":"Skizze prüfen","cmd.sketch_intersection_curve":"Schnittkurve","cmd.sketch_isoparametric_curve":"Isoparametrische Kurve","cmd.sketch_line3d":"3D-Linie","cmd.sketch_line_midpoint":"Linie über den Mittelpunkt","cmd.sketch_loose_ends":"Lose Enden","cmd.sketch_loose_ends_tie":"Lose Enden verknüpfen","cmd.sketch_move":"Skizzenentitäten verschieben/kopieren","cmd.sketch_move3d":"3D-Punkt verschieben","cmd.sketch_move_point":"Skizzenpunkt ziehen","cmd.sketch_offset_break":"Versatzverknüpfung trennen","cmd.sketch_options":"Skizzenpalettenoptionen","cmd.sketch_paste":"Skizzenelemente einfügen","cmd.sketch_point3d":"3D-Punkt","cmd.sketch_polygon_circumscribed":"Umgeschriebenes Polygon","cmd.sketch_polygon_edge":"Polygon über eine Kante","cmd.sketch_polygon_inscribed":"Eingeschriebenes Polygon","cmd.sketch_project_to_surface":"Auf Fläche projizieren","cmd.sketch_rectangle_center":"Rechteck vom Mittelpunkt","cmd.sketch_rectangle_rounded":"Abgerundetes Rechteck","cmd.sketch_rectangle_three_point":"3-Punkt-Rechteck","cmd.sketch_rectangle_two_point":"2-Punkt-Rechteck","cmd.sketch_redefine":"Skizzierebene neu definieren","cmd.sketch_slot_arc_center":"Mittelpunkt-Bogenschlitz","cmd.sketch_slot_arc_three_point":"3-Punkt-Bogenschlitz","cmd.sketch_slot_center_point":"Mittelpunktschlitz","cmd.sketch_slot_center_to_center":"Schlitz von Mittelpunkt zu Mittelpunkt","cmd.sketch_slot_overall":"Gesamtschlitz","cmd.sketch_snap":"Einrastinferenz","cmd.sketch_solve":"Skizze lösen","cmd.sketch_spline3d":"3D-Spline","cmd.sketch_spline_control_point":"Spline mit Kontrollpunkten","cmd.sketch_spline_control_point_5":"Spline mit Kontrollpunkten (Grad 5)","cmd.sketch_spline_fit_point":"Spline mit Fitpunkten","cmd.sketch_spline_insert_point":"Splinepunkt hinzufügen","cmd.sketch_spline_reverse":"Splinerichtung umkehren","cmd.sketch_spun_profile":"Gedrehtes Profil","cmd.sketch_toggle_diameter":"Radius / Durchmesser umschalten","cmd.sketch_toggle_driven":"Abhängiges Maß umschalten","cmd.sketch_transform":"Transformieren","cmd.sketch_trim_path":"Entlang Pfad trimmen","cmd.solid_align":"Ausrichten","cmd.solid_boundary_fill":"Begrenzungsfüllung","cmd.solid_bounding_solid":"Begrenzender Körper","cmd.solid_emboss":"Prägen","cmd.solid_move":"Verschieben/Kopieren","cmd.solid_offset_face":"Fläche versetzen","cmd.solid_press_pull":"Drücken/Ziehen","cmd.solid_remove":"Entfernen","cmd.solid_replace_face":"Fläche ersetzen","cmd.solid_rib":"Rippe","cmd.solid_split_face":"Fläche teilen","cmd.solid_web":"Gewebe","cmd.surface_blend":"Verbindungsfläche","cmd.surface_boundary":"Begrenzungsfläche","cmd.surface_extrude":"Flächen-Extrusion","cmd.surface_fair":"Flächenbegradigung","cmd.surface_fillet":"Flächenverrundung","cmd.surface_loft":"Flächen-Loft","cmd.surface_match":"Flächenanpassung","cmd.surface_offset":"Offsetfläche","cmd.surface_patch":"Patch","cmd.surface_reverse_normal":"Normale umkehren","cmd.surface_revolve":"Flächen-Rotation","cmd.surface_ruled":"Regelfläche","cmd.surface_stitch":"Nähen","cmd.surface_sweep":"Flächen-Sweep","cmd.surface_thicken":"Dicke vergeben","cmd.surface_unstitch":"Verbund aufheben","cmd.surface_untrim":"Trimmen aufheben","cmd.timeline_add":"Aufgezeichnetes Merkmal hinzufügen","cmd.timeline_compute_all":"Alles berechnen","cmd.timeline_copy":"Merkmale kopieren","cmd.timeline_dependents":"Merkmalsabhängigkeiten","cmd.timeline_export_script":"Befehlsskript exportieren","cmd.timeline_inspect":"Merkmal prüfen","cmd.timeline_paste":"Merkmale einfügen","cmd.timeline_play":"Verlauf abspielen","cmd.timeline_redefine":"Merkmal bearbeiten","cmd.timeline_rename":"Umbenennen","cmd.timeline_reorder":"Merkmal neu ordnen","cmd.timeline_roll_to":"Verlaufsmarkierung verschieben","cmd.timeline_rollback":"Zeitleistenmarkierung verschieben","cmd.timeline_stop":"Verlauf anhalten","cmd.timeline_suppress":"Merkmal unterdrücken","cmd.view.render_browser":"Render-Browser","cmd.view.render_dock":"Render-Panel verschieben","cmd.view.render_focus":"Render-Fokusansicht","cmd.view.status_details":"Statusdetails des Ansichtsfensters","cmd.view.status_items":"Ansichtsstatus-Elemente","cmd.view_ambient_occlusion":"Umgebungsverdeckung","cmd.view_angle_readout":"Ansichtswinkel","cmd.view_apply":"Benannte Ansicht wiederherstellen","cmd.view_back":"Rückansicht","cmd.view_bottom":"Untersicht","cmd.view_delete":"Benannte Ansicht löschen","cmd.view_fit":"Ansicht einpassen","cmd.view_front":"Vorderansicht","cmd.view_graphics_preset":"Grafikprofil","cmd.view_grid":"Raster","cmd.view_ground_shadow":"Bodenschatten","cmd.view_home":"Startansicht","cmd.view_isometric":"Isometrische Ansicht","cmd.view_left":"Linke Seitenansicht","cmd.view_list":"Benannte Ansichten auflisten","cmd.view_navigate":"Ansicht navigieren","cmd.view_navigation_bar":"Navigationsleiste","cmd.view_next_tab":"Nächster Tab","cmd.view_normal_to":"Senkrecht zur Auswahl","cmd.view_previous_tab":"Vorheriger Tab","cmd.view_rename":"Benannte Ansicht umbenennen","cmd.view_render_frame":"Render-Bildhilfen","cmd.view_right":"Rechte Seitenansicht","cmd.view_save":"Neue benannte Ansicht","cmd.view_shots_strip":"Aufnahmenleiste","cmd.view_spin":"Ansicht kontinuierlich drehen","cmd.view_tool":"Navigationswerkzeug","cmd.view_top":"Draufsicht","cmd.view_visual_style":"Darstellungsstil","color.copy":"Klicken, um Farbwerte zu kopieren","color.edit":"Klicken, um Farbe zu bearbeiten","color.gamma":"Farbwerte im Gammaraum 0-255 anzeigen","color.hex":"Hex","color.hex_help":"#rrggbb oder #rrggbbaa eingeben; sechs Ziffern behalten die Deckkraft bei","color.hex_hint":"#rrggbb","color.hue":"Farbton","color.linear":"Farbwerte im linearen Raum 0-1 anzeigen","color.recent":"Zuletzt verwendete Farben","color.recent_help":"Farben, die Sie in einem beliebigen Farbfeld wählen, erscheinen hier","color.saturation":"Sättigung (Prozent)","color.saturation_value":"Sättigung und Wert","color.selected":"Ausgewählte Farbe","color.step_down":"Schritt nach unten","color.step_up":"Schritt nach oben","color.value":"Hellwert (Prozent)","config.column_filter_empty":"Keine passenden Spalten","contact.components_count":"{count} Komponenten","contact.enabled_label":"aktiviert","coupling.gear_1":"Zahnrad 1","coupling.gear_1_pick":"Zahnrad 1 (optional)","coupling.gear_2":"Zahnrad 2","coupling.gear_2_pick":"Zahnrad 2 (optional)","coupling.internal":"Innenzahnrad","coupling.needs_turn_and_slide":"braucht ein Gelenk, das sich dreht, und eines, das gleitet","coupling.needs_turns":"braucht zwei Gelenke, die sich drehen","coupling.not_round":"keine runde Fläche","coupling.nut":"Mutter","coupling.picked":"gewählt","coupling.pinion":"Ritzel","coupling.pinion_pick":"Ritzel (optional)","coupling.pitch":"Steigung","coupling.rack":"Zahnstange","coupling.radius_1":"Radius 1","coupling.radius_2":"Radius 2","crash.announce":"SolidCraft wurde beim letzten Mal unerwartet beendet oder ist auf einen internen Fehler gestoßen. Ein Absturzbericht wurde gespeichert (Hilfe > Absturzberichte…).","crash.copy_folder":"Ordnerpfad kopieren","crash.copy_path":"Pfad kopieren","crash.deleted":"{count} Bericht(e) gelöscht.","crash.detected_time":"Erkannt {time} UTC","crash.intro":"Absturzberichte bleiben auf diesem Computer und werden nirgendwohin gesendet. Bericht… öffnet einen Entwurf, den Sie prüfen, bevor etwas geteilt wird.","crash.kind_command":"Interner Fehler in einem Befehl","crash.kind_internal":"Interner Fehler","crash.kind_kernel":"Kernelfehler (wiederhergestellt)","crash.kind_unclean":"Unerwartet beendet","crash.previous_session":"Eine frühere SolidCraft-Sitzung wurde unerwartet beendet oder ist auf einen internen Fehler gestoßen. Berichte über unsauberes Beenden werden beim Start erkannt. Details unter Hilfe > Absturzberichte….","crash.replayable":"wiederholbar","crash.report":"Bericht…","crash.unclean_explanation":"Beim späteren Start erkannt; der genaue Zeitpunkt des Beendens wurde nicht aufgezeichnet. Auch ein Herunterfahren des Systems oder ein erzwungener Stopp kann ein unsauberes Beenden verursachen.","delete.and_more":"… und {count} weitere","diagnostic.empty_boolean_component":"In Komponente '{component}' gibt es keinen Körper zum Abziehen oder für eine Schnittmenge; das Werkzeug überschneidet sich eventuell mit '{body}' in Komponente '{other}' – aktivieren Sie diese Komponente oder wählen Sie den Körper als Ziel","dialog.bodies_count":"{count} Körper","dialog.clearance_invalid":"der Abstand muss eine Länge von 0 oder mehr sein","dialog.compute":"Berechnen","dialog.compute_again":"Erneut berechnen","dialog.computing":"Wird berechnet… {seconds} s","dialog.could_not_be_checked":"nicht prüfbar","dialog.custom_axis":"↖ Eigene Achse","dialog.dimension_insert_hint":"Doppelklicken Sie auf eine andere steuernde Bemaßung, um ihren Namen einzufügen","dialog.dimension_name":"Bemaßung: {name}","dialog.edit_title":"{title} bearbeiten","dialog.no_shown_body":"Kein sichtbarer Körper zum Ändern vorhanden. Blenden Sie einen Körper ein oder wählen Sie „Neuer Körper“.","dialog.pattern_sketch_not_object":"Körper oder Funktionen wählen: Eine Skizze ist keines von beiden. Ihre Kurven mit Muster oder Spiegeln in der Skizze wiederholen oder sie zuerst extrudieren.","dialog.select":"↖ Auswählen","dialog.selected_count":"↖ {count} ausgewählt","dialog.selection_guidance":"Wählen Sie eine Eingabe aus, um sie zu ändern. Klicken Sie auf ausgewählte Objekte, um sie zu entfernen; Strg/Cmd-Klick schaltet sie ebenfalls um. Prüfen Sie die Vorschau und drücken Sie dann OK.","dialog.selection_step":"{step} von {total}: {input} auswählen","dialog.step":"Schritt","document.changed_on_disk":"{name} wurde auf dem Datenträger geändert","document.changed_on_disk_detail":"{name} wurde seit dem Öffnen oder letzten Speichern von einem anderen Programm oder Computer geändert. „Überschreiben“ ersetzt diese Änderungen durch Ihre; „Kopie speichern“ behält beide.","document.copy_name":"{name} - Kopie","document.open_anyway":"Trotzdem öffnen","document.open_elsewhere":"{name} ist bereits geöffnet","document.open_elsewhere_detail":"{name} ist in SolidCraft {app} auf {who} geöffnet, seit {when}. Wenn Sie beide speichern, verliert einer von Ihnen Arbeit. Öffnen Sie die Datei schreibgeschützt, um sie anzusehen, ohne sie zu überschreiben.","document.open_read_only":"Schreibgeschützt öffnen","document.opened_read_only":"Schreibgeschützt geöffnet: Speichern fragt nach einer neuen Datei","document.overwrite":"Überschreiben","document.read_only_save":"Dieses Design wurde schreibgeschützt geöffnet: Speichern Sie es als neue Datei","document.save_changes":"Änderungen in {name} speichern?","document.save_copy":"Kopie speichern…","document.unsaved_changes":"{name} enthält ungespeicherte Änderungen. Wenn Sie nicht speichern, gehen sie verloren.","drive.rigid":"{joint} ist ein starres Gelenk. Es hält die verbundenen Teile fest zusammen und ermöglicht daher keine Bewegung. Um die Teile beweglich zu machen, ändern Sie den Gelenktyp unter „Gelenk bearbeiten“: Drehgelenk für Drehbewegungen, Schubgelenk für lineare Bewegungen oder Zylindergelenk für beides.","drive.stopped_by_contact":"Angehalten bei {value}: {a} würde {b} durchdringen","drive.stopped_by_loop":"Angehalten bei {value}: die Schleife über {joint} lässt sich nicht weiter schließen","drive.unconnected":"Bewegt nichts: {part} ist mit nichts Festgesetztem verbunden","dxf.cancel_wait":"Warten, bis der Export angehalten wurde…","dxf.cancelled":"DXF-Export abgebrochen","dxf.cancelling":"DXF-Export wird abgebrochen","dxf.exporting":"DXF wird exportiert","dxf.invalid_tolerance":"Die Kurventoleranz muss zwischen 0,0001 und 1 mm liegen.","dxf.progress.index":"Flächen vorbereiten (2/5)","dxf.progress.meshes":"Netze vorbereiten (1/5)","dxf.progress.occlusion":"Verdeckte Kanten ermitteln (4/5)","dxf.progress.projection":"Geometrie projizieren (3/5)","dxf.progress.write":"DXF schreiben (5/5)","dxf.tolerance":"Kurventoleranz","dxf.tolerance_help":"Nur sichtbare Körper und angezeigte Skizzen. Kurven werden durch gerade Segmente angenähert. Eine kleinere Toleranz liefert feinere Kurven und benötigt mehr Zeit und Speicher.","each rail's curves must be in one sketch":"die Kurven jeder Führungskurve müssen in derselben Skizze liegen","feature computation ended without a result":"die Berechnung des Merkmals wurde ohne Ergebnis beendet","file.open.drawing_filter":"Designs, CAD-Dateien, Netze und Zeichnungen","file_load.built":"Bisher erstellt: {built} von {total} Merkmalen.","file_load.converting":"Volumenkörper {done} von {total} wird konvertiert","file_load.inserting":"Geometrie wird eingefügt","file_load.link_item":"{name} ({done} von {total})","file_load.opening":"Design wird geöffnet","file_load.preparing_thumbnail":"Vorschaubild wird vorbereitet...","file_load.preparing_view":"Ansicht wird vorbereitet...","file_load.preview_note":"Gespeicherte Vorschau. Die Geometrie wird vor dem Bearbeiten geprüft.","file_load.reading":"Datei wird gelesen...","file_load.reading_percent":"Datei wird gelesen... {percent} %","file_load.rebuilding":"Merkmal {done} von {total} wird neu aufgebaut","file_load.recovering":"Design wird wiederhergestellt","file_load.stopping":"Warten, bis der vorherige Vorgang beendet ist...","file_load.updating_links":"Verknüpfungen werden aktualisiert","file_load.waiting":"Warten auf Dateivorgang","fits the face, e.g. M8":"passt zur Fläche, z. B. M8","from the profile":"aus dem Profil","from the rule":"aus der Regel","help.apache":"Apache-Lizenz 2.0","help.appearance.assign":"Weist den ausgewählten Körpern, Flächen oder Komponenten eine Farbe oder ein Erscheinungsbild zu, ohne ihre Masse zu verändern. So können Sie Bauteile optisch unterscheiden oder das Aussehen einer Oberfläche vorab prüfen.","help.assembly.bom":"Listet die Teile des Designs oder einer Komponente mit ihrer Anzahl nach Teilenummer auf und kann die Liste als CSV oder JSON speichern. Als Stückliste für Bestellung und Montage.","help.attributions":"Quellenangaben (ATTRIBUTION.md)","help.build":"Version {version} · Commit {commit} · erstellt am {date}","help.canvas.decal":"Bringt ein Bild wie einen Aufkleber auf eine ebene Fläche des Modells. Damit zeigen Sie ein Etikett, ein Logo oder einen Aufdruck auf einem Teil.","help.canvas.edit":"Ändert eine Zeichenfläche: Lage, Größe, Winkel, Deckkraft, Spiegelung, Sichtbarkeit oder Namen. Damit richten Sie ein Referenzbild an der Skizze aus, die Sie darüber nachzeichnen.","help.canvas.insert":"Legt ein PNG- oder JPEG-Bild als durchscheinende Referenz auf eine Ebene oder Fläche. Damit zeichnen Sie ein Foto oder eine Zeichnung in einer Skizze nach, mit dem Bild auf eine bekannte Größe skaliert.","help.component.break_link":"Löst eine verknüpfte Komponente von ihrer Konstruktionsdatei und behält ihre Körper unverändert. Damit folgt das Teil Änderungen an der Originaldatei nicht mehr.","help.component.capture_position":"Übernimmt die Lage von Teilen, die Sie von Hand verschoben haben, als ihre neue Position. Für Teile, die von keinem Gelenk gehalten und von Hand an ihren Platz gezogen wurden.","help.component.create":"Fügt der Konstruktion eine neue, leere Komponente hinzu, in der aktiven Komponente, sofern Sie kein anderes übergeordnetes Element wählen. Damit bekommt ein neues Teil einer Baugruppe einen eigenen Platz für Körper und Skizzen.","help.component.finish_edit":"Speichert das an Ort und Stelle bearbeitete Teil, kehrt zu seiner Baugruppe zurück und aktualisiert die Baugruppe daraus. Verwenden Sie es, wenn Ihre Änderungen am verknüpften Teil fertig sind.","help.component.from_bodies":"Macht aus jedem gewählten Körper eine eigene Komponente, benannt nach dem Körper. Für Konstruktionen aus losen Körpern, die zu einer Baugruppe mit verbindbaren, beweglichen Teilen werden sollen.","help.component.insert_design":"Fügt eine andere gespeicherte Konstruktion als Komponente ein, die mit ihrer Datei verknüpft ist; ihre Volumenkörper liegen so wie dort. Damit verwenden Sie ein Teil in einer Baugruppe wieder und übernehmen spätere Änderungen mit „Verknüpfungen aktualisieren“.","help.component.properties":"Zeigt Volumen, Masse, Schwerpunkt und Trägheitsmomente einer Komponente anhand der Materialien ihrer Körper. Damit prüfen Sie Gewicht und Balance einer Baugruppe.","help.component.revert_position":"Setzt von Hand verschobene Teile an ihre vorige Stelle zurück und verwirft nicht erfasste Verschiebungen. Damit machen Sie Probebewegungen in einer Baugruppe rückgängig.","help.component.update_links":"Liest die verknüpften Konstruktionsdateien neu ein und ersetzt Körper, wo sie sich geändert haben. Damit übernehmen Sie Änderungen an einem Teil, das diese Baugruppe verwendet.","help.config.configure":"Fügt Parameter, Elemente, Materialien oder Darstellungen als Spalten der Konfigurationstabelle hinzu. Damit bauen Sie Varianten eines Designs, etwa Baugrößen eines Teils.","help.config.preview":"Prüft, ob sich eine Zeile der Konfigurationstabelle aufbauen lässt, ohne das Design oder seinen Verlauf zu ändern. Vor dem Wechsel zu einer Variante, bei der Sie unsicher sind.","help.config.rules":"Zeigt die Regeln der Konfigurationstabelle, ihre Zeilen und die aktive Zeile. Damit sehen Sie, wie die Varianten eines Designs aufgebaut sind.","help.config.table":"Zeigt die Konfigurationstabelle: eine Zeile je Variante, eine Spalte je Parameter oder Element, und ob das Design noch der aktiven Zeile entspricht. Damit überblicken Sie die Varianten eines Designs.","help.connect_note":"Starten Sie jeden Assistenten neu, damit er den SolidCraft-Server lädt. Jede Datei wurde vor der Änderung als .bak gesichert.","help.connect_title":"KI-Assistenten verbinden","help.construct.axis.edge":"Erzeugt eine Konstruktionsachse entlang einer geraden Kante oder Skizzenlinie. Als Achse für Drehung, Kreismuster oder Verbindung.","help.construct.axis.normal_to_face":"Erzeugt eine Konstruktionsachse durch einen Punkt, senkrecht zu einer Fläche. Als Achse, die gerade aus einer Fläche heraussteht.","help.construct.axis.through_cylinder":"Erzeugt eine Konstruktionsachse durch die Mitte einer Zylinder-, Kegel- oder Torusfläche oder einer Kreiskante. Damit drehen oder mustern Sie Elemente um ein rundes Teil.","help.construct.axis.two_planes":"Erzeugt eine Konstruktionsachse, wo sich zwei Ebenen oder ebene Flächen schneiden. Wenn die benötigte Achse die Schnittlinie zweier Flächen ist.","help.construct.axis.two_points":"Erzeugt eine Konstruktionsachse durch zwei Punkte, Eckpunkte oder Skizzenpunkte. Für eine Achse zwischen zwei bekannten Lagen.","help.construct.plane.along_path":"Erzeugt eine Konstruktionsebene senkrecht zu einer Kante oder Kurve, an einer Stelle entlang dieser. Damit skizzieren Sie ein Profil für eine Austragung oder einen Querschnitt eines Pfads.","help.construct.plane.at_angle":"Erzeugt eine Konstruktionsebene, die gegenüber einer Ebene oder Fläche um eine Achse oder Kante gedreht ist. Für schräge Skizzen, etwa eines Winkelhalters.","help.construct.plane.midplane":"Erzeugt eine Konstruktionsebene mittig zwischen zwei Ebenen oder ebenen Flächen oder als Winkelhalbierende, wo sie schräg zueinander stehen. Als Symmetrieebene zum Spiegeln.","help.construct.plane.offset":"Erzeugt eine Konstruktionsebene parallel zu einer Ebene oder ebenen Fläche, in einem Abstand oder durch einen Punkt. Damit skizzieren Sie in fester Höhe über einer Fläche.","help.construct.plane.perpendicular":"Erzeugt eine Konstruktionsebene, die eine Linie oder Kante enthält und senkrecht auf einer Ebene oder Fläche steht. Damit skizzieren Sie aufrecht entlang einer Kante am Modell.","help.construct.plane.tangent":"Erzeugt eine Konstruktionsebene, die einen Zylinder, Kegel, eine Kugel oder einen Torus in einem Punkt berührt. Damit skizzieren Sie seitlich an einem runden Teil.","help.construct.plane.three_points":"Erzeugt eine Konstruktionsebene durch drei Punkte. Für eine Ebene, die durch Lagen am Modell bestimmt ist, etwa drei Ecken.","help.construct.plane.two_edges":"Erzeugt eine Konstruktionsebene durch zwei gerade Kanten oder Linien, die in einer Ebene liegen. Für eine Ebene quer durch ein Teil, etwa durch zwei gegenüberliegende Kanten.","help.construct.point.along_path":"Erzeugt einen Konstruktionspunkt an einer Stelle entlang einer Kante oder Kurve. Als Bezug auf halbem oder beliebigem Weg entlang eines Pfads.","help.construct.point.center":"Erzeugt einen Konstruktionspunkt im Mittelpunkt einer Kreiskante, eines Skizzenkreises oder -bogens, einer Kugel oder eines Torus. Als Bezug für Bohrungen, Achsen und Verbindungen.","help.construct.point.edge_plane":"Erzeugt einen Konstruktionspunkt, wo eine Kante oder Linie eine Ebene oder ebene Fläche durchstößt. Damit markieren Sie, wo ein Pfad eine Ebene kreuzt.","help.construct.point.three_planes":"Erzeugt einen Konstruktionspunkt, wo sich drei Ebenen oder ebene Flächen treffen. Als Eckbezug, auch wo das Modell keinen Eckpunkt hat.","help.construct.point.two_edges":"Erzeugt einen Konstruktionspunkt, wo sich zwei Kanten oder Linien treffen oder am nächsten kommen. Als Bezug an einer virtuellen Ecke.","help.construct.point.vertex":"Erzeugt einen Konstruktionspunkt auf einem Eckpunkt oder Skizzenpunkt. Als Bezug, der bleibt, wenn Skizze oder Körper darum ausgeblendet sind.","help.contact.check":"Listet die Teilepaare in Kontaktsätzen auf, die sich in der aktuellen Stellung durchdringen. Damit finden Sie Kollisionen, bevor Sie Gelenke antreiben oder eine Bewegungsuntersuchung abspielen.","help.contact.create":"Fasst zwei oder mehr Teile zu einem Kontaktsatz zusammen, dessen Körper sich beim Bewegen der Gelenke nicht durchdringen. Für Teile, die beim Berühren anhalten sollen, etwa ein Hebel an seinem Anschlag.","help.contact.disable_all":"Schaltet den Kontakt aus, sodass angetriebene Gelenke und Bewegungsuntersuchungen nicht mehr anhalten, wo sich Teile berühren. Damit bewegen Sie Teile wieder frei oder halten eine große Baugruppe flüssig.","help.contact.edit":"Ändert einen Kontaktsatz: die enthaltenen Teile, den Namen oder ob er unterdrückt ist; der Satz lässt sich auch löschen. Damit passen Sie an, welche Teile sich nicht durchdringen dürfen.","help.contact.enable_all":"Nimmt alle Teile der Baugruppe in einen gemeinsamen Kontaktsatz, sodass sich beim Bewegen der Gelenke keine zwei Teile durchdringen. Für eine schnelle Prüfung des ganzen Mechanismus.","help.contact.enable_sets":"Schaltet den Kontakt für Ihre definierten Kontaktsätze ein, sodass angetriebene Gelenke und Bewegungsuntersuchungen anhalten, wo sich deren Teile durchdringen würden. Damit holen Sie Ihre Sätze zurück, nachdem der Kontakt aus war.","help.contact.list":"Listet die Kontaktsätze der Konstruktion auf, die Teile in jedem Satz und ob der Kontakt eingeschaltet ist. Damit prüfen Sie die Kontakteinstellung, bevor Sie die Baugruppe antreiben.","help.document.inspect":"Zeigt eine Übersicht des Designs: Komponenten, Körper, Skizzen, Elemente und Parameter. Damit finden Sie sich in einem Design zurecht, das Sie nicht selbst gebaut haben.","help.document.units":"Ändert die Einheit, in der die Konstruktion Längen anzeigt, etwa mm oder Zoll. Die Geometrie behält ihre Größe; nur Anzeige und Zahlen ohne Einheit folgen.","help.edit.checkpoint":"Merkt sich das Design, die aktive Skizze und den Rückgängig-Verlauf im jetzigen Zustand. Vor einem riskanten Versuch, von dem Sie vielleicht zurück wollen.","help.edit.restore_checkpoint":"Kehrt zu einem Prüfpunkt zurück, samt Rückgängig-Verlauf. Damit verwerfen Sie alles seit dem Prüfpunkt in einem Schritt.","help.explode.create":"Erstellt eine Explosionsdarstellung, die die Teile vom Mittelpunkt der Baugruppe wegschiebt oder um die von Ihnen festgelegten Wege verschiebt. Damit zeigen Sie, wie eine Baugruppe zusammengesetzt wird, für Anleitungen oder Präsentationen.","help.face.delete":"Entfernt die ausgewählten Flächen. Die angrenzenden Flächen schließen dabei die entstandene Lücke, oder sie bleibt als offene Fläche bestehen. So können Sie beispielsweise eine Rundung, eine Bohrung oder einen störenden Ansatz entfernen.","help.file.insert_mesh":"Fügt eine 3MF-, STL-, OBJ-, PLY- oder glTF-Datei als Netzkörper in einer neuen Komponente in die Konstruktion ein. Damit stellen Sie ein heruntergeladenes oder gescanntes Modell als Referenz neben Ihre Konstruktion.","help.file.insert_step":"Fügt eine STEP-, IGES-, FreeCAD- oder Rhino-Datei als Volumenkörper in einer neuen Komponente in die Konstruktion ein; die Teile einer Baugruppe werden zu verschachtelten Komponenten. Damit übernehmen Sie Modelle von Herstellern oder aus anderen CAD-Programmen.","help.file.save_mesh":"Speichert Körper als STL-, 3MF- oder OBJ-Netz, mit der gewählten Glätte gekrümmter Flächen. Damit bereiten Sie Teile für den 3D-Druck oder für Programme vor, die Netze lesen.","help.file.send_to_slicer":"Speichert die gewählten Körper als 3MF-Datei und öffnet sie im gewählten Slicer. Damit kommen Sie in einem Schritt vom Modell zum Druck.","help.font_details":"Die Oberfläche verwendet die integrierten Schriftarten von egui (Ubuntu Light und Hack unter der Ubuntu Font Licence und der MIT/Bitstream-Vera-Lizenz; Noto Emoji und die Emoji-Symbolschrift unter OFL und MIT). Skizzentext verwendet Liberation Sans (SIL OFL 1.1). Das optionale Schriftpaket craft-fonts von The Crafting Apps (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1) ist nicht in SolidCraft-Builds enthalten.","help.fonts":"Schriftarten","help.frame.member":"Setzt ein Profil, etwa ein Rohr oder ein Aluprofil, entlang der Linien einer Rahmenskizze, ein Stab je Linie. Für Rahmen, Gestelle und Schweißkonstruktionen.","help.inspect.accessibility":"Färbt die Flächen, die ein Werkzeug aus einer Richtung erreicht, und die, die es nicht erreicht. Damit prüfen Sie ein Teil auf Fräsen oder Formen von dieser Seite.","help.inspect.center_of_mass":"Zeigt den Schwerpunkt von Körpern, einzeln und zusammen, bei gleichmäßiger Dichte. Damit prüfen Sie die Balance und wohin ein Teil kippt.","help.inspect.colored_components":"Gibt jeder Komponente vorübergehend eine eigene Farbe, ohne die Darstellungen zu ändern. Damit unterscheiden Sie die Teile einer Baugruppe auf einen Blick.","help.inspect.compare":"Vergleicht zwei Körper und zeigt, wo einer Material hat, das dem anderen fehlt, mit Volumen und Abweichung. Damit prüfen Sie ein geändertes oder importiertes Teil gegen das Original.","help.inspect.continuity":"Prüft, wie glatt Flächen an ihren Kanten ineinander übergehen: Lücken, Knicke oder Krümmungssprünge, und färbt die Nähte. Damit finden Sie Stellen, an denen Flächen nicht sauber anschließen.","help.inspect.curvature_comb":"Zeichnet Kämme an Kurven, Kanten oder Flächen, deren Zinken zeigen, wie stark sie gekrümmt sind. Damit erkennen Sie flache Stellen, Knicke und ungleichmäßige Krümmung.","help.inspect.curvature_map":"Färbt Flächen danach, wie stark sie gekrümmt sind, rot bei kleinem Radius. Damit finden Sie enge Stellen und beurteilen, wie glatt eine Fläche ist.","help.inspect.draft":"Färbt Flächen nach ihrem Formschrägenwinkel zur Entformungsrichtung und markiert die mit zu wenig. Damit prüfen Sie ein Teil vor dem Spritzgießen oder Gießen.","help.inspect.environment_map":"Zeigt das Modell mit spiegelnder Oberfläche. Damit beurteilen Sie den Verlauf von Flächen an der Art, wie Spiegelungen darüber laufen.","help.inspect.interference":"Findet Körper, die sich überschneiden, und zeigt jede Überschneidung mit ihrem Volumen. Damit prüfen Sie eine Baugruppe auf kollidierende Teile.","help.inspect.isocurve":"Zeichnet die isoparametrischen Kurven von Flächen, das Raster, auf dem die Fläche aufbaut. Damit sehen Sie, wie eine Fläche verläuft und wo sie sich staucht.","help.inspect.measure":"Misst Längen, Abstände, Winkel, Flächen und Radien zwischen den gewählten Elementen oder Volumen und Masse von Körpern. Damit prüfen Sie Maße und Abstände.","help.inspect.minimum_radius":"Findet den kleinsten Krümmungsradius von Kurven, Kanten oder Flächen und seine Lage. Damit prüfen Sie, ob ein Werkzeug oder eine Düse der Form folgen kann.","help.inspect.section":"Schneidet die Ansicht entlang einer Ebene auf und schraffiert die Schnittflächen, ohne das Modell zu ändern. Damit schauen Sie in Teile und Baugruppen hinein.","help.inspect.zebra":"Zeigt schwarze und weiße Streifen, die sich auf den Flächen des Modells spiegeln. Damit beurteilen Sie Glätte: Streifen, die an einer Kante brechen oder knicken, zeigen einen schlechten Übergang.","help.joint.as_built":"Verbindet zwei Teile dort, wo sie bereits liegen, ohne eines davon zu verschieben, und legt fest, wie sie sich noch bewegen dürfen. Für Teile, die Sie schon an ihre endgültige Stelle gesetzt haben.","help.joint.cam":"Koppelt eine sich drehende Kurvenscheibe mit einem Stößel, der gleitet oder schwenkt, während die Kontur der Scheibe unter ihm durchläuft. Für Nocken, Exzenter und Ventiltriebe.","help.joint.create":"Verbindet zwei Teile an den gewählten Gelenkursprüngen und bewegt das zweite Teil an seine Stelle; der Gelenktyp legt fest, wie sie sich noch bewegen dürfen. Damit bauen Sie eine Baugruppe, deren Teile sich wie der echte Mechanismus bewegen.","help.joint.drive":"Setzt Winkel oder Weg eines Gelenks und bewegt die Teile mit, innerhalb der Grenzen; gekoppelte Gelenke und geschlossene Schleifen folgen. Damit prüfen Sie, ob sich ein Mechanismus wie gewünscht bewegt.","help.joint.gear":"Koppelt zwei Drehgelenke mit einer Übersetzung, sodass das Antreiben des einen das andere dreht. Für Stirn- und Hohlräder, mit der Übersetzung aus Teilkreisradien oder Zähnezahlen.","help.joint.limits":"Legt fest, wie weit sich ein Gelenk drehen oder schieben darf, als Minimum und Maximum, oder hebt diese Grenzen auf. Damit bleibt ein Scharnier, Schieber oder Hebel in seinem echten Bewegungsbereich.","help.joint.motion_link":"Koppelt zwei Gelenke über ein Verhältnis und einen Versatz, sodass das Antreiben des einen das andere bewegt. Für feste Beziehungen zwischen Gelenken, die Zahnrad, Zahnstange und Ritzel oder Schraube nicht abdecken.","help.joint.origin":"Setzt einen benannten Gelenkursprung auf ein Teil: in die Mitte einer Fläche oder eines runden Endes, auf die Mitte einer Kante, an eine Ecke oder einen Punkt. Damit bereiten Sie vor, wo Gelenke ansetzen; auf einer Fläche gewählt, folgt er ihr, wenn sich die Größe des Teils ändert.","help.joint.rack_pinion":"Koppelt ein drehendes Ritzel mit einer gleitenden Zahnstange, die sich um die abgewälzte Länge des Teilkreises verschiebt. Für Zahnstangenantriebe, Lenkungen und Lineartische.","help.joint.reach":"Bewegt einen Punkt eines Teils auf ein Ziel zu, indem die Gelenke seiner Kette innerhalb ihrer Grenzen verstellt werden. Damit stellen Sie einen Mechanismus über die Lage seines Endes ein, etwa der Spitze eines Roboterarms.","help.joint.rigid_group":"Verbindet die gewählten Teile starr in ihrer jetzigen Lage, sodass sie sich als Einheit bewegen. Für Teile, die zusammengehören und sich gegeneinander nicht bewegen.","help.joint.screw":"Koppelt Drehen und Schieben über eine Steigung, sodass jede Umdrehung um diesen Weg vorrückt. Für Gewindespindeln, Schrauben und Trapezspindeln.","help.library.apply":"Wendet ein Material oder eine Darstellung aus einer lokalen Bibliotheksdatei auf Körper, Flächen oder Komponenten an. Damit nutzen Sie Materialien aus einem anderen Design wieder.","help.library.export":"Speichert die Materialien und Darstellungen des Designs in einer Bibliotheksdatei. Damit teilen Sie sie oder nutzen sie in anderen Designs wieder.","help.library.inspect":"Prüft eine Bibliotheksdatei und listet ihre Materialien und Darstellungen auf, ohne das Design zu ändern. Damit sehen Sie vor dem Anwenden, was eine Bibliothek enthält.","help.licences":"Lizenzen","help.material.assign":"Legt fest, aus welchem Werkstoff die ausgewählten Körper bestehen, beispielsweise Stahl, Aluminium oder ABS. Dadurch entspricht die berechnete Masse derjenigen des realen Bauteils.","help.material.properties.validate":"Prüft eine Materialdatenkarte auf stimmige Werte und fehlende Angaben. Bevor Sie sich für Masse oder Steifigkeit auf die Daten verlassen.","help.mesh.convert":"Baut einen Netzkörper, etwa aus einer STL, als bearbeitbaren Volumenkörper mit ebenen und zylindrischen Flächen nach. Damit ändern Sie importierte Maschinenteile wie einen modellierten Körper.","help.mit":"MIT-Lizenz","help.motion.study":"Legt Gelenkwerte an Schritten entlang einer Zeitleiste fest und spielt sie als Animation ab. Damit sehen Sie einen Mechanismus einen Ablauf durchlaufen und prüfen unterwegs die Abstände.","help.motion.trace":"Verfolgt die Bahn eines Punkts auf einem Teil, während eine Bewegungsuntersuchung läuft oder ein Gelenk angetrieben wird, und behält sie beim Bestätigen als 3D-Skizzenkurve. Damit sehen Sie, wohin ein Mechanismus reicht, oder bauen auf seiner Bahn auf.","help.notice":"NOTICE","help.occurrence.ground":"Setzt ein Teil an seiner Stelle fest oder gibt es wieder frei, sodass Gelenke die übrigen Teile um es herum bewegen. Für den Rahmen oder Sockel, auf dem der Rest der Baugruppe aufbaut.","help.occurrence.move":"Bewegt eine Baugruppeninstanz ausschließlich entlang der Freiheitsgrade, die ihre Gelenke zulassen. Wählen Sie eine Fläche des Bauteils aus und ziehen Sie anschließend einen der verfügbaren Pfeile oder Bögen.","help.parameters.change":"Öffnet die Tabelle mit benannten Parametern und Ausdrücken, die die Abmessungen des Designs steuern. Ändern Sie einen Wert an einer zentralen Stelle, werden alle Features, die diesen Wert verwenden, entsprechend aktualisiert.","help.parameters.export":"Speichert die Parameter des Designs als CSV oder JSON. Damit bearbeiten Sie sie in einer Tabellenkalkulation oder übertragen sie in ein anderes Design.","help.parameters.graph":"Zeigt, welche Parameter und Elemente welche anderen nutzen, samt Schleifen oder Fehlern. Damit sehen Sie, was eine Parameteränderung beeinflusst.","help.parameters.import":"Liest Parameter aus CSV oder JSON in das Design ein, alle oder keine. Damit übernehmen Sie Werte aus einer Tabelle oder einem anderen Design.","help.parameters.move":"Verschiebt einen Benutzerparameter vor oder hinter einen anderen in der Liste. So bleiben zusammengehörige Parameter beieinander.","help.parts.fastener":"Fügt eine genormte Schraube, Mutter, Unterlegscheibe, einen Stift oder ein Lager in der gewählten Größe ein. Auf ein Loch gesetzt, sitzt es mit einem Gelenk darin, sodass Sie Verbindungselemente nicht selbst modellieren müssen.","help.parts.insert":"Fügt ein Normteil in der gewählten Art, Größe und Länge ein. Auf den Rand oder die Wand eines Lochs gesetzt, sitzt es mit einem starren Gelenk auf dem Loch.","help.parts.library":"Öffnet die Standardbauteile: Schrauben, Muttern, Unterlegscheiben, Gewindestifte, Passstifte und Lager in Normgrößen. Damit fügen Sie ein Normteil ein, statt es selbst zu modellieren.","help.parts.resize":"Ändert Größe oder Länge eines eingefügten Normteils und baut es neu auf; seine Gelenke halten es an seinem Platz. Für den Fall, dass eine Schraube zu lang ist oder ein Loch eine andere Größe braucht.","help.plastic.assign_rule":"Weist Körpern eine Kunststoffregel zu, sodass ihre Kunststoffelemente deren Formschräge und Spiel als Vorgabe nehmen. Damit richten Sie ein Spritzgussteil einmal für alle seine Elemente ein.","help.plastic.boss":"Fügt einen Ansatz (Schraubdom) auf einer Fläche hinzu: einen Zapfen mit optionaler Bohrung, Formschräge, Fußrundung und Stützrippen. Für Schraubstellen in gespritzten oder gedruckten Gehäusen.","help.plastic.lip":"Fügt entlang des Rands eines ausgehöhlten Körpers eine Lippe oder eine passende Nut hinzu. Damit zentrieren sich zwei Gehäusehälften aufeinander und schließen dicht.","help.plastic.manage_rules":"Erstellt und bearbeitet Kunststoffregeln: Material, Wandstärke, Radien, Spiel und Formschräge. Damit halten Sie die Elemente eines Spritzgussteils einheitlich.","help.plastic.rest":"Fügt eine Auflage auf einer Fläche hinzu: ein rundes oder rechteckiges Polster, voll oder hohl, mit Formschräge. Als Stütze oder Abstandshalter in einem Spritzgussgehäuse.","help.plastic.snap_fit":"Fügt eine Rastverbindung auf einer Fläche hinzu: einen Schnapphaken mit Länge, Dicke und Rastnase. Damit klipsen Sie Teile ohne Schrauben zusammen.","help.pointcloud.insert":"Fügt einen PLY-, XYZ- oder PTS-Scan als Punktwolke neben dem Modell ein. Verwenden Sie ihn als Referenz beim Modellieren anhand von Messdaten.","help.sheet.convert":"Macht aus einer Platte oder einem ausgehöhlten Körper gleichmäßiger Dicke einen Blechkörper, mit Biegungen an den gewählten Kanten. Damit wird ein vorhandenes Teil abwickelbar.","help.sheet.export_bend_table":"Speichert die Biegungstabelle eines Blechkörpers als CSV oder JSON: Winkel, Radien und Lage der Biegungen im Flachmuster. Für die Abkantpresse oder die Werkstatt.","help.sheet.export_dxf":"Speichert das Flachmuster als DXF, mit Konturen, Biegelinien und optionalen Biegevermerken. Für Laser-, Plasma- oder Wasserstrahlschneiden.","help.sheet.flange":"Fügt einen Flansch hinzu: eine Grundplatte aus einer Skizze, eine Wand entlang einer offenen Skizzenkontur oder eine gebogene Wand an Blechkanten. Damit bauen Sie Blechteile auf.","help.sheet.flat_pattern":"Erstellt das Flachmuster eines Blechkörpers mit Größe, Ausschnitten und Biegelinien. Damit prüfen Sie den Zuschnitt, bevor Sie ihn schneiden.","help.sheet.fold":"Faltet ein Blech entlang einer Skizzenlinie um einen Winkel und Radius. Damit falten Sie ein flaches Blech, nachdem Sie Elemente hineingeschnitten haben.","help.sheet.hem":"Faltet eine Blechkante auf sich selbst zurück. Für sichere, steife Kanten ohne scharfen Grat.","help.sheet.manage_rules":"Erstellt und bearbeitet Blechregeln: Dicke, Biegeradius, K-Faktor, Freischnitte und Spalte. Damit passen Sie die Teile an Material und Werkzeuge Ihrer Werkstatt an.","help.sheet.path_flange":"Fügt entlang einer Blechkante eine Kette von Flanschen hinzu, die einer offenen Kette von Skizzenlinien folgt. Für Profile wie eine U- oder Z-Form in einem Schritt.","help.sheet.perforate":"Fügt über das ganze flache Blech ein Lochfeld hinzu, versetzt oder quadratisch. Für Lüftungen, Gitter und leichtere Bleche.","help.sheet.refold":"Faltet einen entfalteten Blechkörper wieder auf. Nachdem Sie dem flachen Blech Elemente hinzugefügt haben.","help.sheet.unfold":"Entfaltet alle Biegungen eines Blechkörpers. Damit fügen Sie Bohrungen oder Schnitte hinzu, die über eine Biegung laufen müssen, und falten dann wieder.","help.sketch.arc.center_point":"Zeichnet einen Kreisbogen um einen Mittelpunkt, von einem Start- zu einem Endpunkt. Für Bögen mit bekanntem Mittelpunkt, etwa einen Radius um eine Bohrung oder einen Drehpunkt.","help.sketch.arc.tangent":"Zeichnet einen Bogen, der am Ende einer Linie oder eines Bogens tangential weiterläuft. Damit setzen Sie eine Kette mit einer weichen Biegung statt einer Ecke fort.","help.sketch.arc.three_point":"Zeichnet einen Bogen von einem Start- zu einem Endpunkt durch einen dritten Punkt. Für Bögen, die durch vorgegebene Punkte laufen sollen statt um einen bekannten Mittelpunkt.","help.sketch.arc3d":"Zeichnet bei eingeschalteter 3D-Skizze einen exakten Kreisbogen im Raum durch drei Punkte. Für Biegungen in Pfaden und Leitkurven, die die Skizzenebene verlassen.","help.sketch.auto_constrain":"Fügt die Bedingungen hinzu, die die Skizze schon fast erfüllt, etwa horizontal, parallel oder koinzident, und bemaßt sie dann vollständig. Damit legen Sie eine grob gezeichnete Skizze in einem Schritt fest.","help.sketch.auto_constrain_from_datum":"Arbeitet wie Auto-Bedingung, misst die Lagen aber von einem gewählten Bezugspunkt statt vom Ursprung. Für Teile, die von einem Bezugspunkt aus bemaßt werden, etwa einer Ecke oder einer Bohrung.","help.sketch.blend_curve":"Verbindet die Enden zweier Kurven mit einem glatten Spline, der an beide tangential oder auf Wunsch auch krümmungsstetig anschließt. Damit überbrücken Sie eine Lücke zwischen Kurven ohne Knick.","help.sketch.break":"Teilt eine Kurve an den Stellen, an denen andere Kurven sie kreuzen, oder an Punkten, die Sie auf ihr setzen. Wenn ein Stück der Kurve eine eigene Bedingung braucht oder einzeln gelöscht werden soll.","help.sketch.cancel":"Verlässt die Skizze und verwirft alles, was seit dem Erstellen oder Öffnen zum Bearbeiten geändert wurde. Mit Rückgängig holen Sie die Änderungen zurück.","help.sketch.centerline":"Schaltet Linien zwischen normalen Linien und Mittellinien um, also Achsen, die nicht zu Profilen gehören. Eine Mittellinie dient als Achse für Drehen, Spiegeln oder eine Symmetriebedingung.","help.sketch.chamfer.distance_angle":"Schrägt die Ecke zwischen zwei Linien ab, bestimmt durch einen Abstand entlang der ersten Linie und einen Winkel. Wenn eine Zeichnung die Fase als Länge und Winkel angibt, etwa 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Schrägt die Ecke zwischen zwei Linien mit gleichem Abstand auf beiden Seiten ab. Für die übliche 45°-Fase an einer Kontur.","help.sketch.chamfer.two_distance":"Schrägt die Ecke zwischen zwei Linien mit je einem eigenen Abstand entlang jeder Linie ab. Für Fasen, die nicht 45° haben und mit zwei Längen angegeben sind.","help.sketch.circle.center":"Zeichnet einen Kreis aus Mittelpunkt und Durchmesser. Für Bohrungen, Zapfen und andere runde Formen mit bekanntem Mittelpunkt.","help.sketch.circle.three_point":"Zeichnet einen Kreis durch drei Punkte. Wenn der Kreis durch vorgegebene Punkte laufen soll, etwa auf vorhandener Geometrie.","help.sketch.circle.three_tangent":"Zeichnet einen Kreis, der drei Linien, Kreise oder Bögen berührt. Damit setzen Sie einen Kreis passend zwischen drei Kurven, etwa den Inkreis eines Dreiecks.","help.sketch.circle.two_point":"Zeichnet einen Kreis aus den beiden Enden seines Durchmessers. Wenn die Randpunkte des Kreises bekannt sind statt seines Mittelpunkts.","help.sketch.circle.two_tangent":"Zeichnet einen Kreis vorgegebener Größe, der zwei Linien, Kreise oder Bögen berührt. Für eine Rundung mit festem Radius zwischen zwei Kurven.","help.sketch.conic":"Zeichnet einen Kegelschnitt zwischen zwei Endpunkten, geformt durch einen Scheitelpunkt und einen Rho-Wert. Für weiche Übergänge, deren Völle Sie einstellen wollen, von flach bis fast zur scharfen Ecke.","help.sketch.constrainer":"Setzt die Bedingung, die eine oder zwei gewählte Kurven schon fast erfüllen, etwa horizontal, parallel, tangential oder gleich. Damit räumen Sie eine frei gezeichnete Skizze Beziehung für Beziehung auf.","help.sketch.constraint.coincident":"Legt einen Punkt auf einen anderen Punkt, eine Kurve oder eine Skizzenachse. Damit schließen Sie Lücken in einem Profil oder setzen einen Punkt auf eine Linie.","help.sketch.constraint.collinear":"Legt zwei Linien auf eine gemeinsame Gerade. Damit richten Sie unterbrochene Kanten aus, etwa die beiden Seiten einer Kerbe.","help.sketch.constraint.concentric":"Gibt zwei Kreisen oder Bögen denselben Mittelpunkt. Für Ringe, Senkungen und abgesetzte Wellen.","help.sketch.constraint.curvature":"Lässt zwei Kurven, die sich an einem Endpunkt treffen, mit gleicher Krümmung ineinander übergehen (G2). Wo ein tangentialer Übergang nicht glatt genug ist, etwa an Sichtflächen.","help.sketch.constraint.equal":"Macht Linien gleich lang oder Kreise und Bögen gleich groß im Radius. So steuert ein Maß mehrere gleiche Elemente.","help.sketch.constraint.fix":"Fixiert Punkte oder Kurven an ihrer Stelle oder löst sie wieder. Für Geometrie, die sich beim Ziehen oder Lösen der Skizze nicht bewegen darf.","help.sketch.constraint.horizontal_vertical":"Macht eine Linie oder die Verbindung zweier Punkte horizontal oder vertikal, je nachdem, was näher liegt. Damit richten Sie eine Kontur an den Skizzenachsen aus.","help.sketch.constraint.midpoint":"Setzt einen Punkt auf die Mitte einer Linie oder lässt die Mittelpunkte zweier Linien zusammenfallen. Damit mitten Sie Geometrie auf einer Kante ein.","help.sketch.constraint.parallel":"Macht zwei Linien parallel. Für Seiten, die parallel bleiben müssen, wenn sich andere Maße ändern.","help.sketch.constraint.perpendicular":"Stellt zwei Linien rechtwinklig zueinander. Für rechte Winkel zwischen Linien, die nicht an den Skizzenachsen liegen.","help.sketch.constraint.polygon":"Macht eine geschlossene Linienkette zum regelmäßigen Polygon: gleich lange Seiten, alle Ecken auf einem Kreis. Damit machen Sie ein frei gezeichnetes Vieleck regelmäßig und halten es so.","help.sketch.constraint.symmetry":"Lässt zwei Punkte oder Kurven an einer Linie oder einem Punkt gespiegelt liegen. So bleibt ein Profil symmetrisch, wenn Sie eine Seite ändern.","help.sketch.constraint.tangent":"Lässt zwei Kurven tangential aneinanderstoßen, etwa eine Linie und einen Bogen. Für glatte Übergänge ohne Knick.","help.sketch.construction":"Schaltet Kurven zwischen normaler Geometrie und Konstruktionsgeometrie um, die nicht zu Profilen gehört. Konstruktionskurven dienen als Hilfen für Aufteilung, Bezüge und Maße.","help.sketch.construction_line":"Erstellt eine unendliche Konstruktionslinie durch zwei Punkte, ohne Skizzenprofile zu teilen.","help.sketch.construction_line.angle":"Erstellt eine unendliche Konstruktionslinie in einem Winkel zur Skizzen-X-Achse. Punkt wählen und Winkel eingeben oder Richtung wählen.","help.sketch.construction_line.bisector":"Zwei sich schneidende gerade Skizzenlinien wählen, dann eine der beiden Winkelhalbierenden. Das Ergebnis folgt den Ausgangslinien.","help.sketch.construction_line.horizontal":"Erstellt eine unendliche horizontale Konstruktionslinie durch einen Punkt. Die Horizontalbedingung bleibt bei späteren Änderungen erhalten.","help.sketch.construction_line.parallel":"Gerade Skizzenlinie wählen, dann eine parallele unendliche Konstruktionslinie platzieren. Rechtsklick wählt eine andere Referenz.","help.sketch.construction_line.perpendicular":"Gerade Skizzenlinie wählen, dann eine senkrechte unendliche Konstruktionslinie platzieren. Rechtsklick wählt eine andere Referenz.","help.sketch.construction_line.tangent_at":"Erstellt eine Tangente an einem Punkt eines Kreises oder Kreisbogens oder an einem Endpunkt eines offenen Splines oder Kegelschnitts. Kurve wählen, dann Berührpunkt.","help.sketch.construction_line.tangent_external":"Kreis oder Kreisbogen wählen, dann einen äußeren Punkt und eine Tangentenlösung. Die Vorschau zeigt nur Berührpunkte auf dem gezeichneten Bogen.","help.sketch.construction_line.tangent_two":"Zwei Kreise oder Kreisbögen wählen, dann eine gemeinsame Tangente in der Vorschau. Die Berührpunkte müssen auf den gezeichneten Kurven liegen.","help.sketch.construction_line.vertical":"Erstellt eine unendliche vertikale Konstruktionslinie durch einen Punkt. Die Vertikalbedingung bleibt bei späteren Änderungen erhalten.","help.sketch.copy":"Kopiert die gewählten Skizzenkurven und -punkte samt den Bedingungen und Maßen zwischen ihnen. Fügen Sie sie in diese oder eine andere Skizze ein.","help.sketch.create":"Beginnt eine neue 2D-Skizze auf einer Ebene oder einer ebenen Fläche des Modells. Jede Extrusion, Drehung und Austragung beginnt mit einer Skizze.","help.sketch.cut":"Kopiert die gewählte Skizzengeometrie und löscht sie aus der Skizze, in einem Rückgängig-Schritt. Fügen Sie sie an anderer Stelle oder in eine andere Skizze ein.","help.sketch.dimension":"Fügt ein steuerndes Maß hinzu: Länge, Abstand, Winkel, Radius oder Durchmesser, je nachdem, was Sie wählen. Geben Sie einen Wert oder Parameternamen ein, und die Skizze folgt ihm.","help.sketch.edit":"Öffnet eine vorhandene Skizze zum Bearbeiten. Die darauf aufbauenden Elemente werden aktualisiert, wenn Sie die Skizze fertigstellen.","help.sketch.ellipse":"Zeichnet eine Ellipse aus Mittelpunkt, dem Ende der Hauptachse und einem Punkt auf der Nebenseite. Für ovale Öffnungen, Nocken und andere längliche Rundformen.","help.sketch.equation_curve":"Zeichnet eine Kurve aus Formeln über einen Bereich: x(t) und y(t) oder y = f(x). Die Formeln können Parameter verwenden, und die Kurve folgt ihnen: für eine Sinuswelle, eine Spirale oder die Evolvente eines Zahnrads.","help.sketch.extend":"Verlängert eine Linie oder einen Bogen bis zur nächsten Kurve im Weg oder zwei Kurven, bis sie sich treffen. Damit schließen Sie Lücken in einem Profil nach dem Kürzen oder Ändern.","help.sketch.fillet":"Rundet die Ecke zwischen zwei Linien oder Bögen mit einem Bogen vorgegebenen Radius ab. Mehrere zusammen gerundete Ecken teilen sich einen Radius.","help.sketch.finish":"Verlässt die Skizze und kehrt zum Modell zurück. Ihre geschlossenen Profile stehen dann für Extrusion, Drehung und weitere Elemente bereit.","help.sketch.finish_auto_constrain":"Wendet Auto-Bedingung auf die Skizze an und stellt sie dann fertig. Damit verlassen Sie eine Skizze in einem Schritt vollständig bestimmt.","help.sketch.fit_curves_to_section":"Schneidet einen Netz- oder Volumenkörper mit der Skizzenebene und passt Linien und Bögen an den Querschnitt an. Damit bauen Sie ein gescanntes oder importiertes Teil als bearbeitbare Skizze nach.","help.sketch.include_3d":"Holt Modellkanten, Eckpunkte und Kurven anderer Skizzen als verknüpfte Bezüge in diese Skizze und legt Teile außerhalb der Ebene flach auf sie. Damit bauen Sie auf Geometrie auf, die nicht in der Skizzenebene liegt.","help.sketch.infinite":"Schaltet Linien zwischen normalen Linien und unendlichen Konstruktionslinien um, die über die ganze Ansicht laufen. Als Bezugslinien für die Aufteilung, die nie zu kurz enden.","help.sketch.insert_dxf":"Liest die Kurven einer DXF-Zeichnung in eine Skizze ein, skaliert, gedreht und an der gewünschten Stelle. Damit bauen Sie auf einer 2D-Zeichnung aus einem anderen Programm auf, etwa einer Laserschnitt-Kontur.","help.sketch.insert_svg":"Liest die Pfade einer SVG-Zeichnung in eine Skizze ein, skaliert, gedreht und an der gewünschten Stelle. Damit machen Sie aus einem Logo oder einer Vektorkontur Kurven, die sich extrudieren lassen.","help.sketch.inspect":"Öffnet einen Bericht zur offenen Skizze: wie viele Freiheitsgrade übrig sind und ob sie vollständig bestimmt ist. Damit sehen Sie, was sich noch bewegt, bevor Sie die Skizze abschließen.","help.sketch.intersect":"Fügt die Kurven oder Punkte hinzu, an denen Körper, Flächen, Kanten oder andere Skizzen die Skizzenebene schneiden. Sie bleiben verknüpft und folgen Änderungen am Modell.","help.sketch.intersection_curve":"Erzeugt 3D-Kurven, wo sich zwei Körper oder Flächen treffen, mit diesen verknüpft. Als Pfade oder Leitkurven, die dem Modell folgen.","help.sketch.isoparametric_curve":"Erzeugt eine 3D-Kurve in U- oder V-Richtung einer Fläche durch einen gewählten Punkt, mit der Fläche verknüpft. Als Pfad oder Trennlinie, die der Fläche folgt.","help.sketch.line":"Zeichnet verbundene Linien Punkt für Punkt, als offene Kette oder geschlossene Kontur. Das Grundwerkzeug für die meisten Profile.","help.sketch.line.midpoint":"Zeichnet eine Linie von ihrem Mittelpunkt zu einem Ende, das andere Ende gespiegelt. Für Linien, die auf einem Punkt mittig liegen, etwa eine symmetrische Kante.","help.sketch.line3d":"Zeichnet bei eingeschalteter 3D-Skizze verbundene gerade Linien zwischen Punkten im Raum. Für Pfade und Rahmen, die die Skizzenebene verlassen.","help.sketch.mirror":"Spiegelt Skizzenkurven und -punkte an einer Linie oder Achse und fügt Symmetriebedingungen hinzu. Damit zeichnen Sie ein symmetrisches Profil zur Hälfte und ergänzen es.","help.sketch.move":"Verschiebt oder dreht Skizzenkurven und -punkte oder eine Kopie davon. Damit setzen Sie Geometrie um, ohne Form und Bedingungen zu verlieren.","help.sketch.offset":"Erzeugt eine Kopie einer Kurvenkette in festem Abstand, auf einer oder beiden Seiten. Für Wände, Konturen und Spiele; der Abstand bleibt ein änderbares Maß.","help.sketch.paste":"Fügt kopierte oder ausgeschnittene Skizzengeometrie in die aktive Skizze ein. Setzen Sie sie an einen Punkt oder verschieben Sie sie um einen Versatz.","help.sketch.pattern.circular":"Kopiert Skizzengeometrie um einen Mittelpunkt, über einen vollen Kreis oder einen festen Winkel. Für Lochkreise, Speichen und Zähne.","help.sketch.pattern.rectangular":"Kopiert Skizzengeometrie in Reihen und Spalten mit festen Abständen. Für Raster aus Bohrungen, Schlitzen oder Lüftungsöffnungen.","help.sketch.point":"Setzt einen Skizzenpunkt. Als Bezug für Maße, Bedingungen, Bohrungsmitten oder spätere Elemente.","help.sketch.point3d":"Setzt bei eingeschalteter 3D-Skizze einen Punkt im Raum. Als Bezug für 3D-Kurven und Pfade.","help.sketch.polygon.circumscribed":"Zeichnet ein regelmäßiges Polygon um einen Kreis, bemessen vom Mittelpunkt zur Mitte einer Seite. Wenn die Schlüsselweite bekannt ist, etwa bei einer Sechskantmutter.","help.sketch.polygon.edge":"Zeichnet ein regelmäßiges Polygon aus den beiden Enden einer Seite. Wenn Länge und Lage einer Seite bekannt sind.","help.sketch.polygon.inscribed":"Zeichnet ein regelmäßiges Polygon in einen Kreis, bemessen vom Mittelpunkt zu einer Ecke. Wenn das Eckmaß bekannt ist.","help.sketch.project":"Projiziert Modellkanten, Flächen, Eckpunkte und Kurven anderer Skizzen auf die Ebene dieser Skizze. Sie bleiben verknüpft und folgen Änderungen am Modell.","help.sketch.project_to_surface":"Projiziert Kurven anderer Skizzen entlang der Normalen dieser Skizze auf eine Fläche, als verknüpfte 3D-Kurven. Damit bringen Sie ein Logo, eine Trennlinie oder einen Pfad auf eine gekrümmte Fläche.","help.sketch.rectangle.center":"Zeichnet ein Rechteck aus Mittelpunkt und einer Ecke. Für Konturen, die mittig auf einem Punkt liegen, etwa dem Ursprung.","help.sketch.rectangle.rounded":"Zeichnet ein Rechteck, dessen vier Ecken mit einem Radius gerundet sind. Für Platten, Deckel und Öffnungen mit runden Ecken.","help.sketch.rectangle.three_point":"Zeichnet ein Rechteck aus einer Kante und einem Punkt auf der gegenüberliegenden Seite. Für Rechtecke, die schräg zu den Skizzenachsen liegen.","help.sketch.rectangle.two_point":"Zeichnet ein Rechteck aus zwei gegenüberliegenden Ecken. Für die Konturen von Platten, Blöcken und Taschen.","help.sketch.scale":"Skaliert Skizzenkurven und -punkte mit einem Faktor um einen Basispunkt. Damit ändern Sie die Größe eines Skizzenteils, ohne ihn neu zu zeichnen.","help.sketch.slot.arc_center":"Zeichnet einen gebogenen Schlitz vorgegebener Breite entlang eines Bogens aus Mittelpunkt, Start und Ende. Für Verstellschlitze um einen Drehpunkt.","help.sketch.slot.arc_three_point":"Zeichnet einen gebogenen Schlitz vorgegebener Breite entlang eines Bogens durch drei Punkte. Wenn der Verlauf des Schlitzes durch vorgegebene Punkte gehen soll.","help.sketch.slot.center_point":"Zeichnet einen geraden Schlitz vorgegebener Breite von seiner Mitte zum Mittelpunkt eines Endbogens. Für Schlitze, die mittig auf einem Punkt liegen.","help.sketch.slot.center_to_center":"Zeichnet einen geraden Schlitz vorgegebener Breite zwischen den Mittelpunkten seiner beiden Endbögen. Für Schlitze, die von Mitte zu Mitte bemaßt sind, etwa Langlöcher für Schrauben.","help.sketch.slot.overall":"Zeichnet einen geraden Schlitz vorgegebener Breite von einem äußeren Ende zum anderen. Wenn es auf die Gesamtlänge des Schlitzes ankommt.","help.sketch.spline.control_point":"Zeichnet einen kubischen Spline, den Kontrollpunkte formen, ohne dass er durch sie läuft. Für glatte, fließende Kurven, die Sie durch Verschieben der Punkte formen.","help.sketch.spline.control_point_5":"Zeichnet einen Spline vom Grad 5, den Kontrollpunkte formen. Wo Kurven mit glatterer Krümmung anschließen müssen, etwa an gestalteten Sichtflächen.","help.sketch.spline.fit_point":"Zeichnet einen glatten Spline durch alle gesetzten Punkte, offen oder geschlossen. Damit zeichnen Sie eine Form durch bekannte Punkte nach.","help.sketch.spline3d":"Zeichnet bei eingeschalteter 3D-Skizze eine glatte Kurve durch Punkte im Raum. Für Austragungspfade und Kabelwege, die die Skizzenebene verlassen.","help.sketch.spun_profile":"Erzeugt in der Skizzenebene die Kontur, die ein Körper bei einer Drehung um eine Achse überstreicht. Damit erhalten Sie den Umriss eines Drehteils für eine Drehung oder eine Zeichnung.","help.sketch.text":"Schreibt Text in die Skizze, mit Schriftart, Höhe und Winkel; der Wortlaut kann Parametern folgen. Extrudieren oder prägen Sie ihn für Beschriftungen und Schriftzüge.","help.sketch.transform":"Skaliert, dreht und verschiebt Skizzengeometrie um einen Mittelpunkt in einem Schritt. Damit setzen Sie eine Auswahl gleichzeitig um und ändern ihre Größe.","help.sketch.trim":"Entfernt das Stück einer Kurve zwischen den nächsten Schnittpunkten um die angeklickte Stelle. Damit räumen Sie sich überlappende Linien zu einem geschlossenen Profil auf.","help.solid.align":"Verschiebt die ausgewählten Körper so, dass ein Punkt, eine Fläche oder eine Ebene eines Körpers mit einem entsprechenden Punkt, einer Fläche oder Ebene an anderer Stelle zusammenfällt. So können Sie Bauteile aneinander ausrichten, ohne Abstände messen zu müssen.","help.solid.boundary_fill":"Erzeugt Volumenkörper aus den Bereichen, die sich überlappende Werkzeugkörper einschließen, und füllt nur die gewählten Bereiche. Damit bauen Sie eine Form aus dem Raum, den mehrere Körper gemeinsam begrenzen.","help.solid.bounding_solid":"Erzeugt einen Quader, der die gewählten Körper umschließt, auf Wunsch mit Aufmaß. Damit sehen Sie die Gesamtgröße eines Teils oder erhalten das Rohteil, aus dem es gefertigt wird.","help.solid.box":"Erzeugt einen Quader aus Länge, Breite und Höhe, ab einem Eckpunkt oder um einen Punkt zentriert. Für einen schnellen Block, einen Platzhalter oder einen Körper, in den Sie Features schneiden.","help.solid.chamfer":"Schneidet die gewählten Kanten mit einer ebenen Fase im eingestellten Abstand ab. Damit brechen Sie scharfe Kanten oder erleichtern das Einführen eines Stifts oder einer Schraube.","help.solid.coil":"Erzeugt einen schraubenförmigen Körper, etwa eine Feder, aus Durchmesser, Windungen, Höhe oder Steigung und einem runden oder eckigen Querschnitt. Für Federn, Spulen und schraubenförmige Stege.","help.solid.combine":"Kombiniert Körper: vereinigt sie, zieht sie von einem Zielkörper ab oder behält nur das gemeinsame Volumen; die Werkzeugkörper können erhalten bleiben. Damit fügen Sie Teile zusammen, schneiden eine Form mit einer anderen aus oder finden, wo sich zwei Körper überschneiden.","help.solid.cone":"Erzeugt einen Kegel aus Grundkreis und Höhe, oder einen Kegelstumpf, wenn auch die Oberseite einen Radius hat. Für Verjüngungen, Trichter, Senkungen und Spitzen.","help.solid.cylinder":"Erzeugt einen Zylinder aus Radius oder Durchmesser und Höhe, auf einem Punkt entlang einer Achse stehend. Für Wellen, Stifte, Dome und runde Rohlinge.","help.solid.draft":"Schrägt die ausgewählten Flächen um den eingestellten Winkel gegenüber einer neutralen Ebene ab. Diese Funktion wird bei Guss- und Spritzgussteilen verwendet, damit sich die Bauteile leichter aus der Form lösen lassen.","help.solid.emboss":"Hebt Skizzenprofile wie Text oder ein Logo aus einer Fläche heraus oder senkt sie hinein. Für Beschriftungen, Etiketten und Markierungen auf ebenen oder runden Flächen.","help.solid.extrude":"Zieht ein Skizzenprofil über eine Strecke in die dritte Dimension und fügt dabei Material hinzu oder entfernt es. Damit machen Sie aus einer flachen Kontur einen Block, eine Erhebung oder eine Tasche.","help.solid.fillet":"Rundet die gewählten Kanten mit einem glatten Kreisübergang im eingestellten Radius ab. Damit entschärfen Sie scharfe Kanten für Festigkeit, Griffigkeit oder Optik.","help.solid.hole":"Bohrt an einem gewählten Punkt auf einer Fläche ein rundes Loch im eingestellten Durchmesser. Für Durchgangsbohrungen für Schrauben, Stifte und andere einfache runde Öffnungen.","help.solid.loft":"Erzeugt einen glatten Übergangskörper zwischen zwei oder mehr Skizzenprofilen oder von einem Profil zu einem Punkt. Für Übergänge, Trichter, Griffe und alle Formen, deren Querschnitt sich über die Länge ändert.","help.solid.mirror":"Erzeugt eine gespiegelte Kopie der gewählten Körper oder Features an einer Ebene und kann sie mit dem Original vereinigen. Für symmetrische Teile: Sie modellieren eine Hälfte und erhalten beide.","help.solid.move":"Verschiebt oder dreht die ausgewählten Körper oder deren Kopien um den eingestellten Abstand und Winkel. So können Sie einen Körper neu positionieren oder an anderer Stelle eine Kopie erstellen.","help.solid.offset_face":"Versetzt die ausgewählten Flächen um den eingestellten Abstand nach innen oder außen. Die angrenzenden Flächen werden entsprechend angepasst. So können Sie beispielsweise eine Wand verdicken, eine Tasche vertiefen oder einen Ansatz erhöhen, ohne die Skizze bearbeiten zu müssen.","help.solid.pattern.circular":"Wiederholt die gewählten Objekte um eine Achse, mit der eingestellten Anzahl und dem Gesamtwinkel. Für Lochkreise, Speichen, Kühlrippen und Zähne.","help.solid.pattern.path":"Kopiert Elemente oder Körper entlang eines Skizzenpfads, nach Anzahl und Abstand. Für Bohrungen entlang einer gebogenen Kante oder Teile entlang einer Schiene.","help.solid.pattern.rectangular":"Wiederholt die gewählten Objekte in einer oder zwei Richtungen mit der eingestellten Anzahl und dem Abstand. Für Reihen und Raster von Bohrungen, Rippen, Stiften oder Füßen.","help.solid.pipe":"Erzeugt ein rundes Rohr entlang eines Pfads aus Skizzenkurven, massiv oder hohl mit Wandstärke. Für Rohre, Drähte, Kabel und Geländer.","help.solid.press_pull":"Fügt Material hinzu oder trägt es ab, indem Sie eine Fläche ziehen. Durch Ziehen an einer Kante können Sie diese abrunden. So lassen sich schnelle Änderungen direkt am Modell vornehmen.","help.solid.remove":"Entfernt die ausgewählten Körper ab dieser Stelle der Timeline aus dem Design. In den vorherigen Schritten bleiben sie erhalten. So können Sie beispielsweise einen nicht mehr benötigten Hilfs- oder Schneidkörper entfernen.","help.solid.replace_face":"Verschiebt die ausgewählten ebenen Flächen auf eine Ebene oder eine parallele Fläche. Der Körper wird dabei entsprechend vergrößert oder verkleinert. So können Sie eine Fläche bündig zu einem anderen Bauteil oder einer Konstruktionsebene ausrichten.","help.solid.revolve":"Dreht ein Skizzenprofil um eine Achse und erzeugt so einen runden Körper. Für Wellen, Knöpfe, Schalen und alle Teile, die um eine Mittellinie rund sind.","help.solid.rib":"Fügt entlang einer offenen Skizzenkurve eine dünne Wand hinzu, die bis zu den nächsten Flächen des Körpers reicht. Damit versteifen Sie Wände und Ecken, etwa bei Spritzguss- oder Druckteilen.","help.solid.scale":"Skaliert die ausgewählten Körper mit einem festgelegten Faktor, gleichmäßig in alle Richtungen oder getrennt entlang der einzelnen Achsen. So können Sie beispielsweise importierte Geometrien anpassen oder Materialschwindung berücksichtigen.","help.solid.shell":"Höhlt einen Körper aus, lässt Wände in der eingestellten Dicke stehen und kann gewählte Flächen öffnen. Für Kästen, Deckel und andere dünnwandige Teile.","help.solid.sphere":"Erzeugt eine Kugel aus Radius oder Durchmesser um einen Mittelpunkt. Für Kugeln, Knäufe und abgerundete Enden.","help.solid.split_body":"Teilt einen Körper mithilfe einer Ebene, der Fläche eines anderen Körpers oder einer Skizzenlinie in mehrere getrennte Körper. So können Sie Bauteile erstellen, die einzeln gedruckt, bearbeitet oder eingefärbt werden können.","help.solid.split_face":"Teilt die ausgewählten Flächen entlang einer Ebene, der Fläche eines anderen Körpers oder von Skizzenkurven, ohne den Körper selbst zu teilen. So können Sie Teilbereiche einer Fläche mit einer eigenen Formschräge, Farbe oder einem Versatz versehen.","help.solid.sweep":"Führt ein Skizzenprofil entlang eines Pfads und erzeugt so einen Körper. Für Rohre, Schienen, Griffe und alle Teile mit gleichbleibendem Querschnitt entlang einer Kurve.","help.solid.thread":"Versieht eine zylindrische Fläche mit einem metrischen ISO-Gewinde, als kosmetisches Gewinde oder in den Körper geschnitten. Für Schrauben, Gewindebohrungen und gedruckte Schraubteile.","help.solid.torus":"Erzeugt einen Ring aus einem großen Radius um seine Achse und einem kleinen Radius für seinen runden Querschnitt. Für O-Ringe, Griffe und runde Wülste.","help.solid.web":"Fügt entlang jeder offenen Skizzenkurve eine dünne Wand hinzu, jede bis zu den nächsten Flächen des Körpers. Für ein Gitter aus Stützwänden in Gehäusen und Schalen.","help.surface.blend":"Erzeugt eine Fläche, die die Kanten zweier Körper überbrückt, tangential oder krümmungsstetig zu beiden. Damit verbinden Sie zwei Flächen glatt über eine Lücke.","help.surface.boundary":"Erzeugt eine Fläche, die eine Schleife aus zwei bis vier Skizzenkurven oder ein Kurvennetz füllt. Für Freiformflächen, die durch ihre Ränder bestimmt sind.","help.surface.extend":"Verlängert eine Fläche über ihre Kanten hinaus, um einen Abstand oder bis zu einer Ebene oder Fläche. Damit überlappen sich Flächen, bevor Sie sie trimmen oder vernähen.","help.surface.extrude":"Zieht Skizzenkurven oder Profile über eine Strecke zu einer Fläche, nur Wände ohne Deckel. Für dünne Wände und als Werkzeug zum Schneiden oder Teilen.","help.surface.fair":"Glättet das Innere von Freiformflächen, während ihre Kanten an Ort und Stelle bleiben. Damit gleichen Sie Beulen und wellige Spiegelungen in einer Fläche aus.","help.surface.loft":"Erzeugt eine Fläche, die der Reihe nach durch zwei oder mehr Querschnitte läuft, ohne Deckel. Für Schalen und Übergänge zwischen verschiedenen Formen.","help.surface.match":"Baut die Kante einer Fläche so neu auf, dass sie an die Kante eines anderen Körpers anschließt, mit passender Tangente oder Krümmung. Damit schließen Sie eine Naht zwischen zwei Flächen glatt.","help.surface.offset":"Erzeugt eine Kopie von Flächen in einem Abstand entlang ihrer Normalen, als neuen Flächenkörper. Für Häute, Spiele oder die Gegenseite einer Wand.","help.surface.patch":"Füllt einen Skizzenbereich oder eine geschlossene Kantenschleife mit einer Fläche, eben oder glatt gekrümmt. Damit schließen Sie Löcher in einem Flächenkörper.","help.surface.reverse_normal":"Dreht Flächen eines Flächenkörpers um, sodass ihre Außenseite in die andere Richtung zeigt. Vor dem Aufdicken oder Vernähen, wenn die Flächen nach innen zeigen.","help.surface.revolve":"Dreht Skizzenkurven oder Profile um eine Achse zu einer Fläche, ohne Deckel. Für runde Schalen wie Lampenschirme, Schüsseln und Düsen.","help.surface.ruled":"Erzeugt einen Streifen aus geraden Linien, der von einer Kantenkette ausgeht, entlang der Flächennormalen, tangential oder unter einem Winkel. Für Schrägwände, Ausläufe und Trennflächen.","help.surface.stitch":"Vernäht Flächenkörper entlang gemeinsamer Kanten, zu einem Volumenkörper, wenn sie sich schließen. Damit machen Sie aus mehreren Flächen einen Körper.","help.surface.sweep":"Führt Skizzenkurven oder Profile entlang eines Pfads zu einer Fläche, ohne Deckel. Für Rinnen, Leisten und andere dünne Formen, die einem Pfad folgen.","help.surface.thicken":"Gibt einem Flächenkörper eine Dicke und macht ihn so zum Volumenkörper. Damit machen Sie aus Flächen druck- oder fräsbare Teile.","help.surface.trim":"Schneidet eine Fläche mit einer Ebene, einer anderen Fläche oder Skizzenkurven und behält die gewählte Seite. Damit schneiden Sie Flächen vor dem Vernähen in Form.","help.surface.unstitch":"Löst Flächen eines Körpers als eigene Flächenkörper heraus; ein Volumenkörper zerfällt dabei in Flächen. Damit überarbeiten Sie einzelne Flächen eines Körpers.","help.surface.untrim":"Entfernt Löcher aus einer Fläche oder stellt ihren äußeren Rand auf die natürlichen Grenzen der Fläche zurück. Damit holen Sie nach einem Trimmen die volle Fläche zurück.","help.third_party":"Drittanbieterlizenzen","help.timeline.compute_all":"Berechnet alle Features der Timeline von Anfang an neu. Dadurch wird das Modell aktualisiert und Sie sehen, bei welchen Features Berechnungsfehler auftreten.","help.timeline.delete":"Löscht die ausgewählten Features aus der Timeline. Beim Löschen einer Skizze werden auch alle daraus erstellten Features gelöscht. So können Sie nicht mehr benötigte Konstruktionsschritte entfernen.","help.timeline.dependents":"Listet die Elemente, die mit einem Element gelöscht würden, und die, die ohne es fehlschlagen würden. Bevor Sie ein Element löschen oder ändern.","help.timeline.play":"Die verbleibenden Features nacheinander abspielen, mit einer halben Sekunde Pause nach jedem Neuaufbau. Diesen Befehl erneut ausführen oder Escape drücken, um anzuhalten; Zum Ende springt sofort ans Ende.","help.view.apply":"Dreht die Ansicht in eine Standardrichtung wie vorne, oben oder iso oder zu einer gespeicherten Ansicht. Damit betrachten Sie das Modell aus einem festen Winkel.","help.view.delete":"Löscht eine gespeicherte Ansicht. Das Modell bleibt unverändert.","help.view.fit":"Zoomt und verschiebt so, dass das ganze Modell oder die Auswahl die Ansicht füllt. Wenn das Modell aus dem Blick geraten ist.","help.view.grid":"Blendet das Raster im Ansichtsfenster ein oder aus. Als Größen- und Orientierungshilfe beim Modellieren.","help.view.ground_shadow":"Blendet den Schatten des Modells auf dem Boden ein oder aus. Damit schätzen Sie Höhe und Lage leichter ein.","help.view.home":"Dreht die Ansicht zurück in die Ausgangsrichtung und zeigt das ganze Modell. Damit kommen Sie schnell zu einer bekannten Ansicht zurück.","help.view.list":"Listet die im Design gespeicherten Ansichten auf. Damit finden Sie eine früher gespeicherte Ansicht.","help.view.navigate":"Dreht, verschiebt oder zoomt die Ansicht schrittweise, etwa eine Vierteldrehung nach links. Damit bewegen Sie die Kamera genau statt durch Ziehen.","help.view.navigation_bar":"Blendet die Navigationsleiste unten im Ansichtsfenster ein oder aus. Ausblenden für mehr Platz, einblenden, um die Ansichtswerkzeuge per Maus zu erreichen.","help.view.rename":"Gibt einer gespeicherten Ansicht einen neuen Namen. Die Ansicht selbst bleibt gleich.","help.view.save":"Speichert die aktuelle Kameraposition als benannte Ansicht im Design. Damit kehren Sie später zum selben Blickwinkel zurück, etwa für Screenshots.","help.view.spin":"Dreht die Ansicht fortlaufend um das Modell, bis zum nächsten Klick oder Tastendruck. Damit präsentieren Sie ein Modell von allen Seiten.","help.view.tool":"Schaltet ein Kamerawerkzeug fest, Drehen, Verschieben oder Zoomen, sodass Ziehen mit der linken Maustaste die Ansicht bewegt, bis Sie es abschalten. Für Touchpads oder Mäuse ohne mittlere Taste.","help.view.visual_style":"Schaltet um, wie das Modell gezeichnet wird: schattiert mit oder ohne Kanten, Drahtmodell oder mit verdeckten Kanten. Drahtmodell zum Hineinschauen, schattiert für ein sauberes Bild.","history.sketch_under_constrained":"Unterbestimmt ({count} Freiheitsgrade)","history.sketch_under_constrained_one":"Unterbestimmt ({count} Freiheitsgrad)","hole_presets.confirm_delete":"Löschen bestätigen","hole_presets.delete":"Löschen","hole_presets.delete_prompt":"Möchten Sie diese persönliche Vorlage wirklich löschen? Bereits vorhandene Bohrungen bleiben unverändert.","hole_presets.full":"Die persönliche Vorlagenbibliothek enthält bereits 64 Vorlagen.","hole_presets.invalid_name":"Geben Sie einen kurzen Namen ohne Zeilenumbrüche oder Steuerzeichen ein.","hole_presets.invalid_parameters":"Vervollständigen Sie die Bohrungsparameter mit gültigen Ausdrücken angemessener Länge.","hole_presets.missing":"Die ausgewählte Vorlage ist nicht mehr verfügbar.","hole_presets.name":"Vorlagenname","hole_presets.name_exists":"Eine Vorlage mit diesem Namen existiert bereits. Wählen Sie einen anderen Namen.","hole_presets.name_hint":"Eindeutigen Namen eingeben","hole_presets.overwrite":"Änderungen in der ausgewählten Vorlage speichern","hole_presets.preset":"Vorlage","hole_presets.recall":"Vorlage laden","hole_presets.rename":"Umbenennen","hole_presets.save":"Als neue Vorlage speichern","hole_presets.scope":"In Ihrem Profil gespeichert und für alle Projekte verfügbar.","hole_presets.select":"Vorlage auswählen","hole_presets.title":"Persönliche Vorlagen","hole_presets.unsupported_options":"Diese Vorlage enthält Gewindeoptionen, die in dieser Version nicht geladen werden können.","hole_presets.unsupported_overwrite":"Diese Vorlage enthält Optionen, die nicht sicher überschrieben werden können.","home.back":"Zurück zu {name}","home.crashes":"Absturzberichte","home.design_workspace":"Entwurf","home.documentation":"Dokumentation","home.export":"Exportieren","home.export_hint":"Wählen Sie ein Format für den aktuellen Entwurf.","home.export_json_hint":"Bearbeitbarer Entwurf und Befehlsverlauf","home.export_mesh_hint":"Netz zum Drucken oder Teilen","home.export_step_hint":"Präzise Volumengeometrie","home.import":"Importieren…","home.import_hint":"STEP, IGES oder Netz in einen neuen Entwurf","home.in_this_browser":"in diesem Browser","home.missing":"fehlt","home.month_01":"Jan.","home.month_02":"Feb.","home.month_03":"März","home.month_04":"Apr.","home.month_05":"Mai","home.month_06":"Juni","home.month_07":"Juli","home.month_08":"Aug.","home.month_09":"Sept.","home.month_10":"Okt.","home.month_11":"Nov.","home.month_12":"Dez.","home.new_inches":"Neuer Entwurf in Zoll","home.new_inches_hint":"Zoll · öffnet sich im Arbeitsbereich Entwurf","home.new_mm":"Neuer Entwurf","home.new_mm_hint":"Millimeter · öffnet sich im Arbeitsbereich Entwurf","home.open":"Öffnen…","home.open_hint":"Ein .sc-Entwurf ({shortcut})","home.open_now":"Jetzt öffnen","home.opened_days_ago":"Vor {count} Tagen","home.opened_hours_ago":"Vor {count} Std.","home.opened_just_now":"Gerade eben","home.opened_minutes_ago":"Vor {count} Min.","home.opening":"wird geöffnet…","home.properties":"Entwurfseigenschaften","home.recent":"Zuletzt verwendet","home.recent_empty":"Entwürfe, die Sie öffnen oder speichern, erscheinen hier.","home.recovery_count":"Wiederherstellbare Entwürfe: {count}","home.recovery_empty":"Keine wiederherstellbaren Entwürfe.","home.recovery_hint":"SolidCraft wurde geschlossen, bevor diese Entwürfe gespeichert wurden.","home.report_issue":"Problem melden","home.samples":"Beispiele","home.settings":"Einstellungen","home.short_date":"{day}. {month}","home.shortcuts":"Tastenkombinationen","home.start_hint":"Erstellen Sie einen Entwurf, öffnen Sie eine zuletzt verwendete Datei oder erkunden Sie ein Beispiel.","home.whats_new":"Neuigkeiten","home.yesterday":"Gestern","install.button_tip":"SolidCraft als App installieren: eigenes Fenster, funktioniert auch offline","install.dock_1":"Wählen Sie Ablage › Zum Dock hinzufügen.","install.dock_2":"Klicken Sie auf „Hinzufügen“.","install.dock_after":"SolidCraft öffnet sich dann aus dem Dock in einem eigenen Fenster und funktioniert auch offline.","install.done":"Fertig","install.home_screen_1":"Tippen Sie auf „Teilen“ (im Menü …, falls es nicht in der Symbolleiste ist).","install.home_screen_2":"Wählen Sie „Zum Home-Bildschirm“.","install.home_screen_3":"Tippen Sie auf „Hinzufügen“.","install.home_screen_after":"SolidCraft öffnet sich dann über sein Symbol auf dem Home-Bildschirm, ohne die Leisten von Safari, und funktioniert auch offline.","install.menu":"App installieren…","install.steps_intro":"Safari installiert Web-Apps über seine eigenen Menüs:","install.title":"SolidCraft installieren","issue.body_label":"Berichtstext","issue.note_changed_while_waiting":"Einstellungen oder Modell haben sich geändert, während auf die Vorschau gewartet wurde. Nehmen Sie den Screenshot neu auf, um die technischen Details für die aktuelle Ansicht zu aktualisieren.","issue.note_details_kept":"Screenshot lokal aufgenommen. Ihre bearbeiteten technischen Details wurden beibehalten: Prüfen Sie, ob sie noch zur aktuellen Ansicht passen.","issue.note_details_updated":"Technische Details an die aktuelle Ansicht angepasst. Screenshot lokal aufgenommen. Prüfen Sie ihn, bevor Sie ihn auf GitHub anhängen.","issue.note_image_copied":"Fügen Sie das Bild in den GitHub-Entwurf ein oder speichern Sie das PNG, falls das Kopieren von Bildern nicht verfügbar ist.","issue.note_opened":"Prüfen Sie den GitHub-Entwurf und hängen Sie den Screenshot an. Die Schaltfläche Submit new issue von GitHub veröffentlicht ihn.","issue.note_opened_copied":"Bericht kopiert. Fügen Sie ihn in den GitHub-Entwurf ein, hängen Sie den Screenshot an und klicken Sie auf GitHub auf Submit new issue.","issue.note_removed":"Screenshot aus diesem Entwurf entfernt.","issue.note_report_copied":"Bericht kopiert. Fügen Sie ihn bei Bedarf in den GitHub-Entwurf ein.","issue.note_save_failed":"Screenshot konnte nicht gespeichert werden: {error}","issue.note_saved":"Screenshot gespeichert. Hängen Sie das PNG im GitHub-Entwurf an.","issue.save_screenshot":"Screenshot speichern…","joint.from_bodies_hint":"Jeder ausgewählte Körper kommt in eine eigene neue Komponente und bleibt, wo er ist.","joint.one_body":"Beide Auswahlen liegen auf {body}. Wählen Sie die zweite auf einem anderen Teil.","joint.one_component":"Diese Teile sind Körper einer Komponente: {bodies}. Ein Gelenk bewegt eine Komponente gegenüber einer anderen, daher braucht jedes Teil eine eigene Komponente.","joint.rigid_group_one_component":"Diese {count} Körper liegen alle in einer Komponente (oder direkt im Design): Verwenden Sie zuerst {command}.","joint.rigid_group_select_components":"Wählen Sie zwei oder mehr Komponenten aus.","joint_move.blocked_hint":"Prüfen Sie den Gelenktyp (z. B. „Starr“), die Fixierung, die Gelenkgrenzen und die durch Parameter gesteuerten Werte.","joint_move.blocked_title":"Dieses Bauteil kann nicht bewegt werden","joint_move.coarse":"Drehschritt nahe der Achse (°)","joint_move.distance":"Abstand vom Ausgangspunkt","joint_move.done":"Fertig","joint_move.fine":"Drehschritt weit von der Achse entfernt (°)","joint_move.fixed":"Dieses Bauteil verfügt über keine bewegliche Gelenkachse.","joint_move.help":"Verschieben: Ziehen Sie einen Pfeil oder Ring. Mit Esc brechen Sie den aktuellen Ziehvorgang ab.","joint_move.legacy_hint":"Deaktivieren, um wieder den bisherigen Verschiebebereich zu verwenden.","joint_move.precision":"Ziehen Sie außerhalb der gestrichelten Führung, um die Drehung fein einzustellen.","joint_move.rotation":"Drehwinkel vom Ausgangspunkt","joint_move.select":"Wählen Sie eine Fläche oder eine Baugruppenkomponente aus und anschließend „Verschieben“.","joint_move.settings":"Baugruppe verschieben","joint_move.step":"Schrittweite","joint_move.use_handles":"Gelenkgriffe zum Bewegen von Baugruppen verwenden","keymap.command_id":"Befehls-ID","keymap.empty":"Keine passenden Befehle","keymap.use_anyway":"{key} hier trotzdem verwenden","label.move_to_left_side":"Auf die linke Seite verschieben","label.move_to_right_side":"Auf die rechte Seite verschieben","manage.appearance_hint":"Wählen Sie ein Erscheinungsbild für die Auswahl oder ziehen Sie ein Farbmuster auf einen Körper oder eine Fläche.","manage.assign_hint":"Wählen Sie Körper und deren Kunststoff-Konstruktionsregel aus.","manage.config_hint":"Bearbeiten Sie Konfigurationszeilen, Spalten und Regeln und aktivieren Sie dann eine Zeile oder zeigen Sie deren Vorschau an.","manage.empty":"Keine passenden Zeilen.","manage.material_hint":"Wählen Sie Körper und deren physikalisches Material aus.","manage.parameters_hint":"Bearbeiten Sie Ausdrücke und Einheiten. Änderungen werden mit der Eingabetaste oder beim Verlassen eines Feldes übernommen.","manage.rules_hint":"Wählen Sie eine Regel zum Bearbeiten oder erstellen Sie eine neue. Bestätigen Sie, um die Regel zu speichern.","material.editor.add_property":"Eigenschaft hinzufügen","material.editor.add_source":"Quelle hinzufügen","material.editor.assigned_density":"Zugewiesene Dichte","material.editor.axes":"Materialachsen","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Kopie von {name}","material.editor.density_range":"Die zugewiesene Dichte muss größer als 0 und höchstens 1000 g/cm³ sein.","material.editor.designation":"Bezeichnung","material.editor.duplicate":"Duplizieren","material.editor.engineering_card":"Technisches Datenblatt","material.editor.family":"Werkstoffgruppe","material.editor.glass":"Glas","material.editor.illustrative":"Beispielwerte","material.editor.invalid_property":"Nicht unterstützter Eigenschaftstyp.","material.editor.isotropic":"Isotrop","material.editor.measurement":"Messung","material.editor.metal":"Metall","material.editor.moisture":"Feuchte, bezogen auf Trockenmasse","material.editor.name_required":"Geben Sie einen Namen mit 1–128 Zeichen ein.","material.editor.no_draft":"Kein Materialentwurf geöffnet.","material.editor.number_required":"Geben Sie einen gültigen Zahlenwert ein.","material.editor.orthotropic":"Orthotrop","material.editor.other":"Sonstiges","material.editor.polymer":"Polymer","material.editor.preserved_appearance":"Beibehaltenes Erscheinungsbild","material.editor.public_reference":"Öffentliche Quelle","material.editor.reference":"Referenz","material.editor.save_or_discard":"Speichern oder verwerfen Sie den Materialentwurf, bevor Sie ein Material zuweisen.","material.editor.saved":"Material gespeichert. Körperzuweisungen bleiben unverändert.","material.editor.scope":"Speichern legt dieses Material ab, ohne es Körpern zuzuweisen. Leere Eigenschaften und Bedingungen bleiben unbekannt. Die Dichte im Datenblatt ändert weder die zugewiesene Dichte noch die Masse.","material.editor.source_id":"Quellen-ID","material.editor.source_kind":"Quellentyp","material.editor.source_title":"Quellentitel","material.editor.sources":"Quellen","material.editor.stale":"Dieses Material wurde geändert, während der Entwurf geöffnet war. Verwerfen und öffnen Sie es erneut, bevor Sie speichern.","material.editor.state":"Materialzustand","material.editor.strain_rate":"Dehnrate","material.editor.symmetry":"Elastische Symmetrie","material.editor.temperature":"Temperatur","material.editor.unknown_card":"Die technischen Eigenschaften sind unbekannt. Beim Speichern bleiben eventuell nur die zugewiesene Dichte und das vorhandene Erscheinungsbild erhalten.","material.editor.user_supplied":"Vom Benutzer angegeben","material.editor.wood":"Holz","material.selection.choose":"Material auswählen","material.selection.mixed":"Unterschiedliche Materialien","measure.at":"Bei","measure.item":"Element {number}","measure.quick_copied":"Messwert kopiert","measure.quick_copy":"Klicken, um den Messwert zu kopieren","measure.quick_edges":"{count} Kanten","measure.quick_faces":"{count} Flächen","messages.ago_h":"vor {n} Std.","messages.ago_min":"vor {n} Min.","messages.ago_s":"vor {n} Sek.","messages.chip_hint":"Klicken für alle Meldungen dieser Sitzung","messages.clear":"Leeren","messages.copy_all":"Alle kopieren","messages.menu":"Meldungen…","messages.none":"Noch keine Meldungen.","messages.title":"Meldungen","motion.checked_to":"Nur bis Schritt {step} geprüft: der Prüfaufwand ist erschöpft","motion.collision":"{a} · {b}: Schritte {steps}","motion.delete_key":"Schlüsselbild löschen","motion.duration_hint":"Sekunden (leer: pro Schritt)","motion.key_here":"Schlüsselbild hier setzen","motion.key_here_hint":"Ein Schlüsselbild bei diesem Schritt mit dem aktuellen Gelenkwert hinzufügen","motion.no_collisions":"Keine Kollisionen in der Untersuchung","motion.plot_quantity":"Größe","motion.step_back":"Schritt zurück","motion.step_forward":"Schritt vor","motion.to_end":"Zum Ende","motion.to_start":"Zum Anfang","motion.track_name":"Spur {number}","nav.alias.help":"Umschalt+Alt+Linksziehen dreht, Umschalt+Alt+Mitte verschiebt, Umschalt+Alt+Rechtsziehen zoomt; mittleres Ziehen verschiebt ebenfalls und rechtes Ziehen dreht","nav.blender.help":"Mittlere Maustaste dreht, Umschalt+Mitte verschiebt, Strg+Mitte zoomt; rechtes Ziehen lässt die Kamera unverändert","nav.free_orbit.help":"Maus und 3D-Maus drehen über beide Pole hinweg und behalten die Rollneigung bei. Das Einrasten mit Umschalt ist deaktiviert.","nav.free_orbit.label":"Freie Drehung","nav.free_orbit.snap_help":"Maus und 3D-Maus drehen über beide Pole hinweg und behalten die Rollausrichtung bei. Halten Sie beim Ziehen zum Drehen die Umschalttaste gedrückt, um Blickrichtung und Rollausrichtung einrasten zu lassen.","nav.free_orbit_upright.help":"Seitliches Ziehen mit der Maus dreht das Modell um die senkrechte Achse der Welt; Ziehen nach oben und unten neigt es ohne Begrenzung über den Pol hinweg.","nav.free_orbit_upright.label":"Um die senkrechte Achse drehen","nav.fusion.help":"Mittlere Maustaste verschiebt, Umschalt+Mitte dreht, rechte Maustaste dreht","nav.hfss.help":"Alt+Linksziehen verschiebt, Umschalt+Alt+Linksziehen zoomt, Strg+Linksziehen auf leerer Fläche dreht","nav.inventor.help":"Mittlere Maustaste verschiebt, Umschalt+Mitte dreht, Strg+Mitte zoomt, rechte Maustaste dreht","nav.maya.help":"Alt+Linksziehen dreht, Alt+Mitte verschiebt, Alt+Rechtsziehen zoomt; mittleres Ziehen verschiebt ebenfalls","nav.openscad.help":"Linksziehen auf leerem Hintergrund dreht, Umschalt+Linksziehen zieht ein Auswahlrechteck auf, Skizzengeometrie wird durch Ziehen bearbeitet; rechtes oder mittleres Ziehen verschiebt, Umschalt+rechtes oder Umschalt+mittleres Ziehen zoomt","nav.perspective.sketch":"Beim Bearbeiten einer Skizze wird die orthografische Ansicht verwendet. Beenden Sie die Skizze, um die Perspektive umzuschalten.","nav.right_drag_orbits.help":"Aus: rechtes Ziehen lässt die Kamera unverändert, die rechte Maustaste öffnet nur das Kontextmenü. Die Mausbelegung SolidWorks schaltet es beim Auswählen aus.","nav.right_drag_orbits.label":"Rechtes Ziehen dreht","nav.solidworks.help":"Mittlere Maustaste dreht, Strg+Mitte verschiebt, Umschalt+Mitte zoomt, rechte Maustaste dreht","nav.tinkercad.help":"Rechte Maustaste dreht, mittlere oder Umschalt+rechte Maustaste verschiebt","nav.touchpad.help":"Umschalt gedrückt halten und den Zeiger zum Verschieben bewegen; mit Alt/Option drehen. Keine Maustaste nötig. Vertikales Scrollen zoomt.","nav.touchpad.label":"Touchpad","nav.touchpad.orbit":"Drehen (Alt/Option halten und bewegen; ohne Maustaste)","nav.touchpad.pan":"Verschieben (Umschalt halten und bewegen; ohne Maustaste)","nav.touchpad.scroll":"Touchpad verwendet vertikales Scrollen zum Zoomen. Die Zwei-Finger-Verschiebung bleibt für andere Vorgaben gespeichert.","nav.touchpad.zoom":"Zoom (vertikal scrollen oder Finger spreizen/zusammenziehen)","navbar.agent_chat":"Chat-Bereich des Assistenten","navbar.agent_cursor":"Agentencursor zeigen","navbar.ambient_occlusion":"Umgebungsverdeckung","navbar.assistant":"Assistent","navbar.custom.add_slot":"{slot} hinzufügen","navbar.custom.always":"Immer sichtbar","navbar.custom.available":"{available} · auf die Leiste ziehen oder auf Hinzufügen klicken","navbar.custom.buttons":"Schaltflächen","navbar.custom.compact":"Kompakt","navbar.custom.count":"{count} von 16 Feldern","navbar.custom.customise":"Navigationsleiste anpassen…","navbar.custom.design":"Entwurf","navbar.custom.duplicate":"Dieses Feld ist bereits in der Leiste.","navbar.custom.edge":"Rand","navbar.custom.edge_bottom":"Unten","navbar.custom.edge_top":"Oben","navbar.custom.fade":"Abblenden","navbar.custom.full":"Entfernen Sie ein Feld, um ein weiteres hinzuzufügen.","navbar.custom.hidden_design":"Im Entwurf ausgeblendet","navbar.custom.hidden_render":"Im Rendern ausgeblendet","navbar.custom.hide":"Navigationsleiste ausblenden","navbar.custom.hide_idle":"Ausblenden, bis die Maus darüber ist","navbar.custom.icon_only":"Nur Symbol","navbar.custom.icon_value":"Symbol und Wert","navbar.custom.icons":"Symbole","navbar.custom.idle":"Bei Inaktivität","navbar.custom.intro":"Wählen Sie die Bedienelemente der Leiste am unteren Rand der 3D-Ansicht und ihre Reihenfolge. Ziehen Sie ein Feld, um es zu verschieben, oder aus der Leiste heraus, um es zu entfernen.","navbar.custom.labels":"Symbole und Beschriftungen","navbar.custom.left":"Nach links","navbar.custom.position":"Position","navbar.custom.position_centre":"Mitte","navbar.custom.position_left":"Links","navbar.custom.position_right":"Rechts","navbar.custom.preview_as":"Vorschau als","navbar.custom.regular":"Normal","navbar.custom.remove":"Entfernen","navbar.custom.remove_bar":"Aus der Leiste entfernen","navbar.custom.render":"Rendern","navbar.custom.reset":"Navigationsleiste zurücksetzen","navbar.custom.reset_default":"Auf Standard zurücksetzen","navbar.custom.right":"Nach rechts","navbar.custom.select":"Kein Feld ausgewählt. Wählen Sie ein Feld in der Leiste, um es zu verschieben, zu entfernen oder sein Aussehen zu ändern.","navbar.custom.separators_full":"Die Leiste hat bereits vier Trennlinien.","navbar.custom.show":"Navigationsleiste anzeigen","navbar.custom.shows":"Zeigt","navbar.custom.size":"Größe","navbar.custom.stale":"Die Leiste hat sich geändert. Wählen Sie das Feld erneut aus.","navbar.custom.title":"Navigationsleiste","navbar.custom.unknown":"Dieses Feld ist nicht verfügbar.","navbar.description.ambient_occlusion":"Dunkelt Falten und Ecken ab und erzeugt Tiefe.","navbar.description.display":"Enthält die Ansichtseinstellungen: Grafikvoreinstellung, Raster, Bodenschatten, Umgebungsverdeckung und Projektion.","navbar.description.fit":"Zeigt die Auswahl formatfüllend, oder das ganze Modell, wenn nichts ausgewählt ist.","navbar.description.grid":"Zeigt oder verbirgt das Bodenraster.","navbar.description.ground_shadow":"Zeigt oder verbirgt den Schatten unter dem Modell.","navbar.description.home":"Kehrt zur isometrischen Ansicht des ganzen Modells zurück.","navbar.description.look_at":"Dreht die Ansicht zur gewählten Fläche, Ebene oder offenen Skizze.","navbar.description.orbit":"Dreht die Ansicht um das Modell.","navbar.description.pan":"Verschiebt die Ansicht seitwärts, nach oben oder unten.","navbar.description.projection":"Schaltet zwischen orthografischer und perspektivischer Ansicht um.","navbar.description.separator":"Eine dünne Linie, die benachbarte Felder gruppiert.","navbar.description.spin":"Dreht die Ansicht weiter, bis Sie klicken oder eine Taste drücken.","navbar.description.visual_style":"Schaltet um, wie das Modell gezeichnet wird: schattiert, Drahtmodell oder mit verdeckten Kanten.","navbar.description.zoom":"Bringt die Ansicht näher an das Modell heran oder weiter davon weg.","navbar.display":"Anzeige","navbar.fit":"Einpassen","navbar.graphics":"Grafik","navbar.grid":"Raster","navbar.ground_shadow":"Bodenschatten","navbar.home":"Start","navbar.later":"Später","navbar.look_at":"Ansehen","navbar.more":"Mehr","navbar.orbit":"Drehen","navbar.orthographic":"Orthografisch","navbar.pan":"Verschieben","navbar.perspective":"Perspektivisch","navbar.preset":"Voreinstellung","navbar.projection":"Projektion","navbar.projection_heading":"Projektion","navbar.separator":"Trennlinie","navbar.show":"Einblenden","navbar.spin":"Dauerdrehung","navbar.style.shaded":"Schattiert","navbar.style.shaded_with_edges":"Schattiert mit Kanten","navbar.style.shaded_with_hidden_edges":"Schattiert mit verdeckten Kanten","navbar.style.wireframe":"Drahtmodell","navbar.translucent":"Durchscheinend","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Darstellung","navbar.zoom":"Zoomen","needs two joints":"benötigt zwei Gelenke","network.allow_once":"Einmalig erlauben","network.always_allow":"Diesen Server immer erlauben","network.prompt_detail":"Dieses Design verweist auf eine Datei auf dem Netzwerkcomputer {host}. Beim Öffnen wird eine Verbindung zu diesem Computer hergestellt. Dabei werden möglicherweise Ihre Windows-Anmeldedaten an ihn übermittelt. Erlauben Sie den Zugriff nur auf Server, denen Sie vertrauen.","network.prompt_title":"Netzwerkzugriff","new configuration":"neue Konfiguration","new parameter":"new parameter","no hole":"keine Bohrung","no interference":"keine Überschneidung","no joint that moves yet":"noch kein Gelenk, das sich bewegt","no motion study yet":"noch keine Bewegungsuntersuchung","no picture":"kein Bild","no such joint":"kein solches Gelenk","none":"keine","not a move":"keine Verschiebung","not a number":"keine Zahl","open a sketch first":"zuerst eine Skizze öffnen","parameters.apply_live":"Jede Änderung beim Verlassen des Feldes übernehmen","parameters.apply_live_tip":"Aus: Änderungen warten auf Übernehmen oder OK, dann wird das Modell einmal für alle neu aufgebaut. Abbrechen oder Esc verwirft sie.","parameters.held":"{count} Änderungen warten auf Übernehmen","parameters.held_hint":"Bearbeiten Sie Ausdrücke und Einheiten. Änderungen warten auf Übernehmen oder OK.","parameters.held_one":"1 Änderung wartet auf Übernehmen","parts.automatic_name":"automatisch","parts.dimension.across_flats":"Schlüsselweite","parts.dimension.bore":"Bohrung","parts.dimension.d":"Nenndurchmesser","parts.dimension.head_diameter":"Kopfdurchmesser","parts.dimension.head_height":"Kopfhöhe","parts.dimension.height":"Höhe","parts.dimension.inner":"Innendurchmesser","parts.dimension.outer":"Außendurchmesser","parts.dimension.pitch":"Steigung","parts.dimension.socket":"Innensechskant","parts.dimension.socket_depth":"Sechskanttiefe","parts.dimension.thickness":"Dicke","parts.dimension.width":"Breite","parts.family.bearing":"Rillenkugellager (Hüllform)","parts.family.button_head_cap_screw":"Linsenkopfschraube mit Innensechskant","parts.family.dowel_pin":"Zylinderstift","parts.family.hex_bolt":"Sechskantschraube","parts.family.hex_nut":"Sechskantmutter","parts.family.set_screw":"Gewindestift mit Innensechskant und Kegelstumpf","parts.family.socket_head_cap_screw":"Zylinderschraube mit Innensechskant","parts.family.washer":"Unterlegscheibe","parts.holes":"Bohrungen (optional)","parts.placement_hint":"Wählen Sie eine oder mehrere Bohrungen, um in jede ein Teil einzusetzen, oder OK platziert es im Ursprung","pattern.alignment_2":"Ausrichtung 2","pattern.alignment_hint":"Die Anzahl enthält das Original. Die zentrierte Anordnung verteilt Kopien auf beide Seiten; bei gerader Anzahl legt die Richtungsumkehr die Seite mit der zusätzlichen Kopie fest.","pattern.direction_1":"Richtung 1","pattern.direction_2":"Richtung 2","pattern.flip_direction":"Richtung umkehren","perf.click_for_details":"Für Details klicken: Frametime-Diagramm, Histogramm und Darstellung der GPU-Ausgabe","perf.draw_calls":"Draw Calls","perf.line_segments":"Liniensegmente","perf.low_1":"1-%-Tiefstwert","perf.renderer":"Renderer","perf.scene_build":"Szenenaufbau","perf.triangles":"Dreiecke","perf.ui_time":"UI-Zeit","perf.viewport":"Ansichtsfenster","perf.worst":"schlechtester Wert","pick a body or some of its faces":"einen Körper oder einige seiner Flächen wählen","pick a hole to seat it, or OK places it at the origin":"Wählen Sie eine Bohrung zum Einsetzen, oder OK platziert es im Ursprung","pick a planar face":"eine ebene Fläche wählen","pick a plane or a face as the tool":"eine Ebene oder eine Fläche als Werkzeug wählen","pick a size":"eine Größe wählen","pick edges of a body":"Kanten eines Körpers wählen","pick edges of one body":"Kanten eines einzigen Körpers wählen","pick edges of the holes to remove":"die Kanten der zu entfernenden Bohrungen wählen","pick faces of one body":"Flächen eines einzigen Körpers wählen","pick faces to offset":"zu versetzende Flächen wählen","pick lines of one sketch":"Linien einer einzigen Skizze wählen","pick one or two vertices, edges or faces":"Wählen Sie ein oder zwei Ecken, Kanten oder Flächen","pick one plane or face as the tool, or sketch curves":"eine Ebene oder Fläche als Werkzeug wählen, oder Skizzenkurven","pick sections in two or more sketches":"Querschnitte in zwei oder mehr Skizzen wählen","pick sketch curves or edges":"Skizzenkurven oder Kanten wählen","pick the face to untrim":"die Fläche wählen, deren Trimmung aufgehoben werden soll","pick the path":"Pfad auswählen","pick what to keep":"wählen, was behalten werden soll","pick what to keep of the other surface":"wählen, was vom anderen Flächenkörper behalten werden soll","prefs.add_item":"Element hinzufügen","prefs.alt_frees_manipulators":"Alt / Option schaltet auch an Manipulatorpfeilen das Einrasten ab","prefs.anti_aliasing_amd_dx12":"Die Kantenglättung verwendet 1×, da der Starttest mit Multisampling keine Ausgabe erzeugt hat, während der Test mit 1× erfolgreich war. Sie können oben eine andere Einstellung wählen. Starten Sie SolidCraft neu, damit die Änderung übernommen wird, sofern der Test erfolgreich ist.","prefs.anti_aliasing_note":"Glättet gezackte Kanten.","prefs.applies_on_restart":"Wird nach einem Neustart übernommen","prefs.assistant":"Assistent","prefs.auto_operation":"Operation automatisch auswählen","prefs.auto_operation_note":"Die Feature-Dialoge wählen automatisch zwischen „Verbinden“, „Neuer Körper“ und „Ausschneiden“, abhängig davon, was das neue Material berührt. Sobald Sie selbst eine Operation auswählen, wird diese Einstellung nicht mehr angewendet. Deaktiviert: Die beim Öffnen des Dialogs voreingestellte Operation wird beibehalten.","prefs.axes":"Achsen","prefs.axis":"Achse","prefs.bodies_folders":"Körperordner","prefs.bodies_folders_always":"Immer","prefs.bodies_folders_never":"Nie","prefs.bodies_folders_several":"Nur bei mehreren Körpern","prefs.bottom":"Unten","prefs.bottom_centre":"Unten mittig","prefs.bottom_right":"Unten rechts","prefs.browser":"Browser","prefs.browser_eye_left":"Auge neben dem Aufklapppfeil","prefs.browser_eye_left_note":"Browserzeilen zeigen ihr Auge zum Ein- und Ausblenden wie bisher neben dem Aufklapppfeil statt in einer Spalte am rechten Zeilenende.","prefs.browser_reveal_on_hover":"Beim Überfahren einblenden","prefs.browser_show_note":"Angezeigt lässt den Browser auf dem Bildschirm. Beim Überfahren einblenden blendet ihn aus, bis der Zeiger über seinen Platz oder die schmale Lasche an seinem linken Rand kommt; er bleibt offen, solange der Zeiger darin ist oder ein Menü daraus offen ist.","prefs.browser_shown":"Angezeigt","prefs.built_in":"Integriert","prefs.button_left":"Ziehen mit der linken Maustaste","prefs.button_middle":"Ziehen mit der mittleren Maustaste","prefs.button_right":"Ziehen mit der rechten Maustaste","prefs.choose_font":"Schriftdatei auswählen…","prefs.click":"Klicken","prefs.contact_shading":"Weiche Kontaktschattierung","prefs.contact_shading_note":"Erzeugt weiche Schatten an Stellen, an denen sich Bauteile nahekommen.","prefs.context_menu":"Kontextmenü","prefs.context_menu_ring":"Kontextmenü · Gedrückt halten, um das Radialmenü zu öffnen","prefs.cpu":"CPU (Software)","prefs.crash_reports":"Absturzberichte öffnen…","prefs.crash_reports_note":"Die Berichte bleiben auf diesem Computer. Sie enthalten das Design und die Befehle, mit denen sich das Problem reproduzieren lässt.","prefs.ctrl_cmd":"Strg / Cmd","prefs.curved_surfaces":"Gekrümmte Flächen","prefs.curves":"Gekrümmte Flächen","prefs.dark_parts_shading":"Form dunkler Teile erhalten","prefs.dark_parts_shading_help":"Die Ansicht in linearem Licht mit sanftem Himmelslicht schattieren, damit dunkle Flächen einen Verlauf behalten statt schwarz zu werden","prefs.dead_zone_note":"Der schraffierte Bereich kennzeichnet die Totzone. Bewegungen innerhalb dieses Bereichs werden ignoriert.","prefs.default":"Standard","prefs.design":"Design-Vorgaben","prefs.design_note":"Legt fest, mit welchen Einstellungen neue Designs beginnen. Bereits geöffnete Designs behalten ihre eigenen Einstellungen.","prefs.devices":"3D-Maus","prefs.dialog_buttons":"Dialogschaltflächen","prefs.dialogs":"Dialoge","prefs.dialogs_edge":"Am Rand der Ansicht","prefs.dialogs_left_column":"In der linken Spalte","prefs.dialogs_note":"Wo Befehlsdialoge öffnen: am Rand der Ansicht angedockt oder in der linken Spalte anstelle von Browser und Verlauf, die beim Schließen des Dialogs wie zuvor zurückkehren.","prefs.display":"Anzeige","prefs.edges":"Kanten und Schattierung","prefs.extend":"Erweitern","prefs.extra_navigation":"Mit Strg und gedrückter linker Maustaste auf einer freien Fläche drehen. Leertaste gedrückt halten, um die Ansicht zu verschieben.","prefs.extrude_view_isometric":"Beim Öffnen von Extrudieren isometrisch ausrichten","prefs.extrude_view_return":"Beim Schließen von Extrudieren zur vorigen Ansicht zurück","prefs.follows_os":"Wie im Betriebssystem","prefs.font":"Schrift","prefs.font_fallback":"Zeichen, die in der ausgewählten Schrift fehlen, werden mit der integrierten Ersatzschrift dargestellt. So werden keine Beschriftungen als leere Kästchen angezeigt.","prefs.font_sample":"Zwölf Boxkämpfer jagen Viktor quer über den großen Sylter Deich · Ø12,50 mm · 45,0° · 0123456789","prefs.font_unreadable":"Die ausgewählte Schriftdatei konnte nicht gelesen werden.","prefs.general":"Allgemein","prefs.general_note":"Sprache, Speichern und Updates.","prefs.gesture_orbit":"Ansicht drehen","prefs.gesture_pan":"Ansicht verschieben","prefs.gesture_zoom":"Ansicht zoomen","prefs.graphics":"Grafik","prefs.graphics_card":"Grafikkarte","prefs.graphics_card_auto":"Automatisch","prefs.graphics_card_missing":"Die gespeicherte Grafikkarte ist nicht verfügbar. Stattdessen wird „Automatisch“ verwendet.","prefs.graphics_card_restart":"Diese Einstellung wird nach einem Neustart von SolidCraft wirksam. Die Umgebungsvariable WGPU_ADAPTER_NAME hat Vorrang vor dieser Auswahl.","prefs.graphics_card_unused":"Die gespeicherte Grafikkarte wurde für dieses Fenster nicht verwendet; die tatsächlich genutzte Karte steht unter Hilfe › Info und in der Statuszeile. Versuchen Sie Automatisch, oder setzen Sie WGPU_ADAPTER_NAME auf einen eindeutigen Teil des Kartennamens.","prefs.graphics_note":"Wägen Sie Leistung und Darstellungsqualität gegeneinander ab. Jede Option veranschaulicht ihre Wirkung anhand eines Beispiels.","prefs.graphics_presets_note":"Mit den Profilen werden die unten aufgeführten Optionen gemeinsam eingestellt.","prefs.hide_constraint_glyphs_zoomed_out":"Bindungssymbole bei starkem Herauszoomen ausblenden","prefs.hide_constraint_glyphs_zoomed_out_note":"Bindungssymbole verschwinden, wenn die Skizze so weit herausgezoomt ist, dass sie sie überladen würden. Aus: sie behalten bei jedem Zoom eine feste Bildschirmgröße.","prefs.history":"Verlauf","prefs.history_origin_bodies":"Ursprung und Körper oben zeigen","prefs.history_origin_bodies_note":"Der Verlauf links oder unter dem Browser beginnt mit dem Körper-Ordner der aktiven Komponente und dem Ursprung, mit Augen und Menüs wie im Browser. Der Verlauf unten bleibt unverändert.","prefs.history_play_button":"Schaltfläche „Verlauf abspielen“ in den Verlaufssteuerelementen","prefs.history_play_button_note":"Fügt „Verlauf abspielen“ zwischen „Einen Schritt zurück“ und „Einen Schritt vor“ in die Verlaufssteuerelemente ein. Mit einem Rechtsklick auf die Steuerelemente lässt sich die Schaltfläche auch ein- oder ausblenden.","prefs.history_sketches":"Skizzen","prefs.history_sketches_in_order":"In Erstellungsreihenfolge","prefs.history_sketches_note":"Wenn „Skizzen“ auf „Unter dem zugehörigen Feature“ eingestellt ist, wird jede Skizze im linken Verlauf eine Ebene unter dem ersten daraus erstellten Feature angezeigt, sofern der Bereich breit genug für die Namen ist. Die Timeline unten zeigt weiterhin die Reihenfolge, in der die Elemente erstellt wurden.","prefs.history_sketches_under_feature":"Unter dem zugehörigen Feature","prefs.hold_stop_snapping":"Gedrückt halten, um das Einrasten zu deaktivieren","prefs.home_fit_size":"Größe bei Home und Einpassen","prefs.home_fit_size_note":"Wie viel der Ansicht das Modell füllt, wenn Home, Einpassen, ein geöffnetes Design oder ein Ansichtswechsel am Navigator es einrahmt, unabhängig von der Einstellung darunter. 100 %: füllt die Ansicht zwischen den Leisten, dem Kompass und der Navigationsleiste.","prefs.icons_only":"Nur Symbole","prefs.imported_file":"Importierte Datei","prefs.in_browser":"Im Browser","prefs.input":"Eingabe","prefs.interface":"Oberfläche","prefs.interface_language":"Oberflächensprache","prefs.interface_note":"Legt das Erscheinungsbild von SolidCraft und die Anordnung seiner Bereiche fest.","prefs.interval_minutes":"{n} min","prefs.keep_work_on_tab_switch":"Dialoge und Werkzeuge beim Wechsel zwischen Konstruktionen offen lassen","prefs.keep_work_on_tab_switch_note":"Jeder Konstruktions-Tab behält seinen offenen Dialog oder sein Werkzeug mit allem, was darin ausgewählt und eingegeben wurde, sowie seinen Werkzeugleisten-Tab. Beim Zurückkehren zur Konstruktion ist alles wieder da. Aus: Ein Wechsel bricht sie ab und zeigt den Tab Modell.","prefs.labels":"Beschriftungen","prefs.language_system":"System","prefs.layout":"Layout","prefs.layout_note":"Im Layout „Kompakt“ werden Bereiche an den Fensterrändern angedockt. Transparenz für den Browser ist nur im Layout „Schwebend“ verfügbar. Die Position des Assistenten ändern Sie auf der Seite „Assistent“.","prefs.left":"Links","prefs.left_click":"Linksklick","prefs.line_drag_draws_one":"Drücken und Ziehen zeichnet eine Linie","prefs.line_drag_draws_one_note":"Im Linienwerkzeug zeichnet Drücken, Ziehen und Loslassen eine Linie vom Drückpunkt bis zum Loslassen, und dort endet sie. Klicks zeichnen weiterhin eine Kette. Aus: Ein Ziehen setzt wie ein Klick einen Punkt dort, wo losgelassen wird.","prefs.line_hover_tangent_arc":"Auf dem letzten Linienpunkt verweilen, um zum Tangentialbogen zu wechseln","prefs.line_hover_tangent_arc_note":"Im Linienwerkzeug: Nach einem Segment vom letzten Punkt der Kette wegbewegen, zurückkehren und den Zeiger still darauf halten. Der nächste Klick beendet dann einen Tangentialbogen, und dieselbe Geste wechselt zurück zu Linien. Aus: Das Verweilen bewirkt nichts.","prefs.linked_designs":"Verknüpfte Designs","prefs.live_input":"Live-Eingabe","prefs.live_preview":"Live-Vorschau","prefs.logo":"Logo","prefs.logo_accent":"Akzentfarbe","prefs.logo_theme":"Designfarben","prefs.max_file_size":"Maximale Dateigröße zum Öffnen","prefs.max_file_size_design":"Designdateien","prefs.max_file_size_flag":"Dieser Lauf wurde mit --max-file-size {size} gestartet. Der Wert gilt, bis SolidCraft geschlossen wird. Diese Einstellungen gelten beim Start ohne diese Option.","prefs.max_file_size_note":"Standard: 512 MB und 256 MB; höchstens 16 GB. Das Öffnen einer Datei benötigt ein Mehrfaches ihrer Größe im Arbeitsspeicher. Ein Design mit großem Import benötigt zum Speichern und erneuten Öffnen eventuell eine höhere Grenze für Designdateien.","prefs.max_file_size_step":"STEP- und Importdateien","prefs.max_file_size_web":"Die Web-App öffnet STEP- und Importdateien bis 512 MB und Designs bis 256 MB: Ein Browser-Tab kann keine größeren Dateien aufnehmen. In der Desktop-App lassen sich diese Grenzen erhöhen.","prefs.megabytes":"MB","prefs.menu_grid":"Große Symbole","prefs.menu_list":"Liste","prefs.menus":"Menüs","prefs.minutes":"Minuten","prefs.minutes_suffix":" min","prefs.mouse":"Maus und Trackpad","prefs.mouse_heading":"Maus","prefs.mouse_mapping":"Mausbelegung","prefs.navigation":"Navigation","prefs.navigation_note":"Legt fest, wie Maus, Trackpad und 3D-Maus die Ansicht steuern.","prefs.navigator_fit":"Modell nach einem Ansichtswechsel am Navigator einpassen","prefs.navigator_fit_note":"Eine Fläche, Ecke oder ein Pfeil des Würfels oder eine Achse des Gizmos blickt auch auf die Mitte des Modells, aus dem einen Abstand, der es von jeder Seite einpasst (seine Hüllkugel). Home nutzt denselben Zoom und dieselbe Mitte, solange dies an ist, sodass danach gewählte Ansichten sich nur drehen. Aus: Die Ansicht dreht sich an Ort und Stelle und behält Ziel und Zoom.","prefs.network_host_remove":"Entfernen","prefs.network_locations":"Netzwerkspeicherorte in Designs zulassen","prefs.network_locations_note":"Deaktiviert: Verknüpfte Dateien eines Designs auf einem anderen Computer (\\\\server\\share) werden nur von den hier aufgeführten Servern geöffnet oder nachdem Sie einen Server auf Nachfrage ausdrücklich zugelassen haben.","prefs.network_locations_section":"Netzwerkspeicherorte","prefs.not_on_gpu":"Auf dieser GPU nicht verfügbar","prefs.on":"An","prefs.opaque":"Undurchsichtig","prefs.orbit_snap":"Halten Sie beim Drehen die Umschalttaste gedrückt, um die Ansicht an einer Achse einrasten zu lassen.","prefs.orientation":"Ausrichtung","prefs.origin_plane_names":"Namen der Ursprungsebenen","prefs.origin_plane_names_note":"Namen in Browser, Dialogen und Listen. {top} ist XY, {front} ist XZ und {right} ist YZ, mit Z nach oben. Befehle, Skripte und gespeicherte Konstruktionen behalten XY, XZ und YZ.","prefs.overall_speed":"Gesamtgeschwindigkeit","prefs.parameter_list_rows":"Zeilen der Parameterliste","prefs.parameter_list_rows_tip":"Der Pfeil nach unten in einem leeren Wertefeld listet die Parameter auf, Favoriten zuerst, bis zu dieser Anzahl. Weniger hält die Liste in einem großen Design übersichtlich.","prefs.persistent_ribbon_pressed":"Aktive Menübandbefehle hervorheben","prefs.persistent_ribbon_pressed_help":"Hebt Befehle im Menüband hervor, solange ihre Effekte eingeschaltet sind. Deaktivieren Sie diese Option, um die bisherige neutrale Darstellung und Befehlshilfe beizubehalten.","prefs.perspective_fov":"Sichtfeld","prefs.placement":"Platzierung","prefs.prefer_free_sketch_points":"Bei überlappenden Punkten bewegliche Skizzenpunkte bevorzugen","prefs.preview_choices":"Vorschau Ihrer Einstellungen","prefs.print_face_highlight":"Hervorhebung der Auflagefläche","prefs.print_face_highlight_tip":"Wie stark die Auflagefläche eines Körpers in der Ansicht eingefärbt und umrandet wird. 0 % zeigt keine Hervorhebung.","prefs.profile_active":"Aktives Profil","prefs.profile_applied":"Profil angewendet.","prefs.profile_changed":"Die Einstellungen wurden seit dem Speichern des Profils geändert. „Speichern“ übernimmt sie ins Profil.","prefs.profile_deleted":"Profil gelöscht.","prefs.profile_export":"Exportieren…","prefs.profile_exported":"Profil exportiert.","prefs.profile_imported":"Profil importiert. Unter „Aktives Profil“ auswählen, um dazu zu wechseln.","prefs.profile_name_hint":"Profilname, z. B. Laptop","prefs.profile_rename":"Umbenennen","prefs.profile_renamed":"Profil umbenannt.","prefs.profile_save":"Speichern","prefs.profile_saved":"Aktuelle Einstellungen im Profil gespeichert.","prefs.profile_skipped":"Profil angewendet; {n} Einstellung(en) behielten ihren aktuellen Wert (siehe Protokoll).","prefs.profiles":"Einstellungsprofile","prefs.profiles_note":"Tastenkürzel, Werkzeugleiste, Navigation, Radialmenü und Oberflächeneinstellungen, gemeinsam unter einem Namen gespeichert und auf einmal umgeschaltet.","prefs.project_options_dialog":"Project-Optionendialog","prefs.project_options_dialog_note":"Ein: Vor dem Projizieren Geometrie oder Körper und die Projektionsverknüpfung auswählen. Aus: Den bisherigen Direktwahl-Ablauf beibehalten.","prefs.quality_default":"Standard","prefs.quality_fastest":"Am schnellsten","prefs.quality_slowest":"Am langsamsten","prefs.quality_smoother":"Stärker geglättet","prefs.quick_measure":"Schnellmessung in der Ecke der Ansicht","prefs.quick_measure_note":"Zeigt unten rechts in der Ansicht die Größe der Auswahl an: bei einer Kante die Länge, bei einer kreisförmigen Kante zusätzlich Durchmesser (Ø) und Radius (R), bei einer Fläche den Flächeninhalt, bei einem Punkt die Position, bei zwei Elementen Abstand und Winkel sowie bei mehreren Kanten oder Flächen die Gesamtlänge bzw. Gesamtfläche. Ein Klick kopiert den Messwert.","prefs.render_previous_geometry_budget":"Bisheriges Geometriebudget für die Render-Vorschau verwenden","prefs.render_previous_geometry_budget_help":"Stellt die bisherige feste Obergrenze für die Geometrie wieder her (512 MiB auf 64-Bit-Desktop-Systemen, andernfalls 128 MiB) anstelle des geräteabhängigen Budgets.","prefs.reports_saved":"{n} gespeichert","prefs.ribbon_click_ends_tool":"Klick auf die Schaltfläche des laufenden Werkzeugs beendet es","prefs.ribbon_click_ends_tool_note":"Ein Klick auf die hervorgehobene Schaltfläche des aktiven Skizzenwerkzeugs beendet das Werkzeug, sodass Klicks in die Ansicht wieder auswählen. Aus: Der Klick startet das Werkzeug neu.","prefs.ribbon_reveal":"Suchergebnisse im Menüband zeigen","prefs.ribbon_reveal_note":"Steht der Zeiger über einem Ergebnis in Befehle suchen, zeigt das Menüband, wo der Befehl liegt: seine Registerkarte, seine Schaltfläche oder seine Zeile im Aufklappmenü eines Panels. Ein aus der Suche gestarteter Befehl blinkt dort, und ein laufender Befehl aus einem Aufklappmenü markiert sein Panel.","prefs.right_click":"Rechtsklick","prefs.saving":"Automatisches Speichern und Wiederherstellung","prefs.scale_note":"Die Skalierung lässt sich auch mit Strg + / Strg − im Fenster ändern. Bei 100 % sind die Schaltflächen 28 px groß.","prefs.scale_text":"Skalierung und Text","prefs.search":"Einstellungen suchen","prefs.search_empty":"Keine passenden Einstellungen","prefs.select":"Auswählen","prefs.select_one_item":"Ein Element auswählen","prefs.select_other_hidden":"Verborgene Geometrie mit „Andere auswählen“ auswählen","prefs.select_other_hidden_help":"Ein: Verborgene Körper, Skizzen und verdeckte Kanten nahe dem Zeiger einbeziehen. Aus: Die ursprüngliche Liste sichtbarer Geometrie direkt unter dem Zeiger verwenden.","prefs.selecting":"Auswahl","prefs.shift":"Umschalt","prefs.shift_add_ctrl_toggle":"Umschalt fügt nur hinzu; Strg / Cmd schaltet die Auswahl um","prefs.shift_add_note":"Aktiviert: Umschalt fügt Elemente zur Auswahl hinzu, Strg / Cmd schaltet ihre Auswahl um. Deaktiviert (Standard): Beide Tasten schalten die Auswahl um.","prefs.shortcuts":"Tastenkürzel","prefs.single_surface_analysis":"Nur eine Flächenanalyse verwenden","prefs.single_surface_analysis_help":"Wenn deaktiviert, können Flächenschattierung und Stetigkeitsanalyse gleichzeitig aktiv bleiben. Beim Aktivieren bleibt die zuletzt gestartete oder geänderte Analyse erhalten.","prefs.sketch_align_points":"Beim Zeichnen an anderen Skizzenpunkten ausrichten","prefs.sketch_align_points_note":"Beim Zeichnen richtet sich ein Punkt zugleich waagerecht an einem Skizzenpunkt und senkrecht an einem anderen aus, mit einer gepunkteten Hilfslinie; der Klick behält beide Ausrichtungen. Aus: nur am vorherigen Punkt, jeweils eine Achse.","prefs.sketch_conflict_colour":"Widersprüchliche Geometrie in der Konfliktfarbe","prefs.sketch_conflict_colour_note":"Solange die Bedingungen einer Skizze im Konflikt stehen, werden auch die Kurven und Punkte, die eine nicht erfüllte Bedingung hält, in der Konfliktfarbe gezeichnet, nicht nur ihr Symbol oder ihre Bemaßung. Aus: Sie behalten ihre üblichen Farben.","prefs.sketch_construction_lines":"Erweiterte Konstruktionslinien-Werkzeuge","prefs.sketch_exit_view":"Ansicht nach dem Beenden einer Skizze","prefs.sketch_exit_view.keep":"Aktuelle Ansicht beibehalten","prefs.sketch_exit_view.previous":"Zur vorherigen Ansicht zurückkehren","prefs.sketch_exit_view.unless_rotated":"Zurückkehren, sofern nicht gedreht","prefs.sketch_exit_view_note":"Legt fest, zu welcher Ansicht nach „Skizze beenden“, „Abbrechen“ oder zweimaligem Drücken der Esc-Taste gewechselt wird.","prefs.sketch_open_look_at":"Beim Öffnen einer Skizze auf sie ausrichten","prefs.sketch_open_look_at_note":"Aus: Beim Erstellen oder Bearbeiten einer Skizze bleibt die Ansicht, wie sie ist. „Ansehen“ richtet die Ansicht bei Bedarf auf die Skizze aus.","prefs.sketch_recent_snap":"Automatisch an zuletzt verwendete Mittelpunkte fangen","prefs.sketch_recent_snap_note":"Fängt den Zeiger beim Zeichnen dort ein, wo sich die Hilfslinien der beiden zuletzt verwendeten Kreismittelpunkte oder Kantenmitten kreuzen. Aus: die Hilfslinien bleiben sichtbar und der Zeiger bewegt sich nicht.","prefs.sketch_selection":"Skizzen und Auswahl","prefs.sketch_selection_heading":"Skizzen und Auswahl","prefs.sketch_selection_note":"Legt fest, wie Skizzenelemente einrasten und wie Klicks Elemente auswählen.","prefs.sketch_state_icons":"Skizzensymbole in der Farbe ihres Zustands","prefs.sketch_state_icons_note":"Im Verlauf und im Browser nimmt das Symbol einer Skizze die Farbe ihres Zustands an (unterbestimmt, vollständig bestimmt oder im Konflikt), und ihr Tooltip nennt den Zustand. Aus: Alle Skizzen haben dasselbe Symbol.","prefs.sketch_tab_always":"Registerkarte Skizze immer zeigen","prefs.sketch_tab_always_note":"Die Registerkarte Skizze bleibt im Menüband direkt nach Modell, auch wenn keine Skizze offen ist. Ihre Zeichenwerkzeuge beginnen dann eine Skizze auf der ausgewählten Ebene oder Fläche oder auf der Ebene, die Sie als Nächstes wählen, und das Werkzeug ist darin bereit.","prefs.sketch_tracking_guides":"Ausrichtungshilfen für Mittelpunkte","prefs.sketch_tracking_guides_note":"Den Mauszeiger über einen Kreismittelpunkt oder eine Kantenmitte bewegen und dann waagerecht oder senkrecht bewegen, um eine temporäre gepunktete Hilfslinie anzuzeigen.","prefs.sketch_tracking_points":"Ausrichtungshilfen von Endpunkten und Ecken beim Zeichnen","prefs.sketch_tracking_points_note":"Während ein Zeichenwerkzeug auf einen Punkt wartet, zeigt das Überfahren eines Linien- oder Bogenendes, einer Rechteckecke oder eines freien Punkts dieselbe temporäre gepunktete Hilfslinie wie ein Mittelpunkt. Aus: nur Mittelpunkte.","prefs.sketching":"Skizzieren","prefs.snap_drawing_note":"Gilt beim Zeichnen oder Verschieben eines Skizzenpunkts.","prefs.source":"Quelle","prefs.speed":"Geschwindigkeit","prefs.stand_up_note":"Wenn eine STEP- oder IGES-Datei mit der Z-Achse nach oben geöffnet wird, wird eine Vierteldrehung um die X-Achse angeboten.","prefs.stand_up_unknown":"Für Dateien aus unbekannten Programmen","prefs.stand_up_unknown.ask":"In einem Dialog fragen","prefs.stand_up_unknown.note":"Einen Hinweis zeigen","prefs.stand_up_unknown.off":"Nicht anbieten","prefs.stand_up_unknown_note":"Wie das Aufrichten angeboten wird, wenn der Dateikopf kein Programm nennt, das bekanntlich mit Y nach oben speichert. Ein Hinweis erscheint nur, wenn die Datei auf dem Rücken zu liegen scheint; „In einem Dialog fragen“ fragt wie bisher bei jeder solchen Datei.","prefs.status_bar":"Statusleiste","prefs.status_bar_note":"Eine schmale Leiste am unteren Fensterrand zeigt, was gerade bearbeitet wird, den Zustand der offenen Skizze in seiner Farbe und die Einheiten der Konstruktion; ein Klick auf die Einheiten ändert sie. Der Zustand der Skizze steht dann nicht mehr in der Ecke der Ansicht.","prefs.status_done":"Fertig","prefs.status_error":"Fehler","prefs.status_selected":"Ausgewählt","prefs.status_warning":"Warnung","prefs.structure.appearance":"Erscheinungsbild","prefs.structure.appearance_note":"Farben, Text und Barrierefreiheit.","prefs.structure.in_profile":"Im Profil","prefs.structure.layout":"Layout","prefs.structure.layout_note":"Anordnung der Fensterbereiche.","prefs.structure.look":"Ansicht","prefs.structure.measure_pointer":"Messen und Zeiger","prefs.structure.mouse3d":"3D-Maus","prefs.structure.mouse3d_note":"SpaceMouse und SpaceNavigator.","prefs.structure.navigation_note":"Maus und Trackpad. Die 3D-Maus hat eine eigene Seite.","prefs.structure.profile":"Profil","prefs.structure.profile_edited":"Seit dem Speichern geändert","prefs.structure.profile_hover":"Wird in Einstellungsprofilen gespeichert","prefs.structure.scale_percent":"{percent} %","prefs.structure.sketch":"Skizze","prefs.structure.tools":"Werkzeuge","prefs.structure.tools_note":"Verhalten der Modellierungswerkzeuge.","prefs.structure.work":"Arbeit","prefs.supersampling_brief":"Rendert die Ansicht größer und verkleinert sie dann: sehr scharf, aber rechenintensiver.","prefs.tab_accent_note":"Die Akzentfarbe richtet sich nach dem aktiven Tab.","prefs.theme_file":"Designdatei","prefs.theme_file_or_paste":"Datei oder Einfügen","prefs.theme_follow":"Einer Designdatei folgen","prefs.theme_follow_error":"Nicht angewendet: {error}. Das letzte gültige Design bleibt aktiv.","prefs.theme_follow_launch":"Nur für diesen Start (--theme-file); wird neu geladen, sobald ein anderes Werkzeug die Datei überschreibt.","prefs.theme_follow_note":"Wird neu geladen, sobald ein anderes Werkzeug die Datei überschreibt. Die Auswahl eines Designs beendet das Folgen.","prefs.theme_follow_off":"Aus","prefs.theme_follow_stop":"Nicht mehr folgen","prefs.theme_import_hint":"Klicken, um eine Designdatei zu wählen, eine hierher ziehen oder mit kopiertem Design Strg+V (Cmd+V auf dem Mac) drücken","prefs.theme_option_opacity":"Deckkraft","prefs.theme_option_opacity_help":"Deckkraft schwebender Bedienfelder anpassen. Eine Mindestdeckkraft schützt die Lesbarkeit über den Ansichtsfarben.","prefs.theme_option_tab_colours":"Tabfarben","prefs.theme_option_tab_colours_help":"Panel- und Ansichtsfarben dieses Designs je Registerkarte verwenden.","prefs.theme_option_tab_fade_ms":"Tabübergang","prefs.theme_option_tab_fade_ms_help":"Panel- und Ansichtsfarben beim Tabwechsel überblenden. Null wechselt sofort.","prefs.theme_options_badge":"Optionen","prefs.theme_options_more":"Mehr · {count}","prefs.theme_options_reset":"Zurücksetzen","prefs.theme_options_unavailable":"Auf diesem Gerät nicht verfügbar","prefs.theme_paste":"Design einfügen","prefs.theme_paste_none":"Die Zwischenablage enthält kein SolidCraft-Design","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"Jetzt","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Hinweise","prefs.toggle_item":"Element hinzufügen oder wieder entfernen","prefs.toolbar":"Werkzeugleiste","prefs.toolbar_tabs":"Werkzeugleisten-Registerkarten","prefs.top":"Oben","prefs.trackpad_zoom_modifier":"Mit zwei Fingern zoomen bei gedrückter Taste","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Strg","prefs.trackpad_zoom_modifier.help":"Nur diese Taste gedrückt halten, um durch vertikales Scrollen am Zeiger zu zoomen. Aus behält das bisherige Scrollverhalten bei.","prefs.trackpad_zoom_modifier.off":"Aus","prefs.translucent":"Durchscheinend","prefs.under_browser":"Unter dem Browser","prefs.under_cursor":"Unter dem Cursor","prefs.units_precision":"Einheiten und Genauigkeit","prefs.updates":"Updates","prefs.value_boxes_in_view":"Werte in der Ansicht neben ihren Griffen zeigen","prefs.value_boxes_in_view_tip":"Der Wert eines Befehls (Abstand, Radius …) in einem Feld neben seinem Griff, über dem Modell. Aus: Sie geben ihn im Befehlsfenster ein, das nach einer Auswahl die Tastatur erhält, und nichts verdeckt das Modell.","prefs.view":"Ansichtsverhalten","prefs.view_confirm_corner":"OK und Abbrechen in der Ansichtsecke","prefs.view_confirm_corner_note":"Solange ein Dialog oder eine Skizze geöffnet ist, übernehmen ein Häkchen und ein Kreuz oben rechts in der Ansicht dieselben Funktionen wie „OK“ und „Abbrechen“ des Dialogs. Eine Skizze wird damit beendet oder verworfen. Der Ansichtsnavigator rückt darunter.","prefs.viewport":"Ansichtsfenster","prefs.viewport_analysis_status":"Analysestatus im Ansichtsfenster anzeigen","prefs.viewport_analysis_status_help":"Zeigt aktive Analysen über dem Ansichtsfenster und ihre Legenden am jeweiligen Eintrag. Esc beendet die neueste Analyse. Ausschalten stellt Ecklegenden und das bisherige Esc-Verhalten wieder her.","prefs.viewport_background":"Hintergrund","prefs.viewport_background_colour":"Farbe","prefs.viewport_background_theme":"Verlauf des Designs","prefs.viewport_section_status":"Schnittstatus im Ansichtsfenster anzeigen","prefs.viewport_section_status_help":"Die Schnitteinstellung im Ansichtsfenster anzeigen. Escape und die aktive Schaltfläche schalten den Schnitt aus. Deaktivieren, um die bisherigen Schnittbedienelemente zu behalten.","prefs.viewport_status_details":"Live-Details im Ansichtsfenster","prefs.viewport_status_details_help":"Aktive Analyse- und Schnitteinstellungen in standardisierten Detailkarten bearbeiten. Deaktivieren, um schreibgeschützte Analyselegenden und den Schnittdialog wiederherzustellen.","prefs.viewport_status_summary":"Status im Ansichtsfenster zusammenfassen","prefs.viewport_status_summary_help":"Drei oder mehr Statuselemente in einer Zusammenfassung anzeigen. Deaktivieren, um jedes Element in der vollständigen Zeile zu behalten.","prefs.wheel":"Mausrad","prefs.wheel_trackpad":"Mausrad und Trackpad","prefs.workspace":"Arbeitsbereich","prefs.zoom_stop_at_model":"Zoom am Modell stoppen","prefs.zoom_stop_at_model_tip":"3D-Maus und Geräte-App zoomen zur Oberfläche in der Ansichtsmitte; Zieh-Zoom hält den Punkt am Beginn des Ziehens fest. Aus: Zoom kann durch das Modell gehen. Mausrad und Pinch verwenden separat Zoom zum Mauszeiger","prefs.zoom_toward_cursor":"Zoomen zum Mauszeiger hin","properties.title":"Eigenschaften: {name}","recovery.days_ago":"vor {count} Tagen","recovery.detail":"{file} · {features} Merkmale · automatisch gespeichert {when}","recovery.discard_all":"Alle verwerfen","recovery.discard_all_detail":"Dies kann nicht rückgängig gemacht werden.","recovery.discard_all_title":"{count} automatische Sicherungen verwerfen?","recovery.discard_all_title_one":"1 automatische Sicherung verwerfen?","recovery.hours_ago":"vor {count} Std.","recovery.just_now":"gerade eben","recovery.min_ago":"vor {count} Min.","recovery.never_saved":"nie gespeichert","render.adaptive_absolute":"Absolute RGB-Fehleruntergrenze","render.adaptive_coverage":"Zielwert für den Abdeckungsfehler","render.adaptive_enable":"Samples mithilfe unabhängiger Pilot-Samples zuteilen","render.adaptive_help":"Nur GPU. Unabhängige Pilot-Samples werden verworfen. Anschließend werden pro Pixel 16 oder mehr Produktions-Samples zugeteilt, bis zu den Samples pro Pixel. Die Zuteilung richtet sich nach der RGB- und Abdeckungsvarianz; seltene Pfade können übersehen werden, und Pixel, die ihr Limit erreicht haben, können verrauscht bleiben. Der Abschlussbericht zählt den tatsächlichen Aufwand. Keine zertifizierte Garantie für ein bestimmtes Rauschniveau oder eine bestimmte Renderzeit.","render.adaptive_minimum":"Minimale Produktions-Samples","render.adaptive_pending":"Die adaptive Zuteilung mit unabhängigen GPU-Pilot-Samples und bedingte Fresnel-Schichten sind verfügbar. Zertifizierte Konvergenz, Garantien für seltene Ereignisse und adaptiver Lichttransport auf der CPU bleiben nicht verfügbar.","render.adaptive_pilots":"Pilot-Samples pro Pixel","render.adaptive_relative":"Zielwert für den relativen RGB-Fehler","render.add_ground":"Add fitted ground to setup","render.advanced_material_scope":"Ein endliches, homogenes GPU-Medium ist innerhalb ausdrücklich festgelegter Grenzen verfügbar. Dichtegitter, verschachtelte Glas-/Volumen-Kombinationen, Subsurface-Oberflächen, Displacement, spektraler Lichttransport und nicht zugeordnete erweiterte Materialkonzepte bleiben nicht verfügbar.","render.aging_add":"Alterungsschicht hinzufügen","render.aging_airborne":"Luftgetragener Staub / teilnehmendes Medium","render.aging_airborne_help":"Luftgetragener Staub bildet ein separates, endliches und homogenes Streuvolumen. Er beeinflusst den Lichttransport und das unbearbeitete EXR-Bild, nicht jedoch die Oberflächenalterungsschichten. Die bestehenden Einschränkungen für Volumen, Glas und Entrauschen gelten weiterhin. Eine Atmosphäre wird nicht automatisch hinzugefügt.","render.aging_all_bodies":"Alle geeigneten undurchsichtigen Körper","render.aging_chips":"Abgeplatzter Lack","render.aging_class_any":"Alle undurchsichtigen Materialklassen","render.aging_class_dielectric":"Nur nichtmetallische Oberflächen","render.aging_class_metal":"Nur metallische Oberflächen","render.aging_color":"Schichtfarbe · sRGB","render.aging_coverage":"Abdeckung","render.aging_dust":"Abgelagerter Staub","render.aging_empty":"Keine Alterungsschichten: Die ursprünglichen Oberflächen bleiben unverändert.","render.aging_fading":"Ausgeblichene Beschichtung","render.aging_grime":"Schmutz und Verfärbungen","render.aging_help":"Bis zu acht optische Schichten der Reihe nach kombinieren. Rost und Patina sind gestaltete Erscheinungsbilder, keine Simulationen von Alterung oder Korrosion. Die Mustergröße wird in Weltmillimetern angegeben. Geometrie, Masse und technische Eigenschaften bleiben unverändert; Glas und passive Bühnenflächen sind ausgenommen.","render.aging_metallic":"Metallanteil der Schicht","render.aging_origin":"Feldursprung · Weltkoordinaten (mm)","render.aging_patina":"Kupfergrüne Patina","render.aging_refresh_targets":"Aktuelle Körper prüfen","render.aging_roughness":"Rauheit der Schicht","render.aging_rust":"Oxidiertes Eisen / Rost","render.aging_scale":"Mustergröße","render.aging_scratches":"Feine Kratzer","render.aging_target":"Ziel und Koordinaten","render.aging_target_help":"Ein benanntes Ziel muss weiterhin zu seinem erfassten Index und Namen passen. Globale Masken sind im Weltkoordinatensystem verankert und folgen bewegten Teilen nicht. Die Funktion erkennt weder Hohlräume noch echten Kantenverschleiß. Filtern Sie die Liste, um weitere Körper zu erreichen.","render.aging_target_search":"Körpernamen filtern","render.aging_upward":"Ablagerung auf nach oben zeigenden Flächen","render.all_controls_help":"Kompakte Übersicht aller aktuellen Einstellungen. Die Abschnittsseiten erlauben eine gezielte Bearbeitung, ohne die zugrunde liegende Anfrage zu ändern.","render.all_shots_label":"Alle Aufnahmen","render.appearance_editor.absorption":"Absorption","render.appearance_editor.base_colour":"Grundfarbe","render.appearance_editor.body_reason":"Optische Bindungen gelten für einen ganzen Körper. Wählen Sie Körper, um diese Einstellungen zu bearbeiten.","render.appearance_editor.boundary":"Grenzfläche","render.appearance_editor.box":"Quader","render.appearance_editor.choose_image":"Bild wählen…","render.appearance_editor.closed":"Geschlossener Körper","render.appearance_editor.coat":"Klarlack","render.appearance_editor.cpu_reason":"Benötigt CPU-Strahlverfolgung.","render.appearance_editor.glass":"Glas und Absorption","render.appearance_editor.glass_enable":"Physikalisches Glas für diesen Körper verwenden","render.appearance_editor.glass_note":"Geschlossenes Glas verwendet geometrische Abstände. Es kann nicht mit Klarlack oder Texturen auf demselben Körper kombiniert werden.","render.appearance_editor.gpu_reason":"Benötigt GPU-Pfadverfolgung.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Texturen","render.appearance_editor.normal":"Normale","render.appearance_editor.normal_strength":"Normalenstärke","render.appearance_editor.origin":"Ursprung","render.appearance_editor.recipe":"Rezept","render.appearance_editor.reflection_sampling":"Abtastung für alle reflektierenden Körper","render.appearance_editor.reflections":"Reflexionen","render.appearance_editor.remove":"Gespeicherte entfernen","render.appearance_editor.remove_note":"Die gespeicherte Optik wird aus dieser Aufnahme entfernt. Geometrie und zugewiesene Looks bleiben erhalten.","render.appearance_editor.remove_title":"Gespeicherte Optik entfernen?","render.appearance_editor.replace":"Gespeicherte Optik dieses Körpers ersetzen","render.appearance_editor.revalidate":"Diesen Körper erneut prüfen","render.appearance_editor.save":"Diese Optik speichern","render.appearance_editor.save_reason":"Zum Speichern wird physikalisches Glas auf einem aktuellen GPU-Körper benötigt. Klarlack und lokale Bildtexturen bleiben vorübergehend.","render.appearance_editor.saved":"Mit dieser Aufnahme gespeichert","render.appearance_editor.saved_state":"Diese Optik ist mit dieser Aufnahme gespeichert.","render.appearance_editor.scatter_reason":"Innere Streuung benötigt einen geschlossenen Körper.","render.appearance_editor.temporary":"Diese Optik gilt vorübergehend in diesem Tab. Speichern Sie sie mit der Aufnahme.","render.appearance_editor.thickness":"Dicke","render.appearance_editor.thickness_reason":"Dicke gilt für dünne Schichten; geschlossenes Glas verwendet geometrische Abstände.","render.appearance_editor.thin":"Dünne Schicht","render.appearance_editor.u_repeat":"U-Wiederholung","render.appearance_editor.v_repeat":"V-Wiederholung","render.appearance_editor.v_up":"Textur-V zeigt nach oben","render.appearance_editor.weight":"Gewicht","render.appearance_physics_separate":"Das visuelle Aussehen weist weder Dichte noch thermische Daten oder andere technische Eigenschaften zu.","render.appearances":"Erscheinungsbilder","render.assign_help":"Klicken wendet den Look auf die Auswahl an. Ziehen zeigt eine Vorschau; ohne Auswahl startet Malen.","render.availability_native":"Native Zusammenstellung; vor dem Anwenden prüfen","render.availability_projection":"Unterstützte Projektion; Umfang und Auslassungen beachten","render.availability_reference":"Referenzdaten; keine automatische Zuweisung","render.backdrop_alpha_conflict":"Wählen Sie entweder diesen Hintergrund oder die Ausgabe als transparentes PNG; der Renderer ignoriert keine der beiden Einstellungen stillschweigend.","render.backdrop_enable":"Verlaufshintergrund nur für die Kamera verwenden","render.backdrop_first":"Start-/Mittelfarbe","render.backdrop_help":"Dieser Hintergrund im Bildschirmraum beleuchtet nicht, wirft keine Schatten, spiegelt nicht und stellt kein Gelände dar. Er ist im unbearbeiteten EXR-Bild nicht enthalten. Geometrie, Lichter und die HDR-Umgebung bleiben unabhängig.","render.backdrop_horizontal":"Horizontaler Verlauf","render.backdrop_radial":"Radialer Verlauf","render.backdrop_radius":"Radius","render.backdrop_second":"End-/Randfarbe","render.backdrop_vertical":"Vertikaler Verlauf","render.backdrop_x":"Mittelpunkt X","render.backdrop_y":"Mittelpunkt Y","render.background":"Szenenhintergrund","render.background_camera_section":"Kamerahintergrund · PNG-Darstellung","render.background_completed_frozen":"Das angezeigte Ergebnis ist ein eingefrorenes, fertiges Bild. Eine Änderung des Hintergrunds zeichnet dieses Ergebnis nicht automatisch neu. Verwenden Sie „Neu graden“ für reine Kameraänderungen oder „Rendern“ für eine neue physische Bühne.","render.background_hdr_separate":"Die aktuellen HDR-Ressourcen beleuchten Oberflächen und spiegeln sich darin; sie werden nicht automatisch als Panorama hinter dem Motiv angezeigt. Das Ändern eines Verlaufs dreht oder verfärbt die Beleuchtung nicht.","render.background_lighting_section":"HDR-Beleuchtung · getrennt vom Kamerahintergrund","render.background_no_alpha_override":"Ein Kamerahintergrund wird einer transparenten Ausgabe nicht stillschweigend hinzugefügt. Beim Neu-Graden des linearen Rohbilds wird die erfasste Abdeckung verwendet und das Entrauschen nicht erneut angewendet; das Quell-EXR bleibt unverändert.","render.background_not_light":"Die Hintergrundfarbe dient der Darstellung und ist keine zusätzliche Lichtquelle.","render.background_regrade":"Auf das behaltene lineare Rohbild anwenden","render.background_stage_occlusion":"Diese Aufnahme enthält physische Bühnengeometrie. Ein großer Boden oder eine große Wand kann das Bild füllen und einen reinen Kamerahintergrund verdecken. Entfernen oder verkleinern Sie die Bühne gezielt oder ändern Sie ihren physikalischen Reflexionsgrad. Neu graden kann bereits erfasste Geometrie nicht entfernen.","render.background_workflow":"Wählen Sie den gewünschten Hintergrund: eine reine Kamerafarbe bzw. einen Verlauf, eine physische Bühne, die Licht empfängt, oder HDR-Beleuchtung. Sie sind voneinander unabhängig. Die Live-Vorschau ist eine Modellieransicht; rendern Sie ein neues Bild oder graden Sie ein behaltenes lineares Rohbild neu, um die Nachbearbeitung der Kamera zu sehen.","render.base_appearance":"Bearbeitbares Aussehen des Körpers","render.base_apply":"Aussehen des Körpers anwenden","render.base_apply_help":"Eine rückgängig machbare visuelle Zuweisung an genau den geprüften Körper. Bestehende flächenspezifische Looks und technische Materialien bleiben davon getrennt.","render.base_color":"Grundfarbe · sRGB","render.base_metallic":"Metallanteil","render.base_opaque_only":"Dieser Editor lässt Körper undurchsichtig. Für optische Transmission verwenden Sie die gesonderten Glaseinstellungen.","render.bloom_enable":"Darstellungs-Bloom","render.bloom_help":"Kreativer Ausgabeglanz aus linearen Glanzlichtern mit drei normierten Durchläufen. Radius in Ausgabepixeln; Addition vor sRGB. Keine Linsen-, Volumen- oder Konvergenzsimulation. Das rohe EXR bleibt unverändert.","render.bloom_opaque":"Bloom benötigt eine deckende Ausgabe. Transparentes PNG wird abgelehnt, nicht still abgeflacht.","render.bloom_radius":"Bloom-Radius","render.bloom_strength":"Bloom-Stärke","render.bloom_threshold":"Linearer Glanzlichtschwellwert","render.browse_capabilities":"Vollständigen Funktionskatalog ansehen","render.browse_environments":"Originale HDR-Umgebungen durchsuchen","render.browse_looks":"Durchsuchen…","render.browse_native_scenes":"Native Studios durchsuchen","render.browse_physical":"Physikalische Referenzen ansehen","render.browse_quality":"Qualitätsspezifikationen ansehen","render.browse_rigs":"Erstellte Lichtaufbauten durchsuchen","render.browse_scene_specs":"Erweiterte Szenenspezifikationen durchsuchen","render.browse_surfaces":"Erstellte Oberflächen durchsuchen","render.browser_library":"Bibliothek","render.browser_model":"Modell","render.camera_distance":"Abstand zwischen Kamera und Ziel","render.camera_exact_help":"Weltmillimeter; Winkel werden in Grad angezeigt und als Bogenmaß gespeichert. Die Navigation verwendet dieselbe Kamera wie die Ansicht.","render.camera_fov":"Vertikaler Bildwinkel","render.camera_pitch":"Kameraneigung","render.camera_roll":"Rollwinkel","render.camera_set":"Render-Kamera einstellen","render.camera_target":"Zielposition · mm","render.camera_yaw":"Gierwinkel","render.category_metal":"Metall","render.category_paint":"Lack","render.category_plastic":"Kunststoff","render.category_wood":"Holz","render.check_opaque":"Transparenz: nur undurchsichtige Oberflächen; Hintergrund-Alpha wird unterstützt.","render.check_sorted_alpha":"Transparenz: Näherung mit sortiertem Alpha.","render.check_transmission":"Transparenz: physikalische Transmission.","render.children.absolute_floor":"Absolute Untergrenze","render.children.adaptive":"Adaptiv","render.children.add_look_reason":"Einen Look hinzufügen, um Aktivierung und Stärke zu bearbeiten.","render.children.all_shots":"Alle Aufnahmen","render.children.bloom":"Bloom","render.children.check":"Prüfen","render.children.check_now":"Jetzt prüfen","render.children.chromatic":"Chromatisch","render.children.compact":"Kompakt","render.children.contrast":"Kontrast","render.children.copy_image":"Kopieren","render.children.copy_job":"Auftrags-JSON kopieren","render.children.copy_request":"Anfrage-JSON kopieren","render.children.coverage_error":"Abdeckungsfehler","render.children.cpu":"CPU-Raytracing","render.children.denoise":"Rauschen im fertigen Bild reduzieren","render.children.depth":"Pfadtiefe","render.children.distortion":"Verzeichnung","render.children.edge_samples":"Kanten-Samples","render.children.effects_banner":"Diese Effekte benötigen GPU-Pathtracing. Das Öffnen ändert die Methode nicht.","render.children.enable_adaptive":"Unabhängige Pilotabtastung aktivieren, um adaptive Grenzen zu bearbeiten.","render.children.enable_bloom":"Bloom aktivieren, um Stärke, Schwelle und Radius zu bearbeiten.","render.children.finishing":"Nachbearbeitung","render.children.flare":"Lichtreflexe","render.children.fresnel":"Fresnel-Schichten","render.children.ghosts":"Geisterringe","render.children.glass":"Glastransport","render.children.go_to":"Zu {editor}","render.children.grain":"Korn","render.children.halo":"Lichthof","render.children.hdr":"HDR","render.children.keep_master":"Lineares Rohbild behalten","render.children.last_result":"Zuletzt: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Objektiveffekte","render.children.look_summary":"{tone} · {co