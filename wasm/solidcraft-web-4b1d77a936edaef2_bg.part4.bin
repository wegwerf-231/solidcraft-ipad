a","render.error_display_dimensions":"neispravne dimenzije prikaza slike","render.error_display_fit":"prikaz slike se ne može smjestiti na ovaj uređaj","render.error_display_height":"prekoračena visina prikaza","render.error_display_width":"prekoračena širina prikaza","render.error_duplicate_face":"dupli izgled lica proizvoda","render.error_export_document":"Dokument izvoza renderovanja promijenio se dok je birano odredište","render.error_face_cap":"pregled proizvoda premašuje ograničenje broja izgleda lica","render.error_finish_gesture":"završite gestu modeliranja prije pregleda","render.error_finish_operation":"završite trenutnu operaciju modeliranja prije ulaska u Renderovanje","render.error_fixed_preview":"fiksni pregled studija zahtijeva ekspoziciju 0, rotaciju okruženja 0 i intenzitet 1","render.error_geometry_size":"prekoračena veličina geometrije proizvoda","render.error_glass_recipe":"nepoznata receptura stakla","render.error_gpu_preview":"GPU pregled proizvoda nije dostupan na ovom računaru. Sačuvane postavke ostaju dostupne.","render.error_gpu_samples":"nepodržan broj GPU uzoraka","render.error_image_dimensions":"dimenzije renderovane slike ne odgovaraju njenom poslu","render.error_image_profile":"renderovana slika premašuje zabilježeni profil resursa","render.error_interactive_command":"nevezana interaktivna komanda renderovanja","render.error_job_action":"nije akcija interaktivnog posla slike","render.error_job_identity":"neispravan identitet posla renderovanja: {error}","render.error_library_reply":"neispravan odgovor biblioteke renderovanja","render.error_material_binding":"nedostaje veza materijala","render.error_no_completed_image":"renderovanje nema završenu sliku","render.error_no_geometry":"nema geometrije proizvoda","render.error_no_scene":"nema scene proizvoda","render.error_opacity":"neispravna neprozirnost izgleda proizvoda","render.error_pbr_opacity":"neprozirni PBR zahtijeva neprozirnost 1","render.error_physical_glass":"izabrana receptura 