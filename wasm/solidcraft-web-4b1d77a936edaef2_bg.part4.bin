 di superficie","cmd.surface_patch":"Superficie di chiusura","cmd.surface_reverse_normal":"Inverti normale","cmd.surface_revolve":"Rivoluzione di superficie","cmd.surface_ruled":"Superficie rigata","cmd.surface_stitch":"Cuci","cmd.surface_sweep":"Sweep di superficie","cmd.surface_thicken":"Ispessisci","cmd.surface_unstitch":"Separa superfici","cmd.surface_untrim":"Ripristina superficie","cmd.timeline_add":"Aggiungi lavorazione registrata","cmd.timeline_compute_all":"Ricalcola tutto","cmd.timeline_copy":"Copia lavorazioni","cmd.timeline_dependents":"Lavorazioni dipendenti","cmd.timeline_export_script":"Esporta script dei comandi","cmd.timeline_inspect":"Esamina lavorazione","cmd.timeline_paste":"Incolla lavorazioni","cmd.timeline_play":"Riproduci cronologia","cmd.timeline_redefine":"Modifica lavorazione","cmd.timeline_rename":"Rinomina","cmd.timeline_reorder":"Riordina lavorazione","cmd.timeline_roll_to":"Sposta marcatore della cronologia","cmd.timeline_rollback":"Sposta marcatore della sequenza temporale","cmd.timeline_stop":"Arresta riproduzione cronologia","cmd.timeline_suppress":"Sospendi lavorazione","cmd.view.render_browser":"Struttura del rendering","cmd.view.render_dock":"Sposta pannello di rendering","cmd.view.render_focus":"Vista focalizzata sul rendering","cmd.view.status_details":"Dettagli di stato della vista","cmd.view.status_items":"Elementi di stato della vista","cmd.view_ambient_occlusion":"Occlusione ambientale","cmd.view_angle_readout":"Angoli della vista","cmd.view_apply":"Ripristina vista con nome","cmd.view_back":"Vista posteriore","cmd.view_bottom":"Vista dal basso","cmd.view_delete":"Elimina vista con nome","cmd.view_fit":"Adatta","cmd.view_front":"Vista frontale","cmd.view_graphics_preset":"Preimpostazione grafica","cmd.view_grid":"Griglia","cmd.view_ground_shadow":"Ombra sul suolo","cmd.view_home":"Vista iniziale","cmd.view_isometric":"Vista isometrica","cmd.view_left":"Vista sinistra","cmd.view_list":"Elenca viste con nome","cmd.view_navigate":"Naviga nella vista","cmd.view_navigation_bar":"Barra di navigazione","cmd.view_next_tab":"Scheda successiva","cmd.view_normal_to":"Normale alla selezione","cmd.view_previous_tab":"Scheda precedente","cmd.view_rename":"Rinomina vista con nome","cmd.view_render_frame":"Guide di inquadratura del rendering","cmd.view_right":"Vista destra","cmd.view_save":"Nuova vista con nome","cmd.view_shots_strip":"Striscia degli scatti","cmd.view_spin":"Orbita continua","cmd.view_tool":"Strumento di navigazione","cmd.view_top":"Vista dall'alto","cmd.view_visual_style":"Stile di visualizzazione","color.copy":"Fai clic per copiare i valori del colore","color.edit":"Fai clic per modificare il colore","color.gamma":"Valori del colore mostrati nello spazio gamma 0-255","color.hex":"Hex","color.hex_help":"Inserisci #rrggbb o #rrggbbaa; con sei cifre l'opacità resta invariata","color.hex_hint":"#rrggbb","color.hue":"Tonalità","color.linear":"Valori del colore mostrati nello spazio lineare 0-1","color.recent":"Colori recenti","color.recent_help":"I colori scelti in qualsiasi campo colore compaiono qui","color.saturation":"Saturazione (percentuale)","color.saturation_value":"Saturazione e valore","color.selected":"Colore selezionato","color.step_down":"Diminuisci di un passo","color.step_up":"Aumenta di un passo","color.value":"Valore, la luminosità (percentuale)","config.column_filter_empty":"Nessuna colonna corrispondente","contact.components_count":"{count} componenti","contact.enabled_label":"abilitato","coupling.gear_1":"Ruota dentata 1","coupling.gear_1_pick":"Ruota dentata 1 (facoltativa)","coupling.gear_2":"Ruota dentata 2","coupling.gear_2_pick":"Ruota dentata 2 (facoltativa)","coupling.internal":"Dentatura interna","coupling.needs_turn_and_slide":"richiede un giunto rotante e uno scorrevole","coupling.needs_turns":"richiede due giunti rotanti","coupling.not_round":"la faccia non è circolare","coupling.nut":"Dado","coupling.picked":"selezionato","coupling.pinion":"Pignone","coupling.pinion_pick":"Pignone (facoltativo)","coupling.pitch":"Passo","coupling.rack":"Cremagliera","coupling.radius_1":"Raggio 1","coupling.radius_2":"Raggio 2","crash.announce":"L'ultima volta SolidCraft si è chiuso inaspettatamente o ha riscontrato un errore interno. È stato salvato un rapporto di arresto anomalo (Aiuto > Rapporti di arresto anomalo…).","crash.copy_folder":"Copia percorso della cartella","crash.copy_path":"Copia percorso","crash.deleted":"Eliminati {count} rapporti.","crash.detected_time":"Rilevato {time} UTC","crash.intro":"I rapporti di arresto anomalo restano su questo computer e non vengono mai inviati altrove. Segnala… apre una bozza che puoi rivedere prima di condividere qualsiasi cosa.","crash.kind_command":"Errore interno in un comando","crash.kind_internal":"Errore interno","crash.kind_kernel":"Errore del kernel (ripristinato)","crash.kind_unclean":"Chiuso inaspettatamente","crash.previous_session":"Una sessione precedente di SolidCraft è terminata inaspettatamente o ha riscontrato un errore interno. I rapporti delle chiusure anomale vengono rilevati all'avvio. Vedi Aiuto > Rapporti di arresto anomalo… per i dettagli.","crash.replayable":"riproducibile","crash.report":"Segnala…","crash.unclean_explanation":"Rilevato a un avvio successivo; l'ora esatta di chiusura non è stata registrata. Anche uno spegnimento del sistema o un arresto forzato possono causare una chiusura anomala.","delete.and_more":"… e altri {count}","diagnostic.empty_boolean_component":"nel componente '{component}' non c'è nessun corpo da tagliare o intersecare; l'utensile potrebbe sovrapporsi a '{body}' nel componente '{other}': attiva quel componente oppure scegli il corpo come destinazione","dialog.bodies_count":"{count} corpi","dialog.clearance_invalid":"il gioco deve essere una lunghezza pari o superiore a 0","dialog.compute":"Calcola","dialog.compute_again":"Ricalcola","dialog.computing":"Calcolo in corso… {seconds} s","dialog.could_not_be_checked":"impossibile verificare","dialog.custom_axis":"↖ Asse personalizzato","dialog.dimension_insert_hint":"Fai doppio clic su un’altra quota di controllo per inserirne il nome","dialog.dimension_name":"Quota: {name}","dialog.edit_title":"MODIFICA {title}","dialog.no_shown_body":"Nessun corpo visibile da modificare: mostrane uno o scegli Nuovo corpo","dialog.select":"↖ Seleziona","dialog.selected_count":"↖ Selezionati: {count}","dialog.selection_guidance":"Seleziona un dato di ingresso per modificarlo. Fai clic sugli oggetti selezionati per rimuoverli; anche Ctrl/Cmd-clic ne alterna la selezione. Controlla l'anteprima, poi premi OK.","dialog.selection_step":"{step} di {total}: seleziona {input}","dialog.step":"Passo","document.changed_on_disk":"{name} è stato modificato sul disco","document.changed_on_disk_detail":"{name} è stato modificato da un altro programma o computer da quando l'hai aperto o salvato l'ultima volta. Sovrascrivi sostituisce quelle modifiche con le tue; Salva una copia mantiene entrambe le versioni.","document.copy_name":"{name} copia","document.open_anyway":"Apri comunque","document.open_elsewhere":"{name} è già aperto","document.open_elsewhere_detail":"{name} è aperto in SolidCraft {app} su {who}, aperto {when}. Se salvate entrambi, uno di voi perde del lavoro. Aprilo in sola lettura per consultarlo senza sovrascriverlo.","document.open_read_only":"Apri in sola lettura","document.opened_read_only":"Aperto in sola lettura: Salva chiede un nuovo file","document.overwrite":"Sovrascrivi","document.read_only_save":"Questa progettazione è stata aperta in sola lettura: salvala come nuovo file","document.save_changes":"Salvare le modifiche a {name}?","document.save_copy":"Salva una copia…","document.unsaved_changes":"{name} contiene modifiche non salvate. Se non salvi, andranno perse.","drive.rigid":"{joint} è un giunto rigido: tiene ferme le sue parti, quindi non c'è nulla da azionare. Per farle muovere, cambia il suo tipo in Modifica giunto: Rotante per ruotare, Scorrevole per scorrere, Cilindrico per entrambi.","drive.stopped_by_contact":"Arrestato a {value}: {a} attraverserebbe {b}","drive.stopped_by_loop":"Arrestato a {value}: la catena chiusa che passa per {joint} non può chiudersi ulteriormente","drive.unconnected":"Nessun movimento: {part} non è collegato ad alcun elemento fissato a terra","dxf.cancel_wait":"In attesa dell'arresto dell'esportazione…","dxf.cancelled":"Esportazione DXF annullata","dxf.cancelling":"Annullamento dell'esportazione DXF","dxf.exporting":"Esportazione DXF","dxf.invalid_tolerance":"La tolleranza delle curve deve essere compresa tra 0.0001 e 1 mm.","dxf.progress.index":"Preparazione delle superfici (2/5)","dxf.progress.meshes":"Preparazione delle mesh (1/5)","dxf.progress.occlusion":"Risoluzione delle linee nascoste (4/5)","dxf.progress.projection":"Proiezione della geometria (3/5)","dxf.progress.write":"Scrittura DXF (5/5)","dxf.tolerance":"Tolleranza delle curve","dxf.tolerance_help":"Solo corpi visibili e schizzi mostrati. Le curve usano segmenti rettilinei. Una tolleranza minore produce curve più precise e richiede più tempo e memoria.","each rail's curves must be in one sketch":"le curve di ogni guida devono stare in un solo schizzo","feature computation ended without a result":"il calcolo dell'operazione si è concluso senza risultato","file.open.drawing_filter":"Progettazioni, file CAD, mesh e disegni","file_load.built":"Costruite finora: {built} di {total} feature.","file_load.converting":"Conversione del solido {done} di {total}","file_load.inserting":"Inserimento della geometria","file_load.link_item":"{name} ({done} di {total})","file_load.opening":"Apertura del progetto","file_load.preparing_thumbnail":"Preparazione dell'anteprima...","file_load.preparing_view":"Preparazione della vista...","file_load.preview_note":"Anteprima salvata. La geometria viene verificata prima della modifica.","file_load.reading":"Lettura del file...","file_load.reading_percent":"Lettura del file... {percent}%","file_load.rebuilding":"Ricostruzione della feature {done} di {total}","file_load.recovering":"Recupero del progetto","file_load.stopping":"In attesa dell'arresto dell'operazione precedente...","file_load.updating_links":"Aggiornamento dei collegamenti","file_load.waiting":"In attesa dell'operazione sul file","fits the face, e.g. M8":"adatta alla faccia, ad es. M8","from the profile":"dal profilo","from the rule":"dalla regola","help.apache":"Licenza Apache 2.0","help.appearance.assign":"Dà ai corpi, alle facce o ai componenti selezionati un colore o un aspetto di materiale, senza cambiarne il peso. Usalo per distinguere le parti o per vedere in anteprima una finitura.","help.assembly.bom":"Elenca le parti del progetto o di un componente con le relative quantità, per numero di parte, e può salvare l'elenco come CSV o JSON. Usalo come distinta delle parti per ordini e montaggio.","help.attributions":"Attribuzioni (ATTRIBUTION.md)","help.build":"Versione {version} · commit {commit} · compilata il {date}","help.canvas.decal":"Applica un'immagine su una faccia piana del modello, come un adesivo. Usalo per mostrare un'etichetta, un logo o un motivo stampato su un pezzo.","help.canvas.edit":"Modifica un'immagine di riferimento: posizione, dimensione, angolo, opacità, specchiatura, visibilità o nome. Usalo per allineare l'immagine allo schizzo che ci ricalchi sopra.","help.canvas.insert":"Colloca un'immagine PNG o JPEG su un piano o una faccia come riferimento semitrasparente. Usalo per ricalcare una foto o un disegno in uno schizzo, con l'immagine scalata a una dimensione nota.","help.component.break_link":"Interrompe il collegamento di un componente con il suo file di progetto, mantenendone i corpi così come sono. Usalo quando la parte non deve più seguire le modifiche del file originale.","help.component.capture_position":"Acquisisce le posizioni delle parti spostate a mano, che diventano la loro nuova posizione. Usalo dopo aver trascinato in posizione parti che nessun giunto trattiene.","help.component.create":"Aggiunge al progetto un nuovo componente vuoto, dentro il componente attivo a meno che tu non scelga un altro padre. Usalo per dare a una nuova parte di un assieme il proprio spazio per corpi e schizzi.","help.component.finish_edit":"Salva la parte che stai modificando sul posto, torna al suo assieme e lo aggiorna con le modifiche. Usalo quando hai finito di modificare la parte collegata.","help.component.from_bodies":"Trasforma ogni corpo selezionato in un componente a sé, con il nome del corpo. Usalo quando un progetto costruito con corpi sciolti deve diventare un assieme le cui parti possono essere collegate con giunti e spostate.","help.component.insert_design":"Inserisce un altro progetto salvato come componente collegato al suo file, con i suoi corpi solidi posizionati come nel file originale. Usalo per riutilizzare una parte in un assieme e recepire le modifiche successive con Aggiorna collegamenti.","help.component.properties":"Mostra volume, massa, centro di massa e momenti d'inerzia di un componente, in base ai materiali dei suoi corpi. Usalo per controllare peso e bilanciamento di un assieme.","help.component.revert_position":"Riporta dove erano le parti spostate a mano, scartando gli spostamenti non acquisiti. Usalo per annullare gli spostamenti di prova in un assieme.","help.component.update_links":"Rilegge i file di progetto collegati e sostituisce i corpi che sono cambiati. Usalo dopo aver modificato una parte usata da questo assieme.","help.config.configure":"Aggiunge parametri, lavorazioni, materiali o aspetti come colonne della tabella delle configurazioni. Usalo per creare varianti di uno stesso progetto, ad esempio le misure di un pezzo.","help.config.preview":"Verifica che una riga della tabella delle configurazioni si ricostruisca, senza modificare il progetto né la sua cronologia. Usalo prima di passare a una variante di cui non sei sicuro.","help.config.rules":"Mostra le regole della tabella delle configurazioni, le sue righe e quale riga è attiva. Usalo per vedere come sono impostate le varianti di un progetto.","help.config.table":"Mostra la tabella delle configurazioni: una riga per variante, una colonna per parametro o lavorazione, e se il progetto corrisponde ancora alla riga attiva. Usalo per esaminare le varianti di un progetto.","help.connect_note":"Riavvia ogni assistente per caricare il server SolidCraft. Ogni file è stato salvato come .bak prima della modifica.","help.connect_title":"Collega assistenti AI","help.construct.axis.edge":"Crea un asse di costruzione lungo uno spigolo rettilineo o una linea dello schizzo. Usalo come asse per una rivoluzione, una serie circolare o un giunto.","help.construct.axis.normal_to_face":"Crea un asse di costruzione passante per un punto, perpendicolare a una faccia. Usalo come asse che esce dritto da una superficie.","help.construct.axis.through_cylinder":"Crea un asse di costruzione passante per il centro di una faccia cilindrica, conica o torica, o di uno spigolo circolare. Usalo per ruotare lavorazioni o ripeterle in serie attorno a un pezzo tondo.","help.construct.axis.two_planes":"Crea un asse di costruzione dove si incontrano due piani o facce piane. Usalo quando l'asse che ti serve è la linea tra due facce.","help.construct.axis.two_points":"Crea un asse di costruzione passante per due punti, vertici o punti dello schizzo. Usalo per un asse che collega due posizioni note.","help.construct.plane.along_path":"Crea un piano di costruzione perpendicolare a uno spigolo o a una curva, in una posizione lungo di essa. Usalo per disegnare il profilo di uno sweep o una sezione di un percorso.","help.construct.plane.at_angle":"Crea un piano di costruzione ruotato di un angolo rispetto a un piano o a una faccia, attorno a un asse o a uno spigolo. Usalo per schizzi inclinati, ad esempio una staffa angolata.","help.construct.plane.midplane":"Crea un piano di costruzione a metà tra due piani o facce piane, oppure che li biseca dove si incontrano ad angolo. Usalo come piano di simmetria per specchiare.","help.construct.plane.offset":"Crea un piano di costruzione parallelo a un piano o a una faccia piana, a una certa distanza o passante per un punto. Usalo per disegnare a un'altezza stabilita sopra una faccia.","help.construct.plane.perpendicular":"Crea un piano di costruzione che contiene una linea o uno spigolo ed è perpendicolare a un piano o a una faccia. Usalo per disegnare in verticale sul modello lungo uno spigolo.","help.construct.plane.tangent":"Crea un piano di costruzione tangente a un cilindro, un cono, una sfera o un toro in un punto. Usalo per disegnare sul lato di un pezzo tondo.","help.construct.plane.three_points":"Crea un piano di costruzione passante per tre punti. Usalo per un piano definito da posizioni sul modello, ad esempio tre angoli.","help.construct.plane.two_edges":"Crea un piano di costruzione passante per due spigoli rettilinei o linee che giacciono sullo stesso piano. Usalo per un piano che attraversa un pezzo, ad esempio per due spigoli opposti.","help.construct.point.along_path":"Crea un punto di costruzione in una posizione lungo uno spigolo o una curva. Usalo come riferimento in un punto intermedio di un percorso.","help.construct.point.center":"Crea un punto di costruzione al centro di uno spigolo circolare, di un cerchio o arco dello schizzo, di una sfera o di un toro. Usalo come riferimento per fori, assi e giunti.","help.construct.point.edge_plane":"Crea un punto di costruzione dove uno spigolo o una linea attraversa un piano o una faccia piana. Usalo per segnare dove un percorso incrocia un piano.","help.construct.point.three_planes":"Crea un punto di costruzione dove si incontrano tre piani o facce piane. Usalo come riferimento d'angolo, anche dove il modello non ha un vertice.","help.construct.point.two_edges":"Crea un punto di costruzione dove due spigoli o linee si incontrano, o si avvicinano di più. Usalo come riferimento in un angolo virtuale.","help.construct.point.vertex":"Crea un punto di costruzione su un vertice o su un punto dello schizzo. Usalo come riferimento che resta anche quando lo schizzo o il corpo intorno è nascosto.","help.contact.check":"Elenca le coppie di parti nei gruppi di contatto che si compenetrano nella posizione attuale. Usalo per trovare le collisioni prima di azionare i giunti o avviare uno studio del movimento.","help.contact.create":"Raggruppa due o più parti in un gruppo di contatto, i cui corpi non possono compenetrarsi mentre i giunti si muovono. Usalo per parti che devono fermarsi quando si toccano, come una leva contro il suo fermo.","help.contact.disable_all":"Disattiva il contatto, così i giunti azionati e gli studi del movimento non si fermano più dove le parti si toccano. Usalo per muovere di nuovo le parti liberamente, o per mantenere reattivo un assieme grande.","help.contact.edit":"Modifica un gruppo di contatto: le parti che contiene, il nome o se è sospeso; può anche eliminare il gruppo. Usalo per regolare quali parti non possono compenetrarsi.","help.contact.enable_all":"Mette ogni parte dell'assieme in un unico gruppo di contatto, così nessuna coppia di parti può compenetrarsi mentre i giunti si muovono. Usalo per un controllo rapido di un intero meccanismo.","help.contact.enable_sets":"Attiva il contatto per i gruppi di contatto che hai definito, così i giunti azionati e gli studi del movimento si fermano dove le loro parti si compenetrerebbero. Usalo per riattivare i tuoi gruppi dopo aver disattivato il contatto.","help.contact.list":"Elenca i gruppi di contatto del progetto, le parti di ciascuno e se il contatto è attivo. Usalo per controllare come è impostato il contatto prima di azionare l'assieme.","help.document.inspect":"Mostra una panoramica del progetto: componenti, corpi, schizzi, lavorazioni e parametri. Usalo per orientarti in un progetto che non hai realizzato tu.","help.document.units":"Cambia le unità in cui il progetto mostra le lunghezze, come mm o pollici. La geometria mantiene le sue dimensioni; si adattano solo la visualizzazione e i numeri semplici.","help.edit.checkpoint":"Memorizza il progetto, lo schizzo attivo e la cronologia di annullamento così come sono ora. Usalo prima di tentare qualcosa di rischioso da cui potresti voler tornare indietro.","help.edit.restore_checkpoint":"Torna a un punto di ripristino, compresa la cronologia di annullamento. Usalo per scartare in un solo passo tutto ciò che è stato fatto dopo il punto di ripristino.","help.explode.create":"Crea una vista esplosa che allontana le parti dal centro dell'assieme, oppure con gli spostamenti che imposti. Usalo per mostrare come si monta un assieme, per istruzioni o presentazioni.","help.face.delete":"Rimuove le facce selezionate e lascia che le facce vicine chiudano il vuoto, oppure lascia il vuoto aperto come superficie. Usalo per togliere uno spigolo arrotondato, un foro o una sporgenza che è d'intralcio.","help.file.insert_mesh":"Aggiunge al progetto un file 3MF, STL, OBJ, PLY o glTF come corpi a mesh in un nuovo componente. Usalo per affiancare al progetto, come riferimento, un modello scaricato o scansionato.","help.file.insert_step":"Aggiunge al progetto un file STEP, IGES, FreeCAD o Rhino come corpi solidi in un nuovo componente; le parti di un assieme diventano componenti annidati. Usalo per importare modelli di fornitori o di altri programmi CAD.","help.file.save_mesh":"Salva i corpi come mesh STL, 3MF o OBJ, con la finezza che scegli per le facce curve. Usalo per preparare pezzi per la stampa 3D o per programmi che leggono mesh.","help.file.send_to_slicer":"Salva i corpi selezionati come file 3MF e lo apre nello slicer che scegli. Usalo per passare dal modello alla stampa in un solo passo.","help.font_details":"L’interfaccia usa i caratteri integrati di egui (Ubuntu Light e Hack, con licenze Ubuntu Font Licence e MIT/Bitstream Vera; Noto Emoji e il carattere per icone emoji, con licenze OFL e MIT). Il testo degli schizzi usa Liberation Sans (SIL OFL 1.1). Il pacchetto di caratteri facoltativo di The Crafting Apps, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), non è incluso nelle build di SolidCraft.","help.fonts":"Caratteri","help.frame.member":"Posiziona un profilo, come un tubo o un profilato di alluminio, lungo le linee di uno schizzo del telaio, un membro per linea. Usalo per costruire telai, scaffalature e strutture saldate.","help.inspect.accessibility":"Colora le facce che un utensile può raggiungere da una direzione e quelle che non può raggiungere. Usalo per verificare un pezzo per la lavorazione meccanica o lo stampaggio da quel lato.","help.inspect.center_of_mass":"Mostra il centro di massa dei corpi, ciascuno da solo e tutti insieme, a densità uniforme. Usalo per controllare il bilanciamento e dove un pezzo si ribalterà.","help.inspect.colored_components":"Dà a ogni componente un proprio colore temporaneo, senza modificare gli aspetti. Usalo per distinguere a colpo d'occhio le parti di un assieme.","help.inspect.compare":"Confronta due corpi e mostra dove uno ha materiale che l'altro non ha, con volume e scostamento. Usalo per verificare un pezzo modificato o importato rispetto all'originale.","help.inspect.continuity":"Verifica come si raccordano le facce lungo i loro spigoli: giochi, spigoli vivi o salti di curvatura, e colora le giunzioni. Usalo per trovare dove le superfici non si raccordano bene.","help.inspect.curvature_comb":"Disegna pettini lungo curve, spigoli o facce i cui denti mostrano quanto si curvano. Usalo per individuare zone piatte, spigoli vivi e curvatura irregolare.","help.inspect.curvature_map":"Colora le facce in base a quanto si curvano, in rosso dove il raggio è piccolo. Usalo per trovare i punti stretti e valutare quanto è liscia una superficie.","help.inspect.draft":"Colora le facce in base all'angolo di sformo rispetto a una direzione di estrazione, segnalando quelle con sformo insufficiente. Usalo per controllare un pezzo prima dello stampaggio o della fusione.","help.inspect.environment_map":"Mostra il modello con una finitura riflettente, simile a uno specchio. Usalo per valutare l'andamento delle superfici dal modo in cui scorrono i riflessi.","help.inspect.interference":"Trova i corpi che si sovrappongono e mostra ogni sovrapposizione con il suo volume. Usalo per controllare se in un assieme ci sono parti che si scontrano.","help.inspect.isocurve":"Disegna le curve isoparametriche delle facce, la griglia su cui è costruita la superficie. Usalo per vedere come scorre una superficie e dove si addensa.","help.inspect.measure":"Misura lunghezze, distanze, angoli, aree e raggi tra gli elementi che selezioni, oppure il volume e la massa dei corpi. Usalo per controllare dimensioni e distanze libere.","help.inspect.minimum_radius":"Trova il raggio di curvatura minimo di curve, spigoli o facce e dove si trova. Usalo per verificare che un utensile o un ugello possa seguire la forma.","help.inspect.section":"Apre la vista con un taglio lungo un piano e tratteggia le facce tagliate, senza modificare il modello. Usalo per guardare dentro pezzi e assiemi.","help.inspect.zebra":"Mostra strisce bianche e nere riflesse sulle facce del modello. Usalo per valutare la levigatezza: strisce che si spezzano o si piegano su uno spigolo indicano una transizione scadente.","help.joint.as_built":"Collega due parti dove si trovano già, senza spostarne nessuna, e imposta come possono ancora muoversi. Usalo per parti che hai già posizionato nella loro posizione finale.","help.joint.cam":"Collega una camma rotante a un seguicamma, che scorre o oscilla mentre il profilo della camma gli passa sotto. Usalo per camme, eccentrici e comandi delle valvole.","help.joint.create":"Collega due parti alle origini del giunto che selezioni e sposta la seconda parte al suo posto; il tipo di giunto stabilisce come possono ancora muoversi. Usalo per costruire un assieme le cui parti si muovono come il meccanismo reale.","help.joint.drive":"Imposta l'angolo o la distanza di un giunto e sposta di conseguenza le parti, entro i suoi limiti; i giunti collegati e le catene cinematiche chiuse seguono il movimento. Usalo per verificare che un meccanismo si muova come previsto.","help.joint.gear":"Collega due giunti rotanti con un rapporto di trasmissione, così azionarne uno fa ruotare l'altro. Usalo per ingranaggi cilindrici e dentature interne, con il rapporto ricavato dai raggi primitivi o dal numero di denti.","help.joint.limits":"Imposta fin dove un giunto può ruotare o scorrere, con un minimo e un massimo, oppure rimuove questi limiti. Usalo per mantenere una cerniera, un cursore o una leva entro la sua reale corsa.","help.joint.motion_link":"Accoppia due giunti con un rapporto e uno scostamento, così azionarne uno muove l'altro. Usalo per una relazione fissa tra giunti che Ingranaggio, Pignone e cremagliera o Vite non coprono.","help.joint.origin":"Colloca un'origine del giunto con nome su una parte: al centro di una faccia o di un'estremità tonda, a metà di uno spigolo, su un angolo o su un punto. Usalo per preparare i punti in cui si attaccano i giunti; un'origine scelta su una faccia segue la faccia quando la parte cambia dimensione.","help.joint.rack_pinion":"Collega un pignone rotante a una cremagliera scorrevole, così la cremagliera si sposta della lunghezza di circonferenza primitiva percorsa dal pignone. Usalo per trasmissioni a cremagliera, sterzi e slitte lineari.","help.joint.reach":"Sposta un punto di una parte verso una destinazione modificando i giunti della sua catena, entro i loro limiti. Usalo per posizionare un meccanismo in base a dove deve arrivare la sua estremità, come la punta di un braccio robotico.","help.joint.rigid_group":"Blocca insieme le parti selezionate così come sono, in modo che si muovano come un tutt'uno. Usalo per parti che stanno insieme e non hanno moto relativo.","help.joint.screw":"Collega rotazione e scorrimento tramite un passo, così ogni giro avanza di quella distanza. Usalo per viti madri, bulloni e alberi filettati.","help.library.apply":"Applica un materiale o un aspetto da un file di libreria locale a corpi, facce o componenti. Usalo per riutilizzare materiali salvati da un altro progetto.","help.library.export":"Salva i materiali e gli aspetti del progetto in un file di libreria. Usalo per condividerli o riutilizzarli in altri progetti.","help.library.inspect":"Controlla un file di libreria ed elenca i suoi materiali e aspetti, senza modificare il progetto. Usalo per vedere cosa contiene una libreria prima di applicarla.","help.licences":"Licenze","help.material.assign":"Imposta di che cosa sono fatti i corpi selezionati, per esempio acciaio, alluminio o ABS. Usalo perché massa e peso corrispondano al pezzo reale.","help.material.properties.validate":"Controlla la coerenza dei numeri e i valori mancanti in una scheda dati di un materiale. Usalo prima di affidarti ai dati per massa o rigidità.","help.mesh.convert":"Ricostruisce un corpo a mesh, come un STL, come solido modificabile con facce piane e cilindriche. Usalo per modificare parti meccaniche importate come un corpo modellato.","help.mit":"Licenza MIT","help.motion.study":"Imposta i valori dei giunti a intervalli lungo una sequenza temporale e li riproduce come animazione. Usalo per osservare un meccanismo muoversi in una sequenza e controllare le distanze libere lungo il percorso.","help.motion.trace":"Traccia il percorso seguito da un punto di una parte mentre uno studio del movimento viene riprodotto o un giunto viene azionato, e lo conserva come curva di schizzo 3D quando confermi. Usalo per vedere dove arriva un meccanismo, o per costruire a partire dal suo percorso.","help.notice":"NOTICE","help.occurrence.ground":"Fissa una parte al suo posto, o la libera di nuovo, in modo che i giunti muovano le altre parti attorno a essa. Usalo per il telaio o la base su cui è costruito il resto dell'assieme.","help.occurrence.move":"Sposta una parte dell'assieme solo lungo i gradi di libertà consentiti dai suoi giunti. Seleziona una faccia della parte, poi trascina una freccia o un arco disponibile.","help.parameters.change":"Apre la tabella dei valori con nome e delle espressioni che guidano le quote della progettazione. Usala per cambiare una misura in un solo punto e far seguire tutte le lavorazioni che la usano.","help.parameters.export":"Salva i parametri del progetto come CSV o JSON. Usalo per modificarli in un foglio di calcolo o spostarli in un altro progetto.","help.parameters.graph":"Mostra quali parametri e lavorazioni ne usano altri, ed eventuali cicli o errori tra di loro. Usalo per vedere cosa influenzerà la modifica di un parametro.","help.parameters.import":"Legge i parametri da CSV o JSON nel progetto, tutti o nessuno. Usalo per importare valori da un foglio di calcolo o da un altro progetto.","help.parameters.move":"Sposta un parametro utente prima o dopo un altro nell'elenco. Usalo per tenere insieme i parametri correlati.","help.parts.fastener":"Aggiunge una vite, un bullone, un dado, una rondella, un perno o un cuscinetto standard della misura che scegli. Posizionato su un foro, si assesta nel foro con un giunto, così non devi modellare da solo gli elementi di fissaggio.","help.parts.insert":"Inserisce una parte standard della famiglia, misura e lunghezza che scegli. Posizionata sul bordo o sulla parete di un foro, si assesta sul foro con un giunto rigido.","help.parts.library":"Apre le parti standard: viti, bulloni, dadi, rondelle, grani, spine cilindriche e cuscinetti nelle misure standard. Usalo per aggiungere una parte standard invece di modellarla da solo.","help.parts.resize":"Cambia la misura o la lunghezza di una parte standard inserita e la ricostruisce; i suoi giunti la mantengono in sede. Usalo quando una vite risulta troppo lunga o un foro richiede un'altra misura.","help.plastic.assign_rule":"Assegna una regola per plastica ai corpi, così le loro lavorazioni in plastica ne usano come valori predefiniti lo sformo e il gioco. Usalo per impostare una sola volta un pezzo stampato per tutte le sue lavorazioni.","help.plastic.boss":"Aggiunge un risalto per vite su una faccia: un montante con foro, sformo, raccordo di base e nervature di sostegno facoltativi. Usalo per i punti di avvitamento in involucri stampati o stampati in 3D.","help.plastic.lip":"Aggiunge un labbro o una scanalatura corrispondente lungo il bordo di un corpo svuotato. Usalo perché due metà di un involucro si centrino tra loro e chiudano bene.","help.plastic.manage_rules":"Crea e modifica le regole per plastica: materiale, spessore della parete, raggi, gioco e sformo. Usale per mantenere coerenti le lavorazioni di un pezzo stampato.","help.plastic.rest":"Aggiunge un appoggio su una faccia: un tampone tondo o rettangolare, pieno o cavo, con sformo. Usalo come supporto o distanziale in un involucro stampato.","help.plastic.snap_fit":"Aggiunge un gancio a scatto su una faccia, con lunghezza, spessore e dente di aggancio. Usalo per fissare a scatto le parti senza viti.","help.pointcloud.insert":"Inserisci una scansione PLY, XYZ o PTS come nuvola di punti accanto al modello. Usala come riferimento quando costruisci un modello a partire da dati misurati.","help.sheet.convert":"Trasforma una piastra o un corpo svuotato di spessore uniforme in un corpo in lamiera, con pieghe sugli spigoli che scegli. Usalo per rendere sviluppabile un pezzo esistente.","help.sheet.export_bend_table":"Salva la tabella delle pieghe di un corpo in lamiera come CSV o JSON: angoli, raggi e posizioni delle pieghe nello sviluppo piano. Usalo per la pressopiegatrice o per l'officina.","help.sheet.export_dxf":"Salva lo sviluppo piano come DXF, con contorni, linee di piega e note di piega facoltative. Usalo per il taglio laser, al plasma o a getto d'acqua.","help.sheet.flange":"Aggiunge una flangia: una piastra di base da uno schizzo, una parete lungo un contorno aperto dello schizzo o una parete piegata sugli spigoli della lamiera. Usalo per costruire pezzi in lamiera.","help.sheet.flat_pattern":"Crea lo sviluppo piano di un corpo in lamiera, con dimensioni, tagli e linee di piega. Usalo per controllare il grezzo prima di tagliarlo.","help.sheet.fold":"Piega una lamiera lungo una linea dello schizzo con un angolo e un raggio. Usalo per piegare una lamiera piana dopo avervi praticato i tagli.","help.sheet.hem":"Ripiega su se stesso il bordo di una lamiera. Usalo per bordi sicuri e rigidi, senza bave taglienti.","help.sheet.manage_rules":"Crea e modifica le regole per lamiera: spessore, raggio di piega, fattore K, scarichi e giochi. Usale per adattarle al materiale e agli utensili della tua officina.","help.sheet.path_flange":"Aggiunge una catena di flange lungo uno spigolo della lamiera, seguendo una catena aperta di linee dello schizzo. Usalo per profili a U o a Z in un solo passo.","help.sheet.perforate":"Aggiunge un campo di fori su tutta la lamiera piana, con disposizione sfalsata o quadrata. Usalo per prese d'aria, griglie e pannelli più leggeri.","help.sheet.refold":"Ripiega un corpo in lamiera sviluppato. Usalo dopo aver aggiunto lavorazioni alla lamiera piana.","help.sheet.unfold":"Spiega tutte le pieghe di un corpo in lamiera. Usalo per aggiungere fori o tagli che devono attraversare una piega, poi ripiega.","help.sketch.arc.center_point":"Disegna un arco di cerchio attorno a un punto centrale, da un punto iniziale a un punto finale. Usalo quando il centro dell'arco è noto, ad esempio un raggio attorno a un foro o a un perno.","help.sketch.arc.tangent":"Disegna un arco che parte dall'estremità di una linea o di un arco e prosegue tangente a essa. Usalo per continuare una catena con una curva dolce invece di un angolo vivo.","help.sketch.arc.three_point":"Disegna un arco da un punto iniziale a un punto finale passando per un terzo punto. Usalo quando l'arco deve passare per punti dati invece che attorno a un centro noto.","help.sketch.arc3d":"Disegna un arco di cerchio esatto nello spazio passante per tre punti, con Schizzo 3D attivo. Usalo per le curve di percorsi e guide che escono dal piano dello schizzo.","help.sketch.auto_constrain":"Aggiunge i vincoli che lo schizzo ha già quasi, come orizzontale, parallelo o coincidente, poi lo quota finché non è completamente definito. Usalo per bloccare in un solo passo uno schizzo disegnato a mano libera.","help.sketch.auto_constrain_from_datum":"Funziona come Vincola automaticamente, ma misura le posizioni da un punto di riferimento scelto invece che dall'origine. Usalo quando il pezzo è impostato a partire da un unico punto di riferimento, come un angolo o un foro.","help.sketch.blend_curve":"Unisce le estremità di due curve con una spline dolce tangente a entrambe, o anche continua in curvatura se lo scegli. Usalo per colmare un vuoto tra curve senza angoli vivi.","help.sketch.break":"Divide una curva in parti dove la attraversano altre curve, oppure nei punti che vi collochi. Usalo quando una parte di una curva ha bisogno di un proprio vincolo o deve essere eliminata da sola.","help.sketch.cancel":"Esce dallo schizzo e scarta tutto ciò che è stato modificato da quando è stato creato o aperto per la modifica. Le modifiche si recuperano con Annulla.","help.sketch.centerline":"Alterna le linee tra linee normali e linee d'asse, assi che i profili non includono. Usa una linea d'asse come asse per una rivoluzione, una specchiatura o un vincolo di simmetria.","help.sketch.chamfer.distance_angle":"Smussa l'angolo tra due linee, definito da una distanza lungo la prima linea e da un angolo. Usalo quando un disegno indica lo smusso come lunghezza e angolo, ad esempio 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Smussa l'angolo tra due linee alla stessa distanza lungo entrambe. Usalo per il normale smusso a 45° su un contorno.","help.sketch.chamfer.two_distance":"Smussa l'angolo tra due linee, definito da una distanza separata lungo ciascuna linea. Usalo per smussi diversi da 45°, indicati con due lunghezze.","help.sketch.circle.center":"Disegna un cerchio a partire dal centro e dal diametro. Usalo per fori, risalti e altre lavorazioni tonde il cui centro è noto.","help.sketch.circle.three_point":"Disegna un cerchio passante per tre punti. Usalo quando il cerchio deve passare per punti dati, ad esempio di una geometria esistente.","help.sketch.circle.three_tangent":"Disegna un cerchio tangente a tre linee, cerchi o archi. Usalo per inserire un cerchio nello spazio tra tre curve, come il cerchio inscritto di un triangolo.","help.sketch.circle.two_point":"Disegna un cerchio a partire dai due estremi del suo diametro. Usalo quando sono noti i punti del bordo del cerchio invece del centro.","help.sketch.circle.two_tangent":"Disegna un cerchio di dimensione data tangente a due linee, cerchi o archi. Usalo per un arrotondamento a raggio fisso tra due curve.","help.sketch.conic":"Disegna una curva conica tra due punti finali, definita da un punto di vertice e da un valore rho. Usalo per transizioni dolci di cui vuoi regolare la pienezza, da piatta a quasi un angolo vivo.","help.sketch.constrainer":"Applica il vincolo che una o due curve selezionate hanno già quasi, come orizzontale, parallelo, tangente o uguale. Usalo per mettere in ordine uno schizzo disegnato a mano, un vincolo alla volta.","help.sketch.constraint.coincident":"Fa giacere un punto su un altro punto, una curva o un asse dello schizzo. Usalo per chiudere i vuoti in un profilo o per mettere un punto su una linea.","help.sketch.constraint.collinear":"Fa giacere due linee sulla stessa retta. Usalo per allineare bordi interrotti, come i due lati di un intaglio.","help.sketch.constraint.concentric":"Dà lo stesso centro a due cerchi o archi. Usalo per anelli, lamature e alberi con spallamenti.","help.sketch.constraint.curvature":"Fa proseguire con la stessa curvatura (G2) due curve che si incontrano in un punto finale. Usalo dove un raccordo tangente non è abbastanza dolce, ad esempio sulle superfici in vista.","help.sketch.constraint.equal":"Rende uguali in lunghezza le linee, o uguali in raggio cerchi e archi. Usalo perché una sola quota governi più elementi corrispondenti.","help.sketch.constraint.fix":"Fissa punti o curve dove si trovano, oppure li libera di nuovo. Usalo per la geometria che non deve muoversi quando trascini o risolvi lo schizzo.","help.sketch.constraint.horizontal_vertical":"Rende orizzontale o verticale, a seconda di quale è più vicino, una linea o la linea tra due punti. Usalo per squadrare un contorno rispetto agli assi dello schizzo.","help.sketch.constraint.midpoint":"Mette un punto a metà di una linea, oppure fa coincidere i punti medi di due linee. Usalo per centrare la geometria su un bordo.","help.sketch.constraint.parallel":"Rende parallele due linee. Usalo per i lati che devono restare paralleli quando cambiano altre quote.","help.sketch.constraint.perpendicular":"Fa incontrare due linee ad angolo retto. Usalo per angoli retti tra linee che non sono sugli assi dello schizzo.","help.sketch.constraint.polygon":"Rende poligono regolare una catena chiusa di linee: lati uguali, con ogni vertice su un unico cerchio. Usalo per rendere regolare un poligono disegnato a mano e mantenerlo tale.","help.sketch.constraint.symmetry":"Rende due punti o curve speculari tra loro rispetto a una linea o a un punto. Usalo per mantenere simmetrico un profilo quando modifichi un lato.","help.sketch.constraint.tangent":"Fa toccare tangenzialmente due curve, come una linea e un arco. Usalo per raccordi dolci senza angoli vivi.","help.sketch.construction":"Alterna le curve tra geometria normale e geometria di costruzione, che i profili non includono. Usa le curve di costruzione come ausilio per l'impostazione, i riferimenti e le quote.","help.sketch.construction_line":"Crea una retta di costruzione infinita passante per due punti. Usala per impostare uno schizzo senza dividere i profili.","help.sketch.construction_line.angle":"Crea una retta di costruzione infinita con un angolo rispetto all'asse X dello schizzo. Seleziona il punto e digita l'angolo, oppure scegli la direzione.","help.sketch.construction_line.bisector":"Seleziona due linee rette dello schizzo che si intersecano, poi scegli una delle due bisettrici. Il risultato segue le linee di origine.","help.sketch.construction_line.horizontal":"Crea una retta di costruzione orizzontale infinita passante per un punto. Il suo vincolo orizzontale resta valido anche nelle modifiche successive.","help.sketch.construction_line.parallel":"Seleziona una linea retta dello schizzo, poi posiziona una retta di costruzione infinita parallela. Fai clic destro per scegliere un altro riferimento.","help.sketch.construction_line.perpendicular":"Seleziona una linea retta dello schizzo, poi posiziona una retta di costruzione infinita perpendicolare. Fai clic destro per scegliere un altro riferimento.","help.sketch.construction_line.tangent_at":"Crea una tangente in un punto di un cerchio o di un arco di cerchio, oppure in un estremo di una spline aperta o di una conica. Seleziona la curva, poi il suo punto di contatto.","help.sketch.construction_line.tangent_external":"Seleziona un cerchio o un arco di cerchio, poi un punto esterno e una soluzione di tangente. Le anteprime mostrano solo i contatti sull'arco disegnato.","help.sketch.construction_line.tangent_two":"Seleziona due cerchi o archi di cerchio, poi scegli una tangente comune nell'anteprima. I contatti devono trovarsi sulle curve disegnate.","help.sketch.construction_line.vertical":"Crea una retta di costruzione verticale infinita passante per un punto. Il suo vincolo verticale resta valido anche nelle modifiche successive.","help.sketch.copy":"Copia le curve e i punti dello schizzo selezionati, insieme ai vincoli e alle quote tra di essi. Incollali in questo schizzo o in un altro.","help.sketch.create":"Avvia un nuovo schizzo 2D su un piano o su una faccia piana del modello. Ogni estrusione, rivoluzione e sweep inizia con uno schizzo.","help.sketch.cut":"Copia la geometria dello schizzo selezionata e la elimina dallo schizzo, in un solo passo di annullamento. Incollala altrove in questo schizzo o in un altro.","help.sketch.dimension":"Aggiunge una quota di controllo: una lunghezza, una distanza, un angolo, un raggio o un diametro, a seconda di ciò che selezioni. Digita un valore o il nome di un parametro e lo schizzo lo segue.","help.sketch.edit":"Apre uno schizzo esistente per la modifica. Le lavorazioni costruite su di esso si aggiornano quando termini lo schizzo.","help.sketch.ellipse":"Disegna un'ellisse a partire dal centro, dall'estremità del suo asse maggiore e da un punto sul lato minore. Usalo per aperture ovali, camme e altre forme tonde allungate.","help.sketch.equation_curve":"Disegna una curva da formule: x(t) e y(t), oppure y = f(x), su un intervallo. Le formule possono usare parametri e la curva li segue: usala per un'onda sinusoidale, una spirale o l'evolvente del dente di un ingranaggio.","help.sketch.extend":"Allunga una linea o un arco fino alla curva più vicina sul suo percorso, oppure estende due curve finché non si incontrano. Usalo per chiudere i vuoti in un profilo dopo un ritaglio o una modifica.","help.sketch.fillet":"Arrotonda con un arco di raggio dato l'angolo in cui si incontrano due linee o archi. Più angoli arrotondati insieme condividono lo stesso raggio.","help.sketch.finish":"Esce dallo schizzo e torna al modello. I suoi profili chiusi sono poi pronti per Estrusione, Rivoluzione e altre lavorazioni.","help.sketch.finish_auto_constrain":"Esegue Vincola automaticamente sullo schizzo, poi lo termina. Usalo per lasciare uno schizzo completamente definito in un solo passo.","help.sketch.fit_curves_to_section":"Taglia un corpo a mesh o solido con il piano dello schizzo e adatta linee e archi alla sezione. Usalo per ricostruire come schizzo modificabile un pezzo scansionato o importato.","help.sketch.include_3d":"Porta in questo schizzo spigoli e vertici del modello e curve di altri schizzi come riferimenti collegati, appiattendo su di esso quelli fuori dal suo piano. Usalo per costruire su una geometria che non giace sul piano dello schizzo.","help.sketch.infinite":"Alterna le linee tra linee normali e rette di costruzione infinite che attraversano tutta la vista. Usale come riferimenti di impostazione che non finiscono mai troppo presto.","help.sketch.insert_dxf":"Legge le curve di un disegno DXF in uno schizzo, scalate, ruotate e posizionate come imposti. Usalo per costruire a partire da un disegno 2D di un altro programma, come un contorno da tagliare al laser.","help.sketch.insert_svg":"Legge i tracciati di un disegno SVG in uno schizzo, scalati, ruotati e posizionati come imposti. Usalo per trasformare un logo o un contorno vettoriale in curve che puoi estrudere.","help.sketch.inspect":"Apre un rapporto sullo schizzo aperto: quanti gradi di libertà restano e se è completamente vincolato. Usalo per scoprire cosa si muove ancora prima di terminare lo schizzo.","help.sketch.intersect":"Aggiunge le curve o i punti in cui corpi, facce, spigoli o altri schizzi attraversano il piano dello schizzo. Restano collegati e seguono il modello quando cambia.","help.sketch.intersection_curve":"Crea curve 3D dove si incontrano due corpi o facce, collegate a essi. Usale come percorsi o guide che seguono il modello.","help.sketch.isoparametric_curve":"Crea una curva 3D lungo la direzione U o V di una faccia passante per un punto che scegli, collegata alla faccia. Usala come percorso o linea di divisione che segue la superficie.","help.sketch.line":"Disegna linee collegate punto per punto, come catena aperta o contorno chiuso. È lo strumento di base per la maggior parte dei profili.","help.sketch.line.midpoint":"Disegna una linea dal suo punto medio fino a un'estremità, con l'altra estremità speculare. Usalo per linee centrate su un punto, come un bordo simmetrico.","help.sketch.line3d":"Disegna linee rette collegate tra punti nello spazio, con Schizzo 3D attivo. Usalo per percorsi e telai che escono dal piano dello schizzo.","help.sketch.mirror":"Specchia curve e punti dello schizzo rispetto a una linea o a un asse e aggiunge vincoli di simmetria. Usalo per disegnare metà di un profilo simmetrico e completarlo.","help.sketch.move":"Sposta o ruota curve e punti dello schizzo, oppure una loro copia. Usalo per riposizionare la geometria mantenendone forma e vincoli.","help.sketch.offset":"Crea una copia di una catena di curve a una distanza stabilita, su un lato o su entrambi. Usalo per pareti, contorni e giochi; la distanza resta una quota modificabile.","help.sketch.paste":"Incolla nello schizzo attivo la geometria dello schizzo che hai copiato o tagliato. Posizionala in un punto o spostala di uno scostamento.","help.sketch.pattern.circular":"Copia la geometria dello schizzo attorno a un punto centrale, su un cerchio completo o su un angolo stabilito. Usalo per cerchi di bulloni, raggi e denti.","help.sketch.pattern.rectangular":"Copia la geometria dello schizzo in righe e colonne con spaziature stabilite. Usalo per griglie di fori, asole o prese d'aria.","help.sketch.point":"Colloca un punto dello schizzo. Usalo come riferimento per quote, vincoli, centri di fori o lavorazioni successive.","help.sketch.point3d":"Colloca un punto nello spazio, con Schizzo 3D attivo. Usalo come riferimento per curve e percorsi 3D.","help.sketch.polygon.circumscribed":"Disegna un poligono regolare attorno a un cerchio, dimensionato dal centro al punto medio di un lato. Usalo quando è nota l'apertura chiave, come per un dado esagonale.","help.sketch.polygon.edge":"Disegna un poligono regolare a partire dai due estremi di un lato. Usalo quando sono note la lunghezza e la posizione di un lato.","help.sketch.polygon.inscribed":"Disegna un poligono regolare dentro un cerchio, dimensionato dal centro a un vertice. Usalo quando è nota la dimensione tra i vertici opposti.","help.sketch.project":"Porta in questo schizzo spigoli, facce e vertici del modello e curve di altri schizzi, proiettati sul suo piano. Restano collegati e seguono il modello quando cambia.","help.sketch.project_to_surface":"Proietta le curve di altri schizzi lungo la normale di questo schizzo su una faccia, come curve 3D collegate. Usalo per applicare un logo, una linea di divisione o un percorso su una superficie curva.","help.sketch.rectangle.center":"Disegna un rettangolo a partire dal centro e da un angolo. Usalo per contorni centrati su un punto, come l'origine.","help.sketch.rectangle.rounded":"Disegna un rettangolo con tutti e quattro gli angoli arrotondati con lo stesso raggio. Usalo per piastre, coperchi e aperture con angoli arrotondati.","help.sketch.rectangle.three_point":"Disegna un rettangolo a partire da un lato e da un punto sul lato opposto. Usalo per rettangoli inclinati rispetto agli assi dello schizzo.","help.sketch.rectangle.two_point":"Disegna un rettangolo a partire da due angoli opposti. Usalo per i contorni di piastre, blocchi e tasche.","help.sketch.scale":"Scala curve e punti dello schizzo di un fattore rispetto a un punto base. Usalo per ridimensionare una parte di uno schizzo senza ridisegnarla.","help.sketch.slot.arc_center":"Disegna un'asola curva di larghezza data lungo un arco definito da centro, inizio e fine. Usalo per asole di regolazione attorno a un perno.","help.sketch.slot.arc_three_point":"Disegna un'asola curva di larghezza data lungo un arco passante per tre punti. Usalo quando il percorso dell'asola deve passare per punti dati.","help.sketch.slot.center_point":"Disegna un'asola retta di larghezza data dal suo centro al centro di un arco di estremità. Usalo per asole centrate su un punto.","help.sketch.slot.center_to_center":"Disegna un'asola retta di larghezza data tra i centri dei suoi due archi di estremità. Usalo per asole quotate per interasse, come le asole di regolazione per viti.","help.sketch.slot.overall":"Disegna un'asola retta di larghezza data da un'estremità esterna all'altra. Usalo quando conta la lunghezza complessiva dell'asola.","help.sketch.spline.control_point":"Disegna una spline cubica modellata da punti di controllo per i quali non passa. Usalo per curve dolci e fluide che modelli spostando i punti.","help.sketch.spline.control_point_5":"Disegna una spline di grado 5 modellata da punti di controllo. Usalo dove le curve devono raccordarsi con una curvatura più dolce, ad esempio su superfici di design in vista.","help.sketch.spline.fit_point":"Disegna una spline dolce che passa per ogni punto che collochi, aperta o chiusa. Usalo per tracciare una forma attraverso punti noti.","help.sketch.spline3d":"Disegna una curva dolce nello spazio passante per dei punti, con Schizzo 3D attivo. Usalo per percorsi di sweep e tracciati di cavi che escono dal piano dello schizzo.","help.sketch.spun_profile":"Crea nel piano dello schizzo il contorno descritto da un corpo quando ruota attorno a un asse. Usalo per ottenere la silhouette di un pezzo tornito per una rivoluzione o un disegno.","help.sketch.text":"Scrive del testo nello schizzo con il carattere, l'altezza e l'angolo scelti; le sue parole possono seguire i parametri. Estrudilo o mettilo in rilievo per etichette e scritte.","help.sketch.transform":"Scala, ruota e sposta la geometria dello schizzo rispetto a un punto centrale in un solo passo. Usalo per riposizionare e ridimensionare una selezione in una volta.","help.sketch.trim":"Rimuove il tratto di una curva compreso tra gli incroci più vicini attorno al punto in cui fai clic. Usalo per ripulire linee sovrapposte e ottenere un profilo chiuso.","help.solid.align":"Sposta i corpi selezionati in modo che un punto, una faccia o un piano su di essi coincida con un punto, una faccia o un piano altrove. Usalo per posizionare un pezzo contro un altro senza misurare lo scostamento.","help.solid.boundary_fill":"Crea solidi dalle regioni racchiuse da corpi utensile sovrapposti, riempiendo solo le regioni che scegli. Usalo per costruire una forma dallo spazio delimitato insieme da più corpi.","help.solid.bounding_solid":"Crea un parallelepipedo che racchiude i corpi selezionati, con un margine facoltativo. Usalo per vedere l'ingombro complessivo di un pezzo, o come grezzo da cui viene lavorato.","help.solid.box":"Crea un parallelepipedo da lunghezza, larghezza e altezza, a partire da un angolo o centrato su un punto. Usalo per un blocco veloce, un segnaposto o un corpo in cui ricavare lavorazioni.","help.solid.chamfer":"Taglia gli spigoli selezionati con uno smusso piano della distanza impostata. Usalo per eliminare gli spigoli vivi o per facilitare l'ingresso di un perno o di una vite.","help.solid.coil":"Crea un corpo elicoidale, come una molla, da un diametro, dal numero di spire, dall'altezza o dal passo e da una sezione tonda o quadrata. Usalo per molle, eliche e creste elicoidali.","help.solid.combine":"Unisce i corpi, li sottrae da un corpo di destinazione oppure tiene solo il volume che hanno in comune, e può conservare i corpi utensile. Usalo per fondere parti, per tagliare una forma con un'altra o per trovare dove due corpi si sovrappongono.","help.solid.cone":"Crea un cono da un cerchio di base e un'altezza, oppure un tronco di cono se anche la sommità ha un raggio. Usalo per rastremazioni, imbuti, svasature e punte.","help.solid.cylinder":"Crea un cilindro da un raggio o un diametro e un'altezza, poggiato su un punto lungo un asse. Usalo per alberi, perni, risalti e grezzi tondi.","help.solid.draft":"Dà uno sformo alle facce selezionate con l'angolo impostato, misurato da un piano neutro. Usalo su pezzi stampati o fusi perché escano dallo stampo.","help.solid.emboss":"Solleva da una faccia i profili dello schizzo, come un testo o un logo, oppure li incide al suo interno. Usalo per scritte, etichette e marcature su facce piane o tonde.","help.solid.extrude":"Spinge il profilo di uno schizzo nel 3D lungo una distanza, aggiungendo o togliendo materiale. Usalo per trasformare un contorno piatto in un blocco, una sporgenza o una tasca.","help.solid.fillet":"Arrotonda gli spigoli selezionati con un raccordo circolare liscio del raggio impostato. Usalo per addolcire gli spigoli vivi per resistenza, comodità o estetica.","help.solid.hole":"Crea un foro tondo del diametro impostato in un punto scelto di una faccia. Usalo per i passaggi delle viti, i perni e altre semplici aperture tonde.","help.solid.loft":"Crea un solido continuo tra due o più profili di schizzo, oppure da un profilo a un punto. Usalo per transizioni, imbuti, maniglie e qualsiasi forma la cui sezione cambia lungo la lunghezza.","help.solid.mirror":"Crea una copia speculare dei corpi o delle lavorazioni selezionati rispetto a un piano e può unirla all'originale. Usalo per pezzi simmetrici: modelli una metà e ottieni entrambe.","help.solid.move":"Sposta o ruota i corpi selezionati, o una loro copia, della distanza e dell'angolo impostati. Usalo per riposizionare un corpo o per crearne un secondo in un altro punto.","help.solid.offset_face":"Spinge le facce selezionate verso l'interno o l'esterno della distanza impostata e le facce intorno le seguono. Usalo per ispessire una parete, approfondire una tasca o alzare una sporgenza senza modificare lo schizzo.","help.solid.pattern.circular":"Ripete gli oggetti selezionati intorno a un asse, per il numero e l'angolo totale impostati. Usalo per cerchi di bulloni, raggi, alette e denti.","help.solid.pattern.path":"Copia lavorazioni o corpi lungo un percorso dello schizzo, per numero e spaziatura. Usalo per fori lungo uno spigolo curvo o parti lungo una guida.","help.solid.pattern.rectangular":"Ripete gli oggetti selezionati in una o due direzioni con il numero e la spaziatura impostati. Usalo per file e griglie di fori, nervature, perni o piedini.","help.solid.pipe":"Crea un tubo tondo lungo un percorso di curve dello schizzo, pieno o cavo con uno spessore di parete. Usalo per tubi, fili, cavi e guide.","help.solid.press_pull":"Aggiunge o toglie materiale mentre trascini una faccia, oppure arrotonda gli spigoli mentre li trascini. Usalo per modifiche rapide direttamente sul modello.","help.solid.remove":"Toglie i corpi selezionati dalla progettazione da questo punto della cronologia in poi; i passaggi precedenti li mantengono. Usalo per scartare un corpo ausiliario, come un utensile da taglio che non serve più.","help.solid.replace_face":"Porta le facce piane selezionate su un piano o su una faccia parallela, e il corpo cresce o si riduce per raggiungerlo. Usalo per portare una faccia a filo con un altro pezzo o con un piano di costruzione.","help.solid.revolve":"Fa ruotare il profilo di uno schizzo intorno a un asse per creare un solido rotondo. Usalo per alberi, manopole, ciotole e qualsiasi pezzo tondo attorno a una linea d'asse.","help.solid.rib":"Aggiunge una parete sottile lungo una curva aperta dello schizzo, estesa fino alle facce successive del corpo. Usalo per irrigidire pareti e angoli, ad esempio in pezzi stampati.","help.solid.scale":"Ingrandisce o rimpicciolisce i corpi selezionati di un fattore, uguale in ogni direzione oppure uno per asse. Usalo per ridimensionare una forma importata o per compensare il ritiro.","help.solid.shell":"Svuota un solido lasciando pareti dello spessore impostato e può aprire le facce che scegli. Usalo per scatole, coperchi e altri pezzi a parete sottile.","help.solid.sphere":"Crea una sfera da un raggio o un diametro attorno a un punto centrale. Usalo per palline, manopole ed estremità arrotondate.","help.solid.split_body":"Taglia un corpo in corpi separati con un piano, la faccia di un altro corpo o una linea dello schizzo. Usalo per ottenere pezzi che vengono stampati, lavorati o colorati separatamente.","help.solid.split_face":"Divide le facce selezionate lungo un piano, la faccia di un altro corpo o delle curve di schizzo, senza tagliare il corpo. Usalo per dare a una parte di una faccia il proprio sformo, colore o offset.","help.solid.sweep":"Trascina il profilo di uno schizzo lungo un percorso per creare un solido. Usalo per tubi, guide, maniglie e qualsiasi pezzo a sezione costante che segue una curva.","help.solid.thread":"Aggiunge una filettatura metrica ISO a una faccia cilindrica, come filettatura cosmetica o ricavata nel corpo. Usalo per bulloni, fori filettati e parti a vite stampate.","help.solid.torus":"Crea un anello da un raggio maggiore attorno al suo asse e un raggio minore per la sua sezione tonda. Usalo per O-ring, maniglie e perline tonde.","help.solid.web":"Aggiunge una parete sottile lungo ogni curva aperta dello schizzo, ciascuna estesa fino alle facce successive del corpo. Usalo per un reticolo di pareti di sostegno all'interno di involucri e vassoi.","help.surface.blend":"Crea una superficie che collega gli spigoli di due corpi, tangente o continua in curvatura a entrambi. Usalo per unire dolcemente due superfici attraverso un vuoto.","help.surface.boundary":"Crea una superficie che riempie un contorno chiuso di due-quattro curve dello schizzo, o una rete di curve. Usalo per pannelli a forma libera definiti dai loro bordi.","help.surface.extend":"Allunga una superficie oltre i suoi bordi, di una distanza o fino a un piano o a una faccia. Usalo per far sovrapporre le superfici prima di ritagliarle o cucirle.","help.surface.extrude":"Spinge curve o profili dello schizzo lungo una distanza fino a formare una superficie, solo pareti, senza chiusure. Usalo per pareti sottili e per utensili di taglio o di divisione.","help.surface.fair":"Regolarizza l'interno delle facce a forma libera mentre i loro bordi restano fermi. Usalo per eliminare gobbe e riflessi ondulati in una superficie.","help.surface.loft":"Crea una superficie che passa in ordine per due o più sezioni, senza chiusure. Usalo per gusci e transizioni tra forme diverse.","help.surface.match":"Ricostruisce il bordo di una superficie in modo che incontri il bordo di un altro corpo, con tangenza o curvatura corrispondenti. Usalo per chiudere dolcemente una giunzione tra due superfici.","help.surface.offset":"Crea una copia delle facce a una distanza lungo le loro normali, come nuovo corpo di superficie. Usalo per rivestimenti, giochi o l'altro lato di una parete.","help.surface.patch":"Riempie una regione dello schizzo o un anello chiuso di spigoli con una faccia, piana o dolcemente curva. Usalo per chiudere i fori in un corpo di superficie.","help.surface.reverse_normal":"Rovescia le facce di un corpo di superficie, in modo che il loro lato esterno sia rivolto dall'altra parte. Usalo prima di ispessire o cucire quando le facce sono rivolte verso l'interno.","help.surface.revolve":"Fa ruotare curve o profili dello schizzo attorno a un asse per ottenere una superficie, senza chiusure. Usalo per gusci rotondi come paralumi, ciotole e ugelli.","help.surface.ruled":"Crea una striscia di rette a partire da una catena di spigoli, lungo la normale o la tangente della faccia oppure ad angolo. Usalo per pareti con sformo, prolungamenti e superfici di divisione.","help.surface.stitch":"Cuce insieme i corpi di superficie lungo i loro spigoli condivisi, formando un solido quando si chiudono. Usalo per trasformare un insieme di superfici in un unico corpo.","help.surface.sweep":"Muove curve o profili dello schizzo lungo un percorso per ottenere una superficie, senza chiusure. Usalo per grondaie, rifiniture e altre forme sottili che seguono un percorso.","help.surface.thicken":"Dà uno spessore a un corpo di superficie, trasformandolo in un solido. Usalo per ottenere da superfici pezzi stampabili o lavorabili.","help.surface.trim":"Taglia una superficie con un piano, un'altra superficie o curve dello schizzo, e mantiene il lato che scegli. Usalo per dare forma alle superfici prima di cucirle.","help.surface.unstitch":"Separa le facce di un corpo in corpi di superficie indipendenti; un solido si scompone in superfici. Usalo per rielaborare singole facce di un corpo.","help.surface.untrim":"Rimuove i fori da una faccia, oppure riporta il suo contorno esterno ai limiti naturali della superficie. Usalo per recuperare la superficie intera dopo un ritaglio.","help.third_party":"Licenze di terze parti","help.timeline.compute_all":"Ricostruisce ogni lavorazione della cronologia dall'inizio. Usalo per aggiornare il modello e vedere quali lavorazioni falliscono.","help.timeline.delete":"Elimina le lavorazioni selezionate dalla cronologia; eliminando uno schizzo si eliminano anche le lavorazioni costruite su di esso. Usalo per togliere un passaggio che non serve più.","help.timeline.dependents":"Elenca le lavorazioni che verrebbero eliminate insieme a una lavorazione, e quelle che fallirebbero senza di essa. Usalo prima di eliminare o modificare una lavorazione.","help.timeline.play":"Riproduce le lavorazioni rimanenti una alla volta, con una pausa di mezzo secondo dopo ogni ricostruzione. Esegui di nuovo questo comando o premi Escape per arrestare; Vai alla fine salta subito alla fine.","help.view.apply":"Ruota la vista verso una direzione standard come frontale, dall'alto o isometrica, oppure verso una vista con nome salvata. Usalo per guardare il modello da un'angolazione fissa.","help.view.delete":"Elimina una vista con nome salvata. Il modello non viene modificato.","help.view.fit":"Esegue zoom e panoramica in modo che l'intero modello, o la selezione, riempia la vista. Usalo quando il modello è uscito dall'inquadratura.","help.view.grid":"Mostra o nasconde la griglia nella vista. Usala come guida per dimensioni e orientamento durante la modellazione.","help.view.ground_shadow":"Mostra o nasconde l'ombra del modello sul suolo. Usala per valutare più facilmente altezza e posizione.","help.view.home":"Riporta la vista alla direzione iniziale e inquadra tutto il modello. Usalo per tornare rapidamente a una vista nota.","help.view.list":"Elenca le viste con nome salvate nel progetto. Usalo per trovare una vista salvata in precedenza.","help.view.navigate":"Ruota, sposta o ingrandisce la vista a passi, come un quarto di giro a sinistra. Usalo per muovere la camera con precisione invece di trascinare.","help.view.navigation_bar":"Mostra o nasconde la barra di navigazione in basso nella vista. Nascondila per avere più spazio, mostrala per raggiungere con il mouse gli strumenti della vista.","help.view.rename":"Dà un nuovo nome a una vista con nome salvata. La vista in sé resta la stessa.","help.view.save":"Salva la posizione attuale della camera come vista con nome nel progetto. Usalo per tornare in seguito alla stessa angolazione, ad esempio per le schermate.","help.view.spin":"Fa orbitare la vista attorno al modello in modo continuo fino al clic o al tasto successivo. Usalo per presentare un modello da tutti i lati.","help.view.tool":"Mantiene attivo uno strumento della camera (orbita, panoramica o zoom), così trascinando con il pulsante sinistro del mouse si muove la vista finché non lo disattivi. Usalo su un trackpad o senza pulsante centrale del mouse.","help.view.visual_style":"Cambia il modo in cui il modello viene disegnato: ombreggiato con o senza spigoli, reticolo, oppure con gli spigoli nascosti. Usa il reticolo per vedere all'interno, l'ombreggiato per un aspetto pulito.","history.sketch_under_constrained":"Sottovincolato ({count} gradi di libertà)","history.sketch_under_constrained_one":"Sottovincolato ({count} grado di libertà)","hole_presets.confirm_delete":"Conferma eliminazione","hole_presets.delete":"Elimina","hole_presets.delete_prompt":"Eliminare questo preset personale? I fori esistenti restano invariati.","hole_presets.full":"La raccolta personale contiene già 64 preset.","hole_presets.invalid_name":"Inserisci un nome breve, senza a capo o caratteri di controllo.","hole_presets.invalid_parameters":"Completa i parametri del foro con espressioni valide e di lunghezza ragionevole.","hole_presets.missing":"Il preset selezionato non è più disponibile.","hole_presets.name":"Nome preset","hole_presets.name_exists":"Esiste già un preset con questo nome. Usa un nome diverso.","hole_presets.name_hint":"Un nome univoco","hole_presets.overwrite":"Salva le modifiche nel preset selezionato","hole_presets.preset":"Preset","hole_presets.recall":"Richiama","hole_presets.rename":"Rinomina","hole_presets.save":"Salva nuovo","hole_presets.scope":"Salvati nel tuo profilo per tutti i progetti.","hole_presets.select":"Seleziona un preset","hole_presets.title":"Preset personali","hole_presets.unsupported_options":"Questo preset usa opzioni del filetto che questa versione non può richiamare.","hole_presets.unsupported_overwrite":"Questo preset contiene opzioni che non possono essere sovrascritte in sicurezza.","home.back":"Torna a {name}","home.crashes":"Rapporti di arresto anomalo","home.design_workspace":"Progettazione","home.documentation":"Documentazione","home.export":"Esporta","home.export_hint":"Scegli un formato per il progetto attuale.","home.export_json_hint":"Progetto modificabile e cronologia dei comandi","home.export_mesh_hint":"Mesh per la stampa o la condivisione","home.export_step_hint":"Geometria solida precisa","home.import":"Importa…","home.import_hint":"STEP, IGES o mesh in un nuovo progetto","home.in_this_browser":"in questo browser","home.missing":"non presente","home.month_01":"gen","home.month_02":"feb","home.month_03":"mar","home.month_04":"apr","home.month_05":"mag","home.month_06":"giu","home.month_07":"lug","home.month_08":"ago","home.month_09":"set","home.month_10":"ott","home.month_11":"nov","home.month_12":"dic","home.new_inches":"Nuovo progetto in pollici","home.new_inches_hint":"Pollici · si apre in Progettazione","home.new_mm":"Nuovo progetto","home.new_mm_hint":"Millimetri · si apre in Progettazione","home.open":"Apri…","home.open_hint":"Un progetto .sc ({shortcut})","home.open_now":"Apri ora","home.opened_days_ago":"{count} giorni fa","home.opened_hours_ago":"{count} h fa","home.opened_just_now":"Adesso","home.opened_minutes_ago":"{count} min fa","home.opening":"apertura…","home.properties":"Proprietà del progetto","home.recent":"Recenti","home.recent_empty":"I progetti che apri o salvi vengono visualizzati qui.","home.recovery_count":"Progetti recuperabili: {count}","home.recovery_empty":"Nessun progetto recuperabile.","home.recovery_hint":"SolidCraft si è chiuso prima del salvataggio di questi progetti.","home.report_issue":"Segnala un problema","home.samples":"Esempi","home.settings":"Impostazioni","home.short_date":"{day} {month}","home.shortcuts":"Scorciatoie da tastiera","home.start_hint":"Crea un progetto, apri un file recente o esplora un esempio.","home.whats_new":"Novità","home.yesterday":"Ieri","install.button_tip":"Installa SolidCraft come applicazione: si apre in una finestra dedicata e funziona offline","install.dock_1":"Scegli File › Aggiungi al Dock.","install.dock_2":"Fai clic su Aggiungi.","install.dock_after":"SolidCraft si aprirà dal Dock in una finestra dedicata e funzionerà offline.","install.done":"Fine","install.home_screen_1":"Tocca Condividi (nel menu … se non è nella barra degli strumenti).","install.home_screen_2":"Scegli Aggiungi alla schermata Home.","install.home_screen_3":"Tocca Aggiungi.","install.home_screen_after":"SolidCraft si aprirà dalla sua icona nella schermata Home, senza le barre degli strumenti di Safari, e funzionerà offline.","install.menu":"Installa applicazione…","install.steps_intro":"Safari installa le applicazioni web dai propri menu:","install.title":"Installa SolidCraft","issue.body_label":"Testo della segnalazione","issue.note_changed_while_waiting":"Le impostazioni o il modello sono cambiati durante l'attesa dell'anteprima. Rifai la schermata per aggiornare i dettagli tecnici in base alla vista attuale.","issue.note_details_kept":"Schermata acquisita in locale. I dettagli tecnici che hai modificato sono stati mantenuti: controlla che corrispondano ancora alla vista attuale.","issue.note_details_updated":"Dettagli tecnici aggiornati in base alla vista attuale. Schermata acquisita in locale. Controllala prima di allegarla su GitHub.","issue.note_image_copied":"Incolla l'immagine nella bozza su GitHub, oppure salva il PNG se la copia dell'immagine non è disponibile.","issue.note_opened":"Rivedi la bozza su GitHub e allega la schermata. Il pulsante Submit new issue di GitHub la pubblica.","issue.note_opened_copied":"Segnalazione copiata. Incollala nella bozza su GitHub, allega la schermata, poi fai clic su Submit new issue su GitHub.","issue.note_removed":"Schermata rimossa da questa bozza.","issue.note_report_copied":"Segnalazione copiata. Incollala nella bozza su GitHub se necessario.","issue.note_save_failed":"Impossibile salvare la schermata: {error}","issue.note_saved":"Schermata salvata. Allega il PNG nella bozza su GitHub.","issue.save_screenshot":"Salva schermata…","joint.from_bodies_hint":"Ogni corpo selezionato viene spostato in un nuovo componente distinto, mantenendo la sua posizione.","joint.one_body":"Entrambe le selezioni sono su {body}. Seleziona il secondo elemento su un'altra parte.","joint.one_component":"Queste parti sono corpi di un unico componente: {bodies}. Un giunto muove un componente rispetto a un altro, quindi ogni parte richiede un componente distinto.","joint.rigid_group_one_component":"Questi {count} corpi sono tutti in un solo componente (o nella progettazione stessa): usa prima {command}.","joint.rigid_group_select_components":"Seleziona due o più componenti.","joint_move.blocked_hint":"Controlla il tipo di giunto (ad esempio Rigido), il fissaggio a terra, i limiti del giunto e i valori comandati da parametri.","joint_move.blocked_title":"Impossibile spostare questa parte","joint_move.coarse":"Passo di rotazione vicino all'asse (°)","joint_move.distance":"Distanza dall'inizio","joint_move.done":"Fatto","joint_move.fine":"Passo di rotazione lontano dall'asse (°)","joint_move.fixed":"Questa parte non ha alcun asse di giunto mobile.","joint_move.help":"Sposta — trascina una freccia o un anello. Esc annulla il trascinamento in corso.","joint_move.legacy_hint":"Disattiva per usare il pannello Sposta precedente.","joint_move.precision":"Trascina oltre la guida tratteggiata per una rotazione fine.","joint_move.rotation":"Rotazione dall'inizio","joint_move.select":"Seleziona una faccia o una parte dell'assieme, poi scegli Sposta.","joint_move.settings":"Spostamento nell'assieme","joint_move.step":"Passo","joint_move.use_handles":"Usa le maniglie di movimento dei giunti per Sposta nell'assieme","keymap.command_id":"ID comando","keymap.empty":"Nessun comando corrispondente","keymap.use_anyway":"Usa comunque {key} qui","label.move_to_left_side":"Sposta sul lato sinistro","label.move_to_right_side":"Sposta sul lato destro","manage.appearance_hint":"Scegli un aspetto per la selezione o trascina un campione su un corpo o una faccia.","manage.assign_hint":"Seleziona i corpi e scegli la loro regola di progettazione per parti in plastica.","manage.config_hint":"Modifica righe, colonne e regole di configurazione, poi attiva una riga o visualizzane l’anteprima.","manage.empty":"Nessuna riga corrispondente.","manage.material_hint":"Seleziona i corpi e scegli il loro materiale fisico.","manage.parameters_hint":"Modifica espressioni e unità. Le modifiche vengono applicate premendo Invio o uscendo da un campo.","manage.rules_hint":"Scegli una regola da modificare o creane una nuova. Conferma per salvare la regola.","material.editor.add_property":"Aggiungi proprietà","material.editor.add_source":"Aggiungi fonte","material.editor.assigned_density":"Densità assegnata","material.editor.axes":"Assi del materiale","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Copia di {name}","material.editor.density_range":"La densità assegnata deve essere maggiore di 0 e al massimo 1000 g/cm³.","material.editor.designation":"Designazione","material.editor.duplicate":"Duplica","material.editor.engineering_card":"Scheda delle proprietà tecniche","material.editor.family":"Famiglia di materiali","material.editor.glass":"Vetro","material.editor.illustrative":"Illustrativo","material.editor.invalid_property":"Tipo di proprietà non supportato.","material.editor.isotropic":"Isotropo","material.editor.measurement":"Misura","material.editor.metal":"Metallo","material.editor.moisture":"Umidità, base secca","material.editor.name_required":"Inserisci un nome di 1–128 caratteri.","material.editor.no_draft":"Nessuna bozza del materiale è aperta.","material.editor.number_required":"Inserisci un valore numerico finito.","material.editor.orthotropic":"Ortotropo","material.editor.other":"Altro","material.editor.polymer":"Polimero","material.editor.preserved_appearance":"Aspetto conservato","material.editor.public_reference":"Riferimento pubblico","material.editor.reference":"Riferimento","material.editor.save_or_discard":"Salva o scarta la bozza del materiale prima di assegnare un materiale.","material.editor.saved":"Materiale salvato. Le assegnazioni ai corpi non sono cambiate.","material.editor.scope":"Salva memorizza questo materiale senza assegnarlo ai corpi. Le proprietà e le condizioni lasciate vuote restano sconosciute. La densità della scheda non cambia la densità assegnata né la massa.","material.editor.source_id":"ID fonte","material.editor.source_kind":"Tipo di fonte","material.editor.source_title":"Titolo della fonte","material.editor.sources":"Fonti","material.editor.stale":"Questo materiale è cambiato mentre la bozza era aperta. Scartala e riaprila prima di salvare.","material.editor.state":"Stato del materiale","material.editor.strain_rate":"Velocità di deformazione","material.editor.symmetry":"Simmetria elastica","material.editor.temperature":"Temperatura","material.editor.unknown_card":"Le proprietà tecniche sono sconosciute. Salva può conservare solo la densità assegnata e l'aspetto esistente.","material.editor.user_supplied":"Fornito dall'utente","material.editor.wood":"Legno","material.selection.choose":"Scegli un materiale","material.selection.mixed":"Materiali diversi","measure.at":"In","measure.item":"Elemento {number}","measure.quick_copied":"Misura copiata","measure.quick_copy":"Fai clic per copiare la misura","measure.quick_edges":"{count} spigoli","measure.quick_faces":"{count} facce","messages.ago_h":"{n} h fa","messages.ago_min":"{n} min fa","messages.ago_s":"{n} s fa","messages.chip_hint":"Fai clic per tutti i messaggi di questa sessione","messages.clear":"Cancella","messages.copy_all":"Copia tutto","messages.menu":"Messaggi…","messages.none":"Ancora nessun messaggio.","messages.title":"Messaggi","motion.checked_to":"Controllato solo fino al passo {step}: il controllo ha esaurito il limite di calcolo","motion.collision":"{a} · {b}: passi {steps}","motion.delete_key":"Elimina fotogramma chiave","motion.duration_hint":"secondi (vuoto: per passo)","motion.key_here":"Inserisci fotogramma chiave qui","motion.key_here_hint":"Aggiungi un fotogramma chiave in questo passo con il valore attuale del giunto","motion.no_collisions":"Nessuna collisione durante lo studio","motion.plot_quantity":"Quantità","motion.step_back":"Passo indietro","motion.step_forward":"Passo avanti","motion.to_end":"Alla fine","motion.to_start":"All’inizio","motion.track_name":"Traccia {number}","nav.alias.help":"Shift+Alt+trascinamento sinistro orbita, Shift+Alt+centrale fa la panoramica, Shift+Alt+destro fa lo zoom; anche il trascinamento centrale fa la panoramica e il destro orbita","nav.blender.help":"Il trascinamento centrale orbita, Shift+centrale fa la panoramica, Ctrl+centrale fa lo zoom; il trascinamento destro lascia ferma la vista","nav.free_orbit.help":"Mouse e mouse 3D ruotano oltre entrambi i poli e conservano il rollio. L'aggancio degli assi con Shift è disattivato.","nav.free_orbit.label":"Orbita libera","nav.free_orbit.snap_help":"Mouse e mouse 3D ruotano oltre entrambi i poli e conservano il rollio. Tieni premuto Shift durante il trascinamento dell'orbita per agganciare la direzione della vista e il rollio.","nav.free_orbit_upright.help":"Il trascinamento laterale del mouse fa girare il modello attorno all'asse verticale del mondo; il trascinamento in alto e in basso lo inclina oltre la sommità senza limiti.","nav.free_orbit_upright.label":"Ruota attorno all'asse verticale","nav.fusion.help":"Il trascinamento centrale fa la panoramica, Shift+centrale orbita, il trascinamento destro orbita","nav.hfss.help":"Alt+trascinamento con il pulsante sinistro esegue la panoramica, Shift+Alt+pulsante sinistro lo zoom, Ctrl+trascinamento con il pulsante sinistro su uno spazio vuoto orbita","nav.inventor.help":"Il trascinamento centrale fa la panoramica, Shift+centrale orbita, Ctrl+centrale fa lo zoom, il trascinamento destro orbita","nav.maya.help":"Alt+trascinamento con il pulsante sinistro orbita, Alt+pulsante centrale esegue la panoramica, Alt+pulsante destro lo zoom; anche il trascinamento con il pulsante centrale esegue la panoramica","nav.openscad.help":"Il trascinamento sinistro nello spazio vuoto orbita, Shift+trascinamento sinistro seleziona con un riquadro, il trascinamento sulla geometria dello schizzo la modifica; il trascinamento destro o centrale fa la panoramica, Shift+destro o Shift+centrale fa lo zoom","nav.perspective.sketch":"La modifica dello schizzo usa la vista ortogonale. Termina lo schizzo per passare alla prospettiva.","nav.right_drag_orbits.help":"Disattivato: il trascinamento con il pulsante destro non muove la camera e il pulsante destro apre solo il menu contestuale. Scegliendo l'assegnazione del mouse SolidWorks l'opzione si disattiva.","nav.right_drag_orbits.label":"Orbita con il trascinamento destro","nav.solidworks.help":"Trascina con il tasto centrale per orbitare, Ctrl+centrale per la panoramica, Shift+centrale per lo zoom, trascina con il destro per orbitare","nav.tinkercad.help":"Trascina con il tasto destro per orbitare, con il centrale o Shift+destro per la panoramica","nav.touchpad.help":"Tieni premuto Shift e muovi il puntatore per eseguire una panoramica; tieni premuto Alt/Option e muovilo per orbitare. Non serve premere pulsanti del mouse. Lo scorrimento verticale regola lo zoom.","nav.touchpad.label":"Touchpad","nav.touchpad.orbit":"Orbita (tieni premuto Alt/Option e muovi il puntatore; senza pulsanti del mouse)","nav.touchpad.pan":"Panoramica (tieni premuto Shift e muovi il puntatore; senza pulsanti del mouse)","nav.touchpad.scroll":"Il touchpad usa lo scorrimento verticale per lo zoom. L'impostazione di panoramica a due dita viene conservata per le altre preimpostazioni.","nav.touchpad.zoom":"Zoom (scorrimento verticale o gesto di pizzicamento)","navbar.agent_chat":"Pannello chat dell'assistente","navbar.agent_cursor":"Mostra cursore dell'agente","navbar.ambient_occlusion":"Occlusione ambientale","navbar.assistant":"Assistente","navbar.custom.add_slot":"Aggiungi {slot}","navbar.custom.always":"Sempre visibile","navbar.custom.available":"{available} · trascina sulla barra o premi Aggiungi","navbar.custom.buttons":"Pulsanti","navbar.custom.compact":"Compatta","navbar.custom.count":"{count} di 16 elementi","navbar.custom.customise":"Personalizza barra di navigazione…","navbar.custom.design":"Progettazione","navbar.custom.duplicate":"Questo elemento è già sulla barra.","navbar.custom.edge":"Bordo","navbar.custom.edge_bottom":"In basso","navbar.custom.edge_top":"In alto","navbar.custom.fade":"Attenua","navbar.custom.full":"Rimuovi un elemento per aggiungerne un altro.","navbar.custom.hidden_design":"Nascosto in Progettazione","navbar.custom.hidden_render":"Nascosto in Rendering","navbar.custom.hide":"Nascondi barra di navigazione","navbar.custom.hide_idle":"Nascondi finché non ci passi sopra","navbar.custom.icon_only":"Solo icona","navbar.custom.icon_value":"Icona e valore","navbar.custom.icons":"Icone","navbar.custom.idle":"Quando inattiva","navbar.custom.intro":"Scegli i comandi della barra nella parte inferiore della vista 3D e il loro ordine. Trascina un elemento per spostarlo, oppure trascinalo fuori dalla barra per rimuoverlo.","navbar.custom.labels":"Icone ed etichette","navbar.custom.left":"Sposta a sinistra","navbar.custom.position":"Posizione","navbar.custom.position_centre":"Centro","navbar.custom.position_left":"Sinistra","navbar.custom.position_right":"Destra","navbar.custom.preview_as":"Anteprima come","navbar.custom.regular":"Normale","navbar.custom.remove":"Rimuovi","navbar.custom.remove_bar":"Rimuovi dalla barra","navbar.custom.render":"Rendering","navbar.custom.reset":"Reimposta barra di navigazione","navbar.custom.reset_default":"Reimposta ai valori predefiniti","navbar.custom.right":"Sposta a destra","navbar.custom.select":"Nessun elemento selezionato. Seleziona un elemento sulla barra per spostarlo, rimuoverlo o cambiarne l'aspetto.","navbar.custom.separators_full":"La barra ha già quattro separatori.","navbar.custom.show":"Mostra barra di navigazione","navbar.custom.shows":"Mostra","navbar.custom.size":"Dimensioni","navbar.custom.stale":"La barra è cambiata. Seleziona di nuovo l'elemento.","navbar.custom.title":"Barra di navigazione","navbar.custom.unknown":"Questo elemento non è disponibile.","navbar.description.ambient_occlusion":"Scurisce incavi e angoli per dare profondità.","navbar.description.display":"Raccoglie le impostazioni della vista: preimpostazione grafica, griglia, ombra sul piano di appoggio, occlusione ambientale e proiezione.","navbar.description.fit":"Inquadra la selezione o l'intero modello se non è selezionato nulla.","navbar.description.grid":"Mostra o nasconde la griglia di base.","navbar.description.ground_shadow":"Mostra o nasconde l'ombra sotto il modello.","navbar.description.home":"Torna alla vista isometrica dell'intero modello.","navbar.description.look_at":"Orienta la vista verso la faccia, il piano o lo schizzo aperto selezionato.","navbar.description.orbit":"Ruota la vista attorno al modello.","navbar.description.pan":"Sposta la vista lateralmente, in alto o in basso.","navbar.description.projection":"Passa dalla vista ortografica a quella prospettica.","navbar.description.separator":"Una linea sottile che raggruppa gli elementi vicini.","navbar.description.spin":"Mantiene la vista in rotazione finché non fai clic o premi un tasto.","navbar.description.visual_style":"Cambia il modo in cui è disegnato il modello: ombreggiato, reticolo o con spigoli nascosti.","navbar.description.zoom":"Avvicina o allontana la vista dal modello.","navbar.display":"Visualizzazione","navbar.fit":"Adatta","navbar.graphics":"Grafica","navbar.grid":"Griglia","navbar.ground_shadow":"Ombra sul piano di appoggio","navbar.home":"Inizio","navbar.later":"Più tardi","navbar.look_at":"Vista normale","navbar.more":"Altro","navbar.orbit":"Orbita","navbar.orthographic":"Ortografica","navbar.pan":"Panoramica","navbar.perspective":"Prospettica","navbar.preset":"Preimpostazione","navbar.projection":"Proiezione","navbar.projection_heading":"Proiezione","navbar.separator":"Separatore","navbar.show":"Mostra","navbar.spin":"Rotazione continua","navbar.style.shaded":"Ombreggiato","navbar.style.shaded_with_edges":"Ombreggiato con spigoli","navbar.style.shaded_with_hidden_edges":"Ombreggiato con spigoli nascosti","navbar.style.wireframe":"Reticolo","navbar.translucent":"Traslucido","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Stile visualizzazione","navbar.zoom":"Zoom","needs two joints":"richiede due giunti","network.allow_once":"Consenti una volta","network.always_allow":"Consenti sempre questo server","network.prompt_detail":"Questo progetto rimanda a un file nella posizione di rete {host}. Aprirlo collega a quel computer e potrebbe inviargli il tuo accesso a Windows. Consenti solo server di cui ti fidi.","network.prompt_title":"Posizione di rete","new configuration":"nuova configurazione","new parameter":"nuovo parametro","no hole":"nessun foro","no interference":"nessuna interferenza","no joint that moves yet":"nessun giunto mobile ancora presente","no motion study yet":"ancora nessuno studio del movimento","no picture":"nessuna immagine","no such joint":"giunto inesistente","none":"nessuno","not a move":"non è uno spostamento","not a number":"non è un numero","open a sketch first":"apri prima uno schizzo","parameters.apply_live":"Applica ogni modifica quando esci dal campo","parameters.apply_live_tip":"Disattivato: le modifiche restano in attesa fino ad Applica o OK, poi il progetto si ricostruisce una sola volta per tutte. Annulla o Escape le scarta.","parameters.held":"{count} modifiche in attesa di Applica","parameters.held_hint":"Modifica espressioni e unità. Le modifiche restano in attesa di Applica o OK.","parameters.held_one":"1 modifica in attesa di Applica","parts.automatic_name":"automatico","parts.dimension.across_flats":"Apertura chiave","parts.dimension.bore":"Foro","parts.dimension.d":"Diametro nominale","parts.dimension.head_diameter":"Diametro testa","parts.dimension.head_height":"Altezza testa","parts.dimension.height":"Altezza","parts.dimension.inner":"Diametro interno","parts.dimension.outer":"Diametro esterno","parts.dimension.pitch":"Passo","parts.dimension.socket":"Esagono incassato","parts.dimension.socket_depth":"Profondità esagono","parts.dimension.thickness":"Spessore","parts.dimension.width":"Larghezza","parts.family.bearing":"Cuscinetto radiale a sfere (ingombro)","parts.family.button_head_cap_screw":"Vite a testa bombata con esagono incassato","parts.family.dowel_pin":"Spina cilindrica","parts.family.hex_bolt":"Vite a testa esagonale","parts.family.hex_nut":"Dado esagonale","parts.family.set_screw":"Grano a esagono incassato, punta piana","parts.family.socket_head_cap_screw":"Vite a testa cilindrica con esagono incassato","parts.family.washer":"Rondella piana","parts.holes":"Fori (facoltativo)","parts.placement_hint":"scegli uno o più fori per alloggiare una parte in ciascuno, oppure OK la colloca nell'origine","pattern.alignment_2":"Allineamento 2","pattern.alignment_hint":"Il conteggio include l'originale. Centro distribuisce le copie sui due lati; Inverti sceglie il lato con la copia in più per totali pari.","pattern.direction_1":"Direzione 1","pattern.direction_2":"Direzione 2","pattern.flip_direction":"Inverti direzione","perf.click_for_details":"Fai clic per i dettagli: grafico dei tempi, istogramma e ciò che la GPU ha disegnato","perf.draw_calls":"Chiamate di disegno","perf.line_segments":"Segmenti","perf.low_1":"1% più lento","perf.renderer":"Renderer","perf.scene_build":"Costruzione scena","perf.triangles":"Triangoli","perf.ui_time":"Tempo UI","perf.viewport":"Vista","perf.worst":"peggiore","pick a body or some of its faces":"scegli un corpo o alcune delle sue facce","pick a hole to seat it, or OK places it at the origin":"seleziona un foro in cui inserirlo, oppure premi OK per posizionarlo nell'origine","pick a planar face":"scegli una faccia piana","pick a plane or a face as the tool":"scegli un piano o una faccia come strumento","pick a size":"scegli una dimensione","pick edges of a body":"scegli spigoli di un corpo","pick edges of one body":"scegli spigoli di un solo corpo","pick edges of the holes to remove":"scegli gli spigoli dei fori da rimuovere","pick faces of one body":"scegli facce di un solo corpo","pick faces to offset":"scegli le facce di cui creare l'offset","pick lines of one sketch":"scegli linee di un solo schizzo","pick one or two vertices, edges or faces":"seleziona uno o due vertici, spigoli o facce","pick one plane or face as the tool, or sketch curves":"scegli un piano o una faccia come strumento, oppure curve dello schizzo","pick sections in two or more sketches":"scegli sezioni in due o più schizzi","pick sketch curves or edges":"scegli curve dello schizzo o spigoli","pick the face to untrim":"scegli la faccia di cui annullare il ritaglio","pick the path":"scegli il percorso","pick what to keep":"scegli cosa tenere","pick what to keep of the other surface":"scegli cosa tenere dell'altra superficie","prefs.add_item":"Aggiungi l'elemento","prefs.alt_frees_manipulators":"Alt / Option libera anche le frecce del manipolatore","prefs.anti_aliasing_amd_dx12":"L'antialiasing usa 1× perché il controllo all'avvio non ha disegnato nulla con il multicampionamento ed è riuscito a 1×. Puoi scegliere un'altra impostazione qui sopra; riavvia per applicarla se il controllo riesce.","prefs.anti_aliasing_note":"Ammorbidisce i bordi seghettati.","prefs.applies_on_restart":"Si applica al riavvio","prefs.assistant":"Assistente","prefs.auto_operation":"Scegli l'operazione automaticamente","prefs.auto_operation_note":"Le finestre delle lavorazioni scelgono Unisci, Nuovo corpo o Taglia in base a ciò che tocca il nuovo materiale, finché non ne scegli una tu. Disattivato: mantengono l'operazione con cui si aprono.","prefs.axes":"Assi","prefs.axis":"Asse","prefs.bodies_folders":"Cartelle dei corpi","prefs.bodies_folders_always":"Sempre","prefs.bodies_folders_never":"Mai","prefs.bodies_folders_several":"Solo con più corpi","prefs.bottom":"In basso","prefs.bottom_centre":"In basso al centro","prefs.bottom_right":"In basso a destra","prefs.browser":"Struttura","prefs.browser_eye_left":"Occhio accanto alla freccia di espansione","prefs.browser_eye_left_note":"Le righe della Struttura mostrano l'occhio mostra/nascondi accanto alla freccia di espansione, come prima, invece che in una colonna all'estremità destra delle righe.","prefs.browser_reveal_on_hover":"Mostra al passaggio del puntatore","prefs.browser_show_note":"Visibile mantiene la Struttura sullo schermo. Mostra al passaggio del puntatore la tiene nascosta finché il puntatore non passa sulla sua posizione o sulla sottile linguetta al suo bordo sinistro, e resta aperta finché il puntatore è al suo interno o un suo menu è aperto.","prefs.browser_shown":"Visibile","prefs.built_in":"Integrato","prefs.button_left":"Trascinamento sinistro","prefs.button_middle":"Trascinamento centrale","prefs.button_right":"Trascinamento destro","prefs.choose_font":"Scegli il file del carattere…","prefs.click":"Clic","prefs.contact_shading":"Ombreggiatura di contatto morbida","prefs.contact_shading_note":"Ombreggiatura morbida dove le parti si avvicinano.","prefs.context_menu":"Menu contestuale","prefs.context_menu_ring":"Menu contestuale · tieni premuto per il menu radiale","prefs.cpu":"CPU (software)","prefs.crash_reports":"Apri i rapporti di arresto anomalo…","prefs.crash_reports_note":"I rapporti restano su questo computer, insieme al progetto e ai comandi che riproducono il problema.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Superfici curve","prefs.curves":"Superfici curve","prefs.dead_zone_note":"La fascia tratteggiata è la zona morta: il movimento al suo interno viene ignorato.","prefs.default":"predefinito","prefs.design":"Impostazioni predefinite del progetto","prefs.design_note":"Valori di partenza dei nuovi progetti. I progetti aperti mantengono i propri.","prefs.devices":"Mouse 3D","prefs.dialog_buttons":"Pulsanti OK","prefs.dialogs":"Dialoghi","prefs.dialogs_edge":"Al bordo della vista","prefs.dialogs_left_column":"Nella colonna sinistra","prefs.dialogs_note":"Dove si aprono le finestre dei comandi: ancorate al bordo della vista, oppure nella colonna sinistra al posto della Struttura e della Cronologia, che tornano com'erano alla chiusura della finestra.","prefs.display":"Visualizzazione","prefs.edges":"Spigoli e ombreggiatura","prefs.extend":"Estendi","prefs.extra_navigation":"Ctrl+trascina con il sinistro sullo spazio vuoto per orbitare; tieni premuto Space per la panoramica.","prefs.follows_os":"Segue il sistema operativo","prefs.font":"Carattere","prefs.font_fallback":"I simboli che mancano nel carattere scelto passano a quello integrato, così nessuna etichetta mostra un riquadro vuoto.","prefs.font_sample":"Quel fez sghembo copre davanti · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"Non è stato possibile leggere il carattere selezionato.","prefs.general":"Generale","prefs.general_note":"Lingua, salvataggio e aggiornamenti.","prefs.gesture_orbit":"Orbita","prefs.gesture_pan":"Panoramica","prefs.gesture_zoom":"Zoom","prefs.graphics":"Grafica","prefs.graphics_card":"Scheda grafica","prefs.graphics_card_auto":"Automatica","prefs.graphics_card_missing":"La scheda grafica salvata non è disponibile; viene usata Automatica.","prefs.graphics_card_restart":"Ha effetto dopo il riavvio di SolidCraft. WGPU_ADAPTER_NAME prevale su questa scelta.","prefs.graphics_note":"Scegli tra velocità e fluidità dell'immagine. Ogni scelta mostra il suo effetto su un esempio.","prefs.graphics_presets_note":"Una preimpostazione regola insieme le scelte qui sotto.","prefs.hide_constraint_glyphs_zoomed_out":"Nascondi i simboli dei vincoli quando lo zoom è ridotto","prefs.hide_constraint_glyphs_zoomed_out_note":"I simboli dei vincoli scompaiono dalla vista quando lo zoom sullo schizzo è ridotto al punto da affollarlo. Disattivato: restano a una dimensione fissa sullo schermo a qualsiasi zoom.","prefs.history":"Cronologia","prefs.history_origin_bodies":"Mostra origine e corpi in alto","prefs.history_origin_bodies_note":"La Cronologia a sinistra o sotto la Struttura inizia con la cartella Corpi del componente attivo e con l'Origine, con occhi e menu come nella Struttura. La Cronologia in basso non cambia.","prefs.history_play_button":"Pulsante Riproduci cronologia nei controlli della cronologia","prefs.history_play_button_note":"Inserisce Riproduci cronologia tra Indietro di un passaggio e Avanti di un passaggio nei controlli della cronologia. Puoi anche fare clic con il pulsante destro sui controlli per mostrarlo o nasconderlo.","prefs.history_sketches":"Schizzi","prefs.history_sketches_in_order":"In ordine","prefs.history_sketches_note":"Con Schizzi impostato su Sotto la lavorazione, la Cronologia a sinistra elenca ogni schizzo rientrato di un livello, sotto la prima lavorazione creata a partire da esso, quando è abbastanza larga da mostrare i nomi. La cronologia in basso mantiene sempre l'ordine di creazione.","prefs.history_sketches_under_feature":"Sotto la lavorazione","prefs.hold_stop_snapping":"Tieni premuto per disattivare l'aggancio","prefs.icons_only":"Solo icone","prefs.imported_file":"File importato","prefs.in_browser":"Nella Struttura","prefs.input":"Input","prefs.interface":"Interfaccia","prefs.interface_language":"Lingua dell'interfaccia","prefs.interface_note":"Aspetto di SolidCraft e disposizione dei suoi elementi.","prefs.interval_minutes":"{n} min","prefs.labels":"Etichette","prefs.layout":"Disposizione","prefs.layout_note":"Compatta: pannelli ancorati ai bordi della finestra. La trasparenza della Struttura è disponibile in Flottante. Cambia il lato dell'Assistente nella pagina Assistente.","prefs.left":"Sinistra","prefs.left_click":"Clic sinistro","prefs.line_drag_draws_one":"Premi e trascina per disegnare una linea","prefs.line_drag_draws_one_note":"Nello strumento Linea, premere, trascinare e rilasciare disegna una linea dal punto di pressione a quello di rilascio, e il disegno termina lì. I clic disegnano comunque una catena. Disattivato: un trascinamento posiziona un punto dove viene rilasciato, come un clic.","prefs.linked_designs":"Progetti collegati","prefs.live_input":"Input in tempo reale","prefs.live_preview":"Anteprima dal vivo","prefs.logo":"Logo","prefs.logo_accent":"Accento","prefs.logo_theme":"Colori del tema","prefs.max_file_size":"Dimensione massima dei file da aprire","prefs.max_file_size_design":"File di progettazione","prefs.max_file_size_flag":"Questo avvio usa --max-file-size {size}, valido fino alla chiusura di SolidCraft. Queste impostazioni si applicano all’avvio senza tale opzione.","prefs.max_file_size_note":"Valori predefiniti: 512 MB e 256 MB; massimo 16 GB. Aprire un file richiede memoria pari a più volte la sua dimensione. Un progetto che conserva un’importazione grande può richiedere un limite maggiore per essere salvato e riaperto.","prefs.max_file_size_step":"File STEP e di importazione","prefs.max_file_size_web":"L’app web apre file STEP e di importazione fino a 512 MB e progetti fino a 256 MB: una scheda del browser non può contenere file più grandi. L’app desktop permette di aumentare questi limiti.","prefs.megabytes":"MB","prefs.menu_grid":"Icone grandi","prefs.menu_list":"Elenco","prefs.menus":"Menu","prefs.minutes":"minuti","prefs.minutes_suffix":" min","prefs.mouse":"Mouse e trackpad","prefs.mouse_heading":"Mouse","prefs.mouse_mapping":"Assegnazione del mouse","prefs.navigation":"Navigazione","prefs.navigation_note":"Come mouse, trackpad e mouse 3D spostano la vista.","prefs.network_host_remove":"Rimuovi","prefs.network_locations":"Consenti posizioni di rete nei progetti","prefs.network_locations_note":"Disattivato: i file collegati di un progetto su un altro computer (\\\\server\\share) vengono aperti solo dai server elencati qui, o dopo che ne consenti uno quando richiesto.","prefs.network_locations_section":"Posizioni di rete","prefs.not_on_gpu":"non su questa GPU","prefs.on":"Attivo","prefs.opaque":"Opaco","prefs.orbit_snap":"Tieni premuto Shift durante l'orbita per agganciarti a un asse.","prefs.orientation":"Orientamento","prefs.origin_plane_names":"Nomi dei piani di origine","prefs.origin_plane_names_note":"Nomi mostrati nella Struttura, nelle finestre di dialogo e negli elenchi. {top} è XY, {front} è XZ e {right} è YZ, con Z verso l'alto. Comandi, script e progetti salvati mantengono XY, XZ e YZ.","prefs.overall_speed":"Velocità complessiva","prefs.parameter_list_rows":"Righe dell'elenco dei parametri","prefs.parameter_list_rows_tip":"La freccia giù in un campo valore vuoto elenca i parametri, prima i preferiti, fino a questo numero. Un numero minore mantiene leggero l'elenco in un progetto grande.","prefs.persistent_ribbon_pressed":"Evidenzia i comandi attivi della barra multifunzione","prefs.persistent_ribbon_pressed_help":"Evidenzia i comandi della barra multifunzione finché i loro effetti sono attivi. Disattiva per mantenere l'aspetto neutro precedente e la guida dei comandi.","prefs.perspective_fov":"Campo visivo","prefs.placement":"Posizione","prefs.prefer_free_sketch_points":"Preferisci i punti dello schizzo mobili quando i punti si sovrappongono","prefs.preview_choices":"Anteprima delle tue scelte","prefs.print_face_highlight":"Evidenziazione della faccia di stampa","prefs.print_face_highlight_tip":"Intensità della tinta e del contorno della faccia di stampa di un corpo nella vista. 0 % non mostra evidenziazione.","prefs.profile_active":"Profilo attivo","prefs.profile_applied":"Profilo applicato.","prefs.profile_changed":"Le impostazioni sono cambiate da quando il profilo è stato salvato. Salva le conserva nel profilo.","prefs.profile_deleted":"Profilo eliminato.","prefs.profile_export":"Esporta…","prefs.profile_exported":"Profilo esportato.","prefs.profile_imported":"Profilo importato. Sceglilo in Profilo attivo per passare a esso.","prefs.profile_name_hint":"Nome del profilo, ad es. Portatile","prefs.profile_rename":"Rinomina","prefs.profile_renamed":"Profilo rinominato.","prefs.profile_save":"Salva","prefs.profile_saved":"Impostazioni attuali salvate nel profilo.","prefs.profile_skipped":"Profilo applicato; {n} impostazioni hanno mantenuto il valore attuale (vedi il registro).","prefs.profiles":"Profili delle impostazioni","prefs.profiles_note":"Scorciatoie, barra degli strumenti, navigazione, menu radiale e impostazioni dell'interfaccia, raccolti sotto un nome e cambiati tutti insieme.","prefs.project_options_dialog":"Finestra delle opzioni di Proietta","prefs.project_options_dialog_note":"Attivo: scegli Geometria o Corpi e Collegamento di proiezione prima di proiettare. Disattivato: mantiene il flusso di lavoro precedente con selezione diretta.","prefs.quality_default":"predefinito","prefs.quality_fastest":"più veloce","prefs.quality_slowest":"più lento","prefs.quality_smoother":"più fluido","prefs.quick_measure":"Misura rapida nell'angolo della vista","prefs.quick_measure_note":"La dimensione della selezione nell'angolo in basso a destra della vista: la lunghezza di uno spigolo, oppure Ø e R per uno tondo, l'area di una faccia, la posizione di un punto, la distanza e l'angolo tra due elementi, il totale di più spigoli o facce. Un clic la copia.","prefs.render_previous_geometry_budget":"Usa il budget di geometria precedente per l'anteprima di Rendering","prefs.render_previous_geometry_budget_help":"Ripristina il limite fisso di geometria precedente (512 MiB su desktop a 64 bit, 128 MiB altrove) invece del budget basato sul dispositivo.","prefs.reports_saved":"{n} salvati","prefs.ribbon_reveal":"Mostra i risultati della ricerca nella barra multifunzione","prefs.ribbon_reveal_note":"Passando il puntatore su un risultato in Cerca comandi si vede dove si trova il comando nella barra multifunzione: la sua scheda, il suo pulsante o la sua riga nel menu a discesa di un pannello. Un comando avviato dalla ricerca lampeggia lì, e un comando in esecuzione da un menu a discesa ne evidenzia il pannello.","prefs.right_click":"Clic destro","prefs.saving":"Salvataggio automatico e ripristino","prefs.scale_note":"Anche Ctrl + / Ctrl − nella finestra. I pulsanti sono 28 px al 100%.","prefs.scale_text":"Scala e testo","prefs.search":"Cerca nelle impostazioni","prefs.search_empty":"Nessuna impostazione corrispondente","prefs.select":"Seleziona","prefs.select_one_item":"Seleziona un elemento","prefs.select_other_hidden":"Seleziona la geometria nascosta con Seleziona altro","prefs.select_other_hidden_help":"Attivo: include i corpi e gli schizzi nascosti e gli spigoli occlusi vicino al puntatore. Disattivato: usa l'elenco originale della geometria visibile sotto il puntatore.","prefs.selecting":"Selezione","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift solo aggiunge; Ctrl / Cmd alterna","prefs.shift_add_note":"Attivo: Shift aggiunge, Ctrl / Cmd alterna. Disattivo (predefinito): entrambi alternano.","prefs.shortcuts":"Scorciatoie","prefs.single_surface_analysis":"Usa una sola analisi della superficie","prefs.single_surface_analysis_help":"Se disattivato, l'ombreggiatura della superficie e Continuità possono restare attive insieme. Se attivato, resta solo l'ultima analisi avviata o modificata.","prefs.sketch_align_points":"Allinea agli altri punti dello schizzo durante il disegno","prefs.sketch_align_points_note":"Durante il disegno, un punto si allinea contemporaneamente in orizzontale con un punto dello schizzo e in verticale con un altro, con una guida punteggiata, e il clic mantiene entrambi gli allineamenti. Disattivato: solo con il punto precedente, un asse alla volta.","prefs.sketch_conflict_colour":"Geometria in conflitto nel colore di conflitto","prefs.sketch_conflict_colour_note":"Quando i vincoli di uno schizzo sono in conflitto, anche le curve e i punti interessati da un vincolo in errore vengono disegnati con il colore di conflitto, non solo il suo simbolo o la sua quota. Disattivato: mantengono i colori abituali.","prefs.sketch_construction_lines":"Strumenti estesi per le rette di costruzione","prefs.sketch_exit_view":"Al termine di uno schizzo","prefs.sketch_exit_view.keep":"Mantieni la vista attuale","prefs.sketch_exit_view.previous":"Torna alla vista precedente","prefs.sketch_exit_view.unless_rotated":"Torna, se non ruotata","prefs.sketch_exit_view_note":"Dove va la vista dopo Termina schizzo, Annulla o un doppio Esc.","prefs.sketch_open_look_at":"Ruota la vista verso lo schizzo quando si apre","prefs.sketch_open_look_at_note":"Disattivato: creando o modificando uno schizzo la vista resta com'è. Vista normale orienta la vista sullo schizzo quando vuoi.","prefs.sketch_recent_snap":"Aggancia automaticamente ai centri e punti medi recenti","prefs.sketch_recent_snap_note":"Durante il disegno, il cursore si aggancia dove si incrociano le guide degli ultimi due centri di cerchio o punti medi di segmento. Disattivato: queste guide restano solo visive e il cursore non si sposta.","prefs.sketch_selection":"Schizzo e selezione","prefs.sketch_selection_heading":"Schizzo e selezione","prefs.sketch_selection_note":"Come si agganciano gli schizzi e come selezionano i clic.","prefs.sketch_state_icons":"Icone degli schizzi nel colore del loro stato","prefs.sketch_state_icons_note":"Nella Cronologia e nella Struttura, l'icona di uno schizzo assume il colore del suo stato (sottovincolato, completamente vincolato o in conflitto) e il suo suggerimento indica lo stato. Disattivato: ogni schizzo ha la stessa icona.","prefs.sketch_tab_always":"Mantieni visibile la scheda Schizzo","prefs.sketch_tab_always_note":"La scheda Schizzo resta nella barra multifunzione, subito dopo Modella, finché nessuno schizzo è aperto. I suoi strumenti di disegno avviano allora uno schizzo sul piano o sulla faccia selezionati, oppure sul piano che selezioni subito dopo, con lo strumento già attivo.","prefs.sketch_tracking_guides":"Guide di allineamento di centro e punto medio","prefs.sketch_tracking_guides_note":"Passa il puntatore sul centro di un cerchio o sul punto medio di un segmento, poi spostati in orizzontale o in verticale per mostrare una guida punteggiata temporanea.","prefs.sketch_tracking_points":"Guide di allineamento da estremità e angoli durante il disegno","prefs.sketch_tracking_points_note":"Mentre uno strumento di disegno attende un punto, passando il puntatore sull'estremità di una linea o di un arco, sull'angolo di un rettangolo o su un punto libero compare la stessa guida punteggiata temporanea di un centro o di un punto medio. Disattivato: solo centri e punti medi.","prefs.sketching":"Schizzi","prefs.snap_drawing_note":"Mentre disegni o trascini un punto dello schizzo.","prefs.source":"Fonte","prefs.speed":"Velocità","prefs.stand_up_note":"Dopo l'apertura di un file STEP o IGES con Z verso l'alto, proponi un quarto di giro attorno a X.","prefs.stand_up_unknown":"Per i file di programmi sconosciuti","prefs.stand_up_unknown.ask":"Chiedi in una finestra di dialogo","prefs.stand_up_unknown.note":"Mostra una nota","prefs.stand_up_unknown.off":"Non proporre","prefs.stand_up_unknown_note":"Come viene fatta la proposta quando l'intestazione del file non indica alcun programma noto per salvare con Y verso l'alto. Una nota viene mostrata solo quando il file sembra coricato; Chiedi in una finestra di dialogo chiede per ogni file di questo tipo, come prima.","prefs.status_bar":"Barra di stato","prefs.status_bar_note":"Una barra sottile lungo il bordo inferiore della finestra mostra cosa si sta modificando, lo stato dello schizzo aperto nel suo colore e le unità del progetto; un clic sulle unità le cambia. Lo stato dello schizzo non compare più nell'angolo della vista.","prefs.status_done":"Fatto","prefs.status_error":"Errore","prefs.status_selected":"Selezionato","prefs.status_warning":"Avviso","prefs.supersampling_brief":"Disegna la vista più grande e poi la riduce con un filtro: molto nitida, ma più pesante.","prefs.tab_accent_note":"L'accento segue la scheda attiva","prefs.theme_file":"file del tema","prefs.theme_file_or_paste":"file o incolla","prefs.theme_follow":"Segui un file di tema","prefs.theme_follow_error":"Non applicato: {error}. Resta attivo l’ultimo tema valido.","prefs.theme_follow_launch":"Seguito solo per questa sessione (--theme-file); ricaricato quando un altro strumento riscrive il file.","prefs.theme_follow_note":"Ricaricato quando un altro strumento riscrive il file. Scegliere un tema interrompe il monitoraggio.","prefs.theme_follow_off":"Disattivato","prefs.theme_follow_stop":"Smetti di seguire","prefs.theme_import_hint":"Fai clic per scegliere un file di tema, trascinane uno qui oppure premi Ctrl+V (Cmd+V su Mac) con un tema copiato","prefs.theme_option_opacity":"Opacità","prefs.theme_option_opacity_help":"Regola l'opacità dei pannelli flottanti. Una soglia minima di leggibilità protegge il testo sopra i colori della vista.","prefs.theme_option_tab_colours":"Colori delle schede","prefs.theme_option_tab_colours_help":"Usa i colori dei pannelli e della vista di questo tema per ogni scheda della barra multifunzione.","prefs.theme_option_tab_fade_ms":"Transizione tra schede","prefs.theme_option_tab_fade_ms_help":"Sfuma i colori dei pannelli e della vista quando si cambia scheda. Zero cambia all'istante.","prefs.theme_options_badge":"Opzioni","prefs.theme_options_more":"Altro · {count}","prefs.theme_options_reset":"Reimposta","prefs.theme_options_unavailable":"Non disponibile su questo dispositivo","prefs.theme_paste":"Incolla tema","prefs.theme_paste_none":"Negli appunti non c'è nessun tema SolidCraft","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"ora","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Avvisi","prefs.toggle_item":"Aggiungi l'elemento o toglilo di nuovo","prefs.toolbar":"Barra degli strumenti","prefs.toolbar_tabs":"Schede della barra degli strumenti","prefs.top":"In alto","prefs.trackpad_zoom_modifier":"Zoom con lo scorrimento a due dita tenendo premuto","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Tieni premuto solo questo tasto per eseguire lo zoom sul puntatore con lo scorrimento verticale. Disattivato mantiene il comportamento di scorrimento attuale.","prefs.trackpad_zoom_modifier.off":"Disattivato","prefs.translucent":"Traslucido","prefs.under_browser":"Sotto la Struttura","prefs.under_cursor":"Sotto il cursore","prefs.units_precision":"Unità e precisione","prefs.updates":"Aggiornamenti","prefs.value_boxes_in_view":"Mostra i valori accanto alle maniglie nella vista","prefs.value_boxes_in_view_tip":"Il valore di un comando (Distanza, Raggio…) in un riquadro accanto alla sua maniglia, sopra il modello. Disattivato: lo digiti nella finestra del comando, che riceve la tastiera dopo una selezione, e niente copre il modello.","prefs.view":"Comportamento della vista","prefs.view_confirm_corner":"OK e Annulla nell'angolo della vista","prefs.view_confirm_corner_note":"Mentre è aperta una finestra di dialogo o uno schizzo, una spunta e una croce in alto a destra nella vista fanno ciò che fanno OK e Annulla della finestra, oppure terminano e annullano lo schizzo. Il navigatore della vista scende sotto di esse.","prefs.viewport":"Vista","prefs.viewport_analysis_status":"Mostra lo stato di analisi della vista","prefs.viewport_analysis_status_help":"Mostra le analisi attive sopra la vista, apri le loro legende da ogni elemento e usa Esc per disattivare l'analisi più recente. Disattiva per ripristinare le legende negli angoli e il comportamento precedente di Esc.","prefs.viewport_background":"Sfondo","prefs.viewport_background_colour":"Colore","prefs.viewport_background_theme":"Sfumatura del tema","prefs.viewport_section_status":"Mostra lo stato di sezione della vista","prefs.viewport_section_status_help":"Mostra l'impostazione della sezione nella vista. Escape e il pulsante attivo della barra multifunzione la disattivano. Disattiva per mantenere i controlli di sezione precedenti.","prefs.viewport_status_details":"Dettagli della vista in tempo reale","prefs.viewport_status_details_help":"Modifica le impostazioni di analisi e sezione attive nelle schede di dettaglio standard. Disattiva per ripristinare le legende di analisi in sola lettura e la finestra di dialogo Sezione.","prefs.viewport_status_summary":"Raggruppa gli elementi di stato della vista","prefs.viewport_status_summary_help":"Raggruppa tre o più elementi di stato della vista in un unico indicatore di riepilogo. Disattiva per mantenere ogni elemento nella riga completa.","prefs.wheel":"Rotellina","prefs.wheel_trackpad":"Rotellina e trackpad","prefs.workspace":"Area di lavoro","prefs.zoom_stop_at_model":"Ferma lo zoom sul modello","prefs.zoom_stop_at_model_tip":"Il mouse 3D e l'app del dispositivo eseguono lo zoom verso la superficie al centro della vista; lo zoom con trascinamento mantiene il punto in cui è iniziato il trascinamento. Disattivato: lo zoom può attraversare il modello. Rotellina e pizzicamento usano separatamente Zoom verso il cursore","prefs.zoom_toward_cursor":"Zoom verso il cursore","properties.title":"Proprietà: {name}","recovery.days_ago":"{count} giorni fa","recovery.detail":"{file} · {features} feature · salvato automaticamente {when}","recovery.discard_all":"Scarta tutto","recovery.discard_all_detail":"Questa azione non può essere annullata.","recovery.discard_all_title":"Scartare {count} salvataggi automatici?","recovery.discard_all_title_one":"Scartare 1 salvataggio automatico?","recovery.hours_ago":"{count} h fa","recovery.just_now":"proprio ora","recovery.min_ago":"{count} min fa","recovery.never_saved":"mai salvato","render.adaptive_absolute":"Soglia minima di errore RGB assoluto","render.adaptive_coverage":"Obiettivo di errore di copertura","render.adaptive_enable":"Assegna i campioni con piloti indipendenti","render.adaptive_help":"Solo GPU. I campioni pilota indipendenti vengono scartati, poi si assegnano 16 o più campioni di produzione per pixel fino a Campioni per pixel. La varianza di RGB e copertura guida l'assegnazione; i percorsi rari possono andare persi e i pixel limitati dal tetto possono restare rumorosi. Il rapporto finale conta il lavoro effettivo. Nessuna garanzia certificata su rumore o tempo.","render.adaptive_minimum":"Campioni di produzione minimi","render.adaptive_pending":"Sono disponibili l'assegnazione adattiva a piloti indipendenti su GPU e gli strati di Fresnel condizionali. Convergenza certificata, garanzie sugli eventi rari e trasporto adattivo su CPU restano non disponibili.","render.adaptive_pilots":"Campioni pilota per pixel","render.adaptive_relative":"Obiettivo di errore RGB relativo","render.add_ground":"Aggiungi all'impostazione il piano d'appoggio adattato","render.advanced_material_scope":"È disponibile un mezzo GPU omogeneo e finito entro limiti espliciti. Griglie di densità, combinazioni annidate di vetro e volume, superfici con scattering sottosuperficiale, displacement, trasporto spettrale e concetti avanzati di materiale non vincolati restano non disponibili.","render.aging_add":"Aggiungi strato di invecchiamento","render.aging_airborne":"Polvere sospesa / mezzo partecipante","render.aging_airborne_help":"La polvere sospesa è un volume di scattering omogeneo e finito, separato dalle superfici. Modifica il trasporto e l'EXR grezzo, non la pila di invecchiamento delle superfici. Le restrizioni esistenti su volume, vetro e riduzione del rumore restano esplicite; non viene aggiunta automaticamente alcuna atmosfera.","render.aging_all_bodies":"Tutti i corpi opachi idonei","render.aging_chips":"Vernice scheggiata","render.aging_class_any":"Tutte le classi di materiali opachi","render.aging_class_dielectric":"Solo superfici non metalliche","render.aging_class_metal":"Solo superfici metalliche","render.aging_color":"Colore dello strato · sRGB","render.aging_coverage":"Copertura","render.aging_dust":"Polvere depositata","render.aging_empty":"Nessuno strato di invecchiamento: le superfici originali restano invariate.","render.aging_fading":"Rivestimento sbiadito","render.aging_grime":"Sporco e macchie","render.aging_help":"Combina fino a otto strati ottici, in ordine. Ruggine e patina sono aspetti artistici, non simulazioni di invecchiamento o corrosione. La scala è in millimetri globali. Nessuna geometria, massa o proprietà ingegneristica viene modificata; vetro e scenografie passive sono esclusi.","render.aging_metallic":"Frazione metallica dello strato","render.aging_origin":"Origine del campo · mm globali","render.aging_patina":"Patina verde rame","render.aging_refresh_targets":"Esamina i corpi attuali","render.aging_roughness":"Rugosità dello strato","render.aging_rust":"Ferro ossidato / ruggine","render.aging_scale":"Scala del motivo","render.aging_scratches":"Graffi sottili","render.aging_target":"Destinazione e coordinate","render.aging_target_help":"Una destinazione con nome deve ancora corrispondere all'indice e al nome acquisiti. Le maschere globali sono ancorate al sistema globale e non seguono le parti in movimento. Non sono né un rilevamento delle cavità né una vera usura degli spigoli. Filtra l'elenco per raggiungere altri corpi.","render.aging_target_search":"Filtra i nomi dei corpi","render.aging_upward":"Deposito sulle superfici rivolte verso l'alto","render.all_controls_help":"Ispezione compatta di tutti i controlli attuali. Le pagine delle sezioni consentono una modifica mirata senza cambiare la richiesta sottostante.","render.all_shots_label":"Tutte le inquadrature","render.appearance_editor.absorption":"Assorbimento","render.appearance_editor.base_colour":"Colore di base","render.appearance_editor.body_reason":"Le associazioni ottiche riguardano un intero corpo. Seleziona Corpo per modificare questi controlli.","render.appearance_editor.boundary":"Contorno","render.appearance_editor.box":"Parallelepipedo","render.appearance_editor.choose_image":"Scegli immagine…","render.appearance_editor.closed":"Solido chiuso","render.appearance_editor.coat":"Vernice trasparente","render.appearance_editor.cpu_reason":"Richiede il ray tracing su CPU.","render.appearance_editor.glass":"Vetro e assorbimento","render.appearance_editor.glass_enable":"Usa vetro fisico su questo corpo","render.appearance_editor.glass_note":"Il vetro chiuso usa la distanza geometrica. Non può coesistere sullo stesso corpo con vernice trasparente o mappe.","render.appearance_editor.gpu_reason":"Richiede il path tracing su GPU.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Mappe","render.appearance_editor.normal":"Normale","render.appearance_editor.normal_strength":"Intensità della normale","render.appearance_editor.origin":"Origine","render.appearance_editor.recipe":"Ricetta","render.appearance_editor.reflection_sampling":"Campionamento per tutti i corpi riflettenti","render.appearance_editor.reflections":"Riflessi","render.appearance_editor.remove":"Rimuovi proprietà salvate","render.appearance_editor.remove_note":"Rimuove le proprietà ottiche salvate da questa inquadratura. La geometria e gli aspetti assegnati vengono mantenuti.","render.appearance_editor.remove_title":"Rimuovere le proprietà ottiche salvate?","render.appearance_editor.replace":"Sostituisci le proprietà ottiche salvate di questo corpo","render.appearance_editor.revalidate":"Riconvalida questo corpo","render.appearance_editor.save":"Salva queste proprietà ottiche","render.appearance_editor.save_reason":"Per salvare queste proprietà ottiche serve vetro fisico su un corpo GPU corrente. La vernice trasparente e le mappe immagine locali restano temporanee.","render.appearance_editor.saved":"Salvato con questa inquadratura","render.appearance_editor.saved_state":"Queste proprietà ottiche sono salvate con questa inquadratura.","render.appearance_editor.scatter_reason":"La diffusione interna richiede un contorno solido chiuso.","render.appearance_editor.temporary":"Queste proprietà ottiche sono temporanee in questa scheda. Salvale per conservarle con l'inquadratura.","render.appearance_editor.thickness":"Spessore","render.appearance_editor.thickness_reason":"Lo spessore si applica ai fogli sottili; il vetro chiuso usa la distanza geometrica.","render.appearance_editor.thin":"Foglio sottile","render.appearance_editor.u_repeat":"Ripetizione U","render.appearance_editor.v_repeat":"Ripetizione V","render.appearance_editor.v_up":"La V della texture punta verso l'alto","render.appearance_editor.weight":"Peso","render.appearance_physics_separate":"L'aspetto visivo non assegna densità, dati termici o altre proprietà ingegneristiche.","render.appearances":"Aspetti","render.assign_help":"Fai clic per applicare alla selezione; trascina per vedere l'anteprima e rilascia, oppure, senza nulla selezionato, fai clic per applicare con il pennello.","render.availability_native":"Composizione nativa; verifica prima di applicare","render.availability_projection":"Proiezione supportata; vedi ambito e omissioni","render.availability_reference":"Dati di riferimento; non è un'assegnazione automatica","render.backdrop_alpha_conflict":"Scegli questo sfondo oppure l'uscita PNG trasparente; il motore di rendering non ignorerà in silenzio nessuna delle due impostazioni.","render.backdrop_enable":"Usa sfondo sfumato solo per la camera","render.backdrop_first":"Colore iniziale / centrale","render.backdrop_help":"Questo sfondo nello spazio schermo non illumina, non proietta ombre, non riflette e non rappresenta il terreno. È escluso dall'EXR grezzo. Geometria, luci e ambiente HDR restano indipendenti.","render.backdrop_horizontal":"Sfumatura orizzontale","render.backdrop_radial":"Sfumatura radiale","render.backdrop_radius":"Raggio","render.backdrop_second":"Colore finale / del bordo","render.backdrop_vertical":"Sfumatura verticale","render.backdrop_x":"Centro X","render.backdrop_y":"Centro Y","render.background":"Sfondo della scena","render.background_camera_section":"Sfondo della camera · presentazione PNG","render.background_completed_frozen":"Il risultato mostrato è un'immagine completata e congelata. La modifica di uno sfondo non ridisegna automaticamente quel risultato. Usa Correzione colore per le modifiche solo della camera oppure Rendering per una nuova scenografia fisica.","render.background_hdr_separate":"Le risorse HDR attuali illuminano le superfici e vi si riflettono; non vengono mostrate automaticamente come panorama dietro il soggetto. Modificare una sfumatura non ruota né ricolora l'illuminazione.","render.background_lighting_section":"Illuminazione HDR · separata dallo sfondo della camera","render.background_no_alpha_override":"Uno sfondo della camera non viene aggiunto in silenzio all'uscita trasparente. La correzione colore del master grezzo usa la copertura acquisita e non riapplica la riduzione del rumore; l'EXR di origine resta invariato.","render.background_not_light":"Il colore dello sfondo serve alla presentazione e non è una sorgente luminosa aggiuntiva.","render.background_regrade":"Applica al master grezzo conservato","render.background_stage_occlusion":"Questa inquadratura include la geometria fisica della scenografia. Un pavimento o una parete grande può riempire l'inquadratura e nascondere uno sfondo solo camera. Cancella o ridimensiona la scenografia di proposito oppure modifica la sua riflettanza fisica. La rielaborazione non può rimuovere la geometria acquisita.","render.background_workflow":"Scegli lo sfondo desiderato: un colore o una sfumatura solo camera, una scenografia fisica che riceve luce oppure l'illuminazione HDR. Sono indipendenti. L'anteprima in tempo reale è una vista di modellazione; esegui il rendering di una nuova immagine o rielabora un master conservato per vedere la finitura della camera.","render.base_appearance":"Aspetto modificabile del corpo","render.base_apply":"Applica l'aspetto del corpo","render.base_apply_help":"Un'unica assegnazione visiva annullabile al corpo esatto verificato. Gli aspetti specifici delle facce e i materiali tecnici esistenti restano separati.","render.base_color":"Colore di base · sRGB","render.base_metallic":"Frazione metallica","render.base_opaque_only":"Questo editor mantiene la semantica dei corpi opachi. Per la trasmissione ottica usa i controlli espliciti del vetro.","render.bloom_enable":"Bloom di visualizzazione","render.bloom_help":"Alone creativo solo in uscita, ricavato dalle alte luci lineari positive e diffuso con tre passate box normalizzate. Il raggio è in pixel di uscita. Viene aggiunto nella luce di visualizzazione lineare prima della conversione sRGB; non è un effetto di lente o volumetrico né un miglioramento della convergenza. L'EXR grezzo resta invariato.","render.bloom_opaque":"Il bloom richiede un'uscita opaca. Il PNG trasparente viene rifiutato, non appiattito in silenzio.","render.bloom_radius":"Raggio del bloom","render.bloom_strength":"Intensità del bloom","render.bloom_threshold":"Soglia lineare delle alte luci","render.browse_capabilities":"Esamina il catalogo completo delle funzionalità","render.browse_environments":"Sfoglia gli ambienti HDR originali","render.browse_looks":"Sfoglia…","render.browse_native_scenes":"Sfoglia gli studi nativi","render.browse_physical":"Esamina i riferimenti fisici","render.browse_quality":"Esamina le specifiche di qualità","render.browse_rigs":"Sfoglia i set di luci predisposti","render.browse_scene_specs":"Sfoglia le specifiche avanzate della scena","render.browse_surfaces":"Sfoglia le superfici predisposte","render.browser_library":"Libreria","render.browser_model":"Modello","render.camera_distance":"Distanza dall'occhio al punto di mira","render.camera_exact_help":"Millimetri nel sistema globale; gli angoli sono mostrati in gradi e salvati in radianti. La navigazione usa la stessa camera della vista 3D.","render.camera_fov":"Campo visivo verticale","render.camera_pitch":"Beccheggio della camera","render.camera_roll":"Rollio","render.camera_set":"Imposta camera di rendering","render.camera_target":"Posizione del punto di mira · mm","render.camera_yaw":"Imbardata","render.category_metal":"Metallo","render.category_paint":"Vernice","render.category_plastic":"Plastica","render.category_wood":"Legno","render.check_opaque":"Trasparenza: solo superfici opache; l'alfa dello sfondo è supportato.","render.check_sorted_alpha":"Trasparenza: approssimazione alfa ordinata.","render.check_transmission":"Trasparenza: trasmissione fisica.","render.children.absolute_floor":"Soglia minima assoluta","render.children.adaptive":"Adattivo","render.children.add_look_reason":"Aggiungi un look per modificarne l'attivazione e l'intensità.","render.children.all_shots":"Tutte le inquadrature","render.children.bloom":"Bloom","render.children.check":"Verifica","render.children.check_now":"Verifica ora","render.children.chromatic":"Scostamento cromatico","render.children.compact":"Compatto","render.children.contrast":"Contrasto","render.children.copy_image":"Copia","render.children.copy_job":"Copia JSON del lavoro","render.children.copy_request":"Copia JSON della richiesta","render.children.coverage_error":"Errore di copertura","render.children.cpu":"Ray tracing su CPU","render.children.denoise":"Riduci il rumore nell'immagine finale","render.children.depth":"Profondità del percorso","render.children.distortion":"Distorsione","render.children.edge_samples":"Campioni dei bordi","render.children.effects_banner":"Questi effetti richiedono il path tracing su GPU. Aprire questa sezione non cambia mai il metodo.","render.children.enable_adaptive":"Abilita i piloti indipendenti per modificare i limiti adattivi.","render.children.enable_bloom":"Abilita il bloom per modificarne intensità, soglia e raggio.","render.children.finishing":"Finitura","render.children.flare":"Flare","render.children.fresnel":"Strati di Fresnel","render.children.ghosts":"Anelli fantasma","render.children.glass":"Trasporto nel vetro","render.children.go_to":"Vai a {editor}","render.children.grain":"Grana","render.children.halo":"Alone","render.children.hdr":"HDR","render.children.keep_master":"Conserva il master lineare grezzo","render.children.last_result":"Ultimo: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Effetti obiettivo","render.children.look_summary":"{tone} · {count} look","render.children.looks":"Look creativi","render.children.memory":"Memoria","render.children.method":"Metodo","render.children.minimum":"Minimo","render.children.needs_cpu":"Richiede il ray tracing su CPU. Aprire questa sezione non cambia mai il metodo.","render.children.nested":"Dielettrici annidati certificati","render.children.not_checked":"Non verificato","render.children.path":"Path tracing","render.children.pilots":"Campioni pilota","render.children.preview":"Payload dell'anteprima","render.children.progressive_reason":"Scegli Progressiva per modificarne il numero di campioni e il seme.","render.children.radius":"Raggio","render.children.reflect_depth":"Profondità delle riflessioni","render.children.reflect_samples":"Campioni di riflessione","render.children.regrade":"Correzione colore","render.children.relative_error":"Errore relativo","render.children.render":"Rendering","render.children.render_shot":"Renderizza inquadratura","render.children.renderer":"Motore di rendering","render.children.renderers":"Motori di rendering","render.children.request":"Questa richiesta","render.children.reset_finishing":"Reimposta finitura","render.children.review_quality":"Esamina una specifica di qualità…","render.children.rgb_gain":"Guadagno RGB","render.children.samples":"Campioni","render.children.sampling":"Campionamento","render.children.saturation":"Saturazione","render.children.scene_summary":"{bodies} corpi · {triangles} triangoli","render.children.seed":"Seme","render.children.sharpening":"Nitidezza","render.children.single_image":"Immagine singola","render.children.soft_focus":"Messa a fuoco morbida","render.children.streak":"Striatura","render.children.strength":"Intensità","render.children.studio":"Studio","render.children.threshold":"Soglia","render.children.tone":"Tono","render.children.under_hood":"Dettagli tecnici","render.children.vignette":"Vignettatura","render.children.workstation":"Workstation","render.choose_look":"Scegli prima un aspetto in Aspetti","render.chromatic_offset":"Scostamento cromatico dei bordi","render.clear_stage":"Rimuovi la scenografia salvata","render.copy_request":"Copia JSON","render.cpu_aa_help":"Campioni spaziali: più campioni migliorano i bordi e aumentano il tempo di rendering.","render.cpu_area_add":"Aggiungi luce rettangolare CPU","render.cpu_area_editor":"Luci rettangolari CPU","render.cpu_area_editor_help":"Vettori dei lati interi in millimetri; il prodotto vettoriale U × V punta verso il lato emittente. Ciò differisce dai vettori di semilato della GPU.","render.cpu_area_full_u":"Lato U intero · mm","render.cpu_area_full_v":"Lato V intero · mm","render.cpu_area_samples":"Campioni delle luci ad area","render.cpu_binding_confirm":"Conferma questo corpo","render.cpu_binding_stale":"La scena è cambiata. Conferma di nuovo questa destinazione di riflessione prima del rendering.","render.cpu_body_choose":"Scegli un corpo","render.cpu_body_filter":"Filtra i corpi per nome","render.cpu_body_filter_more":"Restringi il filtro per vedere altri corpi.","render.cpu_body_missing":"Una destinazione di riflessione è mancante, nascosta, ambigua oppure ha un nome più lungo di 128 byte. Sceglila di nuovo.","render.cpu_budget":"Profilo di risorse della CPU","render.cpu_budget_bodies":"Limite di corpi","render.cpu_budget_compact":"Compatto (limiti precedenti)","render.cpu_budget_details":"Limiti delle risorse","render.cpu_budget_help":"Scegli esplicitamente limiti più alti. Risoluzione e campioni non vengono mai ridotti automaticamente.","render.cpu_budget_memory":"Limite di memoria del lavoro","render.cpu_budget_not_guarantee":"Sono limiti di ammissione, non una riserva di RAM né una garanzia di velocità. Geometria, buffer immagine e anteprime conservate condividono il budget di memoria; il rendering può sempre essere annullato.","render.cpu_budget_resize":"La bozza supera questo profilo CPU o il suo budget di campioni della camera. Accetta esplicitamente dimensioni inferiori oppure seleziona un profilo più grande.","render.cpu_budget_studio":"Studio (immagini grandi)","render.cpu_budget_triangles":"Limite di triangoli","render.cpu_budget_workstation":"Workstation (scene complesse)","render.cpu_captured_hdr":"HDR acquisito per questa immagine","render.cpu_check_capture_help":"Verifica e Avvia controllano lo stesso digest del file o usano l'HDR incorporato. Ogni immagine mantiene la propria origine acquisita.","render.cpu_check_changed":"I comandi o il modello sono cambiati dopo questa verifica. Verifica di nuovo prima di eseguire il rendering.","render.cpu_constant_help":"La radianza costante è visibile ai raggi riflessi o trasmessi. Non fornisce illuminazione diffusa diretta.","render.cpu_custom_directions":"Sostituisci la preimpostazione con luci direzionali personalizzate","render.cpu_direction":"Direzione verso la luce (X, Y, Z)","render.cpu_directional":"Luce direzionale","render.cpu_directional_add":"Aggiungi luce direzionale","render.cpu_environment":"Ambiente CPU","render.cpu_environment_background":"Lo sfondo dell'immagine resta separato dall'illuminazione ambientale.","render.cpu_environment_bounds":"L'intensità CPU deve essere compresa tra 0 e 64, la rotazione HDR deve essere finita entro ±1,000,000 radianti e i campioni HDR devono essere 1, 4, 16 o 64.","render.cpu_environment_constant":"Ambiente costante per i raggi secondari","render.cpu_environment_none":"Nessun ambiente CPU","render.cpu_environment_samples":"Campioni di illuminazione HDR","render.cpu_exposure_help":"L'esposizione CPU deve essere compresa tra −16 e 16 EV. Un'esposizione GPU fuori da questo intervallo viene mantenuta finché non la modifichi.","render.cpu_fixed":"Immagine singola","render.cpu_hdr_help":"Radiance .hdr, panorama 2:1, fino a 2048 × 1024 e 16 MiB. La CPU richiede primari sRGB/D65 espliciti nel file; i primari non specificati e i file EXR vengono rifiutati.","render.cpu_hdr_reflection_help":"Le riflessioni ruvide HDR richiedono superfici di corpi e facce completamente metalliche. Verifica segnala le combinazioni non supportate.","render.cpu_key_rim":"Principale e controluce","render.cpu_last_check":"Ultima verifica CPU","render.cpu_light_help":"Fino a otto luci direzionali. Un elenco personalizzato vuoto le disattiva; selezionando una preimpostazione si ripristinano le sue luci. I colori sono RGB lineari e l'intensità è relativa, non in watt.","render.cpu_light_intensity":"Intensità relativa (0–64)","render.cpu_light_minimum":"Distanza minima per l'attenuazione","render.cpu_light_position":"Posizione globale (X, Y, Z)","render.cpu_light_reference":"Distanza di riferimento per l'intensità","render.cpu_light_remove":"Rimuovi luce","render.cpu_lighting":"Preimpostazione di illuminazione","render.cpu_lights":"Luci CPU","render.cpu_linear_color":"Colore lineare (R, G, B)","render.cpu_neutral":"Neutra","render.cpu_opaque_required":"Il ray tracing su CPU richiede uno sfondo opaco. Deseleziona Sfondo trasparente per continuare.","render.cpu_options_pending":"Questo pannello CPU non può ancora modificare emissione, effetti di superficie, vetro o anisotropia. Rimuovi queste opzioni API prima di usarlo.","render.cpu_point":"Luce puntiforme","render.cpu_point_add":"Aggiungi luce puntiforme","render.cpu_point_help":"Fino a otto luci puntiformi, aggiunte all'illuminazione direzionale selezionata. Le distanze sono in mm; il minimo non deve superare la distanza di riferimento.","render.cpu_primary_samples":"Campioni dei bordi per pixel","render.cpu_progressive":"CPU progressiva","render.cpu_progressive_help":"Accumula l'integratore CPU esistente in passate di un campione primario. Le riflessioni selezionate richiedono un solo campione; luci d'area, dielettrici e anisotropia richiedono Immagine singola.","render.cpu_progressive_limits":"Al massimo 1,048,576 pixel e 16,777,216 valutazioni pixel × campione. Cambiare i campioni non ridimensiona mai automaticamente l'immagine.","render.cpu_progressive_seed":"Seme di campionamento CPU","render.cpu_progressive_spp":"campioni per pixel","render.cpu_reflection_add":"Aggiungi riflessione ruvida","render.cpu_reflection_depth":"Profondità delle riflessioni (1–8)","render.cpu_reflection_empty":"Nessun corpo selezionato: le riflessioni della scena sono disattivate.","render.cpu_reflection_help":"Scegli i corpi e imposta Disattivato, Specchio o Ruvida. Ruvida usa la rugosità della superficie assegnata. Più campioni e rimbalzi aumentano il tempo; si tratta di trasporto speculare limitato, non di illuminazione globale.","render.cpu_reflection_limit":"Sono supportati fino a 64 corpi riflessi.","render.cpu_reflection_mirror":"Specchio","render.cpu_reflection_off":"Disattivato","render.cpu_reflection_rough":"Ruvida","render.cpu_reflection_samples":"Campioni di riflessione (1–64)","render.cpu_reflections":"Riflessioni CPU","render.cpu_runtime_help":"Le impostazioni numeriche di luce e ambiente vengono salvate con l'impostazione. Le riflessioni dei corpi e i file HDR restano temporanei. I valori esistenti di luci d'area e coni degli spot vengono mantenuti.","render.cpu_sampling_mode":"Modalità di campionamento CPU","render.cpu_shadows":"Proietta ombre","render.cpu_summary":"Ray tracing su CPU · riflessioni · HDR · luci direzionali e puntiformi","render.cpu_warm_cool":"Calda e fredda","render.diag_bodies":"Corpi visibili","render.diag_job_details":"Dettagli del lavoro acquisito","render.diag_last_check":"Ultimo controllo preliminare","render.diag_memory":"Stima logica per l'ammissione","render.diag_not_implemented":"Limiti di funzionalità espliciti","render.diag_preflight_details":"Dettagli del controllo preliminare","render.diag_request":"Richiesta corrente esatta","render.diag_triangles":"Triangoli","render.discard_continue":"Scarta la bozza e continua","render.draft_confirm_help":"La bozza di rendering corrente contiene modifiche non applicate. Salvale prima di cambiare, scartale esplicitamente oppure continua a modificare.","render.draft_confirm_title":"Conserva le impostazioni di rendering modificate","render.effects_gpu_only":"Questi effetti richiedono il path tracing su GPU. Cambiare pagina non cambia mai automaticamente il motore di rendering.","render.effects_help":"Combina look cromatici ordinati ed effetti obiettivo nello spazio immagine. Il rendering e la correzione colore del master grezzo usano le stesse impostazioni salvate. L'EXR grezzo resta invariato. Sono controlli artistici originali, non emulazioni calibrate di obiettivi o di pellicole di marche specifiche.","render.effects_reset_lens":"Reimposta effetti obiettivo","render.effects_seed":"Seme del motivo","render.emitted_axis":"Asse di emissione","render.env_advanced":"Avanzate","render.env_backdrop":"Sfondo","render.env_backdrop_pending":"La visibilità dell'ambiente e la sfocatura dello sfondo non sono ancora supportate dal motore di rendering.","render.env_blur":"Sfocatura","render.env_change":"Cambia","render.env_choose_source":"Scegli un ambiente in Studi e ambienti prima di modificare l'illuminazione.","render.env_clear":"Cancella","render.env_colour":"Colore","render.env_environments":"Ambienti","render.env_ground":"Piano d'appoggio","render.env_ground_pending":"Il piano d'appoggio fisico riceve le ombre come superficie diffusa finita. La ricezione delle sole ombre e i riflessi del piano non sono ancora supportati.","render.env_intensity":"Intensità","render.env_invalid_edit":"Modifica dell'ambiente non valida.","render.env_physical_ground":"Piano d'appoggio fisico","render.env_preview_help":"Esempio illustrativo con una sfera; non è un'anteprima dell'ambiente selezionato.","render.env_reflection":"Riflesso","render.env_ring_help":"Trascina l'anello per ruotare l'illuminazione. Tieni premuto Shift per agganciare a 15°.","render.env_rotate":"Ruota","render.env_set":"Imposta ambiente di rendering","render.env_shadow_catcher":"Ricevitore di ombre","render.env_show_environment":"Mostra ambiente","render.env_source":"Fonte","render.env_stage_details":"Le modifiche al piano d'appoggio richiedono il ray tracing e un solo pannello di appoggio. Usa Scena per modificare gli altri pannelli del set fotografico.","render.env_studios":"Studi","render.environment.albedo":"Albedo","render.environment.atmosphere":"Atmosfera","render.environment.backdrop_note":"Uno sfondo è visibile solo alla camera. Non illumina, non proietta ombre né riflette ed è rifiutato con l'uscita trasparente.","render.environment.blur_pending":"La sfocatura non è disponibile: il motore di rendering non ha un'impostazione di sfocatura dello sfondo.","render.environment.builtin":"HDR integrato","render.environment.check":"Verifica file"