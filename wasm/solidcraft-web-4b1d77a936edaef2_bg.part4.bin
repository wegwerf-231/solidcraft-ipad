der.layer_enabled":"Sloj je omogućen","render.layer_off_suffix":" (isključeno)","render.layer_remove":"Ukloni sloj","render.layer_strength":"Jačina sloja","render.layer_up":"Pomakni gore","render.lens_effects_help":"Odsjaj koristi do četiri odvojena svijetla izvora u stvarnoj linearnoj slici. Duhovi, oreol, pruge, kromatski pomaci i radijalno izobličenje umjetničke su aproksimacije u prostoru slike. Prostorni efekti zahtijevaju neprozirni izlaz; vanjski uzorci produljuju rub slike. Zrno je determinističko. Fizika, EXR i geometrija ne mijenjaju se.","render.lens_effects_title":"Po uzoru na objektive i fotografiju","render.library_all":"Katalog","render.library_all_states":"Sva stanja dostupnosti","render.library_appearance_available":"Dostupan izgled","render.library_applicable":"Primjenjivi resursi","render.library_applied":"Projekcija resursa je primijenjena. Provjerite potpuni zahtjev za renderiranje prije pokretanja.","render.library_apply_appearance":"Primijeni izgled","render.library_apply_hdr":"Spremi s ovim HDR okruženjem","render.library_apply_hint":"Kliknite za primjenu · povucite na model","render.library_apply_maps":"Upotrijebi autorske GPU mape površine","render.library_apply_studio":"Spremi autorsku projekciju studija","render.library_apply_uniform":"Primijeni jednoličan neprozirni izgled","render.library_authored_help":"Izvorni autorski resursi ilustrativni su, a ne izmjereni inženjerski podaci. Svaka radnja primjenjuje samo svoju navedenu projekciju.","render.library_blocked":"Blokirano / potrebna kalibracija","render.library_capabilities":"Specifikacije mogućnosti","render.library_center":"Središte postave","render.library_clear_search":"Očisti","render.library_details":"Specifikacija i porijeklo","render.library_emitters_only_ack":"Upotrijebi samo emitere; izostavi dokumentirane pasivne kartice","render.library_empty":"Nema odgovarajućih resursa. Pokušajte s drugim upitom ili filtrom dostupnosti.","render.library_environment_concepts":"Koncepti okruženja","render.library_extent":"Opseg predmeta","render.library_favorite":"Dodaj u favorite","render.library_favorites":"Favoriti","render.library_filters":"Katalog i dostupnost","render.library_grid":"Mreža","render.library_hdr":"Ugrađena HDR okruženja","render.library_hdr_help":"Ugrađuje izvorni HDR u spremljenu postavku. Autorsko ishodište geografske duljine izričito se pretvara; nakon spremanja nije potrebna vanjska datoteka.","render.library_in_design":"U dizajnu","render.library_inspect_only":"Odaberite za pregled; ništa se ne primjenjuje automatski. Favoriti i nedavna povijest pripadaju ovoj sesiji otvorenog dokumenta.","render.library_ior":"IOR","render.library_light_concepts":"Koncepti osvjetljenja","render.library_list":"Popis","render.library_maps_help":"Ugrađene mape mogu se spremiti s fiksiranim izvorima i lokalnim mapiranjem primjeraka. Privremena optička nadjačavanja ostaju zaseban način rada.","render.library_material_concepts":"Koncepti materijala","render.library_metallic":"Metalnost","render.library_native_scenes":"Izvorni studiji","render.library_next":"Sljedeća stranica","render.library_omitted":"Nije uključeno","render.library_opacity":"Neprozirnost","render.library_other":"Ostali izgledi","render.library_physical_profiles":"Profili fizičkih referenci","render.library_previous":"Prethodna stranica","render.library_quality_concepts":"Specifikacije kvalitete","render.library_recent":"Nedavno","render.library_replace_environment":"Izričito zamijeni postojeće okruženje","render.library_replace_studio":"Zamijeni spremljeno osvjetljenje, okruženje i scenu","render.library_results":"Odgovarajući resursi","render.library_rig_help":"Uklopi jednom u izričito zadano središte i fizički opseg. Potpune postave uključuju pasivne kartice; prepreke kalibracije i dalje odbijaju. Konzervativni razmak emitera i kartica provjerava se prije spremanja.","render.library_rigs":"Autorske postave osvjetljenja","render.library_roughness":"Hrapavost","render.library_save_maps":"Spremi mape u ovu postavku","render.library_scene_bounds":"Upotrijebi zabilježene granice scene","render.library_scenes":"Specifikacije scene","render.library_search":"Pretraži biblioteku","render.library_select_hint":"Odaberite resurs u Biblioteci kako biste pregledali njegove podržane radnje i ograničenja.","render.library_selene":"SELENE neprozirni izgledi","render.library_selene_shots":"SELENE specifikacije kadrova","render.library_short_blocked":"Nedostupno","render.library_short_native":"Izvorni sastav","render.library_short_projection":"Podržana projekcija","render.library_short_reference":"Samo referenca","render.library_short_specification":"Samo specifikacija","render.library_source_preview":"Učitaj pregled izvorne mape","render.library_source_preview_help":"Autorska izvorna mapa osnovne boje. Ovo nije renderirani ni izmjereni pregled materijala.","render.library_specification_only":"Samo specifikacija: nije potpuna izvršna postavka. Potrebni efekti, resursi i uloge predmeta i dalje zahtijevaju izričitu implementaciju i povezivanje.","render.library_specs":"Samo specifikacije","render.library_status":"Dostupnost","render.library_surfaces":"Autorske PBR površine","render.library_target":"Ciljno tijelo","render.library_title":"Biblioteka resursa za renderiranje","render.library_unfavorite":"Ukloni iz favorita","render.library_uniform_ack":"Upotrijebi jednoličnu aproksimaciju bez prostornih ili naprednih efekata","render.library_usable":"Izvršne projekcije","render.library_users":"Korisnici","render.light_aim":"Usmjeri prema","render.light_anchor_pending":"Promjena koordinatnog sustava svjetla još nije podržana.","render.light_azimuth":"Azimut","render.light_backend_limit":"Odaberite CPU praćenje zraka ili izričiti GPU studio kako biste uređivali svjetla. Svjetla starog GPU studija ostaju samo za čitanje.","render.light_behaviour":"PONAŠANJE","render.light_default_fill":"Popunjavajuće","render.light_default_key":"Glavno","render.light_default_number":"S