dio_half_v":"Halvkant V (mm)","render.studio_hdr":"Radiance HDR-fil","render.studio_hdr_browse":"Velg HDR…","render.studio_hdr_help":"Radiance .hdr, 2:1-panorama, opptil 2048 × 1024. EXR er ikke tilgjengelig. Fargeantakelsen gjelder bare når primærfargene ikke er angitt.","render.studio_hdr_required":"Velg en lokal .hdr-fil.","render.studio_hdr_srgb":"Tolk uspesifiserte primærfarger som lineær sRGB","render.studio_intensity":"Omgivelsesintensitet","render.studio_lens":"Dybdeskarphet","render.studio_lens_perspective":"Dybdeskarphet krever et perspektivkamera.","render.studio_lighting":"Studiobelysning","render.studio_lighting_enable":"Bruk egendefinert studiobelysning","render.studio_needs_review":"Gå gjennom metode og innstillinger","render.studio_radiance":"Lineær RGB-stråling","render.studio_ready":"Klar for kontroll","render.studio_remove_area":"Fjern arealys","render.studio_rotation":"Omgivelsesrotasjon","render.studio_runtime_help":"Numeriske studioinnstillinger og kontrollerte HDR-kilder kan lagres sammen med oppsettet. Optiske overstyringer og materialoverstyringer på kropper er midlertidige og endrer ikke lagrede utseender.","render.studio_saved":"Lagret oppsett / gjeldende kamera","render.studio_sky":"Kunstnerisk himmel","render.studio_sky_help":"Original himmelgradient for belysning; ikke en kalibrert atmosfæremodell.","render.studio_sun":"Sol","render.studio_sun_radius":"Vinkelradius","render.studio_tiles_require_gpu":"Studioer krever GPU-banesporing. Velg GPU i utdataeditoren.","render.studio_title":"Rendringsstudio","render.studio_tone_map":"Tonemapping","render.studios_environments":"Studioer og omgivelser","render.subsurface_enable":"Indre spredning (tilfeldig vandring)","render.subsurface_help":"Bare for lukkede dielektrikum. Spredning og RGB-absorpsjon er separate koeffisienter per mm. Lysbaner spres inne i den faktiske geometrien og brytes eller reflekteres deretter ved grensen. Slå av rett skyggegjennomgang, overflatestøyreduksjon og eksternt volum; bruk ett Fresnel-sjikt. Ikke en diffusjonsshader, et tetthetsrutenett eller et målt materiale. Tette medier kan kreve flere prøver og større banedybde.","render.subsurface_rate":"Kollisjonsrate for spredning","render.tone_aces_fitted":"ACES tilpasset","render.tone_reinhard":"Reinhard","render.transmission_scope":"GPU-glass støtter sertifiserte disjunkte medier. Ubegrenset nestede medier og en støyfri transmisjonsestimator finnes ikke.","render.transmission_strata":"Betingede Fresnel-sjikt","render.transmission_strata_help":"1 beholder den opprinnelige tilfeldighetsstrømmen. 2 eller 4 delbaner stratifiserer det første valget mellom refleksjon og transmisjon i glass, med uendrede lover for Snell og absorpsjon. Flere baner koster mer beregningsarbeid; dette er verken støyreduksjon, støtte for nestede medier eller et løfte om raskere rendring.","render.tree_add_light":"Legg til lys","render.tree_add_shot":"Legg til opptak","render.tree_browser":"Rendringstre","render.tree_by_look":"Etter stil","render.tree_by_object":"Etter objekt","render.tree_constant":"Konstant omgivelse","render.tree_default":"Standard","render.tree_directional":"Retningsbestemt","render.tree_environment":"Omgivelse","render.tree_environment_values":"{rotation}° · {intensity}×","render.tree_face_count":"{count} flater","render.tree_face_one":"{count} flate","render.tree_fixed_studio":"Fiksert studio","render.tree_hdr":"HDR","render.tree_lights":"Lys","render.tree_lights_pending":"Kommandoer for navngitte lys er ikke tilgjengelige ennå.","render.tree_mixed":"Blandet","render.tree_more":"{count} til","render.tree_mute":"Demp lys","render.tree_no_environment":"Ingen omgivelse","render.tree_objects":"Objekter","render.tree_output":"Utdata","render.tree_point":"Punkt","render.tree_rectangle":"Rektangel","render.tree_search":"Søk i objekter","render.tree_selection":"Rendringsutvalg","render.tree_shots":"Opptak","render.tree_sky":"Himmel","render.tree_solo":"Solo-lys","render.tree_spot":"Spot","render.tree_sun":"Sol","render.tree_switch":"Bytt","render.tree_user_one":"{count} objekt","render.tree_users":"{count} objekter","render.unavailable_preview":"Dette oppsettet ber om en utilgjengelig forhåndsvisningsprofil.","render.unsaved":"Ulagrede forhåndsvisningsendringer","render.use_preview":"Bruk integrert forhåndsvisning","render.volume_albedo":"Spredningsalbedo · lineær RGB","render.volume_anisotropy":"Gjennomsnittlig fasekosinus","render.volume_enable":"Aktiver deltakende medium","render.volume_extinction":"Ekstinksjonskoeffisient","render.volume_help":"GPU-lystransport inne i én endelig boks, med Beer-demping og HG-spredning på kamerabaner og indirekte baner. Bruker eksplisitt studio-, HDR- og himmelbelysning, inkludert skyggedemping. Positiv fasekosinus spreder fremover. Glassgrenser og overflatestøyreduksjon må slås av eksplisitt. Null ekstinksjon lar transporten være uendret. Ikke en fysisk måneatmosfære, et tetthetsrutenett, volumemisjon, spektraltransport eller en sertifisert materialegenskap.","render.volume_max":"Maksimumsgrenser · verden mm","render.volume_min":"Minimumsgrenser · verden mm","render.volume_title":"Avgrenset homogent volum","render.wait_add_light":"støttes ikke ennå: opprettelse av navngitt lys","render.wait_batch":"støttes ikke ennå: rendringskøen for lagrede opptak","render.wait_compare":"støttes ikke ennå: sammenligning av lagrede bilder","render.wait_paint":"støttes ikke ennå: valg av produkt og maling av utseende","render.wait_pick_up":"støttes ikke ennå: valg av produkt og opptak av utseende","render.wait_replace":"støttes ikke ennå: erstatning av alle bruk av et utseende","render.wait_solo":"støttes ikke ennå: lysenes synlighet og solo-kontroller","render.wear_applies_to":"Gjelder for","render.wear_layer_count":"{count} lag","render.wear_layer_one":"{count} lag","render.wear_layers":"Lag","render.wear_no_layers":"Ingen lag","render.wear_selected_layer":"Valgt lag","render.wear_title":"Slitasje","sample.bracket.about":"Basisflens med kantflenser og kantomslag, med en plateregel for 2 mm tykkelse","sample.bracket.name":"Platebrakett","sample.enclosure.about":"Uthulet boks med leppekant, skruefester, anlegg og snap-fit","sample.enclosure.name":"Plasthus","sample.flange.about":"Nav og flens med sirkulært mønster drevet av en parameter","sample.flange.name":"Boltet flens","sample.hinge.about":"To komponenter og et dreieledd beveget til 60°","sample.hinge.name":"Hengselenhet","sample.plate.about":"Parametrisk plate med avrundinger, hull og en knast med boring","sample.plate.name":"Eksempelplate","sample.vents.about":"Spor i et rektangulært mønster: rader, kolonner og stigning er parametere","sample.vents.name":"Ventilasjonsplate","search.command_keys":"Enter kjør     Shift+Enter kjør og behold åpen     Esc lukk","search.commands":"Kommandoer","search.design":"I dette designet","search.feature":"Funksjon","search.invalid":"Ikke gyldig","search.keys":"↑ ↓ velg     Enter kjør     Tab fyll navn     Esc lukk","search.no_match":"Ingen kommando samsvarer med «{query}»","search.parameter":"Parameter","search.recent":"Nylige","search.run":"Kjør kommando","search.suggest":"Mente du {label}?","search.try":"Skriv et kommandonavn, en funksjon i dette designet, eller en parameter. For å kjøre en kommando med verdier, skriv id-en og et JSON-objekt: {example}","search.valid":"Gyldig","section.off_hint":"Ingen plan valgt: OK slår snittet av.","select a direction (an axis, a sketch line or a straight edge) first":"velg en retning (en akse, en skisselinje eller en rett kant) først","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"velg en retning (en akse, en skisselinje eller en rett kant) som profilen skal følge","select a point on a component":"velg et punkt på en komponent","select a profile, edges or sketch lines first":"velg en profil, kanter eller skisselinjer først","select an axis":"velg en akse","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"velg en akse, en rett eller sirkulær kant, eller en sylinder-, kjegle- eller torusflate først","select bodies first":"velg kropper først","select components first":"velg komponenter først","select corner points, or the two lines of one corner":"velg hjørnepunkter, eller de to linjene i ett hjørne","select one corner point, or the two lines of one corner":"velg ett hjørnepunkt, eller de to linjene i ett hjørne","select sheet edges first":"velg platekanter først","select the bend line (a sketch line) first":"velg bøyelinjen (en skisselinje) først","select the cam's profile (a sketch profile or the cam's edges)":"velg kammens profil (en skisseprofil eller kammens kanter)","select the corner to cut first":"velg hjørnet som skal kappes først","select the corners to round first":"velg hjørnene som skal rundes først","select the fixed face first (a plate's large face)":"velg den faste flaten først (platens store flate)","select the frame sketch's lines first":"velg linjene i rammeskissen først","select the path (sketch lines across the edge)":"velg banen (skisselinjer på tvers av kanten)","select the rim face first":"velg randflaten først","select the sheet edge first":"velg platekanten først","select two components":"velg to komponenter","set by the sketch's lines":"bestemt av skisselinjene","settings.display_quality_note":"Gjelder bare visningen. Design og eksport påvirkes ikke.","settings.double_click_components":"Dobbeltklikk på en komponent for å aktivere den, eller for å redigere en koblet komponent på stedet","settings.frame_rate_details_note":"Legger til en graf over tidene for de siste bildene med trekantene som er tegnet oppå, et histogram over bildetider og hva GPU-en tegnet. Klikk på bildefrekvensen i visningen for å vise eller skjule dem.","settings.frame_rate_note":"Viser bilder per sekund nederst til høyre i visningen.","settings.insert_lists_open_designs":"Sett inn design viser først designene som er åpne i andre faner","settings.measure_axis_distances":"Vis X/Y/Z-avstander","settings.measure_axis_distances_help":"Vis avstanden langs hver av de globale X-, Y- og Z-aksene sammen med totalavstanden mens Mål er åpen.","settings.msaa_applies_on_restart":"Kantutjevning brukes neste gang SolidCraft starter","settings.msaa_reset":"{setting}: {requested}× støttes ikke av denne grafikkenheten; den er nå {reset}× (støttet: {supported}).","settings.msaa_unsupported":"Støttes ikke av denne grafikkenheten","settings.reference_geometry_through_bodies":"Vis referansegeometri gjennom kropper","settings.reference_geometry_through_bodies_help":"Tegn inaktive skisseomriss og referanseplan over skyggelagte kropper","settings.reset_intro":"Disse innstillingene fungerer ikke på denne datamaskinen og ville hindret SolidCraft i å starte, så de ble endret:","settings.reset_title":"Innstillinger ble endret","settings.supersampling_note":"Tegner visningen i høyere oppløsning og skalerer den ned for å gi jevnere kanter, linjer og rutenett på skjermer under 4K. Det bruker mer GPU-tid: 1,5× gir omtrent 2,25 ganger så mange piksler, og 2× gir 4 ganger så mange.","settings.update_changed_links":"Oppdater endrede koblede design når en fane kommer tilbake","settings.window_system_details":"Detaljer","settings.window_system_note_now":"Gjelder etter en omstart. Nå: {now}.","settings.window_system_wayland_limited":"Noen funksjoner er begrenset på native Wayland.","sheet.flange_type_base":"Base","sheet.flange_type_contour":"Kontur","sheet.flange_type_edge":"Kant","sheet.no_body":"det finnes ingen platemetallkropp: start en med Flens > Basis, eller gjør en plate om til platemetall med Konverter til platemetall (velg den store, flate siden)","sheet.personal_rules.confirm_delete":"Bekreft sletting","sheet.personal_rules.delete":"Slett","sheet.personal_rules.delete_prompt":"Slette denne personlige regelen? Regler som allerede ligger i design, endres ikke.","sheet.personal_rules.full":"Det personlige biblioteket inneholder allerede 64 regler.",