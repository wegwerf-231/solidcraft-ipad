,"cmd.view.status_items":"عناصر حالة منطقة العرض","cmd.view_ambient_occlusion":"الإظلال المحيطي","cmd.view_angle_readout":"زوايا العرض","cmd.view_apply":"استعادة عرض مسمّى","cmd.view_back":"العرض الخلفي","cmd.view_bottom":"العرض السفلي","cmd.view_delete":"حذف عرض مسمّى","cmd.view_fit":"ملاءمة","cmd.view_front":"العرض الأمامي","cmd.view_graphics_preset":"إعداد الرسوميات المسبق","cmd.view_grid":"الشبكة","cmd.view_ground_shadow":"ظل الأرض","cmd.view_home":"العرض الرئيسي","cmd.view_isometric":"العرض المتساوي القياس","cmd.view_left":"العرض الأيسر","cmd.view_list":"قائمة العروض المسمّاة","cmd.view_navigate":"التنقل في العرض","cmd.view_navigation_bar":"شريط التنقل","cmd.view_next_tab":"علامة التبويب التالية","cmd.view_normal_to":"عمودي على التحديد","cmd.view_previous_tab":"علامة التبويب السابقة","cmd.view_rename":"إعادة تسمية عرض مسمّى","cmd.view_render_frame":"أدلة إطار التصيير","cmd.view_right":"العرض الأيمن","cmd.view_save":"عرض مسمّى جديد","cmd.view_shots_strip":"شريط اللقطات","cmd.view_spin":"تدوير مستمر","cmd.view_tool":"أداة التنقل","cmd.view_top":"العرض العلوي","cmd.view_visual_style":"نمط العرض","color.copy":"انقر لنسخ قيم اللون","color.edit":"انقر لتعديل اللون","color.gamma":"عرض قيم اللون في نطاق جاما 0-255","color.hex":"Hex","color.hex_help":"أدخل #rrggbb أو #rrggbbaa؛ مع الخانات الست تبقى العتامة كما هي","color.hex_hint":"#rrggbb","color.hue":"درجة اللون","color.linear":"عرض قيم اللون في النطاق الخطي 0-1","color.recent":"الألوان الأخيرة","color.recent_help":"تظهر هنا الألوان التي تختارها في أي حقل لون","color.saturation":"التشبع (بالمئة)","color.saturation_value":"التشبع والقيمة","color.selected":"اللون المحدد","color.step_down":"إنقاص خطوة","color.step_up":"زيادة خطوة","color.value":"القيمة، أي السطوع (بالمئة)","config.column_filter_empty":"لا توجد أعمدة مطابقة","contact.components_count":"{count} مكوّنات","contact.enabled_label":"مفعّل","coupling.gear_1":"الترس 1","coupling.gear_1_pick":"الترس 1 (اختياري)","coupling.gear_2":"الترس 2","coupling.gear_2_pick":"الترس 2 (اختياري)","coupling.internal":"ترس داخلي","coupling.needs_turn_and_slide":"يحتاج إلى مفصل يدور وآخر ينزلق","coupling.needs_turns":"يحتاج إلى مفصلين يدوران","coupling.not_round":"ليس وجهًا دائريًا","coupling.nut":"صامولة","coupling.picked":"مُختار","coupling.pinion":"ترس صغير","coupling.pinion_pick":"ترس صغير (اختياري)","coupling.pitch":"الخطوة","coupling.rack":"جريدة مسننة","coupling.radius_1":"نصف القطر 1","coupling.radius_2":"نصف القطر 2","crash.announce":"أُغلق SolidCraft بشكل غير متوقع أو واجه خطأً داخليًا في المرة السابقة. حُفظ تقرير عطل (المساعدة > تقارير الأعطال…).","crash.copy_folder":"نسخ مسار المجلد","crash.copy_path":"نسخ المسار","crash.deleted":"حُذف {count} من التقارير.","crash.detected_time":"اكتُشف في {time} UTC","crash.intro":"تبقى تقارير الأعطال على هذا الحاسوب ولا تُرسل إلى أي مكان. «إبلاغ…» يفتح مسودة تراجعها قبل مشاركة أي شيء.","crash.kind_command":"خطأ داخلي في أمر","crash.kind_internal":"خطأ داخلي","crash.kind_kernel":"خطأ في النواة (تم التعافي منه)","crash.kind_unclean":"أُغلق بشكل غير متوقع","crash.previous_session":"انتهت جلسة سابقة من SolidCraft بشكل غير متوقع أو واجهت خطأً داخليًا. تُكتشف تقارير الخروج غير السليم عند بدء التشغيل. راجع المساعدة > تقارير الأعطال… للتفاصيل.","crash.replayable":"قابل لإعادة التشغيل","crash.report":"إبلاغ…","crash.unclean_explanation":"اكتُشف عند تشغيل لاحق، ولم يُسجَّل وقت الخروج بدقة. قد يسبب إيقاف تشغيل النظام أو الإيقاف القسري خروجًا غير سليم أيضًا.","delete.and_more":"… و{count} غيرها","diagnostic.empty_boolean_component":"لا يوجد جسم للقص أو التقاطع في المكوّن '{component}'؛ قد تتداخل الأداة مع '{body}' في المكوّن '{other}' — نشّط ذلك المكوّن أو اختر الجسم هدفًا","dialog.bodies_count":"{count} أجسام","dialog.clearance_invalid":"يجب أن يكون الخلوص طولًا قيمته 0 أو أكثر","dialog.compute":"احسب","dialog.compute_again":"احسب مرة أخرى","dialog.computing":"جارٍ الحساب… {seconds} ث","dialog.could_not_be_checked":"تعذّر فحصه","dialog.custom_axis":"↖ محور مخصص","dialog.dimension_insert_hint":"انقر على بُعد قائد آخر لإدراج اسمه","dialog.dimension_name":"البُعد: {name}","dialog.edit_title":"تعديل {title}","dialog.no_shown_body":"لا يوجد جسم ظاهر لتغييره: أظهر جسمًا، أو اختر «جسم جديد»","dialog.pattern_sketch_not_object":"اختر أجسامًا أو ميزات: الرسم ليس أيًّا منهما. كرّر منحنياته بأداة النمط أو المرآة داخل الرسم، أو ابثقه أولًا.","dialog.select":"↖ تحديد","dialog.selected_count":"↖ {count} محدد","dialog.selection_guidance":"حدد مُدخلًا لتغييره. انقر على العناصر المحددة لإزالتها؛ Ctrl/Cmd مع النقر يبدّل تحديدها أيضًا. راجع المعاينة ثم اضغط موافق.","dialog.selection_step":"{step} من {total}: حدد {input}","dialog.step":"الخطوة","document.changed_on_disk":"تغيّر {name} على القرص","document.changed_on_disk_detail":"غيّر برنامج أو حاسوب آخر {name} منذ أن فتحته أو حفظته آخر مرة. الكتابة فوقه تستبدل تلك التغييرات بتغييراتك؛ وحفظ نسخة يحتفظ بالاثنين.","document.copy_name":"نسخة من {name}","document.open_anyway":"افتح على أي حال","document.open_elsewhere":"{name} مفتوح بالفعل","document.open_elsewhere_detail":"{name} مفتوح في SolidCraft {app} على {who}، فُتح {when}. إذا حفظتما كلاكما، فسيخسر أحدكما عمله. افتحه للقراءة فقط لتطّلع عليه دون الحفظ فوقه.","document.open_read_only":"فتح للقراءة فقط","document.opened_read_only":"فُتح للقراءة فقط: الحفظ يطلب ملفًا جديدًا","document.overwrite":"الكتابة فوقه","document.read_only_save":"فُتح هذا التصميم للقراءة فقط: احفظه كملف جديد","document.save_changes":"حفظ التغييرات على {name}؟","document.save_copy":"حفظ نسخة…","document.unsaved_changes":"في {name} تغييرات غير محفوظة. إن لم تحفظها فستضيع.","drive.rigid":"{joint} مفصل صلب: يثبّت أجزاءه في مكانها، لذا لا يوجد ما يمكن تحريكه. لتتحرك الأجزاء، غيّر نوعه في «تعديل المفصل»: «دوراني» للدوران، «منزلق» للانزلاق، «أسطواني» لكليهما.","drive.stopped_by_contact":"توقف عند {value}: سيخترق {a} الجسم {b}","drive.stopped_by_loop":"توقف عند {value}: لا يمكن للحلقة عبر {joint} أن تنغلق أكثر","drive.unconnected":"لا يحرّك شيئًا: {part} غير متصل بأي شيء مثبت بالأرض","dxf.cancel_wait":"بانتظار توقف التصدير…","dxf.cancelled":"أُلغي تصدير DXF","dxf.cancelling":"جارٍ إلغاء تصدير DXF","dxf.exporting":"جارٍ تصدير DXF","dxf.invalid_tolerance":"يجب أن يكون تفاوت المنحنى بين 0.0001 و1 mm.","dxf.progress.index":"تجهيز الأسطح (2/5)","dxf.progress.meshes":"تجهيز الشبكات (1/5)","dxf.progress.occlusion":"معالجة الخطوط المخفية (4/5)","dxf.progress.projection":"إسقاط الهندسة (3/5)","dxf.progress.write":"كتابة DXF (5/5)","dxf.tolerance":"تفاوت المنحنى","dxf.tolerance_help":"الأجسام الظاهرة فقط. المنحنيات تُمثَّل بقطع مستقيمة. التفاوت الأصغر يعطي منحنيات أنعم ويستهلك وقتًا وذاكرة أكثر.","each rail's curves must be in one sketch":"يجب أن تكون منحنيات كل دليل في رسم واحد","feature computation ended without a result":"انتهى حساب الميزة دون نتيجة","file.open.drawing_filter":"التصاميم وملفات CAD والشبكات والرسومات","file_load.built":"بُني حتى الآن: {built} من {total} ميزة.","file_load.converting":"تحويل الجسم الصلب {done} من {total}","file_load.inserting":"إدراج الهندسة","file_load.link_item":"{name} ({done} من {total})","file_load.opening":"فتح التصميم","file_load.preparing_thumbnail":"تجهيز الصورة المصغّرة...","file_load.preparing_view":"تجهيز العرض...","file_load.preview_note":"معاينة محفوظة. يجري التحقق من الهندسة قبل التعديل.","file_load.reading":"قراءة الملف...","file_load.reading_percent":"قراءة الملف... {percent}%","file_load.rebuilding":"إعادة بناء الميزة {done} من {total}","file_load.recovering":"استعادة التصميم","file_load.stopping":"انتظار توقف العملية السابقة...","file_load.updating_links":"تحديث الروابط","file_load.waiting":"انتظار عملية الملف","fits the face, e.g. M8":"يلائم الوجه، مثل M8","from the profile":"من المقطع","from the rule":"من القاعدة","help.apache":"رخصة Apache 2.0","help.appearance.assign":"يمنح الأجسام أو الأوجه أو المكونات المحددة لونًا أو مظهر مادة، من دون تغيير وزنها. استخدمه للتمييز بين القطع أو لمعاينة التشطيب.","help.assembly.bom":"يسرد قطع التصميم أو المكوّن مع أعدادها حسب رقم القطعة، ويمكنه حفظ القائمة بصيغة CSV أو JSON. استخدمه كقائمة قطع للطلب والتجميع.","help.attributions":"الإسنادات (ATTRIBUTION.md)","help.build":"الإصدار {version} · الإيداع {commit} · بُني في {date}","help.canvas.decal":"يضع صورة على وجه مستوٍ من النموذج مثل ملصق. استخدمه لإظهار تسمية أو شعار أو نمط مطبوع على قطعة.","help.canvas.edit":"يغيّر اللوحة المرجعية: موضعها أو حجمها أو زاويتها أو عتامتها أو انعكاسها أو ظهورها أو اسمها. استخدمه لمحاذاة صورة مرجعية مع الرسم الذي تتتبعه فوقها.","help.canvas.insert":"يضع صورة PNG أو JPEG على مستوى أو وجه كمرجع شبه شفاف. استخدمه لتتبع صورة أو مخطط في رسم، مع ضبط الصورة على مقاس معلوم.","help.component.break_link":"يفصل مكوّنًا مرتبطًا عن ملف تصميمه مع إبقاء أجسامه كما هي. استخدمه عندما ينبغي ألا تتبع القطعة تغييرات الملف الأصلي بعد الآن.","help.component.capture_position":"يحفظ مواضع القطع التي حركتها يدويًا لتصبح مواضعها المعتمدة. استخدمه بعد سحب قطع إلى أماكنها دون أن يمسكها أي مفصل.","help.component.create":"يضيف مكوّنًا جديدًا فارغًا إلى التصميم داخل المكوّن النشط، ما لم تختر مكوّنًا أبًا آخر. استخدمه لمنح قطعة جديدة في تجميع مكانًا خاصًا لأجسامها ورسومها.","help.component.finish_edit":"يحفظ الجزء الذي تحرّره في مكانه، ويعود إلى تجميعه ويحدّث التجميع منه. استخدمه عند الانتهاء من تغييراتك على الجزء المرتبط.","help.component.from_bodies":"يحوّل كل جسم محدد إلى مكوّن مستقل يحمل اسم الجسم. استخدمه لتحويل تصميم من أجسام منفصلة إلى تجميع يمكن ربط قطعه وتحريكها.","help.component.insert_design":"يدرج تصميمًا محفوظًا آخر كمكوّن مرتبط بملفه، مع وضع أجسامه الصلبة كما هي فيه. استخدمه لإعادة استخدام قطعة في تجميع واستيراد تغييراتها اللاحقة عبر تحديث الروابط.","help.component.properties":"يعرض الحجم والكتلة ومركز الكتلة وعزوم القصور الذاتي لمكوّن، اعتمادًا على مواد أجسامه. استخدمه للتحقق من وزن التجميع وتوازنه.","help.component.revert_position":"يعيد القطع التي حركتها يدويًا إلى مواضعها السابقة، ويتجاهل التحركات التي لم تُثبّت مواضعها. استخدمه للتراجع عن التحركات التجريبية في تجميع.","help.component.update_links":"يعيد قراءة ملفات التصميم المرتبطة ويستبدل الأجسام التي تغيّرت. استخدمه بعد تعديل قطعة يستخدمها هذا التجميع.","help.config.configure":"يضيف معاملات أو ميزات أو مواد أو مظاهر كأعمدة في جدول التكوينات. استخدمه لبناء نسخ متعددة من تصميم واحد، مثل مقاسات قطعة.","help.config.preview":"يتحقق من أن صفًا في جدول التكوينات يُعاد بناؤه بنجاح، دون تغيير التصميم أو سجله. استخدمه قبل التبديل إلى نسخة لست متأكدًا منها.","help.config.rules":"يعرض قواعد جدول التكوينات وصفوفه والصف النشط حاليًا. استخدمه لمعرفة كيف أُعدّت نسخ التصميم.","help.config.table":"يعرض جدول التكوينات: صف لكل نسخة وعمود لكل معامل أو ميزة، ويبيّن هل ما زال التصميم مطابقًا للصف النشط. استخدمه لمراجعة نسخ التصميم.","help.connect_note":"أعد تشغيل كل مساعد لتحميل خادم SolidCraft. نُسخ كل ملف احتياطيًا بامتداد .bak قبل تغييره.","help.connect_title":"ربط مساعدي الذكاء الاصطناعي","help.construct.axis.edge":"ينشئ محورًا إنشائيًا على امتداد حافة مستقيمة أو خط رسم. استخدمه كمحور لعملية دوران أو لنمط دائري أو لمفصل.","help.construct.axis.normal_to_face":"ينشئ محورًا إنشائيًا يمر بنقطة ويكون عموديًا على وجه. استخدمه كمحور يبرز مستقيمًا من السطح.","help.construct.axis.through_cylinder":"ينشئ محورًا إنشائيًا عبر مركز وجه أسطوانة أو مخروط أو طارة، أو حافة دائرية. استخدمه لتدوير الميزات أو تكرارها حول قطعة مستديرة.","help.construct.axis.two_planes":"ينشئ محورًا إنشائيًا عند التقاء مستويين أو وجهين مسطحين. استخدمه حين يكون المحور المطلوب هو الخط بين وجهين.","help.construct.axis.two_points":"ينشئ محورًا إنشائيًا يمر بنقطتين أو رأسين أو نقطتي رسم. استخدمه لمحور يمتد بين موضعين معروفين.","help.construct.plane.along_path":"ينشئ مستوى إنشائيًا عموديًا على حافة أو منحنى عند موضع على امتداده. استخدمه لرسم مقطع من أجل كنس أو لمقطع عرضي للمسار.","help.construct.plane.at_angle":"ينشئ مستوى إنشائيًا مائلًا بزاوية عن مستوى أو وجه، حول محور أو حافة. استخدمه للرسوم المائلة، مثل حامل مائل.","help.construct.plane.midplane":"ينشئ مستوى إنشائيًا في منتصف المسافة بين مستويين أو وجهين مسطحين، أو منصّفًا لهما حيث يلتقيان بزاوية. استخدمه كمستوى تناظر عند عمل مرآة.","help.construct.plane.offset":"ينشئ مستوى إنشائيًا موازيًا لمستوى أو وجه مسطح، على مسافة محددة أو عبر نقطة. استخدمه للرسم على ارتفاع محدد فوق وجه.","help.construct.plane.perpendicular":"ينشئ مستوى إنشائيًا يحوي خطًا أو حافة ويكون عموديًا على مستوى أو وجه. استخدمه للرسم بشكل رأسي على النموذج على امتداد حافة.","help.construct.plane.tangent":"ينشئ مستوى إنشائيًا يمس أسطوانة أو مخروطًا أو كرة أو طارة عند نقطة. استخدمه للرسم على جانب قطعة مستديرة.","help.construct.plane.three_points":"ينشئ مستوى إنشائيًا يمر بثلاث نقاط. استخدمه لمستوى تحدده مواضع على النموذج، مثل ثلاث زوايا.","help.construct.plane.two_edges":"ينشئ مستوى إنشائيًا يمر بحافتين مستقيمتين أو خطين يقعان في مستوى واحد. استخدمه لمستوى يقطع القطعة، مثل مستوى يمر بحافتين متقابلتين.","help.construct.point.along_path":"ينشئ نقطة إنشائية عند موضع على امتداد حافة أو منحنى. استخدمها كمرجع في موضع بين طرفي المسار.","help.construct.point.center":"ينشئ نقطة إنشائية في مركز حافة دائرية أو دائرة رسم أو قوس أو كرة أو طارة. استخدمها كمرجع للثقوب والمحاور والمفاصل.","help.construct.point.edge_plane":"ينشئ نقطة إنشائية حيث تخترق حافة أو خط مستوى أو وجهًا مسطحًا. استخدمها لتحديد موضع عبور المسار للمستوى.","help.construct.point.three_planes":"ينشئ نقطة إنشائية حيث تلتقي ثلاثة مستويات أو أوجه مسطحة. استخدمها مرجعًا لزاوية، حتى حيث لا يوجد رأس في النموذج.","help.construct.point.two_edges":"ينشئ نقطة إنشائية حيث تلتقي حافتان أو خطان، أو حيث يكونان أقرب ما يمكن. استخدمها مرجعًا عند زاوية افتراضية.","help.construct.point.vertex":"ينشئ نقطة إنشائية على رأس أو نقطة رسم. استخدمها مرجعًا يبقى حتى عند إخفاء الرسم أو الجسم المحيط بها.","help.contact.check":"يسرد أزواج القطع في مجموعات التلامس التي تتداخل أجسامها في مواضعها الحالية. استخدمه لاكتشاف التصادمات قبل تحريك المفاصل أو تشغيل دراسة الحركة.","help.contact.create":"يجمع قطعتين أو أكثر في مجموعة تلامس تمنع أجسامها من اختراق بعضها أثناء حركة المفاصل. استخدمه للقطع التي ينبغي أن تتوقف عند التلامس، مثل ذراع يصطدم بمصدّه.","help.contact.disable_all":"يعطّل التلامس، فلا تعود المفاصل المحرّكة ودراسات الحركة تتوقف عند تلامس القطع. استخدمه لتحريك القطع بحرية مجددًا أو للحفاظ على سرعة استجابة تجميع كبير.","help.contact.edit":"يعدّل مجموعة تلامس: قطعها أو اسمها أو حالة تعطيلها المؤقت، ويمكنه حذف المجموعة أيضًا. استخدمه لتحديد القطع التي يُمنع تداخل أجسامها.","help.contact.enable_all":"يضع كل قطع التجميع في مجموعة تلامس واحدة، فلا يمكن لأي قطعتين اختراق بعضهما أثناء حركة المفاصل. استخدمه لفحص آلية كاملة بسرعة.","help.contact.enable_sets":"يفعّل التلامس لمجموعات التلامس التي عرّفتها، فتتوقف المفاصل المحرّكة ودراسات الحركة حيث كانت قطعها ستخترق بعضها. استخدمه لإعادة تفعيل مجموعاتك بعد تعطيل التلامس.","help.contact.list":"يسرد مجموعات التلامس في التصميم والقطع في كل مجموعة وحالة تفعيل التلامس. استخدمه لفحص إعداد التلامس قبل تحريك التجميع.","help.document.inspect":"يعرض نظرة عامة على التصميم: مكوّناته وأجسامه ورسومه وميزاته ومعاملاته. استخدمه للتعرف على تصميم لم تبنِه بنفسك.","help.document.units":"يغيّر الوحدات التي تُعرض بها الأطوال في التصميم، مثل mm أو البوصة. يحتفظ الشكل الهندسي بحجمه؛ ويتغير العرض والأرقام العادية فقط.","help.edit.checkpoint":"يحفظ التصميم والرسم النشط وسجل التراجع كما هي الآن. استخدمه قبل تجربة شيء محفوف بالمخاطر قد ترغب في العودة منه.","help.edit.restore_checkpoint":"يعود إلى نقطة حفظ مع سجل التراجع. استخدمه لتجاهل كل ما أُجري منذ نقطة الحفظ بخطوة واحدة.","help.explode.create":"ينشئ عرضًا مفككًا يباعد القطع عن مركز التجميع أو ينقلها وفق التحركات التي تحددها. استخدمه لإظهار كيفية تركيب التجميع في التعليمات أو العروض التقديمية.","help.face.delete":"يحذف الأوجه المحددة ويترك الأوجه المجاورة تسد الفجوة، أو يترك الفتحة مفتوحة كسطح. استخدمه لإزالة حافة مقوّسة أو ثقب أو نتوء يعترض الطريق.","help.file.insert_mesh":"يضيف ملف 3MF أو STL أو OBJ أو PLY أو glTF إلى التصميم كأجسام شبكية في مكوّن جديد. استخدمه لوضع نموذج منزّل أو ممسوح ضوئيًا بجانب تصميمك كمرجع.","help.file.insert_step":"يضيف ملف STEP أو IGES أو FreeCAD أو Rhino إلى التصميم كأجسام صلبة في مكوّن جديد، وتصبح قطع التجميع مكوّنات متداخلة. استخدمه لاستيراد نماذج من المورّدين أو برامج CAD الأخرى.","help.file.save_mesh":"يحفظ الأجسام كشبكة STL أو 3MF أو OBJ بدرجة نعومة الوجوه المنحنية التي تختارها. استخدمه لتجهيز القطع للطباعة ثلاثية الأبعاد أو للبرامج التي تقرأ الشبكات.","help.file.send_to_slicer":"يحفظ الأجسام المحددة في ملف 3MF ويفتحه في برنامج التقطيع الذي تختاره. استخدمه للانتقال من النموذج إلى الطباعة بخطوة واحدة.","help.font_details":"تستخدم الواجهة خطوط egui المدمجة (Ubuntu Light وHack، بموجب رخصة Ubuntu Font ورخصة MIT/Bitstream Vera، وNoto Emoji وخط أيقونات الرموز التعبيرية بموجب OFL وMIT). يستخدم نص الرسم خط Liberation Sans (SIL OFL 1.1). حزمة الخطوط الاختيارية craft-fonts لتطبيقات Crafting (BIZ UDPGothic وShippori Mincho وBIZ UDMincho وNoto Sans CJK SC وNoto Sans Arabic، بموجب SIL OFL 1.1) غير مضمّنة في إصدارات SolidCraft.","help.fonts":"الخطوط","help.frame.member":"يضع مقطعًا، مثل أنبوب أو قطاع ألومنيوم مبثوق، على امتداد خطوط رسم هيكل، بعنصر واحد لكل خط. استخدمه لبناء الهياكل والرفوف والمنشآت الملحومة.","help.inspect.accessibility":"يلوّن الأوجه التي تستطيع أداة الوصول إليها من اتجاه واحد، وتلك التي لا تستطيع. استخدمه لفحص قطعة للتشغيل الآلي أو القولبة من ذلك الجانب.","help.inspect.center_of_mass":"يعرض مركز كتلة الأجسام، كلٍّ على حدة ومجتمعةً، بكثافة منتظمة. استخدمه لفحص التوازن ومعرفة أين ستميل القطعة.","help.inspect.colored_components":"يمنح كل مكوّن لونه المؤقت الخاص دون تغيير المظاهر. استخدمه لتمييز قطع التجميع بنظرة واحدة.","help.inspect.compare":"يقارن جسمين ويبيّن المواضع التي يحتوي فيها أحدهما مادة لا يحتويها الآخر، مع الحجم والانحراف. استخدمه لمقارنة قطعة معدّلة أو مستوردة بالأصل.","help.inspect.continuity":"يفحص مدى نعومة التقاء الأوجه عند حوافها: فجوات أو انكسارات أو قفزات في الانحناء، ويظلّل الدرزات. استخدمه لإيجاد المواضع التي لا تلتقي فيها الأسطح بنظافة.","help.inspect.curvature_comb":"يرسم أمشاطًا على المنحنيات أو الحواف أو الأوجه تُظهر أسنانها مدى شدة انحنائها. استخدمه لكشف المواضع المسطحة والانكسارات وعدم انتظام الانحناء.","help.inspect.curvature_map":"يلوّن الأوجه بحسب شدة انحنائها، بالأحمر حيث يصغر نصف القطر. استخدمه لإيجاد المواضع الضيقة وللحكم على نعومة السطح.","help.inspect.draft":"يلوّن الأوجه بحسب زاوية الميل بالنسبة لاتجاه السحب، ويحدد ذات الميل غير الكافي. استخدمه لفحص القطعة قبل القولبة أو الصب.","help.inspect.environment_map":"يعرض النموذج بلمسة نهائية عاكسة تشبه المرآة. استخدمه للحكم على انسياب الأسطح من طريقة مرور الانعكاسات عليها.","help.inspect.interference":"يجد الأجسام المتداخلة ويعرض كل تداخل مع حجمه. استخدمه لفحص التجميع بحثًا عن قطع تتصادم.","help.inspect.isocurve":"يرسم المنحنيات المتساوية المعاملات للأوجه، أي الشبكة التي بُني عليها السطح. استخدمه لمعرفة كيف ينساب السطح وأين تتجمع الخطوط.","help.inspect.measure":"يقيس الأطوال والمسافات والزوايا والمساحات وأنصاف الأقطار بين ما تحدده، أو حجم الأجسام وكتلتها. استخدمه للتحقق من المقاسات والخلوصات.","help.inspect.minimum_radius":"يجد أصغر نصف قطر انحناء للمنحنيات أو الحواف أو الأوجه وموضعه. استخدمه للتأكد من أن أداة أو فوهة تستطيع اتباع الشكل.","help.inspect.section":"يقطع العرض على امتداد مستوى ويهشّر الأوجه المقطوعة دون تغيير النموذج. استخدمه للنظر داخل القطع والتجميعات.","help.inspect.zebra":"يعرض خطوطًا سوداء وبيضاء منعكسة على أوجه النموذج. استخدمه للحكم على النعومة: الخطوط التي تنقطع أو تنكسر عند حافة تدل على انتقال ضعيف.","help.joint.as_built":"يربط قطعتين في موضعيهما الحاليين دون تحريك أي منهما، ويحدد الحركة المسموحة لهما. استخدمه للقطع التي وضعتها بالفعل في مواضعها النهائية.","help.joint.cam":"يربط كامة دوّارة بتابع، فينزلق التابع أو يتأرجح عندما يمر محيط الكامة تحته. استخدمه للكامات واللامركزيات وآليات تشغيل الصمامات.","help.joint.create":"يربط قطعتين عند أصلي المفصل اللذين تختارهما وينقل القطعة الثانية إلى موضعها، ويحدد نوع المفصل الحركة المسموحة لهما. استخدمه لبناء تجميع تتحرك قطعه مثل الآلية الحقيقية.","help.joint.drive":"يضبط زاوية المفصل أو مسافته ويحرّك القطع معه ضمن حدوده، وتتبعها المفاصل المرتبطة والحلقات المغلقة. استخدمه للتحقق من أن الآلية تتحرك كما هو مقصود.","help.joint.gear":"يربط مفصلين دوّارين بنسبة تروس، بحيث يؤدي تحريك أحدهما إلى دوران الآخر. استخدمه للتروس المستقيمة والحلقية، مع تحديد النسبة من أنصاف أقطار دوائر الخطوة أو أعداد الأسنان.","help.joint.limits":"يضبط الحدين الأدنى والأقصى لدوران المفصل أو انزلاقه، أو يزيل هذين الحدين. استخدمه لإبقاء مفصلة أو منزلق أو ذراع ضمن نطاق حركته الحقيقي.","help.joint.motion_link":"يربط مفصلين بنسبة وإزاحة، بحيث يؤدي تحريك أحدهما إلى تحريك الآخر. استخدمه لعلاقة ثابتة بين المفاصل لا تغطيها أدوات ترس أو جريدة مسننة وترس أو لولب.","help.joint.origin":"يضع أصل مفصل باسم على قطعة، عند مركز وجه أو نهاية دائرية أو منتصف حافة أو ركن أو نقطة. استخدمه لتجهيز مواضع اتصال المفاصل، فالأصل المختار على وجه يتبعه عند تغيير مقاس القطعة.","help.joint.rack_pinion":"يربط ترسًا دوّارًا بجريدة مسننة منزلقة، فتتحرك الجريدة بمقدار طول قوس دائرة الخطوة الذي يدور به الترس. استخدمه لمحركات الجريدة المسننة وأنظمة التوجيه ومنصات الحركة الخطية.","help.joint.reach":"يحرّك نقطة على قطعة نحو هدف بتغيير مفاصل سلسلتها ضمن حدودها. استخدمه لضبط وضعية آلية حسب الموضع المطلوب لنهايتها، مثل طرف ذراع روبوت.","help.joint.rigid_group":"يثبّت القطع المحددة معًا كما هي لتتحرك كقطعة واحدة. استخدمه للقطع التي تنتمي إلى وحدة واحدة ولا تتحرك بالنسبة إلى بعضها.","help.joint.screw":"يربط الدوران والانزلاق بخطوة لولبية، بحيث تتقدم القطعة بمقدار تلك المسافة في كل دورة. استخدمه للوالب القيادة والبراغي والمحاور الملولبة.","help.library.apply":"يطبّق مادة أو مظهرًا من ملف مكتبة محلي على أجسام أو أوجه أو مكوّنات. استخدمه لإعادة استخدام مواد حفظتها من تصميم آخر.","help.library.export":"يحفظ مواد التصميم ومظاهره في ملف مكتبة. استخدمه لمشاركتها أو إعادة استخدامها في تصميمات أخرى.","help.library.inspect":"يفحص ملف مكتبة ويسرد موادّه ومظاهره دون تغيير التصميم. استخدمه لمعرفة ما تحويه المكتبة قبل تطبيقها.","help.licences":"الرخص","help.material.assign":"يحدد المادة التي صُنعت منها الأجسام المحددة، مثل الفولاذ أو الألومنيوم أو ABS. استخدمه لتطابق الكتلة والوزن القطعة الحقيقية.","help.material.properties.validate":"يفحص بطاقة بيانات مادة بحثًا عن أرقام غير متسقة أو قيم مفقودة. استخدمه قبل الاعتماد على البيانات في حساب الكتلة أو الصلابة.","help.mesh.convert":"يعيد بناء جسم شبكي، مثل ملف STL، كجسم صلب قابل للتعديل بأوجه مسطحة وأسطوانية. استخدمه لتعديل القطع الميكانيكية المستوردة كأنها جسم منمذج.","help.mit":"رخصة MIT","help.motion.study":"يضبط قيم المفاصل عند خطوات على خط زمني ويشغّلها كرسوم متحركة. استخدمه لمشاهدة حركة آلية عبر تسلسل وفحص الخلوص أثناء الحركة.","help.motion.trace":"يتتبع مسار نقطة على قطعة أثناء تشغيل دراسة الحركة أو تحريك مفصل، ويحفظه كمنحنى رسم ثلاثي الأبعاد عند التأكيد. استخدمه لرؤية مدى وصول آلية أو لبناء أشكال اعتمادًا على مسارها.","help.notice":"NOTICE","help.occurrence.ground":"يثبّت قطعة في موضعها أو يحررها مجددًا، بحيث تحرّك المفاصل القطع الأخرى حولها. استخدمه للإطار أو القاعدة التي يُبنى عليها باقي التجميع.","help.occurrence.move":"يحرّك جزءًا في التجميع فقط ضمن درجات الحرية التي تسمح بها مفاصله. حدد وجهًا للجزء، ثم اسحب سهمًا أو قوسًا متاحًا.","help.parameters.change":"يفتح جدول القيم المسماة والتعبيرات التي تتحكم في أبعاد التصميم. استخدمه لتغيير مقاس في مكان واحد فتتبعه كل الميزات التي تستخدمه.","help.parameters.export":"يحفظ معاملات التصميم بصيغة CSV أو JSON. استخدمه لتعديلها في جدول بيانات أو نقلها إلى تصميم آخر.","help.parameters.graph":"يبيّن أي المعاملات والميزات تستخدم أيًّا من غيرها، وأي حلقات أو أخطاء بينها. استخدمه لمعرفة ما سيتأثر بتغيير معامل.","help.parameters.import":"يقرأ المعاملات من CSV أو JSON إلى التصميم، كلها أو لا شيء منها. استخدمه لإحضار قيم من جدول بيانات أو من تصميم آخر.","help.parameters.move":"ينقل معاملًا من معاملات المستخدم قبل معامل آخر أو بعده في القائمة. استخدمه لإبقاء المعاملات المترابطة معًا.","help.parts.fastener":"يضيف برغيًا أو مسمار ربط أو صامولة أو وردة أو دبوسًا أو محملًا قياسيًا بالمقاس الذي تختاره. عند وضعه على ثقب يستقر فيه بمفصل، فلا تحتاج إلى نمذجة أدوات التثبيت بنفسك.","help.parts.insert":"يدرج قطعة قياسية من الفئة وبالمقاس والطول الذي تختاره. عند وضعها على إطار ثقب أو جداره، تستقر على الثقب بمفصل صلب.","help.parts.library":"يفتح القطع القياسية: البراغي ومسامير الربط والصواميل والوردات وبراغي التثبيت ودبابيس التمركز والمحامل بالمقاسات القياسية. استخدمه لإضافة قطعة قياسية بدلًا من نمذجتها بنفسك.","help.parts.resize":"يغيّر مقاس قطعة قياسية مدرجة أو طولها ويعيد بناءها، وتبقيها مفاصلها مثبتة في مكانها. استخدمه عندما يتبين أن برغيًا أطول من اللازم أو أن ثقبًا يحتاج إلى مقاس آخر.","help.plastic.assign_rule":"يعيّن قاعدة بلاستيك لأجسام، فتأخذ ميزاتها البلاستيكية ميلها وخلوصها منها كقيم افتراضية. استخدمه لإعداد قطعة مقولبة مرة واحدة لكل ميزاتها.","help.plastic.boss":"يضيف نتوءًا لمسمار على وجه: عمودًا مع ثقب اختياري وميل وتقويس عند الجذر وأضلاع تقوية. استخدمه لنقاط البراغي في الهياكل المقولبة أو المطبوعة.","help.plastic.lip":"يضيف شفة أو أخدودًا مطابقًا على طول حافة جسم مفرَّغ. استخدمه ليتمركز نصفا الهيكل أحدهما على الآخر ويُغلقا بإحكام.","help.plastic.manage_rules":"ينشئ قواعد البلاستيك ويعدّلها: المادة وسماكة الجدار وأنصاف الأقطار والخلوص والميل. استخدمها للحفاظ على اتساق ميزات القطعة المقولبة.","help.plastic.rest":"يضيف مسندًا على وجه: وسادة مستديرة أو مستطيلة، مصمتة أو مجوفة، مع ميل. استخدمه كدعامة أو مُباعِد في هيكل مقولب.","help.plastic.snap_fit":"يضيف خطاف وصلة كبس على وجه، بطوله وسماكته ونتوء التثبيت. استخدمه لتثبيت القطع معًا بلا براغي.","help.pointcloud.insert":"أدرج مسحًا بصيغة PLY أو XYZ أو PTS كسحابة نقاط بجانب النموذج. استخدمه كمرجع عند النمذجة انطلاقًا من بيانات القياس.","help.sheet.convert":"يحوّل لوحًا أو جسمًا مفرَّغًا بسماكة منتظمة إلى جسم صفائح معدنية، مع ثنيات عند الحواف التي تحددها. استخدمه لجعل قطعة موجودة قابلة للفرد.","help.sheet.export_bend_table":"يحفظ جدول الثني لجسم صفائح معدنية بصيغة CSV أو JSON: الزوايا وأنصاف الأقطار ومواضع الثني في النمط المسطح. استخدمه لماكينة الثني أو الورشة.","help.sheet.export_dxf":"يحفظ النمط المسطح بصيغة DXF، مع الحدود وخطوط الثني وملاحظات الثني الاختيارية. استخدمه للقطع بالليزر أو البلازما أو نفاث الماء.","help.sheet.flange":"يضيف حافة مثنية: لوحًا أساسيًا من رسم، أو جدارًا على امتداد محيط رسم مفتوح، أو جدارًا مثنيًا على حواف الصفيحة. استخدمه لبناء قطع الصفائح المعدنية.","help.sheet.flat_pattern":"ينشئ النمط المسطح لجسم صفائح معدنية، مع حجمه وفتحاته وخطوط الثني. استخدمه لفحص الشريحة الخام قبل قصها.","help.sheet.fold":"يثني صفيحة على امتداد خط رسم بزاوية ونصف قطر محددين. استخدمه لطي صفيحة مسطحة بعد عمل القطوع فيها.","help.sheet.hem":"يطوي حافة صفيحة على نفسها. استخدمه لحواف آمنة وصلبة بلا نتوءات حادة.","help.sheet.manage_rules":"ينشئ قواعد الصفائح المعدنية ويعدّلها: السماكة ونصف قطر الثني ومعامل K والتفريغات والفجوات. استخدمها لمطابقة مادة ورشتك وأدواتها.","help.sheet.path_flange":"يضيف سلسلة من الحواف المثنية على امتداد حافة صفيحة، متتبعًا سلسلة مفتوحة من خطوط الرسم. استخدمها لمقاطع مثل شكل U أو Z بخطوة واحدة.","help.sheet.perforate":"يضيف حقلًا من الثقوب على كامل الصفيحة المسطحة، بنمط متدرج أو مربع. استخدمه للتهوية والشبكات والألواح الأخف.","help.sheet.refold":"يعيد طي جسم صفائح معدنية مفرود. استخدمه بعد إضافة ميزات إلى الصفيحة المسطحة.","help.sheet.unfold":"يفرد جميع ثنيات جسم صفائح معدنية. استخدمه لإضافة ثقوب أو قطوع يجب أن تعبر ثنية، ثم استخدم إعادة الطي.","help.sketch.arc.center_point":"يرسم قوسًا دائريًا حول نقطة مركز، من نقطة بداية إلى نقطة نهاية. استخدمه عندما يكون مركز القوس معروفًا، مثل نصف قطر حول ثقب أو محور.","help.sketch.arc.tangent":"يرسم قوسًا يبدأ من نهاية خط أو قوس ويكمل مماسًا له. استخدمه لمتابعة السلسلة بانحناء ناعم بدل زاوية حادة.","help.sketch.arc.three_point":"يرسم قوسًا من نقطة بداية إلى نقطة نهاية مارًا بنقطة ثالثة. استخدمه عندما يجب أن يمر القوس بنقاط محددة لا حول مركز معروف.","help.sketch.arc3d":"يرسم قوسًا دائريًا دقيقًا في الفراغ عبر ثلاث نقاط، مع تفعيل الرسم ثلاثي الأبعاد. استخدمه لانحناءات المسارات وقضبان التوجيه الخارجة عن مستوى الرسم.","help.sketch.auto_constrain":"يضيف القيود التي يكاد الرسم يحققها أصلًا، مثل الأفقي أو المتوازي أو المتطابق، ثم يضيف الأبعاد حتى يصبح محددًا بالكامل. استخدمه لتثبيت رسم تقريبي بخطوة واحدة.","help.sketch.auto_constrain_from_datum":"يعمل مثل «تقييد تلقائي»، لكنه يقيس المواضع من نقطة مرجعية تختارها بدل نقطة الأصل. استخدمه عندما تُحدَّد أبعاد القطعة انطلاقًا من نقطة مرجعية واحدة، كركن أو ثقب.","help.sketch.blend_curve":"يصل نهايتي منحنيين بمنحنى شريحي ناعم مماس لكليهما، أو مستمر الانحناء أيضًا إن اخترت. استخدمه لسد الفجوة بين منحنيين دون التواء.","help.sketch.break":"يقسم المنحنى إلى أجزاء عند تقاطع منحنيات أخرى معه، أو عند نقاط تضعها عليه. استخدمه عندما يحتاج جزء من المنحنى إلى قيده الخاص أو إلى حذفه وحده.","help.sketch.cancel":"يغادر الرسم ويتجاهل كل ما تغيّر منذ إنشائه أو فتحه للتعديل. ويمكن استعادة التغييرات بأمر «تراجع».","help.sketch.centerline":"يبدّل الخطوط بين خطوط عادية وخطوط المركز، وهي محاور لا تدخل في المقاطع. استخدم خط المركز محورًا لأمر «دوران» أو «مرآة» أو لقيد التناظر.","help.sketch.chamfer.distance_angle":"يشطف الزاوية بين خطين بمسافة على طول الخط الأول وبزاوية. استخدمه عندما يعطي المخطط الشطف بطول وزاوية، مثل 2 mm × 30°.","help.sketch.chamfer.equal_distance":"يشطف الزاوية بين خطين بالمسافة نفسها على طول كليهما. استخدمه للشطف المعتاد بزاوية 45° على المحيط.","help.sketch.chamfer.two_distance":"يشطف الزاوية بين خطين بمسافة مستقلة على كل خط. استخدمه للشطف بزاوية غير 45°، المعطى بطولين.","help.sketch.circle.center":"يرسم دائرة من مركزها وقطرها. استخدمه للثقوب والنتوءات والميزات المستديرة الأخرى المعروف مركزها.","help.sketch.circle.three_point":"يرسم دائرة تمر بثلاث نقاط. استخدمه عندما يجب أن تمر الدائرة بنقاط محددة، مثلًا من هندسة موجودة.","help.sketch.circle.three_tangent":"يرسم دائرة تمس ثلاثة خطوط أو دوائر أو أقواس. استخدمه لإدخال دائرة في الفراغ بين ثلاثة منحنيات، مثل الدائرة المحاطة بمثلث.","help.sketch.circle.two_point":"يرسم دائرة من طرفي قطرها. استخدمه عندما تكون نقطتا حافة الدائرة معروفتين لا مركزها.","help.sketch.circle.two_tangent":"يرسم دائرة بحجم محدد تمس خطين أو دائرتين أو قوسين. استخدمه لتقويس ثابت نصف القطر بين منحنيين.","help.sketch.conic":"يرسم منحنى مخروطيًا بين نقطتي نهاية، يتشكل بنقطة قمة وقيمة rho. استخدمه لانتقالات ناعمة تضبط امتلاءها من المسطح إلى ما يقارب زاوية حادة.","help.sketch.constrainer":"يطبق القيد الذي يكاد منحنى أو منحنيان محددان يحققانه، مثل الأفقي أو التوازي أو التماس أو التساوي. استخدمه لتهذيب رسم يدوي علاقة بعد أخرى.","help.sketch.constraint.coincident":"يجعل نقطة تقع على نقطة أخرى أو على منحنى أو على محور الرسم. استخدمه لسد الفجوات في المقطع أو لوضع نقطة على خط.","help.sketch.constraint.collinear":"يجعل خطين يقعان على خط مستقيم واحد. استخدمه لمحاذاة الحواف المتقطعة، مثل جانبي حز.","help.sketch.constraint.concentric":"يعطي دائرتين أو قوسين المركز نفسه. استخدمه للحلقات والتجاويف المتدرجة والأعمدة ذات الأكتاف.","help.sketch.constraint.curvature":"يجعل منحنيين يلتقيان عند نقطة نهاية يتابعان بالانحناء نفسه (G2). استخدمه حيث لا يكفي الوصل المماسي نعومة، مثلًا على الأسطح الظاهرة.","help.sketch.constraint.equal":"يجعل الخطوط بالطول نفسه، أو الدوائر والأقواس بنصف القطر نفسه. استخدمه ليتحكم بُعد واحد في عدة ميزات متماثلة.","help.sketch.constraint.fix":"يثبّت النقاط أو المنحنيات في مكانها، أو يفك تثبيتها. استخدمه للهندسة التي يجب ألا تتحرك عند سحب الرسم أو حله.","help.sketch.constraint.horizontal_vertical":"يجعل خطًا، أو الخط بين نقطتين، أفقيًا أو رأسيًا، أيهما أقرب. استخدمه لمحاذاة المحيط مع محاور الرسم.","help.sketch.constraint.midpoint":"يضع نقطة في منتصف خط، أو يجعل منتصفي خطين يلتقيان. استخدمه لتوسيط الهندسة على حافة.","help.sketch.constraint.parallel":"يجعل خطين متوازيين. استخدمه للأضلاع التي يجب أن تبقى متوازية عند تغيير الأبعاد الأخرى.","help.sketch.constraint.perpendicular":"يجعل خطين يلتقيان بزاوية قائمة. استخدمه للزوايا القائمة بين خطوط ليست على محاور الرسم.","help.sketch.constraint.polygon":"يجعل سلسلة مغلقة من الخطوط مضلعًا منتظمًا: أضلاع متساوية وكل زاوية على دائرة واحدة. استخدمه لجعل مضلع مرسوم يدويًا منتظمًا والحفاظ على ذلك.","help.sketch.constraint.symmetry":"يجعل نقطتين أو منحنيين متناظرين حول خط أو نقطة. استخدمه للحفاظ على تناظر المقطع عند تغيير أحد جانبيه.","help.sketch.constraint.tangent":"يجعل منحنيين يتماسان مماسيًا، مثل خط وقوس. استخدمه لوصلات ناعمة بلا التواء.","help.sketch.construction":"يبدّل المنحنيات بين الهندسة العادية والهندسة الإنشائية التي تتجاهلها المقاطع. استخدم المنحنيات الإنشائية مساعدات للتخطيط والمراجع والأبعاد.","help.sketch.construction_line":"أنشئ خطًا إنشائيًا لا نهائيًا يمر بنقطتين. استخدمه لتخطيط الرسم دون تقسيم مقاطعه.","help.sketch.construction_line.angle":"أنشئ خطًا إنشائيًا لا نهائيًا بزاوية من محور X للرسم. اختر النقطة ثم اكتب الزاوية، أو اختر اتجاهه.","help.sketch.construction_line.bisector":"اختر خطين مستقيمين متقاطعين في الرسم، ثم اختر أحد منصفي الزاوية. يتبع الناتج الخطين اللذين أُنشئ منهما.","help.sketch.construction_line.horizontal":"أنشئ خطًا إنشائيًا أفقيًا لا نهائيًا يمر بنقطة. يحافظ القيد الأفقي على الاتجاه بعد التعديلات.","help.sketch.construction_line.parallel":"اختر خطًا مستقيمًا في الرسم ثم ضع خطًا إنشائيًا لا نهائيًا موازيًا له. انقر بزر الفأرة الأيمن لتغيير المرجع.","help.sketch.construction_line.perpendicular":"اختر خطًا مستقيمًا في الرسم ثم ضع خطًا إنشائيًا لا نهائيًا عموديًا عليه. انقر بزر الفأرة الأيمن لتغيير المرجع.","help.sketch.construction_line.tangent_at":"أنشئ مماسًا عند نقطة على دائرة أو قوس دائري، أو عند نهاية منحنى شريحي مفتوح أو قطع مخروطي مفتوح. اختر المنحنى ثم نقطة التماس.","help.sketch.construction_line.tangent_external":"اختر دائرة أو قوسًا دائريًا، ثم نقطة خارجية وحل المماس. تعرض المعاينة نقاط التماس الواقعة على القوس المرسوم فقط.","help.sketch.construction_line.tangent_two":"اختر دائرتين أو قوسين دائريين ثم اختر مماسًا مشتركًا من المعاينة. يجب أن تقع نقطتا التماس على المنحنيين المرسومين.","help.sketch.construction_line.vertical":"أنشئ خطًا إنشائيًا رأسيًا لا نهائيًا يمر بنقطة. يحافظ القيد الرأسي على الاتجاه بعد التعديلات.","help.sketch.copy":"ينسخ منحنيات الرسم ونقاطه المحددة مع القيود والأبعاد بينها. الصقها في هذا الرسم أو في رسم آخر.","help.sketch.create":"يبدأ رسمًا ثنائي الأبعاد جديدًا على مستوى أو على وجه مسطح من النموذج. يبدأ كل بثق ودوران وكنس برسم.","help.sketch.cut":"ينسخ هندسة الرسم المحددة ويحذفها من الرسم بخطوة تراجع واحدة. الصقها في مكان آخر من هذا الرسم أو في رسم آخر.","help.sketch.dimension":"يضيف بُعدًا حاكمًا: طولًا أو مسافة أو زاوية أو نصف قطر أو قطرًا بحسب ما تختاره. اكتب قيمة أو اسم معامل فيتبعها الرسم.","help.sketch.edit":"يفتح رسمًا موجودًا للتعديل. تتحدّث الميزات المبنية عليه عند إنهاء الرسم.","help.sketch.ellipse":"يرسم قطعًا ناقصًا من مركزه ونهاية محوره الأكبر ونقطة على جانبه الأصغر. استخدمه للفتحات البيضاوية والكامات وغيرها من الأشكال المستديرة المتطاولة.","help.sketch.equation_curve":"يرسم منحنى من صيغ على مدى: x(t) و y(t)، أو y = f(x). يمكن أن تستخدم الصيغ المعلمات فيتبعها المنحنى: استخدمه لموجة جيبية أو لولب أو منحنى انفلات لسن ترس.","help.sketch.extend":"يمدد خطًا أو قوسًا حتى أقرب منحنى في طريقه، أو ينمّي منحنيين حتى يلتقيا. استخدمه لسد الفجوات في المقطع بعد القص أو التعديل.","help.sketch.fillet":"يقوّس الزاوية التي يلتقي فيها خطان أو قوسان بقوس ذي نصف قطر محدد. الزوايا المقوّسة معًا تشترك في نصف قطر واحد.","help.sketch.finish":"يغادر الرسم ويعود إلى النموذج. تصبح مقاطعه المغلقة جاهزة للبثق والدوران وغيرهما من الميزات.","help.sketch.finish_auto_constrain":"يشغّل «تقييد تلقائي» على الرسم ثم ينهيه. استخدمه لترك الرسم محددًا بالكامل بخطوة واحدة.","help.sketch.fit_curves_to_section":"يقطع شبكة أو جسمًا صلبًا بمستوى الرسم ويلائم خطوطًا وأقواسًا مع المقطع. استخدمه لإعادة بناء قطعة ممسوحة أو مستوردة كرسم قابل للتعديل.","help.sketch.include_3d":"يجلب حواف النموذج ورؤوسه ومنحنيات رسوم أخرى إلى هذا الرسم كمراجع مرتبطة، ويسطّح ما هو خارج مستواه عليه. استخدمه للبناء على هندسة لا تقع في مستوى الرسم.","help.sketch.infinite":"يبدّل الخطوط بين خطوط عادية وخطوط إنشائية لا نهائية تمتد عبر العرض كله. استخدمها مراجع للتخطيط لا تقصر عن الحاجة أبدًا.","help.sketch.insert_dxf":"يقرأ منحنيات مخطط DXF إلى رسم بالمقياس والدوران والموضع الذي تحدده. استخدمه للبناء على مخطط ثنائي الأبعاد من برنامج آخر، مثل محيط للقطع بالليزر.","help.sketch.insert_svg":"يقرأ مسارات مخطط SVG إلى رسم بالمقياس والدوران والموضع الذي تحدده. استخدمه لتحويل شعار أو محيط متجهي إلى منحنيات يمكنك بثقها.","help.sketch.inspect":"يفتح تقريرًا عن الرسم المفتوح: عدد درجات الحرية المتبقية وهل هو مقيد بالكامل. استخدمه لمعرفة ما لا يزال يتحرك قبل إنهاء الرسم.","help.sketch.intersect":"يضيف المنحنيات أو النقاط التي تقطع فيها أجسام أو أوجه أو حواف أو رسوم أخرى مستوى الرسم. تبقى مرتبطة وتتبع النموذج عندما يتغير.","help.sketch.intersection_curve":"ينشئ منحنيات ثلاثية الأبعاد حيث يلتقي جسمان أو وجهان، مرتبطة بهما. استخدمها مسارات أو قضبان توجيه تتبع النموذج.","help.sketch.isoparametric_curve":"ينشئ منحنى ثلاثي الأبعاد على اتجاه U أو V للوجه عبر نقطة تختارها، مرتبطًا بالوجه. استخدمه مسارًا أو خط تقسيم يتبع السطح.","help.sketch.line":"يرسم خطوطًا متصلة نقطة بنقطة، كسلسلة مفتوحة أو محيط مغلق. هو الأداة الأساسية لمعظم المقاطع.","help.sketch.line.midpoint":"يرسم خطًا من منتصفه إلى أحد طرفيه، ويعكس الطرف الآخر. استخدمه للخطوط المتمركزة على نقطة، مثل حافة متناظرة.","help.sketch.line3d":"يرسم خطوطًا مستقيمة متصلة بين نقاط في الفراغ، مع تفعيل الرسم ثلاثي الأبعاد. استخدمه للمسارات والإطارات الخارجة عن مستوى الرسم.","help.sketch.mirror":"يعكس منحنيات الرسم ونقاطه حول خط أو محور ويضيف قيود تناظر. استخدمه لرسم نصف مقطع متناظر ثم إكماله.","help.sketch.move":"يحرّك منحنيات الرسم ونقاطه أو يدوّرها، أو يفعل ذلك بنسخة منها. استخدمه لإعادة وضع الهندسة مع الحفاظ على شكلها وقيودها.","help.sketch.offset":"ينشئ نسخة من سلسلة منحنيات على مسافة محددة، من جانب واحد أو من الجانبين. استخدمه للجدران والمحيطات والخلوصات؛ وتبقى المسافة بُعدًا قابلًا للتعديل.","help.sketch.paste":"يلصق في الرسم النشط هندسة رسم نسختها أو قصصتها. ضعها عند نقطة أو أزحها بمقدار.","help.sketch.pattern.circular":"ينسخ هندسة الرسم حول نقطة مركز، على دائرة كاملة أو زاوية محددة. استخدمه لدوائر البراغي والأذرع والأسنان.","help.sketch.pattern.rectangular":"ينسخ هندسة الرسم في صفوف وأعمدة بمسافات محددة. استخدمه لشبكات الثقوب والشقوق وفتحات التهوية.","help.sketch.point":"يضع نقطة رسم. استخدمها مرجعًا للأبعاد والقيود ومراكز الثقوب أو الميزات اللاحقة.","help.sketch.point3d":"يضع نقطة في الفراغ، مع تفعيل الرسم ثلاثي الأبعاد. استخدمها مرجعًا للمنحنيات والمسارات الثلاثية الأبعاد.","help.sketch.polygon.circumscribed":"يرسم مضلعًا منتظمًا حول دائرة، بحجم يُحدد من مركزها إلى منتصف ضلع. استخدمه عندما يكون العرض بين الضلعين المتقابلين معروفًا، كما في صامولة سداسية.","help.sketch.polygon.edge":"يرسم مضلعًا منتظمًا من طرفي ضلع واحد. استخدمه عندما يكون طول الضلع وموضعه معروفين.","help.sketch.polygon.inscribed":"يرسم مضلعًا منتظمًا داخل دائرة، بحجم يُحدد من مركزها إلى أحد رؤوسه. استخدمه عندما يكون البعد بين الرأسين المتقابلين معروفًا.","help.sketch.project":"يجلب حواف النموذج وأوجهه ورؤوسه ومنحنيات رسوم أخرى إلى هذا الرسم، مسقطة على مستواه. تبقى مرتبطة وتتبع النموذج عندما يتغير.","help.sketch.project_to_surface":"يسقط منحنيات رسوم أخرى على وجه في اتجاه العمودي على مستوى هذا الرسم، كمنحنيات ثلاثية الأبعاد مرتبطة. استخدمه لوضع شعار أو خط تقسيم أو مسار على سطح منحنٍ.","help.sketch.rectangle.center":"يرسم مستطيلًا من مركزه وأحد أركانه. استخدمه للمحيطات المتمركزة على نقطة، مثل نقطة الأصل.","help.sketch.rectangle.rounded":"يرسم مستطيلًا بأركان أربعة مدوّرة بنصف قطر واحد. استخدمه للألواح والأغطية والفتحات ذات الأركان المدوّرة.","help.sketch.rectangle.three_point":"يرسم مستطيلًا من حافة واحدة ونقطة على الجانب المقابل. استخدمه للمستطيلات المائلة عن محاور الرسم.","help.sketch.rectangle.two_point":"يرسم مستطيلًا من ركنين متقابلين. استخدمه لمحيطات الألواح والكتل والجيوب.","help.sketch.scale":"يغيّر مقياس منحنيات الرسم ونقاطه بمعامل حول نقطة أساس. استخدمه لتغيير حجم جزء من الرسم دون إعادة رسمه.","help.sketch.slot.arc_center":"يرسم شقًا منحنيًا بعرض محدد على امتداد قوس يُحدد بمركزه وبدايته ونهايته. استخدمه لشقوق الضبط حول محور.","help.sketch.slot.arc_three_point":"يرسم شقًا منحنيًا بعرض محدد على امتداد قوس يمر بثلاث نقاط. استخدمه عندما يجب أن يمر مسار الشق بنقاط محددة.","help.sketch.slot.center_point":"يرسم شقًا مستقيمًا بعرض محدد من مركزه إلى مركز قوس أحد طرفيه. استخدمه للشقوق المتمركزة على نقطة.","help.sketch.slot.center_to_center":"يرسم شقًا مستقيمًا بعرض محدد بين مركزي قوسي طرفيه. استخدمه للشقوق المقيّسة من مركز إلى مركز، مثل شقوق ضبط البراغي.","help.sketch.slot.overall":"يرسم شقًا مستقيمًا بعرض محدد من طرفه الخارجي إلى الطرف الآخر. استخدمه عندما يكون الطول الكلي للشق هو المهم.","help.sketch.spline.control_point":"يرسم منحنى شريحيًا تكعيبيًا يتشكل بنقاط تحكم لا يمر بها. استخدمه للمنحنيات الناعمة المنسابة التي تشكلها بتحريك النقاط.","help.sketch.spline.control_point_5":"يرسم منحنى شريحيًا من الدرجة 5 يتشكل بنقاط تحكم. استخدمه حيث يجب أن تلتقي المنحنيات بانحناء أنعم، مثلًا على الأسطح الظاهرة ذات التصميم الانسيابي.","help.sketch.spline.fit_point":"يرسم منحنى شريحيًا ناعمًا يمر بكل نقطة تضعها، مفتوحًا أو مغلقًا. استخدمه لتتبع شكل عبر نقاط معروفة.","help.sketch.spline3d":"يرسم منحنى ناعمًا في الفراغ عبر نقاط، مع تفعيل الرسم ثلاثي الأبعاد. استخدمه لمسارات الكنس ومسارات الكابلات الخارجة عن مستوى الرسم.","help.sketch.spun_profile":"ينشئ في مستوى الرسم المحيط الذي يمسحه جسم عند دورانه حول محور. استخدمه للحصول على صورة ظلية لقطعة مشغولة بالخراطة من أجل أمر «دوران» أو مخطط.","help.sketch.text":"يكتب نصًا في الرسم بخط وارتفاع وزاوية تختارها، ويمكن لكلماته أن تتبع المعلمات. ابثقه أو حوّله إلى نقش بارز للملصقات والكتابة.","help.sketch.transform":"يغيّر مقياس هندسة الرسم ويدوّرها ويحرّكها حول نقطة مركز بخطوة واحدة. استخدمه لإعادة وضع تحديد وتغيير حجمه معًا.","help.sketch.trim":"يزيل الجزء من المنحنى بين أقرب نقطتي تقاطع حول موضع نقرتك. استخدمه لتنظيف الخطوط المتداخلة وتحويلها إلى مقطع مغلق.","help.solid.align":"يحرّك الأجسام المحددة بحيث تلتقي نقطة أو وجه أو مستوى منها بنقطة أو وجه أو مستوى في مكان آخر. استخدمه لوضع قطعة ملاصقة لأخرى دون قياس المسافة.","help.solid.boundary_fill":"ينشئ أجسامًا صلبة من المناطق التي تحيط بها أجسام أدوات متداخلة، مع تعبئة المناطق التي تختارها فقط. استخدمه لبناء شكل من الحيز الذي تحدّه عدة أجسام معًا.","help.solid.bounding_solid":"ينشئ صندوقًا يحيط بالأجسام المحددة، مع هامش اختياري. استخدمه لمعرفة الأبعاد الكلية لقطعة أو كخامة أولية تُشغّل منها.","help.solid.box":"ينشئ صندوقًا بطول وعرض وارتفاع، انطلاقًا من نقطة ركن أو متمركزًا حول نقطة. استخدمه لإنشاء كتلة سريعة أو شكل مؤقت أو جسم تُقطع فيه ميزات.","help.solid.chamfer":"يقطع الحواف المحددة بشطفة مستوية بالمسافة التي تحددها. استخدمه لكسر الحواف الحادة أو لتسهيل إدخال مسمار أو برغي.","help.solid.coil":"ينشئ جسمًا حلزونيًا مثل النابض من قطر وعدد لفات وارتفاع أو خطوة، وبمقطع دائري أو مربع. استخدمه للنوابض والملفات والنتوءات الحلزونية.","help.solid.combine":"يضم الأجسام، أو يقتطعها من جسم هدف، أو يُبقي الحجم المشترك بينها فقط، ويمكنه الاحتفاظ بأجسام الأداة. استخدمه لدمج القطع، أو لقطع شكل بشكل آخر، أو لمعرفة موضع تداخل جسمين.","help.solid.cone":"ينشئ مخروطًا من دائرة قاعدة وارتفاع، أو مخروطًا ناقصًا عند تحديد نصف قطر للقمة أيضًا. استخدمه للأشكال المستدقة والقمع والتجاويف المخروطية والرؤوس المدببة.","help.solid.cylinder":"ينشئ أسطوانة بنصف قطر أو قطر وارتفاع، قائمة عند نقطة على امتداد محور. استخدمه للأعمدة والدبابيس والنتوءات الدائرية والخامات الأسطوانية.","help.solid.draft":"يميل الأوجه المحددة بالزاوية التي تحددها، مقيسةً من مستوى محايد. استخدمه في القطع المقولبة أو المصبوبة كي تخرج من القالب بسهولة.","help.solid.emboss":"يبرز مقاطع رسم مثل نص أو شعار من وجه، أو يغورها فيه. استخدمه للكتابات والتسميات والعلامات على الوجوه المستوية أو المستديرة.","help.solid.extrude":"يدفع مقطع رسم إلى ثلاثي الأبعاد على مسافة محددة، بإضافة مادة أو إزالتها. استخدمه لتحويل مخطط مسطح إلى كتلة أو نتوء أو تجويف.","help.solid.fillet":"يقوّس الحواف المحددة بانحناء دائري ناعم بنصف القطر الذي تحدده. استخدمه لتنعيم الحواف الحادة من أجل المتانة أو الراحة أو المظهر.","help.solid.hole":"يحفر ثقبًا دائريًا بالقطر الذي تحدده عند نقطة مختارة على وجه. استخدمه لفتحات البراغي والمسامير والفتحات الدائرية البسيطة الأخرى.","help.solid.loft":"يصنع جسمًا صلبًا ناعمًا ينتقل بين مقطعي رسم أو أكثر، أو من مقطع إلى نقطة. استخدمه للانتقالات والأقماع والمقابض وأي شكل يتغير مقطعه على طوله.","help.solid.mirror":"يصنع نسخة معكوسة من الأجسام أو الميزات المحددة عبر مستوى، ويمكنه دمجها مع الأصل. استخدمه للقطع المتماثلة، فتنمذج نصفًا واحدًا وتحصل على الاثنين.","help.solid.move":"يحرّك الأجسام المحددة أو يدوّرها، أو نسخة منها، بالمسافة والزاوية اللتين تحددهما. استخدمه لتغيير موضع جسم أو لإنشاء جسم ثانٍ في مكان آخر.","help.solid.offset_face":"يدفع الأوجه المحددة إلى الداخل أو الخارج بالمسافة التي تحددها، وتتبعها الأوجه المحيطة. استخدمه لزيادة سماكة جدار أو عمق جيب أو ارتفاع نتوء دون تعديل الرسم.","help.solid.pattern.circular":"يكرر العناصر المحددة حول محور، بالعدد والزاوية الكلية اللذين تحددهما. استخدمه لدوائر البراغي والأذرع والزعانف والأسنان.","help.solid.pattern.path":"ينسخ ميزات أو أجسامًا على امتداد مسار رسم، بالعدد والتباعد. استخدمه لثقوب على حافة منحنية أو قطع على سكة.","help.solid.pattern.rectangular":"يكرر العناصر المحددة في اتجاه واحد أو اتجاهين بالعدد والتباعد اللذين تحددهما. استخدمه لصفوف الثقوب والأضلاع والمسامير والأرجل وشبكاتها.","help.solid.pipe":"ينشئ أنبوبًا دائريًا على مسار من منحنيات الرسم، مصمتًا أو مجوفًا بسماكة جدار محددة. استخدمه للأنابيب والأسلاك والكابلات والقضبان.","help.solid.press_pull":"يضيف المادة أو يزيلها حين تسحب وجهًا، أو يقوّس الحواف حين تسحبها. استخدمه لإجراء تعديلات سريعة على النموذج مباشرة.","help.solid.remove":"يُخرج الأجسام المحددة من التصميم بدءًا من هذه النقطة في السجل، وتحتفظ بها الخطوات السابقة. استخدمه للتخلص من جسم مساعد، مثل أداة قطع لم تعد تحتاجها.","help.solid.replace_face":"ينقل الأوجه المستوية المحددة إلى مستوى أو إلى وجه موازٍ، فيطول الجسم أو يقصر ليبلغه. استخدمه لجعل وجه مستويًا مع قطعة أخرى أو مع مستوى إنشائي.","help.solid.revolve":"يدير مقطع رسم حول محور لصنع جسم دائري. استخدمه للأعمدة والمقابض والأوعية وأي قطعة دائرية حول خط مركزي.","help.solid.rib":"يضيف ضلع تقوية رقيقًا على امتداد منحنى رسم مفتوح، ممتدًا حتى الوجوه التالية للجسم. استخدمه لتقوية الجدران والزوايا، مثلًا في القطع المقولبة أو المطبوعة.","help.solid.scale":"يكبّر الأجسام المحددة أو يصغّرها بمعامل، متساوٍ في كل الاتجاهات أو مختلف لكل محور. استخدمه لتغيير حجم شكل مستورد أو لحساب الانكماش.","help.solid.shell":"يفرّغ الجسم الصلب تاركًا جدرانًا بالسماكة التي تحددها، ويمكنه فتح الأوجه التي تختارها. استخدمه للصناديق والأغطية والقطع الأخرى رقيقة الجدران.","help.solid.sphere":"ينشئ كرة بنصف قطر أو قطر حول نقطة مركز. استخدمه للكرات والمقابض والنهايات المستديرة.","help.solid.split_body":"يقسم جسمًا إلى أجسام منفصلة بمستوى أو بوجه جسم آخر أو بخط من رسم. استخدمه لصنع قطع تُطبع أو تُشغَّل أو تُلوَّن كلٌّ على حدة.","help.solid.split_face":"يقسم الأوجه المحددة على طول مستوى أو وجه جسم آخر أو منحنيات رسم، دون قطع الجسم. استخدمه لإعطاء جزء من وجه ميلًا أو لونًا أو إزاحة خاصة به.","help.solid.sweep":"يسحب مقطع رسم على طول مسار لصنع جسم صلب. استخدمه للأنابيب والقضبان والمقابض وأي قطعة ثابتة المقطع تتبع منحنى.","help.solid.thread":"يضيف قلاوظًا متريًا بمعيار ISO إلى وجه أسطواني، إما كتمثيل شكلي أو محفورًا في الجسم. استخدمه للبراغي والثقوب الملولبة والقطع اللولبية المطبوعة.","help.solid.torus":"ينشئ حلقة بنصف قطر رئيسي حول محورها ونصف قطر ثانوي لمقطعها الدائري. استخدمه لحلقات منع التسرب والمقابض والنتوءات الحلقية المستديرة.","help.solid.web":"يضيف جسر تقوية رقيقًا على امتداد كل منحنى رسم مفتوح، يمتد كل منها حتى الوجوه التالية للجسم. استخدمه لإنشاء شبكة من الجدران الداعمة داخل الأغلفة والصواني.","help.surface.blend":"ينشئ سطحًا يصل بين حواف جسمين، مماسًّا أو متصل الانحناء مع كليهما. استخدمه لوصل سطحين بنعومة عبر فجوة.","help.surface.boundary":"ينشئ سطحًا يملأ حلقة من منحنيين إلى أربعة منحنيات رسم، أو شبكة من المنحنيات. استخدمه للوحات حرة الشكل تحددها حوافها.","help.surface.extend":"يمدّد سطحًا إلى ما بعد حوافه، بمسافة أو حتى مستوى أو وجه. استخدمه لكي تتداخل الأسطح قبل القص أو الخياطة.","help.surface.extrude":"يدفع منحنيات أو مقاطع رسم مسافة محددة لتكوين سطح، جدران فقط بلا أغطية. استخدمه للجدران الرقيقة وأدوات القطع أو التقسيم.","help.surface.fair":"ينعّم داخل الأوجه حرة الشكل مع بقاء حوافها ثابتة. استخدمه لتسوية النتوءات والانعكاسات المتموجة في السطح.","help.surface.loft":"ينشئ سطحًا يمر عبر مقطعين أو أكثر بالترتيب، بلا أغطية. استخدمه للأغلفة والانتقالات بين أشكال مختلفة.","help.surface.match":"يعيد بناء حافة سطح لتلتقي بحافة جسم آخر، بمماسية أو انحناء متطابق. استخدمه لإغلاق درزة بنعومة بين سطحين.","help.surface.offset":"ينشئ نسخة من الأوجه على مسافة على امتداد اتجاهاتها العمودية، كجسم سطحي جديد. استخدمه للأغلفة أو الخلوصات أو الجانب الآخر من جدار.","help.surface.patch":"يملأ منطقة رسم أو حلقة مغلقة من الحواف بوجه، مسطح أو منحنٍ بنعومة. استخدمه لسدّ الثقوب في جسم سطحي.","help.surface.reverse_normal":"يقلب أوجه جسم سطحي بحيث يتجه سطحها الخارجي إلى الجهة الأخرى. استخدمه قبل التثخين أو الخياطة حين تتجه الأوجه إلى الداخل.","help.surface.revolve":"يدير منحنيات أو مقاطع رسم حول محور ليكوّن سطحًا، بلا أغطية. استخدمه للأغلفة المستديرة مثل أباجورات المصابيح والأوعية والفوهات.","help.surface.ruled":"ينشئ شريطًا من خطوط مستقيمة ممتدة من سلسلة حواف، باتجاه عمودي الوجه أو مماسه أو بزاوية. استخدمه لجدران الميل وأسطح الامتداد وأسطح الفصل.","help.surface.stitch":"يخيط أجسامًا سطحية معًا على امتداد حوافها المشتركة، وتصبح جسمًا صلبًا إذا أغلقت. استخدمه لتحويل مجموعة أسطح إلى جسم واحد.","help.surface.sweep":"يحرّك منحنيات أو مقاطع رسم على امتداد مسار لتكوين سطح، بلا أغطية. استخدمه للمزاريب والأشرطة الزخرفية وسائر الأشكال الرقيقة التي تتبع مسارًا.","help.surface.thicken":"يمنح جسمًا سطحيًا سماكة ويحوّله إلى جسم صلب. استخدمه لصنع قطع قابلة للطباعة أو التشغيل من الأسطح.","help.surface.trim":"يقص سطحًا بمستوى أو سطح آخر أو منحنيات رسم، ويبقي الجانب الذي تختاره. استخدمه لقص الأسطح إلى الشكل المطلوب قبل الخياطة.","help.surface.unstitch":"يفصل أوجه جسم إلى أجسام سطحية مستقلة؛ فيتفكك الجسم الصلب إلى أسطح. استخدمه لإعادة العمل على أوجه مفردة من جسم.","help.surface.untrim":"يزيل الثقوب من وجه، أو يستعيد حدوده الخارجية إلى الحدود الطبيعية للسطح. استخدمه لاستعادة السطح الكامل بعد القص.","help.third_party":"رخص الأطراف الثالثة","help.timeline.compute_all":"يعيد بناء كل ميزة في السجل من البداية. استخدمه لتحديث النموذج ولمعرفة الميزات التي تفشل.","help.timeline.delete":"يحذف الميزات المحددة من السجل، وحذف رسمٍ يحذف معه الميزات المبنية عليه. استخدمه لإزالة خطوة لم تعد مطلوبة.","help.timeline.dependents":"يسرد الميزات التي ستُحذف مع ميزة ما، وتلك التي ستفشل بدونها. استخدمه قبل حذف ميزة أو تغييرها.","help.timeline.play":"أعد تشغيل الميزات المتبقية واحدة تلو الأخرى، مع توقف لمدة نصف ثانية بعد كل إعادة بناء. شغّل هذا الأمر مرة أخرى أو اضغط Escape للإيقاف؛ ينتقل «الذهاب إلى النهاية» فورًا إلى النهاية.","help.view.apply":"يدير العرض إلى اتجاه قياسي مثل الأمامي أو العلوي أو الأيزومتري، أو إلى عرض مسمّى محفوظ. استخدمه للنظر إلى النموذج من زاوية ثابتة.","help.view.delete":"يحذف عرضًا مسمّى محفوظًا. لا يتغير النموذج.","help.view.fit":"يضبط التكبير ويُزيح العرض حتى يملأ النموذج كله أو التحديد منطقة العرض. استخدمه حين يخرج النموذج من مجال الرؤية.","help.view.grid":"يُظهر الشبكة في منطقة العرض أو يخفيها. استخدمها كدليل للحجم والاتجاه أثناء النمذجة.","help.view.ground_shadow":"يُظهر ظل النموذج على الأرض أو يخفيه. استخدمه لتقدير الارتفاع والموضع بسهولة أكبر.","help.view.home":"يعيد العرض إلى الاتجاه الرئيسي ويلائم النموذج. استخدمه للعودة سريعًا إلى عرض معروف.","help.view.list":"يسرد العروض المسمّاة المحفوظة في التصميم. استخدمه للعثور على عرض حفظته سابقًا.","help.view.navigate":"يدير العرض أو يُزيحه أو يغيّر تكبيره بخطوات، مثل ربع دورة إلى اليسار. استخدمه لتحريك الكاميرا بدقة بدلًا من السحب.","help.view.navigation_bar":"يُظهر شريط التنقل أسفل منطقة العرض أو يخفيه. أخفِه لمساحة أكبر، وأظهره للوصول إلى أدوات العرض بالفأرة.","help.view.rename":"يمنح عرضًا مسمّى محفوظًا اسمًا جديدًا. يبقى العرض نفسه كما هو.","help.view.save":"يحفظ موضع الكاميرا الحالي كعرض مسمّى في التصميم. استخدمه للعودة إلى الزاوية نفسها لاحقًا، مثلًا للقطات الشاشة.","help.view.spin":"يدوّر العرض حول النموذج باستمرار حتى النقرة أو المفتاح التالي. استخدمه لعرض النموذج من جميع الجهات.","help.view.tool":"يثبّت أداة كاميرا، التدوير أو الإزاحة أو التكبير، بحيث يحرّك السحب بزر الفأرة الأيسر العرض حتى توقفها. استخدمه على لوحة اللمس أو بدون زر فأرة أوسط.","help.view.visual_style":"يبدّل طريقة رسم النموذج: مظلَّل مع الحواف أو بدونها، أو إطار سلكي، أو مع الحواف المخفية. استخدم الإطار السلكي لرؤية الداخل، والمظلَّل لمظهر نظيف.","history.sketch_under_constrained":"قيود ناقصة ({count} درجات حرية)","history.sketch_under_constrained_one":"قيود ناقصة ({count} درجة حرية)","hole_presets.confirm_delete":"تأكيد الحذف","hole_presets.delete":"حذف","hole_presets.delete_prompt":"هل تحذف هذا الإعداد المسبق الشخصي؟ الثقوب الموجودة لا تتغير.","hole_presets.full":"المكتبة الشخصية فيها 64 إعدادًا مسبقًا بالفعل.","hole_presets.invalid_name":"أدخل اسمًا قصيرًا بلا فواصل أسطر ولا محارف تحكم.","hole_presets.invalid_parameters":"أكمل معاملات الثقب بتعابير صالحة وبطول معقول.","hole_presets.missing":"الإعداد المسبق المحدد لم يعد متاحًا.","hole_presets.name":"اسم الإعداد المسبق","hole_presets.name_exists":"يوجد إعداد مسبق بهذا الاسم. استخدم اسمًا آخر.","hole_presets.name_hint":"اسم فريد","hole_presets.overwrite":"حفظ التغييرات في الإعداد المسبق المحدد","hole_presets.preset":"الإعداد المسبق","hole_presets.recall":"استدعاء","hole_presets.rename":"إعادة تسمية","hole_presets.save":"حفظ كجديد","hole_presets.scope":"محفوظ في ملفك الشخصي لكل المشاريع.","hole_presets.select":"اختر إعدادًا مسبقًا","hole_presets.title":"الإعدادات المسبقة الشخصية","hole_presets.unsupported_options":"يستخدم هذا الإعداد المسبق خيارات سن لولبي لا يستطيع هذا الإصدار استدعاءها.","hole_presets.unsupported_overwrite":"يحتوي هذا الإعداد المسبق على خيارات لا يمكن الكتابة فوقها بأمان.","home.back":"العودة إلى {name}","home.crashes":"تقارير الأعطال","home.design_workspace":"التصميم","home.documentation":"التوثيق","home.export":"تصدير","home.export_hint":"اختر صيغة للتصميم الحالي.","home.export_json_hint":"تصميم قابل للتعديل مع سجل الأوامر","home.export_mesh_hint":"شبكة للطباعة أو المشاركة","home.export_step_hint":"هندسة صلبة دقيقة","home.import":"استيراد…","home.import_hint":"STEP أو IGES أو شبكة في تصميم جديد","home.in_this_browser":"في هذا المتصفح","home.missing":"مفقود","home.month_01":"يناير","home.month_02":"فبراير","home.month_03":"مارس","home.month_04":"أبريل","home.month_05":"مايو","home.month_06":"يونيو","home.month_07":"يوليو","home.month_08":"أغسطس","home.month_09":"سبتمبر","home.month_10":"أكتوبر","home.month_11":"نوفمبر","home.month_12":"ديسمبر","home.new_inches":"تصميم جديد بالبوصة","home.new_inches_hint":"بالبوصة · يُفتح في التصميم","home.new_mm":"تصميم جديد","home.new_mm_hint":"بالمليمتر · يُفتح في التصميم","home.open":"فتح…","home.open_hint":"تصميم .sc ({shortcut})","home.open_now":"فتح الآن","home.opened_days_ago":"فُتح قبل {count} أيام","home.opened_hours_ago":"فُتح قبل {count} ساعة","home.opened_just_now":"فُتح الآن","home.opened_minutes_ago":"فُتح قبل {count} دقيقة","home.opening":"جارٍ الفتح…","home.properties":"خصائص التصميم","home.recent":"الأخيرة","home.recent_empty":"تظهر هنا التصاميم التي تفتحها أو تحفظها.","home.recovery_count":"التصاميم القابلة للاستعادة: {count}","home.recovery_empty":"لا توجد تصاميم قابلة للاستعادة.","home.recovery_hint":"أُغلق SolidCraft قبل حفظ هذه التصاميم.","home.report_issue":"الإبلاغ عن مشكلة","home.samples":"أمثلة","home.settings":"التفضيلات","home.short_date":"{day} {month}","home.shortcuts":"اختصارات لوحة المفاتيح","home.start_hint":"أنشئ تصميمًا، أو افتح ملفًا حديثًا، أو استكشف مثالًا.","home.whats_new":"ما الجديد","home.yesterday":"أمس","install.button_tip":"ثبّت SolidCraft كتطبيق: يُفتح في نافذته الخاصة ويعمل دون اتصال","install.dock_1":"اختر ملف › إضافة إلى Dock.","install.dock_2":"انقر إضافة.","install.dock_after":"بعدها يُفتح SolidCraft في نافذته الخاصة من Dock، ويعمل دون اتصال.","install.done":"تم","install.home_screen_1":"اضغط مشاركة (في قائمة … إن لم يكن في شريط الأدوات).","install.home_screen_2":"اختر إضافة إلى الشاشة الرئيسية.","install.home_screen_3":"اضغط إضافة.","install.home_screen_after":"بعدها يُفتح SolidCraft من أيقونته في الشاشة الرئيسية، بدون أشرطة Safari، ويعمل دون اتصال.","install.menu":"تثبيت التطبيق…","install.steps_intro":"يثبّت Safari تطبيقات الويب من قوائمه الخاصة:","install.title":"تثبيت SolidCraft","issue.body_label":"نص البلاغ","issue.note_changed_while_waiting":"تغيّرت الإعدادات أو النموذج أثناء انتظار المعاينة. أعد التقاط الشاشة لتحديث التفاصيل التقنية للعرض الحالي.","issue.note_details_kept":"التُقطت لقطة الشاشة محليًا. احتُفظ بالتفاصيل التقنية التي عدّلتها: تحقّق من أنها لا تزال تطابق العرض الحالي.","issue.note_details_updated":"حُدّثت التفاصيل التقنية لتطابق العرض الحالي. التُقطت لقطة الشاشة محليًا. راجعها قبل إرفاقها في GitHub.","issue.note_image_copied":"الصق الصورة في مسودة GitHub، أو احفظ ملف PNG إن لم يتوفر نسخ الصور.","issue.note_opened":"راجع مسودة GitHub وأرفق لقطة الشاشة. زر Submit new issue في GitHub ينشرها.","issue.note_opened_copied":"نُسخ البلاغ. الصقه في مسودة GitHub، وأرفق لقطة الشاشة، ثم انقر Submit new issue في GitHub.","issue.note_removed":"أُزيلت لقطة الشاشة من هذه المسودة.","issue.note_report_copied":"نُسخ البلاغ. الصقه في مسودة GitHub إن لزم.","issue.note_save_failed":"تعذّر حفظ لقطة الشاشة: {error}","issue.note_saved":"حُفظت لقطة الشاشة. أرفق ملف PNG في مسودة GitHub.","issue.save_screenshot":"حفظ لقطة الشاشة…","joint.from_bodies_hint":"ينتقل كل جسم مختار إلى مكوّن جديد خاص به ويبقى في مكانه.","joint.one_body":"كلا الاختيارين على {body}. اختر الثاني على قطعة أخرى.","joint.one_component":"هذه القطع أجسام لمكوّن واحد: {bodies}. المفصل يحرّك مكوّنًا مقابل آخر، لذا تحتاج كل قطعة إلى مكوّن خاص بها.","joint.rigid_group_one_component":"هذه الأجسام وعددها {count} كلها في مكوّن واحد (أو في التصميم نفسه): استخدم {command} أولًا.","joint.rigid_group_select_components":"اختر مكوّنين أو أكثر.","joint_move.blocked_hint":"تحقق من نوع المفصل (مثل المفصل الثابت)، وتثبيت الجزء، وحدود المفصل، والقيم التي تتحكم بها المعلمات.","joint_move.blocked_title":"لا يمكن تحريك هذا الجزء","joint_move.coarse":"خطوة الدوران قرب المحور (°)","joint_move.distance":"المسافة من نقطة البداية","joint_move.done":"تم","joint_move.fine":"خطوة الدوران بعيدًا عن المحور (°)","joint_move.fixed":"لا يملك هذا الجزء محور مفصل قابلًا للحركة.","joint_move.help":"تحريك — اسحب سهمًا أو قوسًا. يلغى السحب الحالي بمفتاح Esc.","joint_move.legacy_hint":"أوقف هذا الخيار لاستخدام لوحة التحريك السابقة.","joint_move.precision":"اسحب خارج الدليل المتقطع لضبط الدوران بدقة.","joint_move.rotation":"الدوران من نقطة البداية","joint_move.select":"اختر وجهًا أو جزءًا واحدًا من التجميع، ثم اختر تحريك.","joint_move.settings":"تحريك التجميع","joint_move.step":"الخطوة","joint_move.use_handles":"استخدام مقابض حركة المفاصل لتحريك التجميع","keymap.command_id":"معرّف الأمر","keymap.empty":"لا توجد أوامر مطابقة","keymap.use_anyway":"استخدام {key} هنا على أي حال","label.move_to_left_side":"نقل إلى الجانب الأيسر","label.move_to_right_side":"نقل إلى الجانب الأيمن","manage.appearance_hint":"اختر مظهرًا للت