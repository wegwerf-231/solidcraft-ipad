ر الرأس","parts.dimension.head_height":"ارتفاع الرأس","parts.dimension.height":"الارتفاع","parts.dimension.inner":"القطر الداخلي","parts.dimension.outer":"القطر الخارجي","parts.dimension.pitch":"الخطوة","parts.dimension.socket":"مقاس السداسي","parts.dimension.socket_depth":"عمق السداسي","parts.dimension.thickness":"السماكة","parts.dimension.width":"العرض","parts.family.bearing":"محمل كريات أخدودي عميق (الغلاف)","parts.family.button_head_cap_screw":"برغي برأس زرّي بتجويف سداسي","parts.family.dowel_pin":"مسمار توجيه أسطواني","parts.family.hex_bolt":"برغي سداسي الرأس","parts.family.hex_nut":"صامولة سداسية","parts.family.set_screw":"برغي تثبيت بتجويف سداسي، طرف مسطح","parts.family.socket_head_cap_screw":"برغي برأس أسطواني بتجويف سداسي","parts.family.washer":"حلقة مسطحة","parts.holes":"الثقوب (اختياري)","parts.placement_hint":"اختر ثقبًا أو أكثر لتثبيت قطعة في كل منها، أو اضغط موافق لوضعها عند نقطة الأصل","pattern.alignment_2":"المحاذاة 2","pattern.alignment_hint":"العدد يشمل الأصل. «توسيط» يوازن النسخ؛ و«قلب» يختار الجانب الإضافي عندما يكون العدد زوجيًا.","pattern.direction_1":"الاتجاه 1","pattern.direction_2":"الاتجاه 2","pattern.flip_direction":"قلب الاتجاه","perf.click_for_details":"انقر للتفاصيل: رسم زمن الإطار والمدرّج التكراري وما رسمته وحدة GPU","perf.draw_calls":"استدعاءات الرسم","perf.line_segments":"مقاطع الخطوط","perf.low_1":"أدنى 1%","perf.renderer":"المُصيّر","perf.scene_build":"بناء المشهد","perf.triangles":"المثلثات","perf.ui_time":"زمن الواجهة","perf.viewport":"منطقة العرض","perf.worst":"الأسوأ","pick a body or some of its faces":"حدد جسمًا أو بعض أوجهه","pick a hole to seat it, or OK places it at the origin":"اختر ثقبًا لتثبيته فيه، أو اضغط موافق لوضعه عند نقطة الأصل","pick a planar face":"حدد وجهًا مستويًا","pick a plane or a face as the tool":"حدد مستوى أو وجهًا ليكون الأداة","pick a size":"اختر مقاسًا","pick edges of a body":"حدد حوافّ جسم","pick edges of one body":"حدد حوافّ جسم واحد","pick edges of the holes to remove":"حدد حواف الثقوب المراد إزالتها","pick faces of one body":"حدد أوجه جسم واحد","pick faces to offset":"حدد الأوجه المراد إزاحتها","pick lines of one sketch":"حدد خطوطًا من رسم واحد","pick one or two vertices, edges or faces":"اختر رأسًا أو اثنين، أو حافة، أو وجهًا","pick one plane or face as the tool, or sketch curves":"حدد مستوى واحدًا أو وجهًا واحدًا ليكون الأداة، أو منحنيات رسم","pick sections in two or more sketches":"حدد مقاطع في رسمين أو أكثر","pick sketch curves or edges":"حدد منحنيات رسم أو حوافّ","pick the face to untrim":"حدد الوجه المراد إلغاء قصه","pick the path":"اختر المسار","pick what to keep":"حدد ما تريد الإبقاء عليه","pick what to keep of the other surface":"حدد ما تريد الإبقاء عليه من السطح الآخر","prefs.add_item":"إضافة العنصر","prefs.alt_frees_manipulators":"Alt / Option يحرر أسهم أدوات التحريك أيضًا","prefs.anti_aliasing_amd_dx12":"يستخدم تنعيم الحواف 1× لأن فحص بدء التشغيل لم يرسم شيئًا مع أخذ العينات المتعددة ونجح عند 1×. يمكنك اختيار إعداد آخر أعلاه؛ أعد التشغيل لتطبيقه إن نجح الفحص.","prefs.anti_aliasing_note":"ينعّم الحواف المسننة.","prefs.applies_on_restart":"يُطبَّق عند إعادة التشغيل","prefs.assistant":"المساعد","prefs.auto_operation":"اختيار العملية تلقائيًا","prefs.auto_operation_note":"تختار نوافذ الميزات «ضم» أو «جسم جديد» أو «قص» بحسب ما تلامسه المادة الجديدة، إلى أن تختار عملية بنفسك. عند الإيقاف: تحتفظ بالعملية التي تُفتح بها.","prefs.axes":"المحاور","prefs.axis":"المحور","prefs.bodies_folders":"مجلدات الأجسام","prefs.bodies_folders_always":"دائمًا","prefs.bodies_folders_never":"أبدًا","prefs.bodies_folders_several":"عند تعدد الأجسام فقط","prefs.bottom":"أسفل","prefs.bottom_centre":"أسفل الوسط","prefs.bottom_right":"أسفل اليمين","prefs.browser":"المستعرض","prefs.browser_eye_left":"أيقونة الإظهار بجانب سهم الطي","prefs.browser_eye_left_note":"تعرض صفوف المستعرض أيقونة الإظهار/الإخفاء بجانب سهم الطي كما كانت من قبل، بدلًا من عمود عند نهاية الصفوف.","prefs.browser_reveal_on_hover":"إظهار عند مرور المؤشر","prefs.browser_show_note":"«ظاهر» يُبقي المستعرض على الشاشة. «إظهار عند مرور المؤشر» يُخفيه حتى يمر المؤشر فوق مكانه أو فوق الشريط الرفيع عند حافته اليسرى، ويبقى مفتوحًا ما دام المؤشر داخله أو كانت قائمة منه مفتوحة.","prefs.browser_shown":"ظاهر","prefs.built_in":"مدمج","prefs.button_left":"سحب بالزر الأيسر","prefs.button_middle":"سحب بالزر الأوسط","prefs.button_right":"سحب بالزر الأيمن","prefs.choose_font":"اختيار ملف خط…","prefs.click":"نقر","prefs.contact_shading":"تظليل التلامس الناعم","prefs.contact_shading_note":"تظليل ناعم حيث تقترب القطع من بعضها.","prefs.context_menu":"القائمة السياقية","prefs.context_menu_ring":"القائمة السياقية · اضغط مطولًا للقائمة الدائرية","prefs.cpu":"المعالج (برمجي)","prefs.crash_reports":"فتح تقارير الأعطال…","prefs.crash_reports_note":"تُحفظ التقارير على هذا الحاسوب، مع التصميم والأوامر التي تعيد المشكلة.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"الأسطح المنحنية","prefs.curves":"الأسطح المنحنية","prefs.dark_parts_shading":"الحفاظ على شكل الأجزاء الداكنة","prefs.dark_parts_shading_help":"تظليل العرض بإضاءة خطية مع إضاءة سماء ناعمة، لتحتفظ الأوجه الداكنة بتدرج بدل أن تصبح سوداء","prefs.dead_zone_note":"الشريط المخطط هو المنطقة الميتة: تُتجاهل الحركة داخلها.","prefs.default":"افتراضي","prefs.design":"افتراضيات التصميم","prefs.design_note":"ما تبدأ به التصاميم الجديدة. التصاميم المفتوحة تحتفظ بإعداداتها.","prefs.devices":"الفأرة ثلاثية الأبعاد","prefs.dialog_buttons":"أزرار مربعات الحوار","prefs.dialogs":"الحوارات","prefs.dialogs_edge":"عند حافة العرض","prefs.dialogs_left_column":"في العمود الأيسر","prefs.dialogs_note":"مكان فتح حوارات الأوامر: مثبتة عند حافة العرض، أو في العمود الأيسر مكان المستعرض والسجل، اللذين يعودان كما كانا عند إغلاق الحوار.","prefs.display":"العرض","prefs.edges":"الحواف والتظليل","prefs.extend":"توسيع","prefs.extra_navigation":"Ctrl مع السحب بالزر الأيسر في مساحة فارغة يدوّر العرض، واضغط مطولًا على Space للإزاحة.","prefs.extrude_view_isometric":"التحويل إلى العرض المتساوي القياس عند فتح البثق","prefs.extrude_view_return":"العودة إلى العرض السابق عند إغلاق البثق","prefs.follows_os":"يتبع النظام","prefs.font":"الخط","prefs.font_fallback":"الرموز التي يفتقدها الخط المختار تُرسم بالخط المدمج، فلا تظهر أي تسمية كمربع فارغ.","prefs.font_sample":"نص تجريبي للخط · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"تعذّرت قراءة الخط المحدد.","prefs.general":"عام","prefs.general_note":"اللغة والحفظ والتحديثات.","prefs.gesture_orbit":"تدوير العرض","prefs.gesture_pan":"إزاحة العرض","prefs.gesture_zoom":"تكبير","prefs.graphics":"الرسوميات","prefs.graphics_card":"بطاقة الرسوميات","prefs.graphics_card_auto":"تلقائي","prefs.graphics_card_missing":"بطاقة الرسوميات المحفوظة غير متاحة؛ يُستخدم الخيار «تلقائي».","prefs.graphics_card_restart":"يُطبَّق بعد إعادة تشغيل SolidCraft. يتجاوز WGPU_ADAPTER_NAME هذا الاختيار.","prefs.graphics_card_unused":"لم تُستخدم بطاقة الرسوميات المحفوظة لهذه النافذة؛ البطاقة المستخدمة تظهر في «المساعدة › حول» وفي شريط الحالة. جرّب «تلقائي»، أو عيّن WGPU_ADAPTER_NAME إلى جزء فريد من اسم البطاقة.","prefs.graphics_note":"وازن بين السرعة والنعومة. كل خيار يعرض أثره على عيّنة.","prefs.graphics_presets_note":"الإعدادات المسبقة تضبط الخيارات أدناه معًا.","prefs.hide_constraint_glyphs_zoomed_out":"إخفاء رموز القيود عند التصغير","prefs.hide_constraint_glyphs_zoomed_out_note":"تختفي رموز القيود من العرض عندما يُصغَّر الرسم بقدر يجعلها تزحمه. معطّل: تبقى بحجم ثابت على الشاشة عند أي مستوى تكبير.","prefs.history":"السجل","prefs.history_origin_bodies":"إظهار الأصل والأجسام في الأعلى","prefs.history_origin_bodies_note":"يبدأ السجل على اليسار أو تحت المستعرض بمجلد الأجسام للمكوّن النشط وبالأصل، مع أيقونات الإظهار والقوائم كما في المستعرض. لا يتغير السجل في الأسفل.","prefs.history_play_button":"زر تشغيل السجل في عناصر تحكم السجل","prefs.history_play_button_note":"يضيف تشغيل السجل بين الرجوع خطوة والتقدم خطوة في عناصر تحكم السجل. يمكنك أيضًا النقر بزر الماوس الأيمن على عناصر التحكم لإظهاره أو إخفائه.","prefs.history_sketches":"الرسومات","prefs.history_sketches_in_order":"بالترتيب","prefs.history_sketches_note":"عند ضبط الرسومات على «تحت ميزتها»، يعرض السجل على اليسار كل رسم بمستوى واحد للداخل، تحت أول ميزة بُنيت منه، متى كان عريضًا بما يكفي لإظهار الأسماء. أما الخط الزمني في الأسفل فيحتفظ دائمًا بترتيب الإنشاء.","prefs.history_sketches_under_feature":"تحت ميزتها","prefs.hold_stop_snapping":"اضغط مطولًا لإيقاف الالتقاط","prefs.home_fit_size":"حجم العرض الرئيسي والملاءمة","prefs.home_fit_size_note":"مقدار ما يملؤه النموذج من العرض عندما يُظهره العرض الرئيسي أو الملاءمة أو تصميم مفتوح أو تغيير العرض من متصفح العرض، سواء كان الإعداد أدناه مفعّلًا أم لا. 100 %: يملأ العرض بين اللوحات والبوصلة وشريط التنقل.","prefs.icons_only":"أيقونات فقط","prefs.imported_file":"ملف مستورد","prefs.in_browser":"في المستعرض","prefs.input":"الإدخال","prefs.interface":"الواجهة","prefs.interface_language":"لغة الواجهة","prefs.interface_note":"شكل SolidCraft وأماكن أجزائه.","prefs.interval_minutes":"{n} دقيقة","prefs.invert_navigator_arrows":"عكس أسهم تدوير مكعب العرض","prefs.invert_navigator_arrows_note":"تدور الأسهم حول المكعب بالكاميرا حسب اتجاه السهم، كما في Fusion وInventor: السهم على اليسار يشير يميناً ويحرّك الكاميرا يميناً. عند الإيقاف: يدور السهم بالمكعب نحو الجهة التي يقع عليها، فيحرّك سهم اليسار الكاميرا يساراً. لا يتأثر سهما التدوير المنحنيان.","prefs.keep_work_on_tab_switch":"إبقاء مربعات الحوار والأدوات مفتوحة عند التبديل بين التصاميم","prefs.keep_work_on_tab_switch_note":"تحتفظ كل علامة تبويب تصميم بمربع الحوار أو الأداة المفتوحة، بما حددته وكتبته فيها، وبعلامة تبويب شريط الأدوات. وتجدها كما هي عند العودة إلى التصميم. عند الإيقاف: يؤدي التبديل بين التصاميم إلى إلغائها وعرض علامة التبويب «النموذج».","prefs.labels":"التسميات","prefs.language_system":"لغة النظام","prefs.layout":"التخطيط","prefs.layout_note":"المضغوط يثبّت اللوحات على حواف النافذة. شفافية المستعرض متاحة في الوضع العائم. غيّر جهة المساعد من صفحة المساعد.","prefs.left":"يسار","prefs.left_click":"نقر أيسر","prefs.line_drag_draws_one":"الضغط والسحب يرسم خطًا واحدًا","prefs.line_drag_draws_one_note":"في أداة الخط، الضغط ثم السحب ثم الإفلات يرسم خطًا واحدًا من نقطة الضغط إلى نقطة الإفلات وينتهي هناك. لا تزال النقرات ترسم سلسلة. عند الإيقاف: يضع السحب نقطة حيث يُفلت، كما تفعل النقرة.","prefs.line_hover_tangent_arc":"التوقف عند آخر نقطة في الخط للتبديل إلى قوس مماسي","prefs.line_hover_tangent_arc_note":"في أداة الخط، بعد رسم قطعة، ابتعد عن آخر نقطة في السلسلة ثم عد إليها وأبقِ المؤشر ثابتًا عليها: تحدد النقرة التالية نهاية قوس مماسي، والحركة نفسها تعيدك إلى الخطوط. عند الإيقاف: لا يحدث شيء عند التوقف هناك.","prefs.linked_designs":"التصاميم المرتبطة","prefs.live_input":"الإدخال المباشر","prefs.live_preview":"المعاينة المباشرة","prefs.logo":"الشعار","prefs.logo_accent":"لون التمييز","prefs.logo_theme":"ألوان السمة","prefs.max_file_size":"أكبر ملف يمكن فتحه","prefs.max_file_size_design":"ملفات التصميم","prefs.max_file_size_flag":"بدأ هذا التشغيل بالخيار --max-file-size {size}، ويسري حتى إغلاق SolidCraft. تسري هذه الإعدادات عند تشغيله دون هذا الخيار.","prefs.max_file_size_note":"القيم الافتراضية: 512 MB و256 MB؛ الحد الأقصى 16 GB. يتطلب فتح ملف ذاكرة تعادل حجمه عدة مرات. قد يحتاج التصميم الذي يحتفظ باستيراد كبير إلى حد أعلى لملف التصميم لحفظه وإعادة فتحه.","prefs.max_file_size_step":"ملفات STEP والاستيراد","prefs.max_file_size_web":"يفتح تطبيق الويب ملفات STEP والاستيراد حتى 512 MB والتصاميم حتى 256 MB؛ لا يتسع تبويب المتصفح لملفات أكبر. يمكن رفع هذه الحدود في تطبيق سطح المكتب.","prefs.megabytes":"MB","prefs.menu_grid":"أيقونات كبيرة","prefs.menu_list":"قائمة","prefs.menus":"القوائم","prefs.minutes":"دقائق","prefs.minutes_suffix":" دقيقة","prefs.mouse":"الفأرة ولوحة اللمس","prefs.mouse_heading":"الفأرة","prefs.mouse_mapping":"تعيين أزرار الفأرة","prefs.navigation":"التنقل","prefs.navigation_note":"كيف تحرك الفأرة ولوحة اللمس والفأرة ثلاثية الأبعاد العرض.","prefs.navigator_fit":"ملاءمة النموذج بعد تغيير العرض من متصفح العرض","prefs.navigator_fit_note":"النقر على وجه أو ركن أو سهم في المكعب، أو على محور في أداة المحاور، يوجّه العرض أيضًا نحو منتصف النموذج من المسافة الواحدة التي تُظهره كاملًا من كل جهة (كرته المحيطة). يستخدم العرض الرئيسي التكبير والمركز ذاتهما ما دام هذا مفعّلًا، فلا تغيّر العروض المختارة بعده سوى الاتجاه. عند الإيقاف: يدور العرض في مكانه محتفظًا بالهدف والتكبير.","prefs.network_host_remove":"إزالة","prefs.network_locations":"السماح بمواقع الشبكة في التصاميم","prefs.network_locations_note":"عند الإيقاف: الملفات المرتبطة بالتصميم على حاسوب آخر (\\\\server\\share) لا تُفتح إلا من الخوادم المدرجة هنا، أو بعد أن تسمح لأحدها عند السؤال.","prefs.network_locations_section":"مواقع الشبكة","prefs.not_on_gpu":"غير متاح على هذا المعالج الرسومي","prefs.on":"تشغيل","prefs.opaque":"معتم","prefs.orbit_snap":"اضغط Shift أثناء التدوير للالتقاط على محور.","prefs.orientation":"الاتجاه","prefs.origin_plane_names":"أسماء مستويات الأصل","prefs.origin_plane_names_note":"الأسماء المعروضة في المستعرض والحوارات والقوائم. {top} هو XY و{front} هو XZ و{right} هو YZ، والمحور Z للأعلى. تحتفظ الأوامر والسكربتات والتصاميم المحفوظة بـ XY وXZ وYZ.","prefs.overall_speed":"السرعة العامة","prefs.parameter_list_rows":"صفوف قائمة المعاملات","prefs.parameter_list_rows_tip":"يعرض السهم لأسفل في حقل قيمة فارغ المعاملات، المفضلة أولًا، حتى هذا العدد. العدد الأقل يبقي القائمة خفيفة في التصميم الكبير.","prefs.persistent_ribbon_pressed":"تمييز أوامر الشريط النشطة","prefs.persistent_ribbon_pressed_help":"تمييز أوامر الشريط أثناء تفعيل تأثيراتها. أوقف هذا الخيار للاحتفاظ بالمظهر المحايد السابق ومساعدة الأوامر.","prefs.perspective_fov":"مجال الرؤية","prefs.placement":"الموضع","prefs.prefer_free_sketch_points":"تفضيل نقاط الرسم القابلة للتحريك عند تداخل النقاط","prefs.preview_choices":"معاينة اختياراتك","prefs.print_face_highlight":"إبراز وجه الطباعة","prefs.print_face_highlight_tip":"مدى قوة تلوين وجه الطباعة للجسم ورسم حدوده في العرض. القيمة 0 % لا تُظهر أي إبراز.","prefs.profile_active":"ملف التعريف النشط","prefs.profile_applied":"تم تطبيق ملف التعريف.","prefs.profile_changed":"تغيّرت الإعدادات منذ حفظ ملف التعريف. «حفظ» يحفظها فيه.","prefs.profile_deleted":"تم حذف ملف التعريف.","prefs.profile_export":"تصدير…","prefs.profile_exported":"تم تصدير ملف التعريف.","prefs.profile_imported":"تم استيراد ملف التعريف. اختره في «ملف التعريف النشط» للتبديل إليه.","prefs.profile_name_hint":"اسم ملف التعريف، مثل: حاسوب محمول","prefs.profile_rename":"إعادة تسمية","prefs.profile_renamed":"تمت إعادة تسمية ملف التعريف.","prefs.profile_save":"حفظ","prefs.profile_saved":"تم حفظ الإعدادات الحالية في ملف التعريف.","prefs.profile_skipped":"تم تطبيق ملف التعريف؛ احتفظ {n} من الإعدادات بقيمها الحالية (راجع السجل).","prefs.profiles":"ملفات تعريف الإعدادات","prefs.profiles_note":"الاختصارات وشريط الأدوات والتنقل والقائمة الدائرية وإعدادات الواجهة، محفوظة معًا تحت اسم واحد وتُبدَّل دفعة واحدة.","prefs.project_options_dialog":"مربع حوار خيارات الإسقاط","prefs.project_options_dialog_note":"تشغيل: اختر الهندسة أو الأجسام ورابط الإسقاط قبل الإسقاط. إيقاف: الإبقاء على سير العمل السابق بالاختيار المباشر.","prefs.quality_default":"افتراضي","prefs.quality_fastest":"الأسرع","prefs.quality_slowest":"الأبطأ","prefs.quality_smoother":"أنعم","prefs.quick_measure":"قياس سريع في زاوية العرض","prefs.quick_measure_note":"مقاس العناصر المحددة في الزاوية اليمنى السفلية من العرض: طول الحافة (أو Ø وR للحافة الدائرية)، ومساحة الوجه، وموضع النقطة، والمسافة والزاوية بين عنصرين، ومجموع عدة حواف أو أوجه. النقر ينسخه.","prefs.render_previous_geometry_budget":"استخدام ميزانية الهندسة السابقة لمعاينة التصيير","prefs.render_previous_geometry_budget_help":"استعادة حد الهندسة الثابت السابق (512 ميبيبايت على سطح المكتب 64 بت، و128 ميبيبايت على المنصات الأخرى) بدلًا من الميزانية المعتمدة على الجهاز.","prefs.reports_saved":"{n} محفوظة","prefs.ribbon_click_ends_tool":"النقر على زر الأداة قيد التشغيل ينهيها","prefs.ribbon_click_ends_tool_note":"النقر على زر الشريط المضيء لأداة الرسم المستخدمة ينهي الأداة، فيعود النقر في العرض إلى التحديد. عند الإيقاف: يبدأ النقر الأداة من جديد.","prefs.ribbon_reveal":"إظهار مكان نتائج البحث في الشريط","prefs.ribbon_reveal_note":"عند تمرير المؤشر فوق نتيجة في «البحث في الأوامر» يظهر مكان الأمر في الشريط: تبويبه أو زره أو صفه في القائمة المنسدلة للوحة. ويومض هناك الأمر الذي بدأ من البحث، ويُعلِّم الأمر الجاري من قائمة منسدلة لوحتَه.","prefs.right_click":"نقر أيمن","prefs.saving":"الحفظ التلقائي والاستعادة","prefs.scale_note":"أو Ctrl + / Ctrl − في النافذة. الأزرار 28 px عند 100%.","prefs.scale_text":"الحجم والنص","prefs.search":"البحث في الإعدادات","prefs.search_empty":"لا توجد إعدادات مطابقة","prefs.select":"تحديد","prefs.select_one_item":"تحديد عنصر واحد","prefs.select_other_hidden":"تحديد العناصر الهندسية المخفية باستخدام «تحديد عنصر آخر»","prefs.select_other_hidden_help":"عند التفعيل: تضمين الأجسام والمخططات المخفية والحواف المحجوبة قرب المؤشر. عند التعطيل: استخدام القائمة الأصلية للعناصر الهندسية المرئية أسفل المؤشر.","prefs.selecting":"التحديد","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift يضيف فقط، وCtrl / Cmd يبدّل","prefs.shift_add_note":"عند التشغيل: Shift يضيف، وCtrl / Cmd يبدّل. عند الإيقاف (الافتراضي): كلاهما يبدّل.","prefs.shortcuts":"الاختصارات","prefs.single_surface_analysis":"استخدام تحليل سطح واحد","prefs.single_surface_analysis_help":"عند إيقاف هذا الخيار، يمكن إبقاء تظليل السطح وتحليل الاستمرارية مفعّلين معًا. عند تشغيله، يبقى آخر تحليل تم بدؤه أو تغييره فقط.","prefs.sketch_align_points":"المحاذاة مع نقاط الرسم الأخرى أثناء الرسم","prefs.sketch_align_points_note":"أثناء الرسم، تتحاذى النقطة أفقيًا مع نقطة رسم وعموديًا مع نقطة أخرى في الوقت نفسه، مع خط إرشادي منقط، وتحتفظ النقرة بالمحاذاتين. عند الإيقاف: مع النقطة السابقة فقط، محور واحد في كل مرة.","prefs.sketch_conflict_colour":"الهندسة المتعارضة بلون التعارض","prefs.sketch_conflict_colour_note":"عندما تتعارض قيود الرسم، تُرسم المنحنيات والنقاط التي يمسكها قيد فاشل بلون التعارض أيضًا، لا رمزه أو بُعده فقط. عند الإيقاف: تحتفظ بألوانها المعتادة.","prefs.sketch_construction_lines":"أدوات الخطوط الإنشائية الموسعة","prefs.sketch_exit_view":"عند انتهاء الرسم","prefs.sketch_exit_view.keep":"إبقاء العرض الحالي","prefs.sketch_exit_view.previous":"العودة إلى العرض السابق","prefs.sketch_exit_view.unless_rotated":"العودة ما لم يُدوَّر العرض","prefs.sketch_exit_view_note":"أين ينتقل العرض بعد إنهاء الرسم أو الإلغاء أو الضغط على Esc مرتين.","prefs.sketch_face_activates_part":"الرسم على وجه جزء يجعل ذلك الجزء نشطًا","prefs.sketch_face_activates_part_note":"الرسم الذي يبدأ على وجه جسم في مكوّن آخر ينشّط ذلك المكوّن أولًا، فينتمي الرسم إليه ويبقى مع ذلك الجزء في المستعرض. ويبقى الجزء نشطًا بعد ذلك. عند الإيقاف: ينتمي الرسم إلى المكوّن النشط.","prefs.sketch_open_look_at":"توجيه العرض نحو الرسم عند فتحه","prefs.sketch_open_look_at_note":"عند الإيقاف: إنشاء الرسم أو تحريره يُبقي العرض كما هو. يوجّه «النظر إلى» العرض نحو الرسم عند الحاجة.","prefs.sketch_recent_snap":"الالتقاط التلقائي إلى المراكز ونقاط المنتصف الأخيرة","prefs.sketch_recent_snap_note":"أثناء الرسم، يلتقط المؤشر الموضع الذي يتقاطع فيه دليلا آخر مركزي دائرتين أو نقطتي منتصف حافتين مستقيمتين. عند الإيقاف: تبقى تلك الأدلة للعرض فقط ولا يتحرك المؤشر.","prefs.sketch_selection":"الرسم والتحديد","prefs.sketch_selection_heading":"الرسم والتحديد","prefs.sketch_selection_note":"كيف تلتقط الرسومات وكيف تحدد النقرات.","prefs.sketch_state_icons":"أيقونات الرسومات بلون حالتها","prefs.sketch_state_icons_note":"في السجل والمستعرض، تأخذ أيقونة الرسم لون حالته (قيود ناقصة، مقيّد بالكامل أو متعارض) ويذكر تلميحه الحالة. عند الإيقاف: لكل الرسومات الأيقونة نفسها.","prefs.sketch_tab_always":"إبقاء تبويب الرسم ظاهرًا","prefs.sketch_tab_always_note":"يبقى تبويب الرسم في الشريط بعد تبويب النموذج مباشرة حتى عندما لا يكون أي رسم مفتوحًا. عندها تبدأ أدوات الرسم فيه رسمًا على المستوي أو الوجه المحدد، أو على المستوي الذي تختاره بعد ذلك، وتكون الأداة جاهزة فيه.","prefs.sketch_tracking_guides":"أدلة محاذاة المراكز ونقاط المنتصف","prefs.sketch_tracking_guides_note":"مرّر المؤشر فوق مركز دائرة أو نقطة منتصف حافة مستقيمة، ثم حرّكه أفقيًا أو عموديًا لإظهار دليل منقّط مؤقت.","prefs.sketch_tracking_points":"أدلة محاذاة من نقاط النهاية والزوايا أثناء الرسم","prefs.sketch_tracking_points_note":"عندما تنتظر أداة رسم نقطة، يؤدي تمرير المؤشر فوق نهاية خط أو قوس أو زاوية مستطيل أو نقطة حرة إلى إظهار الدليل المنقّط المؤقت نفسه الذي يظهر للمركز أو نقطة المنتصف. عند الإيقاف: المراكز ونقاط المنتصف فقط.","prefs.sketching":"الرسم","prefs.snap_drawing_note":"أثناء الرسم أو سحب نقطة في الرسم.","prefs.source":"المصدر","prefs.speed":"السرعة","prefs.stand_up_note":"بعد فتح ملف STEP أو IGES ومحوره Z للأعلى، يُعرض تدويره ربع دورة حول X.","prefs.stand_up_unknown":"للملفات من برامج غير معروفة","prefs.stand_up_unknown.ask":"السؤال في مربع حوار","prefs.stand_up_unknown.note":"عرض ملاحظة","prefs.stand_up_unknown.off":"عدم العرض","prefs.stand_up_unknown_note":"طريقة العرض عندما لا يذكر رأس الملف برنامجًا معروفًا بحفظ المحور Y للأعلى. تظهر الملاحظة فقط عندما يبدو أن الملف ملقى على ظهره؛ أما «السؤال في مربع حوار» فيسأل عن كل ملف كهذا، كما كان سابقًا.","prefs.status_bar":"شريط الحالة","prefs.status_bar_note":"شريط رفيع على الحافة السفلية للنافذة يعرض ما يجري تحريره، وحالة الرسم المفتوح بلونها، ووحدات التصميم؛ النقر على الوحدات يغيّرها. عندها لا تظهر حالة الرسم في زاوية العرض.","prefs.status_done":"تم","prefs.status_error":"خطأ","prefs.status_selected":"محدد","prefs.status_warning":"تحذير","prefs.structure.appearance":"المظهر","prefs.structure.appearance_note":"الألوان والنصوص وإمكانية الوصول.","prefs.structure.in_profile":"ضمن ملف التعريف","prefs.structure.layout":"التخطيط","prefs.structure.layout_note":"مواضع أجزاء النافذة.","prefs.structure.look":"المظهر","prefs.structure.measure_pointer":"القياس والمؤشر","prefs.structure.mouse3d":"فأرة ثلاثية الأبعاد","prefs.structure.mouse3d_note":"SpaceMouse وSpaceNavigator.","prefs.structure.navigation_note":"الفأرة ولوحة اللمس. للفأرة ثلاثية الأبعاد صفحة خاصة بها.","prefs.structure.profile":"ملف التعريف","prefs.structure.profile_edited":"تغيّر منذ الحفظ","prefs.structure.profile_hover":"محفوظ في ملفات تعريف الإعدادات","prefs.structure.scale_percent":"{percent}%","prefs.structure.sketch":"رسم","prefs.structure.tools":"الأدوات","prefs.structure.tools_note":"كيفية عمل أدوات النمذجة.","prefs.structure.work":"العمل","prefs.supersampling_brief":"يرسم العرض بحجم أكبر ثم يصغّره: حاد جدًا لكنه أثقل.","prefs.tab_accent_note":"لون التمييز يتبع التبويب النشط","prefs.theme_file":"ملف السمة","prefs.theme_file_or_paste":"ملف أو لصق","prefs.theme_follow":"اتباع ملف سمة","prefs.theme_follow_error":"لم يُطبّق: {error}. تبقى آخر سمة سليمة مفعّلة.","prefs.theme_follow_launch":"يُتّبع لهذه الجلسة فقط (--theme-file)؛ يُعاد تحميله كلما أعادت أداة أخرى كتابته.","prefs.theme_follow_note":"يُعاد تحميله كلما أعادت أداة أخرى كتابته. اختيار سمة يوقف اتباعه.","prefs.theme_follow_off":"إيقاف","prefs.theme_follow_stop":"إيقاف الاتباع","prefs.theme_import_hint":"انقر لاختيار ملف سمة، أو أفلت ملفًا هنا، أو اضغط Ctrl+V (Cmd+V على Mac) بعد نسخ سمة","prefs.theme_option_opacity":"العتامة","prefs.theme_option_opacity_help":"اضبط عتامة اللوحات العائمة. يُطبّق حد أدنى للعتامة للحفاظ على وضوح النص فوق ألوان منطقة العرض.","prefs.theme_option_tab_colours":"ألوان علامات التبويب","prefs.theme_option_tab_colours_help":"استخدم ألوان اللوحات ومنطقة العرض من هذه السمة لكل علامة تبويب في الشريط.","prefs.theme_option_tab_fade_ms":"انتقال علامات التبويب","prefs.theme_option_tab_fade_ms_help":"تتغيّر ألوان اللوحات ومنطقة العرض تدريجيًا عند تبديل علامات التبويب. القيمة صفر تبدّلها فورًا.","prefs.theme_options_badge":"الخيارات","prefs.theme_options_more":"المزيد · {count}","prefs.theme_options_reset":"إعادة تعيين","prefs.theme_options_unavailable":"غير متاح على هذا الجهاز","prefs.theme_paste":"لصق السمة","prefs.theme_paste_none":"لا تحتوي الحافظة على سمة SolidCraft","prefs.timeline_half_hour":"−30 دقيقة","prefs.timeline_now":"الآن","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"الإشعارات","prefs.toggle_item":"إضافة العنصر، أو إزالته مرة أخرى","prefs.toolbar":"شريط الأدوات","prefs.toolbar_tabs":"علامات تبويب شريط الأدوات","prefs.top":"أعلى","prefs.trackpad_zoom_modifier":"التكبير بالتمرير بإصبعين أثناء الضغط على","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"اضغط مع الاستمرار على هذا المفتاح وحده للتكبير عند المؤشر بالتمرير العمودي. عند الإيقاف يبقى سلوك التمرير كما هو.","prefs.trackpad_zoom_modifier.off":"إيقاف","prefs.translucent":"شفاف","prefs.under_browser":"تحت المستعرض","prefs.under_cursor":"تحت المؤشر","prefs.units_precision":"الوحدات والدقة","prefs.updates":"التحديثات","prefs.value_boxes_in_view":"إظهار القيم بجانب مقابضها في العرض","prefs.value_boxes_in_view_tip":"قيمة الأمر (المسافة، نصف القطر…) في مربع بجانب مقبضه، فوق النموذج. عند الإيقاف: تكتبها في نافذة الأمر، التي تتلقى لوحة المفاتيح بعد التحديد، ولا شيء يغطي النموذج.","prefs.view":"سلوك العرض","prefs.view_confirm_corner":"موافق وإلغاء في زاوية العرض","prefs.view_confirm_corner_note":"أثناء فتح مربع حوار أو رسم، تؤدي علامة الصح وعلامة الإكس أعلى يمين العرض ما يؤديه زرّا موافق وإلغاء في مربع الحوار، أو تنهي الرسم وتلغيه. وينتقل متصفح العرض إلى أسفلهما.","prefs.viewport":"منطقة العرض","prefs.viewport_analysis_status":"إظهار حالة التحليل في منطقة العرض","prefs.viewport_analysis_status_help":"عرض التحليلات النشطة أعلى منطقة العرض، وفتح مفتاح الألوان لكل تحليل من عنصره، واستخدام Esc لإيقاف أحدث تحليل. أوقف الخيار لاستعادة مفاتيح الألوان في الزاوية وسلوك Esc السابق.","prefs.viewport_background":"الخلفية","prefs.viewport_background_colour":"لون","prefs.viewport_background_theme":"تدرج السمة","prefs.viewport_section_status":"إظهار حالة المقطع في منطقة العرض","prefs.viewport_section_status_help":"عرض إعداد المقطع في منطقة العرض. يُوقف Escape وزر الشريط النشط المقطع. عطّل الخيار للاحتفاظ بأدوات المقطع السابقة.","prefs.viewport_status_details":"تفاصيل منطقة العرض المباشرة","prefs.viewport_status_details_help":"حرّر إعدادات التحليل والمقطع النشطين في بطاقات التفاصيل القياسية. عطّل هذا الخيار لاستعادة مفاتيح ألوان التحليل للقراءة فقط ومربع حوار المقطع.","prefs.viewport_status_summary":"تلخيص عناصر حالة منطقة العرض","prefs.viewport_status_summary_help":"اجمع ثلاثة عناصر أو أكثر لحالة منطقة العرض في شارة ملخّصة واحدة. عطّل الخيار لإبقاء كل عنصر في الصف الكامل.","prefs.wheel":"العجلة","prefs.wheel_trackpad":"العجلة ولوحة اللمس","prefs.workspace":"مساحة العمل","prefs.zoom_stop_at_model":"إيقاف التكبير عند النموذج","prefs.zoom_stop_at_model_tip":"تُكبّر الفأرة ثلاثية الأبعاد وتطبيق الجهاز نحو السطح في منتصف العرض، ويثبّت التكبير بالسحب نقطة بدء السحب. عند الإيقاف يمكن للتكبير المرور عبر النموذج. تستخدم العجلة وإيماءة القرص إعداد التكبير نحو المؤشر بشكل مستقل","prefs.zoom_toward_cursor":"التكبير نحو المؤشر","properties.title":"الخصائص: {name}","recovery.days_ago":"قبل {count} يوم","recovery.detail":"{file} · {features} ميزة · حُفظ تلقائيًا {when}","recovery.discard_all":"تجاهل الكل","recovery.discard_all_detail":"لا يمكن التراجع عن هذا الإجراء.","recovery.discard_all_title":"تجاهل {count} من عمليات الحفظ التلقائي؟","recovery.discard_all_title_one":"تجاهل حفظ تلقائي واحد؟","recovery.hours_ago":"قبل {count} ساعة","recovery.just_now":"الآن","recovery.min_ago":"قبل {count} دقيقة","recovery.never_saved":"لم يُحفظ قط","render.adaptive_absolute":"الحد الأدنى المطلق لخطأ RGB","render.adaptive_coverage":"هدف خطأ التغطية","render.adaptive_enable":"توزيع العيّنات باستخدام عيّنات استكشافية مستقلة","render.adaptive_help":"على GPU فقط. تُستبعد العيّنات الاستكشافية المستقلة، ثم تُوزَّع 16 عيّنة إنتاجية أو أكثر لكل بكسل حتى قيمة «عيّنات لكل بكسل». يوجّه تباين RGB والتغطية هذا التوزيع؛ قد تفوت المسارات النادرة وقد تبقى البكسلات المحدودة مشوشة. يحصي التقرير النهائي العمل الفعلي. لا ضمان معتمد للتشويش أو للزمن.","render.adaptive_minimum":"الحد الأدنى للعيّنات الإنتاجية","render.adaptive_pending":"التوزيع التكيّفي على GPU بعيّنات استكشافية مستقلة وطبقات فرينل الشرطية متاحة. التقارب المعتمد وضمانات الأحداث النادرة والنقل التكيّفي على CPU غير متاحة بعد.","render.adaptive_pilots":"العيّنات الاستكشافية لكل بكسل","render.adaptive_relative":"هدف خطأ RGB النسبي","render.add_ground":"إضافة أرضية ملائمة إلى الإعداد","render.advanced_material_scope":"يتوفر وسط متجانس محدود واحد على GPU ضمن حدود صريحة. شبكات الكثافة وتراكيب الزجاج والحجوم المتداخلة وأسطح التشتت تحت السطحي والإزاحة والنقل الطيفي ومفاهيم المواد المتقدمة غير المربوطة غير متاحة بعد.","render.aging_add":"إضافة طبقة تقادم","render.aging_airborne":"غبار عالق / وسط مشارك","render.aging_airborne_help":"الغبار العالق حجم تشتت متجانس محدود ومنفصل. يغيّر النقل وملف EXR الخام، لا مكدّس تقادم السطح. تبقى قيود الحجم والزجاج وإزالة التشويش الحالية صريحة؛ ولا يُضاف غلاف جوي تلقائيًا.","render.aging_all_bodies":"كل الأجسام المعتمة المؤهلة","render.aging_chips":"طلاء متقشر","render.aging_class_any":"كل فئات المواد المعتمة","render.aging_class_dielectric":"الأسطح غير المعدنية فقط","render.aging_class_metal":"الأسطح المعدنية فقط","render.aging_color":"لون الطبقة · sRGB","render.aging_coverage":"التغطية","render.aging_dust":"غبار مترسّب","render.aging_empty":"لا توجد طبقات تقادم: تبقى الأسطح الأصلية دون تغيير.","render.aging_fading":"طلاء باهت","render.aging_grime":"أوساخ وبقع","render.aging_help":"اجمع حتى ثماني طبقات بصرية بالترتيب. الصدأ والزنجار مظاهر مُعدّة، لا محاكاة للتقادم أو التآكل. المقياس بمليمترات العالم. لا تتغير الهندسة ولا الكتلة ولا أي خاصية هندسية؛ ويُستثنى الزجاج والمنصات السلبية.","render.aging_metallic":"النسبة المعدنية للطبقة","render.aging_origin":"أصل الحقل · mm العالم","render.aging_patina":"زنجار نحاسي أخضر","render.aging_refresh_targets":"فحص الأجسام الحالية","render.aging_roughness":"خشونة الطبقة","render.aging_rust":"حديد مؤكسد / صدأ","render.aging_scale":"مقياس النمط","render.aging_scratches":"خدوش دقيقة","render.aging_target":"الهدف والإحداثيات","render.aging_target_help":"يجب أن يظل الهدف المسمّى مطابقًا لفهرسه واسمه الملتقطين. الأقنعة العامة مثبتة في العالم؛ ولا تتبع الأجزاء المتحركة. هذا ليس كشفًا للتجاويف ولا تآكلًا حقيقيًا للحواف. صفِّ القائمة للوصول إلى أجسام أخرى.","render.aging_target_search":"تصفية أسماء الأجسام","render.aging_upward":"ترسّب على الأسطح المتجهة للأعلى","render.all_controls_help":"فحص مكثف لكل عناصر التحكم الحالية. صفحات الأقسام توفر تحريرًا مركّزًا دون تغيير الطلب الأساسي.","render.all_shots_label":"كل اللقطات","render.appearance_editor.absorption":"الامتصاص","render.appearance_editor.base_colour":"اللون الأساسي","render.appearance_editor.body_reason":"الربط البصري يستهدف جسمًا كاملًا واحدًا. اختر «جسم» لتحرير هذه الضوابط.","render.appearance_editor.boundary":"الحدود","render.appearance_editor.box":"صندوق","render.appearance_editor.choose_image":"اختر صورة…","render.appearance_editor.closed":"جسم مصمت مغلق","render.appearance_editor.coat":"طبقة شفافة","render.appearance_editor.cpu_reason":"يتطلب تتبّع الأشعة على المعالج.","render.appearance_editor.glass":"الزجاج والامتصاص","render.appearance_editor.glass_enable":"استخدم زجاجًا فيزيائيًا على هذا الجسم","render.appearance_editor.glass_note":"يستخدم الزجاج المغلق المسافة الهندسية. لا يمكن أن يشارك جسمًا مع طبقة شفافة أو خرائط.","render.appearance_editor.gpu_reason":"يتطلب تتبّع المسار على بطاقة الرسومات.","render.appearance_editor.ior":"معامل الانكسار","render.appearance_editor.maps":"الخرائط","render.appearance_editor.normal":"الخريطة العمودية","render.appearance_editor.normal_strength":"شدة الخريطة العمودية","render.appearance_editor.origin":"الأصل","render.appearance_editor.recipe":"الوصفة","render.appearance_editor.reflection_sampling":"أخذ العينات لكل الأجسام العاكسة","render.appearance_editor.reflections":"الانعكاسات","render.appearance_editor.remove":"إزالة المحفوظ","render.appearance_editor.remove_note":"أزل الخصائص البصرية المحفوظة من هذه اللقطة. تبقى الهندسة والمظاهر المعيّنة.","render.appearance_editor.remove_title":"إزالة الخصائص البصرية المحفوظة؟","render.appearance_editor.replace":"استبدال الخصائص البصرية المحفوظة لهذا الجسم","render.appearance_editor.revalidate":"إعادة التحقق من هذا الجسم","render.appearance_editor.save":"حفظ هذه الخصائص البصرية","render.appearance_editor.save_reason":"يتطلب حفظ هذه الخصائص البصرية زجاجًا فيزيائيًا على جسم حالي في بطاقة الرسومات. تبقى الطبقة الشفافة وخرائط الصور المحلية مؤقتة.","render.appearance_editor.saved":"محفوظ مع هذه اللقطة","render.appearance_editor.saved_state":"هذه الخصائص البصرية محفوظة مع هذه اللقطة.","render.appearance_editor.scatter_reason":"التشتت الداخلي يتطلب حدًّا لجسم مصمت مغلق.","render.appearance_editor.temporary":"هذه الخصائص البصرية مؤقتة في هذا التبويب. احفظها لتبقى مع اللقطة.","render.appearance_editor.thickness":"السماكة","render.appearance_editor.thickness_reason":"السماكة تنطبق على الصفائح الرقيقة؛ الزجاج المغلق يستخدم المسافة الهندسية.","render.appearance_editor.thin":"صفيحة رقيقة","render.appearance_editor.u_repeat":"تكرار U","render.appearance_editor.v_repeat":"تكرار V","render.appearance_editor.v_up":"محور V للنسيج يشير للأعلى","render.appearance_editor.weight":"الوزن","render.appearance_physics_separate":"المظهر المرئي لا يعيّن الكثافة ولا البيانات الحرارية ولا أي خصائص هندسية أخرى.","render.appearances":"المظاهر","render.assign_help":"انقر للتطبيق على التحديد؛ اسحب للمعاينة ثم أفلت، أو انقر دون تحديد للتلوين.","render.availability_native":"تركيب أصلي؛ راجعه قبل التطبيق","render.availability_projection":"إسقاط مدعوم؛ راجع النطاق وما أُغفل","render.availability_reference":"بيانات مرجعية؛ ليست تعيينًا تلقائيًا","render.backdrop_alpha_conflict":"اختر هذه الخلفية أو إخراج PNG شفافًا؛ لن يتجاهل المُصيّر أيًّا من الإعدادين بصمت.","render.backdrop_enable":"استخدام خلفية متدرجة للكاميرا فقط","render.backdrop_first":"لون البداية / المركز","render.backdrop_help":"هذه الخلفية في فضاء الشاشة لا تضيء ولا تلقي ظلالًا ولا تنعكس ولا تمثل تضاريس. وهي مستبعدة من EXR الخام. تبقى الهندسة والأضواء وبيئة HDR مستقلة.","render.backdrop_horizontal":"تدرج أفقي","render.backdrop_radial":"تدرج شعاعي","render.backdrop_radius":"نصف القطر","render.backdrop_second":"لون النهاية / الحافة","render.backdrop_vertical":"تدرج رأسي","render.backdrop_x":"المركز X","render.backdrop_y":"المركز Y","render.background":"خلفية المشهد","render.background_camera_section":"خلفية الكاميرا · عرض PNG","render.background_completed_frozen":"النتيجة المعروضة صورة مكتملة مجمّدة. تحرير الخلفية لا يعيد رسم تلك النتيجة تلقائيًا. استخدم «إعادة التدريج» لتغييرات الكاميرا فقط، أو «تصيير» لمنصة فيزيائية جديدة.","render.background_hdr_separate":"موارد HDR الحالية تضيء الأسطح وتنعكس عليها؛ ولا تُعرض تلقائيًا كصورة بانورامية خلف الموضوع. تغيير التدرج لا يدير الإضاءة ولا يغيّر لونها.","render.background_lighting_section":"إضاءة HDR · منفصلة عن خلفية الكاميرا","render.background_no_alpha_override":"لا تُضاف خلفية الكاميرا إلى الإخراج الشفاف بصمت. إعادة تدريج النسخة الخام تستخدم التغطية الملتقطة ولا تعيد تطبيق إزالة التشويش؛ ويبقى ملف EXR المصدر دون تغيير.","render.background_not_light":"لون الخلفية للعرض فقط، وليس مصدر إضاءة إضافيًا.","render.background_regrade":"تطبيق على النسخة الخام المحفوظة","render.background_stage_occlusion":"تتضمن هذه اللقطة هندسة منصة فيزيائية. قد تملأ أرضية أو جدار كبير الإطار وتخفي خلفية الكاميرا. أزل المنصة أو غيّر حجمها عن قصد، أو غيّر انعكاسيتها الفيزيائية. لا تستطيع إعادة التدريج إزالة هندسة ملتقطة.","render.background_workflow":"اختر الخلفية التي تقصدها: لون أو تدرج للكاميرا فقط، أو منصة فيزيائية تستقبل الضوء، أو إضاءة HDR. وهي مستقلة عن بعضها. المعاينة الحية عرض للنمذجة؛ صيّر صورة جديدة أو أعد تدريج نسخة أصلية محفوظة لترى لمسات الكاميرا النهائية.","render.base_appearance":"مظهر الجسم القابل للتحرير","render.base_apply":"تطبيق مظهر الجسم","render.base_apply_help":"تعيين مرئي واحد قابل للتراجع على الجسم الذي رُوجع بالضبط. تبقى مظاهر الأوجه الخاصة والمواد الهندسية الحالية منفصلة.","render.base_color":"اللون الأساسي · sRGB","render.base_metallic":"النسبة المعدنية","render.base_opaque_only":"يحافظ هذا المحرر على دلالات الجسم المعتم. استخدم عناصر التحكم الصريحة للزجاج من أجل النفاذ البصري.","render.bloom_enable":"توهج العرض","render.bloom_help":"توهج إبداعي للإخراج فقط من الإضاءات الخطية الموجبة، يُنشر بثلاث تمريرات صندوقية مُطبّعة. نصف القطر ببكسلات الإخراج. يُضاف في ضوء العرض الخطي قبل sRGB؛ وليس عدسة ولا تأثيرًا حجميًا ولا تحسينًا للتقارب. يبقى EXR الخام دون تغيير.","render.bloom_opaque":"يتطلب التوهج إخراجًا معتمًا. يُرفض PNG الشفاف بدل تسطيحه بصمت.","render.bloom_radius":"نصف قطر التوهج","render.bloom_strength":"شدة التوهج","render.bloom_threshold":"عتبة الإضاءة الخطية العالية","render.browse_capabilities":"فحص فهرس القدرات الكامل","render.browse_environments":"تصفح بيئات HDR الأصلية","render.browse_looks":"استعراض…","render.browse_native_scenes":"تصفح الاستوديوهات الأصلية","render.browse_physical":"فحص المراجع الفيزيائية","render.browse_quality":"فحص مواصفات الجودة","render.browse_rigs":"تصفح أطقم الإضاءة المُعدّة","render.browse_scene_specs":"تصفح مواصفات المشاهد المتقدمة","render.browse_surfaces":"تصفح الأسطح المُعدّة","render.browser_library":"المكتبة","render.browser_model":"النموذج","render.camera_distance":"المسافة من العين إلى الهدف","render.camera_exact_help":"بمليمترات العالم؛ تُعرض الزوايا بالدرجات وتُحفظ بالراديان. يستخدم التنقل الكاميرا نفسها التي في منطقة العرض.","render.camera_fov":"مجال الرؤية الرأسي","render.camera_pitch":"ميل الكاميرا","render.camera_roll":"الدوران حول المحور","render.camera_set":"تعيين كاميرا التصيير","render.camera_target":"موضع الهدف · mm","render.camera_yaw":"الانعطاف","render.category_metal":"معدن","render.category_paint":"طلاء","render.category_plastic":"بلاستيك","render.category_wood":"خشب","render.check_opaque":"الشفافية: أسطح معتمة فقط؛ ألفا الخلفية مدعومة.","render.check_sorted_alpha":"الشفافية: تقريب ألفا مرتّب.","render.check_transmission":"الشفافية: نفاذية فيزيائية.","render.children.absolute_floor":"الحد الأدنى المطلق","render.children.adaptive":"تكيّفي","render.children.add_look_reason":"أضف مظهرًا لتعديل حالة تفعيله وقوته.","render.children.all_shots":"كل اللقطات","render.children.bloom":"توهّج","render.children.check":"فحص","render.children.check_now":"افحص الآن","render.children.chromatic":"الزيغ اللوني","render.children.compact":"مدمج","render.children.contrast":"التباين","render.children.copy_image":"نسخ","render.children.copy_job":"نسخ JSON المهمة","render.children.copy_request":"نسخ JSON الطلب","render.children.coverage_error