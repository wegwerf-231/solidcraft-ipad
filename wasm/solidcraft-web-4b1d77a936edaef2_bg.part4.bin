cmd.sketch_solve":"Selesaikan Lakaran","cmd.sketch_spline3d":"Splin 3D","cmd.sketch_spline_control_point":"Splin Titik Kawalan","cmd.sketch_spline_control_point_5":"Splin Titik Kawalan (Darjah 5)","cmd.sketch_spline_fit_point":"Splin Titik Padanan","cmd.sketch_spline_insert_point":"Tambah Titik Splin","cmd.sketch_spline_reverse":"Songsangkan Arah Splin","cmd.sketch_spun_profile":"Profil Putaran","cmd.sketch_toggle_diameter":"Togol Jejari / Diameter","cmd.sketch_toggle_driven":"Togol Dimensi Dipacu","cmd.sketch_transform":"Transformasi","cmd.sketch_trim_path":"Pangkas Sepanjang Laluan","cmd.solid_align":"Jajarkan","cmd.solid_boundary_fill":"Isi Sempadan","cmd.solid_bounding_solid":"Pepejal Pembatas","cmd.solid_emboss":"Timbulkan","cmd.solid_move":"Alih/Salin","cmd.solid_offset_face":"Ofset Muka","cmd.solid_press_pull":"Tekan Tarik","cmd.solid_remove":"Buang","cmd.solid_replace_face":"Ganti Muka","cmd.solid_rib":"Rusuk","cmd.solid_split_face":"Belah Muka","cmd.solid_web":"Pengukuh","cmd.surface_blend":"Permukaan Peralihan","cmd.surface_boundary":"Permukaan Sempadan","cmd.surface_extrude":"Penyemperitan Permukaan","cmd.surface_fair":"Licinkan Permukaan","cmd.surface_fillet":"Jejari Sudut Permukaan","cmd.surface_loft":"Loft Permukaan","cmd.surface_match":"Padankan Permukaan","cmd.surface_offset":"Ofset Permukaan","cmd.surface_patch":"Tampalan","cmd.surface_reverse_normal":"Songsangkan Normal","cmd.surface_revolve":"Putaran Permukaan","cmd.surface_ruled":"Permukaan Bergaris","cmd.surface_stitch":"Cantum","cmd.surface_sweep":"Sapuan Permukaan","cmd.surface_thicken":"Tebalkan","cmd.surface_unstitch":"Lerai","cmd.surface_untrim":"Nyahpangkas","cmd.timeline_add":"Tambah Ciri yang Dirakam","cmd.timeline_compute_all":"Kira Semua","cmd.timeline_copy":"Salin Ciri","cmd.timeline_dependents":"Ciri Bergantung","cmd.timeline_export_script":"Eksport Skrip Arahan","cmd.timeline_inspect":"Periksa Ciri","cmd.timeline_paste":"Tampal Ciri","cmd.timeline_play":"Main Sejarah","cmd.timeline_redefine":"Sunting Ciri","cmd.timeline_rename":"Tukar Nama","cmd.timeline_reorder":"Susun Semula Ciri","cmd.timeline_roll_to":"Alih Penanda Sejarah","cmd.timeline_rollback":"Alih Penanda Garis Masa","cmd.timeline_stop":"Hentikan Main Sejarah","cmd.timeline_suppress":"Nyahaktifkan Ciri","cmd.view.render_browser":"Pelayar Render","cmd.view.render_dock":"Alih Dok Render","cmd.view.render_focus":"Pandangan Fokus Render","cmd.view.status_details":"Butiran Status Tetingkap Pandangan","cmd.view.status_items":"Item Status Tetingkap Pandangan","cmd.view_ambient_occlusion":"Oklusi Ambien","cmd.view_angle_readout":"Sudut Pandangan","cmd.view_apply":"Pulihkan Pandangan","cmd.view_back":"Pandangan Belakang","cmd.view_bottom":"Pandangan Bawah","cmd.view_delete":"Padam Pandangan","cmd.view_fit":"Muatkan","cmd.view_front":"Pandangan Hadapan","cmd.view_graphics_preset":"Pratetap Grafik","cmd.view_grid":"Grid","cmd.view_ground_shadow":"Bayang lantai","cmd.view_home":"Pandangan utama","cmd.view_isometric":"Pandangan Isometrik","cmd.view_left":"Pandangan Kiri","cmd.view_list":"Senarai Pandangan","cmd.view_navigate":"Navigasi Pandangan","cmd.view_navigation_bar":"Bar navigasi","cmd.view_next_tab":"Tab Seterusnya","cmd.view_normal_to":"Normal pada Pilihan","cmd.view_previous_tab":"Tab Sebelumnya","cmd.view_rename":"Tukar Nama Pandangan","cmd.view_render_frame":"Panduan Bingkai Render","cmd.view_right":"Pandangan Kanan","cmd.view_save":"Simpan Pandangan","cmd.view_shots_strip":"Jalur Syot","cmd.view_spin":"Orbit berterusan","cmd.view_tool":"Alat navigasi","cmd.view_top":"Pandangan Atas","cmd.view_visual_style":"Gaya visual","color.copy":"Klik untuk menyalin nilai warna","color.edit":"Klik untuk menyunting warna","color.gamma":"Memaparkan nilai warna dalam ruang gamma 0-255","color.hex":"Heks","color.hex_help":"Masukkan #rrggbb atau #rrggbbaa; enam digit mengekalkan kelegapan","color.hex_hint":"#rrggbb","color.hue":"Rona","color.linear":"Memaparkan nilai warna dalam ruang linear 0-1","color.saturation_value":"Ketepuan dan nilai","color.selected":"Warna dipilih","config.column_filter_empty":"Tiada lajur yang sepadan","contact.components_count":"{count} komponen","contact.enabled_label":"diaktifkan","coupling.gear_1":"Gear 1","coupling.gear_1_pick":"Gear 1 (tidak wajib)","coupling.gear_2":"Gear 2","coupling.gear_2_pick":"Gear 2 (tidak wajib)","coupling.internal":"Gear dalaman","coupling.needs_turn_and_slide":"perlu satu sendi putar dan satu sendi gelongsor","coupling.needs_turns":"memerlukan dua sendi yang berputar","coupling.not_round":"bukan muka bulat","coupling.nut":"Nat","coupling.picked":"dipilih","coupling.pinion":"Pinan","coupling.pinion_pick":"Pinan (tidak wajib)","coupling.pitch":"Pic","coupling.rack":"Rak","coupling.radius_1":"Jejari 1","coupling.radius_2":"Jejari 2","crash.announce":"SolidCraft tertutup secara tidak dijangka atau mengalami ralat dalaman kali lepas. Laporan ranap telah disimpan (Bantuan > Laporan Ranap…).","crash.copy_folder":"Salin laluan folder","crash.copy_path":"Salin laluan","crash.deleted":"{count} laporan dipadam.","crash.detected_time":"Dikesan {time} UTC","crash.intro":"Laporan ranap kekal pada komputer ini dan tidak pernah dihantar ke mana-mana. Lapor… membuka draf yang anda semak sebelum apa-apa dikongsi.","crash.kind_command":"Ralat dalaman dalam arahan","crash.kind_internal":"Ralat dalaman","crash.kind_kernel":"Ralat kernel (dipulihkan)","crash.kind_unclean":"Tertutup secara tidak dijangka","crash.previous_session":"Sesi SolidCraft sebelum ini tamat secara tidak dijangka atau mengalami ralat dalaman. Laporan daripada penutupan tidak sempurna dikesan semasa permulaan. Lihat Bantuan > Laporan Ranap… untuk butiran.","crash.replayable":"boleh dimainkan semula","crash.report":"Lapor…","crash.unclean_explanation":"Dikesan pada pelancaran kemudian; masa penutupan sebenar tidak direkodkan. Penutupan sistem atau henti paksa juga boleh menyebabkan penutupan tidak sempurna.","delete.and_more":"… dan {count} lagi","diagnostic.empty_boolean_component":"tiada jasad untuk dipotong atau disilangkan dalam komponen '{component}'; alat mungkin bertindih dengan '{body}' dalam komponen '{other}' — aktifkan komponen itu atau pilih jasad tersebut sebagai sasaran","dialog.bodies_count":"{count} jasad","dialog.clearance_invalid":"kelegaan mestilah panjang 0 atau lebih","dialog.compute":"Kira","dialog.compute_again":"Kira semula","dialog.computing":"Mengira… {seconds} s","dialog.could_not_be_checked":"tidak dapat disemak","dialog.custom_axis":"↖ Paksi Tersuai","dialog.dimension_insert_hint":"Klik dimensi pemacu lain untuk menyisip namanya","dialog.dimension_name":"Dimensi: {name}","dialog.edit_title":"SUNTING {title}","dialog.no_shown_body":"Tiada jasad dipaparkan untuk diubah: paparkan satu, atau pilih Jasad Baharu","dialog.select":"↖ Pilih","dialog.selected_count":"↖ {count} dipilih","dialog.selection_guidance":"Pilih input untuk diubah. Klik objek dipilih untuk nyahpilih; Ctrl/Cmd+klik juga menogol pilihan. Semak pratonton, kemudian tekan OK.","dialog.selection_step":"{step} daripada {total}: Pilih {input}","dialog.step":"Langkah","document.changed_on_disk":"{name} berubah pada cakera","document.changed_on_disk_detail":"{name} telah diubah oleh program atau komputer lain sejak anda membukanya atau menyimpannya kali terakhir. Tulis Ganti menggantikan perubahan itu dengan perubahan anda; Simpan Salinan mengekalkan kedua-duanya.","document.copy_name":"Salinan {name}","document.open_anyway":"Buka Juga","document.open_elsewhere":"{name} sudah dibuka","document.open_elsewhere_detail":"{name} dibuka dalam SolidCraft {app} pada {who}, dibuka {when}. Jika anda berdua menyimpan, salah seorang akan kehilangan kerja. Buka secara baca sahaja untuk melihatnya tanpa menimpanya.","document.open_read_only":"Buka Baca Sahaja","document.opened_read_only":"Dibuka baca sahaja: Simpan akan meminta fail baharu","document.overwrite":"Tulis Ganti","document.read_only_save":"Reka bentuk ini dibuka baca sahaja: simpan sebagai fail baharu","document.save_changes":"Simpan perubahan pada {name}?","document.save_copy":"Simpan Salinan…","document.unsaved_changes":"{name}: perubahan belum disimpan dan akan hilang jika tidak disimpan.","drive.rigid":"{joint} ialah sendi tegar: ia menahan bahagiannya supaya kekal, jadi tiada apa yang boleh digerakkan. Untuk membenarkannya bergerak, tukar jenisnya dalam Sunting Sendi: Putaran untuk berputar, Gelongsor untuk menggelongsor, Silinder untuk kedua-duanya.","drive.stopped_by_contact":"Berhenti pada {value}: {a} akan menembusi {b}","drive.stopped_by_loop":"Berhenti pada {value}: gelung melalui {joint} tidak lagi dapat ditutup","drive.unconnected":"{part} tidak bergerak: tiada sambungan ke komponen tetap","dxf.cancel_wait":"Menunggu eksport berhenti…","dxf.cancelled":"Eksport DXF dibatalkan","dxf.cancelling":"Membatalkan eksport DXF","dxf.exporting":"Mengeksport DXF","dxf.invalid_tolerance":"Toleransi lengkung mestilah antara 0.0001 dan 1 mm.","dxf.progress.index":"Menyediakan permukaan (2/5)","dxf.progress.meshes":"Menyediakan mesh (1/5)","dxf.progress.occlusion":"Menentukan garis tersembunyi (4/5)","dxf.progress.projection":"Mengunjurkan geometri (3/5)","dxf.progress.write":"Menulis DXF (5/5)","dxf.tolerance":"Toleransi lengkung","dxf.tolerance_help":"Jasad kelihatan dan lakaran yang ditunjukkan sahaja. Lengkung guna segmen lurus. Toleransi kecil lebih halus tetapi guna lebih masa dan memori.","each rail's curves must be in one sketch":"lengkung setiap rel mestilah dalam satu lakaran","feature computation ended without a result":"pengiraan ciri berakhir tanpa hasil","file.open.drawing_filter":"Reka bentuk, fail CAD, mesh dan lukisan","file_load.built":"Dibina setakat ini: {built} daripada {total} ciri.","file_load.converting":"Menukar pepejal {done} daripada {total}","file_load.inserting":"Menyisip geometri","file_load.link_item":"{name} ({done} daripada {total})","file_load.opening":"Membuka reka bentuk","file_load.preparing_thumbnail":"Menyediakan imej kecil...","file_load.preparing_view":"Menyediakan pandangan...","file_load.preview_note":"Pratonton disimpan. Geometri disemak sebelum disunting.","file_load.reading":"Membaca fail...","file_load.reading_percent":"Membaca fail... {percent}%","file_load.rebuilding":"Membina semula ciri {done} daripada {total}","file_load.recovering":"Memulihkan reka bentuk","file_load.stopping":"Menunggu operasi sebelumnya berhenti...","file_load.updating_links":"Mengemas kini pautan","file_load.waiting":"Menunggu operasi fail","fits the face, e.g. M8":"padan dengan muka, cth. M8","from the profile":"daripada profil","from the rule":"daripada peraturan","help.apache":"Lesen Apache 2.0","help.appearance.assign":"Memberikan warna atau rupa bahan kepada jasad, muka atau komponen yang dipilih, tanpa mengubah beratnya. Gunakan untuk membezakan bahagian atau melihat pratonton kemasan.","help.assembly.bom":"Menyenaraikan bahagian reka bentuk atau komponen beserta kuantitinya, mengikut nombor bahagian, dan boleh menyimpan senarai itu sebagai CSV atau JSON. Gunakan sebagai senarai bahagian untuk pesanan dan pemasangan.","help.attributions":"Atribusi (ATTRIBUTION.md)","help.build":"Versi {version} · commit {commit} · dibina {date}","help.canvas.decal":"Meletakkan imej pada muka rata model, seperti pelekat. Gunakan untuk memaparkan label, logo atau corak bercetak pada sesuatu bahagian.","help.canvas.edit":"Mengubah kanvas: kedudukan, saiz, sudut, kelegapan, pencerminan, keterlihatan atau namanya. Gunakan untuk menjajarkan imej rujukan dengan lakaran yang anda surih.","help.canvas.insert":"Meletakkan imej PNG atau JPEG pada satah atau muka sebagai rujukan lut sinar. Gunakan untuk menyurih foto atau lukisan dalam lakaran, dengan imej berskala pada saiz yang diketahui.","help.component.break_link":"Memutuskan komponen terpaut daripada fail reka bentuknya dan mengekalkan jasadnya seperti sedia ada. Gunakan apabila bahagian itu tidak lagi perlu mengikut perubahan pada fail asal.","help.component.capture_position":"Menyimpan kedudukan bahagian yang anda alihkan dengan tangan, supaya kedudukan itu menjadi tempat bahagian tersebut. Gunakan selepas menyeret bahagian ke tempatnya yang tidak dipegang oleh sendi.","help.component.create":"Menambah komponen baharu yang kosong ke dalam reka bentuk, di dalam komponen aktif melainkan anda memilih induk lain. Gunakan untuk memberi bahagian baharu pemasangan tempatnya sendiri bagi jasad dan lakaran.","help.component.finish_edit":"Menyimpan bahagian yang sedang anda sunting di tempat, kembali ke pemasangannya dan mengemas kini pemasangan daripadanya. Gunakannya apabila perubahan anda pada bahagian terpaut sudah selesai.","help.component.from_bodies":"Menjadikan setiap jasad yang dipilih sebagai komponen tersendiri, dinamakan sempena jasad itu. Gunakan apabila reka bentuk yang dibina daripada jasad berasingan patut menjadi pemasangan yang bahagiannya boleh disambung dan digerakkan.","help.component.insert_design":"Menyisip reka bentuk tersimpan lain sebagai komponen yang dipautkan ke failnya, dengan jasad pepejalnya diletakkan seperti dalam fail itu. Gunakan untuk menggunakan semula bahagian dalam pemasangan dan menerima perubahan kemudian dengan Kemas Kini Pautan.","help.component.properties":"Memaparkan isi padu, jisim, pusat jisim dan momen inersia sesebuah komponen, menggunakan bahan jasadnya. Gunakan untuk menyemak berat dan keseimbangan pemasangan.","help.component.revert_position":"Mengembalikan bahagian yang anda alihkan dengan tangan ke tempat asalnya, dengan membuang pergerakan yang tidak dirakam. Gunakan untuk membuat asal pergerakan percubaan dalam pemasangan.","help.component.update_links":"Membaca semula fail reka bentuk terpaut dan menggantikan jasad yang telah berubah. Gunakan selepas menyunting bahagian yang digunakan oleh pemasangan ini.","help.config.configure":"Menambah parameter, ciri, bahan atau penampilan sebagai lajur jadual konfigurasi. Gunakan untuk membina varian satu reka bentuk, seperti pelbagai saiz sesuatu bahagian.","help.config.preview":"Menyemak bahawa satu baris jadual konfigurasi dapat dibina semula, tanpa mengubah reka bentuk atau sejarahnya. Gunakan sebelum bertukar kepada varian yang anda tidak pasti.","help.config.rules":"Memaparkan peraturan jadual konfigurasi, barisnya dan baris yang aktif. Gunakan untuk melihat cara varian sesuatu reka bentuk disediakan.","help.config.table":"Memaparkan jadual konfigurasi: satu baris bagi setiap varian, satu lajur bagi setiap parameter atau ciri, dan sama ada reka bentuk masih sepadan dengan baris aktif. Gunakan untuk menyemak varian sesuatu reka bentuk.","help.connect_note":"Mulakan semula setiap pembantu untuk memuatkan pelayan SolidCraft. Setiap fail telah disandarkan sebagai .bak sebelum diubah.","help.connect_title":"Sambungkan pembantu AI","help.construct.axis.edge":"Mencipta paksi binaan sepanjang tepi lurus atau garis lakaran. Gunakan sebagai paksi untuk Putar, corak membulat atau sendi.","help.construct.axis.normal_to_face":"Mencipta paksi binaan melalui satu titik, serenjang dengan muka. Gunakan sebagai paksi yang tegak keluar dari permukaan.","help.construct.axis.through_cylinder":"Mencipta paksi binaan melalui pusat muka silinder, kon atau torus, atau tepi bulat. Gunakan untuk memutar atau mencorak ciri di sekeliling bahagian bulat.","help.construct.axis.two_planes":"Mencipta paksi binaan di tempat dua satah atau muka rata bertemu. Gunakan apabila paksi yang diperlukan ialah garis antara dua muka.","help.construct.axis.two_points":"Mencipta paksi binaan melalui dua titik, bucu atau titik lakaran. Gunakan untuk paksi yang menghubungkan dua kedudukan yang diketahui.","help.construct.plane.along_path":"Mencipta satah binaan yang serenjang dengan tepi atau lengkung, pada satu kedudukan sepanjangnya. Gunakan untuk melakar profil bagi Sapu atau keratan sesuatu laluan.","help.construct.plane.at_angle":"Mencipta satah binaan yang dipusingkan pada satu sudut daripada satah atau muka, pada paksi atau tepi. Gunakan untuk lakaran condong, seperti braket bersudut.","help.construct.plane.midplane":"Mencipta satah binaan di tengah-tengah antara dua satah atau muka rata, atau yang membahagi dua kedua-duanya di tempat ia bertemu pada satu sudut. Gunakan sebagai satah simetri untuk pencerminan.","help.construct.plane.offset":"Mencipta satah binaan yang selari dengan satah atau muka rata, pada satu jarak atau melalui satu titik. Gunakan untuk melakar pada ketinggian tertentu di atas sesuatu muka.","help.construct.plane.perpendicular":"Mencipta satah binaan yang memuatkan garis atau tepi dan berdiri serenjang dengan satah atau muka. Gunakan untuk melakar secara tegak pada model sepanjang tepi.","help.construct.plane.tangent":"Mencipta satah binaan yang menyentuh silinder, kon, sfera atau torus pada satu titik. Gunakan untuk melakar pada sisi bahagian bulat.","help.construct.plane.three_points":"Mencipta satah binaan melalui tiga titik. Gunakan untuk satah yang ditentukan oleh kedudukan pada model, seperti tiga bucu.","help.construct.plane.two_edges":"Mencipta satah binaan melalui dua tepi atau garis lurus yang terletak pada satu satah. Gunakan untuk satah merentasi sesuatu bahagian, seperti melalui dua tepi yang bertentangan.","help.construct.point.along_path":"Mencipta titik binaan pada satu kedudukan sepanjang tepi atau lengkung. Gunakan sebagai rujukan di pertengahan laluan.","help.construct.point.center":"Mencipta titik binaan di pusat tepi bulat, bulatan atau lengkok lakaran, sfera atau torus. Gunakan sebagai rujukan untuk lubang, paksi dan sendi.","help.construct.point.edge_plane":"Mencipta titik binaan di tempat tepi atau garis melalui satah atau muka rata. Gunakan untuk menandakan tempat laluan merentasi satah.","help.construct.point.three_planes":"Mencipta titik binaan di tempat tiga satah atau muka rata bertemu. Gunakan sebagai rujukan sudut, walaupun model tiada bucu di situ.","help.construct.point.two_edges":"Mencipta titik binaan di tempat dua tepi atau garis bertemu, atau paling hampir antara satu sama lain. Gunakan sebagai rujukan pada sudut maya.","help.construct.point.vertex":"Mencipta titik binaan pada bucu atau titik lakaran. Gunakan sebagai rujukan yang kekal apabila lakaran atau jasad di sekelilingnya disembunyikan.","help.contact.check":"Menyenaraikan pasangan bahagian dalam set sentuhan yang menembusi satu sama lain pada kedudukan semasa. Gunakan untuk mencari perlanggaran sebelum anda menggerakkan sendi atau menjalankan kajian gerakan.","help.contact.create":"Mengumpulkan dua atau lebih bahagian ke dalam satu set sentuhan, yang jasadnya dihalang daripada menembusi satu sama lain semasa sendi bergerak. Gunakan untuk bahagian yang patut berhenti apabila bersentuhan, seperti tuil terhadap penahannya.","help.contact.disable_all":"Mematikan sentuhan, supaya sendi yang digerakkan dan kajian gerakan tidak lagi berhenti di tempat bahagian bersentuhan. Gunakan untuk menggerakkan bahagian dengan bebas semula, atau untuk memastikan pemasangan besar kekal responsif.","help.contact.edit":"Mengubah set sentuhan: bahagian yang dipegangnya, namanya, atau sama ada ia dinyahaktifkan; ia juga boleh memadam set itu. Gunakan untuk melaraskan bahagian mana yang dihalang daripada menembusi satu sama lain.","help.contact.enable_all":"Memasukkan setiap bahagian pemasangan ke dalam satu set sentuhan, supaya tiada dua bahagian dapat menembusi satu sama lain semasa sendi bergerak. Gunakan untuk semakan pantas seluruh mekanisme.","help.contact.enable_sets":"Mengaktifkan sentuhan bagi set sentuhan yang anda takrifkan, supaya sendi yang digerakkan dan kajian gerakan berhenti di tempat bahagiannya akan menembusi satu sama lain. Gunakan untuk memulihkan set anda selepas mematikan sentuhan.","help.contact.list":"Menyenaraikan set sentuhan dalam reka bentuk, bahagian dalam setiap satu dan sama ada sentuhan diaktifkan. Gunakan untuk menyemak cara sentuhan disediakan sebelum anda menggerakkan pemasangan.","help.document.inspect":"Memaparkan gambaran keseluruhan reka bentuk: komponen, jasad, lakaran, ciri dan parameternya. Gunakan untuk memahami reka bentuk yang bukan anda bina sendiri.","help.document.units":"Menukar unit yang digunakan reka bentuk untuk memaparkan panjang, seperti mm atau inci. Geometri kekal bersaiz sama; hanya paparan dan nombor biasa yang mengikutinya.","help.edit.checkpoint":"Mengingati reka bentuk, lakaran aktif dan sejarah Buat Asal seperti keadaan sekarang. Gunakan sebelum mencuba sesuatu yang berisiko dan mungkin hendak anda kembali daripadanya.","help.edit.restore_checkpoint":"Kembali ke titik semak, termasuk sejarah Buat Asal. Gunakan untuk membuang semua yang dilakukan sejak titik semak dalam satu langkah.","help.explode.create":"Mencipta pandangan terlerai yang menolak bahagian menjauhi pusat pemasangan, atau mengikut pergerakan yang anda tetapkan. Gunakan untuk menunjukkan cara pemasangan disatukan, bagi arahan atau pembentangan.","help.face.delete":"Membuang muka yang dipilih dan membiarkan muka bersebelahan menutup ruang kosong itu, atau membiarkannya terbuka sebagai permukaan. Gunakan untuk menanggalkan tepi bulat, lubang atau bonggol yang menghalang.","help.file.insert_mesh":"Menambah fail 3MF, STL, OBJ, PLY atau glTF ke dalam reka bentuk sebagai jasad mesh dalam komponen baharu. Gunakan untuk meletakkan model yang dimuat turun atau diimbas di sebelah reka bentuk anda sebagai rujukan.","help.file.insert_step":"Menambah fail STEP, IGES, FreeCAD atau Rhino ke dalam reka bentuk sebagai jasad pepejal dalam komponen baharu; bahagian pemasangan menjadi komponen bersarang. Gunakan untuk membawa masuk model daripada pembekal atau program CAD lain.","help.file.save_mesh":"Menyimpan jasad sebagai mesh STL, 3MF atau OBJ, dengan kehalusan muka melengkung yang anda pilih. Gunakan untuk menyediakan bahagian bagi pencetakan 3D atau program yang membaca mesh.","help.file.send_to_slicer":"Menyimpan jasad yang dipilih sebagai fail 3MF dan membukanya dalam penghiris yang anda pilih. Gunakan untuk beralih daripada model kepada pencetakan dalam satu langkah.","help.font_details":"Antara muka menggunakan fon terbina dalam egui (Ubuntu Light dan Hack, di bawah Lesen Fon Ubuntu dan lesen MIT/Bitstream Vera; Noto Emoji dan fon ikon emoji, di bawah OFL dan MIT). Teks lakaran menggunakan Liberation Sans (SIL OFL 1.1). Pek fon pilihan Crafting Apps, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), tidak disertakan dalam binaan SolidCraft.","help.fonts":"Fon","help.frame.member":"Meletakkan profil, seperti tiub atau aluminium tersemperit, sepanjang garis lakaran rangka, satu anggota bagi setiap garis. Gunakan untuk membina rangka, rak dan struktur kimpalan.","help.inspect.accessibility":"Mewarnakan muka yang dapat dicapai oleh alat dari satu arah, dan yang tidak dapat dicapai. Gunakan untuk menyemak bahagian bagi pemesinan atau pengacuanan dari sisi itu.","help.inspect.center_of_mass":"Memaparkan pusat jisim jasad, setiap satu secara berasingan dan semuanya bersama, pada ketumpatan seragam. Gunakan untuk menyemak keseimbangan dan tempat bahagian akan terbalik.","help.inspect.colored_components":"Memberi setiap komponen warna sementaranya sendiri, tanpa mengubah penampilan. Gunakan untuk membezakan bahagian pemasangan dengan sekilas pandang.","help.inspect.compare":"Membandingkan dua jasad dan menunjukkan di mana satu mempunyai bahan yang tiada pada yang lain, dengan isi padu dan sisihan. Gunakan untuk menyemak bahagian yang diubah atau diimport dengan yang asal.","help.inspect.continuity":"Menyemak kehalusan pertemuan muka di sepanjang tepinya: sela, patahan atau lonjakan kelengkungan, dan mewarnakan sambungannya. Gunakan untuk mencari tempat permukaan tidak bercantum dengan kemas.","help.inspect.curvature_comb":"Melukis sisir di sepanjang lengkung, tepi atau muka yang giginya menunjukkan sekuat mana ia melengkung. Gunakan untuk mengesan tempat rata, patahan dan kelengkungan yang tidak sekata.","help.inspect.curvature_map":"Mewarnakan muka mengikut sekuat mana ia melengkung, merah di tempat jejari kecil. Gunakan untuk mencari tempat yang sempit dan menilai kehalusan sesuatu permukaan.","help.inspect.draft":"Mewarnakan muka mengikut sudut draf terhadap arah tarikan, dan menandakan yang sudutnya terlalu kecil. Gunakan untuk menyemak bahagian sebelum pengacuanan atau penuangan.","help.inspect.environment_map":"Memaparkan model dengan kemasan memantul seperti cermin. Gunakan untuk menilai aliran permukaan melalui cara pantulan melintasinya.","help.inspect.interference":"Mencari jasad yang bertindih dan menunjukkan setiap pertindihan dengan isi padunya. Gunakan untuk menyemak pemasangan bagi bahagian yang berlanggar.","help.inspect.isocurve":"Melukis lengkung isoparametrik pada muka, iaitu grid tempat permukaan dibina. Gunakan untuk melihat aliran permukaan dan tempat ia terkumpul.","help.inspect.measure":"Mengukur panjang, jarak, sudut, luas dan jejari antara apa yang anda pilih, atau isi padu dan jisim jasad. Gunakan untuk menyemak saiz dan kelegaan.","help.inspect.minimum_radius":"Mencari jejari kelengkungan terkecil bagi lengkung, tepi atau muka, dan tempatnya. Gunakan untuk menyemak bahawa alat atau muncung dapat mengikuti bentuk itu.","help.inspect.section":"Membelah pandangan di sepanjang satah dan melorek muka yang dipotong, tanpa mengubah model. Gunakan untuk melihat ke dalam bahagian dan pemasangan.","help.inspect.zebra":"Memaparkan jalur hitam dan putih yang memantul pada muka model. Gunakan untuk menilai kehalusan: jalur yang putus atau patah di tepi menunjukkan peralihan yang kurang baik.","help.joint.as_built":"Menyambung dua bahagian di tempat ia berada, tanpa menggerakkan mana-mana satu, dan menetapkan cara ia masih boleh bergerak. Gunakan untuk bahagian yang sudah anda letakkan pada kedudukan akhirnya.","help.joint.cam":"Memaut sesondol yang berputar kepada pengikut, supaya pengikut menggelongsor atau berayun apabila garis luar sesondol melaluinya. Gunakan untuk sesondol, eksentrik dan pemacu injap.","help.joint.create":"Menyambung dua bahagian pada titik asal sendi yang anda pilih dan menggerakkan bahagian kedua ke tempatnya; jenis sendi menentukan cara ia masih boleh bergerak. Gunakan untuk membina pemasangan yang bahagiannya bergerak seperti mekanisme sebenar.","help.joint.drive":"Menetapkan sudut atau jarak sesebuah sendi dan menggerakkan bahagian bersamanya, dalam had sendi itu; sendi terpaut dan gelung tertutup turut mengikut. Gunakan untuk menyemak bahawa mekanisme bergerak seperti yang dimaksudkan.","help.joint.gear":"Memaut dua sendi berputar dengan nisbah gear, supaya menggerakkan satu akan memutar yang lain. Gunakan untuk gear taji dan gear dalaman, dengan nisbah daripada jejari pic atau bilangan gigi.","help.joint.limits":"Menetapkan sejauh mana sendi boleh berputar atau menggelongsor, sebagai minimum dan maksimum, atau mengosongkan had itu. Gunakan untuk memastikan engsel, gelangsar atau tuil kekal dalam julat pergerakan sebenarnya.","help.joint.motion_link":"Memaut dua sendi dengan nisbah dan ofset, supaya menggerakkan satu akan menggerakkan yang lain. Gunakan untuk hubungan tetap antara sendi yang tidak diliputi oleh Gear, Rak dan Pinan atau Skru.","help.joint.origin":"Meletakkan titik asal sendi bernama pada sesuatu bahagian: di pusat muka atau hujung bulat, tengah tepi, sudut atau satu titik. Gunakan untuk menyediakan tempat sendi melekat; titik asal yang dipilih pada muka mengikutinya apabila saiz bahagian berubah.","help.joint.rack_pinion":"Memaut pinan berputar kepada rak menggelongsor, supaya rak bergerak sepanjang bulatan pic yang digelek oleh pinan. Gunakan untuk pemacu rak, stereng dan pentas linear.","help.joint.reach":"Menggerakkan satu titik pada bahagian ke arah sasaran dengan mengubah sendi pada rantaiannya, dalam had sendi itu. Gunakan untuk melaraskan mekanisme mengikut kedudukan hujungnya, seperti hujung lengan robot.","help.joint.rigid_group":"Mengunci bahagian yang dipilih bersama seperti sedia ada, supaya ia bergerak sebagai satu. Gunakan untuk bahagian yang bersatu dan tiada gerakan antara satu sama lain.","help.joint.screw":"Memaut putaran dan gelongsoran melalui pic, supaya setiap pusingan menggerakkan jarak itu. Gunakan untuk skru pemacu, bolt dan gelendong berbebenang.","help.library.apply":"Menggunakan bahan atau penampilan daripada fail koleksi setempat pada jasad, muka atau komponen. Gunakan untuk menggunakan semula bahan yang anda simpan daripada reka bentuk lain.","help.library.export":"Menyimpan bahan dan penampilan reka bentuk ke fail koleksi. Gunakan untuk berkongsinya atau menggunakannya semula dalam reka bentuk lain.","help.library.inspect":"Menyemak fail koleksi dan menyenaraikan bahan dan penampilannya, tanpa mengubah reka bentuk. Gunakan untuk melihat kandungan koleksi sebelum menggunakannya.","help.licences":"Lesen","help.material.assign":"Menetapkan bahan jasad yang dipilih, seperti keluli, aluminium atau ABS. Gunakan supaya jisim dan berat sepadan dengan bahagian sebenar.","help.material.properties.validate":"Menyemak kad data bahan untuk nombor yang konsisten dan nilai yang hilang. Gunakan sebelum bergantung pada data itu untuk jisim atau kekakuan.","help.mesh.convert":"Membina semula jasad mesh, seperti STL, sebagai pepejal boleh sunting dengan muka rata dan silinder. Gunakan untuk mengubah suai bahagian mekanikal yang diimport seperti jasad yang dimodelkan.","help.mit":"Lesen MIT","help.motion.study":"Menetapkan nilai sendi pada beberapa langkah sepanjang garis masa dan memainkannya semula sebagai animasi. Gunakan untuk menonton mekanisme bergerak melalui satu urutan dan menyemak kelegaan sepanjangnya.","help.motion.trace":"Menjejak laluan yang diikuti satu titik pada bahagian semasa kajian gerakan dimainkan atau sendi digerakkan, dan menyimpannya sebagai lengkung lakaran 3D apabila anda mengesahkan. Gunakan untuk melihat sejauh mana mekanisme mencapai, atau untuk membina berdasarkan laluannya.","help.notice":"NOTIS","help.occurrence.ground":"Menetapkan bahagian pada tempatnya, atau membebaskannya semula, supaya sendi menggerakkan bahagian lain di sekelilingnya. Gunakan untuk rangka atau tapak yang menjadi asas seluruh pemasangan.","help.occurrence.move":"Mengalihkan bahagian pemasangan hanya mengikut kebebasan yang dibenarkan oleh sendinya. Pilih muka bahagian, kemudian seret anak panah atau lengkok yang tersedia.","help.parameters.change":"Membuka jadual nilai dan ungkapan bernama yang memacu dimensi reka bentuk. Gunakan untuk menukar saiz di satu tempat dan membiarkan setiap ciri yang menggunakannya mengikut.","help.parameters.export":"Menyimpan parameter reka bentuk sebagai CSV atau JSON. Gunakan untuk menyuntingnya dalam hamparan atau memindahkannya ke reka bentuk lain.","help.parameters.graph":"Menunjukkan parameter dan ciri mana yang menggunakan yang mana, dan sebarang gelung atau ralat di antaranya. Gunakan untuk melihat apa yang akan terjejas oleh perubahan pada sesuatu parameter.","help.parameters.import":"Membaca parameter daripada CSV atau JSON ke dalam reka bentuk, semuanya atau tiada satu pun. Gunakan untuk membawa masuk nilai daripada hamparan atau reka bentuk lain.","help.parameters.move":"Mengalihkan parameter pengguna sebelum atau selepas parameter lain dalam senarai. Gunakan untuk memastikan parameter yang berkaitan berada bersama.","help.parts.fastener":"Menambah skru, bolt, nat, sesendal, pin atau galas piawai dalam saiz yang anda pilih. Apabila diletakkan pada lubang, ia duduk dalam lubang itu dengan sendi, jadi anda tidak perlu memodelkan pengikat sendiri.","help.parts.insert":"Menyisip bahagian piawai dalam keluarga, saiz dan panjang yang anda pilih. Apabila diletakkan pada pinggir atau dinding lubang, ia duduk pada lubang itu dengan sendi tegar.","help.parts.library":"Membuka bahagian piawai: skru, bolt, nat, sesendal, skru penetap, pin dowel dan galas dalam saiz piawai. Gunakan untuk menambah bahagian piawai dan bukannya memodelkannya sendiri.","help.parts.resize":"Mengubah saiz atau panjang bahagian piawai yang disisipkan dan membinanya semula; sendinya mengekalkannya pada tempat. Gunakan apabila skru ternyata terlalu panjang atau lubang memerlukan saiz lain.","help.plastic.assign_rule":"Menetapkan peraturan plastik pada jasad, supaya ciri plastiknya menggunakan sudut draf dan kelegaan peraturan itu sebagai lalai. Gunakan untuk menyediakan bahagian teracu sekali sahaja bagi semua cirinya.","help.plastic.boss":"Menambah bonggol skru pada muka: tiang dengan lubang pilihan, sudut draf, jejari sudut pada akar dan rusuk penyokong. Gunakan untuk titik skru dalam perumah teracu atau bercetak.","help.plastic.lip":"Menambah bibir atau alur sepadan di sepanjang pinggir jasad yang diberi ronggak. Gunakan supaya dua separuh perumah duduk pada satu sama lain dan tertutup rapat.","help.plastic.manage_rules":"Mencipta dan menyunting peraturan plastik: bahan, ketebalan dinding, jejari, kelegaan dan sudut draf. Gunakan untuk memastikan ciri bahagian teracu konsisten.","help.plastic.rest":"Menambah penyokong pada muka: pad bulat atau segi empat tepat, pepejal atau berongga, dengan sudut draf. Gunakan sebagai sokongan atau tiang pengasing dalam perumah teracu.","help.plastic.snap_fit":"Menambah cangkuk sambungan sentap pada muka, dengan panjang, ketebalan dan penahannya. Gunakan untuk mengklip bahagian bersama tanpa skru.","help.pointcloud.insert":"Sisipkan imbasan PLY, XYZ atau PTS sebagai awan titik di samping model. Gunakannya sebagai rujukan semasa membina model daripada data yang diukur.","help.sheet.convert":"Menukar plat atau jasad beronggak yang berketebalan sekata kepada jasad logam kepingan, dengan lenturan pada tepi yang anda pilih. Gunakan untuk menjadikan bahagian sedia ada boleh dibuka lipatan.","help.sheet.export_bend_table":"Menyimpan jadual lenturan jasad logam kepingan sebagai CSV atau JSON: sudut, jejari dan kedudukan lenturan dalam bentangan rata. Gunakan untuk brek tekan atau bengkel.","help.sheet.export_dxf":"Menyimpan bentangan rata sebagai DXF, dengan garis luar, garis lenturan dan nota lenturan pilihan. Gunakan untuk pemotongan laser, plasma atau jet air.","help.sheet.flange":"Menambah bebibir: plat tapak daripada lakaran, dinding di sepanjang kontur lakaran terbuka, atau dinding berlentur pada tepi kepingan. Gunakan untuk membina bahagian logam kepingan.","help.sheet.flat_pattern":"Mencipta bentangan rata jasad logam kepingan, dengan saiz, potongan dan garis lenturannya. Gunakan untuk menyemak kepingan mentah sebelum anda memotongnya.","help.sheet.fold":"Melipat kepingan di sepanjang garis lakaran mengikut sudut dan jejari. Gunakan untuk melipat kepingan rata selepas memotong ciri padanya.","help.sheet.hem":"Melipat tepi kepingan kembali ke atas dirinya. Gunakan untuk tepi yang selamat dan kukuh tanpa duri tajam.","help.sheet.manage_rules":"Mencipta dan menyunting peraturan logam kepingan: ketebalan, jejari lenturan, faktor K, pelega dan sela. Gunakan untuk menyesuaikan dengan bahan dan alat bengkel anda.","help.sheet.path_flange":"Menambah rantaian bebibir di sepanjang tepi kepingan, mengikut rantaian terbuka garis lakaran. Gunakan untuk profil seperti bentuk U atau Z dalam satu langkah.","help.sheet.perforate":"Menambah medan lubang di seluruh kepingan rata, dalam corak berselang-seli atau segi empat sama. Gunakan untuk lubang angin, gril dan panel yang lebih ringan.","help.sheet.refold":"Melipat semula jasad logam kepingan yang telah dibuka lipatan. Gunakan selepas menambah ciri pada kepingan rata.","help.sheet.unfold":"Membuka lipatan semua lenturan jasad logam kepingan. Gunakan untuk menambah lubang atau potongan yang perlu melintasi lenturan, kemudian lipat semula.","help.sketch.arc.center_point":"Melukis lengkok bulat di sekeliling titik pusat, daripada titik mula ke titik akhir. Gunakan apabila pusat lengkok diketahui, seperti jejari di sekeliling lubang atau pangsi.","help.sketch.arc.tangent":"Melukis lengkok yang bermula di hujung garis atau lengkok dan bersambung secara tangen dengannya. Gunakan untuk meneruskan rantaian dengan lenturan licin dan bukannya sudut.","help.sketch.arc.three_point":"Melukis lengkok daripada titik mula ke titik akhir melalui titik ketiga. Gunakan apabila lengkok perlu melalui titik yang diberi dan bukannya mengelilingi pusat yang diketahui.","help.sketch.arc3d":"Melukis lengkok bulat tepat dalam ruang melalui tiga titik, dengan Lakaran 3D aktif. Gunakan untuk lenturan pada laluan dan rel pemandu yang keluar daripada satah lakaran.","help.sketch.auto_constrain":"Menambah kekangan yang hampir dimiliki lakaran, seperti mendatar, selari atau bertindih tepat, kemudian mendimensikannya sehingga tertakrif sepenuhnya. Gunakan untuk mengunci lakaran yang dilukis secara kasar dalam satu langkah.","help.sketch.auto_constrain_from_datum":"Berfungsi seperti Kekangan Automatik, tetapi mengukur kedudukan daripada titik datum yang anda pilih dan bukannya titik asal. Gunakan apabila bahagian disusun daripada satu titik rujukan, seperti sudut atau lubang.","help.sketch.blend_curve":"Menyambung hujung dua lengkung dengan splin licin yang tangen kepada kedua-duanya, atau juga selanjar kelengkungan jika anda pilih. Gunakan untuk merapatkan jurang antara lengkung tanpa patahan.","help.sketch.break":"Memutuskan lengkung kepada beberapa keping di tempat lengkung lain melintasinya, atau pada titik yang anda letakkan padanya. Gunakan apabila sebahagian lengkung memerlukan kekangannya sendiri atau patut dipadam secara berasingan.","help.sketch.cancel":"Meninggalkan lakaran dan membuang semua yang diubah sejak ia dicipta atau dibuka untuk disunting. Buat Asal mengembalikan perubahan itu.","help.sketch.centerline":"Menukar garis antara garis biasa dan garis tengah, paksi yang diabaikan oleh profil. Gunakan garis tengah sebagai paksi untuk Putar, Cermin atau kekangan simetri.","help.sketch.chamfer.distance_angle":"Menyerongkan sudut antara dua garis, ditetapkan oleh jarak sepanjang garis pertama dan satu sudut. Gunakan apabila lukisan memberikan serong sebagai panjang dan sudut, seperti 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Menyerongkan sudut antara dua garis dengan jarak yang sama ke belakang sepanjang kedua-duanya. Gunakan untuk serong 45° yang biasa pada garis luar.","help.sketch.chamfer.two_distance":"Menyerongkan sudut antara dua garis, ditetapkan oleh jarak berasingan sepanjang setiap garis. Gunakan untuk serong yang bukan 45°, diberikan sebagai dua panjang.","help.sketch.circle.center":"Melukis bulatan daripada pusat dan diameternya. Gunakan untuk lubang, bonggol dan ciri bulat lain yang pusatnya diketahui.","help.sketch.circle.three_point":"Melukis bulatan melalui tiga titik. Gunakan apabila bulatan perlu melalui titik yang diberi, contohnya pada geometri sedia ada.","help.sketch.circle.three_tangent":"Melukis bulatan yang menyentuh tiga garis, bulatan atau lengkok. Gunakan untuk memuatkan bulatan dalam ruang antara tiga lengkung, seperti bulatan terterap dalam segi tiga.","help.sketch.circle.two_point":"Melukis bulatan daripada dua hujung diameternya. Gunakan apabila titik tepi bulatan diketahui dan bukannya pusatnya.","help.sketch.circle.two_tangent":"Melukis bulatan bersaiz tertentu yang menyentuh dua garis, bulatan atau lengkok. Gunakan untuk pembulatan berjejari tetap antara dua lengkung.","help.sketch.conic":"Melukis lengkung kon antara dua titik hujung, dibentuk oleh titik puncak dan nilai rho. Gunakan untuk peralihan licin yang kepenuhannya hendak anda laraskan, daripada rata hingga hampir sudut tajam.","help.sketch.constrainer":"Menggunakan kekangan yang hampir dimiliki satu atau dua lengkung yang dipilih, seperti mendatar, selari, tangen atau sama. Gunakan untuk mengemaskan lakaran lukisan tangan satu hubungan demi satu hubungan.","help.sketch.constraint.coincident":"Menjadikan satu titik bertindih tepat dengan titik lain, lengkung atau paksi lakaran. Gunakan untuk menutup jurang dalam profil atau untuk meletakkan titik pada garis.","help.sketch.constraint.collinear":"Menjadikan dua garis terletak pada satu garis lurus. Gunakan untuk menjajarkan tepi yang terputus, seperti kedua-dua sisi takuk.","help.sketch.constraint.concentric":"Memberi dua bulatan atau lengkok pusat yang sama. Gunakan untuk gelang, lubang benam rata dan aci bertingkat.","help.sketch.constraint.curvature":"Menjadikan dua lengkung yang bertemu di titik hujung bersambung dengan kelengkungan yang sama (G2). Gunakan apabila sambungan tangen tidak cukup licin, contohnya pada permukaan yang kelihatan.","help.sketch.constraint.equal":"Menjadikan garis sama panjang, atau bulatan dan lengkok sama jejari. Gunakan supaya satu dimensi memacu beberapa ciri yang sepadan.","help.sketch.constraint.fix":"Menetapkan titik atau lengkung di tempatnya, atau melepaskannya semula. Gunakan untuk geometri yang tidak boleh bergerak apabila anda menyeret atau menyelesaikan lakaran.","help.sketch.constraint.horizontal_vertical":"Menjadikan garis, atau garis antara dua titik, mendatar atau menegak, mana-mana yang lebih hampir. Gunakan untuk meluruskan garis luar mengikut paksi lakaran.","help.sketch.constraint.midpoint":"Meletakkan titik di tengah garis, atau menjadikan titik tengah dua garis bertemu. Gunakan untuk memusatkan geometri pada tepi.","help.sketch.constraint.parallel":"Menjadikan dua garis selari. Gunakan untuk sisi yang mesti kekal selari apabila dimensi lain berubah.","help.sketch.constraint.perpendicular":"Menjadikan dua garis bertemu pada sudut tegak. Gunakan untuk sudut segi empat antara garis yang tidak berada pada paksi lakaran.","help.sketch.constraint.polygon":"Menjadikan rantaian garis tertutup sebagai poligon sekata: sisi sama panjang, dengan setiap sudut pada satu bulatan. Gunakan untuk menjadikan poligon lukisan tangan sekata dan mengekalkannya begitu.","help.sketch.constraint.symmetry":"Menjadikan dua titik atau lengkung saling bercermin merentasi garis atau mengelilingi titik. Gunakan untuk memastikan profil kekal simetri apabila anda mengubah satu sisi.","help.sketch.constraint.tangent":"Menjadikan dua lengkung bersentuhan secara tangen, seperti garis dan lengkok. Gunakan untuk sambungan licin tanpa patahan.","help.sketch.construction":"Menukar lengkung antara geometri biasa dan geometri binaan, yang diabaikan oleh profil. Gunakan lengkung binaan sebagai pembantu untuk susun atur, rujukan dan dimensi.","help.sketch.construction_line":"Cipta garis binaan tak terhingga melalui dua titik. Gunakannya untuk menyusun lakaran tanpa memisahkan profil.","help.sketch.construction_line.angle":"Cipta garis binaan tak terhingga pada sudut daripada paksi X lakaran. Pilih titik dan taip sudutnya, atau pilih arahnya.","help.sketch.construction_line.bisector":"Pilih dua garis lakaran lurus yang bersilang, kemudian pilih salah satu pembahagi dua sudut. Hasilnya mengikut garis sumbernya.","help.sketch.construction_line.horizontal":"Cipta garis binaan mendatar tak terhingga melalui satu titik. Kekangan mendatarnya kekal apabila disunting kemudian.","help.sketch.construction_line.parallel":"Pilih garis lakaran lurus, kemudian letakkan garis binaan tak terhingga yang selari. Klik kanan untuk memilih rujukan lain.","help.sketch.construction_line.perpendicular":"Pilih garis lakaran lurus, kemudian letakkan garis binaan tak terhingga yang serenjang. Klik kanan untuk memilih rujukan lain.","help.sketch.construction_line.tangent_at":"Cipta tangen pada satu titik pada bulatan atau lengkok bulat, atau pada titik hujung splin atau lengkung kon yang terbuka. Pilih lengkung itu, kemudian titik sentuhnya.","help.sketch.construction_line.tangent_external":"Pilih bulatan atau lengkok bulat, kemudian satu titik luar dan satu penyelesaian tangen. Pratonton hanya menunjukkan titik sentuh pada lengkok yang dilukis.","help.sketch.construction_line.tangent_two":"Pilih dua bulatan atau lengkok bulat, kemudian pilih tangen sepunya dalam pratonton. Titik sentuh mesti terletak pada lengkung yang dilukis.","help.sketch.construction_line.vertical":"Cipta garis binaan menegak tak terhingga melalui satu titik. Kekangan menegaknya kekal apabila disunting kemudian.","help.sketch.copy":"Menyalin lengkung dan titik lakaran yang dipilih, bersama kekangan dan dimensi di antaranya. Tampalkannya ke dalam lakaran ini atau lakaran lain.","help.sketch.create":"Memulakan lakaran 2D baharu pada satah atau muka rata model. Setiap Semperit, Putar dan Sapu bermula dengan lakaran.","help.sketch.cut":"Menyalin geometri lakaran yang dipilih dan memadamnya daripada lakaran, dalam satu langkah Buat Asal. Tampalkannya di tempat lain dalam lakaran ini atau ke dalam lakaran lain.","help.sketch.dimension":"Menambah dimensi pemacu: panjang, jarak, sudut, jejari atau diameter, bergantung pada apa yang anda pilih. Taip nilai atau nama parameter, dan lakaran mengikutinya.","help.sketch.edit":"Membuka lakaran sedia ada untuk disunting. Ciri yang dibina padanya dikemas kini apabila anda menamatkan lakaran.","help.sketch.ellipse":"Melukis elips daripada pusatnya, hujung paksi utama dan satu titik pada sisi minornya. Gunakan untuk bukaan bujur, sesondol dan bentuk bulat memanjang yang lain.","help.sketch.equation_curve":"Melukis lengkung daripada formula: x(t) dan y(t), atau y = f(x), dalam satu julat. Formula boleh menggunakan parameter dan lengkung akan mengikutinya: gunakannya untuk gelombang sinus, lingkaran atau involut gigi gear.","help.sketch.extend":"Memanjangkan garis atau lengkok sehingga lengkung terdekat yang menghalang, atau memanjangkan dua lengkung sehingga bertemu. Gunakan untuk menutup jurang dalam profil selepas memangkas atau menyunting.","help.sketch.fillet":"Membulatkan sudut tempat dua garis atau lengkok bertemu dengan lengkok berjejari tertentu. Beberapa sudut yang dibulatkan bersama berkongsi satu jejari.","help.sketch.finish":"Meninggalkan lakaran dan kembali ke model. Profilnya yang tertutup kemudian sedia untuk Semperit, Putar dan ciri lain.","help.sketch.finish_auto_constrain":"Menjalankan Kekangan Automatik pada lakaran, kemudian menamatkannya. Gunakan untuk meninggalkan lakaran yang tertakrif sepenuhnya dalam satu langkah.","help.sketch.fit_curves_to_section":"Memotong jasad mesh atau pepejal dengan satah lakaran dan memadankan garis dan lengkok pada keratan itu. Gunakan untuk membina semula bahagian yang diimbas atau diimport sebagai lakaran boleh sunting.","help.sketch.include_3d":"Membawa tepi model, bucu dan lengkung lakaran lain ke dalam lakaran ini sebagai rujukan terpaut, dan meratakan yang tidak berada pada satahnya ke atasnya. Gunakan untuk membina berdasarkan geometri yang tidak terletak pada satah lakaran.","help.sketch.infinite":"Menukar garis antara garis biasa dan garis binaan tak terhingga yang melintasi seluruh pandangan. Gunakan sebagai rujukan susun atur yang tidak pernah terlalu pendek.","help.sketch.insert_dxf":"Membaca lengkung lukisan DXF ke dalam lakaran, diskalakan, diputar dan diletakkan mengikut tetapan anda. Gunakan untuk membina berdasarkan lukisan 2D daripada program lain, seperti garis luar potongan laser.","help.sketch.insert_svg":"Membaca laluan lukisan SVG ke dalam lakaran, diskalakan, diputar dan diletakkan mengikut tetapan anda. Gunakan untuk menukar logo atau garis luar vektor kepada lengkung yang boleh disemperit.","help.sketch.inspect":"Membuka laporan tentang lakaran yang terbuka: berapa banyak darjah kebebasan yang tinggal dan sama ada ia terkekang sepenuhnya. Gunakan untuk mengetahui apa yang masih bergerak sebelum anda menamatkan lakaran.","help.sketch.intersect":"Menambah lengkung atau titik tempat jasad, muka, tepi atau lakaran lain melintasi satah lakaran. Ia kekal terpaut dan mengikut model apabila model berubah.","help.sketch.intersection_curve":"Mencipta lengkung 3D tempat dua jasad atau muka bertemu, terpaut kepadanya. Gunakan sebagai laluan atau rel pemandu yang mengikut model.","help.sketch.isoparametric_curve":"Mencipta lengkung 3D di sepanjang arah U atau V muka melalui titik yang anda pilih, terpaut kepada muka itu. Gunakan sebagai laluan atau garis belahan yang mengikut permukaan.","help.sketch.line":"Melukis garis bersambung titik demi titik, sebagai rantaian terbuka atau garis luar tertutup. Ia ialah alat asas bagi kebanyakan profil.","help.sketch.line.midpoint":"Melukis garis daripada titik tengahnya ke satu hujung, dengan hujung satu lagi dicerminkan. Gunakan untuk garis yang berpusat pada satu titik, seperti tepi simetri.","help.sketch.line3d":"Melukis garis lurus bersambung antara titik dalam ruang, dengan Lakaran 3D aktif. Gunakan untuk laluan dan rangka yang keluar daripada satah lakaran.","help.sketch.mirror":"Mencerminkan lengkung dan titik lakaran merentasi garis atau paksi dan menambah kekangan simetri. Gunakan untuk melukis separuh profil simetri dan melengkapkannya.","help.sketch.move":"Mengalihkan atau memutar lengkung dan titik lakaran, atau salinannya. Gunakan untuk meletakkan semula geometri sambil mengekalkan bentuk dan kekangannya.","help.sketch.offset":"Mencipta salinan rantaian lengkung pada jarak tertentu, di satu sisi atau kedua-duanya. Gunakan untuk dinding, garis luar dan kelegaan; jarak kekal sebagai dimensi yang boleh disunting.","help.sketch.paste":"Menampal geometri lakaran yang anda salin atau potong ke dalam lakaran aktif. Letakkan pada satu titik atau anjakkan dengan ofset.","help.sketch.pattern.circular":"Menyalin geometri lakaran mengelilingi titik pusat, sepanjang bulatan penuh atau sudut tertentu. Gunakan untuk bulatan bolt, ruji dan gigi.","help.sketch.pattern.rectangular":"Menyalin geometri lakaran dalam baris dan lajur pada jarak tertentu. Gunakan untuk grid lubang, slot atau lubang angin.","help.sketch.point":"Meletakkan titik lakaran. Gunakan sebagai rujukan untuk dimensi, kekangan, pusat lubang atau ciri kemudian.","help.sketch.point3d":"Meletakkan titik dalam ruang, dengan Lakaran 3D aktif. Gunakan sebagai rujukan untuk lengkung dan laluan 3D.","help.sketch.polygon.circumscribed":"Melukis poligon sekata di sekeliling bulatan, bersaiz daripada pusatnya ke tengah satu sisi. Gunakan apabila lebar merentasi sisi rata diketahui, seperti pada nat heks.","help.sketch.polygon.edge":"Melukis poligon sekata daripada dua hujung satu sisi. Gunakan apabila panjang dan kedudukan satu sisi diketahui.","help.sketch.polygon.inscribed":"Melukis poligon sekata di dalam bulatan, bersaiz daripada pusatnya ke satu sudut. Gunakan apabila saiz merentasi sudut diketahui.","help.sketch.project":"Membawa tepi model, muka, bucu dan lengkung lakaran lain ke dalam lakaran ini, diunjurkan ke satahnya. Ia kekal terpaut dan mengikut model apabila model berubah.","help.sketch.project_to_surface":"Mengunjurkan lengkung lakaran lain di sepanjang normal lakaran ini ke atas muka, sebagai lengkung 3D terpaut. Gunakan untuk meletakkan logo, garis belahan atau laluan pada permukaan melengkung.","help.sketch.rectangle.center":"Melukis segi empat tepat daripada pusatnya dan satu sudut. Gunakan untuk garis luar yang berpusat pada satu titik, seperti titik asal.","help.sketch.rectangle.rounded":"Melukis segi empat tepat dengan keempat-empat sudut dibulatkan pada satu jejari. Gunakan untuk plat, penutup dan bukaan bersudut bulat.","help.sketch.rectangle.three_point":"Melukis segi empat tepat daripada satu tepi dan satu titik pada sisi bertentangan. Gunakan untuk segi empat tepat yang condong terhadap paksi lakaran.","help.sketch.rectangle.two_point":"Melukis segi empat tepat daripada dua sudut bertentangan. Gunakan untuk garis luar plat, blok dan poket.","help.sketch.scale":"Menskalakan lengkung dan titik lakaran dengan satu faktor mengikut titik asas. Gunakan untuk mengubah saiz sebahagian lakaran tanpa melukisnya semula.","help.sketch.slot.arc_center":"Melukis slot melengkung dengan lebar tertentu di sepanjang lengkok yang ditetapkan oleh pusat, permulaan dan penghujungnya. Gunakan untuk slot pelarasan di sekeliling pangsi.","help.sketch.slot.arc_three_point":"Melukis slot melengkung dengan lebar tertentu di sepanjang lengkok melalui tiga titik. Gunakan apabila laluan slot perlu melalui titik yang diberi.","help.sketch.slot.center_point":"Melukis slot lurus dengan lebar tertentu daripada pusatnya ke pusat satu lengkok hujung. Gunakan untuk slot yang berpusat pada satu titik.","help.sketch.slot.center_to_center":"Melukis slot lurus dengan lebar tertentu antara pusat kedua-dua lengkok hujungnya. Gunakan untuk slot yang didimensikan dari pusat ke pusat, seperti slot pelarasan untuk skru.","help.sketch.slot.overall":"Melukis slot lurus dengan lebar tertentu dari satu hujung luar ke hujung yang lain. Gunakan apabila panjang keseluruhan slot yang penting.","help.sketch.spline.control_point":"Melukis splin kubik yang dibentuk oleh titik kawalan yang tidak dilaluinya. Gunakan untuk lengkung licin dan mengalir yang anda bentuk dengan menggerakkan titik.","help.sketch.spline.control_point_5":"Melukis splin darjah 5 yang dibentuk oleh titik kawalan. Gunakan apabila lengkung perlu bersambung dengan kelengkungan yang lebih licin, contohnya pada permukaan bergaya yang kelihatan.","help.sketch.spline.fit_point":"Melukis splin licin yang melalui setiap titik yang anda letakkan, terbuka atau tertutup. Gunakan untuk menyurih bentuk melalui titik yang diketahui.","help.sketch.spline3d":"Melukis lengkung licin dalam ruang melalui titik, dengan Lakaran 3D aktif. Gunakan untuk laluan sapuan dan laluan kabel yang keluar daripada satah lakaran.","help.sketch.spun_profile":"Mencipta dalam satah lakaran garis luar yang dilalui oleh jasad apabila ia berputar pada paksi. Gunakan untuk mendapatkan siluet bahagian bubutan bagi Putar atau lukisan.","help.sketch.text":"Menulis teks dalam lakaran dengan fon, ketinggian dan sudut yang dipilih; perkataannya boleh mengikut parameter. Semperit atau timbulkan untuk label dan tulisan.","help.sketch.transform":"Menskalakan, memutar dan mengalihkan geometri lakaran mengelilingi titik pusat dalam satu langkah. Gunakan untuk meletakkan semula dan mengubah saiz pilihan sekali gus.","help.sketch.trim":"Membuang bahagian lengkung antara persilangan terdekat di sekeliling tempat anda mengklik. Gunakan untuk mengemaskan garis bertindih menjadi profil tertutup.","help.solid.align":"Mengalihkan jasad yang dipilih supaya satu titik, muka atau satah padanya bertemu satu titik, muka atau satah di tempat lain. Gunakan untuk meletakkan satu bahagian pada bahagian lain tanpa mengukur ofset.","help.solid.boundary_fill":"Membuat pepejal daripada kawasan yang dikelilingi jasad alat yang bertindih, mengisi hanya kawasan yang anda pilih. Gunakan untuk membina bentuk daripada ruang yang disempadani bersama oleh beberapa jasad.","help.solid.bounding_solid":"Mencipta kotak yang mengurung jasad yang dipilih, dengan margin pilihan. Gunakan untuk melihat saiz keseluruhan bahagian, atau sebagai stok bahan yang daripadanya ia dimesin.","help.solid.box":"Mencipta kotak daripada panjang, lebar dan tinggi, daripada titik sudut atau berpusat pada satu titik. Gunakan untuk blok pantas, pemegang tempat atau jasad untuk dipotong ciri padanya.","help.solid.chamfer":"Memotong tepi yang dipilih dengan potongan serong rata sejauh jarak yang anda tetapkan. Gunakan untuk menumpulkan tepi tajam atau memudahkan kemasukan pin atau skru.","help.solid.coil":"Mencipta jasad heliks, seperti pegas, daripada diameter, bilangan lilitan, ketinggian atau pic dan keratan bulat atau segi empat sama. Gunakan untuk pegas, gegelung dan rabung heliks.","help.solid.combine":"Mencantum jasad, memotongnya daripada jasad sasaran, atau hanya mengekalkan isi padu yang dikongsi, dan boleh mengekalkan jasad alat. Gunakan untuk menggabungkan bahagian, memotong satu bentuk dengan bentuk lain atau mencari tempat dua jasad bertindih.","help.solid.cone":"Mencipta kon daripada bulatan tapak dan ketinggian, atau kon terpenggal apabila bahagian atas juga berjejari. Gunakan untuk tirus, corong, lubang benam tirus dan hujung tajam.","help.solid.cylinder":"Mencipta silinder daripada jejari atau diameter dan ketinggian, berdiri pada satu titik di sepanjang paksi. Gunakan untuk aci, pin, bonggol dan bakal bulat.","help.solid.draft":"Mencondongkan muka yang dipilih mengikut sudut yang anda tetapkan, diukur dari satah neutral. Gunakan pada bahagian yang diacu atau dituang supaya boleh dikeluarkan dari acuan.","help.solid.emboss":"Menimbulkan profil lakaran, seperti teks atau logo, keluar daripada muka, atau membenamkannya ke dalamnya. Gunakan untuk tulisan, label dan tanda pada muka rata atau bulat.","help.solid.extrude":"Menyemperit profil lakaran menjadi 3D sepanjang jarak yang ditetapkan, menambah atau membuang bahan. Gunakan untuk menukar garis bentuk rata menjadi blok, bonggol atau poket.","help.solid.fillet":"Membulatkan tepi yang dipilih dengan peralihan bulat licin berjejari yang anda tetapkan. Gunakan untuk melembutkan tepi tajam demi kekuatan, keselesaan atau rupa.","help.solid.hole":"Menggerudi lubang bulat berdiameter yang anda tetapkan pada titik terpilih pada muka. Gunakan untuk ruang skru, pin dan bukaan bulat ringkas yang lain.","help.solid.loft":"Menghasilkan pepejal licin antara dua atau lebih profil lakaran, atau dari profil ke satu titik. Gunakan untuk peralihan, corong, pemegang dan sebarang bentuk yang keratannya berubah sepanjang panjangnya.","help.solid.mirror":"Membuat salinan cermin bagi jasad atau ciri yang dipilih merentasi satah, dan boleh mencantumkannya dengan yang asal. Gunakan untuk bahagian simetri, supaya anda memodelkan separuh sahaja dan mendapat kedua-duanya.","help.solid.move":"Mengalih atau memutar jasad yang dipilih, atau salinannya, mengikut jarak dan sudut yang ditetapkan. Gunakan untuk menempatkan semula jasad atau membuat satu lagi di tempat lain.","help.solid.offset_face":"Menolak muka yang dipilih ke dalam atau ke luar mengikut jarak yang ditetapkan, dan muka di sekelilingnya turut mengikut. Gunakan untuk menebalkan dinding, mendalamkan poket atau meninggikan bonggol tanpa menyunting lakaran.","help.solid.pattern.circular":"Mengulang objek yang dipilih mengelilingi paksi, mengikut bilangan dan jumlah sudut yang ditetapkan. Gunakan untuk bulatan bolt, jejari roda, sirip dan gigi.","help.solid.pattern.path":"Menyalin ciri atau jasad di sepanjang laluan lakaran, mengikut bilangan dan jarak. Gunakan untuk lubang di sepanjang tepi melengkung atau bahagian di sepanjang rel.","help.solid.pattern.rectangular":"Mengulang objek yang dipilih dalam satu atau dua arah mengikut bilangan dan selang yang ditetapkan. Gunakan untuk baris dan grid lubang, rusuk, pin atau kaki.","help.solid.pipe":"Mencipta tiub bulat di sepanjang laluan lengkung lakaran, pepejal atau berongga dengan ketebalan dinding. Gunakan untuk tiub, wayar, kabel dan rel.","help.solid.press_pull":"Menambah atau membuang bahan semasa anda menyeret muka, atau membulatkan tepi semasa anda menyeretnya. Gunakan untuk perubahan pantas terus pada model.","help.solid.remove":"Mengeluarkan jasad yang dipilih daripada reka bentuk mulai titik ini dalam garis masa; langkah terdahulu masih mengekalkannya. Gunakan untuk menggugurkan jasad bantu, seperti alat pemotong yang tidak diperlukan lagi.","help.solid.replace_face":"Mengalihkan muka rata yang dipilih ke satah atau ke muka selari, dan jasad membesar atau mengecil untuk bertemu dengannya. Gunakan untuk menyamakan aras muka dengan bahagian lain atau satah binaan.","help.solid.revolve":"Memutar profil lakaran mengelilingi paksi untuk menghasilkan pepejal bulat. Gunakan untuk aci, tombol, mangkuk dan mana-mana bahagian yang bulat di sekeliling garis tengah.","help.solid.rib":"Menambah dinding nipis di sepanjang lengkung lakaran terbuka, diisi sehingga muka seterusnya pada jasad. Gunakan untuk mengukuhkan dinding dan sudut, contohnya pada bahagian teracu atau bercetak.","help.solid.scale":"Membesarkan atau mengecilkan jasad yang dipilih mengikut faktor, sama ke semua arah atau satu bagi setiap paksi. Gunakan untuk mengubah saiz bentuk yang diimport atau untuk mengambil kira pengecutan.","help.solid.shell":"Mengosongkan bahagian dalam pepejal, meninggalkan dinding setebal yang ditetapkan, dan boleh membuka muka yang anda pilih. Gunakan untuk kotak, penutup dan bahagian berdinding nipis yang lain.","help.solid.sphere":"Mencipta sfera daripada jejari atau diameter mengelilingi titik pusat. Gunakan untuk bebola, tombol dan hujung bulat.","help.solid.split_body":"Memotong jasad kepada beberapa jasad berasingan menggunakan satah, muka jasad lain atau garis lakaran. Gunakan untuk menghasilkan bahagian yang dicetak, dimesin atau diwarnakan secara berasingan.","help.solid.split_face":"Membahagikan muka yang dipilih di sepanjang satah, muka jasad lain atau lengkung lakaran, tanpa memotong jasad. Gunakan untuk memberikan sebahagian muka sudut draf, warna atau ofset tersendiri.","help.solid.sweep":"Menyeret profil lakaran di sepanjang laluan untuk menghasilkan pepejal. Gunakan untuk paip, rel, pemegang dan mana-mana bahagian berkeratan malar yang mengikut lengkung.","help.solid.thread":"Menambah bebenang metrik ISO pada muka silinder, sama ada sebagai bebenang kosmetik atau dipotong ke dalam jasad. Gunakan untuk bolt, lubang berbebenang dan bahagian skru bercetak.","help.solid.torus":"Mencipta gelang daripada jejari utama mengelilingi paksinya dan jejari minor untuk keratan bulatnya. Gunakan untuk gelang-O, pemegang dan manik bulat.","help.solid.web":"Menambah dinding nipis di sepanjang setiap lengkung lakaran terbuka, masing-masing diisi sehingga muka seterusnya pada jasad. Gunakan untuk grid dinding penyokong di dalam perumah dan dulang.","help.surface.blend":"Mencipta permukaan yang menyambung tepi dua jasad, tangen atau selanjar kelengkungan kepada kedua-duanya. Gunakan untuk menyambung dua permukaan dengan licin merentasi jurang.","help.surface.boundary":"Mencipta permukaan yang mengisi gelung dua hingga empat lengkung lakaran, atau rangkaian lengkung. Gunakan untuk panel bentuk bebas yang ditakrifkan oleh tepinya.","help.surface.extend":"Memanjangkan permukaan melepasi tepinya, mengikut jarak atau sehingga satah atau muka. Gunakan supaya permukaan bertindih sebelum anda memangkas atau mencantumnya.","help.surface.extrude":"Menolak lengkung atau profil lakaran sepanjang satu jarak menjadi permukaan, dinding sahaja, tanpa penutup. Gunakan untuk dinding nipis dan untuk alat pemotong atau pembelah.","help.surface.fair":"Melicinkan bahagian dalam muka bentuk bebas sementara tepinya kekal. Gunakan untuk meratakan bonjolan dan pantulan beralun pada permukaan.","help.surface.loft":"Mencipta permukaan yang melalui dua atau lebih keratan mengikut urutan, tanpa penutup. Gunakan untuk cangkerang dan peralihan antara bentuk yang berbeza.","help.surface.match":"Membina semula tepi permukaan supaya bertemu dengan tepi jasad lain, dengan tangen atau kelengkungan yang sepadan. Gunakan untuk menutup sambungan dengan licin antara dua permukaan.","help.surface.offset":"Mencipta salinan muka pada satu jarak di sepanjang normalnya, sebagai jasad permukaan baharu. Gunakan untuk kulit, kelegaan atau sisi lain sesuatu dinding.","help.surface.patch":"Mengisi kawasan lakaran atau gelung tertutup tepi dengan muka, rata atau melengkung licin. Gunakan untuk menutup lubang pada jasad permukaan.","help.surface.reverse_normal":"Membalikkan muka jasad permukaan, supaya bahagian luarnya menghadap arah lain. Gunakan sebelum menebalkan atau mencantum apabila muka menghala ke dalam.","help.surface.revolve":"Memutar lengkung atau profil lakaran pada paksi menjadi permukaan, tanpa penutup. Gunakan untuk cangkerang bulat seperti teduhan lampu, mangkuk dan muncung.","help.surface.ruled":"Mencipta jalur garis lurus keluar daripada rantaian tepi, sepanjang normal muka, tangen atau pada satu sudut. Gunakan untuk dinding draf, kawasan lari-keluar dan permukaan perpisahan.","help.surface.stitch":"Mencantum jasad permukaan bersama di sepanjang tepi yang dikongsi, menjadi pepejal apabila ia tertutup. Gunakan untuk menjadikan sekumpulan permukaan satu jasad.","help.surface.sweep":"Menggerakkan lengkung atau profil lakaran di sepanjang laluan menjadi permukaan, tanpa penutup. Gunakan untuk alur air, perapi dan bentuk nipis lain yang mengikut laluan.","help.surface.thicken":"Memberi ketebalan kepada jasad permukaan, menjadikannya pepejal. Gunakan untuk membuat bahagian yang boleh dicetak atau dimesin daripada permukaan.","help.surface.trim":"Memotong permukaan dengan satah, permukaan lain atau lengkung lakaran, dan mengekalkan sisi yang anda pilih. Gunakan untuk memotong permukaan mengikut bentuk sebelum dicantum.","help.surface.unstitch":"Melerai muka jasad menjadi jasad permukaan tersendiri; pepejal terlerai menjadi permukaan. Gunakan untuk mengolah semula muka tunggal pada jasad.","help.surface.untrim":"Membuang lubang daripada muka, atau memulihkan sempadan luarnya kepada had semula jadi permukaan. Gunakan untuk mendapatkan semula permukaan penuh selepas dipangkas.","help.third_party":"Lesen pihak ketiga","help.timeline.compute_all":"Membina semula setiap ciri dalam garis masa dari awal. Gunakan untuk menyegarkan model dan melihat ciri yang gagal.","help.timeline.delete":"Memadam ciri yang dipilih daripada garis masa; memadam lakaran turut memadam ciri yang dibina daripadanya. Gunakan untuk membuang langkah yang tidak lagi diperlukan.","help.timeline.dependents":"Menyenaraikan ciri yang akan dipadam bersama sesuatu ciri, dan yang akan gagal tanpanya. Gunakan sebelum memadam atau mengubah ciri.","help.timeline.play":"Main semula ciri yang tinggal satu demi satu, dengan jeda setengah saat selepas setiap pembinaan semula. Jalankan perintah ini sekali lagi atau tekan Escape untuk berhenti; Pergi ke penghujung melompat serta-merta.","help.view.apply":"Memutar pandangan ke arah piawai seperti hadapan, atas atau iso, atau ke pandangan bernama yang disimpan. Gunakan untuk melihat model dari sudut tetap.","help.view.delete":"Memadam pandangan bernama yang disimpan. Model tidak berubah.","help.view.fit":"Menzum dan menyorot supaya seluruh model, atau pilihan, memenuhi pandangan. Gunakan apabila model telah hilang daripada pandangan.","help.view.grid":"Memaparkan atau menyembunyikan grid dalam tetingkap pandangan. Gunakan sebagai panduan saiz dan orientasi semasa memodelkan.","help.view.ground_shadow":"Memaparkan atau menyembunyikan bayang model pada lantai. Gunakan untuk menilai ketinggian dan kedudukan dengan lebih mudah.","help.view.home":"Memutar pandangan kembali ke arah utama dan memuatkan model. Gunakan untuk kembali ke pandangan yang diketahui dengan cepat.","help.view.list":"Menyenaraikan pandangan bernama yang disimpan dalam reka bentuk. Gunakan untuk mencari pandangan yang anda simpan sebelum ini.","help.view.navigate":"Memutar, menyorot atau menzum pandangan mengikut langkah, seperti suku pusingan ke kiri. Gunakan untuk menggerakkan kamera dengan tepat dan bukannya menyeret.","help.view.navigation_bar":"Memaparkan atau menyembunyikan bar navigasi di bahagian bawah tetingkap pandangan. Sembunyikan untuk ruang lebih luas, paparkan untuk mencapai alat pandangan dengan tetikus.","help.view.rename":"Memberi nama baharu kepada pandangan bernama yang disimpan. Pandangan itu sendiri kekal sama.","help.view.save":"Menyimpan kedudukan kamera semasa sebagai pandangan bernama dalam reka bentuk. Gunakan untuk kembali ke sudut yang sama kemudian, contohnya untuk tangkapan skrin.","help.view.spin":"Mengorbit pandangan mengelilingi model secara berterusan sehingga klik atau kekunci seterusnya. Gunakan untuk mempersembahkan model dari semua sisi.","help.view.tool":"Mengunci alat kamera, orbit, sorot atau zum, supaya menyeret dengan butang kiri tetikus menggerakkan pandangan sehingga anda mematikannya. Gunakan pada pad jejak atau tanpa butang tengah tetikus.","help.view.visual_style":"Menukar cara model dilukis: berlorek dengan atau tanpa tepi, rangka dawai, atau dengan tepi tersembunyi. Gunakan rangka dawai untuk melihat ke dalam, berlorek untuk rupa yang bersih.","history.sketch_under_constrained":"Kurang terkekang ({count} darjah kebebasan)","history.sketch_under_constrained_one":"Kurang terkekang ({count} darjah kebebasan)","hole_presets.confirm_delete":"Sahkan pemadaman","hole_presets.delete":"Padam","hole_presets.delete_prompt":"Padam pratetap peribadi ini? Lubang sedia ada tidak berubah.","hole_presets.full":"Koleksi peribadi sudah mengandungi 64 pratetap.","hole_presets.invalid_name":"Masukkan nama pendek tanpa pemisah baris atau aksara kawalan.","hole_presets.invalid_parameters":"Lengkapkan parameter lubang menggunakan ungkapan yang sah dengan panjang yang munasabah.","hole_presets.missing":"Pratetap yang dipilih tidak lagi tersedia.","hole_presets.name":"Nama pratetap","hole_presets.name_exists":"Pratetap dengan nama ini sudah wujud. Gunakan nama lain.","hole_presets.name_hint":"Nama yang unik","hole_presets.overwrite":"Simpan perubahan pada pratetap yang dipilih","hole_presets.preset":"Pratetap","hole_presets.recall":"Panggil semula","hole_presets.rename":"Tukar Nama","hole_presets.save":"Simpan baharu","hole_presets.scope":"Disimpan dalam profil anda untuk semua projek.","hole_presets.select":"Pilih pratetap","hole_presets.title":"Pratetap peribadi","hole_presets.unsupported_options":"Pratetap ini menggunakan pilihan bebenang yang tidak dapat dipanggil semula oleh versi ini.","hole_presets.unsupported_overwrite":"Pratetap ini mengandungi pilihan yang tidak dapat ditimpa dengan selamat.","home.back":"Kembali ke {name}","home.crashes":"Laporan ranap","home.design_workspace":"Reka Bentuk","home.documentation":"Dokumentasi","home.export":"Eksport","home.export_hint":"Pilih format untuk reka bentuk semasa.","home.export_json_hint":"Reka bentuk boleh sunting dan sejarah perintah","home.export_mesh_hint":"Jejaring untuk pencetakan atau perkongsian","home.export_step_hint":"Geometri pepejal yang tepat","home.import":"Import…","home.import_hint":"STEP, IGES atau jejaring ke dalam reka bentuk baharu","home.in_this_browser":"dalam pelayar ini","home.missing":"tiada","home.month_01":"Jan","hom