ристи само емитере; изостави документоване пасивне картице","render.library_empty":"Нема одговарајућих ресурса. Покушајте са другим упитом или филтером доступности.","render.library_environment_concepts":"Концепти окружења","render.library_extent":"Опсег предмета","render.library_favorite":"Додај у омиљено","render.library_favorites":"Омиљено","render.library_filters":"Каталог и доступност","render.library_grid":"Мрежа","render.library_hdr":"Уграђена HDR окружења","render.library_hdr_help":"Уграђује изворни HDR у сачувано подешавање. Ауторско исходиште географске дужине изричито се претвара; након чувања није потребна спољна датотека.","render.library_in_design":"У дизајну","render.library_inspect_only":"Изаберите за преглед; ништа се не примењује аутоматски. Омиљено и недавна историја припадају овој сесији отвореног документа.","render.library_ior":"IOR","render.library_light_concepts":"Концепти осветљења","render.library_list":"Списак","render.library_maps_help":"Уграђене мапе могу се сачувати са фиксираним изворима и локалним мапирањем примерака. Привремена оптичка надјачавања остају засебан режим.","render.library_material_concepts":"Концепти материјала","render.library_metallic":"Металност","render.library_native_scenes":"Изворни студији","render.library_next":"Следећа страница","render.library_omitted":"Није укључено","render.library_opacity":"Непрозирност","render.library_other":"Остали изгледи","render.library_physical_profiles":"Профили физичких референци","render.library_previous":"Претходна страница","render.library_quality_concepts":"Спецификације квалитета","render.library_recent":"Недавно","render.library_replace_environment":"Изричито замени постојеће окружење","render.library_replace_studio":"Замени сачувано осветљење, окружење и сцену","render.library_results":"Одговарајући ресурси","render.library_rig_help":"Уклопи једном у изричито задати центар и физички опсег. Комплетне поставе укључују пасивне картице; препреке калибрације и даље одбијају. Конзервативни размак емитера и картица проверава се пре чувања.","render.library_rigs":"Ауторске поставе осветљења","render.library_roughness":"Храпавост","render.library_save_maps":"Сачувај мапе у ово подешавање","render.library_scene_bounds":"Користи забележене границе сцене","render.library_scenes":"Спецификације сцене","render.library_search":"Претражи библиотеку","render.library_select_hint":"Изаберите ресурс у Библиотеци да прегледате његове подржане радње и ограничења.","render.library_selene":"SELENE непрозирни изгледи","render.library_selene_shots":"SELENE спецификације кадрова","render.library_short_blocked":"Недоступно","render.library_short_native":"Изворни састав","render.library_short_projection":"Подржана пројекција","render.library_short_reference":"Само референца","render.library_short_specification":"Само спецификација","render.library_source_preview":"Учитај преглед изворне мапе","render.library_source_preview_help":"Ауторска изворна мапа основне боје. Ово није рендеровани ни измерени преглед материјала.","render.library_specification_only":"Само спецификација: није комплетно извршно подешавање. Потребни ефекти, ресурси и улоге предмета и даље захтевају изричиту имплементацију и повезивање.","render.library_specs":"Само спецификације","render.library_status":"Доступност","render.library_surfaces":"Ауторске PBR површине","render.library_target":"Циљно тело","render.library_title":"Библиотека ресурса за рендеровање","render.library_unfavorite":"Уклони из омиљеног","render.library_uniform_ack":"Користи једноличну апроксимацију без просторних или напредних ефеката","render.library_usable":"Извршне пројекције","render.library_users":"Корисници","render.light_aim":"Усмери ка","render.light_anchor_pending":"Промена координатног система светла још није подржана.","render.light_azimuth":"Азимут","render.light_backend_limit":"Изаберите CPU праћење зрака или изричити GPU студио да бисте мењали светла. Светла старог GPU студија остају само за читање.","render.light_behaviour":"ПОНАШАЊЕ","render.light_default_fill":"Допунско","render.light_default_key":"Главно","render.light_default_number":"Светло {number}","render.light_default_rim":"Рубно","render.light_delete":"Избриши","render.light_distance":"Растојање","render.light_duplicate":"Дуплицирај","render.light_elevation":"Елевација","render.light_gpu_punctual":"Тачкаста светла и рефлектори доступни су уз CPU праћење зрака.","render.light_hard_shadow":"Ово светло има оштре сенке; мекоћа емитера није доступна.","render.light_intensity":"Интензитет","render.light_missing":"Ово светло више не постоји. Изаберите светло у стаблу модела.","render.light_place_highlight":"Постави према одсјају","render.light_place_pending":"Постављање према одсјају захтева избор светла у прозору приказа и још није подржано.","render.light_position":"ПОЛОЖАЈ","render.light_preview_help":"Приказ уживо је без сенки; површинска светла користе апроксимацију узорком из центра. Рендеровање користи потпуни модел светла.","render.light_product_centre":"Центар производа","render.light_size":"Величина","render.light_softness":"Мекоћа","render.light_temperature":"Температура боје","render.light_temperature_help":"Приближна нијанса црног тела; чува се као линеарни RGB.","render.light_type":"Врста","render.light_type_area":"Површинско","render.light_type_point":"Тачкасто","render.light_type_spot":"Рефлектор","render.light_type_sun":"Сунце","render.light_view_only":"Само једно светло и искључена светла утичу на овај приказ и његове рендере; никад се не чувају у дизајну.","render.light_world_origin":"Исходиште света","render.lighting_aim_point":"Тачка циљања","render.lighting_apply":"Примени подешавање","render.lighting_area_samples":"Узорци површинског светла","render.lighting_budget":"Буџет","render.lighting_budget_help":"Бројеви су само за читање. Додајте, дуплицирајте или избришите светла да бисте их променили; метода одређује ограничења.","render.lighting_colour":"Боја","render.lighting_consent":"Замени усмерена светла овим подешавањем","render.lighting_custom":"Прилагођена светла","render.lighting_custom_help":"Избор опције Прилагођено претвара подешавање у светла која се могу мењати, свако у свом реду у стаблу.","render.lighting_direction":"Смер X Y Z","render.lighting_direction_help":"Или упишите смер према светлу (X Y Z).","render.lighting_distance_unit":" × величина","render.lighting_edge_u":"Вектор странице U","render.lighting_edge_v":"Вектор странице V","render.lighting_falloff":"Слабљење","render.lighting_falloff_help":"Интензитет је наведен на референтном растојању.","render.lighting_height":"Висина V","render.lighting_minimum":"Минимум","render.lighting_mute":"Искључи ово светло","render.lighting_point":"Тачка","render.lighting_preset":"Подешавање студија","render.lighting_preset_cpu":"Подешавања студија са усмереним светлима захтевају CPU праћење зрака. GPU осветљење користи изричита сунчева и површинска светла.","render.lighting_preset_row":"Подешавање","render.lighting_radiance":"Радијанса","render.lighting_reference":"Референца","render.lighting_review_help":"Замењује списак усмерених светала. Задржава тачкаста и површинска светла, окружење, сенке, камеру и сва остала подешавања кадра.","render.lighting_review_title":"Прегледај подешавање осветљења","render.lighting_samples_cpu":"Узорци површинског светла важе за CPU праћење зрака.","render.lighting_samples_need_area":"Додајте CPU површинско светло да бисте подесили узорке површинског светла.","render.lighting_samples_reason":"Узорци површинског светла морају бити 1, 4, 16 или 64.","render.lighting_shadow_cpu":"Прекидач сенки захтева CPU праћење зрака. GPU праћење путања увек баца сенке.","render.lighting_shadows":"Баци сенке","render.lighting_shadows_section":"Сенке и узорковање","render.lighting_shape":"Облик","render.lighting_solo":"Само ово светло","render.lighting_source":"Извор","render.lighting_source_section":"Извор светла","render.lighting_spot_preserved":"Ово тачкасто светло задржава сачувани конус рефлектора док му се не промени врста.","render.lighting_sun_distance":"Смер сунца не зависи од растојања и тачке циљања.","render.lighting_unsupported":"неподржано","render.lighting_used":"{used} од {limit}","render.lighting_width":"Ширина U","render.lighting_world_position":"Светски X Y Z","render.lights_fixed_to":"Светла везана за","render.linear_help":"Задржава 32-битни флоат RGBA мастер пре уклањања шума, експозиције, мапирања тонова, филтера и позадине. Линеарни sRGB/D65; помножен покривеношћу. Додатна меморија се изричито одобрава. Без компресије и додатних пролаза.","render.linear_retain":"Задржи сирови линеарни EXR","render.linear_unavailable":"Изабрани завршени кадар нема задржани EXR. Омогућите задржавање пре рендеровања; старији PNG не може да врати сирову радијансу.","render.look_add":"Додај изглед боје","render.look_applied":"Примењено: {name}","render.look_bleach":"По узору на bleach bypass","render.look_cool":"Хладно","render.look_cyanotype":"По узору на цијанотипију","render.look_faded":"Избледели отисак","render.look_material":"Материјал","render.look_mono":"Једнобојно","render.look_pasted":"Изглед је налепљен","render.look_sepia":"Сепија","render.look_strength":"Јачина изгледа","render.look_teal_orange":"Тиркизно / наранџасто","render.look_title":"Низ креативних изгледа","render.look_warm":"Топло","render.mapping_scale":"Множилац физичког понављања","render.material_absorption":"Апсорпција R · G · B (по mm)","render.material_add":"Додај или измени ово тело","render.material_assignments":"Доделе телима","render.material_binding_enable":"Укључи ово надјачавање тела","render.material_box":"Кутија поравната са осама","render.material_browse":"Изабери слику…","render.material_certification":"Затворено стакло користи геометријско растојање. Топологија, оријентација, преклапање и оптичке границе проверавају се током GPU припреме; Провери само прихвата захтев.","render.material_choose_body":"Изаберите тело сцене","render.material_closed":"Затворена чврста мрежа","render.material_coat":"Провидни лак преко основног материјала","render.material_coat_enable":"Омогући провидни лак","render.material_coat_help":"Илустративни диелектрични премаз преко постојећег непрозирног изгледа. Нулта тежина оставља основу непромењеном.","render.material_color_map":"Слика основне боје (sRGB)","render.material_color_replace":"Основна мапа замењује боју тела","render.material_custom":"Прилагођена илустративна оптика","render.material_enable":"Користи ова GPU надјачавања материјала","render.material_filter":"Филтрирај тела сцене…","render.material_filter_help":"Приказује се до 128 одговарајућих тела. За велике сцене сузите филтер.","render.material_glass":"Стакло и оптичка апсорпција","render.material_glass_enable":"Користи физичко стакло на овом телу","render.material_glass_exclusive":"У овом рендереру стакло не може да дели тело са провидним лаком или мапама у току извођења.","render.material_glass_help":"Изворни илустративни рецепти. Узорци приказују пропусност, а не рендеровани преглед. Апсорпција је −ln(линеарна пропусност) / референтно растојање; алфа остаје непромењена.","render.material_gpu_required":"Ова активна надјачавања материјала захтевају GPU праћење путања. Изаберите GPU или онемогућите надјачавања пре Провере или Покретања.","render.material_ior":"Индекс преламања (IOR)","render.material_limits":"Највише 128 надјачавања тела, 32 раздвојена стаклена тела, 64 премаза и 128 веза текстура. Идентичне мапе деле простор за складиштење; стварна ограничења уређаја и укупне меморије и даље важе.","render.material_map_invalid":"Путање мапа морају бити ограничене локалне путање; јачина нормале мора бити коначна и између 0 и 1.","render.material_map_required":"Изаберите слику боје или слику нормала пре употребе мапа.","render.material_maps":"Планарне мапе боје и нормала","render.material_maps_enable":"Омогући мапе за ово непрозирно тело","render.material_maps_help":"PNG/JPEG до 1024×1024; укупно 16 MiB кодирано. U и V су ортогонални вектори понављања у светским mm (највише 128 понављања). Боја је sRGB; подаци нормала користе OpenGL +Y. Датотеке се бележе при Провери/Покретању.","render.material_metallic_map":"Метална мапа (линеарна)","render.material_normal_map":"Слика нормала (OpenGL, +Y)","render.material_normal_strength":"Јачина нормале (0–1)","render.material_origin":"Исходиште мапирања X · Y · Z (mm)","render.material_refresh":"Освежи тела сцене","render.material_refresh_needed":"Сцена се променила. Освежите списак тела пре додавања циља.","render.material_remove":"Уклони ову доделу","render.material_repeat_u":"Једно U понављање X · Y · Z (mm)","render.material_repeat_v":"Једно V понављање X · Y · Z (mm)","render.material_revalidate":"Поново потврди ово тело","render.material_revalidate_needed":"Ова додела припада ранијој ревизији сцене. Пре рендеровања поново потврдите тачан идентитет њеног тела.","render.material_roughness":"Храпавост лака (0,045–1)","render.material_roughness_map":"Мапа храпавости (линеарна)","render.material_shadow":"Пропуштај праве зраке сенке","render.material_target_missing":"Редни број и назив тела више се не подударају. Уклоните ову доделу и поново изричито изаберите жељено тело.","render.material_thickness":"Дебљина танког листа (mm)","render.material_thin":"Танак лист","render.material_title":"GPU сликовни материјали","render.material_transient":"Привремена оптичка надјачавања за ову картицу документа. Не чувају се у дизајну, подешавању рендеровања ни библиотеци материјала.","render.material_v_up":"V текстуре показује нагоре на слици","render.material_weight":"Тежина лака (0–1)","render.method_cpu":"CPU праћење зрака","render.method_gpu":"GPU праћење путања","render.method_limit_raster":"Растер користи фиксни непрозирни преглед студија. За подржане оптичке контроле изаберите изричиту методу праћења зрака.","render.method_raster":"CPU растер","render.navigation_help":"Камера се креће као у Дизајну (Подешавања › Навигација). Сачувај подешавање бележи тренутну камеру.","render.nested_enable":"Потврђени угнежђени диелектрици","render.nested_help":"До 16 обухватних слојева; сваки родитељ мора бити конвексан, а свако дете строго унутар њега. Пресеци, површине које се додирују, танки листови и пропуштање правих сенки се одбијају. Стање камере унутра прати потврђену хијерархију. Не прави површину течности и не спаја CAD границе које се додирују.","render.opaque_image_summary":"Преглед PNG · непрозирни PBR · мешана провидност","render.opaque_preview_help":"Непрозирни PBR и једноставне боје; мешана провидност. Преламање, HDRI и завршно рендеровање још нису доступни.","render.optics_remove":"Уклони сачувану оптику","render.optics_replace":"Изричито замени сачувану оптику овог циља","render.optics_save":"Сачувај ову оптику у подешавање","render.optics_saved":"Сачувани оптички циљеви","render.optics_saved_help":"Тачан идентитет дефиниције, операције и примерка остаје сачуван и при поновном отварању без мреже. Недостајући, замењени или скривени циљеви се одбијају; инжењерски материјали остају непромењени. Сачувајте или одбаците бројчане измене пре уклањања сачуваног циља.","render.outer_half_angle":"Спољни полуугао","render.output_advanced":"Напредно","render.output_backend_ready":"Спремно","render.output_check":"Провери","render.output_check_failed":"Провера · грешка","render.output_check_help":"Покрените проверу да бисте прегледали овај захтев без покретања рендеровања.","render.output_check_summary":"Провера · Напомене: {count}","render.output_copy":"Копирај","render.output_copy_report":"Копирај извештај","render.output_destination":"Одредиште","render.output_destination_help":"Одредишну датотеку изаберите при извозу завршене слике.","render.output_dimensions":"Величина","render.output_effects":"Ефекти","render.output_export":"Извези PNG…","render.output_exr_unavailable":"Подешавање EXR излаза овде није доступно. Линеарни EXR извоз захтева завршену GPU слику са задржаним линеарним мастером.","render.output_fit":"Уклопи","render.output_format":"Формат","render.output_format_status":"PNG је тачна завршена слика за приказ. Необавезни GPU EXR задржава сирову линеарну радијансу сцене у формату FLOAT32 пре филтера приказа. Извоз никад не замењује кеш прегледа ни други посао.","render.output_grading":"Градација","render.output_image":"Слика","render.output_largest":"Највише {width} × {height}","render.output_lock_ratio":"Закључај однос страница","render.output_over_budget":"Тражена слика премашује изабрани оквир ресурса. Изричито изаберите компатибилну величину или профил; нема аутоматског смањења.","render.output_presets_help":"Формат, квалитет и списак провере налазе се у уређивачу Излаз.","render.output_quality":"Квалитет","render.output_quality_waiting":"чека се уговор о квалитету","render.output_ratio_refused":"Повезана димензија премашује ограничење величине ове методе. Претходна величина се задржава; откључајте однос или изаберите мању вредност.","render.output_ready":"Спремно за рендеровање","render.output_run_check":"Покрени проверу","render.output_size_limit":"{method}: до {dimension} px по страни и {pixels} пиксела. Највећа величина која стаје: {width} × {height}.","render.output_size_method_profile":"Да бисте рендеровали {width} × {height}, изаберите {method} са CPU профилом ресурса {profile}, или мању величину.","render.output_size_ok":"Величина је у реду · {width} × {height} px","render.output_size_profile":"Да бисте рендеровали {width} × {height}, изаберите CPU профил ресурса {profile}, или мању величину.","render.output_swap_orientation":"Замени ширину и висину","render.output_tools_inspector":"Величину и формат измените у инспектору Излаз.","render.output_view_image":"Прикажи слику","render.page_aging":"Старење и запрљаност","render.page_all":"Све контроле","render.page_appearance":"Изглед","render.page_background":"Позадине","render.page_camera":"Камера","render.page_diagnostics":"Дијагностика","render.page_effects":"Ефекти објектива и завршне обраде","render.page_environment":"Окружење","render.page_lighting":"Осветљење","render.page_output":"Излаз","render.page_scene":"Сцена","render.paint_label":"Обоји","render.painting_with":"Бојење изгледом {name}","render.passive_stage":"Подлога и пасивна сцена","render.passive_stage_help":"Коначни пасивни панели припадају само рендерованим сликама. Не додају CAD тела ни масу. Постављање је фиксно након примене; пресецање граница производа се одбија. CPU не даје дифузно одбијено осветљење.","render.perspective":"Перспективна камера","render.physical_acknowledge":"Разумем да ова делимична референца захтева проверу разреда, стања и извора","render.physical_associations":"Физички кандидати и улоге","render.physical_background_help":"Стварни пасивни под и зид, одвојени од позадине камере. Циклорама користи 24 полигоналне траке; није бесконачна нити аналитички глатка површина. Замењује сачувану сцену само уз ваш пристанак.","render.physical_copy_plan":"Копирај план са изворима и изоставкама","render.physical_cyclorama":"Уклопи полигоналну циклораму","render.physical_floor_wall":"Уклопи физички под и зид","render.physical_material_name":"Предложени назив референтног материјала","render.physical_omissions":"Својства која се не могу приказати на изворној картици","render.physical_plan_only":"Припремљен је план само за читање. Ниједан материјал није направљен нити додељен. Задржите његов проширени профил и изоставке при прегледу изворне картице.","render.physical_prepare_plan":"Припреми план израде (не примењује се)","render.physical_separate":"Изглед није идентификација материјала. Ово су референце са изворима, а не потврђена ефективна својства. Постојећа маса, инжењерски материјали и оптика остају непромењени.","render.physical_unknown":"Није утврђен ниједан бројчани кандидат. Разред, састав или конструкција морају се навести; непознато није нула.","render.pick_body":"Тело","render.pick_component":"Компонента","render.pick_face":"Лице","render.pick_help":"Изаберите Тело, Лице или Компонента. Кликните празан простор да очистите избор; Shift или Ctrl додаје или укључује/искључује. Истицања се појављују само у живом приказу производа.","render.pick_label":"Изабери","render.pick_up_label":"Преузми","render.pick_up_prompt":"Кликните објекат да преузмете његов изглед","render.pick_waiting":"Избор производа још није подржан.","render.post_contrast":"Контраст","render.post_gain_b":"Појачање плаве","render.post_gain_g":"Појачање зелене","render.post_gain_r":"Појачање црвене","render.post_help":"Само за креативни приказ. RGB појачања долазе пре мапирања тонова; контраст, засићеност и вињета следе у линеарној светлости приказа. Покрени рендеровање прави нове узорке транспорта. Поновна градација користи изабрани задржани сирови мастер без уклањања шума и без нових зрака.","render.post_reset":"Ресетуј филтере приказа","render.post_saturation":"Засићеност","render.post_title":"Филтери приказа","render.post_vignette":"Вињета","render.preview":"Интегрисани преглед","render.preview_help":"Растер сенчење и мешана провидност. Преламање, HDRI и завршно рендеровање још нису доступни.","render.preview_image_settings_help":"Преглед уживо задржава фиксно осветљење студија. Експозиција и осветљење слике примењују се на посао слике када кликнете Провери или Покрени.","render.preview_lighting_help":"Преглед уживо приказује само директно светло, без сенки.","render.preview_retry":"Поново покушај преглед уживо","render.preview_unavailable_help":"Преглед уживо није доступан. Сачувана подешавања и контроле посла слике остају доступни. Промените сцену или изричито покушајте поново; одбијена сцена се не гради поново у сваком кадру.","render.preview_upload":"Подаци врхова прегледа уживо","render.preview_upload_help":"Тачан број бајтова врхова прегледа, а не укупна меморија GPU-а или процеса. Геометрија се не поједностављује. Послови слике користе сопствени пријем и осветљење.","render.progressive_image_summary":"Преглед PNG · PBR и стакло · прогресивни узорци","render.property_conditions":"Услови: {value}","render.property_fallback":"својство","render.property_qualifier":"Квалификатор: {value}","render.property_source":"Извор: {id} - {locator}","render.property_uncertainty":"Неизвесност: {value}","render.property_unknown":"непознато","render.quality_ack":"Потврди пројекцију са фиксним буџетом и изоставке","render.quality_apply":"Користи овај фиксни буџет узорковања","render.quality_balanced":"Уравнотежено","render.quality_custom":"Прилагођено","render.quality_draft":"Нацрт","render.quality_high":"Високо","render.quality_projection_help":"Q подешавања укључују будуће захтеве. Ова радња пројектује само подржани PNG буџет са фиксним бројем узорака и изричито изоставља адаптивно заустављање, сирови линеарни излаз и независна ограничења пропуштања.","render.quality_review":"Прегледај буџет узорковања","render.queue_pending":"У овом интерфејсу нема аутоматског продукцијског реда ни рендерера анимација. Завршене статичне слике и даље се могу засебно извести.","render.radial_assign":"Додели изглед","render.radial_compare":"Упореди","render.radial_distortion":"Радијално изобличење","render.radial_fit":"Уклопи производ","render.radial_save":"Сачувај кадар","render.recent_looks":"Недавни изгледи","render.regrade_action":"Поновна градација сировог мастера (без уклањања шума)","render.regrade_help":"Прави засебан PNG из изабраног завршеног сировог мастера, користећи ове контроле приказа. Не прати зраке, не мења забележену величину, камеру ни светла и не преписује EXR. Уклањање шума се не примењује поново: сирови мастери не чувају његове водиље. Изведена слика се и даље може извести истим контролама посла.","render.regrade_label":"Поновна градација","render.reload_settings":"Поново учитај сачувана подешавања","render.remove_override":"Уклони надјачавање","render.replace_all":"Замени све","render.replace_ground":"Потврди замену постојеће сцене","render.replace_label":"Замени","render.replace_saved_surface":"Замени постојећу сачувану везу за овај циљ","render.replace_with":"Замени са","render.restore_camera":"Врати сачувану камеру","render.result_actual":"100%","render.result_actual_help":"Један пиксел слике по пикселу екрана.","render.result_actual_size":"100%","render.result_capture":"Забележена ревизија","render.result_current":"Забележена ревизија модела је актуелна.","render.result_empty":"Још нема завршене слике. Проверите подешавања, а затим покрените рендеровање.","render.result_fit":"Уклопи слику","render.result_job":"Посао","render.result_navigation":"Померање и зумирање користе подешавања Навигације. Размакница + превлачење помера приказ.","render.result_open":"Отвори завршену слику на главном платну.","render.result_preview":"Преглед уживо","render.result_provisional":"Привремена CPU слика","render.result_provisional_help":"Ова контролна тачка се не може извести. Извоз задржава последњи завршени резултат; отказивање враћа на тај резултат.","render.result_reduced_display":"Преглед приказа смањен је на ограничење уређаја/кеша прозора приказа. Задржани PNG и извоз задржавају пуну резолуцију; изворни преглед од 100% није доступан за овај смањени приказ.","render.result_retained":"Приказује се последња завршена слика; новије рендеровање је још није заменило.","render.result_sequence":"Контролна тачка","render.result_title":"Резултат рендеровања","render.return_design":"Назад на Дизајн","render.review_stale":"Овај преглед је застарео. Решите га или поново проверите пре примене.","render.ribbon_aging":"Старење","render.ribbon_backgrounds":"Позадине","render.ribbon_check":"Провери","render.ribbon_check_help":"Потврди тачан тренутни нацрт који ће Рендеровање послати. Без заменског рендерера, тихе промене величине или замене ресурса.","render.ribbon_edit_lights":"Измени светла","render.ribbon_effects":"Ефекти","render.ribbon_environment_help":"HDR осветљење, позадине само за камеру и површине физичке сцене су одвојене контроле са изричитим пристанком на замену.","render.ribbon_finish_dialog":"Прво завршите тренутни дијалог за датотеку или потврду.","render.ribbon_frame":"Уоквири","render.ribbon_hdr_library":"HDR библиотека","render.ribbon_job_active":"Рендеровање већ траје; изричито га откажите пре покретања новог.","render.ribbon_light_rigs":"Поставе светала","render.ribbon_lights_help":"Прегледајте ауторске поставе или измените подржана светла без замене тренутног подешавања док изричито не примените промену.","render.ribbon_materials":"Материјали","render.ribbon_materials_help":"Отворите заједнички прегледач изгледа и изворну библиотеку површина. Оптичке измене никад тихо не мењају инжењерска својства.","render.ribbon_no_active_job":"Нема активног рендеровања за отказивање.","render.ribbon_no_result":"Завршите рендеровање пре извоза његове тачне слике.","render.ribbon_no_saved_camera":"Сачувајте кадар пре враћања његове камере.","render.ribbon_saved_camera":"Сачувана камера","render.ribbon_shots":"Кадрови","render.ribbon_studios":"Студији","render.ribbon_studios_help":"Прегледајте имплементиране композиције студија и њихове замене пре примене. Сцене које су само концепти остају означене.","render.ribbon_surface_maps":"Мапе површине","render.sampling_title":"Адаптивно узорковање и узорковање пропуштања","render.save_continue":"Сачувај и настави","render.save_setup":"Сачувај подешавање","render.save_shot":"Сачувај кадар","render.saved_maps_runtime_conflict":"Сачуване везе површина не могу се мешати са привременим оптичким надјачавањима ни несачуваним HDR-ом. Сачувајте HDR или изричито уклоните привремене улазе.","render.saved_surface_remove":"Уклони сачувану везу","render.saved_surfaces":"Сачуване везе површина","render.saved_surfaces_help":"Фиксиране уграђене мапе прате изабрани примерак у локалним милиметрима. Замењен или недостајући циљ је грешка, никад аутоматска поновна додела.","render.scene_all_shots":"Сви кадрови ({count})","render.scene_apply":"Примени прегледани студио","render.scene_batch_reason":"За Све кадрове потребан је ред чекања за рендеровање сачуваних кадрова, који још није доступан.","render.scene_check_now":"Провери сада","render.scene_check_passed":"Провера је прошла · напомене: {notes}","render.scene_check_stale":"Провера је застарела · проверите поново","render.scene_check_unchecked":"Још није проверено · напомене: 0","render.scene_consent":"Потврди замену осветљења, окружења, експозиције и сцене","render.scene_light_summary":"{environment} · светла: {lights}","render.scene_look_summary":"изгледи: {looks} · надјачавања: {overrides}","render.scene_open_check":"Отвори проверу","render.scene_preserved_fields":"Камера, узорковање, димензије, оптичке везе, CAD геометрија и инжењерски материјали се чувају.","render.scene_preserves_design":"Саставите осветљење и пасивну сцену за видљиви предмет. Геометрија, инжењерски материјали и камера остају одвојени.","render.scene_ready":"Спремно за рендеровање","render.scene_reminder":"Сцена чува дизајн. Геометрија, инжењерска својства и CAD никад се не мењају из Рендеровања.","render.scene_reminders":"Подсетници","render.scene_renderer_ready":"Спремно: {renderer}","render.scene_replaces":"Замењује","render.scene_review":"Разреши и прегледај","render.scene_review_help":"Прегледајте комплетну изворну композицију пре примене. Невезане напредне SCENE спецификације се не замењују.","render.scene_scope_details":"Опсег композиције","render.scene_stages":"Фазе","render.search_appearances":"Претражи {count} изгледа","render.setup_legacy_environment":"Ово старије подешавање користи наслеђену ротацију или интензитет окружења. Те вредности се задржавају; изричито их претворите пре чувања пуног посла слике.","render.setup_name":"Назив подешавања","render.setup_numeric_help":"Сачувај бележи активну методу слике и сва њена бројчана подешавања. Поновно учитавање или избор другог подешавања замењује овај нацрт; камеру вратите засебно.","render.setup_offline_help":"Ову методу можете мењати и сачувати без њеног рендерера. Провери и Покрени захтевају доступан хост.","render.setup_runtime_unsupported":"Овај пуни посао још се не може сачувати: садржи мапе или везе са телима сцене. Уклоните те привремене улазе пре чувања преносивог подешавања.","render.setup_save_missing":"Сачувана конфигурација рендеровања није пронађена након извршења команде.","render.sharpening":"Изоштравање детаља","render.shell_tab_appearance":"ИЗГЛЕД РЕНДЕРА","render.shell_tab_camera":"КАМЕРА РЕНДЕРА","render.shell_tab_lighting":"ОСВЕТЉЕЊЕ","render.shell_tab_scene":"СЦЕНА РЕНДЕРА","render.shot_aperture":"Отвор бленде","render.shot_distance":"Растојање","render.shot_dof":"Дубинска оштрина","render.shot_duplicate":"Дуплицирај сачувани кадар","render.shot_edit_output":"Измени у Излазу","render.shot_exposure_reason":"Експозиција захтева CPU праћење зрака или GPU праћење путања.","render.shot_exposure_section":"Експозиција","render.shot_focus_distance":"Растојање фокуса","render.shot_fov_reason":"Видно поље захтева перспективну пројекцију.","render.shot_frame_subject":"Уоквири предмет","render.shot_invalid_camera":"Вредности камере морају бити коначне и у дозвољеном опсегу.","render.shot_lens":"Објектив","render.shot_lens_enable_reason":"Омогућите дубинску оштрину да бисте мењали отвор бленде и растојање фокуса.","render.shot_lens_gpu_reason":"Дубинска оштрина захтева GPU праћење путања.","render.shot_lens_perspective_reason":"Дубинска оштрина захтева перспективну пројекцију.","render.shot_look_selection":"Усмери на избор","render.shot_manager":"Сачувани кадрови","render.shot_new_name":"Назив новог кадра","render.shot_remove":"Уклони сачувани кадар","render.shot_remove_help":"Уклони само ово сачувано подешавање. Изворна геометрија и завршене слике остају сачуване; радња се може поништити.","render.shot_remove_title":"Уклонити сачувани кадар?","render.shot_rename":"Преименуј сачувани кадар","render.shot_saved_only":"Прво сачувајте тренутни нацрт. Дуплицирање и преименовање чувају тачне сачуване опције и референце на ресурсе.","render.shot_selection_reason":"Изаберите тело или лице на које ћете усмерити камеру.","render.shot_size":"Величина","render.shot_target":"Циљ","render.shots_camera_changed":"Камера је промењена откако је овај кадар сачуван","render.shots_name_help":"Унесите јединствен назив за тренутни кадар.","render.shots_no_result":"Још нема рендера","render.shots_result":"Рендер {number} · {width} × {height}","render.shots_revert":"Врати","render.shots_save":"Сачувај кадар","render.shots_update":"Ажурирај кадар","render.show_shots_label":"Прикажи траку кадрова","render.size_4k":"4K","render.size_4k_uhd":"4K UHD","render.size_custom":"Прилагођено…","render.size_full_hd":"Full HD","render.size_hd":"HD","render.size_needs_profile":"{size} · захтева {profile}","render.size_presets":"Унапред подешене величине","render.size_presets_pending":"Стиже са уређивачем излаза","render.size_preview":"Преглед","render.size_square":"Квадратно","render.sky_ground":"Тло · линеарни RGB","render.sky_horizon":"Хоризонт · линеарни RGB","render.sky_zenith":"Зенит · линеарни RGB","render.soft_focus":"Меки фокус","render.spot_cone":"Конус рефлектора","render.stage_frame":"Кадар","render.stage_layout.appearance_note":"Кликните да примените на избор.","render.stage_layout.studio_note":"Кликните да прегледате пре примене.","render.stage_light":"Светло","render.stage_look":"Изглед","render.stage_orthographic":"Ортографски","render.stage_output":"Излаз","render.stage_panel_count":"Сачувани панели","render.stage_panels.acknowledge":"Потврђујем замену и ограничења","render.stage_panels.appearance_note":"Кликните да примените на избор. Превуците на модел. Када ништа није изабрано, клик активира Обоји.","render.stage_panels.apply":"Примени","render.stage_panels.apply_studio":"Примени студио","render.stage_panels.badge_blocked":"блокирано","render.stage_panels.badge_native":"изворно","render.stage_panels.badge_projection":"пројекција","render.stage_panels.badge_reference":"референца","render.stage_panels.badge_specification":"само спецификација","render.stage_panels.candidate_summary":"Кандидати: {count} вре