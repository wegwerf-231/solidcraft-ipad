":"Góc nhìn phía trước","cmd.view_graphics_preset":"Cấu hình đồ họa định sẵn","cmd.view_grid":"Lưới tọa độ","cmd.view_ground_shadow":"Bóng đổ mặt sàn","cmd.view_home":"Góc nhìn mặc định (Home)","cmd.view_isometric":"Góc nhìn trục đo","cmd.view_left":"Góc nhìn bên trái","cmd.view_list":"Danh sách góc nhìn đã lưu","cmd.view_navigate":"Điều hướng góc nhìn","cmd.view_navigation_bar":"Thanh điều hướng","cmd.view_next_tab":"Thẻ tiếp theo","cmd.view_normal_to":"Góc nhìn vuông góc với vùng chọn","cmd.view_previous_tab":"Thẻ trước","cmd.view_rename":"Đổi tên góc nhìn đã lưu","cmd.view_render_frame":"Đường dẫn khung kết xuất","cmd.view_right":"Góc nhìn bên phải","cmd.view_save":"Tạo góc nhìn đã lưu mới","cmd.view_shots_strip":"Dải cảnh chụp","cmd.view_spin":"Xoay quỹ đạo liên tục","cmd.view_tool":"Công cụ điều hướng","cmd.view_top":"Góc nhìn từ trên","cmd.view_visual_style":"Kiểu hiển thị trực quan","color.copy":"Nhấp để sao chép giá trị màu","color.edit":"Nhấp để sửa màu","color.gamma":"Đang hiển thị giá trị màu trong không gian gamma 0-255","color.hex":"Hex","color.hex_help":"Enter #rrggbb or #rrggbbaa; six digits preserve opacity","color.hex_hint":"#rrggbb","color.hue":"Sắc độ","color.linear":"Đang hiển thị giá trị màu trong không gian tuyến tính 0-1","color.recent":"Màu gần đây","color.recent_help":"Các màu bạn chọn ở bất kỳ ô màu nào sẽ hiện ở đây","color.saturation":"Độ bão hòa (phần trăm)","color.saturation_value":"Độ bão hòa và giá trị","color.selected":"Màu đã chọn","color.step_down":"Giảm một bước","color.step_up":"Tăng một bước","color.value":"Giá trị, độ sáng (phần trăm)","config.column_filter_empty":"Không có cột phù hợp","contact.components_count":"{count} chi tiết","contact.enabled_label":"đã bật","coupling.gear_1":"Bánh răng 1","coupling.gear_1_pick":"Bánh răng 1 (tùy chọn)","coupling.gear_2":"Bánh răng 2","coupling.gear_2_pick":"Bánh răng 2 (tùy chọn)","coupling.internal":"Bánh răng trong","coupling.needs_turn_and_slide":"cần một khớp quay và một khớp trượt","coupling.needs_turns":"cần hai khớp quay","coupling.not_round":"không phải là bề mặt tròn","coupling.nut":"Đai ốc","coupling.picked":"đã chọn","coupling.pinion":"Bánh răng nhỏ (Pinion)","coupling.pinion_pick":"Bánh răng nhỏ (tùy chọn)","coupling.pitch":"Bước răng","coupling.rack":"Thanh răng","coupling.radius_1":"Bán kính 1","coupling.radius_2":"Bán kính 2","crash.announce":"Lần trước SolidCraft đã đóng đột ngột hoặc gặp lỗi nội bộ. Báo cáo sự cố đã được lưu (Trợ giúp > Báo cáo sự cố…).","crash.copy_folder":"Sao chép đường dẫn thư mục","crash.copy_path":"Sao chép đường dẫn","crash.deleted":"Đã xóa {count} báo cáo.","crash.detected_time":"Phát hiện lúc {time} UTC","crash.intro":"Báo cáo sự cố được giữ trên máy tính này và không bao giờ được gửi đi đâu. Báo cáo… sẽ mở một bản nháp để bạn xem lại trước khi chia sẻ bất cứ điều gì.","crash.kind_command":"Lỗi nội bộ trong một lệnh","crash.kind_internal":"Lỗi nội bộ","crash.kind_kernel":"Lỗi nhân (đã khôi phục)","crash.kind_unclean":"Đóng đột ngột","crash.previous_session":"Một phiên SolidCraft trước đó đã kết thúc đột ngột hoặc gặp lỗi nội bộ. Các báo cáo từ lần thoát bất thường được phát hiện khi khởi động. Xem Trợ giúp > Báo cáo sự cố… để biết chi tiết.","crash.replayable":"có thể phát lại","crash.report":"Báo cáo…","crash.unclean_explanation":"Được phát hiện ở lần khởi chạy sau; thời điểm thoát chính xác không được ghi lại. Việc tắt máy hoặc buộc dừng cũng có thể gây ra thoát bất thường.","delete.and_more":"… và {count} mục khác","diagnostic.empty_boolean_component":"không có thân khối nào để cắt hoặc giao trong cụm chi tiết '{component}'; công cụ có thể giao nhau với '{body}' trong cụm chi tiết '{other}' — hãy kích hoạt cụm chi tiết đó hoặc chọn thân khối làm đối tượng đích","dialog.bodies_count":"{count} thân khối","dialog.clearance_invalid":"khoảng cách an toàn phải có chiều dài từ 0 trở lên","dialog.compute":"Tính toán","dialog.compute_again":"Tính toán lại","dialog.computing":"Đang tính toán… {seconds} s","dialog.could_not_be_checked":"không thể kiểm tra","dialog.custom_axis":"↖ Trục tùy chỉnh","dialog.dimension_insert_hint":"Nhấp vào một kích thước điều khiển khác để chèn tên của nó","dialog.dimension_name":"Kích thước: {name}","dialog.edit_title":"CHỈNH SỬA {title}","dialog.no_shown_body":"Không có thân khối đang hiển thị để thay đổi: hãy hiển thị một thân khối, hoặc chọn “Tạo mới Thân khối”","dialog.pattern_sketch_not_object":"Hãy chọn thân khối hoặc tính năng: bản phác thảo không phải là cả hai. Lặp lại các đường cong của nó bằng Mảng hoặc Lấy đối xứng trong chính bản phác thảo, hoặc đùn khối nó trước.","dialog.select":"↖ Chọn","dialog.selected_count":"↖ {count} đã chọn","dialog.selection_guidance":"Chọn một mục đầu vào để thay đổi. Nhấp vào đối tượng đã chọn để bỏ chọn; Ctrl/Cmd-nhấp để bật/tắt chọn. Xem trước kết quả, sau đó nhấn OK.","dialog.selection_step":"{step} / {total}: Chọn {input}","dialog.step":"Bước","document.changed_on_disk":"{name} đã thay đổi trên đĩa","document.changed_on_disk_detail":"{name} đã bị thay đổi bởi chương trình hoặc máy tính khác kể từ khi bạn mở hoặc lưu lần cuối. Ghi đè sẽ thay thế các thay đổi đó bằng thay đổi của bạn; Lưu bản sao sẽ giữ lại cả hai.","document.copy_name":"Bản sao {name}","document.open_anyway":"Vẫn mở","document.open_elsewhere":"{name} hiện đang được mở","document.open_elsewhere_detail":"{name} đang được mở trong SolidCraft {app} trên {who}, mở lúc {when}. Nếu cả hai cùng lưu, một người sẽ mất phần công việc. Mở ở chế độ chỉ đọc để xem mà không ghi đè lên tệp.","document.open_read_only":"Mở chỉ đọc","document.opened_read_only":"Đã mở chỉ đọc: Lưu sẽ yêu cầu tệp mới","document.overwrite":"Ghi đè","document.read_only_save":"Thiết kế này được mở ở chế độ chỉ đọc: hãy lưu thành tệp mới","document.save_changes":"Lưu các thay đổi đối với {name}?","document.save_copy":"Lưu bản sao…","document.unsaved_changes":"{name} có các thay đổi chưa lưu. Nếu không lưu, các thay đổi sẽ bị mất.","drive.rigid":"{joint} là khớp nối cứng: nó giữ cố định các chi tiết, nên không có gì để dẫn động. Để các chi tiết chuyển động, hãy đổi loại khớp nối trong “Chỉnh sửa khớp nối”: Revolute để xoay, Slider để trượt, Cylindrical cho cả hai.","drive.stopped_by_contact":"Đã dừng tại {value}: {a} sẽ xuyên qua {b}","drive.stopped_by_loop":"Đã dừng tại {value}: vòng lặp qua {joint} không thể khép kín thêm được nữa","drive.unconnected":"Không di chuyển gì: {part} không được nối với bất kỳ chi tiết cố định nào","dxf.cancel_wait":"Đang đợi quá trình xuất dừng…","dxf.cancelled":"Đã hủy xuất tệp DXF","dxf.cancelling":"Đang hủy xuất tệp DXF","dxf.exporting":"Đang xuất tệp DXF","dxf.invalid_tolerance":"Dung sai đường cong phải nằm trong khoảng từ 0.0001 đến 1 mm.","dxf.progress.index":"Đang chuẩn bị bề mặt (2/5)","dxf.progress.meshes":"Đang chuẩn bị lưới đa giác (1/5)","dxf.progress.occlusion":"Đang xử lý nét khuất (4/5)","dxf.progress.projection":"Đang chiếu hình học (3/5)","dxf.progress.write":"Đang ghi tệp DXF (5/5)","dxf.tolerance":"Dung sai đường cong","dxf.tolerance_help":"Chỉ áp dụng cho các thân khối và phác thảo hiển thị. Đường cong sử dụng các đoạn thẳng. Dung sai nhỏ hơn cho đường cong mịn hơn nhưng tốn nhiều thời gian và bộ nhớ hơn.","each rail's curves must be in one sketch":"các đường cong của mỗi đường dẫn hướng phải nằm trong cùng một phác thảo","feature computation ended without a result":"việc tính toán đặc trưng kết thúc mà không có kết quả","file.open.drawing_filter":"Thiết kế, tệp CAD, lưới đa giác và bản vẽ","file_load.built":"Đã dựng được: {built} trên {total} tính năng.","file_load.converting":"Đang chuyển đổi khối đặc {done} trên {total}","file_load.inserting":"Đang chèn hình học","file_load.link_item":"{name} ({done} trên {total})","file_load.opening":"Đang mở thiết kế","file_load.preparing_thumbnail":"Đang chuẩn bị ảnh thu nhỏ...","file_load.preparing_view":"Đang chuẩn bị góc nhìn...","file_load.preview_note":"Bản xem trước đã lưu. Hình học đang được kiểm tra trước khi chỉnh sửa.","file_load.reading":"Đang đọc tệp...","file_load.reading_percent":"Đang đọc tệp... {percent}%","file_load.rebuilding":"Đang dựng lại tính năng {done} trên {total}","file_load.recovering":"Đang khôi phục thiết kế","file_load.stopping":"Đang chờ thao tác trước đó dừng lại...","file_load.updating_links":"Đang cập nhật liên kết","file_load.waiting":"Đang chờ thao tác tệp","fits the face, e.g. M8":"vừa khít bề mặt, ví dụ M8","from the profile":"từ biên dạng","from the rule":"từ quy tắc","help.apache":"Giấy phép Apache 2.0","help.appearance.assign":"Gán màu hoặc vẻ ngoài vật liệu cho các khối, mặt hoặc thành phần đã chọn mà không thay đổi khối lượng. Dùng để phân biệt các chi tiết hoặc xem trước lớp hoàn thiện.","help.assembly.bom":"Liệt kê các chi tiết của thiết kế hoặc cụm chi tiết kèm số lượng theo mã chi tiết, và có thể lưu danh sách dạng CSV hoặc JSON. Dùng làm bảng kê vật tư để đặt hàng và lắp ráp.","help.attributions":"Ghi công (ATTRIBUTION.md)","help.build":"Phiên bản {version} · commit {commit} · dựng ngày {date}","help.canvas.decal":"Đặt hình ảnh lên một mặt phẳng của mô hình như một đề can. Dùng để thể hiện nhãn, logo hoặc hoa văn in trên chi tiết.","help.canvas.edit":"Thay đổi hình ảnh Canvas: vị trí, kích thước, góc, độ mờ đục, phản chiếu, hiển thị hoặc tên. Dùng để căn hình ảnh tham chiếu với bản phác thảo mà bạn vẽ đè lên ảnh.","help.canvas.insert":"Đặt hình ảnh PNG hoặc JPEG lên mặt phẳng hoặc bề mặt làm tham chiếu bán trong suốt. Dùng để đồ lại ảnh chụp hoặc bản vẽ trong phác thảo, với ảnh được chỉnh về kích thước đã biết.","help.component.break_link":"Ngắt liên kết cụm chi tiết với tệp thiết kế của nó, giữ nguyên các thân khối. Dùng khi chi tiết không còn cần cập nhật theo thay đổi trong tệp gốc.","help.component.capture_position":"Lưu vị trí các chi tiết đã di chuyển bằng tay làm vị trí chính thức của chúng. Dùng sau khi kéo các chi tiết vào vị trí mà không có khớp nối nào giữ chúng.","help.component.create":"Thêm một cụm chi tiết mới, rỗng vào thiết kế, bên trong cụm đang hoạt động trừ khi bạn chọn cụm cha khác. Dùng để dành không gian riêng cho các thân khối và phác thảo của một chi tiết mới trong cụm lắp ráp.","help.component.finish_edit":"Lưu chi tiết đang được chỉnh sửa tại chỗ, quay lại cụm lắp ráp của nó và cập nhật cụm lắp ráp từ chi tiết đó. Dùng khi bạn đã hoàn tất các thay đổi cho chi tiết liên kết.","help.component.from_bodies":"Biến mỗi thân khối được chọn thành một cụm chi tiết riêng, lấy tên theo thân khối. Dùng khi cần chuyển thiết kế gồm các thân khối rời thành cụm lắp ráp có các chi tiết nối và di chuyển được.","help.component.insert_design":"Chèn một thiết kế đã lưu khác thành cụm chi tiết liên kết với tệp của nó, giữ vị trí các thân khối đặc như trong tệp đó. Dùng để tái sử dụng chi tiết trong cụm lắp ráp và nhận các thay đổi sau này bằng Cập nhật liên kết.","help.component.properties":"Hiển thị thể tích, khối lượng, trọng tâm và mô men quán tính của một cụm chi tiết, dựa trên vật liệu của các thân khối trong đó. Dùng để kiểm tra khối lượng và độ cân bằng của cụm lắp ráp.","help.component.revert_position":"Đưa các chi tiết đã di chuyển bằng tay về vị trí cũ, bỏ những lần di chuyển chưa lưu vị trí. Dùng để hoàn tác các lần di chuyển thử trong cụm lắp ráp.","help.component.update_links":"Đọc lại các tệp thiết kế được liên kết và thay thế những thân khối đã thay đổi. Dùng sau khi chỉnh sửa một chi tiết mà cụm lắp ráp này sử dụng.","help.config.configure":"Thêm tham số, tính năng, vật liệu hoặc ngoại quan làm cột của bảng cấu hình. Dùng để tạo các biến thể của một thiết kế, chẳng hạn các kích cỡ của một chi tiết.","help.config.preview":"Kiểm tra xem một hàng của bảng cấu hình có dựng lại được không, mà không thay đổi thiết kế hay lịch sử của nó. Dùng trước khi chuyển sang một biến thể bạn chưa chắc chắn.","help.config.rules":"Hiển thị các quy tắc của bảng cấu hình, các hàng và hàng đang kích hoạt. Dùng để xem các biến thể của thiết kế được thiết lập thế nào.","help.config.table":"Hiển thị bảng cấu hình: mỗi biến thể một hàng, mỗi tham số hoặc tính năng một cột, và cho biết thiết kế còn khớp với hàng đang kích hoạt hay không. Dùng để rà soát các biến thể của thiết kế.","help.connect_note":"Khởi động lại từng trợ lý ảo để nạp SolidCraft server. Mỗi tập tin cấu hình đều đã được sao lưu thành .bak trước khi thay đổi.","help.connect_title":"Kết nối trợ lý ảo AI","help.construct.axis.edge":"Tạo trục dựng hình dọc theo một cạnh thẳng hoặc đường phác thảo. Dùng làm trục cho Xoay tròn tạo khối, mảng tròn hoặc khớp nối.","help.construct.axis.normal_to_face":"Tạo trục dựng hình đi qua một điểm và vuông góc với một mặt. Dùng làm trục nhô thẳng ra khỏi bề mặt.","help.construct.axis.through_cylinder":"Tạo trục dựng hình đi qua tâm của mặt hình trụ, nón hoặc xuyến, hoặc của một cạnh tròn. Dùng để xoay hoặc tạo mảng các tính năng quanh một chi tiết tròn.","help.construct.axis.two_planes":"Tạo trục dựng hình tại nơi hai mặt phẳng giao nhau. Dùng khi trục cần có chính là đường giao giữa hai mặt.","help.construct.axis.two_points":"Tạo trục dựng hình đi qua hai điểm, đỉnh hoặc điểm phác thảo. Dùng cho trục chạy giữa hai vị trí đã biết.","help.construct.plane.along_path":"Tạo mặt phẳng dựng hình vuông góc với một cạnh hoặc đường cong, tại một vị trí dọc theo nó. Dùng để phác thảo biên dạng cho Quét theo đường dẫn hoặc mặt cắt của đường dẫn.","help.construct.plane.at_angle":"Tạo mặt phẳng dựng hình xoay một góc so với mặt phẳng hoặc mặt, quanh một trục hoặc cạnh. Dùng cho phác thảo nghiêng, chẳng hạn giá đỡ vát góc.","help.construct.plane.midplane":"Tạo mặt phẳng dựng hình nằm giữa hai mặt phẳng, hoặc phân giác của chúng nơi chúng giao nhau theo một góc. Dùng làm mặt phẳng đối xứng khi Lấy đối xứng.","help.construct.plane.offset":"Tạo mặt phẳng dựng hình song song với một mặt phẳng, cách một khoảng hoặc đi qua một điểm. Dùng để phác thảo ở độ cao xác định phía trên một mặt.","help.construct.plane.perpendicular":"Tạo mặt phẳng dựng hình chứa một đường hoặc cạnh và vuông góc với một mặt phẳng hoặc mặt. Dùng để phác thảo thẳng đứng trên mô hình dọc theo một cạnh.","help.construct.plane.tangent":"Tạo mặt phẳng dựng hình tiếp xúc với hình trụ, nón, cầu hoặc xuyến tại một điểm. Dùng để phác thảo trên mặt bên của một chi tiết tròn.","help.construct.plane.three_points":"Tạo mặt phẳng dựng hình đi qua ba điểm. Dùng cho mặt phẳng xác định bởi các vị trí trên mô hình, chẳng hạn ba góc.","help.construct.plane.two_edges":"Tạo mặt phẳng dựng hình đi qua hai cạnh thẳng hoặc hai đường nằm trong cùng một mặt phẳng. Dùng cho mặt phẳng cắt ngang chi tiết, chẳng hạn qua hai cạnh đối diện.","help.construct.point.along_path":"Tạo điểm dựng hình tại một vị trí dọc theo cạnh hoặc đường cong. Dùng làm điểm tham chiếu ở giữa đường dẫn.","help.construct.point.center":"Tạo điểm dựng hình tại tâm của cạnh tròn, đường tròn hoặc cung phác thảo, hình cầu hoặc hình xuyến. Dùng làm điểm tham chiếu cho lỗ, trục và khớp nối.","help.construct.point.edge_plane":"Tạo điểm dựng hình tại nơi một cạnh hoặc đường xuyên qua một mặt phẳng. Dùng để đánh dấu chỗ đường dẫn cắt qua mặt phẳng.","help.construct.point.three_planes":"Tạo điểm dựng hình tại nơi ba mặt phẳng giao nhau. Dùng làm điểm tham chiếu cho góc, kể cả khi mô hình không có đỉnh ở đó.","help.construct.point.two_edges":"Tạo điểm dựng hình tại nơi hai cạnh hoặc hai đường gặp nhau, hoặc gần nhau nhất. Dùng làm điểm tham chiếu tại một góc ảo.","help.construct.point.vertex":"Tạo điểm dựng hình trên một đỉnh hoặc điểm phác thảo. Dùng làm điểm tham chiếu vẫn còn khi phác thảo hay thân khối xung quanh bị ẩn.","help.contact.check":"Liệt kê các cặp chi tiết trong tập hợp tiếp xúc đang xuyên qua nhau ở vị trí hiện tại. Dùng để tìm va chạm trước khi dẫn động khớp nối hoặc chạy nghiên cứu chuyển động.","help.contact.create":"Gom hai hay nhiều chi tiết thành tập hợp tiếp xúc, ngăn các thân khối xuyên qua nhau khi khớp nối chuyển động. Dùng cho các chi tiết cần dừng khi chạm nhau, như đòn bẩy chạm cữ chặn.","help.contact.disable_all":"Tắt tiếp xúc để khớp nối được dẫn động và nghiên cứu chuyển động không còn dừng khi các chi tiết chạm nhau. Dùng để di chuyển chi tiết tự do trở lại hoặc giữ cho cụm lắp ráp lớn phản hồi nhanh.","help.contact.edit":"Thay đổi tập hợp tiếp xúc: các chi tiết, tên hoặc trạng thái tạm nén, đồng thời có thể xóa tập hợp. Dùng để điều chỉnh những chi tiết không được xuyên qua nhau.","help.contact.enable_all":"Đưa mọi chi tiết của cụm lắp ráp vào một tập hợp tiếp xúc để không có hai chi tiết nào xuyên qua nhau khi khớp nối chuyển động. Dùng để kiểm tra nhanh toàn bộ cơ cấu.","help.contact.enable_sets":"Bật tiếp xúc cho các tập hợp tiếp xúc đã định nghĩa để khớp nối được dẫn động và nghiên cứu chuyển động dừng tại nơi các chi tiết sắp xuyên qua nhau. Dùng để bật lại các tập hợp sau khi tắt tiếp xúc.","help.contact.list":"Liệt kê các tập hợp tiếp xúc của thiết kế, các chi tiết trong mỗi tập hợp và trạng thái bật tiếp xúc. Dùng để kiểm tra thiết lập tiếp xúc trước khi dẫn động cụm lắp ráp.","help.document.inspect":"Hiển thị tổng quan về thiết kế: các cụm chi tiết, thân khối, phác thảo, tính năng và tham số. Dùng để nắm nhanh một thiết kế do người khác tạo.","help.document.units":"Thay đổi đơn vị hiển thị chiều dài của thiết kế, chẳng hạn mm hoặc inch. Hình học giữ nguyên kích thước; chỉ phần hiển thị và các số thuần túy thay đổi theo.","help.edit.checkpoint":"Ghi nhớ thiết kế, phác thảo đang hoạt động và lịch sử hoàn tác ở trạng thái hiện tại. Dùng trước khi thử điều gì rủi ro mà bạn có thể muốn quay lại.","help.edit.restore_checkpoint":"Quay về một điểm kiểm tra, kể cả lịch sử hoàn tác. Dùng để bỏ mọi thao tác đã làm kể từ điểm kiểm tra chỉ trong một bước.","help.explode.create":"Tạo chế độ xem phân rã, đẩy các chi tiết ra xa tâm cụm lắp ráp hoặc theo các dịch chuyển bạn thiết lập. Dùng để thể hiện cách lắp các chi tiết trong hướng dẫn hoặc bài trình bày.","help.face.delete":"Xóa các mặt đã chọn và để các mặt lân cận khép kín chỗ trống, hoặc giữ lỗ hở dưới dạng bề mặt. Dùng để bỏ một cạnh bo tròn, một lỗ hoặc một phần lồi đang vướng.","help.file.insert_mesh":"Thêm tệp 3MF, STL, OBJ, PLY hoặc glTF vào thiết kế dưới dạng các thân khối lưới trong cụm chi tiết mới. Dùng để đặt mô hình tải về hoặc quét bên cạnh thiết kế làm tham chiếu.","help.file.insert_step":"Thêm tệp STEP, IGES, FreeCAD hoặc Rhino vào thiết kế dưới dạng các thân khối đặc trong cụm chi tiết mới; các chi tiết của cụm lắp ráp trở thành cụm chi tiết lồng nhau. Dùng để nhập mô hình từ nhà cung cấp hoặc chương trình CAD khác.","help.file.save_mesh":"Lưu các thân khối thành lưới đa giác STL, 3MF hoặc OBJ, với độ mịn của các mặt cong do bạn chọn. Dùng để chuẩn bị chi tiết cho in 3D hoặc cho các chương trình đọc lưới đa giác.","help.file.send_to_slicer":"Lưu các thân khối đã chọn thành tệp 3MF và mở trong phần mềm cắt lớp bạn chọn. Dùng để chuyển từ mô hình sang in chỉ trong một bước.","help.font_details":"Giao diện sử dụng các phông chữ tích hợp của egui (Ubuntu Light và Hack, theo Ubuntu Font Licence và giấy phép MIT/Bitstream Vera; Noto Emoji và phông biểu tượng emoji, theo OFL và MIT). Văn bản phác thảo dùng Liberation Sans (SIL OFL 1.1). Gói phông chữ tùy chọn của Crafting Apps, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), không được đóng gói kèm trong các bản dựng SolidCraft.","help.fonts":"Phông chữ","help.frame.member":"Đặt một biên dạng, chẳng hạn ống hoặc nhôm định hình, dọc theo các đường của phác thảo khung, mỗi đường một phần tử. Dùng để dựng khung, giá đỡ và kết cấu hàn.","help.inspect.accessibility":"Tô màu các mặt mà dụng cụ có thể tiếp cận từ một hướng và các mặt không tiếp cận được. Dùng để kiểm tra chi tiết có gia công hoặc ép khuôn được từ phía đó không.","help.inspect.center_of_mass":"Hiển thị trọng tâm của các thân khối, từng thân riêng và tất cả cùng nhau, với giả định mật độ đồng đều. Dùng để kiểm tra cân bằng và chỗ chi tiết sẽ bị lật.","help.inspect.colored_components":"Gán cho mỗi cụm chi tiết một màu tạm thời riêng, không thay đổi ngoại quan. Dùng để phân biệt các chi tiết của cụm lắp ráp chỉ trong một cái nhìn.","help.inspect.compare":"So sánh hai thân khối và chỉ ra chỗ nào một thân có vật liệu mà thân kia không có, kèm thể tích và độ lệch. Dùng để đối chiếu chi tiết đã chỉnh sửa hoặc nhập vào với bản gốc.","help.inspect.continuity":"Kiểm tra các mặt gặp nhau mượt đến đâu dọc theo cạnh: khe hở, gãy góc hoặc nhảy độ cong, và tô bóng các đường nối. Dùng để tìm chỗ các bề mặt nối chưa sạch.","help.inspect.curvature_comb":"Vẽ các lược dọc theo đường cong, cạnh hoặc mặt, với răng lược cho thấy mức độ uốn cong. Dùng để phát hiện chỗ phẳng, chỗ gãy và độ cong không đều.","help.inspect.curvature_map":"Tô màu các mặt theo độ cong, màu đỏ ở nơi bán kính nhỏ. Dùng để tìm chỗ gấp gắt và đánh giá độ mượt của bề mặt.","help.inspect.draft":"Tô màu các mặt theo góc thoát khuôn so với hướng tháo khuôn, đánh dấu những mặt có góc quá nhỏ. Dùng để kiểm tra chi tiết trước khi ép khuôn hoặc đúc.","help.inspect.environment_map":"Hiển thị mô hình với lớp hoàn thiện phản chiếu như gương. Dùng để đánh giá độ uôn lượn của bề mặt qua cách các hình phản chiếu chạy trên đó.","help.inspect.interference":"Tìm các thân khối chồng lấn nhau và hiển thị từng vùng chồng lấn kèm thể tích. Dùng để kiểm tra cụm lắp ráp xem có chi tiết nào va chạm không.","help.inspect.isocurve":"Vẽ các đường đẳng trị của mặt, tức lưới mà bề mặt được xây dựng trên đó. Dùng để xem bề mặt chạy ra sao và chỗ nào các đường dồn lại.","help.inspect.measure":"Đo chiều dài, khoảng cách, góc, diện tích và bán kính giữa các đối tượng bạn chọn, hoặc thể tích và khối lượng của thân khối. Dùng để kiểm tra kích thước và khe hở.","help.inspect.minimum_radius":"Tìm bán kính cong nhỏ nhất của đường cong, cạnh hoặc mặt và vị trí của nó. Dùng để kiểm tra dụng cụ hoặc đầu phun có đi theo được hình dạng này không.","help.inspect.section":"Cắt mở khung nhìn theo một mặt phẳng và tô gạch các mặt bị cắt, không thay đổi mô hình. Dùng để nhìn vào bên trong chi tiết và cụm lắp ráp.","help.inspect.zebra":"Hiển thị các sọc đen trắng phản chiếu trên các mặt của mô hình. Dùng để đánh giá độ mượt: sọc bị đứt hoặc gãy tại một cạnh cho thấy chỗ chuyển tiếp kém.","help.joint.as_built":"Nối hai chi tiết tại vị trí hiện có mà không di chuyển chi tiết nào, đồng thời đặt cách chúng còn có thể chuyển động. Dùng cho các chi tiết đã được đặt ở vị trí cuối cùng.","help.joint.cam":"Liên kết cam quay với con đội để con đội trượt hoặc lắc khi biên dạng cam đi qua bên dưới. Dùng cho cam, cơ cấu lệch tâm và bộ dẫn động van.","help.joint.create":"Nối hai chi tiết tại các gốc tọa độ khớp nối bạn chọn và đưa chi tiết thứ hai vào vị trí; loại khớp nối quyết định cách chúng còn có thể chuyển động. Dùng để dựng cụm lắp ráp có các chi tiết chuyển động như cơ cấu thực.","help.joint.drive":"Đặt góc hoặc khoảng cách của khớp nối và di chuyển các chi tiết theo nó trong giới hạn cho phép; các khớp liên kết và vòng kín chuyển động theo. Dùng để kiểm tra cơ cấu có chuyển động đúng dự kiến hay không.","help.joint.gear":"Liên kết hai khớp quay theo tỉ số truyền bánh răng để dẫn động khớp này làm khớp kia quay. Dùng cho bánh răng trụ răng thẳng và bánh răng vành, với tỉ số từ bán kính vòng chia hoặc số răng.","help.joint.limits":"Đặt giới hạn nhỏ nhất và lớn nhất cho góc quay hoặc hành trình trượt của khớp nối, hoặc xóa các giới hạn đó. Dùng để giữ bản lề, con trượt hoặc đòn bẩy trong phạm vi chuyển động thực tế.","help.joint.motion_link":"Ghép hai khớp nối theo tỉ số và độ lệch để dẫn động khớp này làm khớp kia chuyển động. Dùng cho quan hệ cố định giữa các khớp mà Khớp bánh răng, Khớp thanh răng - bánh răng hoặc Khớp trục vít không đáp ứng.","help.joint.origin":"Đặt gốc tọa độ khớp nối có tên trên chi tiết: tại tâm mặt hoặc đầu tròn, trung điểm cạnh, góc hoặc một điểm. Dùng để chuẩn bị vị trí gắn khớp nối; gốc chọn trên mặt sẽ đi theo mặt khi chi tiết đổi kích thước.","help.joint.rack_pinion":"Liên kết bánh răng quay với thanh răng trượt để thanh răng di chuyển bằng độ dài cung vòng chia mà bánh răng lăn qua. Dùng cho bộ truyền thanh răng, cơ cấu lái và bàn trượt tuyến tính.","help.joint.reach":"Di chuyển một điểm trên chi tiết về phía đích bằng cách thay đổi các khớp trong chuỗi của nó, trong giới hạn cho phép. Dùng để đặt tư thế cơ cấu theo vị trí mong muốn của đầu mút, như đầu cánh tay rô bốt.","help.joint.rigid_group":"Khóa các chi tiết đã chọn với nhau ở vị trí hiện tại để chúng chuyển động như một khối. Dùng cho các chi tiết thuộc cùng một nhóm và không chuyển động tương đối với nhau.","help.joint.screw":"Liên kết chuyển động quay và trượt theo bước vít để mỗi vòng quay tiến được khoảng cách đó. Dùng cho vít me, bu lông và trục có ren.","help.library.apply":"Áp dụng vật liệu hoặc ngoại quan từ tệp thư viện cục bộ lên thân khối, mặt hoặc cụm chi tiết. Dùng để tái sử dụng vật liệu đã lưu từ thiết kế khác.","help.library.export":"Lưu vật liệu và ngoại quan của thiết kế vào tệp thư viện. Dùng để chia sẻ hoặc tái sử dụng trong các thiết kế khác.","help.library.inspect":"Kiểm tra một tệp thư viện và liệt kê các vật liệu, ngoại quan trong đó, không thay đổi thiết kế. Dùng để xem thư viện có gì trước khi áp dụng.","help.licences":"Giấy phép","help.material.assign":"Đặt vật liệu cho các khối đã chọn, chẳng hạn thép, nhôm hoặc ABS. Dùng để khối lượng và trọng lượng khớp với chi tiết thật.","help.material.properties.validate":"Kiểm tra thẻ dữ liệu vật liệu xem các số liệu có nhất quán và có thiếu giá trị nào không. Dùng trước khi dựa vào dữ liệu này để tính khối lượng hay độ cứng.","help.mesh.convert":"Dựng lại thân khối dạng lưới, chẳng hạn tệp STL, thành khối đặc có thể chỉnh sửa với các mặt phẳng và mặt trụ. Dùng để sửa các chi tiết cơ khí nhập vào như một thân khối tự dựng.","help.mit":"Giấy phép MIT","help.motion.study":"Đặt giá trị khớp nối tại các bước trên dòng thời gian và phát lại dưới dạng hoạt ảnh. Dùng để quan sát cơ cấu chuyển động theo chuỗi và kiểm tra khe hở trên đường đi.","help.motion.trace":"Theo dõi quỹ đạo của một điểm trên chi tiết khi phát nghiên cứu chuyển động hoặc dẫn động khớp nối, rồi giữ lại dưới dạng đường cong phác thảo 3D khi xác nhận. Dùng để xem tầm vươn của cơ cấu hoặc dựng hình dựa trên quỹ đạo đó.","help.notice":"NOTICE","help.occurrence.ground":"Cố định chi tiết tại chỗ hoặc giải phóng nó trở lại để các khớp nối di chuyển những chi tiết khác quanh nó. Dùng cho khung hoặc đế làm nền cho phần còn lại của cụm lắp ráp.","help.occurrence.move":"Chỉ di chuyển chi tiết lắp ráp theo các bậc tự do mà khớp nối cho phép. Chọn một mặt của chi tiết, rồi kéo mũi tên hoặc cung tròn có thể sử dụng.","help.parameters.change":"Mở bảng các giá trị có tên và biểu thức điều khiển kích thước của thiết kế. Dùng để sửa một kích thước ở một chỗ và mọi tính năng dùng nó sẽ cập nhật theo.","help.parameters.export":"Lưu các tham số của thiết kế dạng CSV hoặc JSON. Dùng để chỉnh sửa trong bảng tính hoặc chuyển sang thiết kế khác.","help.parameters.graph":"Hiển thị tham số và tính năng nào dùng tham số, tính năng nào khác, cùng các vòng lặp hoặc lỗi giữa chúng. Dùng để biết thay đổi một tham số sẽ ảnh hưởng đến những gì.","help.parameters.import":"Đọc tham số từ CSV hoặc JSON vào thiết kế, hoặc nhập tất cả hoặc không nhập gì. Dùng để đưa giá trị từ bảng tính hoặc thiết kế khác vào.","help.parameters.move":"Di chuyển một tham số người dùng lên trước hoặc xuống sau tham số khác trong danh sách. Dùng để giữ các tham số liên quan gần nhau.","help.parts.fastener":"Thêm vít, bu lông, đai ốc, vòng đệm, chốt hoặc ổ lăn tiêu chuẩn theo kích thước bạn chọn. Dùng tại lỗ để chi tiết liên kết tự lắp vào bằng khớp nối, giúp bạn không phải tự dựng hình chi tiết liên kết.","help.parts.insert":"Chèn chi tiết tiêu chuẩn theo họ, kích thước và chiều dài bạn chọn. Dùng tại vành hoặc thành lỗ để chi tiết lắp vào lỗ bằng khớp ngàm cứng.","help.parts.library":"Mở thư viện chi tiết tiêu chuẩn: vít, bu lông, đai ốc, vòng đệm, vít hãm, chốt định vị và ổ lăn theo kích thước tiêu chuẩn. Dùng để thêm chi tiết tiêu chuẩn thay vì tự dựng hình.","help.parts.resize":"Thay đổi kích thước hoặc chiều dài của chi tiết tiêu chuẩn đã chèn và dựng lại nó; các khớp nối giữ chi tiết đúng vị trí lắp. Dùng khi vít quá dài hoặc lỗ cần kích thước khác.","help.plastic.assign_rule":"Gán một quy tắc nhựa kỹ thuật cho các thân khối, để các tính năng nhựa của chúng lấy góc thoát khuôn và khe hở từ đó làm mặc định. Dùng để thiết lập chi tiết ép khuôn một lần cho mọi tính năng.","help.plastic.boss":"Thêm vấu bắt ốc vỏ nhựa lên một mặt: một trụ có thể kèm lỗ, góc thoát khuôn, Bo tròn mép ở chân và các gân tăng cứng. Dùng cho điểm bắt vít trong vỏ ép khuôn hoặc in 3D.","help.plastic.lip":"Thêm gờ khớp mí hoặc rãnh tương ứng dọc theo mép của thân khối đã khoét rỗng. Dùng để hai nửa vỏ định vị vào nhau và đóng khít.","help.plastic.manage_rules":"Tạo và chỉnh sửa quy tắc nhựa kỹ thuật: vật liệu, độ dày thành, bán kính, khe hở và góc thoát khuôn. Dùng để các tính năng của chi tiết ép khuôn luôn nhất quán.","help.plastic.rest":"Thêm vấu đỡ nhựa lên một mặt: đệm tròn hoặc chữ nhật, đặc hoặc rỗng, có góc thoát khuôn. Dùng làm chân đỡ hoặc trụ kê trong vỏ ép khuôn.","help.plastic.snap_fit":"Thêm móc khớp gài bấm lên một mặt, với chiều dài, độ dày và chốt hãm. Dùng để gài các chi tiết vào nhau mà không cần vít.","help.pointcloud.insert":"Chèn bản quét PLY, XYZ hoặc PTS dưới dạng đám mây điểm bên cạnh mô hình. Dùng làm tham chiếu khi dựng mô hình từ dữ liệu đo.","help.sheet.convert":"Biến một tấm hoặc thân khối khoét rỗng có độ dày đều thành thân kim loại tấm, với các chỗ uốn tại cạnh bạn chọn. Dùng để làm cho chi tiết có sẵn trải phẳng được.","help.sheet.export_bend_table":"Lưu bảng chấn uốn của thân kim loại tấm dạng CSV hoặc JSON: góc, bán kính và vị trí chấn trên bản trải phẳng. Dùng cho máy chấn hoặc xưởng gia công.","help.sheet.export_dxf":"Lưu bản trải phẳng dạng DXF, gồm đường viền, đường chấn và ghi chú chấn tùy chọn. Dùng cho cắt laser, plasma hoặc tia nước.","help.sheet.flange":"Thêm chấn gập mép tôn: tấm đế từ phác thảo, thành dọc theo đường viền phác thảo hở, hoặc thành uốn trên cạnh tấm. Dùng để dựng các chi tiết kim loại tấm.","help.sheet.flat_pattern":"Tạo bản trải phẳng của thân kim loại tấm, gồm kích thước, các lỗ cắt và đường chấn. Dùng để kiểm tra phôi trước khi cắt.","help.sheet.fold":"Uốn tấm kim loại dọc theo một đường phác thảo với góc và bán kính cho trước. Dùng để gập tấm phẳng sau khi đã tạo các chi tiết cắt trên đó.","help.sheet.hem":"Gấp mép tấm kim loại ngược lại lên chính nó. Dùng để có mép an toàn, cứng cáp và không còn ba via sắc.","help.sheet.manage_rules":"Tạo và chỉnh sửa quy tắc kim loại tấm: độ dày, bán kính uốn, K-factor, rãnh giảm ứng suất và khe hở. Dùng để khớp với vật liệu và dụng cụ của xưởng bạn.","help.sheet.path_flange":"Thêm một chuỗi chấn gập mép tôn dọc theo cạnh tấm, theo một chuỗi đường phác thảo hở. Dùng cho các biên dạng như chữ U hoặc Z chỉ trong một bước.","help.sheet.perforate":"Thêm một vùng lỗ phủ toàn bộ tấm phẳng, theo kiểu so le hoặc vuông. Dùng cho lỗ thông gió, lưới chắn và tấm nhẹ hơn.","help.sheet.refold":"Gập lại thân kim loại tấm đã được trải phẳng. Dùng sau khi thêm tính năng lên tấm phẳng.","help.sheet.unfold":"Trải phẳng mọi chỗ uốn của thân kim loại tấm. Dùng để thêm lỗ hoặc đường cắt phải băng qua chỗ uốn, rồi Gập lại tấm kim loại.","help.sketch.arc.center_point":"Vẽ cung tròn quanh một tâm, từ điểm đầu đến điểm cuối. Dùng khi đã biết tâm cung, chẳng hạn bán kính quanh lỗ hoặc trục xoay.","help.sketch.arc.tangent":"Vẽ cung tròn bắt đầu từ đầu mút của đường thẳng hoặc cung và tiếp tuyến với nó. Dùng để nối tiếp chuỗi bằng chỗ uốn mượt thay vì góc nhọn.","help.sketch.arc.three_point":"Vẽ cung tròn từ điểm đầu đến điểm cuối đi qua điểm thứ ba. Dùng khi cung phải đi qua các điểm cho trước chứ không quanh một tâm đã biết.","help.sketch.arc3d":"Vẽ cung tròn chính xác trong không gian qua ba điểm, khi bật 3D Phác thảo. Dùng cho các chỗ uốn của đường dẫn và ray dẫn hướng nằm ngoài mặt phẳng phác thảo.","help.sketch.auto_constrain":"Thêm các ràng buộc mà phác thảo gần như đã thỏa, như nằm ngang, song song hay trùng khớp, rồi thêm kích thước cho đến khi xác định hoàn toàn. Dùng để khóa một phác thảo vẽ tay chỉ trong một bước.","help.sketch.auto_constrain_from_datum":"Hoạt động như Tự động gán ràng buộc, nhưng đo vị trí từ điểm chuẩn bạn chọn thay vì gốc tọa độ. Dùng khi chi tiết được bố trí từ một điểm tham chiếu, như góc hoặc lỗ.","help.sketch.blend_curve":"Nối đầu mút của hai đường cong bằng một spline mượt tiếp tuyến với cả hai, hoặc liên tục cả độ cong nếu bạn chọn. Dùng để lấp khoảng hở giữa các đường cong mà không bị gãy.","help.sketch.break":"Tách đường cong thành các đoạn tại chỗ các đường cong khác cắt qua, hoặc tại các điểm bạn đặt lên nó. Dùng khi một đoạn cần ràng buộc riêng hoặc cần xóa riêng.","help.sketch.cancel":"Thoát phác thảo và bỏ mọi thay đổi kể từ khi tạo hoặc mở ra để chỉnh sửa. Hoàn tác sẽ khôi phục lại các thay đổi.","help.sketch.centerline":"Chuyển đường thẳng giữa đường thường và đường tâm, tức trục mà biên dạng bỏ qua. Dùng đường tâm làm trục cho Xoay tròn tạo khối, đối xứng gương hoặc ràng buộc đối xứng.","help.sketch.chamfer.distance_angle":"Vát mép góc giữa hai đường thẳng theo khoảng cách dọc đường thứ nhất và một góc. Dùng khi bản vẽ cho kích thước vát mép bằng chiều dài và góc, như 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Vát mép góc giữa hai đường thẳng với cùng khoảng cách dọc theo cả hai. Dùng cho kiểu vát mép 45° thông thường trên đường bao.","help.sketch.chamfer.two_distance":"Vát mép góc giữa hai đường thẳng với khoảng cách riêng dọc theo từng đường. Dùng cho vát mép không phải 45°, cho bằng hai chiều dài.","help.sketch.circle.center":"Vẽ đường tròn từ tâm và đường kính. Dùng cho lỗ, vấu và các chi tiết tròn khác đã biết tâm.","help.sketch.circle.three_point":"Vẽ đường tròn đi qua ba điểm. Dùng khi đường tròn phải đi qua các điểm cho trước, chẳng hạn của hình học có sẵn.","help.sketch.circle.three_tangent":"Vẽ đường tròn tiếp xúc với ba đường thẳng, đường tròn hoặc cung. Dùng để đặt đường tròn vào khoảng giữa ba đường cong, như đường tròn nội tiếp của tam giác.","help.sketch.circle.two_point":"Vẽ đường tròn từ hai đầu mút của đường kính. Dùng khi biết các điểm trên mép đường tròn chứ chưa biết tâm.","help.sketch.circle.two_tangent":"Vẽ đường tròn có kích thước cho trước tiếp xúc với hai đường thẳng, đường tròn hoặc cung. Dùng để bo tròn với bán kính cố định giữa hai đường cong.","help.sketch.conic":"Vẽ đường conic giữa hai đầu mút, định hình bằng một điểm đỉnh và giá trị rho. Dùng cho các chỗ chuyển tiếp mượt mà bạn muốn chỉnh độ phồng, từ phẳng đến gần như góc nhọn.","help.sketch.constrainer":"Áp dụng ràng buộc mà một hoặc hai đường cong đã chọn gần như đã thỏa, như nằm ngang, song song, tiếp tuyến hay bằng nhau. Dùng để chỉnh lại phác thảo vẽ tay từng quan hệ một.","help.sketch.constraint.coincident":"Làm một điểm trùng với điểm khác, nằm trên một đường cong hoặc trục phác thảo. Dùng để đóng khe hở trong biên dạng hoặc đặt điểm lên đường thẳng.","help.sketch.constraint.collinear":"Làm hai đường thẳng nằm trên cùng một đường thẳng. Dùng để căn thẳng hàng các cạnh bị ngắt quãng, như hai bên của một khe khuyết.","help.sketch.constraint.concentric":"Cho hai đường tròn hoặc cung cùng một tâm. Dùng cho vòng, lỗ khoét bậc và trục có vai.","help.sketch.constraint.curvature":"Làm hai đường cong gặp nhau tại đầu mút tiếp tục với cùng độ cong (G2). Dùng khi nối tiếp tuyến chưa đủ mượt, chẳng hạn trên các bề mặt nhìn thấy.","help.sketch.constraint.equal":"Làm các đường thẳng bằng chiều dài, hoặc các đường tròn và cung bằng bán kính. Dùng để một kích thước điều khiển nhiều chi tiết giống nhau.","help.sketch.constraint.fix":"Cố định điểm hoặc đường cong tại chỗ, hoặc bỏ cố định chúng. Dùng cho hình học không được di chuyển khi bạn kéo hoặc giải phác thảo.","help.sketch.constraint.horizontal_vertical":"Làm một đường thẳng, hoặc đường nối hai điểm, nằm ngang hoặc thẳng đứng, tùy hướng nào gần hơn. Dùng để căn đường bao thẳng theo các trục phác thảo.","help.sketch.constraint.midpoint":"Đặt một điểm vào trung điểm của đường thẳng, hoặc làm trung điểm của hai đường thẳng trùng nhau. Dùng để căn giữa hình học trên một cạnh.","help.sketch.constraint.parallel":"Làm hai đường thẳng song song. Dùng cho các cạnh phải luôn song song khi các kích thước khác thay đổi.","help.sketch.constraint.perpendicular":"Làm hai đường thẳng gặp nhau ở góc vuông. Dùng cho các góc vuông giữa những đường không nằm trên trục phác thảo.","help.sketch.constraint.polygon":"Biến chuỗi đường thẳng khép kín thành đa giác đều: các cạnh bằng nhau, mọi đỉnh nằm trên một đường tròn. Dùng để làm đa giác vẽ tay thành đa giác đều và giữ nguyên như vậy.","help.sketch.constraint.symmetry":"Làm hai điểm hoặc đường cong đối xứng nhau qua một đường thẳng hoặc quanh một điểm. Dùng để giữ biên dạng đối xứng khi bạn sửa một bên.","help.sketch.constraint.tangent":"Làm hai đường cong tiếp xúc tiếp tuyến, như đường thẳng và cung. Dùng cho các chỗ nối mượt, không bị gãy góc.","help.sketch.construction":"Chuyển đường cong giữa hình học thường và hình học dựng hình, thứ mà biên dạng bỏ qua. Dùng đường dựng hình làm công cụ hỗ trợ bố trí, tham chiếu và ghi kích thước.","help.sketch.construction_line":"Tạo đường thẳng dựng hình vô hạn qua hai điểm để bố trí phác thảo mà không chia tách biên dạng.","help.sketch.construction_line.angle":"Tạo đường dựng hình vô hạn theo góc so với trục X của phác thảo. Chọn điểm rồi nhập góc hoặc chọn hướng.","help.sketch.construction_line.bisector":"Chọn hai đường thẳng giao nhau trong phác thảo rồi chọn một trong hai đường phân giác. Kết quả thay đổi theo các đường gốc.","help.sketch.construction_line.horizontal":"Tạo đường dựng hình nằm ngang vô hạn qua một điểm. Ràng buộc ngang được giữ khi chỉnh sửa sau này.","help.sketch.construction_line.parallel":"Chọn đường thẳng trong phác thảo rồi đặt đường dựng hình vô hạn song song. Nhấp chuột phải để đổi tham chiếu.","help.sketch.construction_line.perpendicular":"Chọn đường thẳng trong phác thảo rồi đặt đường dựng hình vô hạn vuông góc. Nhấp chuột phải để đổi tham chiếu.","help.sketch.construction_line.tangent_at":"Tạo tiếp tuyến tại một điểm trên đường tròn hoặc cung tròn, hoặc tại đầu mút của spline hay đường conic hở. Chọn đường cong rồi chọn tiếp điểm.","help.sketch.construction_line.tangent_external":"Chọn đường tròn hoặc cung tròn, một điểm ngoài rồi chọn nghiệm tiếp tuyến. Bản xem trước chỉ hiển thị tiếp điểm trên cung đã vẽ.","help.sketch.construction_line.tangent_two":"Chọn hai đường tròn hoặc cung tròn rồi chọn tiếp tuyến chung trong bản xem trước. Tiếp điểm phải nằm trên các đường cong đã vẽ.","help.sketch.construction_line.vertical":"Tạo đường dựng hình thẳng đứng vô hạn qua một điểm. Ràng buộc đứng được giữ khi chỉnh sửa sau này.","help.sketch.copy":"Sao chép các đường cong và điểm phác thảo đã chọn, cùng các ràng buộc và kích thước giữa chúng. Dán vào phác thảo này hoặc phác thảo khác.","help.sketch.create":"Bắt đầu một phác thảo 2D mới trên mặt phẳng chuẩn hoặc mặt phẳng của khối. Mọi lệnh Đùn khối, Xoay tròn tạo khối và Quét theo đường dẫn đều bắt đầu từ một phác thảo.","help.sketch.cut":"Sao chép hình học phác thảo đã chọn rồi xóa khỏi phác thảo, trong một bước hoàn tác. Dán sang chỗ khác trong phác thảo này hoặc phác thảo khác.","help.sketch.dimension":"Thêm kích thước điều khiển: chiều dài, khoảng cách, góc, bán kính hoặc đường kính, tùy thứ bạn chọn. Nhập giá trị hoặc tên tham số, phác thảo sẽ thay đổi theo.","help.sketch.edit":"Mở một phác thảo có sẵn để chỉnh sửa. Các tính năng dựng trên nó sẽ cập nhật khi bạn hoàn tất phác thảo.","help.sketch.ellipse":"Vẽ hình elip từ tâm, đầu mút trục lớn và một điểm ở phía trục nhỏ. Dùng cho lỗ mở hình bầu dục, cam và các hình tròn dài khác.","help.sketch.equation_curve":"Vẽ một đường cong từ công thức trên một khoảng: x(t) và y(t), hoặc y = f(x). Công thức có thể dùng tham số và đường cong thay đổi theo: dùng cho sóng sin, đường xoắn ốc hay đường thân khai của răng bánh răng.","help.sketch.extend":"Kéo dài đường thẳng hoặc cung đến đường cong gần nhất cản đường, hoặc kéo hai đường cong cho đến khi gặp nhau. Dùng để đóng khe hở trong biên dạng sau khi cắt tỉa hoặc chỉnh sửa.","help.sketch.fillet":"Bo tròn góc nơi hai đường thẳng hoặc cung gặp nhau bằng một cung có bán kính cho trước. Nhiều góc bo cùng lúc dùng chung một bán kính.","help.sketch.finish":"Thoát phác thảo và quay lại mô hình. Các biên dạng khép kín của nó khi đó sẵn sàng cho Đùn khối, Xoay tròn tạo khối và các tính năng khác.","help.sketch.finish_auto_constrain":"Chạy Tự động gán ràng buộc cho phác thảo rồi hoàn tất. Dùng để để lại phác thảo xác định hoàn toàn chỉ trong một bước.","help.sketch.fit_curves_to_section":"Cắt một lưới hoặc khối đặc bằng mặt phẳng phác thảo rồi khớp các đường thẳng và cung vào mặt cắt. Dùng để dựng lại chi tiết quét hoặc nhập vào thành phác thảo có thể chỉnh sửa.","help.sketch.include_3d":"Đưa cạnh, đỉnh của mô hình và đường cong của các phác thảo khác vào phác thảo này dưới dạng tham chiếu liên kết, làm phẳng phần nằm ngoài mặt phẳng của nó. Dùng để dựng tiếp trên hình học không nằm trong mặt phẳng phác thảo.","help.sketch.infinite":"Chuyển đường thẳng giữa đường thường và đường dựng hình vô hạn chạy suốt khung nhìn. Dùng làm tham chiếu bố trí không bao giờ bị ngắn.","help.sketch.insert_dxf":"Đọc các đường cong của bản vẽ DXF vào phác thảo, theo tỉ lệ, góc xoay và vị trí bạn đặt. Dùng để dựng tiếp từ bản vẽ 2D của chương trình khác, như biên dạng cắt laser.","help.sketch.insert_svg":"Đọc các đường dẫn của bản vẽ SVG vào phác thảo, theo tỉ lệ, góc xoay và vị trí bạn đặt. Dùng để biến logo hoặc đường bao véc tơ thành đường cong có thể đùn.","help.sketch.inspect":"Mở báo cáo về bản phác thảo đang mở: còn bao nhiêu bậc tự do và đã ràng buộc hoàn toàn chưa. Dùng nó để biết phần nào vẫn còn di chuyển được trước khi hoàn tất bản phác thảo.","help.sketch.intersect":"Thêm các đường cong hoặc điểm nơi khối, mặt, cạnh hoặc phác thảo khác cắt qua mặt phẳng phác thảo. Chúng vẫn được liên kết và thay đổi theo mô hình.","help.sketch.intersection_curve":"Tạo đường cong 3D tại nơi hai khối hoặc hai mặt gặp nhau, liên kết với chúng. Dùng làm đường dẫn hoặc ray dẫn hướng thay đổi theo mô hình.","help.sketch.isoparametric_curve":"Tạo đường cong 3D theo hướng U hoặc V của một mặt qua điểm bạn chọn, liên kết với mặt đó. Dùng làm đường dẫn hoặc đường tách thay đổi theo bề mặt.","help.sketch.line":"Vẽ các đường thẳng nối liền từng điểm một, thành chuỗi hở hoặc đường bao khép kín. Đây là công cụ cơ bản cho hầu hết biên dạng.","help.sketch.line.midpoint":"Vẽ đường thẳng từ trung điểm ra một đầu, đầu kia đối xứng qua trung điểm. Dùng cho đường thẳng có tâm tại một điểm, như cạnh đối xứng.","help.sketch.line3d":"Vẽ các đường thẳng nối giữa các điểm trong không gian, khi bật 3D Phác thảo. Dùng cho đường dẫn và khung nằm ngoài mặt phẳng phác thảo.","help.sketch.mirror":"Lấy đối xứng gương các đường cong và điểm phác thảo qua một đường thẳng hoặc trục, đồng thời thêm ràng buộc đối xứng. Dùng để vẽ nửa biên dạng đối xứng rồi hoàn thiện nó.","help.sketch.move":"Di chuyển hoặc xoay các đường cong và điểm phác thảo, hoặc một bản sao của chúng. Dùng để đổi vị trí hình học mà vẫn giữ nguyên hình dạng và ràng buộc.","help.sketch.offset":"Tạo bản sao của một chuỗi đường cong ở khoảng cách cho trước, về một phía hoặc cả hai. Dùng cho thành, đường bao và khe hở; khoảng cách vẫn là kích thước có thể chỉnh sửa.","help.sketch.paste":"Dán hình học phác thảo đã sao chép hoặc cắt vào phác thảo đang hoạt động. Đặt tại một điểm hoặc dời theo một khoảng.","help.sketch.pattern.circular":"Sao chép hình học phác thảo quanh một tâm, trên cả vòng tròn hoặc một góc cho trước. Dùng cho vòng lỗ bu lông, nan hoa và răng.","help.sketch.pattern.rectangular":"Sao chép hình học phác thảo theo hàng và cột với khoảng cách cho trước. Dùng cho lưới lỗ, rãnh then hoặc khe thông gió.","help.sketch.point":"Đặt một điểm phác thảo. Dùng làm tham chiếu cho kích thước, ràng buộc, tâm lỗ hoặc các tính năng sau này.","help.sketch.point3d":"Đặt một điểm trong không gian, khi bật 3D Phác thảo. Dùng làm tham chiếu cho đường cong và đường dẫn 3D.","help.sketch.polygon.circumscribed":"Vẽ đa giác đều bao quanh một đường tròn, kích thước tính từ tâm đến trung điểm một cạnh. Dùng khi biết khoảng cách giữa hai cạnh đối diện, như với đai ốc lục giác.","help.sketch.polygon.edge":"Vẽ đa giác đều từ hai đầu mút của một cạnh. Dùng khi biết chiều dài và vị trí của cạnh.","help.sketch.polygon.inscribed":"Vẽ đa giác đều nội tiếp trong một đường tròn, kích thước tính từ tâm đến một đỉnh. Dùng khi biết kích thước giữa hai đỉnh đối diện.","help.sketch.project":"Đưa cạnh, mặt, đỉnh của mô hình và đường cong của các phác thảo khác vào phác thảo này, chiếu lên mặt phẳng của nó. Chúng vẫn được liên kết và thay đổi theo mô hình.","help.sketch.project_to_surface":"Chiếu đường cong của các phác thảo khác theo pháp tuyến của phác thảo này lên một mặt, thành đường cong 3D liên kết. Dùng để đặt logo, đường tách hoặc đường dẫn lên bề mặt cong.","help.sketch.rectangle.center":"Vẽ hình chữ nhật từ tâm và một góc. Dùng cho đường bao có tâm tại một điểm, như gốc tọa độ.","help.sketch.rectangle.rounded":"Vẽ hình chữ nhật có cả bốn góc bo tròn cùng một bán kính. Dùng cho tấm, nắp và lỗ mở có góc bo tròn.","help.sketch.rectangle.three_point":"Vẽ hình chữ nhật từ một cạnh và một điểm ở phía đối diện. Dùng cho hình chữ nhật nghiêng so với trục phác thảo.","help.sketch.rectangle.two_point":"Vẽ hình chữ nhật từ hai góc đối diện. Dùng cho đường bao của tấm, khối và hốc.","help.sketch.scale":"Thay đổi tỉ lệ các đường cong và điểm phác thảo theo một hệ số quanh điểm gốc. Dùng để đổi kích thước một phần phác thảo mà không phải vẽ lại.","help.sketch.slot.arc_center":"Vẽ rãnh then cong có độ rộng cho trước dọc theo một cung xác định bởi tâm, điểm đầu và điểm cuối. Dùng cho rãnh điều chỉnh quanh trục xoay.","help.sketch.slot.arc_three_point":"Vẽ rãnh then cong có độ rộng cho trước dọc theo một cung đi qua ba điểm. Dùng khi đường đi của rãnh phải qua các điểm cho trước.","help.sketch.slot.center_point":"Vẽ rãnh then thẳng có độ rộng cho trước từ tâm của nó đến tâm cung ở một đầu. Dùng cho rãnh có tâm tại một điểm.","help.sketch.slot.center_to_center":"Vẽ rãnh then thẳng có độ rộng cho trước giữa tâm của hai cung ở hai đầu. Dùng cho rãnh ghi kích thước tâm đến tâm, như rãnh điều chỉnh vít.","help.sketch.slot.overall":"Vẽ rãnh then thẳng có độ rộng cho trước từ mép ngoài này đến mép ngoài kia. Dùng khi chiều dài toàn phần của rãnh là điều quan trọng.","help.sketch.spline.control_point":"Vẽ spline bậc ba được định hình bởi các điểm điều khiển mà nó không đi qua. Dùng cho đường cong mượt, uyển chuyển mà bạn chỉnh bằng cách di chuyển các điểm.","help.sketch.spline.control_point_5":"Vẽ spline bậc 5 được định hình bởi các điểm điều khiển. Dùng khi các đường cong cần nối với độ cong mượt hơn, chẳng hạn trên bề mặt tạo dáng nhìn thấy.","help.sketch.spline.fit_point":"Vẽ spline mượt đi qua mọi điểm bạn đặt, hở hoặc khép kín. Dùng để vẽ theo một hình dạng qua các điểm đã biết.","help.sketch.spline3d":"Vẽ đường cong mượt trong không gian qua các điểm, khi bật 3D Phác thảo. Dùng cho đường dẫn của lệnh Quét theo đường dẫn và đường đi dây cáp nằm ngoài mặt phẳng phác thảo.","help.sketch.spun_profile":"Tạo trong mặt phẳng phác thảo đường bao mà một khối quét qua khi quay quanh một trục. Dùng để lấy hình bóng của chi tiết tiện cho lệnh Xoay tròn tạo khối hoặc bản vẽ.","help.sketch.text":"Viết văn bản trong phác thảo với phông chữ, chiều cao và góc tùy chọn; nội dung có thể thay đổi theo tham số. Dùng Đùn khối hoặc Dập nổi để làm nhãn và chữ.","help.sketch.transform":"Đổi tỉ lệ, xoay và di chuyển hình học phác thảo quanh một tâm chỉ trong một bước. Dùng để đổi vị trí và kích thước của vùng chọn cùng lúc.","help.sketch.trim":"Xóa đoạn đường cong nằm giữa các giao điểm gần nhất quanh chỗ bạn nhấp. Dùng để dọn các đường chồng lên nhau thành biên dạng khép kín.","help.solid.align":"Di chuyển các khối đã chọn để một điểm, mặt hoặc mặt phẳng trên chúng gặp một điểm, mặt hoặc mặt phẳng ở nơi khác. Dùng để đặt chi tiết áp vào chi tiết khác mà không cần đo khoảng cách.","help.solid.boundary_fill":"Tạo khối đặc từ các vùng được bao kín bởi các thân khối công cụ chồng lấn, chỉ điền đầy những vùng bạn chọn. Dùng để dựng hình từ không gian được nhiều thân khối cùng bao lại.","help.solid.bounding_solid":"Tạo khối hộp bao ngoài các thân khối đã chọn, có thể thêm khoảng dư. Dùng để xem kích thước tổng thể của chi tiết hoặc làm phôi để gia công chi tiết đó.","help.solid.box":"Tạo khối hộp theo chiều dài, chiều rộng và chiều cao, từ điểm góc hoặc có tâm tại một điểm. Dùng để tạo nhanh khối, hình giữ chỗ hoặc thân khối để cắt tạo các tính năng.","help.solid.chamfer":"Vát các cạnh đã chọn theo khoảng cách bạn thiết lập. Dùng để triệt tiêu cạnh sắc hoặc giúp lắp chốt, bu lông dễ dàng hơn.","help.solid.coil":"Tạo thân khối xoắn ốc, như lò xo, từ đường kính, số vòng, chiều cao hoặc bước xoắn và tiết diện tròn hoặc vuông. Dùng cho lò xo, cuộn xoắn và gờ xoắn ốc.","help.solid.combine":"Hợp nhất các khối, cắt trừ khỏi khối đích, hoặc chỉ giữ lại phần thể tích giao nhau, đồng thời có thể giữ lại các khối công cụ. Dùng để gộp chi tiết, dùng hình này cắt hình kia hoặc tìm vị trí hai khối giao nhau.","help.solid.cone":"Tạo khối nón từ đường tròn đáy và chiều cao, hoặc nón cụt khi đỉnh cũng có bán kính. Dùng cho phần thuôn, phễu, lỗ loe côn và đầu nhọn.","help.solid.cylinder":"Tạo khối trụ theo bán kính hoặc đường kính và chiều cao, dựng tại một điểm dọc theo một trục. Dùng cho trục, chốt, vấu trụ và phôi tròn.","help.solid.draft":"Làm nghiêng các mặt đã chọn theo góc thiết lập, đo từ một mặt phẳng trung hòa. Dùng cho chi tiết đúc hoặc ép phun để chúng tháo ra khỏi khuôn được.","help.solid.emboss":"Dập nổi các biên dạng phác thảo, như chữ hoặc logo, lên khỏi mặt hoặc dập chìm vào mặt. Dùng cho chữ, nhãn và dấu trên mặt phẳng hoặc mặt tròn.","help.solid.extrude":"Đùn biên dạng phác thảo thành khối 3D theo khoảng cách, thêm hoặc bớt vật liệu. Dùng để biến phác thảo phẳng thành khối, vấu nổi hoặc hốc lõm.","help.solid.fillet":"Bo tròn các cạnh đã chọn bằng cung cong mượt mà theo bán kính thiết lập. Dùng để làm mềm cạnh sắc nhằm tăng độ bền, an toàn khi chạm hoặc tăng thẩm mỹ.","help.solid.hole":"Khoan lỗ tròn theo đường kính thiết lập tại vị trí chọn trên mặt. Dùng cho lỗ xỏ bu lông, chốt định vị và các lỗ tròn đơn giản.","help.solid.loft":"Tạo khối đặc chuyển tiếp mượt mà giữa hai hay nhiều biên dạng phác thảo, hoặc từ một biên dạng đến một điểm. Dùng cho đoạn chuyển tiếp, phễu, tay nắm và bất kỳ hình dạng nào có tiết diện biến thiên dọc theo chiều dài.","help.solid.mirror":"Tạo bản sao đối xứng của các khối hoặc tính năng được chọn qua một mặt phẳng, có thể hợp nhất với bản gốc. Dùng cho các chi tiết đối xứng, chỉ cần dựng một nửa để có toàn bộ.","help.solid.move":"Di chuyển hoặc xoay các khối đã chọn, hoặc một bản sao của chúng, theo khoảng cách và góc thiết lập. Dùng để đổi vị trí một khối hoặc tạo thêm một khối ở chỗ khác.","help.solid.offset_face":"Đẩy các mặt đã chọn vào trong hoặc ra ngoài theo khoảng cách thiết lập, các mặt xung quanh tự điều chỉnh theo. Dùng để làm thành dày hơn, hốc sâu hơn hoặc phần lồi cao hơn mà không sửa bản phác thảo.","help.solid.pattern.circular":"Lặp lại các đối tượng được chọn quanh một trục theo số lượng và tổng góc thiết lập. Dùng cho bố trí vòng bu lông, nan hoa, cánh tản nhiệt và răng bánh răng.","help.solid.pattern.path":"Sao chép tính năng hoặc thân khối dọc theo đường phác thảo, theo số lượng và khoảng cách. Dùng cho các lỗ dọc theo cạnh cong hoặc chi tiết dọc theo thanh ray.","help.solid.pattern.rectangular":"Lặp lại các đối tượng được chọn theo một hoặc hai hướng với số lượng và khoảng cách thiết lập. Dùng cho dãy hoặc mảng lỗ, gân tăng cứng, chốt định vị hoặc chân đế.","help.solid.pipe":"Tạo ống tròn dọc theo đường dẫn gồm các đường cong phác thảo, đặc hoặc rỗng với độ dày thành. Dùng cho ống, dây điện, cáp và thanh ray.","help.solid.press_pull":"Thêm hoặc bớt vật liệu khi kéo một mặt, hoặc bo tròn các cạnh khi kéo chúng. Dùng để sửa nhanh trực tiếp trên mô hình.","help.solid.remove":"Loại các khối đã chọn khỏi thiết kế từ điểm này trong lịch sử trở đi; các bước trước vẫn giữ chúng. Dùng để bỏ một khối phụ trợ, như một công cụ cắt không còn cần.","help.solid.replace_face":"Đưa các mặt phẳng đã chọn tới một mặt phẳng hoặc một mặt song song, khối sẽ dài ra hoặc ngắn lại để chạm tới đó. Dùng để làm một mặt phẳng hàng với chi tiết khác hoặc với mặt phẳng dựng hình.","help.solid.revolve":"Quay biên dạng phác thảo quanh một trục để tạo khối tròn xoay. Dùng cho trục, núm xoay, chén bát và bất kỳ chi tiết nào tròn xoay quanh tâm.","help.solid.rib":"Thêm gân tăng cứng mỏng dọc theo đường cong phác thảo hở, kéo đầy tới các mặt kế tiếp của thân khối. Dùng để tăng cứng thành và góc, chẳng hạn trong chi tiết đúc hoặc in.","help.solid.scale":"Phóng to hoặc thu nhỏ các khối đã chọn theo một hệ số, như nhau theo mọi hướng hoặc riêng cho từng trục. Dùng để đổi kích thước hình nhập vào hoặc bù độ co ngót.","help.solid.shell":"Khoét rỗng khối đặc, để lại thành mỏng theo độ dày thiết lập, và có thể mở các mặt bạn chọn. Dùng cho hộp, nắp che và các chi tiết thành mỏng.","help.solid.sphere":"Tạo khối cầu theo bán kính hoặc đường kính quanh một điểm tâm. Dùng cho bi, núm và đầu bo tròn.","help.solid.split_body":"Tách một khối thành các khối riêng bằng một mặt phẳng, mặt của khối khác hoặc một đường thẳng trong bản phác thảo. Dùng để tạo các chi tiết được in, gia công hoặc tô màu riêng.","help.solid.split_face":"Chia các mặt đã chọn theo một mặt phẳng, mặt của khối khác hoặc các đường cong phác thảo, mà không tách khối. Dùng để cho một phần của mặt có độ nghiêng, màu hoặc độ dịch riêng.","help.solid.sweep":"Quét một biên dạng phác thảo dọc theo đường dẫn để tạo khối đặc. Dùng cho đường ống, thanh ray, tay vịn và bất kỳ chi tiết nào có tiết diện không đổi chạy dọc theo đường cong.","help.solid.thread":"Thêm ren hệ mét ISO lên mặt trụ, dưới dạng ren biểu diễn hoặc cắt vào thân khối. Dùng cho bu lông, lỗ ren và các chi tiết ren được in.","help.solid.torus":"Tạo khối vòng từ bán kính lớn quanh trục và bán kính nhỏ của tiết diện tròn. Dùng cho vòng đệm kín, tay cầm và gờ tròn dạng vòng.","help.solid.web":"Thêm thành mỏng dọc theo mỗi đường cong phác thảo hở, mỗi thành kéo đầy tới các mặt kế tiếp của thân khối. Dùng để tạo mạng lưới gân đỡ bên trong vỏ hộp và khay.","help.surface.blend":"Tạo mặt cong nối các cạnh của hai thân khối, tiếp tuyến hoặc liên tục độ cong với cả hai. Dùng để nối hai mặt cong mượt qua một khoảng hở.","help.surface.boundary":"Tạo mặt cong lấp đầy một vòng gồm hai đến bốn đường cong phác thảo, hoặc một mạng đường cong. Dùng cho các tấm tự do được xác định bởi các cạnh của chúng.","help.surface.extend":"Kéo dài mặt cong ra ngoài cạnh của nó, theo khoảng cách hoặc đến một mặt phẳng hoặc mặt. Dùng để các mặt cong chồng lên nhau trước khi Cắt tỉa hoặc Khâu mặt cong (Stitch).","help.surface.extrude":"Đùn các đường cong hoặc biên dạng phác thảo theo một khoảng cách thành mặt cong, chỉ có thành, không có nắp. Dùng cho thành mỏng và làm dụng cụ cắt hoặc tách.","help.surface.fair":"Làm mượt phần bên trong của các mặt tự do trong khi cạnh của chúng giữ nguyên. Dùng để san phẳng các chỗ lồi lõm và phản chiếu gợn sóng trên bề mặt.","help.surface.loft":"Tạo mặt cong đi qua hai hoặc nhiều tiết diện theo thứ tự, không có nắp. Dùng cho vỏ mỏng và chuyển tiếp giữa các hình dạng khác nhau.","help.surface.match":"Dựng lại cạnh của một mặt cong để gặp cạnh của thân khối khác, khớp tiếp tuyến hoặc độ cong. Dùng để khép kín đường nối mượt giữa hai mặt cong.","help.surface.offset":"Tạo bản sao của các mặt cách một khoảng theo pháp tuyến, thành một thân mặt cong mới. Dùng để tạo lớp vỏ, khe hở hoặc mặt bên kia của một thành.","help.surface.patch":"Lấp một vùng phác thảo hoặc vòng cạnh kín bằng một mặt, phẳng hoặc cong mượt. Dùng để bít các lỗ trên thân mặt cong.","help.surface.reverse_normal":"Lật các mặt của thân mặt cong để phía ngoài của chúng quay sang hướng ngược lại. Dùng trước khi Tạo độ dày cho mặt cong hoặc Khâu mặt cong (Stitch) khi các mặt đang hướng vào trong.","help.surface.revolve":"Xoay các đường cong hoặc biên dạng phác thảo quanh một trục thành mặt cong, không có nắp. Dùng cho vỏ tròn như chụp đèn, bát và vòi phun.","help.surface.ruled":"Tạo một dải đường thẳng xuất phát từ chuỗi cạnh, theo pháp tuyến, tiếp tuyến của mặt hoặc theo một góc. Dùng cho thành thoát khuôn, vùng thoát và mặt phân khuôn.","help.surface.stitch":"Khâu các thân mặt cong lại với nhau dọc theo cạnh chung, thành khối đặc nếu chúng khép kín. Dùng để biến một tập hợp mặt cong thành một thân khối.","help.surface.sweep":"Di chuyển các đường cong hoặc biên dạng phác thảo dọc theo đường dẫn để tạo mặt cong, không có nắp. Dùng cho máng xối, nẹp viền và các hình mỏng khác chạy theo đường dẫn.","help.surface.thicken":"Cho thân mặt cong một độ dày, biến nó thành khối đặc. Dùng để tạo chi tiết in được hoặc gia công được từ các mặt cong.","help.surface.trim":"Cắt một mặt cong bằng mặt phẳng, mặt cong khác hoặc đường cong phác thảo, và giữ lại phía bạn chọn. Dùng để cắt tỉa các mặt cong theo hình trước khi Khâu mặt cong (Stitch).","help.surface.unstitch":"Tách các mặt của một thân khối thành những thân mặt cong riêng; khối đặc sẽ rã ra thành các mặt cong. Dùng để chỉnh lại từng mặt riêng của một thân khối.","help.surface.untrim":"Loại bỏ các lỗ khỏi một mặt, hoặc khôi phục biên ngoài của nó về giới hạn tự nhiên của mặt cong. Dùng để lấy lại toàn bộ mặt cong sau khi Cắt tỉa.","help.third_party":"Giấy phép của bên thứ ba","help.timeline.compute_all":"Dựng lại mọi tính năng trong lịch sử từ đầu. Dùng để làm mới mô hình và xem tính năng nào bị lỗi.","help.timeline.delete":"Xóa các tính năng đã chọn khỏi lịch sử; xóa một bản phác thảo cũng xóa các tính năng dựng từ nó. Dùng để bỏ một bước không còn cần.","help.timeline.dependents":"Liệt kê các tính năng sẽ bị xóa cùng một tính năng, và những tính năng sẽ lỗi nếu thiếu nó. Dùng trước khi xóa hoặc thay đổi một tính năng.","help.timeline.play":"Phát lại lần lượt các tính năng còn lại, tạm dừng nửa giây sau mỗi lần dựng lại. Chạy lại lệnh này hoặc nhấn Escape để dừng; Đến cuối sẽ chuyển ngay đến cuối lịch sử.","help.view.apply":"Xoay khung nhìn về hướng chuẩn như trước, trên hoặc iso, hoặc về một góc nhìn đã lưu. Dùng để xem mô hình từ một góc cố định.","help.view.delete":"Xóa một góc nhìn đã lưu. Mô hình không bị thay đổi.","help.view.fit":"Phóng to và dịch khung nhìn để toàn bộ mô hình, hoặc phần đang chọn, lấp đầy khung nhìn. Dùng khi mô hình đã trôi ra khỏi tầm mắt.","help.view.grid":"Hiện hoặc ẩn lưới trong khung nhìn. Dùng làm thước tham chiếu kích thước và hướng khi dựng mô hình.","help.view.ground_shadow":"Hiện hoặc ẩn bóng của mô hình trên mặt sàn. Dùng để đánh giá độ cao và vị trí dễ hơn.","help.view.home":"Đưa khung nhìn về hướng mặc định và vừa khít mô hình. Dùng để quay lại nhanh một góc nhìn quen thuộc.","help.view.list":"Liệt kê các góc nhìn đã lưu trong thiết kế. Dùng để tìm góc nhìn bạn đã lưu trước đó.","help.view.navigate":"Xoay, dịch hoặc thu phóng khung nhìn theo từng bước, chẳng hạn xoay một phần tư vòng sang trái. Dùng để điều khiển camera chính xác thay vì kéo chuột.","help.view.navigation_bar":"Hiện hoặc ẩn thanh điều hướng ở cuối khung nhìn. Ẩn đi để có thêm chỗ, hiện ra để dùng các công cụ xem bằng chuột.","help.view.rename":"Đặt tên mới cho một góc nhìn đã lưu. Bản thân góc nhìn không đổi.","help.view.save":"Lưu vị trí camera hiện tại thành một góc nhìn có tên trong thiết kế. Dùng để quay lại đúng góc đó sau này, chẳng hạn khi chụp ảnh màn hình.","help.view.spin":"Quay khung nhìn quanh mô hình liên tục cho đến cú nhấp hoặc phím tiếp theo. Dùng để trình bày mô hình từ mọi phía.","help.view.tool":"Giữ cố định một công cụ camera (xoay quanh, dịch hoặc thu phóng) để kéo bằng nút chuột trái sẽ di chuyển khung nhìn cho đến khi bạn tắt nó. Dùng trên bàn di chuột hoặc khi không có nút chuột giữa.","help.view.visual_style":"Đổi cách vẽ mô hình: tô bóng có hoặc không có cạnh, khung dây, hoặc hiện cạnh khuất. Dùng khung dây để nhìn vào bên trong, tô bóng để có hình ảnh gọn gàng.","history.sketch_under_constrained":"Thiếu ràng buộc ({count} bậc tự do)","history.sketch_under_constrained_one":"Thiếu ràng buộc ({count} bậc tự do)","hole_presets.confirm_delete":"Xác nhận xóa","hole_presets.delete":"Xóa","hole_presets.delete_prompt":"Xóa mẫu thiết lập sẵn cá nhân này? Các lỗ ren/khoan hiện có sẽ không thay đổi.","hole_presets.full":"Thư viện cá nhân đã chứa tối đa 64 mẫu thiết lập sẵn.","hole_presets.invalid_name":"Nhập một tên ngắn gọn, không chứa ký tự xuống dòng hoặc ký tự điều khiển.","hole_presets.invalid_parameters":"Hoàn tất các tham số lỗ bằng các biểu thức hợp lệ với độ dài hợp lý.","hole_presets.missing":"Mẫu thiết lập sẵn đã chọn không còn khả dụng.","hole_presets.name":"Tên mẫu thiết lập sẵn","hole_presets.name_exists":"Mẫu thiết lập sẵn với tên này đã tồn tại. Vui lòng sử dụng tên khác.","hole_presets.name_hint":"Tên duy nhất","hole_presets.overwrite":"Lưu các thay đổi vào mẫu thiết lập sẵn đã chọn","hole_presets.preset":"Mẫu thiết lập sẵn","hole_presets.recall":"Tải lại","hole_presets.rename":"Đổi tên","hole_presets.save":"Lưu mới","hole_presets.scope":"Được lưu trong hồ sơ cá nhân của bạn cho tất cả dự án.","hole_presets.select":"Chọn một mẫu thiết lập sẵn","hole_presets.title":"Mẫu thiết lập sẵn cá nhân","hole_presets.unsupported_options":"Mẫu thiết lập sẵn này sử dụng các tùy chọn ren mà phiên bản hiện tại không hỗ trợ tải lại.","hole_presets.unsupported_overwrite":"Mẫu thiết lập sẵn này chứa các tùy chọn không thể ghi đè an toàn.","home.back":"Quay lại {name}","home.crashes":"Báo cáo sự cố","home.design_workspace":"Thiết kế","home.documentation":"Tài liệu hướng dẫn","home.export":"Xuất","home.export_hint":"Chọn định dạng cho thiết kế hiện tại.","home.export_json_hint":"Thiết kế có thể chỉnh sửa và lịch sử lệnh","home.export_mesh_hint":"Lưới để in hoặc chia sẻ","home.export_step_hint":"Hình học khối chính xác","home.import":"Nhập…","home.import_hint":"Nhập STEP, IGES hoặc lưới vào thiết kế mới","home.in_this_browser":"trong trình duyệt này","home.missing":"thiếu","home.month_01":"thg 1","home.month_02":"thg 2","home.month_03":"thg 3","home.month_04":"thg 4","home.month_05":"thg 5","home.month_06":"thg 6","home.month_07":"thg 7","home.month_08":"thg 8","home.month_09":"thg 9","home.month_10":"thg 10","home.month_11":"thg 11","home.month_12":"thg 12","home.new_inches":"Thiết kế mới theo inch","home.new_inches_hint":"Inch · mở trong Thiết kế","home.new_mm":"Thiết kế mới","home.new_mm_hint":"Milimét · mở trong Thiết kế","home.open":"Mở…","home.open_hint":"Một thiết kế .sc ({shortcut})","home.open_now":"Mở ngay","home.opened_days_ago":"{count} ngày trước","home.opened_hours_ago":"{count} giờ trước","home.opened_just_now":"Vừa xong","home.opened_minutes_ago":"{count} phút trước","home.opening":"đang mở…","home.properties":"Thuộc tính thiết kế","home.recent":"Gần đây","home.recent_empty":"Các thiết kế bạn mở hoặc lưu sẽ xuất hiện ở đây.","home.recovery_count":"Thiết kế có thể khôi phục: {count}","home.recovery_empty":"Không có thiết kế nào có thể khôi phục.","home.recovery_hint":"SolidCraft đã đóng trước khi các thiết kế này được lưu.","home.report_issue":"Báo cáo sự cố","home.samples":"Mẫu thiết kế","home.settings":"Cài đặt","home.short_date":"{day} {month}","home.shortcuts":"Phím tắt","home.start_hint":"Tạo thiết kế, mở tệp gần đây hoặc khám phá mẫu.","home.whats_new":"Có gì mới","home.yesterday":"Hôm qua","install.button_tip":"Cài đặt SolidCraft dưới dạng ứng dụng: mở trong cửa sổ riêng và hoạt động ngoại tuyến","install.dock_1":"Chọn Tệp › Thêm vào Dock.","install.dock_2":"Nhấp vào Thêm.","install.dock_after":"SolidCraft sau đó sẽ mở trong cửa sổ riêng từ thanh Dock và hoạt động ngoại tuyến.","install.done":"Hoàn tất","install.home_screen_1":"Chạm vào Chia sẻ (trong menu … nếu không có trên thanh công cụ).","install.home_screen_2":"Chọn Thêm vào Màn hình chính.","install.home_screen_3":"Chạm vào Thêm.","install.home_screen_after":"SolidCraft sau đó sẽ mở từ biểu tượng trên Màn hình chính, không có thanh công cụ của Safari và hoạt động ngoại tuyến.","install.menu":"Cài đặt ứng dụng…","install.steps_intro":"Safari cài đặt ứng dụng web từ menu của chính nó:","install.title":"Cài đặt SolidCraft","issue.body_label":"Nội dung báo cáo","issue.note_changed_while_waiting":"Cài đặt hoặc mô hình đã thay đổi trong lúc chờ bản xem trước. Hãy chụp lại màn hình để cập nhật chi tiết kỹ thuật cho góc nhìn hiện tại.","issue.note_details_kept":"Đã chụp ảnh màn hình trên máy. Chi tiết kỹ thuật bạn đã chỉnh sửa được giữ lại: hãy kiểm tra xem chúng còn khớp với góc nhìn hiện tại không.","issue.note_details_updated":"Chi tiết kỹ thuật đã được cập nhật theo góc nhìn hiện tại. Đã chụp ảnh màn hình trên máy. Hãy xem lại trước khi đính kèm trên GitHub.","issue.note_image_copied":"Hãy dán hình ảnh vào bản nháp GitHub, hoặc lưu tệp PNG nếu không thể sao chép hình ảnh.","issue.note_opened":"Hãy xem lại bản nháp GitHub và đính kèm ảnh chụp màn hình. Nút Submit new issue của GitHub sẽ đăng bản nháp.","issue.note_opened_copied":"Đã sao chép báo cáo. Hãy dán vào bản nháp GitHub, đính kèm ảnh chụp màn hình, rồi nhấp Submit new issue trên GitHub.","issue.note_removed":"Đã xóa ảnh chụp màn hình khỏi bản nháp này.","issue.note_report_copied":"Đã sao chép báo cáo. Hãy dán vào bản nháp GitHub nếu cần.","issue.note_save_failed":"Không thể lưu ảnh chụp màn hình: {error}","issue.note_saved":"Đã lưu ảnh chụp màn hình. Hãy đính kèm tệp PNG vào bản nháp GitHub.","issue.save_screenshot":"Lưu ảnh chụp màn hình…","joint.from_bodies_hint":"Mỗi thân khối được chọn sẽ được chuyển thành một cụm chi tiết mới riêng biệt và giữ nguyên vị trí hiện tại.","joint.one_body":"Cả hai điểm chọn đều nằm trên {body}. Vui lòng chọn điểm thứ hai trên chi tiết khác.","joint.one_component":"Các chi tiết này thuộc cùng một cụm chi tiết: {bodies}. Khớp nối điều khiển một cụm chi tiết so với cụm chi tiết khác, vì vậy mỗi chi tiết cần một cụm chi tiết riêng.","joint.rigid_group_one_component":"Tất cả {count} thân khối này đều nằm trong cùng một cụm chi tiết (hoặc trong chính thiết kế): hãy dùng lệnh {command} trước.","joint.rigid_group_select_components":"Chọn từ hai cụm chi tiết trở lên.","joint_move.blocked_hint":"Kiểm tra loại khớp nối (chẳng hạn khớp nối cố định), trạng thái cố định của chi tiết, giới hạn khớp nối và các giá trị do tham số điều khiển.","joint_move.blocked_title":"Không thể di chuyển chi tiết này","joint_move.coarse":"Bước xoay khi ở gần trục (°)","joint_move.distance":"Quãng đường từ vị trí bắt đầu","joint_move.done":"Xong","joint_move.fine":"Bước xoay khi ở xa trục (°)","joint_move.fixed":"Chi tiết này không có trục khớp nối nào có thể di chuyển.","joint_move.help":"Di chuyển — kéo mũi tên hoặc cung tròn. Nhấn Esc để hủy thao tác kéo hiện tại.","joint_move.legacy_hint":"Tắt để sử dụng bảng Di chuyển trước đây.","joint_move.precision":"Kéo ra ngoài đường dẫn nét đứt để tinh chỉnh góc xoay.","joint_move.rotation":"Góc xoay từ vị trí bắt đầu","joint_move.select":"Chọn một mặt hoặc một chi tiết trong cụm lắp ráp, rồi chọn Di chuyển.","joint_move.settings":"Di chuyển trong cụm lắp ráp","joint_move.step":"Bước","joint_move.use_handles":"Dùng tay nắm chuyển động khớp nối khi di chuyển trong cụm lắp ráp","keymap.command_id":"Mã lệnh","keymap.empty":"Không có lệnh phù hợp","keymap.use_anyway":"Vẫn dùng {key} tại đây","label.move_to_left_side":"Chuyển sang bên trái","label.move_to_right_side":"Chuyển sang bên phải","manage.appearance_hint":"Chọn một kiểu hiển thị cho phần đã chọn, hoặc kéo một mẫu màu thả lên thân khối hay bề mặt.","manage.assign_hint":"Chọn các thân khối và chọn quy tắc thiết kế nhựa cho chúng.","manage.config_hint":"Sửa các hàng, cột và quy tắc cấu hình, rồi kích hoạt hoặc xem trước một hàng.","manage.empty":"Không có hàng phù hợp.","manage.material_hint":"Chọn các thân khối và chọn vật liệu vật lý cho chúng.","manage.parameters_hint":"Sửa biểu thức và đơn vị. Thay đổi được áp dụng khi nhấn Enter hoặc khi rời khỏi ô nhập.","manage.rules_hint":"Chọn một quy tắc để sửa, hoặc tạo quy tắc mới. Xác nhận để lưu quy tắc.","material.editor.add_property":"Thêm đặc tính","material.editor.add_source":"Thêm nguồn tham chiếu","material.editor.assigned_density":"Khối lượng riêng đã gán","material.editor.axes":"Trục vật liệu","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Bản sao của {name}","material.editor.density_range":"Khối lượng riêng đã gán phải lớn hơn 0 và tối đa 1000 g/cm³.","material.editor.designation":"Ký hiệu vật liệu","material.editor.duplicate":"Nhân bản","material.editor.engineering_card":"Thẻ đặc tính kỹ thuật","material.editor.family":"Nhóm vật liệu","material.editor.glass":"Thủy tinh","material.editor.illustrative":"Minh họa","material.editor.invalid_property":"Loại đặc tính không được hỗ trợ.","material.editor.isotropic":"Đẳng hướng","material.editor.measurement":"Đo lường","material.editor.metal":"Kim loại","material.editor.moisture":"Độ ẩm (trên cơ sở khô)","material.editor.name_required":"Nhập tên từ 1–128 ký tự.","material.editor.no_draft":"Không có bản nháp vật liệu nào đang mở.","material.editor.number_required":"Nhập một giá trị số hữu hạn.","material.editor.orthotropic":"Trực giao đẳng hướng","material.editor.other":"Khác","material.editor.polymer":"Polyme","material.editor.preserved_appearance":"Bề mặt hiển thị giữ lại","material.editor.public_reference":"Tài liệu tham khảo công khai","material.editor.reference":"Tham khảo","material.editor.save_or_discard":"Lưu hoặc hủy bản nháp vật liệu trước khi gán vật liệu.","material.editor.saved":"Đã lưu vật liệu. Gán vật liệu cho khối không đổi.","material.editor.scope":"Lưu sẽ lưu trữ vật liệu này mà không gán cho khối. Các thuộc tính và điều kiện để trống vẫn chưa xác định. Khối lượng riêng trên thẻ không làm thay đổi khối lượng riêng hay khối lượng đã gán.","material.editor.source_id":"Mã nguồn","material.editor.source_kind":"Loại nguồn","material.editor.source_title":"Tiêu đề nguồn","material.editor.sources":"Nguồn tham chiếu","material.editor.stale":"Vật liệu này đã thay đổi trong khi bản nháp đang mở. Hãy hủy và mở lại trước khi lưu.","material.editor.state":"Trạng thái vật liệu","material.editor.strain_rate":"Tốc độ biến dạng","material.editor.symmetry":"Đối xứng đàn hồi","material.editor.temperature":"Nhiệt độ","material.editor.unknown_card":"Chưa xác định đặc tính kỹ thuật. Có thể chỉ lưu khối lượng riêng đã gán và diện mạo hiện có.","material.editor.user_supplied":"Người dùng cung cấp","material.editor.wood":"Gỗ","material.selection.choose":"Chọn vật liệu","material.selection.mixed":"Các vật liệu khác nhau","measure.at":"Tại","measure.item":"Mục {number}","measure.quick_copied":"Đã sao chép số đo","measure.quick_copy":"Nhấp để sao chép số đo","measure.quick_edges":"{count} cạnh","measure.quick_faces":"{count} mặt","messages.ago_h":"{n} giờ trước","messages.ago_min":"{n} phút trước","messages.ago_s":"{n} giây trước","messages.chip_hint":"Nhấp để xem tất cả thông báo của phiên này","messages.clear":"Xóa","messages.copy_all":"Sao chép tất cả","messages.menu":"Thông báo…","messages.none":"Chưa có thông báo nào.","messages.title":"Thông báo","motion.checked_to":"Chỉ kiểm tra đến bước {step}: đã hết giới hạn tác vụ","motion.collision":"{a} · {b}: bước {steps}","motion.delete_key":"Xóa khóa","motion.duration_hint":"giây (để trống: theo từng bước)","motion.key_here":"Đặt khóa tại đây","motion.key_here_hint":"Thêm một khóa tại bước này với giá trị hiện tại của khớp nối","motion.no_collisions":"Không có va chạm trong suốt quá trình khảo sát","motion.plot_quantity":"Số lượng","motion.step_back":"Lùi một bước","motion.step_forward":"Tiến một bước","motion.to_end":"Đến cuối","motion.to_start":"Về đầu","motion.track_name":"Rãnh {number}","nav.alias.help":"Shift+Alt+kéo chuột trái để xoay, Shift+Alt+chuột giữa để trượt, Shift+Alt+chuột phải để thu phóng; kéo chuột giữa cũng trượt và kéo chuột phải xoay","nav.blender.help":"Kéo chuột giữa để xoay, Shift+chuột giữa để trượt, Ctrl+chuột giữa để thu phóng; kéo chuột phải giữ nguyên camera","nav.free_orbit.help":"Chuột và chuột 3D xoay tự do qua cả hai cực và giữ nguyên độ lăn nghiêng (Roll). Bắt dính trục bằng phím Shift sẽ bị tắt.","nav.free_orbit.label":"Xoay góc nhìn tự do","nav.free_orbit.snap_help":"Chuột và chuột 3D xoay qua cả hai cực và giữ nguyên góc nghiêng cuộn. Giữ Shift trong khi kéo xoay quỹ đạo để bắt dính hướng nhìn và góc nghiêng cuộn.","nav.free_orbit_upright.help":"Kéo chuột sang ngang sẽ xoay mô hình quanh trục thẳng đứng của không gian; kéo lên và xuống sẽ nghiêng qua đỉnh mà không bị giới hạn.","nav.free_orbit_upright.label":"Xoay quanh trục thẳng đứng","nav.fusion.help":"Kéo chuột giữa để trượt, Shift + chuột giữa để xoay, kéo chuột phải để xoay","nav.hfss.help":"Alt+kéo chuột trái để trượt, Shift+Alt+chuột trái để thu phóng, Ctrl+kéo chuột trái từ vùng trống để xoay","nav.inventor.help":"Kéo chuột giữa để trượt, Shift + chuột giữa để xoay, Ctrl + chuột giữa để thu phóng, kéo chuột phải để xoay","nav.maya.help":"Alt+kéo chuột trái để xoay, Alt+chuột giữa để trượt, Alt+chuột phải để thu phóng; kéo chuột giữa cũng trượt","nav.nx.help":"Kéo chuột giữa để xoay, Shift+chuột giữa để kéo ngang (NX: giữa + phải), Ctrl+chuột giữa để thu phóng (NX: giữa + trái); kéo chuột phải không di chuyển camera","nav.openscad.help":"Kéo chuột trái trên vùng trống để xoay, Shift + chuột trái để quét chọn vùng, kéo hình học phác thảo để chỉnh sửa; kéo chuột phải hoặc chuột giữa để trượt, Shift + kéo chuột phải hoặc chuột giữa để thu phóng","nav.perspective.sketch":"Chế độ chỉnh sửa phác thảo sử dụng góc nhìn trực giao. Hãy hoàn tất phác thảo để chuyển sang góc nhìn phối cảnh.","nav.right_drag_orbits.help":"Tắt: kéo chuột phải không di chuyển camera, và nút phải chỉ mở menu ngữ cảnh. Chọn kiểu chuột SolidWorks sẽ tắt tùy chọn này.","nav.right_drag_orbits.label":"Kéo chuột phải để xoay","nav.solidworks.help":"Kéo chuột giữa để xoay, Ctrl + chuột giữa để trượt, Shift + chuột giữa để thu phóng, kéo chuột phải để xoay","nav.tinkercad.help":"Kéo chuột phải để xoay, kéo chuột giữa hoặc Shift + kéo chuột phải để trượt","nav.touchpad.help":"Giữ Shift và di chuyển con trỏ để dời góc nhìn; giữ Alt/Option và di chuyển để xoay quanh tâm. Không cần nhấn nút chuột. Cuộn dọc để thu phóng.","nav.touchpad.label":"Bàn di chuột (Touchpad)","nav.touchpad.orbit":"Xoay quanh tâm (giữ Alt/Option và di chuyển; không cần nhấn chuột)","nav.touchpad.pan":"Dời góc nhìn (giữ Shift và di chuyển; không cần nhấn chuột)","nav.touchpad.scroll":"Bàn rê cảm ứng dùng thao tác cuộn dọc để thu phóng. Cài đặt dời góc nhìn bằng hai ngón tay được giữ cho các cấu hình khác.","nav.touchpad.zoom":"Thu phóng (cuộn dọc hoặc chụm ngón tay)","navbar.agent_chat":"Bảng trò chuyện của trợ lý","navbar.agent_cursor":"Hiện con trỏ tác tử","navbar.ambient_occlusion":"Đổ bóng che khuất môi trường (AO)","navbar.assistant":"Trợ lý","navbar.custom.add_slot":"Thêm {slot}","navbar.custom.always":"Luôn hiện","navbar.custom.available":"{available} · kéo vào thanh hoặc nhấn Thêm","navbar.custom.buttons":"Nút","navbar.custom.compact":"Gọn","navbar.custom.count":"{count}/16 ô","navbar.custom.customise":"Tùy chỉnh thanh điều hướng…","navbar.custom.design":"Thiết kế","navbar.custom.duplicate":"Ô này đã có trên thanh.","navbar.custom.edge":"Cạnh","navbar.custom.edge_bottom":"Dưới","navbar.custom.edge_top":"Trên","navbar.custom.fade":"Mờ dần","navbar.custom.full":"Hãy xóa một ô để thêm ô khác.","navbar.custom.hidden_design":"Ẩn trong Thiết kế","navbar.custom.hidden_render":"Ẩn trong Kết xuất","navbar.custom.hide":"Ẩn thanh điều hướng","navbar.custom.hide_idle":"Ẩn cho đến khi rê chuột","navbar.custom.icon_only":"Chỉ biểu tượng","navbar.custom.icon_value":"Biểu tượng và giá trị","navbar.custom.icons":"Biểu tượng","navbar.custom.idle":"Khi không dùng","navbar.custom.intro":"Chọn các điều khiển trên thanh ở cuối khung nhìn 3D và thứ tự của chúng. Kéo một ô để di chuyển, hoặc kéo ra khỏi thanh để xóa.","navbar.custom.labels":"Biểu tượng và nhãn","navbar.custom.left":"Chuyển sang trái","navbar.custom.position":"Vị trí","navbar.custom.position_centre":"Giữa","navbar.custom.position_left":"Trái","navbar.custom.position_right":"Phải","navbar.custom.preview_as":"Xem trước ở chế độ","navbar.custom.regular":"Thường","navbar.custom.remove":"Xóa","navbar.custom.remove_bar":"Xóa khỏi thanh","navbar.custom.render":"Kết xuất","navbar.custom.reset":"Đặt lại thanh điều hướng","navbar.custom.reset_default":"Đặt lại mặc định","navbar.custom.right":"Chuyển sang phải","navbar.custom.select":"Chưa chọn ô nào. Hãy chọn một ô trên thanh để di chuyển, xóa hoặc đổi cách hiển thị.","navbar.custom.separators_full":"Thanh đã có bốn dải phân cách.","navbar.custom.show":"Hiện thanh điều hướng","navbar.custom.shows":"Hiển thị","navbar.custom.size":"Kích thước","navbar.custom.stale":"Thanh đã thay đổi. Hãy chọn lại ô.","navbar.custom.title":"Thanh điều hướng","navbar.custom.unknown":"Ô này không khả dụng.","navbar.description.ambient_occlusion":"Làm tối các nếp gấp và góc để tạo chiều sâu.","navbar.description.display":"Chứa các cài đặt hiển thị: mẫu đồ họa, lưới, bóng đổ mặt sàn, đổ bóng che khuất môi trường và phép chiếu.","navbar.description.fit":"Đưa vùng chọn vào khung nhìn, hoặc toàn bộ mô hình nếu chưa chọn gì.","navbar.description.grid":"Hiện hoặc ẩn lưới mặt sàn.","navbar.description.ground_shadow":"Hiện hoặc ẩn bóng bên dưới mô hình.","navbar.description.home":"Quay về góc nhìn đẳng cự của toàn bộ mô hình.","navbar.description.look_at":"Xoay góc nhìn về phía mặt, mặt phẳng hoặc bản phác đang mở đã chọn.","navbar.description.orbit":"Xoay góc nhìn quanh mô hình.","navbar.description.pan":"Trượt góc nhìn sang ngang, lên hoặc xuống.","navbar.description.projection":"Chuyển giữa chế độ trực giao và phối cảnh.","navbar.description.separator":"Một đường mảnh nhóm các ô liền kề.","navbar.description.spin":"Giữ cho góc nhìn tiếp tục xoay cho đến khi bạn nhấp chuột hoặc nhấn phím.","navbar.description.visual_style":"Đổi cách vẽ mô hình: tô bóng, khung dây hoặc có cạnh ẩn.","navbar.description.zoom":"Đưa góc nhìn lại gần hoặc ra xa mô hình.","navbar.display":"Hiển thị","navbar.fit":"Vừa khung nhìn","navbar.graphics":"Đồ họa","navbar.grid":"Lưới tọa độ","navbar.ground_shadow":"Bóng đổ mặt sàn","navbar.home":"Góc nhìn chuẩn","navbar.later":"Sau","navbar.look_at":"Nhìn vào","navbar.more":"Thêm","navbar.orbit":"Xoay góc nhìn","navbar.orthographic":"Trực giao","navbar.pan":"Trượt góc nhìn","navbar.perspective":"Phối cảnh","navbar.preset":"Mẫu thiết lập sẵn","navbar.projection":"Phép chiếu","navbar.projection_heading":"Phép chiếu","navbar.separator":"Dải phân cách","navbar.show":"Hiển thị","navbar.spin":"Xoay liên tục","navbar.style.shaded":"Tô bóng","navbar.style.shaded_with_edges":"Tô bóng có cạnh","navbar.style.shaded_with_hidden_edges":"Tô bóng có cạnh ẩn","navbar.style.wireframe":"Khung dây","navbar.translucent":"Bán trong suốt","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Kiểu hiển thị trực quan","navbar.zoom":"Thu phóng","needs two joints":"cần hai khớp nối","network.allow_once":"Cho phép một lần","network.always_allow":"Luôn cho phép máy chủ này","network.prompt_detail":"Thiết kế này liên kết đến một tệp trên vị trí mạng {host}. Việc mở tệp sẽ kết nối đến máy tính đó và có thể gửi thông tin đăng nhập Windows của bạn. Chỉ cho phép các máy chủ bạn tin cậy.","network.prompt_title":"Vị trí mạng","new configuration":"cấu hình mới","new parameter":"tham số mới","no hole":"không có lỗ","no interference":"không có giao thoa","no joint that moves yet":"chưa có khớp nối nào có thể chuyển động","no motion study yet":"chưa có nghiên cứu chuyển động","no picture":"không có ảnh","no such joint":"không có khớp này","none":"không có","not a move":"không phải một phép di chuyển","not a number":"không phải là số","open a sketch first":"hãy mở một phác thảo trước","parameters.apply_live":"Áp dụng mỗi thay đổi khi rời khỏi ô của nó","parameters.apply_live_tip":"Tắt: các thay đổi chờ đến khi nhấn Áp dụng hoặc OK, rồi thiết kế được dựng lại một lần cho tất cả. Hủy hoặc Escape sẽ bỏ chúng.","parameters.held":"{count} thay đổi đang chờ Áp dụng","parameters.held_hint":"Sửa biểu thức và đơn vị. Thay đổi chờ đến khi nhấn Áp dụng hoặc OK.","parameters.held_one":"1 thay đổi đang chờ Áp dụng","parts.automatic_name":"tự động","parts.dimension.across_flats":"Cỡ cờ lê","parts.dimension.bore":"Đường kính lỗ","parts.dimension.d":"Đường kính danh nghĩa","parts.dimension.head_diameter":"Đường kính đầu","parts.dimension.head_height":"Chiều cao đầu","parts.dimension.height":"Chiều cao","parts.dimension.inner":"Đường kính trong","parts.dimension.outer":"Đường kính ngoài","parts.dimension.pitch":"Bước ren","parts.dimension.socket":"Cỡ lục giác","parts.dimension.socket_depth":"Độ sâu lục giác","parts.dimension.thickness":"Độ dày","parts.dimension.width":"Bề rộng","parts.family.bearing":"Ổ bi cầu rãnh sâu (bao ngoài)","parts.family.button_head_cap_screw":"Vít đầu tròn lục giác chìm","parts.family.dowel_pin":"Chốt trụ","parts.family.hex_bolt":"Bu lông đầu lục giác","parts.family.hex_nut":"Đai ốc lục giác","parts.family.set_screw":"Vít trí lục giác chìm, đầu bằng","parts.family.socket_head_cap_screw":"Bu lông lục giác chìm đầu trụ","parts.family.washer":"Vòng đệm phẳng","parts.holes":"Lỗ (tùy chọn)","parts.placement_hint":"chọn một hoặc nhiều lỗ để lắp một chi tiết vào mỗi lỗ, hoặc nhấn OK để đặt tại gốc tọa độ","pattern.alignment_2":"Căn chỉnh 2","pattern.alignment_hint":"Số lượng bao gồm cả bản gốc. Căn giữa sẽ cân bằng các bản sao; Đổi hướng sẽ chọn phía bổ sung cho tổng số chẵn.","pattern.direction_1":"Hướng 1","pattern.direction_2":"Hướng 2","pattern.flip_direction":"Đổi chiều hướng","perf.click_for_details":"Bấm để xem chi tiết: biểu đồ thời gian khung hình, biểu đồ tần suất và nội dung GPU đã vẽ","perf.draw_calls":"Lệnh vẽ (Draw calls)","perf.line_segments":"Đoạn thẳng","perf.low_1":"1% thấp nhất","perf.renderer":"Bộ kết xuất","perf.scene_build":"Dựng cảnh","perf.triangles":"Tam giác","perf.ui_time":"Thời gian giao diện","perf.viewport":"Khung nhìn","perf.worst":"Tệ nhất","pick a body or some of its faces":"chọn một thân hoặc một số mặt của thân","pick a hole to seat it, or OK places it at the origin":"chọn một lỗ để lắp đặt, hoặc nhấn OK để đặt tại gốc tọa độ","pick a planar face":"chọn một mặt phẳng","pick a plane or a face as the tool":"chọn một mặt phẳng hoặc một mặt làm dụng cụ","pick a size":"chọn một kích thước","pick edges of a body":"chọn các cạnh của một thân","pick edges of one body":"chọn các cạnh của cùng một thân","pick edges of the holes to remove":"chọn các cạnh của những lỗ cần loại bỏ","pick faces of one body":"chọn các mặt của cùng một thân","pick faces to offset":"chọn các mặt cần offset","pick lines of one sketch":"chọn các đường thẳng của cùng một phác thảo","pick one or two vertices, edges or faces":"chọn một hoặc hai đỉnh, cạnh hoặc bề mặt","pick one plane or face as the tool, or sketch curves":"chọn một mặt phẳng hoặc một mặt làm dụng cụ, hoặc chọn các đường cong phác thảo","pick sections in two or more sketches":"chọn các mặt cắt trong hai phác thảo trở lên","pick sketch curves or edges":"chọn các đường cong phác thảo hoặc các cạnh","pick the face to untrim":"chọn mặt cần hủy cắt tỉa","pick the path":"chọn đường dẫn","pick what to keep":"chọn phần cần giữ lại","pick what to keep of the other surface":"chọn phần cần giữ lại của bề mặt còn lại","prefs.add_item":"Thêm mục","prefs.alt_frees_manipulators":"Phím Alt / Option cũng giải phóng mũi tên thao tác","prefs.anti_aliasing_amd_dx12":"Khử răng cưa sử dụng mức 1× vì kiểm tra khởi động không vẽ được hình ảnh với đa lấy mẫu và đã vượt qua ở mức 1×. Bạn có thể chọn cài đặt khác ở trên; hãy khởi động lại để áp dụng nếu kiểm tra vượt qua.","prefs.anti_aliasing_note":"Làm mịn các cạnh răng cưa.","prefs.applies_on_restart":"Áp dụng sau khi khởi động lại","prefs.assistant":"Trợ lý","prefs.auto_operation":"Tự động chọn thao tác","prefs.auto_operation_note":"Cửa sổ tính năng chọn “Nối liền”, “Tạo mới Thân khối” hoặc “Cắt” theo những gì vật liệu mới chạm vào, cho đến khi bạn tự chọn. Tắt: cửa sổ giữ nguyên thao tác lúc mở.","prefs.axes":"Các trục tọa độ","prefs.axis":"Trục tọa độ","prefs.bodies_folders":"Thư mục thân khối","prefs.bodies_folders_always":"Luôn luôn","prefs.bodies_folders_never":"Không bao giờ","prefs.bodies_folders_several":"Chỉ khi có nhiều thân khối","prefs.bottom":"Dưới cùng","prefs.bottom_centre":"Giữa phía dưới","prefs.bottom_right":"Góc dưới bên phải","prefs.browser":"Cây thư mục","prefs.browser_eye_left":"Biểu tượng mắt cạnh mũi tên thu gọn","prefs.browser_eye_left_note":"Các hàng trong cây thư mục hiển thị biểu tượng mắt bật/tắt cạnh mũi tên thu gọn như trước đây, thay vì trong một cột ở đầu bên phải của các hàng.","prefs.browser_reveal_on_hover":"Hiện khi di chuột","prefs.browser_show_note":"Hiển thị giữ trình duyệt trên màn hình. Hiện khi di chuột ẩn nó cho đến khi con trỏ đến vị trí của nó hoặc thẻ mảnh ở cạnh trái, và nó vẫn mở khi con trỏ ở bên trong hoặc một menu của nó đang mở.","prefs.browser_shown":"Hiển thị","prefs.built_in":"Mặc định tích hợp","prefs.button_left":"Kéo chuột trái","prefs.button_middle":"Kéo chuột giữa","prefs.button_right":"Kéo chuột phải","prefs.choose_font":"Chọn tệp phông chữ…","prefs.click":"Nhấp chuột","prefs.contact_shading":"Đổ bóng tiếp xúc mềm","prefs.contact_shading_note":"Tạo bóng đổ mềm tại những vị trí các chi tiết tiếp giáp gần nhau.","prefs.context_menu":"Menu ngữ cảnh","prefs.context_menu_ring":"Menu ngữ cảnh · giữ để hiện menu tròn xoay","prefs.cpu":"CPU (phần mềm)","prefs.crash_reports":"Mở thư mục báo cáo sự cố…","prefs.crash_reports_note":"Báo cáo được lưu trên máy tính này, bao gồm tệp thiết kế và chuỗi lệnh giúp tái hiện sự cố.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Các mặt cong","prefs.curves":"Các đường cong","prefs.dark_parts_shading":"Giữ hình dạng của chi tiết tối","prefs.dark_parts_shading_help":"Tô bóng khung nhìn bằng ánh sáng tuyến tính với ánh sáng bầu trời dịu, để các mặt tối giữ được dải chuyển màu thay vì thành màu đen","prefs.dead_zone_note":"Dải sọc chéo là vùng chết: các chuyển động bên trong vùng này sẽ bị bỏ qua.","prefs.default":"mặc định","prefs.design":"Mặc định thiết kế","prefs.design_note":"Cài đặt khởi đầu cho các tệp thiết kế mới. Các thiết kế đang mở giữ nguyên cài đặt riêng của chúng.","prefs.devices":"Chuột 3D","prefs.dialog_buttons":"Nút hộp thoại","prefs.dialogs":"Hộp thoại","prefs.dialogs_edge":"Ở cạnh khung nhìn","prefs.dialogs_left_column":"Trong cột bên trái","prefs.dialogs_note":"Nơi hộp thoại lệnh mở ra: gắn ở cạnh khung nhìn, hoặc trong cột bên trái thay cho trình duyệt và Lịch sử, hai phần này trở lại như cũ khi hộp thoại đóng.","prefs.display":"Hiển thị","prefs.edges":"Cạnh và đổ bóng","prefs.extend":"Kéo dài","prefs.extra_navigation":"Ctrl + kéo chuột trái trên vùng trống để xoay; giữ phím Cách (Space) để trượt góc nhìn.","prefs.extrude_view_isometric":"Xoay sang góc nhìn trục đo khi mở Đùn khối","prefs.extrude_view_return":"Trở lại góc nhìn trước khi đóng Đùn khối","prefs.follows_os":"Theo hệ điều hành","prefs.font":"Phông chữ","prefs.font_fallback":"Các ký tự mà phông chữ đã chọn thiếu sẽ tự động dùng phông mặc định tích hợp, tránh tình trạng hiển thị ô vuông lỗi.","prefs.font_sample":"Kiểm tra phông chữ · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"Không thể đọc tệp phông chữ đã chọn.","prefs.general":"Cài đặt chung","prefs.general_note":"Ngôn ngữ, lưu tệp và cập nhật.","prefs.gesture_orbit":"Xoay góc nhìn","prefs.gesture_pan":"Trượt góc nhìn","prefs.gesture_zoom":"Thu phóng","prefs.graphics":"Đồ họa","prefs.graphics_card":"Card đồ họa","prefs.graphics_card_auto":"Tự động","prefs.graphics_card_missing":"Card đồ họa đã lưu không khả dụng; chế độ Tự động đang được sử dụng.","prefs.graphics_card_restart":"Có hiệu lực sau khi khởi động lại SolidCraft. Biến môi trường WGPU_ADAPTER_NAME sẽ ghi đè lựa chọn này.","prefs.graphics_card_unused":"Card đồ họa đã lưu không được dùng cho cửa sổ này; card đang dùng hiện trong Trợ giúp › Giới thiệu và trên dòng trạng thái. Thử Tự động, hoặc đặt WGPU_ADAPTER_NAME thành phần tên card mang tính duy nhất.","prefs.graphics_note":"Cân đối giữa tốc độ và độ mượt mà. Mỗi tùy chọn đều hiển thị hiệu ứng trực quan trên mẫu thử.","prefs.graphics_presets_note":"Các cấu hình định sẵn sẽ thiết lập đồng thời các tùy chọn bên dưới.","prefs.hide_constraint_glyphs_zoomed_out":"Ẩn biểu tượng ràng buộc khi thu nhỏ","prefs.hide_constraint_glyphs_zoomed_out_note":"Biểu tượng ràng buộc biến mất khi bản phác được thu nhỏ đủ xa để không làm rối khung nhìn. Tắt: chúng giữ kích thước màn hình cố định ở mọi mức thu phóng.","prefs.history":"Lịch sử","prefs.history_origin_bodies":"Hiển thị gốc tọa độ và thân khối ở trên cùng","prefs.history_origin_bodies_note":"Cây Lịch sử ở bên trái hoặc dưới cây thư mục sẽ bắt đầu với thư mục Thân khối và Gốc tọa độ của cụm chi tiết đang kích hoạt, cùng biểu tượng mắt bật/tắt và trình đơn tương tự như trong cây thư mục. Dòng Lịch sử ở cạnh dưới không thay đổi.","prefs.history_play_button":"Nút Phát lịch sử trong các điều khiển Lịch sử","prefs.history_play_button_note":"Thêm Phát lịch sử vào giữa Lùi một bước và Tiến một bước trong các điều khiển Lịch sử. Bạn cũng có thể nhấp chuột phải vào các điều khiển để hiện hoặc ẩn nút này.","prefs.history_sketches":"Phác thảo","prefs.history_sketches_in_order":"Theo thứ tự tạo","prefs.history_sketches_note":"Khi tùy chọn Phác thảo được đặt thành Dưới tính năng tương ứng, cây Lịch sử ở bên trái sẽ liệt kê mỗi phác thảo thụt vào một cấp dưới tính năng đầu tiên được tạo từ nó (khi khung đủ rộng để hiển thị tên). Dòng thời gian ở cạnh dưới luôn giữ nguyên thứ tự tạo.","prefs.history_sketches_under_feature":"Dưới tính năng tương ứng","prefs.hold_stop_snapping":"Giữ để tạm dừng bắt dính","prefs.home_fit_size":"Cỡ Home và Khớp","prefs.home_fit_size_note":"Mô hình chiếm bao nhiêu phần khung nhìn khi Home, Khớp, một thiết kế vừa mở hoặc đổi góc nhìn bằng khối điều hướng đưa nó vào khung hình, dù tùy chọn bên dưới bật hay tắt. 100 %: lấp đầy khung nhìn giữa các bảng, la bàn và thanh điều hướng.","prefs.icons_only":"Chỉ hiện biểu tượng","prefs.imported_file":"Tệp đã nhập","prefs.in_browser":"Trong cây thư mục","prefs.input":"Thiết bị nhập liệu","prefs.interface":"Giao diện","prefs.interface_language":"Ngôn ngữ giao diện","prefs.interface_note":"Diện mạo của SolidCraft và cách bố trí các bảng điều khiển.","prefs.interval_minutes":"{n} phút","prefs.invert_navigator_arrows":"Đảo ngược mũi tên xoay của khối điều hướng","prefs.invert_navigator_arrows_note":"Các mũi tên quanh khối xoay camera theo hướng mũi tên chỉ, như trong Fusion và Inventor: mũi tên bên trái chỉ sang phải và đưa camera sang phải. Khi tắt: mũi tên xoay khối về phía cạnh chứa nó, nên mũi tên bên trái đưa camera sang trái. Hai mũi tên cuộn cong không bị ảnh hưởng.","prefs.keep_work_on_tab_switch":"Giữ hộp thoại và công cụ mở khi chuyển giữa các thiết kế","prefs.keep_work_on_tab_switch_note":"Mỗi thẻ thiết kế giữ hộp thoại hoặc công cụ đang mở, cùng những gì bạn đã chọn và nhập trong đó, và thẻ thanh công cụ của nó. Chúng vẫn còn đó khi bạn quay lại thiết kế. Tắt: chuyển thiết kế sẽ hủy chúng và hiển thị thẻ Mô hình.","prefs.labels":"Nhãn chữ","prefs.language_system":"Hệ thống","prefs.layout":"Bố cục","prefs.layout_note":"Chế độ Gọn (Compact) gắn các bảng vào mép cửa sổ. Độ trong suốt của Cây thư mục chỉ khả dụng ở chế độ Nổi (Floating). Thay đổi vị trí của Trợ lý trong trang Trợ lý.","prefs.left":"Bên trái","prefs.left_click":"Nhấp chuột trái","prefs.line_drag_draws_one":"Nhấn và kéo vẽ một đường","prefs.line_drag_draws_one_note":"Trong công cụ Đường, nhấn, kéo rồi thả sẽ vẽ một đường từ điểm nhấn đến điểm thả, và kết thúc ở đó. Nhấp vẫn vẽ một chuỗi. Tắt: kéo đặt một điểm tại nơi thả, như một lần nhấp.","prefs.line_hover_tangent_arc":"Dừng trên điểm cuối của đường để chuyển sang cung tiếp tuyến","prefs.line_hover_tangent_arc_note":"Trong công cụ Đường, sau khi vẽ một đoạn, hãy rời điểm cuối của chuỗi, quay lại và giữ yên con trỏ trên đó: lần nhấp tiếp theo sẽ kết thúc một cung tiếp tuyến, và cùng thao tác đó sẽ quay lại đường thẳng. Tắt: dừng ở đó không có tác dụng.","prefs.linked_designs":"Thiết kế liên kết","prefs.live_input":"Nhập liệu trực tiếp","prefs.live_preview":"Xem trước trực tiếp","prefs.logo":"Logo","prefs.logo_accent":"Màu nhấn","prefs.logo_theme":"Màu của chủ đề","prefs.max_file_size":"Kích thước tệp tối đa để mở","prefs.max_file_size_design":"Tệp thiết kế","prefs.max_file_size_flag":"Lần chạy này bắt đầu với --max-file-size {size}, có hiệu lực đến khi đóng SolidCraft. Các cài đặt này áp dụng khi khởi động không có tùy chọn đó.","prefs.max_file_size_note":"Mặc định: 512 MB và 256 MB; tối đa 16 GB. Mở tệp cần lượng bộ nhớ gấp nhiều lần kích thước tệp. Thiết kế giữ dữ liệu nhập lớn có thể cần giới hạn tệp thiết kế cao hơn để lưu và mở lại.","prefs.max_file_size_step":"Tệp STEP và tệp nhập","prefs.max_file_size_web":"Ứng dụng web mở tệp STEP và tệp nhập tối đa 512 MB, thiết kế tối đa 256 MB: thẻ trình duyệt không chứa được tệp lớn hơn. Ứng dụng máy tính cho phép tăng các giới hạn này.","prefs.megabytes":"MB","prefs.menu_grid":"Biểu tượng lớn","prefs.menu_list":"Danh sách","prefs.menus":"Menu","prefs.minutes":"phút","prefs.minutes_suffix":" phút","prefs.mouse":"Chuột và bàn di cảm ứng","prefs.mouse_heading":"Chuột","prefs.mouse_mapping":"Gán chức năng chuột","prefs.navigation":"Điều hướng góc nhìn","prefs.navigation_note":"Cách chuột, bàn di cảm ứng và chuột 3D di chuyển góc nhìn.","prefs.navigator_fit":"Khớp mô hình sau khi đổi góc nhìn bằng khối điều hướng","prefs.navigator_fit_note":"Nhấp vào một mặt, góc hoặc mũi tên của khối lập phương, hoặc một trục của gizmo, cũng nhìn vào tâm mô hình từ một khoảng cách duy nhất chứa trọn nó từ mọi phía (khối cầu bao). Khi bật, góc nhìn chuẩn (Home) dùng cùng mức thu phóng và tâm đó, nên các góc nhìn chọn sau chỉ xoay. Tắt: góc nhìn xoay tại chỗ, giữ nguyên điểm nhìn và mức thu phóng.","prefs.network_host_remove":"Xóa","prefs.network_locations":"Cho phép các vị trí mạng trong thiết kế","prefs.network_locations_note":"Khi tắt: các tệp liên kết của thiết kế trên máy tính khác (\\\\server\\share) chỉ được mở từ các máy chủ được liệt kê tại đây, hoặc sau khi bạn đồng ý khi được hỏi.","prefs.network_locations_section":"Vị trí mạng","prefs.not_on_gpu":"GPU này không hỗ trợ","prefs.on":"Bật","prefs.opaque":"Đậm đặc (không trong suốt)","prefs.orbit_snap":"Giữ Shift khi xoay để bắt dính vào một trục tọa độ.","prefs.orientation":"Hướng nhìn","prefs.origin_plane_names":"Tên các mặt phẳng gốc","prefs.origin_plane_names_note":"Tên hiển thị trong trình duyệt, hộp thoại và danh sách. {top} là XY, {front} là XZ và {right} là YZ, với Z hướng lên. Lệnh, script và thiết kế đã lưu vẫn dùng XY, XZ và YZ.","prefs.overall_speed":"Tốc độ tổng thể","prefs.parameter_list_rows":"Số dòng danh sách tham số","prefs.parameter_list_rows_tip":"Phím mũi tên xuống trong ô giá trị trống liệt kê các tham số, mục yêu thích trước, tối đa số này. Ít hơn giúp danh sách nhẹ trong thiết kế lớn.","prefs.persistent_ribbon_pressed":"Tô sáng lệnh đang bật trên dải băng","prefs.persistent_ribbon_pressed_help":"Tô sáng các lệnh trên dải băng khi hiệu ứng của chúng đang bật. Tắt tùy chọn này để giữ giao diện trung tính và trợ giúp lệnh như trước.","prefs.perspective_fov":"Trường nhìn","prefs.placement":"Vị trí đặt","prefs.prefer_free_sketch_points":"Ưu tiên điểm phác thảo có thể di chuyển khi các điểm chồng lên nhau","prefs.preview_choices":"Xem trước các lựa chọn của bạn","prefs.print_face_highlight":"Tô sáng mặt in","prefs.print_face_highlight_tip":"Mức tô màu và viền mặt in của thân trong khung nhìn. 0 % không tô sáng.","prefs.profile_active":"Hồ sơ đang dùng","prefs.profile_applied":"Đã áp dụng hồ sơ.","prefs.profile_changed":"Cài đặt đã thay đổi kể từ khi lưu hồ sơ. “Lưu” sẽ ghi chúng vào hồ sơ.","prefs.profile_deleted":"Đã xóa hồ sơ.","prefs.profile_export":"Xuất tệp…","prefs.profile_exported":"Đã xuất hồ sơ.","prefs.profile_imported":"Đã nhập hồ sơ. Chọn hồ sơ trong “Hồ sơ đang dùng” để chuyển sang.","prefs.profile_name_hint":"Tên hồ sơ, ví dụ Laptop","prefs.profile_rename":"Đổi tên","prefs.profile_renamed":"Đã đổi tên hồ sơ.","prefs.profile_save":"Lưu","prefs.profile_saved":"Đã lưu cài đặt hiện tại vào hồ sơ.","prefs.profile_skipped":"Đã áp dụng hồ sơ; {n} cài đặt giữ nguyên giá trị hiện tại (xem nhật ký).","prefs.profiles":"Hồ sơ cài đặt","prefs.profiles_note":"Phím tắt, thanh công cụ, điều hướng, menu dạng vòng và cài đặt giao diện, được lưu cùng nhau dưới một tên và chuyển đổi cùng lúc.","prefs.project_options_dialog":"Hộp thoại tùy chọn Project","prefs.project_options_dialog_note":"Bật: chọn Hình học hoặc Thân và Liên kết chiếu trước khi chiếu. Tắt: giữ quy trình chọn trực tiếp trước đây.","prefs.quality_default":"mặc định","prefs.quality_fastest":"nhanh nhất","prefs.quality_slowest":"chậm nhất (chất lượng cao nhất)","prefs.quality_smoother":"mượt mà hơn","prefs.quick_measure":"Đo nhanh ở góc khung nhìn","prefs.quick_measure_note":"Hiển thị kích thước của đối tượng được chọn ở góc dưới bên phải khung nhìn, phía trên Lịch sử: chiều dài của cạnh (hoặc Ø và R với cạnh tròn), diện tích của mặt, vị trí của điểm, khoảng cách và góc giữa hai đối tượng, tổng của nhiều cạnh hoặc mặt. Nhấp để sao chép.","prefs.render_previous_geometry_budget":"Dùng ngân sách hình học trước đây cho bản xem trước kết xuất","prefs.render_previous_geometry_budget_help":"Khôi phục giới hạn hình học cố định trước đây (512 MiB trên máy tính 64 bit, 128 MiB trên các nền tảng khác) thay cho ngân sách dựa trên thiết bị.","prefs.reports_saved":"Đã lưu {n}","prefs.ribbon_click_ends_tool":"Nhấp vào nút của công cụ đang chạy sẽ kết thúc nó","prefs.ribbon_click_ends_tool_note":"Nhấp vào nút ruy-băng đang sáng của công cụ phác thảo đang dùng sẽ kết thúc công cụ, để các cú nhấp trong khung nhìn lại chọn đối tượng. Tắt: cú nhấp khởi động lại công cụ.","prefs.ribbon_reveal":"Hiện kết quả tìm kiếm trên ribbon","prefs.ribbon_reveal_note":"Khi rê chuột lên một kết quả trong Tìm lệnh, ribbon cho biết lệnh nằm ở đâu: tab, nút hoặc dòng của nó trong menu thả xuống của một bảng. Lệnh bắt đầu từ tìm kiếm sẽ nhấp nháy ở đó, và lệnh đang chạy từ menu thả xuống sẽ đánh dấu bảng của nó.","prefs.right_click":"Nhấp chuột phải","prefs.saving":"Tự động lưu và khôi phục","prefs.scale_note":"Cũng có thể dùng Ctrl + / Ctrl − trong cửa sổ. Các nút có kích thước 28 px ở mức 100%.","prefs.scale_text":"Tỉ lệ và văn bản","prefs.search":"Tìm kiếm cài đặt","prefs.search_empty":"Không có cài đặt nào khớp","prefs.select":"Chọn","prefs.select_one_item":"Chọn một mục","prefs.select_other_hidden":"Chọn hình học ẩn bằng Chọn đối tượng khác","prefs.select_other_hidden_help":"Bật: bao gồm các khối, bản phác thảo ẩn và cạnh bị che gần con trỏ. Tắt: dùng danh sách ban đầu chỉ gồm hình học đang hiển thị ngay dưới con trỏ.","prefs.selecting":"Đang chọn","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift chỉ thêm; Ctrl / Cmd đảo trạng thái chọn","prefs.shift_add_note":"Bật: Shift để thêm vào vùng chọn, Ctrl / Cmd để đảo chọn. Tắt (mặc định): cả hai đều đảo trạng thái chọn.","prefs.shortcuts":"Phím tắt","prefs.single_surface_analysis":"Chỉ dùng một phân tích bề mặt","prefs.single_surface_analysis_help":"Khi tắt, phân tích tô bóng bề mặt và phân tích tính liên tục có thể cùng hoạt động. Khi bật, chỉ giữ phân tích được bắt đầu hoặc thay đổi gần nhất.","prefs.sketch_align_points":"Căn theo các điểm phác thảo khác khi vẽ","prefs.sketch_align_points_note":"Khi vẽ, một điểm được căn ngang theo một điểm phác thảo và căn dọc theo điểm khác cùng lúc, kèm đường dẫn chấm; cú nhấp giữ cả hai ràng buộc căn. Tắt: chỉ căn theo điểm trước, mỗi lần một trục.","prefs.sketch_conflict_colour":"Hình học xung đột theo màu xung đột","prefs.sketch_conflict_colour_note":"Khi các ràng buộc của bản phác xung đột, các đường cong và điểm mà một ràng buộc lỗi giữ cũng được vẽ bằng màu xung đột, không chỉ ký hiệu hay kích thước của nó. Tắt: chúng giữ màu thường.","prefs.sketch_construction_lines":"Công cụ đường dựng hình mở rộng","prefs.sketch_exit_view":"Khi kết thúc phác thảo","prefs.sketch_exit_view.keep":"Giữ góc nhìn hiện tại","prefs.sketch_exit_view.previous":"Trở về góc nhìn trước đó","prefs.sketch_exit_view.unless_rotated":"Trở về góc nhìn trước trừ khi đã xoay","prefs.sketch_exit_view_note":"Góc nhìn sẽ chuyển đến đâu sau khi bấm Hoàn tất phác thảo, Hủy bỏ hoặc bấm phím Esc hai lần.","prefs.sketch_face_activates_part":"Phác thảo trên mặt của một chi tiết sẽ kích hoạt chi tiết đó","prefs.sketch_face_activates_part_note":"Bản phác thảo bắt đầu trên mặt của một khối thuộc thành phần khác sẽ kích hoạt thành phần đó trước, nên bản phác thảo thuộc về nó và nằm cùng chi tiết đó trong trình duyệt. Chi tiết vẫn được kích hoạt sau đó. Tắt: bản phác thảo thuộc thành phần đang hoạt động.","prefs.sketch_open_look_at":"Xoay góc nhìn trực diện phác thảo khi mở","prefs.sketch_open_look_at_note":"Tắt: tạo hoặc chỉnh sửa phác thảo sẽ giữ nguyên góc nhìn. Dùng Nhìn trực diện để nhìn thẳng vào phác thảo khi cần.","prefs.sketch_recent_snap":"Tự động bắt điểm vào tâm và trung điểm gần đây","prefs.sketch_recent_snap_note":"Khi vẽ, con trỏ được bắt vào nơi các đường dẫn của hai tâm đường tròn hoặc trung điểm cạnh thẳng gần nhất cắt nhau. Tắt: các đường dẫn chỉ để xem và con trỏ không di chuyển.","prefs.sketch_selection":"Phác thảo & chọn đối tượng","prefs.sketch_selection_heading":"Phác thảo và lựa chọn","prefs.sketch_selection_note":"Cách phác thảo bắt dính và cách nhấp chuột chọn đối tượng.","prefs.sketch_state_icons":"Biểu tượng bản phác theo màu trạng thái","prefs.sketch_state_icons_note":"Trong Lịch sử và trình duyệt, biểu tượng của bản phác lấy màu trạng thái của nó (thiếu ràng buộc, ràng buộc đủ hoặc xung đột) và chú thích nêu trạng thái. Tắt: mọi bản phác có cùng biểu tượng.","prefs.sketch_tab_always":"Luôn hiện thẻ Bản phác","prefs.sketch_tab_always_note":"Thẻ Bản phác vẫn nằm trên thanh công cụ, ngay sau Mô hình, khi không có bản phác nào đang mở. Khi đó các công cụ vẽ của nó bắt đầu một bản phác trên mặt phẳng hoặc mặt đã chọn, hoặc trên mặt phẳng bạn chọn tiếp theo, với công cụ sẵn sàng trong đó.","prefs.sketch_tracking_guides":"Đường căn chỉnh tâm và trung điểm","prefs.sketch_tracking_guides_note":"Di con trỏ lên tâm đường tròn hoặc trung điểm của cạnh thẳng, rồi di chuyển theo phương ngang hoặc dọc để hiển thị đường căn chỉnh nét đứt tạm thời.","prefs.sketch_tracking_points":"Đường căn chỉnh từ điểm đầu mút và góc khi vẽ","prefs.sketch_tracking_points_note":"Khi một công cụ vẽ đang chờ một điểm, di con trỏ lên đầu mút của đường thẳng hoặc cung, góc của hình chữ nhật hoặc một điểm tự do sẽ hiển thị đường căn chỉnh nét đứt tạm thời giống như ở tâm hoặc trung điểm. Tắt: chỉ tâm và trung điểm.","prefs.sketching":"Vẽ phác thảo","prefs.snap_drawing_note":"Khi đang vẽ hoặc kéo một điểm phác thảo.","prefs.source":"Nguồn","prefs.speed":"Tốc độ","prefs.stand_up_note":"Sau khi mở tệp STEP hoặc IGES với trục Z hướng lên, hỏi xem có muốn xoay một phần tư vòng quanh trục X không.","prefs.stand_up_unknown":"Với tệp từ chương trình không xác định","prefs.stand_up_unknown.ask":"Hỏi trong hộp thoại","prefs.stand_up_unknown.note":"Hiện ghi chú","prefs.stand_up_unknown.off":"Không gợi ý","prefs.stand_up_unknown_note":"Cách gợi ý khi phần đầu tệp không nêu chương trình nào được biết là lưu với trục Y hướng lên. Ghi chú chỉ hiện khi tệp có vẻ đang nằm ngửa; “Hỏi trong hộp thoại” sẽ hỏi với mọi tệp như vậy, như trước đây.","prefs.status_bar":"Thanh trạng thái","prefs.status_bar_note":"Một thanh mảnh dọc cạnh dưới cửa sổ hiển thị thứ đang được chỉnh sửa, trạng thái của bản phác đang mở theo màu của nó và đơn vị của thiết kế; nhấp vào đơn vị để đổi. Khi đó trạng thái bản phác không còn hiện ở góc khung nhìn.","prefs.status_done":"Hoàn thành","prefs.status_error":"Lỗi","prefs.status_selected":"Đã chọn","prefs.status_warning":"Cảnh báo","prefs.structure.appearance":"Giao diện","prefs.structure.appearance_note":"Màu sắc, văn bản và khả năng tiếp cận.","prefs.structure.in_profile":"Trong hồ sơ","prefs.structure.layout":"Bố cục","prefs.structure.layout_note":"Vị trí các phần của cửa sổ.","prefs.structure.look":"Hiển thị","prefs.structure.measure_pointer":"Đo lường và con trỏ","prefs.structure.mouse3d":"Chuột 3D","prefs.structure.mouse3d_note":"SpaceMouse và SpaceNavigator.","prefs.structure.navigation_note":"Chuột và bàn di chuột. Chuột 3D có trang riêng.","prefs.structure.profile":"Hồ sơ","prefs.structure.profile_edited":"Đã thay đổi kể từ lần lưu","prefs.structure.profile_hover":"Được lưu trong hồ sơ cài đặt","prefs.structure.scale_percent":"{percent}%","prefs.structure.sketch":"Phác thảo","prefs.structure.tools":"Công cụ","prefs.structure.tools_note":"Cách các công cụ dựng mô hình hoạt động.","prefs.structure.work":"Công việc","prefs.supersampling_brief":"Vẽ khung nhìn ở độ phân giải lớn hơn rồi lọc giảm tỷ lệ: rất sắc nét, nhưng tốn tài nguyên hơn.","prefs.tab_accent_note":"Màu nhấn theo tab đang kích hoạt","prefs.theme_file":"tệp chủ đề","prefs.theme_file_or_paste":"tệp hoặc dán","prefs.theme_follow":"Theo dõi tệp chủ đề","prefs.theme_follow_error":"Chưa áp dụng: {error}. Chủ đề hợp lệ gần nhất vẫn được giữ.","prefs.theme_follow_launch":"Chỉ theo dõi trong lần chạy này (--theme-file); tải lại mỗi khi công cụ khác ghi lại tệp.","prefs.theme_follow_note":"Tải lại mỗi khi công cụ khác ghi lại tệp. Chọn chủ đề sẽ dừng theo dõi.","prefs.theme_follow_off":"Tắt","prefs.theme_follow_stop":"Dừng theo dõi","prefs.theme_import_hint":"Nhấp để chọn tệp giao diện, thả tệp vào đây, hoặc nhấn Ctrl+V (Cmd+V trên Mac) khi đã sao chép một giao diện","prefs.theme_option_opacity":"Độ đục","prefs.theme_option_opacity_help":"Điều chỉnh độ đục của các bảng nổi. Giới hạn độ đục tối thiểu giúp văn bản luôn dễ đọc trên nền màu của khung nhìn.","prefs.theme_option_tab_colours":"Màu thẻ","prefs.theme_option_tab_colours_help":"Sử dụng màu bảng điều khiển và khung nhìn của chủ đề này cho từng thẻ trên dải băng.","prefs.theme_option_tab_fade_ms":"Chuyển đổi thẻ","prefs.theme_option_tab_fade_ms_help":"Chuyển dần màu của bảng điều khiển và khung nhìn khi đổi thẻ. Đặt thành 0 để chuyển ngay lập tức.","prefs.theme_options_badge":"Tùy chọn","prefs.theme_options_more":"Thêm · {count}","prefs.theme_options_reset":"Đặt lại","prefs.theme_options_unavailable":"Không khả dụng trên thiết bị này","prefs.theme_paste":"Dán giao diện","prefs.theme_paste_none":"Bộ nhớ tạm không chứa giao diện SolidCraft nào","prefs.timeline_half_hour":"−30 phút","prefs.timeline_now":"bây giờ","prefs.timeline_quarter_hour":"−15 phút","prefs.toast_place":"Thông báo","prefs.toggle_item":"Thêm mục, hoặc bỏ chọn lại","prefs.toolbar":"Thanh công cụ","prefs.toolbar_tabs":"Thẻ thanh công cụ","prefs.top":"Trên cùng","prefs.trackpad_zoom_modifier":"Thu phóng bằng cuộn hai ngón tay khi giữ","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Chỉ giữ phím này để thu phóng tại con trỏ bằng cuộn dọc. Tắt giữ nguyên hành vi cuộn hiện tại.","prefs.trackpad_zoom_modifier.off":"Tắt","prefs.translucent":"Bán trong suốt","prefs.under_browser":"Dưới cây thư mục","prefs.under_cursor":"Dưới con trỏ chuột","prefs.units_precision":"Đơn vị và độ chính xác","prefs.updates":"Cập nhật ứng dụng","prefs.value_boxes_in_view":"Hiện giá trị cạnh tay nắm trong khung nhìn","prefs.value_boxes_in_view_tip":"Giá trị của lệnh (Khoảng cách, Bán kính…) trong một ô cạnh tay nắm, phía trên mô hình. Tắt: bạn nhập giá trị trong cửa sổ lệnh, cửa sổ này nhận bàn phím sau khi chọn, và không có gì che mô hình.","prefs.view":"Hành vi góc nhìn","prefs.view_confirm_corner":"Nút Đồng ý và Hủy bỏ ở góc khung nhìn","prefs.view_confirm_corner_note":"Khi hộp thoại hoặc môi trường phác thảo đang mở, dấu tích và dấu chéo ở góc trên bên phải khung nhìn có chức năng tương tự nút Đồng ý và Hủy bỏ của hộp thoại, hoặc để hoàn tất và hủy phác thảo. Khối điều hướng góc nhìn sẽ dời xuống bên dưới chúng.","prefs.viewport":"Khung nhìn 3D","prefs.viewport_analysis_status":"Hiện trạng thái phân tích trong khung nhìn","prefs.viewport_analysis_status_help":"Hiện các phân tích đang bật phía trên khung nhìn và mở chú giải từ từng mục. Esc tắt phân tích mới nhất. Tắt tùy chọn để khôi phục chú giải ở góc và hành vi Esc trước đây.","prefs.viewport_background":"Nền","prefs.viewport_background_colour":"Màu","prefs.viewport_background_theme":"Dải màu của chủ đề","prefs.viewport_section_status":"Hiện trạng thái mặt cắt trong khung nhìn","prefs.viewport_section_status_help":"Hiện thiết lập mặt cắt trong khung nhìn. Escape và nút dải công cụ đang bật sẽ tắt mặt cắt. Tắt tùy chọn để giữ cách điều khiển mặt cắt trước đây.","prefs.viewport_status_details":"Chi tiết trực tiếp trong khung nhìn","prefs.viewport_status_details_help":"Chỉnh sửa thiết lập phân tích và mặt cắt đang hoạt động trong các thẻ chi tiết chuẩn. Tắt để khôi phục chú giải phân tích chỉ đọc và hộp thoại Mặt cắt.","prefs.viewport_status_summary":"Tóm tắt các mục trạng thái khung nhìn","prefs.viewport_status_summary_help":"Gộp từ ba mục trạng thái khung nhìn trở lên thành một huy hiệu tóm tắt. Tắt để giữ mọi mục trong hàng đầy đủ.","prefs.wheel":"Con lăn chuột","prefs.wheel_trackpad":"Con lăn chuột và bàn di cảm ứng","prefs.workspace":"Không gian làm việc","prefs.zoom_stop_at_model":"Dừng thu phóng tại mô hình","prefs.zoom_stop_at_model_tip":"Chuột 3D và ứng dụng thiết bị thu phóng về phía bề mặt ở giữa khung nhìn; thu phóng bằng cách kéo giữ nguyên điểm bắt đầu kéo. Khi tắt, có thể thu phóng xuyên qua mô hình. Con lăn và cử chỉ chụm dùng riêng tùy chọn Thu phóng về con trỏ","prefs.zoom_toward_cursor":"Thu phóng về phía con trỏ chuột","properties.title":"Thuộc tính: {name}","recovery.days_ago":"{count} ngày trước","recovery.detail":"{file} · {features} tính năng · tự động lưu {when}","recovery.discard_all":"Hủy bỏ tất cả","recovery.discard_all_detail":"Không thể hoàn tác thao tác này.","recovery.discard_all_title":"Hủy bỏ {count} bản tự động lưu?","recovery.discard_all_title_one":"Hủy bỏ 1 bản tự động lưu?","recovery.hours_ago":"{count} giờ trước","recovery.just_now":"vừa xong","recovery.min_ago":"{count} phút trước","recovery.never_saved":"chưa từng lưu","render.adaptive_absolute":"Ngưỡng lỗi RGB tuyệt đối","render.adaptive_coverage":"Mục tiêu lỗi độ phủ (Coverage error)","render.adaptive_enable":"Phân bổ mẫu bằng các mẫu thử độc lập","render.adaptive_help":"Chỉ dành cho GPU. Các mẫu thử độc lập sẽ bị loại bỏ, sau đó phân bổ tối thiểu 16 mẫu chính thức trên mỗi pixel cho đến khi đạt giới hạn mẫu. Phương sai RGB và độ phủ chỉ dùng để định hướng phân bổ; các đường truyền tia hiếm có thể bị bỏ sót và pixel đạt giới hạn vẫn có thể còn nhiễu. Báo cáo cuối cùng ghi nhận khối lượng tính toán thực tế. Không đảm bảo tuyệt đối về độ nhiễu hay thời gian.","render.adaptive_minimum":"Số mẫu chính thức tối thiểu","render.adaptive_pending":"GPU hỗ trợ phân bổ thích ứng qua mẫu thử độc lập và phân tầng Fresnel có điều kiện. Chưa hỗ trợ kiểm định hội tụ, đảm bảo sự kiện hiếm và truyền dẫn thích ứng trên CPU.","render.adaptive_pilots":"Số mẫu thử trên mỗi pixel","render.adaptive_relative":"Mục tiêu lỗi RGB tương đối","render.add_ground":"Thêm mặt sàn khớp vào thiết lập","render.advanced_material_scope":"Hỗ trợ một môi trường đồng nhất hữu hạn trên GPU với các giới hạn rõ ràng. Chưa hỗ trợ lưới mật độ, kết hợp thủy tinh/thể tích lồng nhau, bề mặt tán xạ dưới bề mặt, dịch chuyển hình học, truyền dẫn quang phổ và các khái niệm vật liệu nâng cao chưa gắn kết.","render.aging_add":"Thêm lớp lão hóa","render.aging_airborne":"Bụi lơ lửng / môi trường tham gia","render.aging_airborne_help":"Bụi lơ lửng là thể tích tán xạ đồng nhất hữu hạn riêng biệt. Nó thay đổi truyền dẫn ánh sáng và tệp EXR thô, không thuộc chồng lớp lão hóa bề mặt. Các giới hạn về thể tích/thủy tinh/khử nhiễu hiện có vẫn áp dụng; không tự động thêm khí quyển.","render.aging_all_bodies":"Tất cả các khối đục đủ điều kiện","render.aging_chips":"Bong tróc sơn","render.aging_class_any":"Tất cả các loại vật liệu đục","render.aging_class_dielectric":"Chỉ bề mặt phi kim loại","render.aging_class_metal":"Chỉ bề mặt kim loại","render.aging_color":"Màu lớp · sRGB","render.aging_coverage":"Độ phủ","render.aging_dust":"Bụi lắng đọng","render.aging_empty":"Không có lớp lão hóa: các bề mặt ban đầu được giữ nguyên.","render.aging_fading":"Lớp phủ bạc màu","render.aging_grime":"Cáu bẩn và vết ố","render.aging_help":"Kết hợp tối đa tám lớp quang học theo thứ tự. Rỉ sét và gỉ đồng là diện mạo được thiết kế thủ công, không phải mô phỏng ăn mòn/lão hóa vật lý. Tỷ lệ tính theo milimét thế giới thực. Không làm thay đổi hình học, khối lượng hay đặc tính kỹ thuật; loại trừ thủy tinh và sân khấu thụ động.","render.aging_metallic":"Tỷ lệ kim loại của lớp","render.aging_origin":"Gốc trường tọa độ · mm thế giới","render.aging_patina":"Gỉ đồng xanh (Patina)","render.aging_refresh_targets":"Kiểm tra các khối hiện tại","render.aging_roughness":"Độ nhám của lớp","render.aging_rust":"Sắt oxy hóa / rỉ sét","render.aging_scale":"Tỷ lệ hoa văn","render.aging_scratches":"Vết xước mảnh","render.aging_target":"Mục tiêu và tọa độ","render.aging_target_help":"Mục tiêu được chỉ định phải khớp với chỉ mục và tên khi ghi nhận. Mặt nạ toàn cục được neo vào tọa độ thế giới, không di chuyển theo chi tiết chuyển động. Đây không phải tính năng phát hiện hốc lõm hay mòn cạnh thực tế. Lọc danh sách để hiển thị thêm các khối khác.","render.aging_target_search":"Lọc tên khối","render.aging_upward":"Lắng đọng trên bề mặt hướng lên","render.all_controls_help":"Xem chi tiết toàn bộ các điều khiển hiện tại. Các trang chuyên mục cho phép chỉnh sửa tập trung mà không làm thay đổi yêu cầu cơ bản bên dưới.","render.all_shots_label":"Mọi cảnh chụp","render.appearance_editor.absorption":"Hấp thụ","render.appearance_editor.base_colour":"Màu cơ bản","render.appearance_editor.body_reason":"Liên kết quang học nhắm vào một thân hoàn chỉnh. Hãy chọn Thân để chỉnh các điều khiển này.","render.appearance_editor.boundary":"Biên","render.appearance_editor.box":"Hộp","render.appearance_editor.choose_image":"Chọn ảnh…","render.appearance_editor.closed":"Khối đặc kín","render.appearance_editor.coat":"Lớp phủ trong","render.appearance_editor.cpu_reason":"Cần dò tia bằng CPU.","render.appearance_editor.glass":"Kính và hấp thụ","render.appearance_editor.glass_enable":"Dùng kính vật lý trên thân này","render.appearance_editor.glass_note":"Kính kín dùng khoảng cách hình học. Không thể dùng chung thân với lớp phủ trong hoặc bản đồ.","render.appearance_editor.gpu_reason":"Cần dò đường đi của tia bằng GPU.","render.appearance_editor.ior":"Chiết suất","render.appearance_editor.maps":"Bản đồ","render.appearance_editor.normal":"Pháp tuyến","render.appearance_editor.normal_strength":"Cường độ pháp tuyến","render.appearance_editor.origin":"Gốc","render.appearance_editor.recipe":"Công thức","render.appearance_editor.reflection_sampling":"Lấy mẫu cho mọi thân phản chiếu","render.appearance_editor.reflections":"Phản xạ","render.appearance_editor.remove":"Gỡ bản đã lưu","render.appearance_editor.remove_note":"Gỡ thuộc tính quang học đã lưu khỏi cảnh chụp này. Hình học và diện mạo đã gán được giữ lại.","render.appearance_editor.remove_title":"Gỡ thuộc tính quang học đã lưu?","render.appearance_editor.replace":"Thay thuộc tính quang học đã lưu của thân này","render.appearance_editor.revalidate":"Kiểm tra lại thân này","render.appearance_editor.save":"Lưu các thuộc tính quang học này","render.appearance_editor.save_reason":"Lưu các thuộc tính quang học này cần kính vật lý trên một thân GPU hiện hành. Lớp phủ và bản đồ ảnh cục bộ vẫn tạm thời.","render.appearance_editor.saved":"Lưu cùng cảnh chụp này","render.appearance_editor.saved_state":"Các thuộc tính quang học này được lưu cùng cảnh chụp này.","render.appearance_editor.scatter_reason":"Tán xạ bên trong cần biên là khối đặc kín.","render.appearance_editor.temporary":"Các thuộc tính quang học này chỉ tạm thời trên tab này. Hãy lưu để giữ cùng cảnh chụp.","render.appearance_editor.thickness":"Độ dày","render.appearance_editor.thickness_reason":"Độ dày áp dụng cho tấm mỏng; kính kín dùng khoảng cách hình học.","render.appearance_editor.thin":"Tấm mỏng","render.appearance_editor.u_repeat":"Lặp U","render.appearance_editor.v_repeat":"Lặp V","render.appearance_editor.v_up":"Trục V của kết cấu hướng lên","render.appearance_editor.weight":"Trọng số","render.appearance_physics_separate":"Diện mạo thị giác không gán khối lượng riêng, dữ liệu nhiệt hay các đặc tính kỹ thuật khác.","render.appearances":"Diện mạo","render.assign_help":"Bấm để áp dụng cho vùng chọn; kéo để xem trước rồi thả, hoặc bấm khi chưa chọn gì để tô.","render.availability_native":"Tổ hợp gốc; hãy xem xét trước khi áp dụng","render.availability_projection":"Chiếu một phần được hỗ trợ; xem phạm vi và các mục lược bỏ","render.availability_reference":"Dữ liệu tham chiếu; không tự động gán","render.backdrop_alpha_conflict":"Hãy chọn phông nền này hoặc đầu ra PNG trong suốt; bộ kết xuất sẽ không âm thầm bỏ qua cài đặt nào.","render.backdrop_enable":"Sử dụng phông nền chuyển màu chỉ cho camera","render.backdrop_first":"Màu bắt đầu / màu tâm","render.backdrop_help":"Phông nền không gian màn hình này không phát sáng, không đổ bóng, không phản xạ và không đại diện cho địa hình. Nó bị loại khỏi tệp EXR thô. Hình học, ánh sáng và môi trường HDR luôn độc lập.","render.backdrop_horizontal":"Chuyển màu ngang","render.backdrop_radial":"Chuyển màu tỏa tròn","render.backdrop_radius":"Bán kính","render.backdrop_second":"Màu kết thúc / màu viền","render.backdrop_vertical":"Chuyển màu dọc","render.backdrop_x":"Tọa độ tâm X","render.backdrop_y":"Tọa độ tâm Y","render.background":"Hình nền khung cảnh","render.background_camera_section":"Nền camera · hiển thị PNG","render.background_completed_frozen":"Kết quả hiển thị là hình ảnh đã kết xuất hoàn tất cố định. Chỉnh sửa nền sẽ không tự động vẽ lại kết quả đó. Dùng 'Chỉnh màu lại' cho thay đổi camera, hoặc 'Kết xuất' cho sân khấu vật lý mới.","render.background_hdr_separate":"Tài nguyên HDR hiện tại dùng để chiếu sáng và phản xạ trên bề mặt; chúng không tự động hiển thị dưới dạng ảnh toàn cảnh phía sau chủ thể. Thay đổi dải chuyển màu không làm xoay hay đổi màu ánh sáng.","render.background_lighting_section":"Chiếu sáng HDR · độc lập với nền camera","render.background_no_alpha_override":"Nền camera không được âm thầm thêm vào đầu ra trong suốt. Chỉnh màu lại bản gốc thô sử dụng độ phủ đã ghi nhận và không chạy lại bộ khử nhiễu; tệp EXR nguồn giữ nguyên.","render.background_not_light":"Màu nền chỉ dùng cho hiển thị trình chiếu, không phải nguồn sáng bổ sung.","render.background_regrade":"Áp dụng cho bản gốc thô được giữ lại","render.background_stage_occlusion":"Khung hình này bao gồm hình học sân khấu vật lý. Mặt sàn hoặc tường lớn có thể lấp đầy khung hình và che khuất nền camera. Hãy xóa hoặc đổi kích thước sân khấu một cách chủ động, hoặc đổi độ phản xạ vật lý. Chỉnh màu lại không thể xóa bỏ hình học đã ghi nhận.","render.background_workflow":"Chọn nền bạn mong muốn: màu/chuyển màu chỉ cho camera, sân khấu vật lý tiếp nhận ánh sáng, hoặc chiếu sáng HDR. Chúng hoàn toàn độc lập. Xem trước trực tiếp là chế độ xem dựng hình; hãy kết xuất ảnh mới hoặc chỉnh màu lại bản gốc để thấy kết quả hoàn thiện của camera.","render.base_appearance":"Diện mạo khối có thể chỉnh sửa","render.base_apply":"Áp dụng diện mạo khối","render.base_apply_help":"Một thao tác gán diện mạo có thể hoàn tác cho khối chính xác đã chọn. Các diện mạo theo mặt riêng biệt và vật liệu kỹ thuật hiện có vẫn được giữ độc lập.","render.base_color":"Màu cơ sở · sRGB","render.base_metallic":"Tỷ lệ kim loại","render.base_opaque_only":"Trình chỉnh sửa này giữ nguyên ngữ nghĩa khối đục. Dùng các điều khiển thủy tinh riêng biệt để chỉnh độ truyền quang học.","render.bloom_enable":"Hiển thị lóe sáng (Bloom)","render.bloom_help":"Hiệu ứng phát sáng sáng tạo cho đầu ra từ các điểm nhấn tuyến tính dương, được khuếch tán qua ba lượt lọc chuẩn hóa. Bán kính tính theo pixel đầu ra. Được cộng vào ánh sáng tuyến tính hiển thị trước sRGB; không phải ống kính thực tế, hiệu ứng thể tích hay cải thiện hội tụ. Tệp EXR thô không đổi.","render.bloom_opaque":"Hiệu ứng lóe sáng yêu cầu đầu ra đục. PNG trong suốt sẽ bị từ chối chứ không âm thầm làm phẳng nền.","render.bloom_radius":"Bán kính lóe sáng","render.bloom_strength":"Cường độ lóe sáng","render.bloom_threshold":"Ngưỡng điểm sáng tuyến tính","render.browse_capabilities":"Kiểm tra toàn bộ danh mục tính năng","render.browse_environments":"Duyệt các môi trường HDR gốc","render.browse_looks":"Duyệt…","render.browse_native_scenes":"Duyệt các studio gốc","render.browse_physical":"Kiểm tra các tham chiếu vật lý","render.browse_quality":"Kiểm tra thông số chất lượng","render.browse_rigs":"Duyệt các bộ đèn chiếu sáng đã tạo","render.browse_scene_specs":"Duyệt thông số cảnh nâng cao","render.browse_surfaces":"Duyệt các bề mặt đã tạo","render.browser_library":"Thư viện","render.browser_model":"Mô hình","render.camera_distance":"Khoảng cách từ mắt đến mục tiêu","render.camera_exact_help":"Milimét thế giới; góc được hiển thị theo độ và lưu dưới dạng radian. Điều hướng sử dụng cùng camera với khung nhìn.","render.camera_fov":"Trường nhìn dọc (FOV)","render.camera_pitch":"Góc chúc ngẩng camera (Pitch)","render.camera_roll":"Góc nghiêng xoay camera (Roll)","render.camera_set":"Đặt camera kết xuất","render.camera_target":"Vị trí mục tiêu · mm","render.camera_yaw":"Góc quay ngang camera (Yaw)","render.category_metal":"Kim loại","render.category_paint":"Sơn","render.category_plastic":"Nhựa","render.category_wood":"Gỗ","render.check_opaque":"Độ trong suốt: chỉ bề mặt đục; hỗ trợ alpha của phông nền.","render.check_sorted_alpha":"Độ trong suốt: xấp xỉ alpha có sắp thứ tự.","render.check_transmission":"Độ trong suốt: truyền sáng vật lý.","render.children.absolute_floor":"Ngưỡng tuyệt đối","render.children.adaptive":"Thích ứng","render.children.add_look_reason":"Thêm một diện mạo để chỉnh trạng thái bật và cường độ của nó.","render.children.all_shots":"Mọi cảnh chụp","render.children.bloom":"Bloom","render.children.check":"Kiểm tra","render.children.check_now":"Kiểm tra ngay","render.children.chromatic":"Sắc sai","render.children.compact":"Gọn","render.children.contrast":"Tương phản","render.children.copy_image":"Sao chép","render.children.copy_job":"Sao chép JSON công việc","render.children.copy_request":"Sao chép JSON yêu cầu","render.children.coverage_error":"Sai số độ phủ","render.children.cpu":"Dò tia bằng CPU","render.children.denoise":"Giảm nhiễu trong ảnh hoàn chỉnh","render.children.depth":"Độ sâu đường đi","render.children.distortion":"Méo","render.children.edge_samples":"Mẫu cạnh","render.children.effects_banner":"Các hiệu ứng này cần dò đường đi của tia bằng GPU. Mở mục này không bao giờ đổi phương pháp.","render.children.enable_adaptive":"Bật các thử nghiệm độc lập để chỉnh giới hạn thích ứng.","render.children.enable_bloom":"Bật bloom để chỉnh cường độ, ngưỡng và bán kính.","render.children.finishing":"Hoàn thiện","render.children.flare":"Chói","render.children.fresnel":"Lớp Fresnel","render.children.ghosts":"Vòng bóng ma","render.children.glass":"Truyền sáng trong kính","render.children.go_to":"Đến {editor}","render.children.grain":"Hạt","render.children.halo":"Quầng","render.children.hdr":"HDR","render.children.keep_master":"Giữ bản gốc tuyến tính thô","render.children.last_result":"Gần nhất: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Hiệu ứng ống kính","render.children.look_summary":"{tone} · {count} diện mạo","render.children.looks":"Diện mạo sáng tạo","render.children.memory":"Bộ nhớ","render.children.method":"Phương pháp","render.children.minimum":"Tối thiểu","render.children.needs_cpu":"Cần dò tia bằng CPU. Mở mục này không bao giờ đổi phương pháp.","render.children.nested":"Điện môi lồng nhau đã chứng nhận","render.children.not_checked":"Chưa kiểm tra","render.children.path":"Dò đường đi của tia","render.children.pilots":"Mẫu thử","render.children.preview":"Dữ liệu xem trước","render.children.progressive_reason":"Chọn Lũy tiến để chỉnh số mẫu và hạt giống.","render.children.radius":"Bán kính","render.children.reflect_depth":"Độ sâu phản xạ","render.children.reflect_samples":"Số mẫu phản xạ","render.children.regrade":"Chỉnh lại màu","render.children.relative_error":"Sai số tương đối","render.children.render":"Kết xuất","render.children.render_shot":"Kết xuất cảnh chụp","render.children.renderer":"Bộ kết xuất","render.children.renderers":"Các bộ kết xuất","render.children.request":"Yêu cầu này","render.children.reset_finishing":"Đặt lại hoàn thiện","render.children.review_quality":"Xem lại đặc tả chất lượng…","render.children.rgb_gain":"Độ lợi RGB","render.children.samples":"Số mẫu","render.children.sampling":"Lấy mẫu","render.children.saturation":"Bão hòa","render.children.scene_summary":"{bodies} thân · {triangles} tam giác","render.children.seed":"Hạt giống","render.children.sharpening":"Làm nét","render.children.single_image":"Một ảnh","render.children.soft_focus":"Nét mềm","render.children.streak":"Vệt sáng","render.children.strength":"Cường độ","render.children.studio":"Studio","render.children.threshold":"Ngưỡng","render.children.tone":"Tông màu","render.children.under_hood":"Bên trong","render.children.vignette":"Tối góc","render.children.workstation":"Máy trạm","render.choose_look":"Hãy chọn một diện mạo trong Diện mạo trước","render.chromatic_offset":"Độ lệch sắc sai viền","render.clear_stage":"Xóa sân khấu đã lưu","render.copy_request":"Sao chép JSON","render.cpu_aa_help":"Số mẫu không gian: tăng số mẫu giúp cạnh mượt hơn nhưng tăng thời gian kết xuất.","render.cpu_area_add":"Thêm nguồn sáng vùng chữ nhật CPU","render.cpu_area_editor":"Nguồn sáng vùng chữ nhật CPU","render.cpu_area_editor_help":"Véc-tơ cạnh đầy đủ tính theo milimét; tích có hướng U × V hướng về phía phát sáng. Khác với véc-tơ nửa cạnh trên GPU.","render.cpu_area_full_u":"Cạnh U đầy đủ · mm","render.cpu_area_full_v":"Cạnh V đầy đủ · mm","render.cpu_area_samples":"Số mẫu nguồn sáng vùng","render.cpu_binding_confirm":"Xác nhận khối này","render.cpu_binding_stale":"Khung cảnh đã thay đổi. Hãy xác nhận lại mục tiêu phản xạ này trước khi kết xuất.","render.cpu_body_choose":"Chọn một khối","render.cpu_body_filter":"Lọc khối theo tên","render.cpu_body_filter_more":"Thu hẹp bộ lọc để xem thêm các khối.","render.cpu_body_missing":"Mục tiêu phản xạ bị thiếu, bị ẩn, không rõ ràng hoặc tên dài hơn 128 byte. Hãy chọn lại.","render.cpu_budget":"Cấu hình tài nguyên CPU","render.cpu_budget_bodies":"Trần số lượng khối","render.cpu_budget_compact":"Gọn nhẹ (giới hạn cũ)","render.cpu_budget_details":"Giới hạn tài nguyên","render.cpu_budget_help":"Chủ động chọn giới hạn lớn hơn. Độ phân giải và số mẫu không bao giờ tự động bị giảm.","render.cpu_budget_memory":"Trần bộ nhớ tác vụ","render.cpu_budget_not_guarantee":"Đây là trần chấp nhận tài nguyên, không phải cam kết cấp phát RAM hay đảm bảo tốc độ. Hình học, đệm ảnh và bản xem trước được giữ sẻ chia ngân sách bộ nhớ; kết xuất vẫn có thể hủy bỏ.","render.cpu_budget_resize":"Bản nháp vượt quá cấu hình CPU hoặc định mức mẫu camera này. Hãy chủ động chấp nhận kích thước nhỏ hơn hoặc chọn cấu hình lớn hơn.","render.cpu_budget_studio":"Studio (ảnh lớn)","render.cpu_budget_triangles":"Trần số tam giác","render.cpu_budget_workstation":"Máy trạm (cảnh nặng)","render.cpu_captured_hdr":"HDR đã ghi nhận cho hình ảnh này","render.cpu_check_capture_help":"Kiểm tra và Bắt đầu sẽ xác minh cùng mã băm tệp hoặc dùng HDR nhúng. Mỗi ảnh giữ nguyên nguồn dữ liệu đã ghi nhận.","render.cpu_check_changed":"Các cài đặt hoặc mô hình đã thay đổi sau lần kiểm tra này. Hãy kiểm tra lại trước khi kết xuất.","render.cpu_constant_help":"Suất bức xạ không đổi tác dụng lên tia phản xạ hoặc tia truyền qua. Nó không cung cấp ánh sáng khuếch tán trực tiếp.","render.cpu_custom_directions":"Thay thế thiết lập sẵn bằng nguồn sáng định hướng tùy chỉnh","render.cpu_direction":"Hướng về phía nguồn sáng (X, Y, Z)","render.cpu_directional":"Nguồn sáng định hướng","render.cpu_directional_add":"Thêm nguồn sáng định hướng","render.cpu_environment":"Môi trường CPU","render.cpu_environment_background":"Hình nền được giữ tách biệt với ánh sáng môi trường.","render.cpu_environment_bounds":"Cường độ CPU phải từ 0–64, góc xoay HDR hữu hạn trong khoảng ±1.000.000 radian, và số mẫu HDR là 1, 4, 16 hoặc 64.","render.cpu_environment_constant":"Môi trường tia thứ cấp không đổi","render.cpu_environment_none":"Không có môi trường CPU","render.cpu_environment_samples":"Số mẫu ánh sáng HDR","render.cpu_exposure_help":"Độ phơi sáng CPU phải từ −16 đến 16 EV. Độ phơi sáng GPU nằm ngoài khoảng này sẽ được giữ lại cho đến khi bạn thay đổi.","render.cpu_fixed":"Hình ảnh đơn","render.cpu_hdr_help":"Định dạng Radiance .hdr, toàn cảnh 2:1, tối đa 2048 × 1024 và 16 MiB. CPU yêu cầu tệp công bố rõ các màu cơ bản sRGB/D65; các màu cơ bản chưa xác định và tệp EXR sẽ bị từ chối.","render.cpu_hdr_reflection_help":"Phản xạ nhám HDR yêu cầu bề mặt khối và bề mặt mặt hoàn toàn bằng kim loại. Lệnh kiểm tra sẽ báo cáo các kết hợp không được hỗ trợ.","render.cpu_key_rim":"Nguồn sáng chính và sáng ven (Key & Rim)","render.cpu_last_check":"Lần kiểm tra CPU gần nhất","render.cpu_light_help":"Tối đa tám nguồn sáng định hướng. Danh sách tùy chỉnh trống sẽ tắt nguồn sáng; chọn thiết lập sẵn sẽ khôi phục các đèn tương ứng. Màu sắc ở dạng RGB tuyến tính và cường độ là giá trị tương đối, không phải Oát.","render.cpu_light_intensity":"Cường độ tương đối (0–64)","render.cpu_light_minimum":"Khoảng cách tối thiểu để suy giảm","render.cpu_light_position":"Vị trí trong tọa độ thế giới (X, Y, Z)","render.cpu_light_reference":"Khoảng cách tham chiếu cho cường độ","render.cpu_light_remove":"Xóa nguồn sáng","render.cpu_lighting":"Thiết lập sẵn chiếu sáng","render.cpu_lights":"Nguồn sáng CPU","render.cpu_linear_color":"Màu tuyến tính (R, G, B)","render.cpu_neutral":"Trung tính","render.cpu_opaque_required":"Dò tia trên CPU yêu cầu nền đục. Hãy bỏ chọn 'Nền trong suốt' để tiếp tục.","render.cpu_options_pending":"Bảng điều khiển CPU này chưa hỗ trợ chỉnh sửa tự phát xạ, hiệu ứng bề mặt, thủy tinh hoặc bất đẳng hướng. Hãy xóa các tùy chọn API đó trước khi sử dụng.","render.cpu_point":"Nguồn sáng điểm","render.cpu_point_add":"Thêm nguồn sáng điểm","render.cpu_point_help":"Tối đa tám nguồn sáng điểm, được bổ sung vào ánh sáng định hướng đã chọn. Khoảng cách tính bằng mm; khoảng cách tối thiểu không được vượt quá khoảng cách tham chiếu.","render.cpu_primary_samples":"Số mẫu cạnh trên mỗi pixel","render.cpu_progressive":"Kết xuất lũy tiến trên CPU","render.cpu_progressive_help":"Tích lũy bộ tích phân CPU hiện có theo từng lượt một mẫu chính. Các phản xạ đã chọn yêu cầu một mẫu; nguồn sáng vùng, chất điện môi và bất đẳng hướng yêu cầu chế độ 'Hình ảnh đơn'.","render.cpu_progressive_limits":"Tối đa 1.048.576 pixel và tổng số tính toán (pixel × mẫu) không quá 16.777.216. Thay đổi số mẫu không bao giờ tự động đổi kích thước ảnh.","render.cpu_progressive_seed":"Hạt giống lấy mẫu CPU","render.cpu_progressive_spp":"Mẫu trên mỗi pixel","render.cpu_reflection_add":"Thêm phản xạ nhám","render.cpu_reflection_depth":"Độ sâu phản xạ (1–8)","render.cpu_reflection_empty":"Chưa chọn khối nào: phản xạ khung cảnh đang tắt.","render.cpu_reflection_help":"Chọn khối và đặt Tắt, Gương hoặc Nhám. Nhám sử dụng độ nhám bề mặt đã gán. Tăng số mẫu và số lần nảy tia sẽ tăng thời gian; đây là truyền dẫn phản xạ gương hữu hạn, không phải chiếu sáng toàn cục.","render.cpu_reflection_limit":"Hỗ trợ tối đa 64 khối phản xạ.","render.cpu_reflection_mirror":"Gương","render.cpu_reflection_off":"Tắt","render.cpu_reflection_rough":"Nhám","render.cpu_reflection_samples":"Số mẫu phản xạ (1–64)","render.cpu_reflections":"Phản xạ CPU","render.cpu_runtime_help":"Cài đặt số của ánh sáng và môi trường được lưu cùng thiết lập. Phản xạ khối và tệp HDR vẫn là cài đặt tạm thời. Giá trị nguồn sáng vùng và góc côn nguồn sáng tụ hiện có được giữ lại.","render.cpu_sampling_mode":"Chế độ lấy mẫu CPU","render.cpu_shadows":"Đổ bóng","render.cpu_summary":"Dò tia CPU · phản xạ · HDR · nguồn sáng định hướng và điểm","render.cpu_warm_cool":"Ấm và lạnh","render.diag_bodies":"Số khối hiển thị","render.diag_job_details":"Chi tiết tác vụ đã ghi nhận","render.diag_last_check":"Lần kiểm tra sơ bộ gần nhất","render.diag_memory":"Ước tính tiếp nhận bộ nhớ logic","render.diag_not_implemented":"Ranh giới tính năng rõ ràng","render.diag_preflight_details":"Chi tiết kiểm tra sơ bộ","render.diag_request":"Yêu cầu chính xác hiện tại","render.diag_triangles":"Số tam giác","render.discard_continue":"Hủy bản nháp và tiếp tục","render.draft_confirm_help":"Bản nháp kết xuất hiện tại có các chỉnh sửa chưa được áp dụng. Hãy lưu trước khi chuyển, hủy bỏ dứt khoát hoặc tiếp tục chỉnh sửa.","render.draft_confirm_title":"Giữ lại cài đặt kết xuất đã chỉnh sửa","render.effects_gpu_only":"Các hiệu ứng này yêu cầu dò đường truyền tia trên GPU (Path Tracing). Chuyển trang không bao giờ tự động đổi bộ kết xuất.","render.effects_help":"Kết hợp các phong cách màu sắc có thứ tự và hiệu ứng ống kính không gian ảnh. Kết xuất và chỉnh màu lại bản gốc thô dùng chung các cài đặt đã lưu. Tệp EXR thô giữ nguyên. Đây là các điều khiển nghệ thuật độc lập, không phải mô phỏng ống kính hiệu chuẩn hay phim có thương hiệu.","render.effects_reset_lens":"Đặt lại hiệu ứng ống kính","render.effects_seed":"Hạt giống hoa văn","render.emitted_axis":"Trục phát","render.env_advanced":"Nâng cao","render.env_backdrop":"Phông nền","render.env_backdrop_pending":"Bộ kết xuất chưa hỗ trợ hiển thị môi trường và làm mờ phông nền.","render.env_blur":"Làm mờ","render.env_change":"Đổi","render.env_choose_source":"Hãy chọn môi trường trong Studio và môi trường trước khi chỉnh ánh sáng.","render.env_clear":"Xóa","render.env_colour":"Màu","render.env_environments":"Môi trường","render.env_ground":"Mặt đất","render.env_ground_pending":"Mặt đất vật lý nhận bóng như một bề mặt khuếch tán hữu hạn. Chưa hỗ trợ chỉ bắt bóng và phản chiếu mặt đất.","render.env_intensity":"Cường độ","render.env_invalid_edit":"Chỉnh môi trường không hợp lệ.","render.env_physical_ground":"Mặt đất vật lý","render.env_preview_help":"Mẫu hình cầu minh họa; không phải bản xem trước của môi trường đã chọn.","render.env_reflection":"Phản chiếu","render.env_ring_help":"Kéo vòng để xoay ánh sáng. Giữ Shift để bám theo bước 15°.","render.env_rotate":"Xoay","render.env_set":"Đặt môi trường kết xuất","render.env_shadow_catcher":"Bắt bóng","render.env_show_environment":"Hiện môi trường","render.env_source":"Nguồn","render.env_stage_details":"Chỉnh mặt đất cần dò tia và một tấm mặt đất duy nhất. Dùng Cảnh để chỉnh các tấm sân khấu khác.","render.env_studios":"Studio","render.environment.albedo":"Albedo","render.environment.atmosphere":"Khí quyển","render.environment.backdrop_note":"Phông nền chỉ máy ảnh nhìn thấy. Nó không chiếu sáng, không đổ bóng, không phản chiếu, và bị từ chối với đầu ra trong suốt.","render.environment.blur_pending":"Làm mờ không khả dụng: bộ kết xuất chưa có cài đặt làm mờ phông nền.","render.environment.builtin":"HDR có sẵn","render.environment.check":"Kiểm tra tệp","render.environment.checked":"Đã kiểm tra tệp HDR. Khi lưu sẽ nhúng các byte này.","render.environment.choose":"Chọn HDR…","render.environment.constant":"Hằng","render.environment.cyclorama":"Cyclorama","render.environment.embedded":"Lưu trong thiết kế này","render.environment.end":"Kết thúc","render.environment.extinction":"Tắt dần","render.environment.file":"Tệp","render.environment.fit":"Khớp và lưu mặt đất","render.environment.floor_wall":"Sàn và tường","render.environment.gap":"Khe hở","render.environment.gradient":"Chuyển sắc","render.environment.gradient_gpu":"Phông nền chuyển sắc cần dò đường đi của tia bằng GPU.","render.environment.ground":"Mặt đất và sân khấu","render.environment.hdr":"HDR","render.environment.hdr_file":"Tệp HDR","render.environment.horizon":"Đường chân trời","render.environment.horizontal":"Ngang","render.environment.keep":"Giữ","render.environment.lighting_samples":"Mẫu chiếu sáng","render.environment.margin":"Lề phạm vi","render.environment.max":"Biên lớn nhất","render.environment.medium":"Môi trường tham gia","render.environment.min":"Biên nhỏ nhất","render.environment.mode":"Chế độ","render.environment.needs_gpu":"Cần dò đường đi của tia bằng GPU.","render.environment.none":"Không","render.environment.orientation":"Hướng và cường độ","render.environment.phase":"Pha","render.environment.primaries":"Coi màu cơ sở không xác định là sRGB tuyến tính","render.environment.primaries_gpu":"Diễn giải màu cơ sở không xác định cần dò đường đi của tia bằng GPU.","render.environment.radial":"Tỏa tròn","render.environment.radial_only":"Tâm và bán kính chỉ áp dụng cho chế độ Tỏa tròn.","render.environment.reflectance":"Độ phản xạ","render.environment.remove":"Gỡ sân khấu","render.environment.remove_confirm":"Gỡ sân khấu đã lưu?","render.environment.remove_note":"Gỡ {count} tấm thụ động khỏi cảnh chụp này. Phông nền máy ảnh vẫn giữ.","render.environment.replace":"Xác nhận thay sân khấu hiện có","render.environment.rotation_hdr":"Xoay cần nguồn HDR để dò tia trên CPU.","render.environment.samples_cpu":"Số mẫu chiếu sáng do ngân sách dò đường đi của tia bằng GPU quyết định; cài đặt này cần dò tia bằng CPU.","render.environment.saved_panels":"Tấm đã lưu {count}"