","render.error_job_action":"nejde o akci interaktivní úlohy obrázku","render.error_job_identity":"neplatná identita úlohy renderu: {error}","render.error_library_reply":"neplatná odpověď knihovny renderu","render.error_material_binding":"chybí vazba materiálu","render.error_no_completed_image":"render nemá žádný dokončený obrázek","render.error_no_geometry":"žádná geometrie produktu","render.error_no_scene":"žádná scéna produktu","render.error_opacity":"neplatná neprůhlednost vzhledu produktu","render.error_pbr_opacity":"neprůhledné PBR vyžaduje neprůhlednost 1","render.error_physical_glass":"vybraný recept není fyzikální sklo","render.error_preview_device":"náhled produktu vyžaduje nainstalované zařízení s hloubkovou vyrovnávací pamětí","render.error_product_triangle":"neplatný trojúhelník produktu","render.error_provisional_identity":"neplatná prozatímní identita renderu nebo počet vzorků","render.error_quality_bounds":"projekce kvality překračuje nativní meze","render.error_quality_method":"projekce kvality vyžaduje stejnou výslovnou metodu GPU","render.error_quality_projection":"neplatná nativní projekce kvality","render.error_regrade_identity":"neplatná identita nové korekce barev: {error}","render.error_scene_bodies":"chybí tělesa scény renderu","render.error_scene_body_limit":"scéna renderu překračuje limit těles","render.error_scene_identity":"neplatná identita scény renderu","render.error_setup_panicked":"inicializace trasování cest GPU selhala (panic)","render.error_setup_stopped":"pracovní vlákno inicializace skončilo, aniž by vrátilo hostitele","render.error_setup_worker":"nelze spustit pracovní vlákno inicializace: {error}","render.error_source_preview":"náhled zdroje překračuje svůj bajtový limit","render.error_surface_normals":"PBR vyžaduje nenulové normály povrchu","render.error_surface_reply":"neplatná odpověď o vytvořeném povrchu","render.error_triangle_bound":"náhled produktu překračuje zdrojový limit osmi milionů trojúhelníků","render.error_tria