ar.more":"Lagi","navbar.orbit":"Orbit","navbar.orthographic":"Ortografik","navbar.pan":"Sorot","navbar.perspective":"Perspektif","navbar.preset":"Pratetap","navbar.projection":"Unjuran","navbar.projection_heading":"Unjuran","navbar.separator":"Pemisah","navbar.show":"Papar","navbar.spin":"Pusing","navbar.style.shaded":"Berlorek","navbar.style.shaded_with_edges":"Berlorek dengan tepi","navbar.style.shaded_with_hidden_edges":"Berlorek dengan tepi tersembunyi","navbar.style.wireframe":"Rangka dawai","navbar.translucent":"Lut sinar","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Gaya visual","navbar.zoom":"Zum","needs two joints":"memerlukan dua sendi","network.allow_once":"Benarkan sekali","network.always_allow":"Sentiasa benarkan pelayan ini","network.prompt_detail":"Reka bentuk ini memaut ke fail pada lokasi rangkaian {host}. Membukanya akan menyambung ke komputer itu dan mungkin menghantar log masuk Windows anda kepadanya. Benarkan hanya pelayan yang anda percayai.","network.prompt_title":"Lokasi rangkaian","new configuration":"konfigurasi baharu","new parameter":"parameter baharu","no hole":"tiada lubang","no interference":"tiada pertindihan","no joint that moves yet":"belum ada sendi yang bergerak","no motion study yet":"belum ada kajian gerakan","no picture":"tiada gambar","no such joint":"tiada sendi sedemikian","none":"tiada","not a move":"bukan gerakan","not a number":"bukan nombor","open a sketch first":"buka lakaran dahulu","parameters.apply_live":"Gunakan setiap perubahan apabila anda meninggalkan medannya","parameters.apply_live_tip":"Mati: perubahan menunggu sehingga Gunakan atau OK, kemudian reka bentuk dibina semula sekali untuk semuanya. Batal atau Escape membuangnya.","parameters.held":"{count} perubahan menunggu Gunakan","parameters.held_hint":"Sunting ungkapan dan unit. Perubahan menunggu Gunakan atau OK.","parameters.held_one":"1 perubahan menunggu Gunakan","parts.automatic_name":"automatik","parts.dimension.across_flats":"Merentasi rata","parts.dimension.bore":"Diameter lubang","parts.dimension.d":"Diameter nominal","parts.dimension.head_diameter":"Diameter kepala","parts.dimension.head_height":"Ketinggian kepala","parts.dimension.height":"Ketinggian","parts.dimension.inner":"Diameter dalam","parts.dimension.outer":"Diameter luar","parts.dimension.pitch":"Pic","parts.dimension.socket":"Saiz soket","parts.dimension.socket_depth":"Kedalaman soket","parts.dimension.thickness":"Ketebalan","parts.dimension.width":"Lebar","parts.family.bearing":"Galas bebola alur dalam (sampul)","parts.family.button_head_cap_screw":"Skru kepala butang","parts.family.dowel_pin":"Pin selari (dowel)","parts.family.hex_bolt":"Bolt / skru kepala heks","parts.family.hex_nut":"Nat heks","parts.family.set_screw":"Skru penetap soket heks, hujung rata","parts.family.socket_head_cap_screw":"Skru kepala soket","parts.family.washer":"Sesendal biasa","parts.holes":"Lubang (pilihan)","parts.placement_hint":"pilih satu atau lebih lubang untuk meletakkan bahagian pada setiap satu, atau tekan OK untuk meletakkannya di titik asal","pattern.alignment_2":"Penjajaran 2","pattern.alignment_hint":"Bilangan termasuk asal. Tengah seimbangkan salinan; Balik pilih sisi lebih untuk bilangan genap.","pattern.direction_1":"Arah 1","pattern.direction_2":"Arah 2","pattern.flip_direction":"Balikkan arah","perf.click_for_details":"Klik untuk butiran: graf masa bingkai, histogram dan apa yang dilukis oleh GPU","perf.draw_calls":"Panggilan lukis","perf.line_segments":"Segmen garis","perf.low_1":"Rendah 1%","perf.renderer":"Enjin Render","perf.scene_build":"Pembinaan adegan","perf.triangles":"Segi tiga","perf.ui_time":"Masa UI","perf.viewport":"Tetingkap pandang","perf.worst":"terburuk","pick a body or some of its faces":"pilih jasad atau beberapa mukanya","pick a hole to seat it, or OK places it at the origin":"pilih lubang, atau tekan OK untuk letak di titik asal","pick a planar face":"pilih muka satah","pick a plane or a face as the tool":"pilih satah atau muka sebagai alat","pick a size":"pilih saiz","pick edges of a body":"pilih tepi sesebuah jasad","pick edges of one body":"pilih tepi satu jasad","pick edges of the holes to remove":"pilih tepi lubang yang hendak dibuang","pick faces of one body":"pilih muka satu jasad","pick faces to offset":"pilih muka untuk diofset","pick lines of one sketch":"pilih garis daripada satu lakaran","pick one or two vertices, edges or faces":"pilih satu atau dua bucu, tepi atau muka","pick one plane or face as the tool, or sketch curves":"pilih satu satah atau muka sebagai alat, atau lengkung lakaran","pick sections in two or more sketches":"pilih keratan dalam dua atau lebih lakaran","pick sketch curves or edges":"pilih lengkung lakaran atau tepi","pick the face to untrim":"pilih muka untuk dinyahpangkas","pick the path":"pilih laluan","pick what to keep":"pilih apa yang hendak dikekalkan","pick what to keep of the other surface":"pilih apa yang hendak dikekalkan pada permukaan yang satu lagi","prefs.add_item":"Tambah item","prefs.alt_frees_manipulators":"Alt / Option turut membebaskan anak panah manipulator","prefs.anti_aliasing_amd_dx12":"Anti-aliasing menggunakan 1× kerana semakan permulaan tidak melukis apa-apa dengan multisampel dan lulus pada 1×. Anda boleh memilih tetapan lain di atas; mulakan semula untuk menggunakannya jika semakan itu lulus.","prefs.anti_aliasing_note":"Melicinkan tepi bergerigi.","prefs.applies_on_restart":"Berkuat kuasa selepas dimulakan semula","prefs.assistant":"Pembantu","prefs.auto_operation":"Pilih operasi secara automatik","prefs.auto_operation_note":"Tetingkap ciri memilih Cantum, Jasad Baharu atau Potong berdasarkan apa yang disentuh oleh bahan baharu, sehingga anda memilih satu. Mati: ia mengekalkan operasi yang dibukanya.","prefs.axes":"Paksi","prefs.axis":"Paksi","prefs.bodies_folders":"Folder jasad","prefs.bodies_folders_always":"Sentiasa","prefs.bodies_folders_never":"Tidak sekali","prefs.bodies_folders_several":"Hanya beberapa jasad","prefs.bottom":"Bawah","prefs.bottom_centre":"Bawah tengah","prefs.bottom_right":"Bawah kanan","prefs.browser":"Pelayar","prefs.browser_eye_left":"Ikon mata di sebelah anak panah kembang/ringkas","prefs.browser_eye_left_note":"Baris pelayar memaparkan ikon mata papar/sembunyi di sebelah anak panah kembang/ringkas, seperti sebelum ini, bukannya dalam lajur di hujung kanan baris.","prefs.browser_reveal_on_hover":"Muncul apabila dilalui kursor","prefs.browser_show_note":"Dipaparkan mengekalkan pelayar pada skrin. Muncul apabila dilalui kursor menyembunyikannya sehingga penuding berada di atas tempatnya atau tab nipis di tepi kirinya, dan ia kekal terbuka selagi penuding berada di dalamnya atau menu daripadanya terbuka.","prefs.browser_shown":"Dipaparkan","prefs.built_in":"Terbina dalam","prefs.button_left":"Seret kiri","prefs.button_middle":"Seret tengah","prefs.button_right":"Seret kanan","prefs.choose_font":"Pilih fail fon…","prefs.click":"Klik","prefs.contact_shading":"Lorekan sentuhan lembut","prefs.contact_shading_note":"Lorekan lembut di tempat bahagian saling menghampiri.","prefs.context_menu":"Menu konteks","prefs.context_menu_ring":"Menu konteks · tahan untuk menu jejarian","prefs.cpu":"CPU (perisian)","prefs.crash_reports":"Buka laporan ranap…","prefs.crash_reports_note":"Laporan disimpan pada komputer ini, bersama reka bentuk dan arahan yang menghasilkan semula masalah itu.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Permukaan melengkung","prefs.curves":"Permukaan melengkung","prefs.dead_zone_note":"Jalur berlorek ialah zon mati: gerakan di dalamnya diabaikan.","prefs.default":"lalai","prefs.design":"Lalai reka bentuk","prefs.design_note":"Apa yang digunakan oleh reka bentuk baharu semasa bermula. Reka bentuk yang dibuka mengekalkan tetapannya sendiri.","prefs.devices":"Tetikus 3D","prefs.dialog_buttons":"Butang dialog","prefs.dialogs":"Dialog","prefs.dialogs_edge":"Di tepi paparan","prefs.dialogs_left_column":"Dalam lajur kiri","prefs.dialogs_note":"Tempat dialog arahan dibuka: dilabuhkan di tepi pandangan, atau di lajur kiri menggantikan pelayar dan Sejarah, yang kembali seperti asal apabila dialog ditutup.","prefs.display":"Paparan","prefs.edges":"Tepi dan teduhan","prefs.extend":"Panjangkan","prefs.extra_navigation":"Seret kiri dengan Ctrl pada ruang kosong untuk mengorbit; tahan Space untuk menyorot.","prefs.follows_os":"Ikut OS","prefs.font":"Fon","prefs.font_fallback":"Glif yang tiada dalam fon pilihan akan beralih kepada fon terbina dalam, jadi tiada label yang memaparkan kotak kosong.","prefs.font_sample":"Sang kancil melompat pantas · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"Fon yang dipilih tidak dapat dibaca.","prefs.general":"Umum","prefs.general_note":"Bahasa, penyimpanan dan kemas kini.","prefs.gesture_orbit":"Orbit","prefs.gesture_pan":"Sorot","prefs.gesture_zoom":"Zum","prefs.graphics":"Grafik","prefs.graphics_card":"Kad grafik","prefs.graphics_card_auto":"Automatik","prefs.graphics_card_missing":"Kad grafik yang disimpan tidak tersedia; Automatik digunakan.","prefs.graphics_card_restart":"Berkuat kuasa selepas SolidCraft dimulakan semula. WGPU_ADAPTER_NAME mengatasi pilihan ini.","prefs.graphics_note":"Tukar kelajuan dengan kelicinan. Setiap pilihan menunjukkan kesannya pada contoh.","prefs.graphics_presets_note":"Pratetap menetapkan pilihan di bawah sekali gus.","prefs.hide_constraint_glyphs_zoomed_out":"Sembunyikan glif kekangan apabila dizum keluar","prefs.hide_constraint_glyphs_zoomed_out_note":"Glif kekangan hilang daripada pandangan apabila lakaran dizum keluar sehingga glif itu menyesakkan paparan. Mati: ia kekal pada saiz skrin tetap pada setiap tahap zum.","prefs.history":"Sejarah","prefs.history_origin_bodies":"Papar titik asal dan jasad di bahagian atas","prefs.history_origin_bodies_note":"Sejarah di sebelah kiri atau di bawah pelayar bermula dengan folder Jasad bagi komponen aktif dan Titik Asal, lengkap dengan ikon mata dan menunya seperti dalam pelayar. Sejarah di bahagian bawah tidak berubah.","prefs.history_play_button":"Butang Main Sejarah dalam kawalan Sejarah","prefs.history_play_button_note":"Meletakkan Main Sejarah di antara Undur satu langkah dan Maju satu langkah dalam kawalan Sejarah. Anda juga boleh klik kanan pada kawalan untuk memapar atau menyembunyikannya.","prefs.history_sketches":"Lakaran","prefs.history_sketches_in_order":"Mengikut urutan","prefs.history_sketches_note":"Apabila Lakaran ditetapkan kepada Di bawah cirinya, Sejarah di sebelah kiri menyenaraikan setiap lakaran satu tahap ke dalam, di bawah ciri pertama yang dibina daripadanya, apabila ruangnya cukup lebar untuk nama. Garis masa di bahagian bawah sentiasa mengekalkan urutan penciptaan.","prefs.history_sketches_under_feature":"Di bawah cirinya","prefs.hold_stop_snapping":"Tahan untuk menghentikan pelekapan","prefs.icons_only":"Ikon sahaja","prefs.imported_file":"Fail yang diimport","prefs.in_browser":"Dalam pelayar","prefs.input":"Input","prefs.interface":"Antara muka","prefs.interface_language":"Bahasa antara muka","prefs.interface_note":"Rupa SolidCraft dan kedudukan bahagiannya.","prefs.interval_minutes":"{n} min","prefs.labels":"Label","prefs.layout":"Susun atur","prefs.layout_note":"Padat melabuhkan panel pada tepi tetingkap. Kelutsinaran pelayar tersedia dalam Terapung. Tukar sisi Pembantu pada halaman Pembantu.","prefs.left":"Kiri","prefs.left_click":"Klik kiri","prefs.line_drag_draws_one":"Tekan dan seret melukis satu garis","prefs.line_drag_draws_one_note":"Dalam alat Garis, menekan, menyeret dan melepaskan melukis satu garis dari titik tekan hingga titik lepas, dan ia tamat di situ. Klik masih melukis rantaian. Mati: seretan meletakkan titik di tempat ia dilepaskan, seperti klik.","prefs.linked_designs":"Reka bentuk terpaut","prefs.live_input":"Input langsung","prefs.live_preview":"Pratonton langsung","prefs.logo":"Logo","prefs.logo_accent":"Aksen","prefs.logo_theme":"Warna tema","prefs.max_file_size":"Saiz fail maksimum untuk dibuka","prefs.max_file_size_design":"Fail reka bentuk","prefs.max_file_size_flag":"Pelaksanaan ini bermula dengan --max-file-size {size}, yang terpakai sehingga SolidCraft ditutup. Tetapan ini terpakai apabila dimulakan tanpa pilihan itu.","prefs.max_file_size_note":"Lalai: 512 MB dan 256 MB; maksimum 16 GB. Membuka fail memerlukan memori beberapa kali saiznya. Reka bentuk yang menyimpan import besar mungkin memerlukan had fail reka bentuk lebih tinggi untuk disimpan dan dibuka semula.","prefs.max_file_size_step":"Fail STEP dan import","prefs.max_file_size_web":"Aplikasi web membuka fail STEP dan import sehingga 512 MB serta reka bentuk sehingga 256 MB: tab pelayar tidak dapat memuatkan fail lebih besar. Aplikasi desktop boleh menaikkan had ini.","prefs.megabytes":"MB","prefs.menu_grid":"Ikon besar","prefs.menu_list":"Senarai","prefs.menus":"Menu","prefs.minutes":"minit","prefs.minutes_suffix":" min","prefs.mouse":"Tetikus dan pad jejak","prefs.mouse_heading":"Tetikus","prefs.mouse_mapping":"Pemetaan tetikus","prefs.navigation":"Navigasi","prefs.navigation_note":"Cara tetikus, pad jejak dan tetikus 3D menggerakkan pandangan.","prefs.network_host_remove":"Buang","prefs.network_locations":"Benarkan lokasi rangkaian dalam reka bentuk","prefs.network_locations_note":"Dimatikan: fail terpaut bagi reka bentuk pada komputer lain (\\\\server\\share) hanya dibuka daripada pelayan yang disenaraikan di sini, atau selepas anda membenarkannya apabila ditanya.","prefs.network_locations_section":"Lokasi rangkaian","prefs.not_on_gpu":"tiada pada GPU ini","prefs.on":"Dihidupkan","prefs.opaque":"Legap","prefs.orbit_snap":"Tahan Shift semasa mengorbit untuk melekap pada paksi.","prefs.orientation":"Orientasi","prefs.origin_plane_names":"Nama satah asal","prefs.origin_plane_names_note":"Nama yang dipaparkan dalam pelayar, dialog dan senarai. {top} ialah XY, {front} ialah XZ dan {right} ialah YZ, dengan Z ke atas. Arahan, skrip dan reka bentuk yang disimpan kekal menggunakan XY, XZ dan YZ.","prefs.overall_speed":"Kelajuan keseluruhan","prefs.parameter_list_rows":"Baris senarai parameter","prefs.parameter_list_rows_tip":"Anak panah ke bawah dalam medan nilai kosong menyenaraikan parameter, kegemaran dahulu, sehingga bilangan ini. Bilangan yang lebih kecil memastikan senarai ringan dalam reka bentuk besar.","prefs.persistent_ribbon_pressed":"Serlahkan arahan reben yang aktif","prefs.persistent_ribbon_pressed_help":"Serlahkan arahan reben selagi kesannya dihidupkan. Matikan untuk mengekalkan rupa neutral dan bantuan arahan yang terdahulu.","prefs.perspective_fov":"Medan pandangan","prefs.placement":"Penempatan","prefs.prefer_free_sketch_points":"Utamakan titik lakaran yang boleh digerakkan apabila titik bertindih","prefs.preview_choices":"Pratonton pilihan anda","prefs.print_face_highlight":"Serlahan muka cetakan","prefs.print_face_highlight_tip":"Sejauh mana muka cetakan sesuatu jasad diwarnakan dan digaris dalam paparan. 0 % tidak menunjukkan serlahan.","prefs.profile_active":"Profil aktif","prefs.profile_applied":"Profil digunakan.","prefs.profile_changed":"Tetapan telah berubah sejak profil disimpan. Simpan mengekalkannya dalam profil.","prefs.profile_deleted":"Profil dipadam.","prefs.profile_export":"Eksport…","prefs.profile_exported":"Profil dieksport.","prefs.profile_imported":"Profil diimport. Pilihnya di bawah Profil aktif untuk beralih kepadanya.","prefs.profile_name_hint":"Nama profil, cth. Laptop","prefs.profile_rename":"Tukar nama","prefs.profile_renamed":"Nama profil ditukar.","prefs.profile_save":"Simpan","prefs.profile_saved":"Tetapan semasa disimpan ke profil.","prefs.profile_skipped":"Profil digunakan; {n} tetapan mengekalkan nilai semasanya (lihat log).","prefs.profiles":"Profil tetapan","prefs.profiles_note":"Pintasan, bar alat, navigasi, menu jejarian dan tetapan antara muka, disimpan bersama di bawah satu nama dan ditukar sekali gus.","prefs.project_options_dialog":"Dialog pilihan Unjur","prefs.project_options_dialog_note":"Hidup: pilih Geometri atau Jasad dan Pautan Unjuran sebelum mengunjur. Mati: kekalkan aliran kerja pilih terus sebelumnya.","prefs.quality_default":"lalai","prefs.quality_fastest":"terpantas","prefs.quality_slowest":"terperlahan","prefs.quality_smoother":"lebih licin","prefs.quick_measure":"Ukuran pantas di sudut pandangan","prefs.quick_measure_note":"Saiz pilihan di sudut kanan bawah pandangan: panjang tepi, atau Ø dan R bagi tepi bulat, luas muka, kedudukan titik, jarak dan sudut dua item, jumlah beberapa tepi atau muka. Satu klik menyalinnya.","prefs.render_previous_geometry_budget":"Gunakan bajet geometri pratonton Render sebelumnya","prefs.render_previous_geometry_budget_help":"Pulihkan had geometri tetap sebelumnya (512 MiB pada desktop 64-bit, 128 MiB di tempat lain) dan bukannya bajet berdasarkan peranti.","prefs.reports_saved":"{n} disimpan","prefs.ribbon_reveal":"Tunjukkan hasil carian dalam reben","prefs.ribbon_reveal_note":"Melalukan kursor pada hasil dalam Cari arahan menunjukkan kedudukan arahan itu dalam reben: tabnya, butangnya atau barisnya dalam senarai juntai sesuatu panel. Arahan yang dimulakan daripada carian berkelip di situ, dan arahan yang sedang berjalan daripada senarai juntai menandakan panelnya.","prefs.right_click":"Klik kanan","prefs.saving":"Simpan auto dan pemulihan","prefs.scale_note":"Juga Ctrl + / Ctrl − dalam tetingkap. Butang ialah 28 px pada 100%.","prefs.scale_text":"Skala dan teks","prefs.search":"Cari tetapan","prefs.search_empty":"Tiada tetapan yang sepadan","prefs.select":"Pilih","prefs.select_one_item":"Pilih satu item","prefs.select_other_hidden":"Pilih geometri tersembunyi dengan Pilih Lain","prefs.select_other_hidden_help":"Hidup: sertakan jasad, lakaran dan tepi terlindung yang tersembunyi berhampiran penuding. Mati: guna senarai asal geometri kelihatan di bawah penuding.","prefs.selecting":"Pemilihan","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift hanya menambah; Ctrl / Cmd menogol","prefs.shift_add_note":"Dihidupkan: Shift menambah, Ctrl / Cmd menogol. Dimatikan (lalai): kedua-duanya menogol.","prefs.shortcuts":"Pintasan","prefs.single_surface_analysis":"Gunakan satu analisis permukaan sahaja","prefs.single_surface_analysis_help":"Apabila dimatikan, lorekan permukaan dan Keselanjaran boleh kekal hidup bersama. Menghidupkan pilihan ini mengekalkan analisis terakhir yang dimulakan atau diubah.","prefs.sketch_align_points":"Selaraskan dengan titik lakaran lain semasa melukis","prefs.sketch_align_points_note":"Semasa melukis, titik diselaraskan secara mendatar dengan satu titik lakaran dan secara menegak dengan titik lain pada masa yang sama, dengan panduan bertitik, dan klik mengekalkan kedua-dua penjajaran. Mati: hanya dengan titik sebelumnya, satu paksi pada satu masa.","prefs.sketch_conflict_colour":"Geometri bercanggah dalam warna percanggahan","prefs.sketch_conflict_colour_note":"Apabila kekangan lakaran bercanggah, lengkung dan titik yang dipegang oleh kekangan yang gagal turut dilukis dalam warna percanggahan, bukan sahaja glifnya atau dimensinya. Mati: ia mengekalkan warna biasa.","prefs.sketch_construction_lines":"Alat garis binaan lanjutan","prefs.sketch_exit_view":"Apabila lakaran tamat","prefs.sketch_exit_view.keep":"Kekalkan pandangan semasa","prefs.sketch_exit_view.previous":"Kembali ke pandangan sebelumnya","prefs.sketch_exit_view.unless_rotated":"Kembali melainkan diputar","prefs.sketch_exit_view_note":"Ke mana pandangan beralih selepas Siap Lakaran, Batal atau Esc dua kali.","prefs.sketch_open_look_at":"Putar menghadap lakaran apabila dibuka","prefs.sketch_open_look_at_note":"Mati: mencipta atau menyunting lakaran membiarkan pandangan seperti sedia ada. Pandang Tepat menghadapkan pandangan ke lakaran apabila anda mahu.","prefs.sketch_recent_snap":"Lekap auto pada pusat dan titik tengah terkini","prefs.sketch_recent_snap_note":"Semasa melukis, kursor melekap pada titik persilangan panduan daripada dua pusat bulatan atau titik tengah tepi lurus yang terkini. Mati: panduan itu hanya untuk paparan dan kursor tidak bergerak.","prefs.sketch_selection":"Lakaran & pilihan","prefs.sketch_selection_heading":"Lakaran dan pilihan","prefs.sketch_selection_note":"Cara lakaran melekap dan cara klik memilih.","prefs.sketch_state_icons":"Ikon lakaran dalam warna keadaannya","prefs.sketch_state_icons_note":"Dalam Sejarah dan pelayar, ikon lakaran mengambil warna keadaannya (kurang terkekang, terkekang sepenuhnya atau bercanggah) dan petua alatnya menamakan keadaan itu. Mati: setiap lakaran mempunyai ikon yang sama.","prefs.sketch_tab_always":"Kekalkan tab Lakaran dipaparkan","prefs.sketch_tab_always_note":"Tab Lakaran kekal dalam reben, sejurus selepas Model, selagi tiada lakaran dibuka. Alat lukisannya kemudian memulakan lakaran pada satah atau muka yang dipilih, atau pada satah yang anda pilih seterusnya, dengan alat itu sedia di dalamnya.","prefs.sketch_tracking_guides":"Panduan penjajaran pusat dan titik tengah","prefs.sketch_tracking_guides_note":"Halakan kursor pada pusat bulatan atau titik tengah tepi lurus, kemudian gerakkan secara mendatar atau menegak untuk memaparkan panduan bertitik sementara.","prefs.sketch_tracking_points":"Panduan penjajaran daripada titik hujung dan sudut semasa melukis","prefs.sketch_tracking_points_note":"Semasa alat lukisan menunggu satu titik, meletakkan penuding pada hujung garis atau lengkok, sudut segi empat tepat atau titik bebas memaparkan panduan bertitik sementara yang sama seperti bagi pusat atau titik tengah. Mati: hanya pusat dan titik tengah.","prefs.sketching":"Melakar","prefs.snap_drawing_note":"Semasa melukis atau menyeret titik lakaran.","prefs.source":"Sumber","prefs.speed":"Kelajuan","prefs.stand_up_note":"Selepas fail STEP atau IGES dibuka dengan Z ke atas, tawarkan putaran suku pusingan pada paksi X.","prefs.stand_up_unknown":"Untuk fail daripada program yang tidak dikenali","prefs.stand_up_unknown.ask":"Tanya dalam dialog","prefs.stand_up_unknown.note":"Papar nota","prefs.stand_up_unknown.off":"Jangan tawarkan","prefs.stand_up_unknown_note":"Cara tawaran dibuat apabila pengepala fail tidak menamakan program yang diketahui menyimpan dengan Y ke atas. Nota dipaparkan hanya apabila fail kelihatan terbaring; Tanya dalam dialog bertanya tentang setiap fail sedemikian, seperti sebelum ini.","prefs.status_bar":"Bar status","prefs.status_bar_note":"Bar nipis di sepanjang tepi bawah tetingkap memaparkan apa yang sedang disunting, keadaan lakaran yang dibuka dalam warnanya dan unit reka bentuk; klik pada unit untuk menukarnya. Keadaan lakaran kemudian tidak lagi dipaparkan di sudut paparan.","prefs.status_done":"Selesai","prefs.status_error":"Ralat","prefs.status_selected":"Dipilih","prefs.status_warning":"Amaran","prefs.supersampling_brief":"Melukis pandangan pada saiz lebih besar lalu menapisnya ke bawah: sangat tajam, tetapi lebih berat.","prefs.tab_accent_note":"Aksen mengikut tab aktif","prefs.theme_file":"fail tema","prefs.theme_file_or_paste":"fail atau tampal","prefs.theme_follow":"Ikut fail tema","prefs.theme_follow_error":"Tidak digunakan: {error}. Tema sah terakhir kekal aktif.","prefs.theme_follow_launch":"Diikuti untuk sesi ini sahaja (--theme-file); dimuat semula setiap kali alat lain menulis semula fail.","prefs.theme_follow_note":"Dimuat semula setiap kali alat lain menulis semula fail. Memilih tema menghentikan ikutan.","prefs.theme_follow_off":"Mati","prefs.theme_follow_stop":"Berhenti mengikuti","prefs.theme_import_hint":"Klik untuk memilih fail tema, seret satu ke sini, atau tekan Ctrl+V (Cmd+V pada Mac) dengan tema yang telah disalin","prefs.theme_option_opacity":"Kelegapan","prefs.theme_option_opacity_help":"Laraskan kelegapan panel terapung. Paras kebolehbacaan minimum melindungi teks di atas warna tetingkap pandangan.","prefs.theme_option_tab_colours":"Warna tab","prefs.theme_option_tab_colours_help":"Gunakan warna panel dan tetingkap pandangan tema ini bagi setiap tab reben.","prefs.theme_option_tab_fade_ms":"Peralihan tab","prefs.theme_option_tab_fade_ms_help":"Pudarkan warna panel dan tetingkap pandangan apabila bertukar tab. Sifar bertukar serta-merta.","prefs.theme_options_badge":"Pilihan","prefs.theme_options_more":"Lagi · {count}","prefs.theme_options_reset":"Set Semula","prefs.theme_options_unavailable":"Tidak tersedia pada peranti ini","prefs.theme_paste":"Tampal tema","prefs.theme_paste_none":"Papan keratan tidak mengandungi tema SolidCraft","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"kini","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Notis","prefs.toggle_item":"Tambah item, atau keluarkannya semula","prefs.toolbar":"Bar alat","prefs.toolbar_tabs":"Tab bar alat","prefs.top":"Atas","prefs.trackpad_zoom_modifier":"Zum dengan tatal dua jari sambil menahan","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Tahan kekunci ini sahaja untuk zum pada penuding dengan tatal menegak. Mati mengekalkan kelakuan tatal sedia ada.","prefs.trackpad_zoom_modifier.off":"Mati","prefs.translucent":"Lut sinar","prefs.under_browser":"Di bawah pelayar","prefs.under_cursor":"Di bawah kursor","prefs.units_precision":"Unit dan ketepatan","prefs.updates":"Kemas kini","prefs.value_boxes_in_view":"Papar nilai di sebelah pemegangnya dalam pandangan","prefs.value_boxes_in_view_tip":"Nilai sesuatu arahan (Jarak, Jejari…) dalam kotak di sebelah pemegangnya, di atas model. Mati: anda menaipnya dalam tetingkap arahan, yang mengambil papan kekunci selepas satu pilihan, dan tiada apa-apa menutupi model.","prefs.view":"Kelakuan pandangan","prefs.view_confirm_corner":"OK dan Batal di sudut pandangan","prefs.view_confirm_corner_note":"Semasa dialog atau lakaran dibuka, tanda semak dan tanda silang di bahagian kanan atas pandangan melakukan apa yang dilakukan OK dan Batal dialog, atau menyiapkan dan membatalkan lakaran. Navigator pandangan bergerak ke bawah di bawahnya.","prefs.viewport":"Tetingkap pandangan","prefs.viewport_analysis_status":"Papar status analisis tetingkap pandangan","prefs.viewport_analysis_status_help":"Papar analisis aktif di atas tetingkap pandangan, buka petunjuknya daripada setiap item, dan gunakan Esc untuk mematikan analisis terbaharu. Matikan untuk memulihkan petunjuk sudut dan tingkah laku Esc yang terdahulu.","prefs.viewport_background":"Latar belakang","prefs.viewport_background_colour":"Warna","prefs.viewport_background_theme":"Kecerunan tema","prefs.viewport_section_status":"Papar status keratan tetingkap pandangan","prefs.viewport_section_status_help":"Papar tetapan keratan dalam tetingkap pandangan. Escape dan butang reben yang aktif mematikannya. Matikan untuk mengekalkan kawalan keratan sebelumnya.","prefs.viewport_status_details":"Butiran tetingkap pandangan langsung","prefs.viewport_status_details_help":"Sunting tetapan analisis dan keratan yang aktif dalam kad butiran piawai. Matikan untuk memulihkan kekunci analisis baca sahaja dan dialog Keratan.","prefs.viewport_status_summary":"Ringkaskan item status tetingkap pandangan","prefs.viewport_status_summary_help":"Ringkaskan tiga atau lebih item status tetingkap pandangan ke dalam satu lencana ringkasan. Matikan untuk mengekalkan setiap item dalam baris penuh.","prefs.wheel":"Roda","prefs.wheel_trackpad":"Roda dan pad jejak","prefs.workspace":"Ruang kerja","prefs.zoom_stop_at_model":"Hentikan zum pada model","prefs.zoom_stop_at_model_tip":"Tetikus 3D dan apl peranti mengezum ke arah permukaan di tengah pandangan; zum seret mengekalkan titik tempat seretan bermula. Mati: zum boleh menembusi model. Roda dan cubit menggunakan Zum ke kursor secara berasingan","prefs.zoom_toward_cursor":"Zum ke arah kursor","properties.title":"Sifat: {name}","recovery.days_ago":"{count} hari lalu","recovery.detail":"{file} · {features} ciri · disimpan automatik {when}","recovery.discard_all":"Buang semua","recovery.discard_all_detail":"Tindakan ini tidak boleh dibuat asal.","recovery.discard_all_title":"Buang {count} simpanan automatik?","recovery.discard_all_title_one":"Buang 1 simpanan automatik?","recovery.hours_ago":"{count} j lalu","recovery.just_now":"sebentar tadi","recovery.min_ago":"{count} min lalu","recovery.never_saved":"tidak pernah disimpan","render.adaptive_absolute":"Had bawah ralat RGB mutlak","render.adaptive_coverage":"Sasaran ralat liputan","render.adaptive_enable":"Peruntukkan sampel dengan perintis bebas","render.adaptive_help":"GPU sahaja. Sampel perintis bebas dibuang, kemudian 16 atau lebih sampel pengeluaran bagi setiap piksel diperuntukkan sehingga Sampel setiap piksel. Varians RGB dan liputan memandu peruntukan; laluan jarang mungkin terlepas dan piksel yang dihadkan mungkin kekal berhingar. Laporan akhir mengira kerja sebenar. Tiada jaminan hingar atau masa yang diperakui.","render.adaptive_minimum":"Sampel pengeluaran minimum","render.adaptive_pending":"Peruntukan adaptif perintis bebas GPU dan strata Fresnel bersyarat tersedia. Penumpuan yang diperakui, jaminan peristiwa jarang dan pengangkutan adaptif CPU masih tidak tersedia.","render.adaptive_pilots":"Sampel perintis setiap piksel","render.adaptive_relative":"Sasaran ralat RGB relatif","render.add_ground":"Tambah lantai yang disesuaikan pada persediaan","render.advanced_material_scope":"Satu medium GPU homogen terhingga tersedia di bawah had yang jelas. Grid ketumpatan, gabungan kaca/isi padu bersarang, permukaan serakan subpermukaan, anjakan, pengangkutan spektrum dan konsep bahan lanjutan yang belum terikat masih tidak tersedia.","render.aging_add":"Tambah lapisan penuaan","render.aging_airborne":"Habuk berudara / medium penyertaan","render.aging_airborne_help":"Habuk berudara ialah isi padu serakan homogen terhingga yang berasingan. Ia mengubah pengangkutan dan EXR mentah, bukan tindanan penuaan permukaan. Sekatan isi padu/kaca/penyahhingaran yang sedia ada kekal jelas; tiada atmosfera ditambah secara automatik.","render.aging_all_bodies":"Semua jasad legap yang layak","render.aging_chips":"Cat terkelupas","render.aging_class_any":"Semua kelas bahan legap","render.aging_class_dielectric":"Permukaan bukan logam sahaja","render.aging_class_metal":"Permukaan logam sahaja","render.aging_color":"Warna lapisan · sRGB","render.aging_coverage":"Liputan","render.aging_dust":"Habuk termendap","render.aging_empty":"Tiada lapisan penuaan: permukaan asal kekal tidak berubah.","render.aging_fading":"Salutan pudar","render.aging_grime":"Kotoran & kesan noda","render.aging_help":"Gabungkan sehingga lapan lapisan optik, mengikut urutan. Karat dan patina ialah penampilan yang direka, bukan simulasi usia/kakisan. Skala dalam milimeter dunia. Tiada geometri, jisim atau sifat kejuruteraan diubah; kaca dan pentas pasif dikecualikan.","render.aging_metallic":"Pecahan logam lapisan","render.aging_origin":"Titik asal medan · mm dunia","render.aging_patina":"Patina hijau kuprum","render.aging_refresh_targets":"Periksa jasad semasa","render.aging_roughness":"Kekasaran lapisan","render.aging_rust":"Besi teroksida / karat","render.aging_scale":"Skala corak","render.aging_scratches":"Calar halus","render.aging_target":"Sasaran & koordinat","render.aging_target_help":"Sasaran bernama mesti masih sepadan dengan indeks dan nama yang dirakam. Topeng global bersauh pada dunia; ia tidak mengikut bahagian yang bergerak. Ini bukan pengesanan rongga mahupun haus tepi sebenar. Tapis senarai untuk mencapai jasad tambahan.","render.aging_target_search":"Tapis nama jasad","render.aging_upward":"Pemendapan menghadap ke atas","render.all_controls_help":"Pemeriksaan padat bagi semua kawalan semasa. Halaman seksyen menyediakan penyuntingan berfokus tanpa mengubah permintaan asas.","render.all_shots_label":"Semua Syot","render.appearance_editor.absorption":"Penyerapan","render.appearance_editor.base_colour":"Warna asas","render.appearance_editor.body_reason":"Pengikatan optik menyasarkan satu jasad sepenuhnya. Pilih Jasad untuk menyunting kawalan ini.","render.appearance_editor.boundary":"Sempadan","render.appearance_editor.box":"Kotak","render.appearance_editor.choose_image":"Pilih imej…","render.appearance_editor.closed":"Pepejal tertutup","render.appearance_editor.coat":"Salutan jernih","render.appearance_editor.cpu_reason":"Memerlukan penjejakan sinar CPU.","render.appearance_editor.glass":"Kaca dan penyerapan","render.appearance_editor.glass_enable":"Gunakan kaca fizikal pada jasad ini","render.appearance_editor.glass_note":"Kaca tertutup menggunakan jarak geometri. Ia tidak boleh berkongsi jasad dengan salutan jernih atau peta.","render.appearance_editor.gpu_reason":"Memerlukan penjejakan laluan GPU.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Peta","render.appearance_editor.normal":"Normal","render.appearance_editor.normal_strength":"Kekuatan normal","render.appearance_editor.origin":"Titik Asal","render.appearance_editor.recipe":"Resipi","render.appearance_editor.reflection_sampling":"Pensampelan untuk semua jasad pemantul","render.appearance_editor.reflections":"Pantulan","render.appearance_editor.remove":"Buang yang tersimpan","render.appearance_editor.remove_note":"Buang optik tersimpan daripada syot ini. Geometri dan gaya yang ditetapkan dikekalkan.","render.appearance_editor.remove_title":"Buang optik tersimpan?","render.appearance_editor.replace":"Ganti optik tersimpan jasad ini","render.appearance_editor.revalidate":"Sahkan semula jasad ini","render.appearance_editor.save":"Simpan optik ini","render.appearance_editor.save_reason":"Menyimpan optik ini memerlukan kaca fizikal pada jasad GPU semasa. Salutan dan peta imej tempatan kekal sementara.","render.appearance_editor.saved":"Disimpan bersama syot ini","render.appearance_editor.saved_state":"Optik ini disimpan bersama syot ini.","render.appearance_editor.scatter_reason":"Serakan dalaman memerlukan sempadan pepejal tertutup.","render.appearance_editor.temporary":"Optik ini bersifat sementara pada tab ini. Simpan untuk mengekalkannya bersama syot.","render.appearance_editor.thickness":"Ketebalan","render.appearance_editor.thickness_reason":"Ketebalan terpakai pada kepingan nipis; kaca tertutup menggunakan jarak geometri.","render.appearance_editor.thin":"Kepingan nipis","render.appearance_editor.u_repeat":"Ulang U","render.appearance_editor.v_repeat":"Ulang V","render.appearance_editor.v_up":"V tekstur menghala ke atas","render.appearance_editor.weight":"Pemberat","render.appearance_physics_separate":"Penampilan visual tidak menetapkan ketumpatan, data terma atau sifat kejuruteraan lain.","render.appearances":"Penampilan","render.assign_help":"Klik untuk menggunakan pada pilihan; seret untuk pratonton dan lepaskan, atau klik tanpa apa-apa dipilih untuk mengecat.","render.availability_native":"Gubahan asli; semak sebelum menggunakan","render.availability_projection":"Unjuran disokong; lihat skop dan perkara yang ditinggalkan","render.availability_reference":"Data rujukan; bukan penetapan automatik","render.backdrop_alpha_conflict":"Pilih latar ini atau keluaran PNG telus; enjin render tidak akan mengabaikan sama ada tetapan secara senyap.","render.backdrop_enable":"Gunakan latar kecerunan untuk kamera sahaja","render.backdrop_first":"Warna mula / tengah","render.backdrop_help":"Latar ruang skrin ini tidak menerangi, tidak menghasilkan bayang, tidak memantul dan tidak mewakili rupa bumi. Ia dikecualikan daripada EXR mentah. Geometri, lampu dan persekitaran HDR kekal bebas.","render.backdrop_horizontal":"Kecerunan mendatar","render.backdrop_radial":"Kecerunan jejarian","render.backdrop_radius":"Jejari","render.backdrop_second":"Warna hujung / tepi","render.backdrop_vertical":"Kecerunan menegak","render.backdrop_x":"Pusat X","render.backdrop_y":"Pusat Y","render.background":"Latar belakang adegan","render.background_camera_section":"Latar belakang kamera · persembahan PNG","render.background_completed_frozen":"Hasil yang dipaparkan ialah imej siap yang dibekukan. Menyunting latar belakang tidak melukis semula hasil itu secara automatik. Gunakan Gred Semula Warna untuk perubahan kamera sahaja, atau Render untuk pentas fizikal baharu.","render.background_hdr_separate":"Sumber HDR semasa menerangi dan memantul pada permukaan; ia tidak dipaparkan secara automatik sebagai panorama di belakang subjek. Menukar kecerunan tidak memutar atau mewarnakan semula pencahayaan.","render.background_lighting_section":"Pencahayaan HDR · berasingan daripada latar belakang kamera","render.background_no_alpha_override":"Latar belakang kamera tidak ditambah secara senyap pada keluaran telus. Gred semula warna induk mentah menggunakan liputan yang dirakam dan tidak menggunakan semula penyahhingaran; EXR sumber kekal tidak berubah.","render.background_not_light":"Warna latar belakang ialah persembahan, bukan sumber pencahayaan tambahan.","render.background_regrade":"Gunakan pada induk mentah yang dikekalkan","render.background_stage_occlusion":"Syot ini mengandungi geometri pentas fizikal. Lantai atau dinding yang besar boleh memenuhi bingkai dan menyembunyikan latar belakang kamera sahaja. Kosongkan atau ubah saiz pentas dengan sengaja, atau ubah kepantulan fizikalnya. Gred semula warna tidak dapat membuang geometri yang dirakam.","render.background_workflow":"Pilih latar belakang yang anda maksudkan: warna/kecerunan untuk kamera sahaja, pentas fizikal yang menerima cahaya, atau pencahayaan HDR. Ketiga-tiganya bebas. Pratonton Langsung ialah paparan pemodelan; render imej baharu atau gred semula warna induk yang dikekalkan untuk melihat kemasan kamera.","render.base_appearance":"Penampilan jasad yang boleh disunting","render.base_apply":"Gunakan penampilan jasad","render.base_apply_help":"Satu penetapan visual yang boleh dibuat asal pada jasad tepat yang disemak. Gaya khusus muka dan bahan kejuruteraan yang sedia ada kekal berasingan.","render.base_color":"Warna asas · sRGB","render.base_metallic":"Pecahan logam","render.base_opaque_only":"Penyunting ini mengekalkan semantik jasad legap. Gunakan kawalan kaca yang khusus untuk transmisi optik.","render.bloom_enable":"Papar bloom","render.bloom_help":"Pendaran kreatif untuk keluaran sahaja daripada serlahan linear positif, disebarkan dengan tiga laluan kotak ternormal. Jejari dalam piksel keluaran. Ditambah dalam cahaya paparan linear sebelum sRGB; bukan kesan kanta, kesan volumetrik atau peningkatan penumpuan. EXR mentah tidak berubah.","render.bloom_opaque":"Bloom memerlukan keluaran legap. PNG telus ditolak, bukan diratakan secara senyap.","render.bloom_radius":"Jejari bloom","render.bloom_strength":"Kekuatan bloom","render.bloom_threshold":"Ambang serlahan linear","render.browse_capabilities":"Periksa katalog keupayaan lengkap","render.browse_environments":"Semak imbas persekitaran HDR asal","render.browse_looks":"Semak imbas…","render.browse_native_scenes":"Semak imbas studio asli","render.browse_physical":"Periksa rujukan fizikal","render.browse_quality":"Periksa spesifikasi kualiti","render.browse_rigs":"Semak imbas rig lampu yang direka","render.browse_scene_specs":"Semak imbas spesifikasi adegan lanjutan","render.browse_surfaces":"Semak imbas permukaan yang direka","render.browser_library":"Koleksi","render.browser_model":"Model","render.camera_distance":"Jarak mata ke sasaran","render.camera_exact_help":"Milimeter dunia; sudut dipaparkan dalam darjah dan disimpan sebagai radian. Navigasi menggunakan kamera yang sama dengan tetingkap pandangan.","render.camera_fov":"Medan pandangan menegak","render.camera_pitch":"Pic kamera","render.camera_roll":"Gelek","render.camera_set":"Tetapkan Kamera Render","render.camera_target":"Kedudukan sasaran · mm","render.camera_yaw":"Yaw","render.category_metal":"Logam","render.category_paint":"Cat","render.category_plastic":"Plastik","render.category_wood":"Kayu","render.check_opaque":"Ketelusan: permukaan legap sahaja; alfa latar belakang disokong.","render.check_sorted_alpha":"Ketelusan: penghampiran alfa tersusun.","render.check_transmission":"Ketelusan: transmisi fizikal.","render.children.absolute_floor":"Had bawah mutlak","render.children.adaptive":"Adaptif","render.children.add_look_reason":"Tambah gaya untuk menyunting status aktif dan kekuatannya.","render.children.all_shots":"Semua syot","render.children.bloom":"Bloom","render.children.check":"Semak","render.children.check_now":"Semak sekarang","render.children.chromatic":"Kromatik","render.children.compact":"Padat","render.children.contrast":"Kontras","render.children.copy_image":"Salin","render.children.copy_job":"Salin JSON kerja","render.children.copy_request":"Salin JSON permintaan","render.children.coverage_error":"Ralat liputan","render.children.cpu":"Penjejakan sinar CPU","render.children.denoise":"Kurangkan hingar dalam imej siap","render.children.depth":"Kedalaman laluan","render.children.distortion":"Herotan","render.children.edge_samples":"Sampel tepi","render.children.effects_banner":"Kesan ini memerlukan penjejakan laluan GPU. Membuka bahagian ini tidak pernah mengubah kaedah.","render.children.enable_adaptive":"Aktifkan perintis bebas untuk menyunting had adaptif.","render.children.enable_bloom":"Aktifkan bloom untuk menyunting kekuatan, ambang dan jejarinya.","render.children.finishing":"Kemasan","render.children.flare":"Kilau","render.children.fresnel":"Strata Fresnel","render.children.ghosts":"Cincin bayang","render.children.glass":"Pengangkutan kaca","render.children.go_to":"Pergi ke {editor}","render.children.grain":"Bijian","render.children.halo":"Halo","render.children.hdr":"HDR","render.children.keep_master":"Kekalkan induk linear mentah","render.children.last_result":"Terakhir: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Kesan kanta","render.children.look_summary":"{tone} · {count} gaya","render.children.looks":"Gaya kreatif","render.children.memory":"Memori","render.children.method":"Kaedah","render.children.minimum":"Minimum","render.children.needs_cpu":"Memerlukan penjejakan sinar CPU. Membuka bahagian ini tidak pernah mengubah kaedah.","render.children.nested":"Dielektrik bersarang yang disahkan","render.children.not_checked":"Belum disemak","render.children.path":"Penjejakan laluan","render.children.pilots":"Sampel perintis","render.children.preview":"Muatan pratonton","render.children.progressive_reason":"Pilih Progresif untuk menyunting bilangan sampel dan benihnya.","render.children.radius":"Jejari","render.children.reflect_depth":"Kedalaman pantulan","render.children.reflect_samples":"Sampel pantulan","render.children.regrade":"Gred semula warna","render.children.relative_error":"Ralat relatif","render.children.render":"Render","render.children.render_shot":"Render syot","render.children.renderer":"Enjin render","render.children.renderers":"Enjin render","render.children.request":"Permintaan ini","render.children.reset_finishing":"Set semula kemasan","render.children.review_quality":"Semak spesifikasi kualiti…","render.children.rgb_gain":"Gandaan RGB","render.children.samples":"Sampel","render.children.sampling":"Pensampelan","render.children.saturation":"Ketepuan","render.children.scene_summary":"{bodies} jasad · {triangles} segi tiga","render.children.seed":"Benih","render.children.sharpening":"Penajaman","render.children.single_image":"Imej tunggal","render.children.soft_focus":"Fokus lembut","render.children.streak":"Alur","render.children.strength":"Kekuatan","render.children.studio":"Studio","render.children.threshold":"Ambang","render.children.tone":"Ton","render.children.under_hood":"Di sebalik tabir","render.children.vignette":"Vinyet","render.children.workstation":"Stesen kerja","render.choose_look":"Pilih gaya dalam Penampilan dahulu","render.chromatic_offset":"Ofset tepi kromatik","render.clear_stage":"Buang pentas yang disimpan","render.copy_request":"Salin JSON","render.cpu_aa_help":"Sampel ruang: lebih banyak sampel menambah baik tepi dan menambah masa render.","render.cpu_area_add":"Tambah lampu segi empat tepat CPU","render.cpu_area_editor":"Lampu segi empat tepat CPU","render.cpu_area_editor_help":"Vektor sisi penuh dalam milimeter; U silang V menghala ke sisi yang memancar. Ini berbeza daripada vektor separuh tepi GPU.","render.cpu_area_full_u":"Sisi U penuh · mm","render.cpu_area_full_v":"Sisi V penuh · mm","render.cpu_area_samples":"Sampel lampu kawasan","render.cpu_binding_confirm":"Sahkan jasad ini","render.cpu_binding_stale":"Adegan telah berubah. Sahkan sasaran pantulan ini sekali lagi sebelum merender.","render.cpu_body_choose":"Pilih jasad","render.cpu_body_filter":"Tapis jasad mengikut nama","render.cpu_body_filter_more":"Perhalusi tapisan untuk melihat lebih banyak jasad.","render.cpu_body_missing":"Sasaran pantulan hilang, tersembunyi, taksa atau mempunyai nama yang lebih panjang daripada 128 bait. Pilih semula.","render.cpu_budget":"Profil sumber CPU","render.cpu_budget_bodies":"Had atas jasad","render.cpu_budget_compact":"Padat (had lama)","render.cpu_budget_details":"Had sumber","render.cpu_budget_help":"Pilih had yang lebih besar secara jelas. Resolusi dan sampel tidak pernah dikurangkan secara automatik.","render.cpu_budget_memory":"Had atas memori kerja","render.cpu_budget_not_guarantee":"Ini ialah had atas kemasukan, bukan tempahan RAM atau jaminan kelajuan. Geometri, filem dan pratonton yang dikekalkan berkongsi bajet memori; render kekal boleh dibatalkan.","render.cpu_budget_resize":"Draf melebihi profil CPU ini atau bajet sampel kameranya. Terima dimensi yang lebih kecil secara jelas atau pilih profil yang lebih besar.","render.cpu_budget_studio":"Studio (imej besar)","render.cpu_budget_triangles":"Had atas segi tiga","render.cpu_budget_workstation":"Stesen kerja (adegan berat)","render.cpu_captured_hdr":"HDR yang dirakam untuk imej ini","render.cpu_check_capture_help":"Semak dan Mula mengesahkan cincang fail yang sama atau menggunakan HDR terbenam. Setiap imej mengekalkan sumber yang dirakamnya.","render.cpu_check_changed":"Kawalan atau model berubah selepas semakan ini. Semak semula sebelum merender.","render.cpu_constant_help":"Radiance malar kelihatan kepada sinar yang dipantulkan atau ditransmisikan. Ia tidak memberikan pencahayaan resap langsung.","render.cpu_custom_directions":"Gantikan pratetap dengan lampu berarah tersuai","render.cpu_direction":"Arah menuju lampu (X, Y, Z)","render.cpu_directional":"Lampu berarah","render.cpu_directional_add":"Tambah lampu berarah","render.cpu_environment":"Persekitaran CPU","render.cpu_environment_background":"Latar belakang imej kekal berasingan daripada pencahayaan persekitaran.","render.cpu_environment_bounds":"Keamatan CPU mestilah 0–64, putaran HDR terhingga dalam ±1,000,000 radian, dan sampel HDR 1, 4, 16 atau 64.","render.cpu_environment_constant":"Persekitaran sinar sekunder malar","render.cpu_environment_none":"Tiada persekitaran CPU","render.cpu_environment_samples":"Sampel pencahayaan HDR","render.cpu_exposure_help":"Pendedahan CPU mestilah antara −16 dan 16 EV. Pendedahan GPU di luar julat itu dikekalkan sehingga anda mengubahnya.","render.cpu_fixed":"Imej tunggal","render.cpu_hdr_help":"Radiance .hdr, panorama 2:1, sehingga 2048 × 1024 dan 16 MiB. CPU memerlukan primari sRGB/D65 yang dinyatakan secara jelas dalam fail; primari yang tidak dinyatakan dan EXR ditolak.","render.cpu_hdr_reflection_help":"Pantulan kasar HDR memerlukan permukaan jasad dan muka yang berlogam sepenuhnya. Semak melaporkan gabungan yang tidak disokong.","render.cpu_key_rim":"Utama dan pinggir","render.cpu_last_check":"Semakan CPU terakhir","render.cpu_light_help":"Sehingga lapan lampu berarah. Senarai tersuai yang kosong mematikannya; memilih pratetap memulihkan lampunya. Warna ialah RGB linear dan keamatan bersifat relatif, bukan watt.","render.cpu_light_intensity":"Keamatan relatif (0–64)","render.cpu_light_minimum":"Jarak minimum untuk pelemahan","render.cpu_light_position":"Kedudukan dunia (X, Y, Z)","render.cpu_light_reference":"Jarak rujukan untuk keamatan","render.cpu_light_remove":"Buang lampu","render.cpu_lighting":"Pratetap pencahayaan","render.cpu_lights":"Lampu CPU","render.cpu_linear_color":"Warna linear (R, G, B)","render.cpu_neutral":"Neutral","render.cpu_opaque_required":"Penjejakan sinar CPU memerlukan latar belakang legap. Nyahtandakan Latar belakang telus untuk meneruskan.","render.cpu_options_pending":"Panel CPU ini belum dapat menyunting pancaran, kesan permukaan, kaca atau anisotropi. Kosongkan pilihan API tersebut sebelum menggunakannya.","render.cpu_point":"Lampu titik","render.cpu_point_add":"Tambah lampu titik","render.cpu_point_help":"Sehingga lapan lampu titik, ditambah pada pencahayaan berarah yang dipilih. Jarak dalam mm; jarak minimum tidak boleh melebihi jarak rujukan.","render.cpu_primary_samples":"Sampel tepi setiap piksel","render.cpu_progressive":"CPU progresif","render.cpu_progressive_help":"Kumpulkan hasil penyepadu CPU sedia ada dalam pas satu sampel utama. Pantulan yang dipilih memerlukan satu sampel; lampu kawasan, dielektrik dan anisotropi memerlukan Imej tunggal.","render.cpu_progressive_limits":"Paling banyak 1,048,576 piksel dan 16,777,216 penilaian piksel × sampel. Menukar sampel tidak mengubah saiz imej secara automatik.","render.cpu_progressive_seed":"Benih pensampelan CPU","render.cpu_progressive_spp":"sampel setiap piksel","render.cpu_reflection_add":"Tambah pantulan kasar","render.cpu_reflection_depth":"Kedalaman pantulan (1–8)","render.cpu_reflection_empty":"Tiada jasad dipilih: pantulan adegan dimatikan.","render.cpu_reflection_help":"Pilih jasad dan tetapkan Dimatikan, Cermin atau Kasar. Kasar menggunakan kekasaran permukaan yang ditetapkan. Lebih banyak sampel dan lantunan menambah masa; ini ialah pengangkutan spekular terhad, bukan pencahayaan global.","render.cpu_reflection_limit":"Sehingga 64 jasad terpantul disokong.","render.cpu_reflection_mirror":"Cermin","render.cpu_reflection_off":"Dimatikan","render.cpu_reflection_rough":"Kasar","render.cpu_reflection_samples":"Sampel pantulan (1–64)","render.cpu_reflections":"Pantulan CPU","render.cpu_runtime_help":"Tetapan lampu dan persekitaran berangka disimpan bersama persediaan. Pantulan jasad dan fail HDR kekal sementara. Nilai lampu kawasan dan kon lampu sorot yang sedia ada dikekalkan.","render.cpu_sampling_mode":"Mod pensampelan CPU","render.cpu_shadows":"Hasilkan bayang","render.cpu_summary":"Penjejakan sinar CPU · pantulan · HDR · lampu berarah dan lampu titik","render.cpu_warm_cool":"Hangat dan sejuk","render.diag_bodies":"Jasad kelihatan","render.diag_job_details":"Butiran kerja yang dirakam","render.diag_last_check":"Semakan awal terakhir","render.diag_memory":"Anggaran kemasukan logik","render.diag_not_implemented":"Sempadan keupayaan yang dinyatakan secara jelas","render.diag_preflight_details":"Butiran semakan awal","render.diag_request":"Permintaan semasa yang tepat","render.diag_triangles":"Segi tiga","render.discard_continue":"Buang draf dan teruskan","render.draft_confirm_help":"Draf render semasa mempunyai suntingan yang belum digunakan. Simpan sebelum menukar, buang secara jelas, atau teruskan menyunting.","render.draft_confirm_title":"Kekalkan tetapan render yang disunting","render.effects_gpu_only":"Kesan ini memerlukan penjejakan laluan GPU. Menukar halaman tidak pernah menukar enjin render secara automatik.","render.effects_help":"Gabungkan gaya warna yang tersusun dan kesan kanta dalam ruang imej. Merender dan gred semula warna induk mentah menggunakan tetapan tersimpan yang sama. EXR mentah kekal tidak berubah. Ini ialah kawalan artistik asli, bukan emulasi kanta yang ditentukur atau filem berjenama.","render.effects_reset_lens":"Set semula kesan kanta","render.effects_seed":"Benih corak","render.emitted_axis":"Paksi pancaran","render.env_advanced":"Lanjutan","render.env_backdrop":"Latar","render.env_backdrop_pending":"Keterlihatan persekitaran dan kekaburan latar belakang belum disokong oleh enjin render.","render.env_blur":"Kabur","render.env_change":"Tukar","render.env_choose_source":"Pilih persekitaran dalam Studio dan Persekitaran sebelum menyunting pencahayaan.","render.env_clear":"Kosongkan","render.env_colour":"Warna","render.env_environments":"Persekitaran","render.env_ground":"Lantai","render.env_ground_pending":"Lantai fizikal menerima bayang sebagai permukaan resap terhingga. Penangkapan bayang sahaja dan pantulan lantai belum disokong.","render.env_intensity":"Keamatan","render.env_invalid_edit":"Suntingan persekitaran tidak sah.","render.env_physical_ground":"Lantai fizikal","render.env_preview_help":"Contoh sfera ilustrasi; bukan pratonton persekitaran yang dipilih.","render.env_reflection":"Pantulan","render.env_ring_help":"Seret gelang untuk memutar pencahayaan. Tahan Shift untuk melekap pada 15°.","render.env_rotate":"Putar","render.env_set":"Tetapkan Persekitaran Render","render.env_shadow_catcher":"Penangkap bayang","render.env_show_environment":"Papar Persekitaran","render.env_source":"Sumber","render.env_stage_details":"Suntingan lantai memerlukan penjejakan sinar dan satu panel lantai. Gunakan Adegan untuk menyunting panel pentas yang lain.","render.env_studios":"Studio","render.environment.albedo":"Albedo","render.environment.atmosphere":"Atmosfera","render.environment.backdrop_note":"Latar hanya dilihat oleh kamera. Ia tidak sekali-kali menerangi, menghasilkan bayang atau memantul, dan ditolak apabila keluaran telus.","render.environment.blur_pending":"Kabur tidak tersedia: enjin render tiada tetapan kekaburan latar.","render.environment.builtin":"HDR terbina dalam","render.environment.check":"Semak fail","render.environment.checked":"Fail HDR telah disemak. Menyimpan akan membenamkan bait ini.","render.environment.choose":"Pilih HDR…","render.environment.constant":"Malar","render.environment.cyclorama":"Siklorama","render.environment.embedded":"Disimpan dalam reka bentuk ini","render.environment.end":"Akhir","render.environment.extinction":"Pemupusan","render.environment.file":"Fail","render.environment.fit":"Muatkan dan simpan lantai","render.environment.floor_wall":"Lantai dan dinding","render.environment.gap":"Jarak kelegaan","render.environment.gradient":"Kecerunan","render.environment.gradient_gpu":"Latar kecerunan memerlukan penjejakan laluan GPU.","render.environment.ground":"Lantai dan pentas","render.environment.hdr":"HDR","render.environment.hdr_file":"Fail HDR","render.environment.horizon":"Ufuk","render.environment.horizontal":"Mendatar","render.environment.keep":"Kekalkan","render.environment.lighting_samples":"Sampel pencahayaan","render.environment.margin":"Jidar julat","render.environment.max":"Sempadan maks","render.environment.medium":"Medium penyertaan","render.environment.min":"Sempadan min","render.environment.mode":"Mod","render.environment.needs_gpu":"Memerlukan penjejakan laluan GPU.","render.environment.none":"Tiada","render.environment.orientation":"Orientasi dan kekuatan","render.environment.phase":"Fasa","render.environment.primaries":"Anggap primer yang tidak ditentukan sebagai sRGB linear","render.environment.primaries_gpu":"Mentafsir primer yang tidak ditentukan memerlukan penjejakan laluan GPU.","render.environment.radial":"Jejarian","render.environment.radial_only":"Pusat dan jejari terpakai pada mod Jejarian.","render.environment.reflectance":"Reflektans","render.environment.remove":"Buang pentas","render.environment.remove_confirm":"Buang pentas yang disimpan?","render.environment.remove_note":"Membuang {count} panel pasif daripada syot ini. Latar kamera kekal.","render.environment.replace":"Sahkan penggantian pentas sedia ada","render.environment.rotation_hdr":"Putaran memerlukan sumber HDR untuk penjejakan sinar CPU.","render.environment.samples_cpu":"Sampel pencahayaan ditetapkan oleh bajet penjejakan laluan GPU; tetapan ini memerlukan penjejakan sinar CPU.","render.environment.saved_panels":"Panel disimpan {count}","render.environment.sky_ground":"Lantai","render.environment.sky_note":"Kecerunan langit asal untuk pencahayaan; bukan atmosfera yang ditentukur.","r