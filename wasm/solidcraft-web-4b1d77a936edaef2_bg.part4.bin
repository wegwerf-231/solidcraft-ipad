aw} · Gelek {roll}","ui.view_angles_roll":"Gelek","ui.view_angles_yaw":"Yaw","ui.view_centre":"Pusat pandangan","ui.viewport_status_clear":"Matikan {name}","ui.viewport_status_clear_hint":"Matikan {name} · Esc","ui.viewport_status_edges":"{count} tepi","ui.viewport_status_from":"dari {direction}","ui.viewport_status_key":"Papar petunjuk untuk {name}","ui.viewport_status_minimum_radius":"Jejari minimum","ui.viewport_status_pairs":"{count} pasangan","ui.viewport_status_section_hatch":"{setting} · lorek","ui.viewport_status_section_plane":"Satah semasa","ui.viewport_status_section_tilted":"condong · {offset}","ui.viewport_status_stripes":"{count} jalur","ui.viewport_status_summary_clear":"Matikan semuanya","ui.viewport_status_summary_heading":"Dalam pandangan ini","ui.viewport_status_summary_label":"{name} dan {count} item lagi","ui.viewport_status_summary_more":"+{count}","ui.viewport_theme_follow":"Ikut tema","ui.visual_shaded_hidden_edges":"Berlorek dengan tepi tersembunyi","ui.visual_shaded_with_edges":"Berlorek dengan tepi","ui.visual_style":"Gaya visual","ui.visual_wireframe":"Rangka dawai","ui.wheel_zoom_speed":"Kelajuan zum roda tetikus","ui.width":"Lebar","ui.window_system":"Sistem tetingkap","ui.window_system_auto":"Automatik","ui.window_system_wayland":"Wayland","ui.window_system_x11":"X11","ui.workspace":"ruang kerja","ui.workspace_animation_description":"Paparan terburai, kajian gerakan dan papan cerita","ui.workspace_available":"Tersedia","ui.workspace_current":"Semasa","ui.workspace_design_description":"Lakar, model, pasang dan periksa","ui.workspace_design_tabs":"Model · Permukaan · Pasang · Sisip · Periksa · Urus · Pandangan","ui.workspace_drawing_description":"Lukisan 2D dengan pandangan, dimensi dan blok tajuk","ui.workspace_footer":"Setiap ruang kerja berfungsi pada reka bentuk, sejarah dan pilihan yang sama; hanya tab reben berubah. Penukar dikunci semasa lakaran atau ciri sedang disunting.","ui.workspace_layout":"Susun atur ruang kerja","ui.worksp