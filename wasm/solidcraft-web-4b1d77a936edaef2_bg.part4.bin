w":"Wkręt dociskowy z gniazdem sześciokątnym, płaski","parts.family.socket_head_cap_screw":"Śruba z łbem walcowym z gniazdem sześciokątnym","parts.family.washer":"Podkładka zwykła","pattern.alignment_2":"Wyrównanie 2","pattern.alignment_hint":"Liczba obejmuje oryginał. Wyśrodkuj rozkłada kopie po obu stronach; Odwróć wybiera stronę z dodatkową kopią przy parzystej liczbie.","pattern.direction_1":"Kierunek 1","pattern.direction_2":"Kierunek 2","pattern.flip_direction":"Odwróć kierunek","perf.click_for_details":"Kliknij, aby zobaczyć szczegóły: wykres czasu klatek, histogram i to, co narysował GPU","perf.draw_calls":"Wywołania rysowania","perf.line_segments":"Odcinki linii","perf.low_1":"1% najniższych","perf.renderer":"Renderer","perf.scene_build":"Budowanie sceny","perf.triangles":"Trójkąty","perf.ui_time":"Czas interfejsu","perf.viewport":"Widok","perf.worst":"najgorszy","pick a body or some of its faces":"wybierz bryłę lub niektóre jej ściany","pick a hole to seat it, or OK places it at the origin":"wybierz otwór, aby go osadzić, lub OK umieszcza go w początku układu","pick a planar face":"wybierz płaską ścianę","pick a plane or a face as the tool":"wybierz płaszczyznę lub ścianę jako narzędzie","pick a size":"wybierz rozmiar","pick edges of a body":"wybierz krawędzie bryły","pick edges of one body":"wybierz krawędzie jednej bryły","pick edges of the holes to remove":"wybierz krawędzie otworów do usunięcia","pick faces of one body":"wybierz ściany jednej bryły","pick faces to offset":"wybierz ściany do odsunięcia","pick lines of one sketch":"wybierz linie jednego szkicu","pick one or two vertices, edges or faces":"wybierz jeden lub dwa wierzchołki, krawędzie lub ściany","pick one plane or face as the tool, or sketch curves":"wybierz jedną płaszczyznę lub ścianę jako narzędzie albo krzywe szkicu","pick sections in two or more sketches":"wybierz przekroje w dwóch lub więcej szkicach","pick sketch curves or edges":"wybierz krzywe szkicu lub krawędzie","pick the face to untrim":"wybierz ścianę do cofnięcia przycięcia","pick the path":"wybierz ścieżkę","pick what to keep":"wybierz, co zachować","pick what to keep of the other surface":"wybierz, co zachować z drugiej powierzchni","prefs.add_item":"Dodaj element","prefs.alt_frees_manipulators":"Alt / Option zwalnia również strzałki manipulatora","prefs.anti_aliasing_amd_dx12":"Wygładzanie krawędzi używa 1×, ponieważ test przy uruchomieniu nic nie narysował z wielopróbkowaniem i przeszedł przy 1×. Możesz wybrać inne ustawienie powyżej; uruchom ponownie, aby je zastosować, jeśli test przejdzie.","prefs.anti_aliasing_note":"Wygładza poszarpane krawędzie.","prefs.applies_on_restart":"Działa po ponownym uruchomieniu","prefs.assistant":"Asystent","prefs.auto_operation":"Wybieraj operację automatycznie","prefs.auto_operation_note":"Okna funkcji wybierają Połącz, Nowa bryła lub Wytnij na podstawie tego, czego dotyka nowy materiał, dopóki nie wybierzesz sam. Wyłączone: zachowują operację, z którą się otwierają.","prefs.axes":"Osie","prefs.axis":"Oś","prefs.bodies_folders":"Foldery brył","prefs.bodies_folders_always":"Zawsze","prefs.bodies_folders_never":"Nigdy","prefs.bodies_folders_several":"Tylko przy kilku bryłach","prefs.bottom":"Dół","prefs.bottom_centre":"Dół pośrodku","prefs.bottom_right":"Dół z prawej","prefs.browser":"Przeglądarka","prefs.browser_reveal_on_hover":"Pokazuj po najechaniu","prefs.browser_show_note":"Widoczna utrzymuje przeglądarkę na ekranie. Pokazuj po najechaniu ukrywa ją, dopóki wskaźnik nie znajdzie się w jej miejscu lub na cienkiej karcie przy jej lewej krawędzi; pozostaje otwarta, gdy wskaźnik jest w niej lub otwarte jest jej menu.","prefs.browser_shown":"Widoczna","prefs.built_in":"Wbudowana","prefs.button_left":"Przeciąganie lewym","prefs.button_middle":"Przeciąganie środkowym","prefs.button_right":"Przeciąganie prawym","prefs.choose_font":"Wybierz plik czcionki…","prefs.click":"Kliknięcie","prefs.contact_shading":"Miękkie cieniowanie kontaktowe","prefs.contact_shading_note":"Miękkie cieniowanie tam, gdzie części są blisko siebie.","prefs.context_menu":"Menu kontekstowe","prefs.context_menu_ring":"Menu kontekstowe · przytrzymaj, aby otworzyć menu promieniste","prefs.cpu":"CPU (programowo)","prefs.crash_reports":"Otwórz raporty o awariach…","prefs.crash_reports_note":"Raporty są przechowywane na tym komputerze, razem z projektem i poleceniami, które odtwarzają problem.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Powierzchnie zakrzywione","prefs.curves":"Powierzchnie zakrzywione","prefs.dead_zone_note":"Zakreskowany pas to strefa martwa: ruch wewnątrz niej jest pomijany.","prefs.default":"domyślnie","prefs.design":"Ustawienia domyślne projektu","prefs.design_note":"Ustawienia, z którymi startują nowe projekty. Otwarte projekty zachowują własne.","prefs.devices":"Mysz 3D","prefs.dialog_buttons":"Przyciski okien dialogowych","prefs.dialogs":"Okna dialogowe","prefs.dialogs_edge":"Przy krawędzi widoku","prefs.dialogs_left_column":"W lewej kolumnie","prefs.dialogs_note":"Gdzie otwierają się okna poleceń: zadokowane przy krawędzi widoku albo w lewej kolumnie w miejscu przeglądarki i Historii, które wracają na swoje miejsce po zamknięciu okna.","prefs.display":"Wyświetlanie","prefs.edges":"Krawędzie i cieniowanie","prefs.extend":"Rozszerz","prefs.extra_navigation":"Ctrl+przeciąganie lewym na pustym miejscu obraca widok; przytrzymaj Spację, aby przesuwać.","prefs.follows_os":"Zgodnie z systemem","prefs.font":"Czcionka","prefs.font_fallback":"Znaki, których brakuje w wybranej czcionce, są brane z czcionki wbudowanej, więc żadna etykieta nie pokaże pustego prostokąta.","prefs.font_sample":"Zażółć gęślą jaźń · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"Nie można odczytać wybranej czcionki.","prefs.general":"Ogólne","prefs.general_note":"Język, zapisywanie i aktualizacje.","prefs.gesture_orbit":"Obracanie widoku","prefs.gesture_pan":"Przesuwanie","prefs.gesture_zoom":"Powiększanie","prefs.graphics":"Grafika","prefs.graphics_card":"Karta graficzna","prefs.graphics_card_auto":"Automatycznie","prefs.graphics_card_missing":"Zapisana karta graficzna jest niedostępna; używane jest ustawienie Automatycznie.","prefs.graphics_card_restart":"Działa po ponownym uruchomieniu SolidCraft. WGPU_ADAPTER_NAME ma pierwszeństwo przed tym wyborem.","prefs.graphics_note":"Wybierz między szybkością a gładkością. Każda opcja pokazuje swój efekt na przykładzie.","prefs.graphics_presets_note":"Ustawienia wstępne zmieniają razem poniższe opcje.","prefs.history":"Historia","prefs.history_origin_bodies":"Pokazuj początek układu i bryły na górze","prefs.history_origin_bodies_note":"Historia po lewej lub pod przeglądarką zaczyna się od folderu Bryły aktywnego komponentu i Początku układu, z ikonami oka i menu jak w przeglądarce. Historia na dole pozostaje bez zmian.","prefs.history_play_button":"Przycisk Odtwórz historię w elementach sterujących Historii","prefs.history_play_button_note":"Umieszcza Odtwórz historię między Cofnij o jeden krok a Przejdź o jeden krok do przodu w elementach sterujących Historii. Możesz też kliknąć je prawym przyciskiem, aby go pokazać lub ukryć.","prefs.history_sketches":"Szkice","prefs.history_sketches_in_order":"W kolejności","prefs.history_sketches_note":"Gdy Szkice są ustawione na Pod swoją funkcją, Historia po lewej pokazuje każdy szkic o poziom głębiej, pod pierwszą zbudowaną z niego funkcją, o ile jest dość szeroka na nazwy. Oś czasu na dole zawsze zachowuje kolejność tworzenia.","prefs.history_sketches_under_feature":"Pod swoją funkcją","prefs.hold_stop_snapping":"Przytrzymaj, aby wyłączyć przyciąganie","prefs.icons_only":"Tylko ikony","prefs.imported_file":"Zaimportowany plik","prefs.in_browser":"W przeglądarce","prefs.input":"Wprowadzanie","prefs.interface":"Interfejs","prefs.interface_language":"Język interfejsu","prefs.interface_note":"Wygląd SolidCraft i rozmieszczenie jego elementów.","prefs.interval_minutes":"{n} min","prefs.labels":"Etykiety","prefs.layout":"Układ","prefs.layout_note":"Kompaktowy dokuje panele do krawędzi okna. Przezroczystość przeglądarki jest dostępna w układzie Pływający. Stronę asystenta zmienisz na stronie Asystent.","prefs.left":"Lewo","prefs.left_click":"Kliknięcie lewym","prefs.line_drag_draws_one":"Naciśnięcie i przeciągnięcie rysuje jedną linię","prefs.line_drag_draws_one_note":"W narzędziu Linia naciśnięcie, przeciągnięcie i puszczenie rysuje jedną linię od miejsca naciśnięcia do puszczenia i na tym się kończy. Kliknięcia nadal rysują łańcuch. Wyłączone: przeciągnięcie stawia punkt w miejscu puszczenia, tak jak kliknięcie.","prefs.linked_designs":"Projekty połączone","prefs.live_input":"Bieżące wejście","prefs.live_preview":"Podgląd na żywo","prefs.logo":"Logo","prefs.logo_accent":"Akcent","prefs.logo_theme":"Kolory motywu","prefs.max_file_size":"Maksymalny rozmiar otwieranego pliku","prefs.max_file_size_design":"Pliki projektów","prefs.max_file_size_flag":"To uruchomienie używa --max-file-size {size} aż do zamknięcia SolidCraft. Te ustawienia obowiązują przy uruchomieniu bez tej opcji.","prefs.max_file_size_note":"Domyślnie: 512 MB i 256 MB; maksymalnie 16 GB. Otwarcie pliku wymaga pamięci kilkakrotnie większej od jego rozmiaru. Projekt z dużym importem może wymagać wyższego limitu pliku projektu, aby go zapisać i ponownie otworzyć.","prefs.max_file_size_step":"Pliki STEP i importu","prefs.max_file_size_web":"Aplikacja internetowa otwiera pliki STEP i importu do 512 MB oraz projekty do 256 MB: karta przeglądarki nie pomieści większych plików. W aplikacji komputerowej można zwiększyć te limity.","prefs.megabytes":"MB","prefs.minutes":"minut","prefs.minutes_suffix":" min","prefs.mouse":"Mysz i gładzik","prefs.mouse_heading":"Mysz","prefs.mouse_mapping":"Przypisanie przycisków myszy","prefs.navigation":"Nawigacja","prefs.navigation_note":"Jak mysz, gładzik i mysz 3D poruszają widokiem.","prefs.network_host_remove":"Usuń","prefs.network_locations":"Zezwalaj na lokalizacje sieciowe w projektach","prefs.network_locations_note":"Wyłączone: połączone pliki projektu na innym komputerze (\\\\serwer\\udział) są otwierane tylko z serwerów wymienionych tutaj albo po zezwoleniu, gdy pojawi się pytanie.","prefs.network_locations_section":"Lokalizacje sieciowe","prefs.not_on_gpu":"niedostępne na tym GPU","prefs.on":"Włączone","prefs.opaque":"Nieprzezroczysta","prefs.orbit_snap":"Przytrzymaj Shift podczas obracania widoku, aby przyciągnąć do osi.","prefs.orientation":"Orientacja","prefs.origin_plane_names":"Nazwy płaszczyzn początku układu","prefs.origin_plane_names_note":"Nazwy pokazywane w przeglądarce, oknach dialogowych i listach. {top} to XY, {front} to XZ, a {right} to YZ, przy osi Z w górę. Polecenia, skrypty i zapisane projekty zachowują XY, XZ i YZ.","prefs.overall_speed":"Szybkość ogólna","prefs.perspective_fov":"Pole widzenia","prefs.placement":"Umieszczanie","prefs.prefer_free_sketch_points":"Przy nakładających się punktach preferuj ruchome punkty szkicu","prefs.preview_choices":"Podgląd wybranych opcji","prefs.print_face_highlight":"Wyróżnienie powierzchni druku","prefs.print_face_highlight_tip":"Jak mocno powierzchnia druku bryły jest barwiona i obrysowywana w widoku. 0 % nie pokazuje wyróżnienia.","prefs.profile_active":"Aktywny profil","prefs.profile_applied":"Zastosowano profil.","prefs.profile_changed":"Ustawienia zmieniły się od zapisania profilu. Zapisz zachowa je w nim.","prefs.profile_deleted":"Usunięto profil.","prefs.profile_export":"Eksportuj…","prefs.profile_exported":"Wyeksportowano profil.","prefs.profile_imported":"Zaimportowano profil. Wybierz go w polu Aktywny profil, aby się na niego przełączyć.","prefs.profile_name_hint":"Nazwa profilu, np. Laptop","prefs.profile_rename":"Zmień nazwę","prefs.profile_renamed":"Zmieniono nazwę profilu.","prefs.profile_save":"Zapisz","prefs.profile_saved":"Zapisano bieżące ustawienia w profilu.","prefs.profile_skipped":"Zastosowano profil; ustawienia, które zachowały bieżącą wartość: {n} (zobacz dziennik).","prefs.profiles":"Profile ustawień","prefs.profiles_note":"Skróty, pasek narzędzi, nawigacja, menu promieniste i ustawienia interfejsu, zebrane pod jedną nazwą i przełączane naraz.","prefs.project_options_dialog":"Okno opcji rzutowania","prefs.project_options_dialog_note":"Włączone: przed rzutowaniem wybierz Geometria lub Bryły oraz Powiązanie rzutu. Wyłączone: zachowaj poprzedni sposób bezpośredniego wybierania.","prefs.quality_default":"domyślnie","prefs.quality_fastest":"najszybciej","prefs.quality_slowest":"najwolniej","prefs.quality_smoother":"gładziej","prefs.render_previous_geometry_budget":"Używaj poprzedniego budżetu geometrii podglądu renderowania","prefs.render_previous_geometry_budget_help":"Przywraca poprzedni stały limit geometrii (512 MiB na 64-bitowym komputerze stacjonarnym, 128 MiB w innych przypadkach) zamiast budżetu zależnego od urządzenia.","prefs.reports_saved":"Zapisane: {n}","prefs.ribbon_reveal":"Pokazuj wyniki wyszukiwania na wstążce","prefs.ribbon_reveal_note":"Najechanie na wynik w Szukaj poleceń pokazuje, gdzie polecenie znajduje się na wstążce: jego kartę, przycisk lub wiersz w rozwijanej liście panelu. Polecenie uruchomione z wyszukiwania miga w tym miejscu, a działające polecenie z rozwijanej listy oznacza swój panel.","prefs.right_click":"Kliknięcie prawym","prefs.saving":"Autozapis i odzyskiwanie","prefs.scale_note":"Także Ctrl + / Ctrl − w oknie. Przyciski mają 28 px przy 100%.","prefs.scale_text":"Skala i tekst","prefs.search":"Szukaj w preferencjach","prefs.search_empty":"Brak pasujących preferencji","prefs.select":"Zaznacz","prefs.select_one_item":"Zaznacz jeden element","prefs.selecting":"Zaznaczanie","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift tylko dodaje; Ctrl / Cmd przełącza","prefs.shift_add_note":"Włączone: Shift dodaje, Ctrl / Cmd przełącza. Wyłączone (domyślnie): oba przełączają.","prefs.shortcuts":"Skróty","prefs.single_surface_analysis":"Używaj jednej analizy powierzchni","prefs.single_surface_analysis_help":"Gdy wyłączone, cieniowanie powierzchni i Ciągłość mogą być włączone jednocześnie. Włączenie zachowuje ostatnio uruchomioną lub zmienioną analizę.","prefs.sketch_align_points":"Wyrównuj do innych punktów szkicu podczas rysowania","prefs.sketch_align_points_note":"Podczas rysowania punkt wyrównuje się jednocześnie poziomo z jednym punktem szkicu i pionowo z innym, z kropkowaną linią pomocniczą, a kliknięcie zachowuje oba wyrównania. Wyłączone: tylko z poprzednim punktem, po jednej osi.","prefs.sketch_conflict_colour":"Geometria w konflikcie w kolorze konfliktu","prefs.sketch_conflict_colour_note":"Gdy wiązania szkicu są w konflikcie, krzywe i punkty trzymane przez niespełnione wiązanie też są rysowane w kolorze konfliktu, a nie tylko jego symbol lub wymiar. Wyłączone: zachowują zwykłe kolory.","prefs.sketch_exit_view":"Po zakończeniu szkicu","prefs.sketch_exit_view.keep":"Zachowaj bieżący widok","prefs.sketch_exit_view.previous":"Wróć do poprzedniego widoku","prefs.sketch_exit_view.unless_rotated":"Wróć, chyba że obrócono widok","prefs.sketch_exit_view_note":"Dokąd przechodzi widok po Zakończ szkic, Anuluj lub podwójnym Esc.","prefs.sketch_selection":"Szkic i zaznaczanie","prefs.sketch_selection_heading":"Szkic i zaznaczanie","prefs.sketch_selection_note":"Jak działa przyciąganie w szkicach i jak kliknięcia zaznaczają.","prefs.sketch_state_icons":"Ikony szkiców w kolorze ich stanu","prefs.sketch_state_icons_note":"W Historii i przeglądarce ikona szkicu przyjmuje kolor jego stanu (niedostatecznie związany, w pełni związany lub w konflikcie), a podpowiedź podaje ten stan. Wyłączone: każdy szkic ma tę samą ikonę.","prefs.sketch_tab_always":"Zawsze pokazuj kartę Szkic","prefs.sketch_tab_always_note":"Karta Szkic pozostaje na wstążce, zaraz po Model, nawet gdy żaden szkic nie jest otwarty. Jej narzędzia rysunkowe zaczynają wtedy szkic na zaznaczonej płaszczyźnie lub ścianie albo na następnej wybranej płaszczyźnie, z gotowym narzędziem.","prefs.sketch_tracking_guides":"Linie pomocnicze wyrównania do środków i punktów środkowych","prefs.sketch_tracking_guides_note":"Najedź na środek okręgu lub punkt środkowy prostej krawędzi, a potem przesuń w poziomie lub pionie, aby pokazać tymczasową kropkowaną linię pomocniczą.","prefs.sketching":"Szkicowanie","prefs.snap_drawing_note":"Podczas rysowania lub przeciągania punktu szkicu.","prefs.source":"Źródło","prefs.speed":"Szybkość","prefs.stand_up_note":"Gdy plik STEP lub IGES otworzy się z osią Z w górę, proponuj obrót o ćwierć obrotu wokół osi X.","prefs.stand_up_unknown":"Dla plików z nieznanych programów","prefs.stand_up_unknown.ask":"Pytaj w oknie dialogowym","prefs.stand_up_unknown.note":"Pokaż uwagę","prefs.stand_up_unknown.off":"Nie proponuj","prefs.stand_up_unknown_note":"Jak składana jest propozycja, gdy nagłówek pliku nie wskazuje programu, o którym wiadomo, że zapisuje z osią Y w górę. Uwaga pojawia się tylko, gdy plik wydaje się leżeć na plecach; Pytaj w oknie dialogowym pyta o każdy taki plik, jak dotąd.","prefs.status_bar":"Pasek stanu","prefs.status_bar_note":"Cienki pasek wzdłuż dolnej krawędzi okna pokazuje, co jest edytowane, stan otwartego szkicu w jego kolorze i jednostki projektu; kliknięcie jednostek je zmienia. Stan szkicu nie jest wtedy pokazywany w rogu widoku.","prefs.status_done":"Gotowe","prefs.status_error":"Błąd","prefs.status_selected":"Zaznaczone","prefs.status_warning":"Ostrzeżenie","prefs.supersampling_brief":"Rysuje widok w większym rozmiarze i go zmniejsza: bardzo ostro, ale bardziej obciąża.","prefs.tab_accent_note":"Kolor akcentu podąża za aktywną kartą","prefs.theme_file":"plik motywu","prefs.theme_file_or_paste":"plik lub wklejenie","prefs.theme_follow":"Śledź plik motywu","prefs.theme_follow_error":"Nie zastosowano: {error}. Ostatni poprawny motyw pozostaje aktywny.","prefs.theme_follow_launch":"Śledzenie tylko w tej sesji (--theme-file); plik jest wczytywany ponownie po każdym nadpisaniu przez inne narzędzie.","prefs.theme_follow_note":"Plik jest wczytywany ponownie po każdym nadpisaniu przez inne narzędzie. Wybór motywu kończy śledzenie.","prefs.theme_follow_off":"Wyłączone","prefs.theme_follow_stop":"Zakończ śledzenie","prefs.theme_import_hint":"Kliknij, aby wybrać plik motywu, upuść go tutaj albo naciśnij Ctrl+V (Cmd+V na Macu), mając skopiowany motyw","prefs.theme_paste":"Wklej motyw","prefs.theme_paste_none":"Schowek nie zawiera motywu SolidCraft","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"teraz","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Powiadomienia","prefs.toggle_item":"Dodaj element lub usuń go ponownie","prefs.toolbar":"Pasek narzędzi","prefs.toolbar_tabs":"Karty paska narzędzi","prefs.top":"Góra","prefs.trackpad_zoom_modifier":"Powiększaj przewijaniem dwoma palcami, trzymając","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Przytrzymaj tylko ten klawisz, aby powiększać w miejscu wskaźnika przewijaniem w pionie. Wyłączone zachowuje dotychczasowe przewijanie.","prefs.trackpad_zoom_modifier.off":"Wyłączone","prefs.translucent":"Półprzezroczysta","prefs.under_browser":"Pod przeglądarką","prefs.under_cursor":"Pod kursorem","prefs.units_precision":"Jednostki i dokładność","prefs.updates":"Aktualizacje","prefs.view":"Zachowanie widoku","prefs.view_confirm_corner":"OK i Anuluj w rogu widoku","prefs.view_confirm_corner_note":"Gdy otwarte jest okno dialogowe lub szkic, znaczek i krzyżyk w prawym górnym rogu widoku działają jak OK i Anuluj w oknie albo kończą i anulują szkic. Nawigator widoku przesuwa się pod nie.","prefs.viewport":"Widok","prefs.viewport_background":"Tło","prefs.viewport_background_colour":"Kolor","prefs.viewport_background_theme":"Gradient motywu","prefs.wheel":"Kółko","prefs.wheel_trackpad":"Kółko i gładzik","prefs.workspace":"Środowisko pracy","prefs.zoom_stop_at_model":"Zatrzymuj powiększanie na modelu","prefs.zoom_stop_at_model_tip":"Mysz 3D i aplikacja urządzenia powiększają w stronę powierzchni na środku widoku; powiększanie przeciąganiem trzyma punkt, w którym zaczęło się przeciąganie. Wyłączone: powiększanie może przejść przez model. Kółko i szczypanie osobno używają Powiększaj w stronę kursora","prefs.zoom_toward_cursor":"Powiększanie w stronę kursora","properties.title":"Właściwości: {name}","recovery.days_ago":"{count} dni temu","recovery.detail":"{file} · elementy: {features} · autozapis {when}","recovery.hours_ago":"{count} godz. temu","recovery.just_now":"przed chwilą","recovery.min_ago":"{count} min temu","recovery.never_saved":"nigdy nie zapisano","render.background":"Tło sceny","render.fit":"Dopasuj produkt","render.image_cancelled":"Anulowano renderowanie","render.image_cancelling":"Anulowanie","render.image_completed":"Obraz gotowy do eksportu","render.image_encoding":"Kodowanie PNG","render.image_export":"Eksportuj PNG","render.image_failed":"Renderowanie nie powiodło się","render.image_height":"Wysokość","render.image_help":"Obraz podglądu CPU · PNG · przybliżona przezroczystość","render.image_overwrite":"Zastąp istniejący plik","render.image_preparing":"Przygotowywanie obrazu","render.image_queued":"Oczekiwanie na renderowanie","render.image_reduce":"Spróbuj mniejszego obrazu lub prostszej sceny.","render.image_running":"Renderowanie obrazu","render.image_stale":"Ten obraz używa sceny uchwyconej przed późniejszymi zmianami.","render.image_start":"Rozpocznij renderowanie","render.image_supported":"Zlecenie renderowania jest obsługiwane; kolejka i pula pamięci zostaną ponownie sprawdzone przy starcie.","render.image_title":"Renderuj obraz","render.image_too_large":"Przekroczono limit obrazu: 4096 pikseli na bok i łącznie 4 194 304 piksele.","render.image_transparent":"Przezroczyste tło","render.image_unknown":"Stan renderowania niedostępny","render.image_use_largest":"Użyj największego rozmiaru o tych proporcjach:","render.image_width":"Szerokość","render.navigation_help":"Kamera porusza się jak w środowisku Projekt (Preferencje › Nawigacja). Zapisz ustawienia zapamiętuje bieżącą kamerę.","render.opaque_image_summary":"Podgląd PNG · nieprzezroczysty PBR · mieszana przezroczystość","render.opaque_preview_help":"Nieprzezroczysty PBR i proste kolory; mieszana przezroczystość. Załamanie, HDRI i renderowanie końcowe nie są jeszcze dostępne.","render.perspective":"Kamera perspektywiczna","render.preview":"Wbudowany podgląd","render.preview_help":"Cieniowanie rastrowe i mieszana przezroczystość. Załamanie, HDRI i renderowanie końcowe nie są jeszcze dostępne.","render.reload_settings":"Wczytaj ponownie zapisane ustawienia","render.restore_camera":"Przywróć zapisaną kamerę","render.return_design":"Wróć do projektu","render.save_setup":"Zapisz ustawienia","render.setup_name":"Nazwa ustawień","render.unavailable_preview":"Te ustawienia wymagają niedostępnego profilu podglądu.","render.unsaved":"Niezapisane zmiany podglądu","render.use_preview":"Użyj wbudowanego podglądu","sample.bracket.about":"Kołnierz bazowy z kołnierzami krawędziowymi i zawinięciem według reguły 2 mm","sample.bracket.name":"Wspornik z blachy","sample.enclosure.about":"Skorupowa obudowa z zakładką, występami pod wkręty, podparciem i zatrzaskiem","sample.enclosure.name":"Obudowa z tworzywa","sample.flange.about":"Piasta z kołnierzem i szykiem kołowym sterowanym parametrem","sample.flange.name":"Kołnierz skręcany","sample.hinge.about":"Dwa komponenty i złącze obrotowe ustawione na 60°","sample.hinge.name":"Zespół zawiasu","sample.plate.about":"Parametryczna płyta z zaokrągleniami, otworami i rozwierconym występem","sample.plate.name":"Przykładowa płyta","sample.vents.about":"Rowki w szyku prostokątnym: wiersze, kolumny i rozstaw są parametrami","sample.vents.name":"Płyta wentylacyjna","search.command_keys":"Enter uruchom     Shift+Enter uruchom i zostaw otwarte     Esc zamknij","search.commands":"Polecenia","search.design":"W tym projekcie","search.feature":"Element","search.invalid":"Nieprawidłowe","search.keys":"↑ ↓ wybierz     Enter uruchom     Tab uzupełnij nazwę     Esc zamknij","search.no_match":"Żadne polecenie nie pasuje do „{query}”","search.parameter":"Parametr","search.recent":"Ostatnie","search.run":"Uruchom polecenie","search.suggest":"Czy chodziło o {label}?","search.try":"Wpisz nazwę polecenia, element tego projektu lub parametr. Aby uruchomić polecenie z wartościami, wpisz jego identyfikator i obiekt JSON: {example}","search.valid":"Prawidłowe","section.off_hint":"Nie wybrano płaszczyzny: OK wyłącza przekrój.","select a direction (an axis, a sketch line or a straight edge) first":"najpierw zaznacz kierunek (oś, linię szkicu lub prostą krawędź)","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"zaznacz kierunek (oś, linię szkicu lub prostą krawędź), za którym ma podążać profil","select a point on a component":"zaznacz punkt na komponencie","select a profile, edges or sketch lines first":"najpierw zaznacz profil, krawędzie lub linie szkicu","select an axis":"zaznacz oś","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"najpierw zaznacz oś, prostą lub okrągłą krawędź albo ścianę walca, stożka lub torusa","select bodies first":"najpierw zaznacz bryły","select components first":"najpierw zaznacz komponenty","select corner points, or the two lines of one corner":"zaznacz punkty naroży lub dwie linie jednego naroża","select one corner point, or the two lines of one corner":"zaznacz jeden punkt naroża lub dwie linie jednego naroża","select sheet edges first":"najpierw zaznacz krawędzie blachy","select the bend line (a sketch line) first":"najpierw zaznacz linię gięcia (linię szkicu)","select the cam's profile (a sketch profile or the cam's edges)":"zaznacz profil krzywki (profil szkicu lub krawędzie krzywki)","select the corner to cut first":"najpierw zaznacz naroże do ścięcia","select the corners to round first":"najpierw zaznacz naroża do zaokrąglenia","select the fixed face first (a plate's large face)":"najpierw zaznacz ścianę stałą (dużą ścianę płyty)","select the frame sketch's lines first":"najpierw zaznacz linie szkicu ramy","select the path (sketch lines across the edge)":"zaznacz ścieżkę (linie szkicu w poprzek krawędzi)","select the rim face first":"najpierw zaznacz ścianę obrzeża","select the sheet edge first":"najpierw zaznacz krawędź blachy","select two components":"zaznacz dwa komponenty","set by the sketch's lines":"wyznaczone przez linie szkicu","settings.display_quality_note":"Wyższe poziomy rysują zakrzywione ściany i krawędzie gładziej, ale siatka powstaje dłużej. Zmienia się tylko widok, nigdy projekt ani eksport.","settings.double_click_components":"Kliknij dwukrotnie komponent, aby go aktywować lub edytować połączony komponent w miejscu","settings.frame_rate_details_note":"Dodaje wykres czasów ostatnich klatek z nałożoną liczbą rysowanych trójkątów, histogram czasów klatek i to, co narysował GPU. Kliknij liczbę klatek w widoku, aby je pokazać lub ukryć.","settings.frame_rate_note":"Pokazuje liczbę klatek na sekundę w prawym dolnym rogu widoku.","settings.insert_lists_open_designs":"Wstaw projekt pokazuje najpierw projekty otwarte w innych kartach","settings.measure_axis_distances":"Pokaż odległości X/Y/Z","settings.measure_axis_distances_help":"Gdy pomiar jest otwarty, pokazuj składowe wzdłuż osi globalnych obok odległości całkowitej.","settings.msaa_applies_on_restart":"Wygładzanie krawędzi zadziała po ponownym uruchomieniu SolidCraft","settings.msaa_reset":"{setting}: {requested}× nie jest obsługiwane przez to urządzenie graficzne; ustawiono {reset}× (obsługiwane: {supported}).","settings.msaa_unsupported":"Nieobsługiwane przez to urządzenie graficzne","settings.reference_geometry_through_bodies":"Pokaż geometrię odniesienia przez bryły","settings.reference_geometry_through_bodies_help":"Rysuj kontury nieaktywnych szkiców i płaszczyzny odniesienia na cieniowanych bryłach","settings.reset_intro":"Te ustawienia nie działają na tym komputerze i uniemożliwiłyby uruchomienie SolidCraft, więc zostały zmienione:","settings.reset_title":"Zmieniono ustawienia","settings.supersampling_note":"Rysuje widok w wyższej rozdzielczości i go zmniejsza: gładsze krawędzie, linie i siatka na ekranach poniżej 4K. Kosztuje czas GPU: ok. 2,25× więcej pikseli przy 1,5× i 4× przy 2×.","settings.update_changed_links":"Aktualizuj zmienione połączone projekty po powrocie do karty","settings.window_system_details":"Szczegóły","settings.window_system_note_now":"Działa po ponownym uruchomieniu. Teraz: {now}.","settings.window_system_wayland_limited":"Niektóre funkcje są ograniczone w natywnym Wayland.","sheet.flange_type_base":"Bazowy","sheet.flange_type_contour":"Konturowy","sheet.flange_type_edge":"Krawędziowy","sheet.no_body":"nie ma bryły blaszanej: zacznij ją przez Kołnierz > Bazowy albo zamień płytę w blachę przez Konwertuj na blachę (wybierz jej dużą płaską ścianę)","shortcut.json_error":"parametry muszą być w formacie JSON: {error}","shortcut.no_command":"nie ma polecenia `{id}`; tekst przed JSON musi być identyfikatorem polecenia","shortcut.pin":"Przypnij na górze pola S","shortcut.unpin":"Odepnij","sketch is missing":"brak szkicu","sketch.degrees_of_freedom":"Stopnie swobody: {count}","sketch.dimension_added_driven":"Szkic już określa ten wymiar, więc dodano go jako wymiar sterowany (referencyjny)","sketch.dimension_applied":"Wymiar zastosowany","sketch.dimension_applied_defined":"Wymiar zastosowany; zdefiniowano parametr `{name}`","sketch.dimension_applied_renamed":"Wymiar zastosowany; parametr nazywa się teraz `{name}`","sketch.dof_left":"Pozostałe stopnie swobody: {count}","sketch.dof_left_one":"Pozostał {count} stopień swobody","sketch.draw_curves":"Rysuj jako {linetype}","sketch.make_selection":"Zamień zaznaczenie na {linetype}","sketch.open_ends":"Otwarte: {count}","sketch.status_conflict":"wiązania w konflikcie","sketch.status_fully_constrained":"w pełni związany","sketch.untied_ends":"Niezwiązane: {count}","sketch_panel.attached":"Dołączony do {body} / {path}","sketch_panel.author":"Pierwotne położenie: {path}","sketch_panel.dimension_hint":"Wprowadź wartość lub wyrażenie, a następnie naciśnij OK.","sketch_panel.move_hint":"Wprowadź odległości i kąt, a następnie naciśnij OK.","sketch_panel.plane_angle":"{plane}, obrócona o {angle}","sketch_panel.plane_fixed":"Stała płaszczyzna","sketch_panel.plane_flipped":"{plane}, od drugiej strony","sketch_panel.plane_offset":"{plane}, odsunięta o {distance}","sketch_panel.plane_origin":"Płaszczyzna {plane}","sketch_panel.redefine_title":"{command}: {name}","sketch_panel.sheet_attachment":"Dołączony do płaskiej ściany bryły blaszanej; podąża za tym panelem przy zmianach blachy.","sketch_panel.text_hint":"Edytuj tekst i jego położenie, a następnie naciśnij OK.","sketch_panel.use_plane":"Użyj płaszczyzny {plane}","sketch_text.align_center":"Do środka","sketch_text.align_left":"Do lewej","sketch_text.align_right":"Do prawej","sketch_text.bold":"Pogrubienie","sketch_text.builtin_font":"{family} (wbudowana)","sketch_text.italic":"Kursywa","sketch_text.loading_fonts":"Wyszukiwanie zainstalowanych czcionek…","sketch_text.on_path":"Tekst biegnie wzdłuż ścieżki: krzywa go rozmieszcza","sketch_text.path_clear":"Zdejmij tekst z krzywej","sketch_text.path_hint":"Krzywa szkicu, wzdłuż której biegnie tekst: kliknij tutaj, a potem krzywą","sketch_text.use_font_file":"Użyj pliku czcionki {path}","solid":"bryła","status.editing":"Edycja: {name}","status.navigation":"Przypisanie myszy: {mapping}","status.navigation_tip":"Jak mysz porusza widokiem. Kliknij, aby wybrać inne przypisanie","status.under_constrained":"Niedostatecznie związany (stopnie swobody: {count})","status.under_constrained_one":"Niedostatecznie związany (stopnie swobody: {count})","status.units_tip":"Jednostki projektu. Kliknij, aby je zmienić","the angle must be a number":"kąt musi być liczbą","the curves must be in one sketch":"krzywe muszą leżeć w jednym szkicu","the direction must be an axis, a sketch line or a straight edge":"kierunek musi być osią, linią szkicu lub prostą krawędzią","the duration must be a number of seconds, 0.001 or more":"czas trwania musi być liczbą sekund, co najmniej 0,001","the line's sketch is gone":"szkic linii już nie istnieje","the lines must be in one sketch":"linie muszą leżeć w jednym szkicu","the lines must be in one sketch, not the section's":"linie muszą leżeć w jednym szkicu, innym niż szkic przekroju","the parts library is empty":"biblioteka części jest pusta","the parts library is not available":"biblioteka części jest niedostępna","the path curves must be in one other sketch":"krzywe ścieżki muszą leżeć w jednym, innym szkicu","the path's sketch is gone":"szkic ścieżki już nie istnieje","the position must be a number":"położenie musi być liczbą","the preview failed":"podgląd się nie powiódł","the profiles and curves must be in one sketch":"profile i krzywe muszą leżeć w jednym szkicu","the reference face must be on the edges' body":"ściana odniesienia musi leżeć na bryle tych krawędzi","the scale must be above 0":"skala musi być większa od 0","the section's profiles must be in one sketch":"profile przekroju muszą leżeć w jednym szkicu","the two origins are on the same component":"oba początki leżą na tym samym komponencie","thread.automatic_size":"Rozmiar automatyczny","thread.designation":"Oznaczenie","thread.direction":"Kierunek gwintu","thread.iso_metric":"Metryczny ISO","thread.left_hand":"Lewy","thread.right_hand":"Prawy","thread.select_size":"Wybierz rozmiar","timeline.delete_after_marker_one":"Usuń 1 funkcję za znacznikiem historii","timeline.delete_after_marker_other":"Usuń funkcje za znacznikiem historii: {count}","timeline.delete_folders_tip":"Zachowaj ich funkcje i zagnieżdżone foldery w historii","timeline.delete_folders_with_features_tip":"Usuń foldery razem ze wszystkimi funkcjami w nich i zagnieżdżonymi folderami","timeline.delete_many":"Usuń zaznaczone funkcje: {count}","timeline.edited_rolled_back":"{name} się zmieniła, ale leży za znacznikiem historii, więc nie jest budowana: przesuń znacznik za nią, aby zobaczyć wynik","timeline.feature_error":"Błąd: {message}","timeline.feature_hint":"Kliknij dwukrotnie, aby edytować · przeciągnij, aby zmienić kolejność · prawy przycisk, aby zobaczyć więcej","timeline.feature_rolled_back":"Cofnięta: leży za znacznikiem historii, więc nie jest budowana","timeline.feature_warning":"Ostrzeżenie: {message}","timeline.group":"Nowy folder funkcji","timeline.move_many":"Przenieś elementy osi czasu","timeline.move_to_group":"Przenieś funkcje do folderu","timeline.rename_group":"Zmień nazwę folderu funkcji","timeline.reorder_many":"Zmień kolejność funkcji","timeline.suppress_features":"Wygaś funkcje","timeline.suppress_folders_tip":"Wygaś lub przywróć każdą funkcję w folderach i ich zagnieżdżonych folderach","timeline.ungroup":"Usuń foldery funkcji","timeline.unsuppress_features":"Przywróć wygaszone funkcje","to the face":"do ściany","to the next face":"do następnej ściany","toolbar.customize_note":"Karta {tab}. Zaznacz polecenie, aby dodać jego przycisk do paska narzędzi. Możesz też przeciągnąć wiersz z listy rozwijanej panelu na pasek narzędzi, przeciągnąć przycisk poza pasek, aby go usunąć, lub użyć pinezki w wierszu listy rozwijanej.","toolbar.image":"OBRAZ","toolbar.render":"RENDEROWANIE","toolbar.render_appearance":"WYGLĄD","toolbar.render_camera":"KAMERA","toolbar.render_environment":"OTOCZENIE","toolbar.render_lighting":"OŚWIETLENIE","toolbar.render_lights":"ŚWIATŁA","toolbar.render_result":"WYNIK","toolbar.render_scene":"SCENA","toolbar.render_stage":"SCENOGRAFIA","toolbar.render_studio":"STUDIO","trace.points":"Punkty wzdłuż ścieżki: {count}","trace.stopped_by_contact":"Kończy się na próbce {sample}: {a} przeszedłby przez {b}","trace.stopped_by_loop":"Kończy się na próbce {sample}: pętla przez {joint} nie może się bardziej zamknąć","trim by sketch curves, or by one plane or face":"przytnij krzywymi szkicu albo jedną płaszczyzną lub ścianą","ui.1_degree_of_freedom":"1 stopień swobody","ui.3d_mouse_axes_reassigned":"Osie są przypisane na nowo w Ustawieniach i to nadal obowiązuje razem z tą kalibracją.","ui.3d_mouse_button":"Przycisk {number}","ui.3d_mouse_button_nothing":"Nic","ui.3d_mouse_button_settings":"Ustawienia myszy 3D","ui.3d_mouse_buttons":"Przyciski","ui.3d_mouse_buttons_hint":"Naciśnij przycisk na myszy 3D, aby go tu znaleźć, a potem wybierz, co ma robić.","ui.3d_mouse_buttons_no_device":"Podłącz mysz 3D, aby ustawić, co robią jej przyciski.","ui.3d_mouse_buttons_reset":"Przywróć domyślne przyciski","ui.3d_mouse_calibrate":"Kalibruj…","ui.3d_mouse_calibrate_tip":"Przesuwaj nakładkę zgodnie z poleceniami okna, aby SolidCraft nauczył się kierunku i zakresu każdej osi tej myszy 3D. Zapisywane dla tej myszy 3D.","ui.3d_mouse_calibrate_title":"Kalibracja myszy 3D","ui.3d_mouse_calibrate_wait":"Rusz raz myszą 3D, aby SolidCraft ją zobaczył.","ui.3d_mouse_calibrated":"Skalibrowano","ui.3d_mouse_calibration":"Kalibracja myszy 3D","ui.3d_mouse_calibration_done":"Gotowe. Zapisz, aby używać kalibracji po każdym podłączeniu tej myszy 3D.","ui.3d_mouse_calibration_no_response":"Jedna oś prawie się nie poruszyła, więc nie można jej skalibrować. Zacznij od nowa i za każdym razem wychylaj nakładkę mocniej.","ui.3d_mouse_circles_help":"Koła pokazują, co urządzenie wysyła po kalibracji. Model testowy pokazuje, co widok z tym robi po odwróceniu, szybkości i przypisaniu osi.","ui.3d_mouse_dead_zone":"Strefa martwa","ui.3d_mouse_dead_zone_tip":"O ile trzeba wychylić nakładkę, zanim widok się poruszy, jako część pełnego wychylenia. Zwiększ, jeśli widok dryfuje przy nieruszanej nakładce.","ui.3d_mouse_denied":"SolidCraft widzi mysz 3D, ale nie ma pozwolenia, by ją odczytać. Regułę udev opisują uwagi o konfiguracji myszy 3D.","ui.3d_mouse_denied_short":"Znaleziono, ale nie można odczytać","ui.3d_mouse_driven_by":"Który skalibrowany ruch urządzenia steruje tą osią. Wybranie ruchu używanego już przez inną oś zamienia je miejscami.","ui.3d_mouse_driven_by_label":"sterowana przez","ui.3d_mouse_driver":"Sterownik myszy 3D","ui.3d_mouse_driver_auto":"Automatyczny","ui.3d_mouse_driver_direct":"Bezpośredni (hidraw)","ui.3d_mouse_driver_fallback":"Na razie odczyt przez spacenavd: samego urządzenia nie udało się otworzyć.","ui.3d_mouse_driver_only_direct":"Urządzenie jest czytane bezpośrednio; spacenavd nie działa","ui.3d_mouse_driver_only_spacenavd":"Odczyt przez spacenavd, jedyna dostępna droga","ui.3d_mouse_forget":"Zapomnij kalibrację","ui.3d_mouse_ghost_left_viewport":"Lewy widok","ui.3d_mouse_ghost_left_window":"Lewe okno","ui.3d_mouse_ghost_position":"Położenie","ui.3d_mouse_ghost_right_viewport":"Prawy widok","ui.3d_mouse_hint":"Przesuwaj i obracaj widok jednocześnie; w szkicach działa tylko przesuwanie i powiększanie.","ui.3d_mouse_kind_cap":"Powrót do środka","ui.3d_mouse_kind_question":"Jaki to rodzaj myszy 3D?","ui.3d_mouse_kind_trackball":"Trackball","ui.3d_mouse_looks_like_cap":"Odczyt zostaje, dopóki trzymasz, jak w urządzeniu typu „Powrót do środka”.","ui.3d_mouse_looks_like_trackball":"Odczyt wraca, gdy tylko przestajesz ruszać, jak w trackballu.","ui.3d_mouse_motion_rotation_x":"Obrót X","ui.3d_mouse_motion_rotation_y":"Obrót Y","ui.3d_mouse_motion_rotation_z":"Obrót Z","ui.3d_mouse_motion_translation_x":"Przesunięcie X","ui.3d_mouse_motion_translation_y":"Przesunięcie Y","ui.3d_mouse_motion_translation_z":"Przesunięcie Z","ui.3d_mouse_navigate":"Nawiguj za pomocą myszy 3D","ui.3d_mouse_none":"Nie znaleziono myszy 3D","ui.3d_mouse_not_calibrated":"Nieskalibrowano","ui.3d_mouse_offer":"Kalibracja myszy 3D naprawia zamienione lub odwrócone osie oraz ustawia jej szybkość i odczucie.","ui.3d_mouse_offer_never":"Nie pokazuj więcej","ui.3d_mouse_offer_swap":"Przełącz na Hidraw (sterownik bezpośredni)","ui.3d_mouse_orbit":"Obracanie widoku","ui.3d_mouse_orbit_classic":"Klasyczne","ui.3d_mouse_orbit_tip":"Śledzone: mysz 3D obraca widok wokół części modelu, która jest na środku widoku w chwili rozpoczęcia obrotu, oznaczonej bladą kulą. Klasyczne: wokół środka widoku","ui.3d_mouse_orbit_traced":"Śledzone","ui.3d_mouse_reading":"Odczyt","ui.3d_mouse_reset_axes":"Przywróć przypisanie osi","ui.3d_mouse_reset_view":"Resetuj widok","ui.3d_mouse_restore":"Przywróć ustawienia myszy 3D","ui.3d_mouse_restore_ask":"Przywrócić domyślne ustawienia myszy 3D? Kalibracja i przypisanie przycisków zostają.","ui.3d_mouse_section":"Mysz 3D","ui.3d_mouse_show_in_view":"Pokazuj mysz 3D w widoku 3D","ui.3d_mouse_show_in_view_tip":"Obraz twojej myszy 3D w lewym dolnym rogu, który porusza się razem z nią.","ui.3d_mouse_skip":"Moje urządzenie tego nie potrafi","ui.3d_mouse_skip_tip":"Pomija ten ruch w obu kierunkach; kalibracja go nie uwzględnia.","ui.3d_mouse_speed":"Czułość myszy 3D","ui.3d_mouse_step_lift":"Unieś nakładkę, przytrzymaj, a następnie puść.","ui.3d_mouse_step_press":"Wciśnij nakładkę w dół, przytrzymaj, a następnie puść.","ui.3d_mouse_step_pull":"Pociągnij nakładkę do siebie, przytrzymaj, a następnie puść.","ui.3d_mouse_step_push":"Popchnij nakładkę od siebie, przytrzymaj, a następnie puść.","ui.3d_mouse_step_rest":"Zdejmij dłoń z nakładki i nie ruszaj jej.","ui.3d_mouse_step_rest_trackball":"Zdejmij dłoń z kulki i nie ruszaj jej.","ui.3d_mouse_step_ring_clockwise":"Obróć pierścień przewijania o kilka kliknięć zgodnie z ruchem wskazówek zegara.","ui.3d_mouse_step_ring_counterclockwise":"Obróć pierścień przewijania o kilka kliknięć przeciwnie do ruchu wskazówek zegara.","ui.3d_mouse_step_roll_away":"Potocz kulkę kilka razy od siebie, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_roll_left":"Potocz kulkę kilka razy w lewo, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_roll_right":"Potocz kulkę kilka razy w prawo, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_roll_toward":"Potocz kulkę kilka razy do siebie, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_slide_left":"Przesuń nakładkę w lewo, przytrzymaj, a następnie puść.","ui.3d_mouse_step_slide_right":"Przesuń nakładkę w prawo, przytrzymaj, a następnie puść.","ui.3d_mouse_step_spin_clockwise":"Zakręć kulką kilka razy zgodnie z ruchem wskazówek zegara, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_spin_counterclockwise":"Zakręć kulką kilka razy przeciwnie do ruchu wskazówek zegara, a potem pozwól jej się zatrzymać.","ui.3d_mouse_step_tilt_away":"Przechyl górę nakładki od siebie (krawędź najbliżej ciebie idzie w górę), przytrzymaj, a następnie puść.","ui.3d_mouse_step_tilt_left":"Przechyl nakładkę w lewo (lewa krawędź w dół), przytrzymaj, a następnie puść.","ui.3d_mouse_step_tilt_right":"Przechyl nakładkę w prawo (prawa krawędź w dół), przytrzymaj, a następnie puść.","ui.3d_mouse_step_tilt_toward":"Przechyl górę nakładki do siebie (krawędź najbliżej ciebie idzie w dół), przytrzymaj, a następnie puść.","ui.3d_mouse_step_touch":"Połóż dłoń na nakładce, nie naciskając jej.","ui.3d_mouse_step_twist_clockwise":"Obróć nakładkę zgodnie z ruchem wskazówek zegara, przytrzymaj, a następnie puść.","ui.3d_mouse_step_twist_counterclockwise":"Obróć nakładkę przeciwnie do ruchu wskazówek zegara, przytrzymaj, a następnie puść.","ui.3d_mouse_switch_cap":"Kalibruj jako powrót do środka","ui.3d_mouse_switch_trackball":"Kalibruj jako trackball","ui.3d_mouse_use_direct":"Użyj sterownika bezpośredniego","ui.3d_mouse_use_direct_tip":"Odczytuj mysz 3D bezpośrednio (hidraw) zamiast przez spacenavd.","ui.3d_mouse_view_axis":"Oś widoku","ui.3d_mouse_view_off":"Wyłączona","ui.3d_mouse_view_off_tip":"Profil sterownika myszy 3D wyłącza tę oś, więc jej ruch nie porusza widokiem. Wybranie tu ruchu innej osi zamienia je miejscami, a ten ruch przestaje poruszać widokiem.","ui.3d_mouse_view_orbit_sideways":"Orbita w lewo / prawo","ui.3d_mouse_view_orbit_up_down":"Orbita w górę / dół","ui.3d_mouse_view_pan_sideways":"Przesuwanie w lewo / prawo","ui.3d_mouse_view_pan_up_down":"Przesuwanie w górę / dół","ui.3d_mouse_view_roll":"Przechył","ui.3d_mouse_view_unmapped":"Oś {n}","ui.3d_mouse_view_zoom":"Powiększenie","ui.3d_mouse_waiting":"Czekam na ruch","ui.3d_mouse_wiggle":"Jeśli masz podłączoną, poruszaj nią chwilę.","ui.3d_sketch":"Szkic 3D","ui.activate":"Aktywuj","ui.active_component":"Aktywny komponent","ui.add_configuration":"Dodaj konfigurację","ui.add_parameter":"Dodaj parametr","ui.agent_chat":"Czat z agentem","ui.agent_chat_add":"Załącz pliki","ui.agent_chat_add_file":"Wybierz plik…","ui.agent_chat_allow":"Zezwól","ui.agent_chat_allow_once":"Zezwól raz","ui.agent_chat_allowed":"Zezwolono","ui.agent_chat_answered":"Odpowiedź: {option}","ui.agent_chat_approval":"Zezwolić agentowi na to działanie?","ui.agent_chat_attach_selection":"Dołącz zaznaczenie","ui.agent_chat_attach_selection_tip":"Wyślij z wiadomością to, co zaznaczono w modelu (ściany, krawędzie, funkcje, bryły), aby agent wiedział, o co chodzi","ui.agent_chat_attach_view":"Dołącz widok","ui.agent_chat_attach_view_tip":"Wyślij z wiadomością obraz bieżącego widoku","ui.agent_chat_attachable":"Obrazy, pliki PDF, tekstowe i CAD","ui.agent_chat_auth_agent":"Zaloguj się przez {name}","ui.agent_chat_auth_env":"Ustaw {vars} w swoim środowisku i uruchom ponownie SolidCraft.","ui.agent_chat_auth_needed":"Agent prosi o zalogowanie. Logujesz się w samym agencie; SolidCraft nigdy nie widzi Twojego hasła ani kluczy.","ui.agent_chat_auth_none":"Agent nie oferuje tu metody logowania: zaloguj się tak, jak opisuje to jego dokumentacja.","ui.agent_chat_auth_retry":"Zalogowano: połącz ponownie","ui.agent_chat_auth_terminal":"Uruchom to w terminalu, a potem ponownie naciśnij Połącz:","ui.agent_chat_auth_title":"Zaloguj się do agenta","ui.agent_chat_cancel":"Anuluj","ui.agent_chat_changes":"Zmiany: {n}, jeden krok cofania","ui.agent_chat_changes_n":"Zmiany: {n}","ui.agent_chat_changes_of":"Zmiany: {n}/{limit}","ui.agent_chat_choose_model":"Wybierz model","ui.agent_chat_close":"Zamknij","ui.agent_chat_command":"Polecenie agenta","ui.agent_chat_connect":"Połącz","ui.agent_chat_copy":"Kopiuj","ui.agent_chat_ctx_bodies":"Bryły","ui.agent_chat_ctx_elements":"Elementy","ui.agent_chat_ctx_features":"Funkcje","ui.agent_chat_ctx_more":"+{n} więcej","ui.agent_chat_ctx_other":"Inne","ui.agent_chat_custom_hint":"Dowolny program, który obsługuje Agent Client Protocol przez stdin i stdout. Nie jest uruchamiany przez powłokę.","ui.agent_chat_denied":"Odmówiono","ui.agent_chat_deny":"Odmów","ui.agent_chat_desktop_only":"Czat z agentem wymaga aplikacji desktopowej.","ui.agent_chat_detecting":"Wyszukiwanie agentów…","ui.agent_chat_dock":"Zadokuj w panelu bocznym","ui.agent_chat_dock_left":"Zadokuj po lewej","ui.agent_chat_dock_right":"Zadokuj po prawej","ui.agent_chat_drop_hint":"Upuść, aby dołączyć do następnej wiadomości","ui.agent_chat_edit":"Edytuj","ui.agent_chat_exited":"Agent się zatrzymał.","ui.agent_chat_failed_start":"Nie udało się uruchomić agenta: {error}","ui.agent_chat_file_cad_not_read":"{name}: plik CAD jest importowany do projektu, a nie odczytywany","ui.agent_chat_file_empty_picture":"{name}: pusty obraz","ui.agent_chat_file_error":"{name}: {error}","ui.agent_chat_file_heic":"{name}: obrazy HEIC nie mogą być tu odczytane; najpierw wyeksportuj je jako JPEG lub PNG","ui.agent_chat_file_importing":"Importowanie do projektu…","ui.agent_chat_file_kinds":"{name}: można załączać obrazy (PNG, JPEG, GIF, WebP, BMP, TIFF), pliki tekstowe (także SVG) i pliki CAD (STEP, IGES, FreeCAD, Rhino, STL, 3MF, OBJ, glTF)","ui.agent_chat_file_loading":"Odczytywanie pliku…","ui.agent_chat_file_not_a_file":"{name}: to nie jest plik","ui.agent_chat_file_not_a_picture":"{name}: to nie jest obraz","ui.agent_chat_file_not_utf8":"{name}: to nie jest tekst UTF-8","ui.agent_chat_file_picture_too_big":"{name}: obraz może mieć najwyżej {max} MB","ui.agent_chat_file_text_too_big":"{name}: plik tekstowy może mieć najwyżej {max} KB","ui.agent_chat_file_too_large":"{name}: za duży","ui.agent_chat_file_too_large_to_send":"{name}: za duży do wysłania, nawet po pomniejszeniu","ui.agent_chat_file_unreadable_picture":"{name}: obraz, którego nie można odczytać","ui.agent_chat_files":"Pliki: {files}","ui.agent_chat_files_left_out":"Do jednej wiadomości można dołączyć najwyżej {max} plików; pominięto: {files}","ui.agent_chat_files_loading":"Oczekiwanie na odczytanie plików","ui.agent_chat_files_max":"Najwyżej {max} plików w jednej wiadomości","ui.agent_chat_flatpak_none_found":"Nie znaleziono agenta programistycznego. Piaskownica Flatpak domyślnie nie widzi agentów zainstalowanych w folderze domowym i nie ma dostępu do sieci. Aby zezwolić na Claude Code i jego adapter ACP zainstalowane przez nvm lub w ~/.local/bin, uruchom to polecenie w terminalu, a potem uruchom ponownie SolidCraft. Daje ono dostęp do wymienionych programów i plików logowania oraz dostęp do sieci:","ui.agent_chat_import_failed":"{name}: import się nie powiódł: {error}","ui.agent_chat_intro":"Rozmawiaj z agentem programistycznym, którego już używasz, lub z wybranym punktem końcowym modelu. Pracuje on na otwartym projekcie za pomocą narzędzi SolidCraft: jego zmiany są widoczne na bieżąco, a cofa się je jednym krokiem na wiadomość. To, co może robić bez pytania, ustawisz w Preferencje > AI.","ui.agent_chat_key_in_env":"klucz ustawiony","ui.agent_chat_last_missing":"Ostatnio używany agent ({agent}) nie jest już dostępny. Wybierz agenta, a potem naciśnij Ponów.","ui.agent_chat_left":"Lewa","ui.agent_chat_limit":"Agent osiągnął limit {limit} zmian na jedną wiadomość. Wyślij kolejną wiadomość, aby mógł kontynuować.","ui.agent_chat_login_found":"znaleziono logowanie","ui.agent_chat_minimize":"Zminimalizuj do paska","ui.agent_chat_mode_all":"Wszystko","ui.agent_chat_mode_ask":"Pytaj","ui.agent_chat_mode_edits":"Edycje","ui.agent_chat_model_no_tools":"{model} nie może używać narzędzi SolidCraft, więc może tylko rozmawiać. Wybierz model obsługujący narzędzia.","ui.agent_chat_model_tip":"Model używany przez agenta. Twój wybór jest zapamiętywany dla tego agenta.","ui.agent_chat_new":"Nowy czat","ui.agent_chat_new_confirm":"Rozpocząć nowy czat? Bieżący zostanie wyczyszczony.","ui.agent_chat_next_picture":"Następny obraz","ui.agent_chat_no_cli":"Nie znaleziono solidcraft-cli obok aplikacji, więc agent nie ma dostępu do projektu.","ui.agent_chat_no_control":"Punkt końcowy czatu z agentem się nie uruchomił, więc agent nie ma dostępu do projektu.","ui.agent_chat_no_images":"Ten agent nie przyjmuje obrazów","ui.agent_chat_no_picture":"W schowku nie ma obrazu","ui.agent_chat_no_tool_call":"Model nie użył narzędzi SolidCraft, więc projekt nie został zmieniony. Wybierz model obsługujący wywoływanie narzędzi; zobacz Modele lokalne w przewodniku czatu z agentem.","ui.agent_chat_none_found":"Nie znaleziono agenta programistycznego. Zainstaluj jeden z poniższych, a potem naciśnij Odśwież:","ui.agent_chat_none_found_short":"Nie znaleziono agenta","ui.agent_chat_not_installed":"Nie zainstalowano","ui.agent_chat_not_signed_in":"nie zalogowano","ui.agent_chat_open_settings":"Otwórz preferencje","ui.agent_chat_own_window":"Osobne okno","ui.agent_chat_paste_picture":"Wklej obraz","ui.agent_chat_permission":"Agent prosi o uruchomienie: {title}","ui.agent_chat_pick":"Agent","ui.agent_chat_pick_context":"Wybierz kontekst","ui.agent_chat_pick_context_tip":"Wybierz w modelu ściany, krawędzie, funkcje i bryły, którym agent ma się przyjrzeć, a potem naciśnij OK","ui.agent_chat_placeholder":"Poproś agenta o zmianę projektu…","ui.agent_chat_placeholder_busy":"Zakolejkuj wiadomość na czas, gdy agent skończy (Ctrl+Enter: wyślij teraz)","ui.agent_chat_pop_out":"Otwórz w osobnym oknie, które możesz przenieść na inny ekran","ui.agent_chat_previous_picture":"Poprzedni obraz","ui.agent_chat_privacy":"Nic nie trafia nigdzie poza uruchomionym przez Ciebie agentem, na Twoim własnym koncie.","ui.agent_chat_privacy_note":"Czat sam z siebie nigdzie niczego nie wysyła: uruchomiony przez Ciebie agent łączy się z własną usługą na Twoim koncie. SolidCraft nigdy nie widzi ani nie przechowuje klucza ani hasła.","ui.agent_chat_provider_models":"Modele: {count}","ui.agent_chat_provider_other":"Inny","ui.agent_chat_provider_tip":"Dostawca, którego modele pokazuje następna lista.","ui.agent_chat_queue":"Kolejka","ui.agent_chat_queue_full":"Za dużo wiadomości czeka: usuń jedną lub poczekaj na agenta.","ui.agent_chat_queued":"W kolejce","ui.agent_chat_queued_stopped":"W kolejce (zatrzymano, nie wysłano)","ui.agent_chat_refresh":"Odśwież","ui.agent_chat_refused":"Niedozwolone dla agenta: {reason}","ui.agent_chat_remove":"Usuń z kolejki","ui.agent_chat_remove_file":"Usuń z tej wiadomości","ui.agent_chat_remove_imported":"Usuń z tej wiadomości; część pozostaje w projekcie (Cofnij ją usuwa)","ui.agent_chat_retry":"Ponów","ui.agent_chat_right":"Prawa","ui.agent_chat_save":"Zapisz","ui.agent_chat_send":"Wyślij","ui.agent_chat_send_now":"Wyślij teraz","ui.agent_chat_send_now_tip":"Zatrzymaj bieżący krok agenta i wyślij tę wiadomość jako następną (Ctrl+Enter)","ui.agent_chat_setup_body":"SolidCraft komunikuje się z agentem programistycznym zainstalowanym na tym komputerze. Wybierz go w Preferencje › AI.","ui.agent_chat_setup_title":"Skonfiguruj asystenta","ui.agent_chat_side":"Strona czatu z agentem","ui.agent_chat_signed_in":"zalogowano","ui.agent_chat_state_auth":"Wymagane logowanie","ui.agent_chat_state_busy":"Pracuje…","ui.agent_chat_state_exited":"Agent zatrzymany","ui.agent_chat_state_failed":"Połączenie nieudane","ui.agent_chat_state_off":"Brak połączenia","ui.agent_chat_state_ready":"Gotowy","ui.agent_chat_state_starting":"Uruchamianie…","ui.agent_chat_stop":"Zatrzymaj","ui.agent_chat_stop_tip":"Zatrzymaj agenta i wszystko, co uruchomił","ui.agent_chat_stop_turn_tip":"Zatrzymaj agenta (Esc). Wiadomości w kolejce pozostają w kolejce.","ui.agent_chat_turn_limit":"Zmiany na wiadomość","ui.agent_chat_turn_unlimited":"Bez limitu","ui.agent_chat_undo_changes":"Cofnij te zmiany","ui.agent_chat_undo_lab