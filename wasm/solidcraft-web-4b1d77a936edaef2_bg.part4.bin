"no interference":"немає перетинів","no joint that moves yet":"ще немає рухомого з'єднання","no motion study yet":"ще немає дослідження руху","no picture":"немає зображення","no such joint":"такого з'єднання немає","none":"немає","not a move":"це не переміщення","not a number":"не число","open a sketch first":"спершу відкрийте ескіз","parameters.apply_live":"Застосовувати кожну зміну, коли ви залишаєте її поле","parameters.apply_live_tip":"Вимкнено: зміни чекають на «Застосувати» або OK, після чого проєкт один раз перебудовується для всіх. «Скасувати» чи Esc відкидає їх.","parameters.held":"Змін, що чекають на «Застосувати»: {count}","parameters.held_hint":"Змінюйте вирази та одиниці. Зміни чекають на «Застосувати» або OK.","parameters.held_one":"1 зміна чекає на «Застосувати»","parts.automatic_name":"автоматично","parts.dimension.across_flats":"Розмір під ключ","parts.dimension.bore":"Діаметр отвору","parts.dimension.d":"Номінальний діаметр","parts.dimension.head_diameter":"Діаметр головки","parts.dimension.head_height":"Висота головки","parts.dimension.height":"Висота","parts.dimension.inner":"Внутрішній діаметр","parts.dimension.outer":"Зовнішній діаметр","parts.dimension.pitch":"Крок","parts.dimension.socket":"Розмір гнізда","parts.dimension.socket_depth":"Глибина гнізда","parts.dimension.thickness":"Товщина","parts.dimension.width":"Ширина","parts.family.bearing":"Радіальний кульковий підшипник (габарит)","parts.family.button_head_cap_screw":"Гвинт з циліндричною головкою та внутрішнім шестигранником","parts.family.dowel_pin":"Циліндричний штифт","parts.family.hex_bolt":"Болт / гвинт із шестигранною головкою","parts.family.hex_nut":"Шестигранна гайка","parts.family.set_screw":"Установчий гвинт із шестигранним гніздом, плоский кінець","parts.family.socket_head_cap_screw":"Гвинт із циліндричною головкою та шестигранним гніздом","parts.family.washer":"Плоска шайба","parts.holes":"Отвори (необов'язково)","parts.placement_hint":"виберіть один чи кілька отворів, щоб посадити деталь у кожен, або OK розмістить її на початку координат","pattern.alignment_2":"Вирівнювання 2","pattern.alignment_hint":"Кількість включає оригінал. Центрування розподіляє копії з обох боків; за парної кількості зміна напрямку визначає бік із додатковою копією.","pattern.direction_1":"Напрямок 1","pattern.direction_2":"Напрямок 2","pattern.flip_direction":"Змінити напрямок","perf.click_for_details":"Клацніть, щоб побачити подробиці: графік часу кадру, гістограму та що намалював GPU","perf.draw_calls":"Виклики малювання","perf.line_segments":"Відрізки ліній","perf.low_1":"1% мін.","perf.renderer":"Рендерер","perf.scene_build":"Побудова сцени","perf.triangles":"Трикутники","perf.ui_time":"Час інтерфейсу","perf.viewport":"Вікно перегляду","perf.worst":"найгірший","pick a body or some of its faces":"виберіть тіло або кілька його граней","pick a hole to seat it, or OK places it at the origin":"виберіть отвір для посадки, або OK розмістить його в початку координат","pick a planar face":"виберіть плоску грань","pick a plane or a face as the tool":"виберіть площину або грань як інструмент","pick a size":"виберіть розмір","pick edges of a body":"виберіть ребра тіла","pick edges of one body":"виберіть ребра одного тіла","pick edges of the holes to remove":"виберіть ребра отворів, які потрібно видалити","pick faces of one body":"виберіть грані одного тіла","pick faces to offset":"виберіть грані для зсуву","pick lines of one sketch":"виберіть лінії одного ескізу","pick one or two vertices, edges or faces":"виберіть одну-дві вершини, ребра або грані","pick one plane or face as the tool, or sketch curves":"виберіть одну площину або грань як інструмент чи криві ескізу","pick sections in two or more sketches":"виберіть перерізи у двох або більше ескізах","pick sketch curves or edges":"виберіть криві ескізу або ребра","pick the face to untrim":"виберіть грань, з якої потрібно зняти обрізання","pick the path":"виберіть траєкторію","pick what to keep":"виберіть, що залишити","pick what to keep of the other surface":"виберіть, що залишити від іншої поверхні","prefs.add_item":"Додати елемент","prefs.alt_frees_manipulators":"Alt / Option також дає вільне перетягування стрілок маніпулятора","prefs.anti_aliasing_amd_dx12":"Згладжування використовує 1×, бо під час перевірки запуску багатовибіркове згладжування нічого не намалювало, а з 1× перевірку пройдено. Вище можна вибрати інший параметр; якщо перевірка пройде, перезапустіть програму, щоб застосувати його.","prefs.anti_aliasing_note":"Згладжує нерівні краї.","prefs.applies_on_restart":"Застосовується після перезапуску","prefs.assistant":"Асистент","prefs.auto_operation":"Автоматичний режим операцій","prefs.auto_operation_note":"Автоматично виконувати команди без додаткових запитів там, де це безпечно","prefs.axes":"Осі","prefs.axis":"Вісь","prefs.bodies_folders":"Теки тіл","prefs.bodies_folders_always":"Завжди","prefs.bodies_folders_never":"Ніколи","prefs.bodies_folders_several":"Лише кілька тіл","prefs.bottom":"Низ","prefs.bottom_centre":"Внизу по центру","prefs.bottom_right":"Внизу праворуч","prefs.browser":"Браузер","prefs.browser_eye_left":"Око поруч зі стрілкою згортання","prefs.browser_eye_left_note":"Рядки браузера показують око «показати/приховати» поруч зі стрілкою згортання, як і раніше, а не в стовпці на правому краї рядків.","prefs.browser_reveal_on_hover":"Показувати в браузері при наведенні","prefs.browser_show_note":"Налаштування відображення браузера проєкту","prefs.browser_shown":"Показувати браузер","prefs.built_in":"Вбудована","prefs.button_left":"Перетягування лівою кнопкою","prefs.button_middle":"Перетягування середньою кнопкою","prefs.button_right":"Перетягування правою кнопкою","prefs.choose_font":"Вибрати файл шрифту…","prefs.click":"Клацання","prefs.contact_shading":"М'яке контактне затінення","prefs.contact_shading_note":"М'яке затінення там, де деталі зближуються.","prefs.context_menu":"Контекстне меню","prefs.context_menu_ring":"Контекстне меню · утримуйте для кругового меню","prefs.cpu":"ЦП (програмний)","prefs.crash_reports":"Відкрити звіти про збої…","prefs.crash_reports_note":"Звіти зберігаються на цьому комп'ютері разом із проєктом і командами, що відтворюють проблему.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Криві поверхні","prefs.curves":"Криві поверхні","prefs.dead_zone_note":"Заштрихована смуга — це мертва зона: рух у її межах ігнорується.","prefs.default":"типово","prefs.design":"Типові параметри проєкту","prefs.design_note":"З чого починаються нові проєкти. Відкриті проєкти зберігають власні параметри.","prefs.devices":"3D-миша","prefs.dialog_buttons":"Кнопки діалогу","prefs.dialogs":"Діалоги","prefs.dialogs_edge":"На краю виду","prefs.dialogs_left_column":"У лівій колонці","prefs.dialogs_note":"Де відкриваються діалоги команд: закріплені на краю виду або в лівій колонці замість браузера та Історії, які повертаються в попередньому вигляді після закриття діалогу.","prefs.display":"Відображення","prefs.edges":"Ребра та затінення","prefs.extend":"Розширення","prefs.extra_navigation":"Ctrl+перетягування лівою на порожньому місці обертає; утримуйте Space, щоб панорамувати.","prefs.follows_os":"Як у системі","prefs.font":"Шрифт","prefs.font_fallback":"Символи, яких немає у вибраному шрифті, беруться з вбудованого, тож жоден напис не показує порожній квадрат.","prefs.font_sample":"Ґедзь, що їв фінік, з'їв і юшку · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"Не вдалося прочитати вибраний шрифт.","prefs.general":"Загальні","prefs.general_note":"Мова, збереження та оновлення.","prefs.gesture_orbit":"Обертання","prefs.gesture_pan":"Панорамування","prefs.gesture_zoom":"Масштаб","prefs.graphics":"Графіка","prefs.graphics_card":"Відеокарта","prefs.graphics_card_auto":"Автоматично","prefs.graphics_card_missing":"Збережена відеокарта недоступна; використовується режим «Автоматично».","prefs.graphics_card_restart":"Набуває чинності після перезапуску SolidCraft. Змінна WGPU_ADAPTER_NAME перевизначає цей вибір.","prefs.graphics_note":"Обміняйте швидкість на плавність. Кожен варіант показує свій ефект на зразку.","prefs.graphics_presets_note":"Набори задають наведені нижче параметри разом.","prefs.hide_constraint_glyphs_zoomed_out":"Ховати позначки обмежень на віддаленому виді","prefs.hide_constraint_glyphs_zoomed_out_note":"Позначки обмежень зникають, коли ескіз віддалено настільки, що вони б захаращували вид. Вимкнено: вони зберігають сталий розмір на екрані за будь-якого масштабу.","prefs.history":"Історія","prefs.history_origin_bodies":"Показувати початок координат і тіла вгорі","prefs.history_origin_bodies_note":"Історія ліворуч або під браузером починається з теки «Тіла» активного компонента та початку координат, з їхніми значками ока й меню, як у браузері. Історія внизу не змінюється.","prefs.history_play_button":"Кнопка «Відтворити історію» в елементах керування історією","prefs.history_play_button_note":"Розміщує «Відтворити історію» між «На один крок назад» і «На один крок уперед» в елементах керування історією. Також можна клацнути правою кнопкою на елементах керування, щоб показати або приховати кнопку.","prefs.history_sketches":"Ескізи","prefs.history_sketches_in_order":"За порядком","prefs.history_sketches_note":"Якщо для «Ескізи» вибрано «Під своєю операцією», Історія ліворуч показує кожен ескіз на один рівень глибше, під першою операцією, побудованою з нього, коли панель достатньо широка для назв. Часовий ланцюжок знизу завжди зберігає порядок створення.","prefs.history_sketches_under_feature":"Під своєю операцією","prefs.hold_stop_snapping":"Утримуйте, щоб вимкнути прив'язування","prefs.icons_only":"Лише піктограми","prefs.imported_file":"Імпортований файл","prefs.in_browser":"У браузері","prefs.input":"Введення","prefs.interface":"Інтерфейс","prefs.interface_language":"Мова інтерфейсу","prefs.interface_note":"Як виглядає SolidCraft і де розташовані його частини.","prefs.interval_minutes":"{n} хв","prefs.labels":"Підписи","prefs.layout":"Компонування","prefs.layout_note":"«Компактне» прикріплює панелі до країв вікна. Прозорість браузера доступна в режимі «Плаваюче». Сторону Асистента можна змінити на сторінці «Асистент».","prefs.left":"Ліворуч","prefs.left_click":"Клацання лівою","prefs.line_drag_draws_one":"Перетягування відрізка малює один елемент","prefs.line_drag_draws_one_note":"Замість безперервного малювання при перетягуванні","prefs.linked_designs":"Пов'язані проєкти","prefs.live_input":"Поточне введення","prefs.live_preview":"Попередній перегляд у реальному часі","prefs.logo":"Логотип","prefs.logo_accent":"Акцент","prefs.logo_theme":"Кольори теми","prefs.max_file_size":"Найбільший файл для відкриття","prefs.max_file_size_design":"Файли проєктів","prefs.max_file_size_flag":"Цей запуск використовує --max-file-size {size} до закриття SolidCraft. Ці налаштування діють під час запуску без цього параметра.","prefs.max_file_size_note":"Типово: 512 МБ і 256 МБ; щонайбільше 16 ГБ. Для відкриття файлу потрібно в кілька разів більше пам’яті, ніж його розмір. Проєкт із великим імпортом може потребувати вищої межі розміру файлу проєкту для збереження й повторного відкриття.","prefs.max_file_size_step":"Файли STEP та імпорту","prefs.max_file_size_web":"Вебзастосунок відкриває файли STEP та імпорту до 512 МБ і проєкти до 256 МБ: вкладка браузера не вміщує більші файли. У настільному застосунку ці межі можна збільшити.","prefs.megabytes":"МБ","prefs.menu_grid":"Великі піктограми","prefs.menu_list":"Список","prefs.menus":"Меню","prefs.minutes":"хв","prefs.minutes_suffix":" хв","prefs.mouse":"Миша й трекпад","prefs.mouse_heading":"Миша","prefs.mouse_mapping":"Призначення кнопок миші","prefs.navigation":"Навігація","prefs.navigation_note":"Як миша, трекпад і 3D-миша рухають вид.","prefs.network_host_remove":"Вилучити","prefs.network_locations":"Дозволяти мережеві розташування в проєктах","prefs.network_locations_note":"Вимкнено: пов'язані файли проєкту на іншому комп'ютері (\\\\server\\share) відкриваються лише з перелічених тут серверів або після того, як ви дозволите один, коли запитають.","prefs.network_locations_section":"Мережеві розташування","prefs.not_on_gpu":"не на цьому GPU","prefs.on":"Увімкнено","prefs.opaque":"Непрозорий","prefs.orbit_snap":"Утримуйте Shift під час обертання, щоб прив'язатися до осі.","prefs.orientation":"Орієнтація","prefs.origin_plane_names":"Назви площин початку координат","prefs.origin_plane_names_note":"Назви, що показуються в браузері, діалогах і списках. {top} — це XY, {front} — XZ, {right} — YZ, а Z спрямована вгору. Команди, скрипти й збережені проєкти зберігають XY, XZ і YZ.","prefs.overall_speed":"Загальна швидкість","prefs.parameter_list_rows":"Рядків у списку параметрів","prefs.parameter_list_rows_tip":"Стрілка вниз у порожньому полі значення показує список параметрів, спершу обрані, до цієї кількості. Менше число робить список легшим у великому проєкті.","prefs.persistent_ribbon_pressed":"Підсвічувати активні команди стрічки","prefs.persistent_ribbon_pressed_help":"Підсвічувати команди стрічки, поки їхні ефекти ввімкнені. Вимкніть, щоб зберегти попередній нейтральний вигляд і довідку команд.","prefs.perspective_fov":"Кут огляду перспективи","prefs.placement":"Розміщення","prefs.prefer_free_sketch_points":"Надавати перевагу рухомим точкам ескізу, коли точки перекриваються","prefs.preview_choices":"Перегляд ваших виборів","prefs.print_face_highlight":"Підсвічування грані друку","prefs.print_face_highlight_tip":"Наскільки сильно грань друку тіла зафарбовується й обводиться у вигляді. 0 % — без підсвічування.","prefs.profile_active":"Активний профіль","prefs.profile_applied":"Профіль застосовано.","prefs.profile_changed":"Налаштування змінено після збереження профілю. «Зберегти» додасть їх до профілю.","prefs.profile_deleted":"Профіль видалено.","prefs.profile_export":"Експортувати…","prefs.profile_exported":"Профіль експортовано.","prefs.profile_imported":"Профіль імпортовано. Виберіть його в полі «Активний профіль», щоб перейти на нього.","prefs.profile_name_hint":"Назва профілю, напр. Ноутбук","prefs.profile_rename":"Перейменувати","prefs.profile_renamed":"Профіль перейменовано.","prefs.profile_save":"Зберегти","prefs.profile_saved":"Поточні налаштування збережено в профілі.","prefs.profile_skipped":"Профіль застосовано; налаштувань, що зберегли поточне значення: {n} (див. журнал).","prefs.profiles":"Профілі налаштувань","prefs.profiles_note":"Комбінації клавіш, панель інструментів, навігація, кругове меню та налаштування інтерфейсу, що зберігаються разом під однією назвою й перемикаються одночасно.","prefs.project_options_dialog":"Діалог параметрів проєкту","prefs.project_options_dialog_note":"Відкривати діалог параметрів проєкту замість бічної панелі","prefs.quality_default":"типово","prefs.quality_fastest":"найшвидше","prefs.quality_slowest":"найповільніше","prefs.quality_smoother":"плавніше","prefs.quick_measure":"Швидке вимірювання в куті виду","prefs.quick_measure_note":"Розмір виділеного в нижньому правому куті виду: довжина ребра або Ø і R для круглого, площа грані, положення точки, відстань і кут між двома елементами, сума для кількох ребер чи граней. Клацання копіює його.","prefs.render_previous_geometry_budget":"Бюджет попередньої геометрії для візуалізації","prefs.render_previous_geometry_budget_help":"Максимальний обсяг пам'яті для кешу геометрії попереднього стану","prefs.reports_saved":"Збережено: {n}","prefs.ribbon_reveal":"Показувати результати пошуку на стрічці","prefs.ribbon_reveal_note":"Наведення курсора на результат у «Пошуку команд» показує, де команда розташована на стрічці: її вкладку, кнопку або рядок у випадному меню панелі. Команда, запущена з пошуку, блимає там, а запущена команда з випадного меню позначає свою панель.","prefs.right_click":"Клацання правою","prefs.saving":"Автозбереження й відновлення","prefs.scale_note":"Також Ctrl + / Ctrl − у вікні. Кнопки мають 28 px за 100%.","prefs.scale_text":"Масштаб і текст","prefs.search":"Пошук у налаштуваннях","prefs.search_empty":"Немає відповідних налаштувань","prefs.select":"Вибрати","prefs.select_one_item":"Вибрати один елемент","prefs.select_other_hidden":"Вибирати приховану геометрію через «Вибрати інше»","prefs.select_other_hidden_help":"Увімкнено: до списку входять приховані тіла, ескізи та затулені ребра поблизу вказівника. Вимкнено: використовується початковий список видимої геометрії під вказівником.","prefs.selecting":"Вибір","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift лише додає; Ctrl / Cmd перемикає","prefs.shift_add_note":"Увімкнено: Shift додає, Ctrl / Cmd перемикає. Вимкнено (типово): обидва перемикають.","prefs.shortcuts":"Комбінації клавіш","prefs.single_surface_analysis":"Аналіз окремої поверхні","prefs.single_surface_analysis_help":"Виконувати аналіз лише для вибраної поверхні","prefs.sketch_align_points":"Вирівнювати точки ескізу","prefs.sketch_align_points_note":"Автоматично вирівнювати точки при наближенні","prefs.sketch_conflict_colour":"Конфліктна геометрія кольором конфлікту","prefs.sketch_conflict_colour_note":"Поки обмеження ескізу суперечать одне одному, криві та точки, які утримує проблемне обмеження, також малюються кольором конфлікту, а не лише його піктограма чи розмір. Вимкнено: вони зберігають свої звичайні кольори.","prefs.sketch_construction_lines":"Розширені інструменти допоміжних прямих","prefs.sketch_exit_view":"Коли ескіз завершується","prefs.sketch_exit_view.keep":"Зберегти поточний вид","prefs.sketch_exit_view.previous":"Повернутися до попереднього виду","prefs.sketch_exit_view.unless_rotated":"Повернутися, якщо вид не оберталося","prefs.sketch_exit_view_note":"Куди переходить вид після «Завершити ескіз», «Скасувати» або подвійного Esc.","prefs.sketch_open_look_at":"Повертати вид до ескізу під час його відкриття","prefs.sketch_open_look_at_note":"Вимкнено: створення чи редагування ескізу не змінює вид. «Наведення» повертає вид до ескізу, коли ви цього захочете.","prefs.sketch_recent_snap":"Автоприв'язка до нещодавніх центрів і середніх точок","prefs.sketch_recent_snap_note":"Під час креслення курсор прив'язується до місця, де перетинаються допоміжні лінії двох останніх центрів кіл або середніх точок прямих відрізків. Вимкнено: ці лінії лише показуються, а курсор не зсувається.","prefs.sketch_selection":"Ескіз і вибір","prefs.sketch_selection_heading":"Ескіз і вибір","prefs.sketch_selection_note":"Як ескізи прив'язуються й як клацання вибирають.","prefs.sketch_state_icons":"Піктограми стану ескізу","prefs.sketch_state_icons_note":"Показувати стан обмежень та ступенів вільності біля точок","prefs.sketch_tab_always":"Завжди показувати вкладку «Ескіз»","prefs.sketch_tab_always_note":"Вкладка «Ескіз» залишається на стрічці одразу після вкладки «Модель», поки жоден ескіз не відкрито. Її інструменти креслення тоді запускають ескіз на вибраній площині чи грані або на площині, яку ви виберете далі, з уже готовим інструментом.","prefs.sketch_tracking_guides":"Допоміжні лінії вирівнювання за центром і середньою точкою","prefs.sketch_tracking_guides_note":"Наведіть курсор на центр кола або середню точку прямого відрізка, потім рухайте курсор горизонтально чи вертикально, щоб показати тимчасову пунктирну допоміжну лінію.","prefs.sketch_tracking_points":"Допоміжні лінії вирівнювання від кінцевих точок і кутів під час креслення","prefs.sketch_tracking_points_note":"Поки інструмент креслення очікує точку, наведення курсора на кінець прямої чи дуги, кут прямокутника або вільну точку показує таку саму тимчасову пунктирну допоміжну лінію, як і для центра чи середньої точки. Вимкнено: лише центри та середні точки.","prefs.sketching":"Ескізування","prefs.snap_drawing_note":"Під час малювання або перетягування точки ескізу.","prefs.source":"Джерело","prefs.speed":"Швидкість","prefs.stand_up_note":"Коли файл STEP або IGES відкрито з віссю Z угору, пропонувати поворот на чверть оберту навколо X.","prefs.stand_up_unknown":"Вирівнювання файлів з невідомою орієнтацією","prefs.stand_up_unknown.ask":"Запитувати","prefs.stand_up_unknown.note":"Визначати орієнтацію для файлів із невідомим напрямком осей","prefs.stand_up_unknown.off":"Не вирівнювати","prefs.stand_up_unknown_note":"Що робити, якщо напрямок осей файлу невідомий (Y вгору чи Z вгору)","prefs.status_bar":"Рядок стану","prefs.status_bar_note":"Тонкий рядок уздовж нижнього краю вікна показує, що саме редагується, стан відкритого ескіза (його кольором) та одиниці проєкту; клацання по одиницях змінює їх. Тоді стан ескіза більше не показується в куті виду.","prefs.status_done":"Готово","prefs.status_error":"Помилка","prefs.status_selected":"Вибрано","prefs.status_warning":"Попередження","prefs.supersampling_brief":"Малює вид у більшому розмірі й зменшує його: дуже чітко, але потребує більше ресурсів.","prefs.tab_accent_note":"Акцентний колір відповідає активній вкладці","prefs.theme_file":"файл теми","prefs.theme_file_or_paste":"файл або вставлення","prefs.theme_follow":"Стежити за файлом теми","prefs.theme_follow_error":"Не застосовано: {error}. Остання робоча тема залишається активною.","prefs.theme_follow_launch":"Лише для цього запуску (--theme-file); перезавантажується, коли інший інструмент перезаписує файл.","prefs.theme_follow_note":"Перезавантажується, коли інший інструмент перезаписує файл. Вибір теми припиняє відстеження.","prefs.theme_follow_off":"Вимк.","prefs.theme_follow_stop":"Припинити відстеження","prefs.theme_import_hint":"Клацніть, щоб вибрати файл теми, перетягніть його сюди або натисніть Ctrl+V (Cmd+V на Mac) зі скопійованою темою","prefs.theme_option_opacity":"Непрозорість","prefs.theme_option_opacity_help":"Налаштуйте непрозорість плаваючих панелей. Нижня межа читабельності захищає текст на кольорах вікна перегляду.","prefs.theme_option_tab_colours":"Кольори вкладок","prefs.theme_option_tab_colours_help":"Використовувати кольори панелей і вікна перегляду цієї теми для кожної вкладки стрічки.","prefs.theme_option_tab_fade_ms":"Перехід між вкладками","prefs.theme_option_tab_fade_ms_help":"Плавно змінювати кольори панелей і вікна перегляду під час перемикання вкладок. Нуль перемикає миттєво.","prefs.theme_options_badge":"Параметри","prefs.theme_options_more":"Ще · {count}","prefs.theme_options_reset":"Скинути","prefs.theme_options_unavailable":"Недоступно на цьому пристрої","prefs.theme_paste":"Вставити тему","prefs.theme_paste_none":"У буфері обміну немає теми SolidCraft","prefs.timeline_half_hour":"−30 хв","prefs.timeline_now":"зараз","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Сповіщення","prefs.toggle_item":"Додати або прибрати елемент","prefs.toolbar":"Панель інструментів","prefs.toolbar_tabs":"Вкладки панелі інструментів","prefs.top":"Верх","prefs.trackpad_zoom_modifier":"Масштабування прокруткою двома пальцями з утриманням","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Утримуйте лише цю клавішу, щоб масштабувати в точці курсора вертикальною прокруткою. Вимкнено — поточна поведінка прокрутки зберігається.","prefs.trackpad_zoom_modifier.off":"Вимк.","prefs.translucent":"Напівпрозорий","prefs.under_browser":"Під браузером","prefs.under_cursor":"Під курсором","prefs.units_precision":"Одиниці й точність","prefs.updates":"Оновлення","prefs.value_boxes_in_view":"Показувати значення біля їхніх маркерів на виді","prefs.value_boxes_in_view_tip":"Значення команди (Відстань, Радіус…) у полі біля її маркера, поверх моделі. Вимкнено: ви вводите його у вікні команди, яке після вибору отримує клавіатуру, і ніщо не закриває модель.","prefs.view":"Поведінка виду","prefs.view_confirm_corner":"OK і Скасувати в куті виду","prefs.view_confirm_corner_note":"Поки відкрито діалог або ескіз, галочка й хрестик у правому верхньому куті виду роблять те саме, що OK і Скасувати в діалозі, або завершують і скасовують ескіз. Навігатор виду зсувається нижче.","prefs.viewport":"Вікно перегляду","prefs.viewport_analysis_status":"Показувати стан аналізу у вікні перегляду","prefs.viewport_analysis_status_help":"Показувати активні аналізи над вікном перегляду, відкривати їхні легенди з кожного елемента, а Esc вимикає найновіший аналіз. Вимкніть, щоб повернути легенди в кутах і попередню поведінку Esc.","prefs.viewport_background":"Фон вікна перегляду","prefs.viewport_background_colour":"Колір","prefs.viewport_background_theme":"Градієнт теми","prefs.viewport_section_status":"Показувати стан перерізу у вікні перегляду","prefs.viewport_section_status_help":"Показувати налаштування перерізу у вікні перегляду. Escape і активна кнопка стрічки вимикають його. Вимкніть, щоб зберегти попередні елементи керування перерізом.","prefs.viewport_status_details":"Інтерактивні подробиці вікна перегляду","prefs.viewport_status_details_help":"Редагуйте налаштування активного аналізу та перерізу в стандартних картках подробиць. Вимкніть, щоб повернути легенди аналізу лише для читання та діалог «Переріз».","prefs.viewport_status_summary":"Згортати елементи рядка стану","prefs.viewport_status_summary_help":"Згортати три й більше елементів рядка стану в один зведений значок. Вимкніть, щоб залишити всі елементи в повному рядку.","prefs.wheel":"Колесо","prefs.wheel_trackpad":"Колесо й трекпад","prefs.workspace":"Робоча область","prefs.zoom_stop_at_model":"Зупиняти масштаб на моделі","prefs.zoom_stop_at_model_tip":"3D-миша та застосунок пристрою масштабують до поверхні в центрі виду; масштабування перетягуванням утримує точку початку. Вимкнено: масштаб може проходити крізь модель. Колесо й стискання окремо використовують «Масштаб до курсора»","prefs.zoom_toward_cursor":"Масштаб до курсора","properties.title":"Властивості: {name}","recovery.days_ago":"{count} дн. тому","recovery.detail":"{file} · елементів: {features} · автозбережено {when}","recovery.discard_all":"Відхилити все","recovery.discard_all_detail":"Цю дію не можна скасувати.","recovery.discard_all_title":"Відхилити автозбережень: {count}?","recovery.discard_all_title_one":"Відхилити 1 автозбереження?","recovery.hours_ago":"{count} год тому","recovery.just_now":"щойно","recovery.min_ago":"{count} хв тому","recovery.never_saved":"ніколи не зберігалося","render.adaptive_absolute":"Абсолютний поріг похибки RGB","render.adaptive_coverage":"Цільова похибка покриття","render.adaptive_enable":"Розподіляти вибірки за незалежними пробами","render.adaptive_help":"Лише GPU. Незалежні пробні вибірки відкидаються, після чого розподіляється щонайменше 16 робочих вибірок на піксель, але не більше за «Вибірок на піксель». Розподіл спрямовують дисперсія RGB і покриття; рідкісні шляхи можуть бути пропущені, а пікселі з досягнутим обмеженням можуть лишитися шумними. Підсумковий звіт враховує фактично виконану роботу. Гарантій щодо рівня шуму чи часу немає.","render.adaptive_minimum":"Мінімум робочих вибірок","render.adaptive_pending":"Доступні адаптивний розподіл на GPU з незалежними пробами та умовні страти Френеля. Сертифікована збіжність, гарантії для рідкісних подій і адаптивний транспорт на CPU поки недоступні.","render.adaptive_pilots":"Пробних вибірок на піксель","render.adaptive_relative":"Цільова відносна похибка RGB","render.add_ground":"Додати підігнану підлогу до сцени","render.advanced_material_scope":"Доступне одне скінченне однорідне середовище на GPU в межах явних обмежень. Сітки густини, вкладені комбінації скла й об'ємів, підповерхневе розсіювання, зміщення, спектральний транспорт та розширені концепції матеріалів без прив'язки до рендерера поки недоступні.","render.aging_add":"Додати шар старіння","render.aging_airborne":"Пил у повітрі / середовище розсіювання","render.aging_airborne_help":"Пил у повітрі — окремий скінченний однорідний об'єм розсіювання. Він змінює перенесення світла та вихідний EXR, а не стопку шарів старіння поверхні. Наявні обмеження для об'ємів, скла й шумозаглушення лишаються явними; атмосфера автоматично не додається.","render.aging_all_bodies":"Усі придатні непрозорі тіла","render.aging_chips":"Відколота фарба","render.aging_class_any":"Усі класи непрозорих матеріалів","render.aging_class_dielectric":"Лише неметалеві поверхні","render.aging_class_metal":"Лише металеві поверхні","render.aging_color":"Колір шару · sRGB","render.aging_coverage":"Покриття","render.aging_dust":"Осілий пил","render.aging_empty":"Немає шарів старіння: початкові поверхні лишаються без змін.","render.aging_fading":"Вицвіле покриття","render.aging_grime":"Бруд і плями","render.aging_help":"Поєднуйте до восьми оптичних шарів по черзі. Іржа й патина — задані вручну вигляди, а не симуляції старіння чи корозії. Масштаб задається у світових міліметрах. Геометрія, маса та інженерні властивості не змінюються; скло й пасивні сцени виключені.","render.aging_metallic":"Частка металу в шарі","render.aging_origin":"Початок поля · світові мм","render.aging_patina":"Мідно-зелена патина","render.aging_refresh_targets":"Переглянути поточні тіла","render.aging_roughness":"Шорсткість шару","render.aging_rust":"Окиснене залізо / іржа","render.aging_scale":"Масштаб візерунка","render.aging_scratches":"Дрібні подряпини","render.aging_target":"Ціль і координати","render.aging_target_help":"Названа ціль має й надалі збігатися із зафіксованими індексом і назвою. Глобальні маски прив'язані до світу й не рухаються разом з рухомими деталями. Це не виявлення заглиблень і не справжнє стирання ребер. Щоб дістатися до інших тіл, відфільтруйте список.","render.aging_target_search":"Фільтр за назвами тіл","render.aging_upward":"Осідання на верхніх поверхнях","render.all_controls_help":"Щільний огляд усіх поточних елементів керування. Сторінки розділів дають змогу зосереджено редагувати, не змінюючи основний запит.","render.all_shots_label":"Усі кадри","render.appearance_editor.absorption":"Поглинання","render.appearance_editor.base_colour":"Основний колір","render.appearance_editor.body_reason":"Оптичні прив'язки діють на все тіло цілком. Виберіть «Тіло», щоб змінювати ці елементи керування.","render.appearance_editor.boundary":"Межа","render.appearance_editor.box":"Куб","render.appearance_editor.choose_image":"Вибрати зображення…","render.appearance_editor.closed":"Замкнене тіло","render.appearance_editor.coat":"Прозоре покриття","render.appearance_editor.cpu_reason":"Потрібне трасування променів на CPU.","render.appearance_editor.glass":"Скло та поглинання","render.appearance_editor.glass_enable":"Використовувати фізичне скло для цього тіла","render.appearance_editor.glass_note":"Замкнене скло використовує геометричну відстань. Його не можна поєднувати в одному тілі з прозорим покриттям або картами.","render.appearance_editor.gpu_reason":"Потрібне трасування шляхів на GPU.","render.appearance_editor.ior":"Показник заломлення (IOR)","render.appearance_editor.maps":"Карти","render.appearance_editor.normal":"Нормаль","render.appearance_editor.normal_strength":"Інтенсивність нормалі","render.appearance_editor.origin":"Початок координат","render.appearance_editor.recipe":"Рецепт","render.appearance_editor.reflection_sampling":"Вибірка для всіх відбивних тіл","render.appearance_editor.reflections":"Відбиття","render.appearance_editor.remove":"Видалити збережене","render.appearance_editor.remove_note":"Видалити збережені оптичні властивості з цього кадру. Геометрію та призначені вигляди буде збережено.","render.appearance_editor.remove_title":"Видалити збережені оптичні властивості?","render.appearance_editor.replace":"Замінити збережені оптичні властивості цього тіла","render.appearance_editor.revalidate":"Повторно перевірити це тіло","render.appearance_editor.save":"Зберегти ці оптичні властивості","render.appearance_editor.save_reason":"Щоб зберегти ці оптичні властивості, потрібне фізичне скло на поточному тілі, яке рендериться на GPU. Покриття та локальні карти зображень залишаються тимчасовими.","render.appearance_editor.saved":"Збережено з цим кадром","render.appearance_editor.saved_state":"Ці оптичні властивості збережено з цим кадром.","render.appearance_editor.scatter_reason":"Внутрішнє розсіювання потребує межі замкненого тіла.","render.appearance_editor.temporary":"Ці оптичні властивості тимчасові на цій вкладці. Збережіть їх, щоб залишити їх разом із кадром.","render.appearance_editor.thickness":"Товщина","render.appearance_editor.thickness_reason":"Товщина застосовується до тонких листів; замкнене скло використовує геометричну відстань.","render.appearance_editor.thin":"Тонкий лист","render.appearance_editor.u_repeat":"Повтор за U","render.appearance_editor.v_repeat":"Повтор за V","render.appearance_editor.v_up":"Вісь V текстури спрямована вгору","render.appearance_editor.weight":"Вага","render.appearance_physics_separate":"Візуальний вигляд не задає густину, теплові дані чи інші інженерні властивості.","render.appearances":"Вигляди","render.assign_help":"Клацніть, щоб застосувати до виділення; перетягніть для попереднього перегляду й відпустіть або клацніть без виділення, щоб нанести.","render.availability_native":"Вбудована композиція; перегляньте перед застосуванням","render.availability_projection":"Підтримувана проєкція; див. обсяг і пропуски","render.availability_reference":"Довідкові дані; не автоматичне призначення","render.backdrop_alpha_conflict":"Оберіть цей задник або прозорий вивід PNG; рендерер не ігноруватиме жодне з налаштувань мовчки.","render.backdrop_enable":"Використовувати градієнтний задник лише для камери","render.backdrop_first":"Початковий / центральний колір","render.backdrop_help":"Цей екранний задник не освітлює, не відкидає тіней, не відбиває і не зображує місцевість. Він не потрапляє в необроблений EXR. Геометрія, світло й середовище HDR лишаються незалежними.","render.backdrop_horizontal":"Горизонтальний градієнт","render.backdrop_radial":"Радіальний градієнт","render.backdrop_radius":"Радіус","render.backdrop_second":"Кінцевий / крайовий колір","render.backdrop_vertical":"Вертикальний градієнт","render.backdrop_x":"Центр X","render.backdrop_y":"Центр Y","render.background":"Фон сцени","render.background_camera_section":"Фон камери · презентація PNG","render.background_completed_frozen":"Показаний результат — зафіксоване готове зображення. Зміна фону не перемальовує його автоматично. Для змін лише на рівні камери скористайтеся «Перекоригувати», а для нової фізичної сцени — «Рендерити».","render.background_hdr_separate":"Поточні ресурси HDR освітлюють поверхні та відбиваються на них; вони не показуються автоматично як панорама за об'єктом. Зміна градієнта не повертає й не перефарбовує освітлення.","render.background_lighting_section":"Освітлення HDR · окремо від фону камери","render.background_no_alpha_override":"Фон камери не додається до прозорого виводу непомітно. Перекорекція необробленого майстер-кадру використовує зафіксоване покриття й не застосовує шумозаглушення повторно; вихідний EXR лишається без змін.","render.background_not_light":"Колір фону — це подання, а не додаткове джерело світла.","render.background_regrade":"Застосувати до збереженого необробленого майстер-кадру","render.background_stage_occlusion":"Цей кадр містить геометрію фізичної сцени. Велика підлога чи стіна може заповнити кадр і приховати фон лише для камери. Свідомо приберіть сцену чи змініть її розмір або змініть її фізичну відбивну здатність. Перекорекція не може прибрати зафіксовану геометрію.","render.background_workflow":"Оберіть потрібний фон: колір чи градієнт лише для камери, фізичну сцену, що отримує світло, або освітлення HDR. Вони незалежні. Живий попередній перегляд — це вигляд для моделювання; щоб побачити фінішну обробку камерою, відрендеріть нове зображення або перекоригуйте збережений майстер-кадр.","render.base_appearance":"Змінюваний вигляд тіла","render.base_apply":"Застосувати вигляд тіла","render.base_apply_help":"Одне візуальне призначення з можливістю скасування для переглянутого конкретного тіла. Наявні вигляди окремих граней та інженерні матеріали лишаються окремими.","render.base_color":"Базовий колір · sRGB","render.base_metallic":"Частка металу","render.base_opaque_only":"Цей редактор зберігає семантику непрозорого тіла. Для оптичного пропускання користуйтеся окремими елементами керування склом.","render.bloom_enable":"Показувати свічення","render.bloom_help":"Творче сяйво лише для виводу від додатних лінійних відблисків, розмите трьома нормалізованими прямокутними проходами. Радіус задається у пікселях виводу. Додається в лінійному світлі дисплея перед sRGB; це не лінза, не об'ємний ефект і не поліпшення збіжності. Необроблений EXR не змінюється.","render.bloom_opaque":"Свічення потребує непрозорого виводу. Прозорий PNG відхиляється, а не мовчки зводиться до плоского.","render.bloom_radius":"Радіус свічення","render.bloom_strength":"Сила свічення","render.bloom_threshold":"Лінійний поріг відблисків","render.browse_capabilities":"Переглянути повний каталог можливостей","render.browse_environments":"Переглянути оригінальні середовища HDR","render.browse_looks":"Огляд…","render.browse_native_scenes":"Переглянути вбудовані студії","render.browse_physical":"Переглянути фізичні еталони","render.browse_quality":"Переглянути специфікації якості","render.browse_rigs":"Переглянути авторські схеми освітлення","render.browse_scene_specs":"Переглянути розширені специфікації сцен","render.browse_surfaces":"Переглянути авторські поверхні","render.browser_library":"Бібліотека","render.browser_model":"Модель","render.camera_distance":"Відстань від ока до цілі","render.camera_exact_help":"Світові міліметри; кути показуються в градусах, а зберігаються в радіанах. Навігація використовує ту саму камеру, що й вікно перегляду.","render.camera_fov":"Вертикальне поле зору","render.camera_pitch":"Тангаж камери","render.camera_roll":"Крен","render.camera_set":"Задати камеру рендерингу","render.camera_target":"Положення цілі · мм","render.camera_yaw":"Рискання","render.category_metal":"Метал","render.category_paint":"Фарба","render.category_plastic":"Пластик","render.category_wood":"Дерево","render.check_opaque":"Прозорість: лише непрозорі поверхні; альфа-канал фону підтримується.","render.check_sorted_alpha":"Прозорість: наближення з сортуванням за альфою.","render.check_transmission":"Прозорість: фізичне пропускання світла.","render.children.absolute_floor":"Абсолютний поріг","render.children.adaptive":"Адаптивна вибірка","render.children.add_look_reason":"Додайте стиль, щоб змінити його ввімкнення та силу.","render.children.all_shots":"Усі кадри","render.children.bloom":"Світіння","render.children.check":"Перевірити","render.children.check_now":"Перевірити зараз","render.children.chromatic":"Хроматичне","render.children.compact":"Компактний","render.children.contrast":"Контраст","render.children.copy_image":"Копіювати","render.children.copy_job":"Копіювати JSON завдання","render.children.copy_request":"Копіювати JSON запиту","render.children.coverage_error":"Похибка покриття","render.children.cpu":"Трасування променів на CPU","render.children.denoise":"Зменшення шуму","render.children.depth":"Глибина шляху","render.children.distortion":"Спотворення","render.children.edge_samples":"Вибірки країв","render.children.effects_banner":"Ці ефекти потребують трасування шляхів на GPU. Відкриття цього ніколи не змінює метод.","render.children.enable_adaptive":"Увімкніть незалежні проби, щоб змінити адаптивні межі.","render.children.enable_bloom":"Увімкніть свічення, щоб змінити його силу, поріг і радіус.","render.children.finishing":"Оздоблення","render.children.flare":"Відблиск","render.children.fresnel":"Шари Френеля","render.children.ghosts":"Кільця-привиди","render.children.glass":"Перенесення світла у склі","render.children.go_to":"Перейти до {editor}","render.children.grain":"Зерно","render.children.halo":"Гало","render.children.hdr":"HDR","render.children.keep_master":"Зберігати необроблений лінійний майстер","render.children.last_result":"Останній: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Ефекти об'єктива","render.children.look_summary":"{tone} · стилів: {count}","render.children.looks":"Стилі вигляду","render.children.memory":"Пам'ять","render.children.method":"Метод","render.children.minimum":"Мінімум","render.children.needs_cpu":"Потрібне трасування променів на CPU. Відкриття цього ніколи не змінює метод.","render.children.nested":"Сертифіковані вкладені діелектрики","render.children.not_checked":"Не перевірено","render.children.path":"Трасування шляхів","render.children.pilots":"Пробні вибірки","render.children.preview":"Дані попереднього перегляду","render.children.progressive_reason":"Виберіть «Поступове», щоб змінити кількість вибірок і початкове значення.","render.children.radius":"Радіус","render.children.reflect_depth":"Глибина відбиття","render.children.reflect_samples":"Вибірки відбиття","render.children.regrade":"Повторне градуювання","render.children.relative_error":"Відносна похибка","render.children.render":"Рендеринг","render.children.render_shot":"Відрендерити кадр","render.children.renderer":"Рендерер","render.children.renderers":"Рендерери","render.children.request":"Цей запит","render.children.reset_finishing":"Скинути оздоблення","render.children.review_quality":"Переглянути специфікацію якості…","render.children.rgb_gain":"Підсилення RGB","render.children.samples":"Вибірки","render.children.sampling":"Дискретизація","render.children.saturation":"Насиченість","render.children.scene_summary":"Тіл: {bodies} · трикутників: {triangles}","render.children.seed":"Початкове значення","render.children.sharpening":"Підвищення різкості","render.children.single_image":"Одне зображення","render.children.soft_focus":"М'який фокус","render.children.streak":"Смуга","render.children.strength":"Сила","render.children.studio":"Студія","render.children.threshold":"Поріг","render.children.tone":"Тон","render.children.under_hood":"Технічні подробиці","render.children.vignette":"Віньєтування","render.children.workstation":"Робоча станція","render.choose_look":"Спершу виберіть стиль у розділі «Вигляд»","render.chromatic_offset":"Хроматичне зміщення країв","render.clear_stage":"Видалити збережену сцену","render.copy_request":"Копіювати JSON","render.cpu_aa_help":"Просторові вибірки: більше вибірок покращує краї, але збільшує час рендерингу.","render.cpu_area_add":"Додати прямокутне світло CPU","render.cpu_area_editor":"Прямокутні світла CPU","render.cpu_area_editor_help":"Повні вектори сторін у міліметрах; векторний добуток U на V вказує в бік випромінювання. Це відрізняється від векторів половини сторони на GPU.","render.cpu_area_full_u":"Повна сторона U · мм","render.cpu_area_full_v":"Повна сторона V · мм","render.cpu_area_samples":"Вибірок площинного світла","render.cpu_binding_confirm":"Підтвердити це тіло","render.cpu_binding_stale":"Сцену змінено. Перед рендерингом ще раз підтвердьте цю ціль відбиття.","render.cpu_body_choose":"Виберіть тіло","render.cpu_body_filter":"Фільтр тіл за назвою","render.cpu_body_filter_more":"Уточніть фільтр, щоб побачити більше тіл.","render.cpu_body_missing":"Ціль відбиття відсутня, прихована, неоднозначна або має назву довшу за 128 байтів. Виберіть її знову.","render.cpu_budget":"Профіль ресурсів CPU","render.cpu_budget_bodies":"Ліміт тіл","render.cpu_budget_compact":"Компактний (застарілі ліміти)","render.cpu_budget_details":"Ліміти ресурсів","render.cpu_budget_help":"Більші ліміти слід вибирати явно. Роздільність і вибірки ніколи не зменшуються автоматично.","render.cpu_budget_memory":"Ліміт пам'яті завдання","render.cpu_budget_not_guarantee":"Це ліміти допуску, а не резервування RAM і не гарантія швидкості. Геометрія, буфер зображення й збережені попередні перегляди ділять один бюджет пам'яті; рендеринг можна скасувати.","render.cpu_budget_resize":"Чернетка перевищує цей профіль CPU або його бюджет вибірок камери. Явно прийміть менші розміри або виберіть більший профіль.","render.cpu_budget_studio":"Студійний (великі зображення)","render.cpu_budget_triangles":"Ліміт трикутників","render.cpu_budget_workstation":"Робоча станція (важкі сцени)","render.cpu_captured_hdr":"HDR зафіксовано для цього зображення","render.cpu_check_capture_help":"Перевірка та Запуск звіряють той самий дайджест файлу або використовують вбудований HDR. Кожне зображення зберігає своє зафіксоване джерело.","render.cpu_check_changed":"Елементи керування або модель змінилися після цієї перевірки. Перевірте ще раз перед рендерингом.","render.cpu_constant_help":"Стала випромінювальність видима для відбитих або пропущених променів. Вона не дає прямого дифузного освітлення.","render.cpu_custom_directions":"Замінити пресет власними напрямленими джерелами світла","render.cpu_direction":"Напрямок до джерела світла (X, Y, Z)","render.cpu_directional":"Напрямлене світло","render.cpu_directional_add":"Додати напрямлене світло","render.cpu_environment":"Середовище CPU","render.cpu_environment_background":"Фон зображення залишається окремим від освітлення середовища.","render.cpu_environment_bounds":"Інтенсивність CPU має бути 0–64, обертання HDR — скінченним у межах ±1,000,000 радіанів, а вибірок HDR — 1, 4, 16 або 64.","render.cpu_environment_constant":"Стале середовище для вторинних променів","render.cpu_environment_none":"Без середовища CPU","render.cpu_environment_samples":"Вибірки освітлення HDR","render.cpu_exposure_help":"Експозиція CPU має бути від −16 до 16 EV. Експозиція GPU поза цим діапазоном зберігається, доки ви її не зміните.","render.cpu_fixed":"Одне зображення","render.cpu_hdr_help":"Radiance .hdr, панорама 2:1, до 2048 × 1024 і 16 MiB. CPU вимагає в файлі явно вказаних основних кольорів sRGB/D65; невказані основні кольори та EXR відхиляються.","render.cpu_hdr_reflection_help":"Шорсткі відбиття HDR потребують повністю металевих поверхонь тіл і граней. Перевірка повідомляє про непідтримувані поєднання.","render.cpu_key_rim":"Ключове й контурне","render.cpu_last_check":"Остання перевірка CPU","render.cpu_light_help":"До восьми напрямлених джерел світла. Порожній власний список вимикає їх; вибір пресета відновлює його джерела. Кольори — лінійний RGB, а інтенсивність відносна, не у ватах.","render.cpu_light_intensity":"Відносна інтенсивність (0–64)","render.cpu_light_minimum":"Мінімальна відстань для згасання","render.cpu_light_position":"Положення у світі (X, Y, Z)","render.cpu_light_reference":"Опорна відстань для інтенсивності","render.cpu_light_remove":"Видалити джерело світла","render.cpu_lighting":"Пресет освітлення","render.cpu_lights":"Джерела світла CPU","render.cpu_linear_color":"Лінійний колір (R, G, B)","render.cpu_neutral":"Нейтральне","render.cpu_opaque_required":"Трасування променів на CPU потребує непрозорого фону. Зніміть позначку «Прозорий фон», щоб продовжити.","render.cpu_options_pending":"Ця панель CPU поки не може редагувати випромінювання, ефекти поверхні, скло чи анізотропію. Приберіть ці параметри API, перш ніж нею користуватися.","render.cpu_point":"Точкове світло","render.cpu_point_add":"Додати точкове світло","render.cpu_point_help":"До восьми точкових джерел світла, що додаються до вибраного напрямленого освітлення. Відстані — у мм; мінімум не має перевищувати опорну відстань.","render.cpu_primary_samples":"Вибірок краю на піксель","render.cpu_progressive":"Прогресивний CPU","render.cpu_progressive_help":"Накопичувати наявний інтегратор CPU проходами по одній первинній вибірці. Вибрані відбиття потребують однієї вибірки; площинні джерела світла, діелектрики та анізотропія потребують режиму «Одне зображення».","render.cpu_progressive_limits":"Не більше 1,048,576 пікселів і 16,777,216 обчислень «піксель × вибірка». Зміна кількості вибірок ніколи не змінює розмір зображення автоматично.","render.cpu_progressive_seed":"Початкове значення вибірки CPU","render.cpu_progressive_spp":"вибірок на піксель","render.cpu_reflection_add":"Додати шорстке відбиття","render.cpu_reflection_depth":"Глибина відбиття (1–8)","render.cpu_reflection_empty":"Тіла не вибрано: відбиття сцени вимкнено.","render.cpu_reflection_help":"Виберіть тіла та задайте «Вимкнено», «Дзеркальне» або «Шорстке». Шорстке використовує призначену шорсткість поверхні. Більше вибірок і відскоків збільшує час; це обмежене дзеркальне перенесення, а не глобальне освітлення.","render.cpu_reflection_limit":"Підтримується до 64 тіл із відбиттями.","render.cpu_reflection_mirror":"Дзеркальне","render.cpu_reflection_off":"Вимкнено","render.cpu_reflection_rough":"Шорстке","render.cpu_reflection_samples":"Вибірки відбиття (1–64)","render.cpu_reflections":"Відбиття CPU","render.cpu_runtime_help":"Числові параметри світла й середовища зберігаються разом із набором налаштувань. Відбиття тіл і файли HDR залишаються тимчасовими. Наявні значення площинних джерел світла та конуса прожектора зберігаються.","render.cpu_sampling_mode":"Режим вибірки CPU","render.cpu_shadows":"Відкидати тіні","render.cpu_summary":"Трасування променів на CPU · відбиття · HDR · напрямлене й точкове світло","render.cpu_warm_cool":"Тепле й холодне","render.diag_bodies":"Видимі тіла","render.diag_job_details":"Подробиці зафіксованого завдання","render.diag_last_check":"Остання попередня перевірка","render.diag_memory":"Оцінка логічного допуску","render.diag_not_implemented":"Явні межі можливостей","render.diag_preflight_details":"Подробиці попередньої перевірки","render.diag_request":"Точний поточний запит","render.diag_triangles":"Трикутники","render.discard_continue":"Відхилити чернетку й продовжити","render.draft_confirm_help":"Поточна чернетка рендерингу має незастосовані зміни. Збережіть їх перед перемиканням, явно відхиліть або продовжте редагування.","render.draft_confirm_title":"Зберегти змінені налаштування рендерингу","render.effects_gpu_only":"Ці ефекти потребують трасування шляхів на GPU. Зміна сторінки ніколи не перемикає рендерер автоматично.","render.effects_help":"Поєднуйте впорядковані кольорові вигляди та ефекти об'єктива у просторі зображення. Рендеринг і повторна колірна обробка сирого майстра використовують ті самі збережені налаштування. Сирий EXR залишається незмінним. Це оригінальні художні параметри, а не відкалібровані емуляції об'єктива чи фірмової плівки.","render.effects_reset_lens":"Скинути ефекти об'єктива","render.effects_seed":"Початкове значення візерунка","render.emitted_axis":"Вісь випромінювання","render.env_advanced":"Додатково","render.env_backdrop":"Задник","render.env_backdrop_pending":"Видимість середовища та розмиття фону поки не підтримуються рендерером.","render.env_blur":"Розмиття","render.env_change":"Змінити","render.env_choose_source":"Перш ніж редагувати освітлення, виберіть середовище в розділі «Студії та середовища».","render.env_clear":"Очистити","render.env_colour":"Колір","render.env_environments":"Середовища","render.env_ground":"Підлога","render.env_ground_pending":"Фізична підлога отримує тіні як скінченна дифузна поверхня. Режим лише тіней та відбиття на підлозі поки не підтримуються.","render.env_intensity":"Інтенсивність","render.env_invalid_edit":"Недійсна зміна середовища.","render.env_physical_ground":"Фізична підлога","render.env_preview_help":"Ілюстративний зразок сфери, а не попередній перегляд вибраного середовища.","render.env_reflection":"Відбиття","render.env_ring_help":"Перетягніть кільце, щоб повернути освітлення. Утримуйте Shift, щоб прив'язуватися з кроком 15°.","render.env_rotate":"Обертання","render.env_set":"Задати середовище рендерингу","render.env_shadow_catcher":"Приймач тіней","render.env_show_environment":"Показати середовище","render.env_source":"Джерело","render.env_stage_details":"Редагування підлоги потребує трасування променів і однієї панелі підлоги. Щоб редагувати інші панелі майданчика, скористайтеся розділом «Сцена».","render.env_studios":"Студії","render.environment.albedo":"Альбедо","render.environment.atmosphere":"Атмосфера","render.environment.backdrop_note":"Задник бачить лише камера. Він ніколи не освітлює, не відкидає тіней і не відбивається, а за прозорого виведення відхиляється.","render.environment.blur_pending":"Розмиття недоступне: у рендерері немає налаштування розмиття задника.","render.environment.builtin":"Вбудований HDR","render.environment.check":"Перевірити файл","render.environment.checked":"Файл HDR перевірено. Під час збереження ці байти вбудовуються.","render.environment.choose":"Вибрати HDR…","render.environment.constant":"Стала","render.environment.cyclorama":"Циклорама","render.environment.embedded":"Збережено в цьому проєкті","render.environment.end":"Кінець","render.environment.extinction":"Згасання","render.environment.file":"Файл","render.environment.fit":"Підігнати й зберегти підлогу","render.environment.floor_wall":"Підлога і стіна","render.environment.gap":"Зазор","render.environment.gradient":"Градієнт","render.environment.gradient_gpu":"Градієнтний задник потребує трасування шляхів на GPU.","render.environment.ground":"Підлога і майданчик","render.environment.hdr":"HDR","render.environment.hdr_file":"Файл HDR","render.environment.horizon":"Горизонт","render.environment.horizontal":"Горизонтальний","render.environment.keep":"Залишити","render.environment.lighting_samples":"Вибірки освітлення","render.environment.margin":"Запас розміру","render.environment.max":"Макс. межі","render.environment.medium":"Середовище, що взаємодіє зі світлом","render.environment.min":"Мін. межі","render.environment.mode":"Режим","render.environment.needs_gpu":"Потрібне трасування шляхів на GPU.","render.environment.none":"Немає","render.environment.orientation":"Орієнтація та інтенсивність","render.environment.phase":"Фаза","render.environment.primaries":"Вважати невказані основні кольори лінійним sRGB","render.environment.primaries_gpu":"Інтерпретація невказаних основних кольорів потребує трасування шляхів на GPU.","render.environment.radial":"Радіальний","render.environment.radial_only":"Центр і радіус застосовуються в радіальному режимі.","render.environment.reflectance":"Відбивна здатність","render.environment.remove":"Видалити майданчик","render.environment.remove_confirm":"Видалити збережений майданчик?","render.environment.remove_note":"Видаляє пасивні панелі ({count}) із цього кадру. Задник камери залишається.","render.environment.replace":"Підтвердити заміну наявного майданчика","render.environment.rotation_hdr":"Для обертання за трасування променів на CPU потрібне джерело HDR.","render.environment.samples_cpu":"Вибірки освітлення визначаються бюджетом трасування шляхів на GPU; це налаштування потребує трасування променів на CPU.","render.environment.saved_panels":"Збережені панелі: {count}","render.environment.sky_ground":"Земля","render.environment.sky_note":"Оригінальний градієнт неба для освітлення, а не відкалібрована атмосфера.","render.environment.source_raytrace":"Джерела середовища потребують трасування променів на CPU або GPU.","render.environment.stage_raytrace":"Фізичні майданчики потребують трасування променів на CPU або GPU.","render.environment.start":"Початок","render.environment.vertical":"Вертикальний","render.environment.world":"Світ","render.environment.world_pending":"Задник «Світ» недоступний: для видимості середовища камерою ще немає збереженого налаштування.","render.environment.zenith":"Зеніт","render.environment_tiles_require_raytrace":"Для середовищ потрібне трасування променів на CPU або GPU. Виберіть його в редакторі виведення.","render.error_area_samples":"area_samples має бути 1, 4, 16 або 64","render.error_binding_allocation":"не вдалося зарезервувати прив'язку матеріалу","render.error_body_bound":"попередній перегляд виробу перевищує ліміт захоплених тіл","render.error_checkpoint_dimensions":"розміри контрольної точки відрізняються від захопленого запиту","render.error_decode_budget":"перевищено бюджет декодування зображення","render.error_denoise_setting":"недійсне нативне налаштування шумозаглушення","render.error_display_dimensions":"недійсні розміри відображення зображення","render.error_display_fit":"відображення зображення не вміщується на цьому пристрої","render.error_display_height":"переповнення висоти відображення","render.error_display_width":"переповнення ширини відображення","render.error_duplicate_face":"повторний вигляд грані виробу","render.error_export_document":"Документ експорту рендерингу змінився під час вибору місця призначення","render.error_face_cap":"попередній перегляд виробу перевищує допустиму кількість виглядів граней","render.error_finish_gesture":"завершіть жест моделювання перед попереднім переглядом","render.error_finish_operation":"завершіть поточну операцію моделювання перед переходом до рендерингу","render.error_fixed_preview":"фіксований студійний перегляд вимагає експозиції 0, обертання середовища 0 та інтенсивності 1","render.error_geometry_size":"переповнення розміру геометрії виробу","render.error_glass_recipe":"невідомий рецепт скла","render.error_gpu_preview":"Попередній перегляд виробу на GPU недоступний на цьому пристрої. Збережені налаштування залишаються доступними.","render.error_gpu_samples":"непідтримувана кількість вибірок GPU","render.error_image_dimensions":"розміри зображення рендерингу не відповідають його завданню","render.error_image_profile":"зображення рендерингу перевищує захоплений профіль ресурсів","render.error_interactive_command":"непризначена інтерактивна команда рендерингу","render.error_job_action":"це не дія інтерактивного завдання зображення","render.error_job_identity":"недійсний ідентифікатор завдання рендерингу: {error}","render.error_library_reply":"недійсна відповідь бібліотеки рендерингу","render.error_material_binding":"відсутня прив'язка матеріалу","render.error_no_completed_image":"у рендерингу немає завершеного зображення","render.error_no_geometry":"немає геометрії виробу","render.error_no_scene":"немає сцени виробу","render.error_opacity":"недійсна непрозорість вигляду виробу","render.error_pbr_opacity":"непрозорий PBR вимагає непрозорості 1","render.error_physical_glass":"вибраний рецепт не є фізичним склом","render.error_preview_device":"для попереднього перегляду виробу потрібен установлений пристрій із буфером глибини","render.error_product_triangle":"недійсний трикутник виробу","render.error_provisional_identity":"недійсний ідентифікатор проміжного рендерингу або кількість вибірок","render.error_quality_bounds":"проєкція якості перевищує нативні межі","render.error_quality_method":"проєкція якості вимагає того самого явного методу GPU","render.error_quality_projection":"недійсна нативна проєкція якості","render.error_regrade_identity":"недійсний ідентифікатор перекоригування: {error}","render.error_scene_bodies":"відсутні тіла сцени рендерингу","render.error_scene_body_limit":"сцена рендерингу перевищує ліміт тіл","render.error_scene_identity":"недійсний ідентифікатор сцени рендерингу","render.error_setup_panicked":"під час ініціалізації трасувальника шляхів GPU виникла паніка","render.error_setup_stopped":"робочий потік ініціалізації зупинився, не повернувши хост","render.error_setup_worker":"не вдалося запустити робочий потік ініціалізації: {error}","render.error_source_preview":"попередній перегляд джерела перевищує байтовий ліміт","render.error_surface_normals":"PBR вимагає ненульових нормалей поверхні","render.error_surface_reply":"недійсна відповідь для авторської поверхні","render.error_triangle_bound":"попередній перегляд виробу перевищує ліміт у вісім мільйонів трикутників джерела","render.error_triangle_count":"переповнення кількості трикутників виробу","render.error_upload_slot":"слот завантаження попереднього перегляду виробу недоступний","render.error_vertex_allocation":"не вдалося виділити пам'ять для вершин попереднього перегляду виробу","render.error_vertex_envelope":"попередній перегляд виробу перевищує ліміт даних вершин {limit} MiB; геометрію не спрощено","render.error_vertex_packing":"пакування попереднього перегляду виробу відрізняється від допущених даних вершин","render.error_visible_solid":"Створіть видиме тіло в розділі «Проєкт», щоб переглянути його тут.","render.exit_focus":"Вийти з фокусу","render.export_display":"Експорт: PNG для екрана","render.export_image_label":"Експорт зображення","render.export_linear":"Експорт: сирий лінійний EXR","render.exr_pending":"GPU може зберігати сирий лінійний EXR. Стиснення, багатошарові зображення та допоміжні проходи рендерингу поки недоступні.","render.film_grain":"Фотографічне зерно","render.fit":"Вписати виріб","render.fixed_camera":"Камера","render.fixed_world":"Світ","render.flare_ghosts":"Кілець-привидів на джерело","render.flare_halo":"Гало відблиску","render.flare_streak":"Смуга в анаморфному стилі","render.flare_strength":"Сила відблиску яскравих місць","render.flare_threshold":"Поріг відблиску в лінійній сцені","render.fold_browser":"Згорнути браузер","render.frame_aspect":"Співвідношення сторін","render.frame_centre_mark":"Центральна позначка","render.frame_copy_limit":"Немає вільної назви для копії кадру","render.frame_copy_name":"{name} — копія {number}","render.frame_custom":"Власне","render.frame_distance_unit":" × розмір","render.frame_duplicate":"Дублювати","render.frame_exposure":"Експозиція","render.frame_fov":"Поле зору","render.frame_guides":"Напрямні","render.frame_invalid_aspect":"Недійсний набір співвідношення сторін","render.frame_lens":"FOV {fov}° · ≈ {mm} мм","render.frame_name":"Назва","render.frame_output_size":"Розмір виводу","render.frame_photo":"3:2 · Фото","render.frame_portrait":"4:5 · Портрет","render.frame_presets":"Набори кадрування","render.frame_presets_pending":"З'явиться разом із редактором кадрів","render.frame_projection":"Проєкція","render.frame_render_shot":"Відрендерити цей кадр","render.frame_rule_thirds":"Правило третин","render.frame_safe_area":"Безпечна зона","render.frame_shot_title":"Кадр · {name}","render.frame_square":"1:1 · Квадрат","render.frame_tall":"9:16 · Вертикальний","render.frame_thirds":"Третини","render.frame_wide":"16:9 · Широкоекранний","render.gpu_depth":"Максимальна глибина шляху","render.gpu_options_help":"Вибірки, глибина, початкове значення та експозиція зберігаються разом із цим набором налаштувань. Зберігається лише активний метод зображення.","render.gpu_path_failed":"Трасувальник шляхів GPU недоступний","render.gpu_path_first_setup":"Перша підготовка на цьому GPU може тривати кілька хвилин; SolidCraft тим часом лишається придатним до роботи. Наступні запуски повторно використовують скомпільовані шейдери, якщо драйвер їх зберігає.","render.gpu_path_preparing":"Трасувальник шляхів GPU: компіляція шейдерів…","render.gpu_seed":"Випадкове початкове значення","render.gpu_unavailable":"Трасування шляхів на GPU не готове на цьому пристрої.","render.ground_apply":"Підігнати й зберегти підлогу","render.ground_gap":"Явний зазор","render.ground_linear_rgb":"Дифузне відбиття · лінійний RGB","render.ground_margin":"Запас розміру підлоги","render.hdr_details":"Подробиці джерела HDR","render.hdr_embedded":"HDR збережено всередині цього проєкту","render.hdr_embedded_help":"Рендеринг використовує байти, включені до проєкту; початковий файл більше не потрібен.","render.hdr_file_captured":"Файл HDR перевірено. Під час збереження ці байти буде вбудовано; якщо файл зміниться, перевірте його ще раз явно.","render.hdr_inspect":"Перевірити файл HDR","render.hdr_inspect_required":"Виберіть і перевірте файл HDR перед збереженням або рендерингом.","render.hdr_primaries_declared":"Джерело оголошує свої основні кольори.","render.hdr_primaries_srgb":"Основні кольори: sRGB/D65","render.hdr_primaries_undeclared":"Джерело не оголошує основних кольорів; перегляньте вимоги рендерера до кольору.","render.hdr_resource_missing":"У цьому проєкті бракує збереженого ресурсу HDR.","render.heading_batch":"ПАКЕТ","render.heading_frame":"КАДРУВАННЯ","render.heading_lens":"ОБ'ЄКТИВ","render.heading_results":"РЕЗУЛЬТАТИ","render.heading_shots":"КАДРИ","render.hide_shots_label":"Сховати стрічку кадрів","render.hover_look":"{object} · {look} · клацніть, щоб вибрати","render.image_advanced":"Додаткові параметри GPU","render.image_cancelled":"Рендеринг скасовано","render.image_cancelling":"Скасування","render.image_completed":"Зображення готове до експорту","render.image