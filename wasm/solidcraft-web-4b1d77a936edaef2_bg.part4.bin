 agent for this conversation","ui.ai_test":"Test","ui.ai_test_acp_ok":"Answers: {agent}","ui.ai_test_acp_tip":"Starts the agent briefly and asks it for a session; ends it again","ui.ai_test_answered":"Reached: {model} answered","ui.ai_test_anthropic_tip":"Sends a short message to the endpoint","ui.ai_test_api_tip":"Asks the endpoint for its models","ui.ai_test_no_model":"Reached: {count} models, but not {model}","ui.ai_test_ok":"Reached: {count} models","ui.ai_testing":"Testing…","ui.ai_tool_arguments":"Arguments","ui.ai_tool_details":"Details","ui.ai_tool_done":"done","ui.ai_tool_failed":"failed","ui.ai_tool_result":"Result","ui.ai_tool_running":"running","ui.ai_tool_sum_bodies_one":"{count} body","ui.ai_tool_sum_bodies_other":"{count} bodies","ui.ai_tool_sum_by":"by {value}","ui.ai_tool_sum_edges_one":"{count} edge","ui.ai_tool_sum_edges_other":"{count} edges","ui.ai_tool_sum_faces_one":"{count} face","ui.ai_tool_sum_faces_other":"{count} faces","ui.ai_tool_sum_features_one":"{count} feature","ui.ai_tool_sum_features_other":"{count} features","ui.ai_tool_sum_measured":"Measured {what}","ui.ai_tool_sum_more":"{steps}, and {count} more","ui.ai_tool_sum_radius":"r {value}","ui.ai_tool_sum_saved":"Saved {file}","ui.ai_tool_sum_screenshot":"Screenshot","ui.ai_tool_sum_then":"{first}, then {next}","ui.ai_tool_unfold":"Click to show what it returned","ui.ai_tool_waiting":"waiting","ui.ai_toolbar_button":"Show Assistant button in application bar","ui.ai_toolbar_button_note":"The Assistant button in the application bar. Ctrl+Shift+A and the View menu still open the panel.","ui.ai_undo_tip":"Undo everything the agent changed for this message, as one step","ui.ai_url_hint":"https://example.com/v1","ui.all":"All","ui.ambient_occlusion":"Ambient occlusion","ui.ambient_occlusion_help":"Soft shading where opaque surfaces meet. Requires the GPU viewport.","ui.analysis":"Analysis","ui.angle":"Angle","ui.angle_decimals":"Angle decimals","ui.animateJoint":"Animate Joint","ui.animate