vani prikaz","cmd.view_fit":"Uklopi","cmd.view_front":"Pogled sprijeda","cmd.view_graphics_preset":"Grafička postavka","cmd.view_grid":"Mreža","cmd.view_ground_shadow":"Sjena na podlozi","cmd.view_home":"Početni prikaz","cmd.view_isometric":"Izometrijski pogled","cmd.view_left":"Pogled slijeva","cmd.view_list":"Popis imenovanih prikaza","cmd.view_navigate":"Navigacija prikaza","cmd.view_navigation_bar":"Navigacijska traka","cmd.view_next_tab":"Sljedeća kartica","cmd.view_normal_to":"Okomito na izbor","cmd.view_previous_tab":"Prethodna kartica","cmd.view_rename":"Preimenuj imenovani prikaz","cmd.view_render_frame":"Pomoćne linije kadra renderovanja","cmd.view_right":"Pogled zdesna","cmd.view_save":"Novi imenovani prikaz","cmd.view_shots_strip":"Traka kadrova","cmd.view_spin":"Neprekidno orbitiranje","cmd.view_tool":"Alat za navigaciju","cmd.view_top":"Pogled odozgo","cmd.view_visual_style":"Vizuelni stil","color.copy":"Kliknite da kopirate vrijednosti boje","color.edit":"Kliknite da uredite boju","color.gamma":"Prikaz vrijednosti boje u gama prostoru 0-255","color.hex":"Hex","color.hex_help":"Unesite #rrggbb ili #rrggbbaa; šest cifara zadržava neprozirnost","color.hex_hint":"#rrggbb","color.hue":"Nijansa","color.linear":"Prikaz vrijednosti boje u linearnom prostoru 0-1","color.saturation_value":"Zasićenost i vrijednost","color.selected":"Izabrana boja","config.column_filter_empty":"Nema odgovarajućih kolona","contact.components_count":"Komponente: {count}","contact.enabled_label":"omogućeno","coupling.gear_1":"Zupčanik 1","coupling.gear_1_pick":"Zupčanik 1 (neobavezno)","coupling.gear_2":"Zupčanik 2","coupling.gear_2_pick":"Zupčanik 2 (neobavezno)","coupling.internal":"Unutrašnji zupčanik","coupling.needs_turn_and_slide":"potreban je spoj koji se okreće i jedan koji klizi","coupling.needs_turns":"potrebna su dva spoja koji se okreću","coupling.not_round":"nije okruglo lice","coupling.nut":"Matica","coupling.picked":"izabrano","coupling.pinion":"Mali zupčanik","coupling.pinion_pick":"Mali zupčanik (neobavezno)","coupling.pitch":"Korak","coupling.rack":"Zupčasta letva","coupling.radius_1":"Poluprečnik 1","coupling.radius_2":"Poluprečnik 2","crash.announce":"SolidCraft se prošli put neočekivano zatvorio ili naišao na internu grešku. Sačuvan je izvještaj o rušenju (Pomoć > Izvještaji o rušenju…).","crash.copy_folder":"Kopiraj putanju foldera","crash.copy_path":"Kopiraj putanju","crash.deleted":"Izbrisani izvještaji: {count}.","crash.detected_time":"Otkriveno {time} UTC","crash.intro":"Izvještaji o rušenju ostaju na ovom računaru i nikad se nikamo ne šalju. Prijavi… otvara nacrt koji pregledate prije nego što se išta podijeli.","crash.kind_command":"Interna greška u komandi","crash.kind_internal":"Interna greška","crash.kind_kernel":"Greška jezgra (oporavljeno)","crash.kind_unclean":"Neočekivano zatvoreno","crash.previous_session":"Ranija sesija SolidCrafta završila je neočekivano ili naišla na internu grešku. Izvještaji o nepravilnim završecima rada otkrivaju se pri pokretanju. Za detalje pogledajte Pomoć > Izvještaji o rušenju….","crash.replayable":"može se ponoviti","crash.report":"Prijavi…","crash.unclean_explanation":"Otkriveno pri kasnijem pokretanju; tačno vrijeme izlaza nije zabilježeno. Gašenje sistema ili prisilno zaustavljanje također mogu uzrokovati nepravilan završetak.","delete.and_more":"… i još {count}","diagnostic.empty_boolean_component":"u komponenti '{component}' nema tijela za oduzimanje ili presjek; alat se možda preklapa s '{body}' u komponenti '{other}' — aktivirajte tu komponentu ili izaberite to tijelo kao cilj","dialog.bodies_count":"Tijela: {count}","dialog.clearance_invalid":"zazor mora biti dužina od 0 ili više","dialog.compute":"Izračunaj","dialog.compute_again":"Izračunaj ponovo","dialog.computing":"Računanje… {seconds} s","dialog.could_not_be_checked":"nije moguće provjeriti","dialog.custom_axis":"↖ Prilagođena osa","dialog.dimension_insert_hint":"Kliknite drugu pogonsku kotu da umetnete njen naziv","dialog.dimension_name":"Kota: {name}","dialog.edit_title":"UREDI {title}","dialog.no_shown_body":"Nema prikazanog tijela za izmjenu: prikažite jedno ili izaberite Novo tijelo","dialog.select":"↖ Izaberi","dialog.selected_count":"↖ Izabrano: {count}","dialog.selection_guidance":"Izaberite ulaz da ga promijenite. Kliknite izabrane objekte da ih uklonite; Ctrl/Cmd-klik ih također uključuje i isključuje. Pogledajte pregled, a zatim pritisnite U redu.","dialog.selection_step":"{step} od {total}: Izaberite {input}","dialog.step":"Korak","document.changed_on_disk":"{name} je promijenjen na disku","document.changed_on_disk_detail":"{name} je promijenio drugi program ili računar otkako ste ga otvorili ili posljednji put sačuvali. Prepiši zamjenjuje te promjene vašim; Sačuvaj kopiju zadržava obje verzije.","document.copy_name":"{name} kopija","document.open_anyway":"Ipak otvori","document.open_elsewhere":"{name} je već otvoren","document.open_elsewhere_detail":"{name} je otvoren u programu SolidCraft {app} na {who}, otvoren {when}. Ako oboje sačuvate, jedno od vas gubi rad. Otvorite ga samo za čitanje da ga pogledate bez prepisivanja.","document.open_read_only":"Otvori samo za čitanje","document.opened_read_only":"Otvoreno samo za čitanje: Sačuvaj traži novu datoteku","document.overwrite":"Prepiši","document.read_only_save":"Ovaj dizajn je otvoren samo za čitanje: sačuvajte ga kao novu datoteku","document.save_changes":"Sačuvati promjene u {name}?","document.save_copy":"Sačuvaj kopiju…","document.unsaved_changes":"{name} ima nesačuvane promjene. Ako ne sačuvate, bit će izgubljene.","drive.rigid":"{joint} je kruti spoj: drži svoje dijelove nepomičnim, pa nema šta pokretati. Da biste im omogućili kretanje, promijenite njegov tip u Uredi spoj: Revolute za rotaciju, Slider za klizanje, Cylindrical za oboje.","drive.stopped_by_contact":"Zaustavljeno na {value}: {a} bi prošao kroz {b}","drive.stopped_by_loop":"Zaustavljeno na {value}: petlja kroz {joint} se ne može dalje zatvoriti","drive.unconnected":"Ništa se ne pomjera: {part} nije povezan ni sa čim učvršćenim","dxf.cancel_wait":"Čeka se zaustavljanje izvoza…","dxf.cancelled":"DXF izvoz je otkazan","dxf.cancelling":"Otkazivanje DXF izvoza","dxf.exporting":"Izvoz DXF-a","dxf.invalid_tolerance":"Tolerancija krive mora biti između 0,0001 i 1 mm.","dxf.progress.index":"Priprema površi (2/5)","dxf.progress.meshes":"Priprema mreža (1/5)","dxf.progress.occlusion":"Razrješavanje skrivenih linija (4/5)","dxf.progress.projection":"Projektovanje geometrije (3/5)","dxf.progress.write":"Upisivanje DXF-a (5/5)","dxf.tolerance":"Tolerancija krive","dxf.tolerance_help":"Samo vidljiva tijela i prikazane skice. Krive koriste ravne segmente. Manja tolerancija daje finije krive i troši više vremena i memorije.","each rail's curves must be in one sketch":"krive svake vodilice moraju biti u jednoj skici","feature computation ended without a result":"izračunavanje operacije završilo je bez rezultata","file.open.drawing_filter":"Dizajni, CAD datoteke, mreže i crteži","file_load.built":"Do sada izgrađeno: {built} od {total} operacija.","file_load.converting":"Pretvaranje tijela {done} od {total}","file_load.inserting":"Umetanje geometrije","file_load.link_item":"{name} ({done} od {total})","file_load.opening":"Otvaranje dizajna","file_load.preparing_thumbnail":"Priprema sličice...","file_load.preparing_view":"Priprema prikaza...","file_load.preview_note":"Sačuvani pregled. Geometrija se provjerava prije uređivanja.","file_load.reading":"Čitanje datoteke...","file_load.reading_percent":"Čitanje datoteke... {percent}%","file_load.rebuilding":"Ponovna izgradnja operacije {done} od {total}","file_load.recovering":"Oporavak dizajna","file_load.stopping":"Čeka se zaustavljanje prethodne operacije...","file_load.updating_links":"Ažuriranje veza","file_load.waiting":"Čeka se operacija s datotekom","fits the face, e.g. M8":"odgovara licu, npr. M8","from the profile":"iz profila","from the rule":"iz pravila","help.apache":"Apache licenca 2.0","help.appearance.assign":"Daje izabranim tijelima, licima ili komponentama boju ili izgled materijala, bez promjene njihove težine. Koristite ga da razlikujete dijelove ili pregledate završnu obradu.","help.assembly.bom":"Navodi dijelove dizajna ili komponente s njihovim količinama, po broju dijela, a popis može sačuvati kao CSV ili JSON. Koristite je kao popis dijelova za naručivanje i montažu.","help.attributions":"Atribucije (ATTRIBUTION.md)","help.build":"Verzija {version} · commit {commit} · izgrađeno {date}","help.canvas.decal":"Postavlja sliku na ravno lice modela, poput naljepnice. Koristite je da prikažete etiketu, logotip ili štampani uzorak na dijelu.","help.canvas.edit":"Mijenja platno: njegov položaj, veličinu, ugao, neprozirnost, preslikavanje, vidljivost ili naziv. Koristite ga da poravnate referentnu sliku sa skicom kojom je precrtavate.","help.canvas.insert":"Postavlja PNG ili JPEG sliku na ravan ili lice kao prozirnu referencu. Koristite je da u skici precrtate fotografiju ili crtež, uz sliku skaliranu na poznatu veličinu.","help.component.break_link":"Odvaja povezanu komponentu od njene datoteke dizajna, a njena tijela ostavlja kakva jesu. Koristite ga kada dio više ne treba pratiti izmjene izvorne datoteke.","help.component.capture_position":"Zadržava položaje dijelova koje ste ručno pomjerili, tako da to postaju njihovi stvarni položaji. Koristite ga nakon što ručno namjestite dijelove koje nijedan spoj ne drži.","help.component.create":"Dodaje novu, praznu komponentu u dizajn, unutar aktivne komponente osim ako izaberete drugog roditelja. Koristite je da novi dio sklopa dobije vlastito mjesto za tijela i skice.","help.component.finish_edit":"Čuva dio koji uređujete na mjestu, vraća se u njegov sklop i ažurira sklop prema njemu. Upotrijebite kada završite izmjene povezanog dijela.","help.component.from_bodies":"Pretvara svako izabrano tijelo u zasebnu komponentu, nazvanu po tijelu. Koristite ga kada dizajn izgrađen od odvojenih tijela treba postati sklop čiji se dijelovi mogu spajati i pomjerati.","help.component.insert_design":"Umeće drugi sačuvani dizajn kao komponentu povezanu s njegovom datotekom, s njegovim punim tijelima postavljenim onako kako su tamo. Koristite ga da ponovo upotrijebite dio u sklopu i kasnije izmjene preuzmete pomoću Ažuriraj veze.","help.component.properties":"Prikazuje zapreminu, masu, centar mase i momente inercije komponente, prema materijalima njenih tijela. Koristite ga da provjerite težinu i uravnoteženost sklopa.","help.component.revert_position":"Vraća dijelove koje ste ručno pomjerili tamo gdje su bili, odbacujući pomjeranja koja nisu zadržana. Koristite ga da poništite probna pomjeranja u sklopu.","help.component.update_links":"Ponovo čita povezane datoteke dizajna i zamjenjuje tijela tamo gdje su se promijenila. Koristite ga nakon uređivanja dijela koji ovaj sklop koristi.","help.config.configure":"Dodaje parametre, operacije, materijale ili izglede kao kolone tabele konfiguracija. Koristite ga da napravite varijante jednog dizajna, npr. veličine nekog dijela.","help.config.preview":"Provjerava može li se red tabele konfiguracija ponovo izgraditi, bez promjene dizajna ili njegove vremenske trake. Koristite ga prije prelaska na varijantu u koju niste sigurni.","help.config.rules":"Prikazuje pravila tabele konfiguracija, njene redove i koji je red aktivan. Koristite ga da vidite kako su postavljene varijante dizajna.","help.config.table":"Prikazuje tabelu konfiguracija: jedan red po varijanti, jednu kolonu po parametru ili operaciji i da li dizajn još odgovara aktivnom redu. Koristite je da pregledate varijante dizajna.","help.connect_note":"Ponovo pokrenite svaki asistent da učita SolidCraft server. Svaka datoteka je sigurnosno kopirana kao .bak prije promjene.","help.connect_title":"Poveži AI asistente","help.construct.axis.edge":"Pravi pomoćnu osu duž ravne ivice ili linije skice. Koristite je kao osu za rotaciju, kružni niz ili spoj.","help.construct.axis.normal_to_face":"Pravi pomoćnu osu kroz tačku, okomitu na lice. Koristite je kao osu koja stoji pravo iz površine.","help.construct.axis.through_cylinder":"Pravi pomoćnu osu kroz centar cilindričnog, konusnog ili torusnog lica, ili kružne ivice. Koristite je da operacije okrećete ili ih postavljate u niz oko okruglog dijela.","help.construct.axis.two_planes":"Pravi pomoćnu osu gdje se sastaju dvije ravni ili ravna lica. Koristite je kada je osa koja vam treba linija između dva lica.","help.construct.axis.two_points":"Pravi pomoćnu osu kroz dvije tačke, vrhove ili tačke skice. Koristite je za osu koja prolazi između dva poznata položaja.","help.construct.plane.along_path":"Pravi pomoćnu ravan okomitu na ivicu ili krivu, na nekom položaju duž nje. Koristite je da skicirate profil za povlačenje ili presjek putanje.","help.construct.plane.at_angle":"Pravi pomoćnu ravan zakrenutu za ugao u odnosu na ravan ili lice, oko ose ili ivice. Koristite je za nagnute skice, npr. kutni nosač.","help.construct.plane.midplane":"Pravi pomoćnu ravan na pola puta između dvije ravni ili ravna lica, ili koja ih raspolavlja tamo gdje se sastaju pod uglom. Koristite je kao ravan simetrije za preslikavanje.","help.construct.plane.offset":"Pravi pomoćnu ravan paralelnu s ravni ili ravnim licem, na određenoj udaljenosti ili kroz tačku. Koristite je da skicirate na zadatoj visini iznad lica.","help.construct.plane.perpendicular":"Pravi pomoćnu ravan koja sadrži liniju ili ivicu i okomita je na ravan ili lice. Koristite je da skicirate uspravno na modelu duž ivice.","help.construct.plane.tangent":"Pravi pomoćnu ravan koja u jednoj tački dodiruje cilindar, konus, sferu ili torus. Koristite je da skicirate na boku okruglog dijela.","help.construct.plane.three_points":"Pravi pomoćnu ravan kroz tri tačke. Koristite je za ravan određenu položajima na modelu, npr. s tri ugla.","help.construct.plane.two_edges":"Pravi pomoćnu ravan kroz dvije ravne ivice ili linije koje leže u jednoj ravni. Koristite je za ravan kroz dio, npr. kroz dvije suprotne ivice.","help.construct.point.along_path":"Pravi pomoćnu tačku na nekom položaju duž ivice ili krive. Koristite je kao referencu negdje duž putanje.","help.construct.point.center":"Pravi pomoćnu tačku u centru kružne ivice, kruga ili luka skice, sfere ili torusa. Koristite je kao referencu za rupe, ose i spojeve.","help.construct.point.edge_plane":"Pravi pomoćnu tačku gdje ivica ili linija prolazi kroz ravan ili ravno lice. Koristite je da označite gdje putanja siječe ravan.","help.construct.point.three_planes":"Pravi pomoćnu tačku gdje se sastaju tri ravni ili ravna lica. Koristite je kao referencu ugla, čak i tamo gdje model nema vrh.","help.construct.point.two_edges":"Pravi pomoćnu tačku gdje se dvije ivice ili linije sastaju ili su najbliže. Koristite je kao referencu u virtualnom uglu.","help.construct.point.vertex":"Pravi pomoćnu tačku na vrhu ili tački skice. Koristite je kao referencu koja ostaje kada se skica ili tijelo oko nje sakrije.","help.contact.check":"Navodi parove dijelova u skupovima kontakata koji se u trenutnom položaju međusobno presijecaju. Koristite ga da pronađete sudare prije nego što pokrenete spojeve ili studiju kretanja.","help.contact.create":"Grupiše dva ili više dijelova u skup kontakata čija se tijela sprečavaju da prolaze jedno kroz drugo dok se spojevi kreću. Koristite ga za dijelove koji treba da se zaustave kad se dodirnu, npr. poluga uz svoj graničnik.","help.contact.disable_all":"Isključuje kontakt, pa se pokretani spojevi i studije kretanja više ne zaustavljaju tamo gdje se dijelovi dodiruju. Koristite ga da ponovo slobodno pomjerate dijelove ili da veliki sklop ostane brz u radu.","help.contact.edit":"Mijenja skup kontakata: dijelove koje sadrži, njegov naziv ili da li je potisnut; može i izbrisati skup. Koristite ga da podesite koji dijelovi ne smiju prolaziti jedan kroz drugi.","help.contact.enable_all":"Stavlja svaki dio sklopa u jedan skup kontakata, pa nijedna dva dijela ne mogu prolaziti jedan kroz drugi dok se spojevi kreću. Koristite ga za brzu provjeru cijelog mehanizma.","help.contact.enable_sets":"Uključuje kontakt za skupove kontakata koje ste definisali, pa se pokretani spojevi i studije kretanja zaustavljaju tamo gdje bi njihovi dijelovi prošli jedan kroz drugi. Koristite ga da vratite svoje skupove nakon isključivanja kontakta.","help.contact.list":"Navodi skupove kontakata dizajna, dijelove u svakom od njih i da li je kontakt uključen. Koristite ga da provjerite kako je kontakt postavljen prije nego što pokrenete sklop.","help.document.inspect":"Prikazuje pregled dizajna: njegove komponente, tijela, skice, operacije i parametre. Koristite ga da se snađete u dizajnu koji niste sami napravili.","help.document.units":"Mijenja jedinice u kojima dizajn prikazuje dužine, npr. mm ili inče. Geometrija zadržava veličinu; mijenjaju se samo prikaz i brojevi bez jedinice.","help.edit.checkpoint":"Pamti dizajn, aktivnu skicu i historiju poništavanja onakve kakvi su sada. Koristite ga prije nego što isprobate nešto rizično od čega ćete se možda htjeti vratiti.","help.edit.restore_checkpoint":"Vraća se na kontrolnu tačku, uključujući historiju poništavanja. Koristite ga da jednim korakom odbacite sve urađeno od kontrolne tačke.","help.explode.create":"Pravi rastavljeni prikaz koji odguruje dijelove od centra sklopa ili prema pomjeranjima koja zadate. Koristite ga da pokažete kako se sklop sastavlja, za uputstva ili prezentacije.","help.face.delete":"Uklanja izabrana lica i pušta da susjedna lica zatvore otvor, ili ostavlja otvor otvorenim kao površ. Koristite ga da uklonite zaobljenu ivicu, rupu ili ispupčenje koje smeta.","help.file.insert_mesh":"Dodaje 3MF, STL, OBJ, PLY ili glTF datoteku u dizajn kao mrežna tijela u novoj komponenti. Koristite ga da pored svog dizajna kao referencu postavite preuzeti ili skenirani model.","help.file.insert_step":"Dodaje STEP, IGES, FreeCAD ili Rhino datoteku u dizajn kao puna tijela u novoj komponenti; dijelovi sklopa postaju ugniježđene komponente. Koristite ga da uvezete modele od dobavljača ili iz drugih CAD programa.","help.file.save_mesh":"Čuva tijela kao STL, 3MF ili OBJ mrežu, s glatkoćom zakrivljenih lica koju izaberete. Koristite ga da pripremite dijelove za 3D štampu ili za programe koji čitaju mreže.","help.file.send_to_slicer":"Čuva izabrana tijela kao 3MF datoteku i otvara je u slajseru koji izaberete. Koristite ga da od modela do štampe dođete jednim korakom.","help.font_details":"Interfejs koristi ugrađene fontove biblioteke egui (Ubuntu Light i Hack, pod licencama Ubuntu Font Licence i MIT/Bitstream Vera; Noto Emoji i font emoji ikona, pod licencama OFL i MIT). Tekst skice koristi Liberation Sans (SIL OFL 1.1). Neobavezni paket fontova Crafting Apps, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), nije uključen u izdanja SolidCrafta.","help.fonts":"Fontovi","help.frame.member":"Postavlja profil, npr. cijev ili aluminijski ekstruzioni profil, duž linija skice konstrukcije, po jedan konstrukcioni profil na liniju. Koristite ga za izradu okvira, regala i zavarenih konstrukcija.","help.inspect.accessibility":"Boji lica do kojih alat može doći iz jednog smjera i ona do kojih ne može. Koristite ga da provjerite dio za obradu ili izradu u kalupu s te strane.","help.inspect.center_of_mass":"Prikazuje centar mase tijela, svakog posebno i svih zajedno, uz ujednačenu gustoću. Koristite ga da provjerite ravnotežu i na koju stranu će se dio prevrnuti.","help.inspect.colored_components":"Daje svakoj komponenti vlastitu privremenu boju, bez promjene izgleda. Koristite ga da na prvi pogled razlikujete dijelove sklopa.","help.inspect.compare":"Upoređuje dva tijela i pokazuje gdje jedno ima materijala kojeg drugo nema, uz zapreminu i odstupanje. Koristite ga da provjerite izmijenjen ili uvezen dio u odnosu na original.","help.inspect.continuity":"Provjerava koliko glatko se lica sastaju duž svojih ivica: otvorene krajeve, pregibe ili skokove zakrivljenosti, i boji spojeve. Koristite ga da pronađete gdje se površi ne spajaju čisto.","help.inspect.curvature_comb":"Crta češljeve duž kriva, ivica ili lica čiji zupci pokazuju koliko se jako savijaju. Koristite ga da uočite ravna mjesta, pregibe i neujednačenu zakrivljenost.","help.inspect.curvature_map":"Boji lica prema tome koliko su zakrivljena, crveno gdje je poluprečnik mali. Koristite ga da pronađete mjesta oštre zakrivljenosti i procijenite koliko je površ glatka.","help.inspect.draft":"Boji lica prema uglu nagiba u odnosu na smjer vađenja iz kalupa i označava ona s premalim nagibom. Koristite ga da provjerite dio prije brizganja ili livenja.","help.inspect.environment_map":"Prikazuje model sa sjajnom završnom obradom koja reflektuje poput ogledala. Koristite ga da procijenite tok površi prema načinu na koji se refleksije protežu preko njih.","help.inspect.interference":"Pronalazi tijela koja se preklapaju i prikazuje svako preklapanje s njegovom zapreminom. Koristite ga da u sklopu provjerite ima li dijelova koji se sudaraju.","help.inspect.isocurve":"Crta izokrive lica (izoparametarske krive), mrežu na kojoj je površ izgrađena. Koristite ga da vidite kako površ teče i gdje se zgušnjava.","help.inspect.measure":"Mjeri dužine, udaljenosti, uglove, površine i poluprečnike između onoga što izaberete, ili zapreminu i masu tijela. Koristite ga da provjerite veličine i zazore.","help.inspect.minimum_radius":"Pronalazi najmanji poluprečnik zakrivljenosti kriva, ivica ili lica i gdje se nalazi. Koristite ga da provjerite može li alat ili mlaznica pratiti oblik.","help.inspect.section":"Otvara prikaz presjekom duž ravni i šrafira presječena lica, bez promjene modela. Koristite ga da pogledate unutrašnjost dijelova i sklopova.","help.inspect.zebra":"Prikazuje crno-bijele pruge reflektovane na licima modela. Koristite ga da procijenite glatkoću: pruge koje se prekidaju ili lome na ivici pokazuju loš prelaz.","help.joint.as_built":"Spaja dva dijela tamo gdje već jesu, bez pomjeranja ijednog od njih, i određuje kako se još smiju kretati. Koristite ga za dijelove koje ste već postavili u konačni položaj.","help.joint.cam":"Povezuje brijeg koji se okreće s pratiocem, pa pratilac klizi ili se ljulja dok obris brijega prolazi ispod njega. Koristite ga za brijegove, ekscentre i pogone ventila.","help.joint.create":"Spaja dva dijela u ishodištima spoja koja izaberete i pomjera drugi dio na mjesto; vrsta spoja određuje kako se još smiju kretati. Koristite ga da napravite sklop čiji se dijelovi kreću kao pravi mehanizam.","help.joint.drive":"Zadaje ugao ili udaljenost spoja i s njim pomjera dijelove, u okviru njegovih granica; povezani spojevi i zatvorene petlje ga prate. Koristite ga da provjerite kreće li se mehanizam kako je zamišljeno.","help.joint.gear":"Povezuje dva rotaciona spoja prijenosnim omjerom, pa pokretanje jednog okreće drugi. Koristite ga za čeone i prstenaste zupčanike, s omjerom iz podionih poluprečnika ili broja zubaca.","help.joint.limits":"Zadaje koliko daleko se spoj smije okrenuti ili pomjeriti, kao minimum i maksimum, ili uklanja te granice. Koristite ga da šarku, klizač ili polugu zadržite unutar njihovog stvarnog raspona kretanja.","help.joint.motion_link":"Veže dva spoja omjerom i pomakom, pa pokretanje jednog pomjera drugi. Koristite ga za čvrst odnos između spojeva koji Zupčanik, Zupčasta letva i zupčanik ili Vijak ne pokrivaju.","help.joint.origin":"Postavlja imenovano ishodište spoja na dio: u centar lica ili okruglog kraja, sredinu ivice, ugao ili tačku. Koristite ga da pripremite gdje se spojevi vezuju; ishodište izabrano na licu prati ga kada dio promijeni veličinu.","help.joint.rack_pinion":"Povezuje mali zupčanik koji se okreće sa zupčastom letvom koja klizi, pa se letva pomjera za dužinu podione kružnice koju mali zupčanik prevali. Koristite ga za pogone sa zupčastom letvom, upravljanje i linearne stolove.","help.joint.reach":"Pomjera tačku na dijelu prema cilju mijenjajući spojeve u njegovom lancu, u okviru njihovih granica. Koristite ga da namjestite mehanizam prema tome gdje treba biti njegov kraj, npr. vrh robotske ruke.","help.joint.rigid_group":"Zaključava izabrane dijelove zajedno onakve kakvi jesu, pa se kreću kao jedan. Koristite ga za dijelove koji zajedno pripadaju i između kojih nema kretanja.","help.joint.screw":"Povezuje okretanje i klizanje korakom, pa se svakim okretajem napreduje za tu udaljenost. Koristite ga za navojna vretena, vijke i navojne osovine.","help.library.apply":"Primjenjuje materijal ili izgled iz lokalne datoteke biblioteke na tijela, lica ili komponente. Koristite ga da ponovo upotrijebite materijale koje ste sačuvali iz drugog dizajna.","help.library.export":"Čuva materijale i izglede dizajna u datoteku biblioteke. Koristite ga da ih dijelite ili ponovo koristite u drugim dizajnima.","help.library.inspect":"Provjerava datoteku biblioteke i navodi njene materijale i izglede, bez promjene dizajna. Koristite ga da vidite šta biblioteka sadrži prije nego što je primijenite.","help.licences":"Licence","help.material.assign":"Određuje od čega su izabrana tijela napravljena, npr. čelik, aluminij ili ABS. Koristite ga da masa i težina odgovaraju stvarnom dijelu.","help.material.properties.validate":"Provjerava karticu podataka materijala na usklađenost brojeva i vrijednosti koje nedostaju. Koristite ga prije nego što se oslonite na podatke za masu ili krutost.","help.mesh.convert":"Ponovo gradi mrežno tijelo, npr. STL, kao uredivo puno tijelo s ravnim i cilindričnim licima. Koristite ga da izmijenite uvezene mehaničke dijelove kao modelirano tijelo.","help.mit":"MIT licenca","help.motion.study":"Zadaje vrijednosti spojeva u koracima na vremenskoj traci i reprodukuje ih kao animaciju. Koristite ga da posmatrate kako se mehanizam kreće kroz niz pokreta i usput provjerite zazore.","help.motion.trace":"Prati putanju kojom ide tačka na dijelu dok se reprodukuje studija kretanja ili se pokreće spoj i, kada potvrdite, zadržava je kao krivu 3D skice. Koristite ga da vidite dokle mehanizam dosiže ili da nastavite graditi na njegovoj putanji.","help.notice":"NOTICE","help.occurrence.ground":"Učvršćuje dio na mjestu, ili ga ponovo oslobađa, tako da spojevi pomjeraju ostale dijelove oko njega. Koristite ga za okvir ili osnovu na kojoj je izgrađen ostatak sklopa.","help.occurrence.move":"Pomjera dio sklopa samo duž stepeni slobode koje dozvoljavaju njegovi spojevi. Izaberite lice dijela, a zatim prevucite dostupnu strelicu ili luk.","help.parameters.change":"Otvara tabelu imenovanih vrijednosti i izraza koji upravljaju kotama dizajna. Koristite je da promijenite mjeru na jednom mjestu, a sve operacije koje je koriste je slijede.","help.parameters.export":"Čuva parametre dizajna kao CSV ili JSON. Koristite ga da ih uredite u proračunskoj tabeli ili prenesete u drugi dizajn.","help.parameters.graph":"Prikazuje koji parametri i operacije koriste koje druge, te sve petlje ili greške među njima. Koristite ga da vidite šta sve zahvata promjena nekog parametra.","help.parameters.import":"Učitava parametre iz CSV ili JSON u dizajn, sve ili nijedan. Koristite ga da unesete vrijednosti iz proračunske tabele ili drugog dizajna.","help.parameters.move":"Pomjera korisnički parametar ispred ili iza drugog na popisu. Koristite ga da povezane parametre držite zajedno.","help.parts.fastener":"Dodaje standardni vijak, zavrtanj, maticu, podlošku, zatik ili ležaj u izabranoj veličini. Postavljen na rupu, naliježe u rupu pomoću spoja, pa spojne elemente ne morate sami modelirati.","help.parts.insert":"Umeće standardni dio u porodici, veličini i dužini koje izaberete. Postavljen na rub ili zid rupe, naliježe na rupu krutim spojem.","help.parts.library":"Otvara standardne dijelove: vijke, zavrtnjeve, matice, podloške, bezglave vijke, cilindrične zatike i ležajeve u standardnim veličinama. Koristite ga da dodate standardni dio umjesto da ga sami modelirate.","help.parts.resize":"Mijenja veličinu ili dužinu umetnutog standardnog dijela i ponovo ga gradi; njegovi spojevi ga drže na mjestu. Koristite ga kada se vijak pokaže predugim ili rupa traži drugu veličinu.","help.plastic.assign_rule":"Dodjeljuje pravilo za plastiku tijelima, pa njihove plastične operacije preuzimaju njegov nagib i zazor kao podrazumijevane vrijednosti. Koristite ga da jednom podesite brizgani dio za sve njegove operacije.","help.plastic.boss":"Dodaje ispust za vijak na licu: stub s neobaveznom rupom, nagibom, zaobljenjem u korijenu i potpornim rebrima. Koristite ga za tačke za vijke u brizganim ili štampanim kućištima.","help.plastic.lip":"Dodaje usnu ili odgovarajući utor duž ruba izdubljenog tijela. Koristite ga da se dvije polovine kućišta međusobno pozicioniraju i čvrsto zatvore.","help.plastic.manage_rules":"Pravi i uređuje pravila za plastiku: materijal, debljinu zida, poluprečnike, zazor i nagib. Koristite ih da operacije brizganog dijela ostanu usklađene.","help.plastic.rest":"Dodaje oslonac na licu: okruglu ili pravougaonu podlogu, punu ili šuplju, s nagibom. Koristite ga kao potporu ili odstojnik u brizganom kućištu.","help.plastic.snap_fit":"Dodaje kuku škljocajućeg spoja na licu, s njenom dužinom, debljinom i zapinjačem. Koristite ga da dijelove spojite zaklapanjem bez vijaka.","help.pointcloud.insert":"Umetnite PLY, XYZ ili PTS skeniranje kao oblak tačaka uz model. Koristite ga kao referencu pri izradi modela iz izmjerenih podataka.","help.sheet.convert":"Pretvara ploču ili izdubljeno tijelo ujednačene debljine u tijelo od lima, sa savijanjima na ivicama koje izaberete. Koristite ga da postojeći dio učinite razvijivim.","help.sheet.export_bend_table":"Čuva tabelu savijanja tijela od lima kao CSV ili JSON: uglove, poluprečnike i položaje savijanja u razvijenom obliku. Koristite ga za presu za savijanje ili radionicu.","help.sheet.export_dxf":"Čuva razvijeni oblik kao DXF, s obrisima, linijama savijanja i neobaveznim napomenama o savijanju. Koristite ga za rezanje laserom, plazmom ili vodenim mlazom.","help.sheet.flange":"Dodaje prirubnicu: osnovnu ploču iz skice, zid duž otvorene konture skice ili savijeni zid na ivicama lima. Koristite je za izgradnju dijelova od lima.","help.sheet.flat_pattern":"Pravi razvijeni oblik tijela od lima, s njegovom veličinom, izrezima i linijama savijanja. Koristite ga da provjerite pripremak prije rezanja.","help.sheet.fold":"Savija lim duž linije skice za zadati ugao i poluprečnik. Koristite ga da presavijete ravan lim nakon što u njemu izrežete operacije.","help.sheet.hem":"Presavija ivicu lima natrag preko sebe. Koristite ga za sigurne, krute ivice bez oštrih srha.","help.sheet.manage_rules":"Pravi i uređuje pravila za lim: debljinu, poluprečnik savijanja, K-faktor, rasterećenja i razmake. Koristite ih da se uskladite s materijalom i alatima svoje radionice.","help.sheet.path_flange":"Dodaje lanac prirubnica duž ivice lima, prateći otvoreni lanac linija skice. Koristite ga za profile poput U ili Z oblika u jednom koraku.","help.sheet.perforate":"Dodaje polje rupa preko cijelog ravnog lima, u izmaknutom ili kvadratnom rasporedu. Koristite ga za otvore za ventilaciju, rešetke i lakše ploče.","help.sheet.refold":"Ponovo presavija razvijeno tijelo od lima. Koristite ga nakon dodavanja operacija na ravan lim.","help.sheet.unfold":"Razvija sva savijanja tijela od lima. Koristite ga da dodate rupe ili rezove koji moraju prelaziti preko savijanja, a zatim ga ponovo presavijte.","help.sketch.arc.center_point":"Crta kružni luk oko tačke centra, od početne do završne tačke. Koristite ga kada je centar luka poznat, npr. poluprečnik oko rupe ili osovine.","help.sketch.arc.tangent":"Crta luk koji počinje na kraju linije ili luka i nastavlja se tangentno na njega. Koristite ga da lanac nastavite glatkim prelazom umjesto ugla.","help.sketch.arc.three_point":"Crta luk od početne do završne tačke kroz treću tačku. Koristite ga kada luk mora proći kroz zadate tačke, a ne oko poznatog centra.","help.sketch.arc3d":"Crta tačan kružni luk u prostoru kroz tri tačke, uz uključenu 3D skicu. Koristite ga za zavoje putanja i vodilica koji izlaze iz ravni skice.","help.sketch.auto_constrain":"Dodaje ograničenja koja skica već gotovo ima, npr. horizontalno, paralelno ili podudarno, a zatim je kotira dok ne bude potpuno definisana. Koristite ga da grubo nacrtanu skicu zaključate u jednom koraku.","help.sketch.auto_constrain_from_datum":"Radi kao Automatska ograničenja, ali položaje mjeri od referentne tačke koju izaberete umjesto od ishodišta. Koristite ga kada je dio raspoređen od jedne referentne tačke, npr. ugla ili rupe.","help.sketch.blend_curve":"Spaja krajeve dviju kriva glatkim splajnom koji je tangentan na obje, ili i kontinuiran po zakrivljenosti ako tako izaberete. Koristite ga da premostite razmak između kriva bez pregiba.","help.sketch.break":"Dijeli krivu na dijelove tamo gdje je presijecaju druge krive, ili na tačkama koje postavite na nju. Koristite ga kada dio krive treba vlastito ograničenje ili ga treba zasebno izbrisati.","help.sketch.cancel":"Napušta skicu i odbacuje sve što je promijenjeno otkako je napravljena ili otvorena za uređivanje. Pomoću Poništi možete vratiti promjene.","help.sketch.centerline":"Prebacuje linije između običnih linija i središnjih linija, osa koje profili izostavljaju. Središnju liniju koristite kao osu za rotaciju, preslikavanje ili ograničenje simetrije.","help.sketch.chamfer.distance_angle":"Skošava ugao između dvije linije, zadat udaljenošću duž prve linije i uglom. Koristite ga kada crtež daje skošenje kao dužinu i ugao, npr. 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Skošava ugao između dvije linije za istu udaljenost unazad duž obje. Koristite ga za uobičajeno skošenje od 45° na obrisu.","help.sketch.chamfer.two_distance":"Skošava ugao između dvije linije, zadat posebnom udaljenošću duž svake linije. Koristite ga za skošenja koja nisu 45°, zadana kao dvije dužine.","help.sketch.circle.center":"Crta krug iz njegovog centra i prečnika. Koristite ga za rupe, ispuste i druge okrugle oblike čiji je centar poznat.","help.sketch.circle.three_point":"Crta krug kroz tri tačke. Koristite ga kada krug mora proći kroz zadate tačke, npr. postojeće geometrije.","help.sketch.circle.three_tangent":"Crta krug koji dodiruje tri elementa: linije, krugove ili lukove. Koristite ga da krug uklopite u prostor između triju kriva, npr. upisani krug trougla.","help.sketch.circle.two_point":"Crta krug iz dva kraja njegovog prečnika. Koristite ga kada su poznate tačke na rubu kruga, a ne njegov centar.","help.sketch.circle.two_tangent":"Crta krug zadate veličine koji dodiruje dva elementa: linije, krugove ili lukove. Koristite ga za zaobljenje stalnog poluprečnika između dvije krive.","help.sketch.conic":"Crta konusnu krivu između dvije krajnje tačke, oblikovanu tjemenom tačkom i vrijednošću rho. Koristite je za glatke prelaze čiju punoću želite podesiti, od ravnog do gotovo oštrog ugla.","help.sketch.constrainer":"Primjenjuje ograničenje koje jedna ili dvije izabrane krive već gotovo imaju, npr. horizontalno, paralelno, tangentno ili jednako. Koristite ga da uredite ručno nacrtanu skicu, jedan odnos po jedan.","help.sketch.constraint.coincident":"Čini da tačka leži na drugoj tački, krivoj ili osi skice. Koristite ga da zatvorite otvore u profilu ili da tačku postavite na liniju.","help.sketch.constraint.collinear":"Čini da dvije linije leže na jednoj pravoj. Koristite ga da poravnate prekinute ivice, npr. obje strane zareza.","help.sketch.constraint.concentric":"Daje dva kruga ili luka isti centar. Koristite ga za prstenove, cilindrična upuštenja i osovine s ramenima.","help.sketch.constraint.curvature":"Čini da dvije krive koje se sastaju u krajnjoj tački nastave istom zakrivljenošću (G2). Koristite ga tamo gdje tangentni spoj nije dovoljno gladak, npr. na vidljivim površima.","help.sketch.constraint.equal":"Izjednačava dužine linija, ili poluprečnike krugova i lukova. Koristite ga da jedna kota upravlja s više istovjetnih oblika.","help.sketch.constraint.fix":"Fiksira tačke ili krive tamo gdje jesu, ili ih ponovo oslobađa. Koristite ga za geometriju koja se ne smije pomjerati kada povlačite ili rješavate skicu.","help.sketch.constraint.horizontal_vertical":"Čini liniju, ili liniju između dvije tačke, horizontalnom ili vertikalnom, zavisno od toga što je bliže. Koristite ga da obris poravnate s osama skice.","help.sketch.constraint.midpoint":"Postavlja tačku na sredinu linije, ili spaja središnje tačke dviju linija. Koristite ga da geometriju centrirate na ivici.","help.sketch.constraint.parallel":"Čini dvije linije paralelnima. Koristite ga za stranice koje moraju ostati paralelne kada se promijene druge kote.","help.sketch.constraint.perpendicular":"Čini da se dvije linije sastaju pod pravim uglom. Koristite ga za prave uglove između linija koje nisu na osama skice.","help.sketch.constraint.polygon":"Čini zatvoreni lanac linija pravilnim poligonom: jednake stranice, a svaki ugao na jednom krugu. Koristite ga da ručno nacrtan poligon učinite pravilnim i takvim ga zadržite.","help.sketch.constraint.symmetry":"Čini da dvije tačke ili krive budu međusobno preslikane preko linije ili oko tačke. Koristite ga da profil ostane simetričan kada promijenite jednu stranu.","help.sketch.constraint.tangent":"Čini da se dvije krive dodiruju tangentno, npr. linija i luk. Koristite ga za glatke spojeve bez pregiba.","help.sketch.construction":"Prebacuje krive između obične geometrije i pomoćne geometrije, koju profili izostavljaju. Pomoćne krive koristite kao pomagala za raspored, reference i kote.","help.sketch.construction_line":"Napravite beskonačnu pomoćnu pravu kroz dvije tačke. Koristite je da rasporedite skicu bez razdvajanja profila.","help.sketch.construction_line.angle":"Napravite beskonačnu pomoćnu pravu pod uglom od ose X skice. Izaberite tačku i upišite ugao ili izaberite smjer.","help.sketch.construction_line.bisector":"Izaberite dvije prave linije skice koje se sijeku, pa jednu od dvije simetrale ugla. Rezultat prati izvorne linije.","help.sketch.construction_line.horizontal":"Napravite beskonačnu horizontalnu pomoćnu pravu kroz tačku. Njeno ograničenje horizontalnosti ostaje na snazi pri kasnijim izmjenama.","help.sketch.construction_line.parallel":"Izaberite pravu liniju skice, pa postavite paralelnu beskonačnu pomoćnu pravu. Desnim klikom izaberite drugu referencu.","help.sketch.construction_line.perpendicular":"Izaberite pravu liniju skice, pa postavite okomitu beskonačnu pomoćnu pravu. Desnim klikom izaberite drugu referencu.","help.sketch.construction_line.tangent_at":"Napravite tangentu u tački na krugu ili kružnom luku, ili u krajnjoj tački otvorenog splajna ili konike. Izaberite krivu, pa tačku dodira.","help.sketch.construction_line.tangent_external":"Izaberite krug ili kružni luk, pa vanjsku tačku i rješenje tangente. Pregledi prikazuju samo dodirne tačke na nacrtanom luku.","help.sketch.construction_line.tangent_two":"Izaberite dva kruga ili kružna luka, pa u pregledu izaberite zajedničku tangentu. Dodirne tačke moraju ležati na nacrtanim krivama.","help.sketch.construction_line.vertical":"Napravite beskonačnu vertikalnu pomoćnu pravu kroz tačku. Njeno ograničenje vertikalnosti ostaje na snazi pri kasnijim izmjenama.","help.sketch.copy":"Kopira izabrane krive i tačke skice, zajedno s ograničenjima i kotama među njima. Zalijepite ih u ovu skicu ili u drugu.","help.sketch.create":"Počinje novu 2D skicu na ravni ili na ravnom licu modela. Svako ekstrudiranje, rotiranje i povlačenje počinje skicom.","help.sketch.cut":"Kopira izabranu geometriju skice i briše je iz skice, u jednom koraku poništavanja. Zalijepite je drugdje u ovoj skici ili u drugoj.","help.sketch.dimension":"Dodaje pogonsku kotu: dužinu, udaljenost, ugao, poluprečnik ili prečnik, zavisno od onoga što izaberete. Upišite vrijednost ili naziv parametra, a skica ih prati.","help.sketch.edit":"Otvara postojeću skicu za uređivanje. Operacije izgrađene na njoj se ažuriraju kada završite skicu.","help.sketch.ellipse":"Crta elipsu iz njenog centra, kraja velike ose i tačke na maloj strani. Koristite je za ovalne otvore, brijegove i druge izdužene okrugle oblike.","help.sketch.equation_curve":"Crta krivu iz formula: x(t) i y(t) ili y = f(x), u zadanom rasponu. Formule mogu koristiti parametre i kriva ih prati: koristite je za sinusoidu, spiralu ili evolventu zupca zupčanika.","help.sketch.extend":"Produžava liniju ili luk do najbliže krive na putu, ili izdužuje dvije krive dok se ne sastanu. Koristite ga da zatvorite otvore u profilu nakon odsijecanja ili uređivanja.","help.sketch.fillet":"Zaobljuje ugao gdje se dvije linije ili lukovi sastaju lukom zadatog poluprečnika. Više uglova zaobljenih zajedno dijeli jedan poluprečnik.","help.sketch.finish":"Napušta skicu i vraća se na model. Njeni zatvoreni profili tada su spremni za Ekstrudiraj, Rotiraj i druge operacije.","help.sketch.finish_auto_constrain":"Pokreće Automatska ograničenja na skici, a zatim je završava. Koristite ga da skicu ostavite potpuno definisanu u jednom koraku.","help.sketch.fit_curves_to_section":"Siječe mrežno ili puno tijelo ravni skice i uklapa linije i lukove u presjek. Koristite ga da skenirani ili uvezeni dio ponovo izgradite kao uredivu skicu.","help.sketch.include_3d":"Unosi ivice modela, vrhove i krive drugih skica u ovu skicu kao povezane reference, spljoštavajući one izvan njene ravni na nju. Koristite ga da gradite na geometriji koja ne leži u ravni skice.","help.sketch.infinite":"Prebacuje linije između običnih linija i beskonačnih pomoćnih pravih koje se protežu preko cijelog prikaza. Koristite ih kao reference za raspored koje nikada ne završe prekratko.","help.sketch.insert_dxf":"Učitava krive DXF crteža u skicu, skalirane, zakrenute i postavljene gdje zadate. Koristite ga da gradite na 2D crtežu iz drugog programa, npr. na obrisu za rezanje laserom.","help.sketch.insert_svg":"Učitava putanje SVG crteža u skicu, skalirane, zakrenute i postavljene gdje zadate. Koristite ga da logotip ili vektorski obris pretvorite u krive koje možete ekstrudirati.","help.sketch.inspect":"Otvara izvještaj o otvorenoj skici: koliko je stepeni slobode preostalo i je li potpuno ograničena. Koristite ga da saznate šta se još pomjera prije nego što završite skicu.","help.sketch.intersect":"Dodaje krive ili tačke gdje tijela, lica, ivice ili druge skice sijeku ravan skice. Ostaju povezane i prate model kada se promijeni.","help.sketch.intersection_curve":"Pravi 3D krive tamo gdje se dva tijela ili lica sastaju, povezane s njima. Koristite ih kao putanje ili vodilice koje prate model.","help.sketch.isoparametric_curve":"Pravi 3D krivu u smjeru U ili V lica kroz tačku koju izaberete, povezanu s licem. Koristite je kao putanju ili liniju razdvajanja koja prati površ.","help.sketch.line":"Crta povezane linije tačku po tačku, kao otvoreni lanac ili zatvoren obris. To je osnovni alat za većinu profila.","help.sketch.line.midpoint":"Crta liniju od njene središnje tačke do jednog kraja, a drugi kraj se preslikava. Koristite je za linije centrirane na tački, npr. simetričnu ivicu.","help.sketch.line3d":"Crta povezane prave linije između tačaka u prostoru, uz uključenu 3D skicu. Koristite ga za putanje i okvire koji izlaze iz ravni skice.","help.sketch.mirror":"Preslikava krive i tačke skice preko linije ili ose i dodaje ograničenja simetrije. Koristite ga da nacrtate pola simetričnog profila i dovršite ga.","help.sketch.move":"Pomjera ili rotira krive i tačke skice, ili njihovu kopiju. Koristite ga da promijenite položaj geometrije uz zadržavanje njenog oblika i ograničenja.","help.sketch.offset":"Pravi kopiju lanca kriva na zadatoj udaljenosti, s jedne strane ili s obje. Koristite ga za zidove, obrise i zazore; udaljenost ostaje kota koju možete uređivati.","help.sketch.paste":"Lijepi geometriju skice koju ste kopirali ili izrezali u aktivnu skicu. Postavite je na tačku ili je pomjerite za odmak.","help.sketch.pattern.circular":"Kopira geometriju skice oko tačke centra, preko punog kruga ili zadatog ugla. Koristite ga za kružne rasporede vijaka, paoke i zupce.","help.sketch.pattern.rectangular":"Kopira geometriju skice u redovima i kolonama na zadatim razmacima. Koristite ga za mreže rupa, žlijebova ili otvora za ventilaciju.","help.sketch.point":"Postavlja tačku skice. Koristite je kao referencu za kote, ograničenja, centre rupa ili kasnije operacije.","help.sketch.point3d":"Postavlja tačku u prostoru, uz uključenu 3D skicu. Koristite je kao referencu za 3D krive i putanje.","help.sketch.polygon.circumscribed":"Crta pravilan poligon oko kruga, zadat od centra do sredine stranice. Koristite ga kada je poznata širina ključa, npr. za šestougaonu maticu.","help.sketch.polygon.edge":"Crta pravilan poligon iz dva kraja jedne stranice. Koristite ga kada su poznate dužina i položaj stranice.","help.sketch.polygon.inscribed":"Crta pravilan poligon unutar kruga, zadat od centra do ugla. Koristite ga kada je poznata mjera preko uglova.","help.sketch.project":"Unosi ivice modela, lica, vrhove i krive drugih skica u ovu skicu, projektovane na njenu ravan. Ostaju povezani i prate model kada se promijeni.","help.sketch.project_to_surface":"Projektuje krive drugih skica duž normale ove skice na lice, kao povezane 3D krive. Koristite ga da logotip, liniju razdvajanja ili putanju postavite na zakrivljenu površ.","help.sketch.rectangle.center":"Crta pravougaonik iz njegovog centra i jednog ugla. Koristite ga za obrise centrirane na tački, npr. na ishodištu.","help.sketch.rectangle.rounded":"Crta pravougaonik sa sva četiri ugla zaobljena istim poluprečnikom. Koristite ga za ploče, poklopce i otvore sa zaobljenim uglovima.","help.sketch.rectangle.three_point":"Crta pravougaonik iz jedne ivice i tačke na suprotnoj strani. Koristite ga za pravougaonike pod uglom u odnosu na ose skice.","help.sketch.rectangle.two_point":"Crta pravougaonik iz dva suprotna ugla. Koristite ga za obrise ploča, blokova i džepova.","help.sketch.scale":"Skalira krive i tačke skice faktorom oko bazne tačke. Koristite ga da promijenite veličinu dijela skice bez ponovnog crtanja.","help.sketch.slot.arc_center":"Crta lučni žlijeb zadate širine duž luka određenog centrom, početkom i krajem. Koristite ga za žlijebove za podešavanje oko osovine.","help.sketch.slot.arc_three_point":"Crta lučni žlijeb zadate širine duž luka kroz tri tačke. Koristite ga kada putanja žlijeba mora proći kroz zadate tačke.","help.sketch.slot.center_point":"Crta ravni žlijeb zadate širine od njegovog centra do centra jednog krajnjeg luka. Koristite ga za žlijebove centrirane na tački.","help.sketch.slot.center_to_center":"Crta ravni žlijeb zadate širine između centara njegova dva krajnja luka. Koristite ga za žlijebove kotirane od centra do centra, npr. žlijebove za podešavanje vijaka.","help.sketch.slot.overall":"Crta ravni žlijeb zadate širine od jednog vanjskog kraja do drugog. Koristite ga kada je bitna ukupna dužina žlijeba.","help.sketch.spline.control_point":"Crta kubni splajn oblikovan kontrolnim tačkama kroz koje ne prolazi. Koristite ga za glatke, tečne krive koje oblikujete pomjeranjem tačaka.","help.sketch.spline.control_point_5":"Crta splajn petog stepena oblikovan kontrolnim tačkama. Koristite ga tamo gdje se krive moraju spajati glađom zakrivljenošću, npr. na vidljivim dizajnerskim površima.","help.sketch.spline.fit_point":"Crta glatki splajn koji prolazi kroz svaku tačku koju postavite, otvoren ili zatvoren. Koristite ga da oblik provučete kroz poznate tačke.","help.sketch.spline3d":"Crta glatku krivu u prostoru kroz tačke, uz uključenu 3D skicu. Koristite ga za putanje povlačenja i vođenje kablova koji izlaze iz ravni skice.","help.sketch.spun_profile":"Pravi u ravni skice obris koji tijelo opisuje kada se okreće oko ose. Koristite ga da dobijete siluetu tokarenog dijela za rotiranje ili crtež.","help.sketch.text":"Upisuje tekst u skicu izabranim fontom, visinom i uglom; njegove riječi mogu pratiti parametre. Ekstrudirajte ga ili ga napravite reljefom za etikete i natpise.","help.sketch.transform":"Skalira, okreće i pomjera geometriju skice oko tačke centra u jednom koraku. Koristite ga da istovremeno promijenite položaj i veličinu izbora.","help.sketch.trim":"Uklanja dio krive između najbližih presjeka oko mjesta na koje kliknete. Koristite ga da preklapajuće linije očistite u zatvoren profil.","help.solid.align":"Pomjera izabrana tijela tako da se tačka, lice ili ravan na njima poklopi s tačkom, licem ili ravni negdje drugdje. Koristite ga da postavite dio uz drugi bez mjerenja odmaka.","help.solid.boundary_fill":"Pravi puna tijela od područja zatvorenih preklapajućim alatnim tijelima, popunjavajući samo područja koja izaberete. Koristite ga da oblik izgradite iz prostora koji nekoliko tijela zajedno ograničava.","help.solid.bounding_solid":"Pravi kutiju koja obuhvata izabrana tijela, s neobaveznom marginom. Koristite ga da vidite ukupnu veličinu dijela ili kao pripremak iz kojeg se dio obrađuje.","help.solid.box":"Pravi kutiju iz dužine, širine i visine, iz tačke ugla ili centriranu na tački. Koristite je za brz blok, privremeni oblik ili tijelo u koje se urezuju operacije.","help.solid.chamfer":"Odsijeca izabrane ivice ravnim skošenjem zadate udaljenosti. Koristite ga da ublažite oštre ivice ili olakšate uvođenje zatika ili vijka.","help.solid.coil":"Pravi zavojno tijelo, npr. oprugu, iz prečnika, broja zavoja, visine ili koraka i okruglog ili kvadratnog presjeka. Koristite je za opruge, zavojnice i zavojne grebene.","help.solid.combine":"Spaja tijela, oduzima ih od ciljnog tijela ili zadržava samo zajedničku zapreminu, a može zadržati i alatna tijela. Koristite ga da spojite dijelove, da jednim oblikom odsiječete drugi ili da pronađete gdje se dva tijela preklapaju.","help.solid.cone":"Pravi konus iz kruga osnove i visine, ili zarubljeni konus kada i vrh ima poluprečnik. Koristite ga za suženja, lijevke, konusna upuštenja i šiljke.","help.solid.cylinder":"Pravi cilindar iz poluprečnika ili prečnika i visine, postavljen na tačku duž ose. Koristite ga za osovine, zatike, ispuste i okrugle pripremke.","help.solid.draft":"Naginje izabrana lica za ugao koji zadate, mjereno od neutralne ravni. Koristite ga na livenim ili brizganim dijelovima kako bi izašli iz kalupa.","help.solid.emboss":"Izdiže profile skice, npr. tekst ili logotip, iz lica, ili ih udubljuje u njega. Koristite ga za natpise, etikete i oznake na ravnim ili okruglim licima.","help.solid.extrude":"Izvlači profil skice u 3D duž zadate udaljenosti, dodajući ili uklanjajući materijal. Koristite ga da ravni obris pretvorite u blok, ispust ili džep.","help.solid.fillet":"Zaobljuje izabrane ivice glatkim kružnim prelazom zadatog poluprečnika. Koristite ga da omekšate oštre ivice radi čvrstoće, udobnosti ili izgleda.","help.solid.hole":"Buši okruglu rupu zadatog prečnika na izabranoj tački lica. Koristite je za prolaze vijaka, zatike i druge jednostavne okrugle otvore.","help.solid.loft":"Pravi glatko tijelo između dva ili više profila skice ili od profila do tačke. Koristite ga za prelaze, lijevke, ručke i svaki oblik čiji se presjek mijenja duž dužine.","help.solid.mirror":"Pravi preslikanu kopiju izabranih tijela ili operacija preko ravni i može je spojiti s originalom. Koristite ga za simetrične dijelove, tako da modelirate jednu polovinu i dobijete obje.","help.solid.move":"Pomjera ili rotira izabrana tijela, ili njihovu kopiju, za udaljenost i ugao koje zadate. Koristite ga da premjestite tijelo ili napravite drugo na drugom mjestu.","help.solid.offset_face":"Gura izabrana lica unutra ili van za udaljenost koju zadate, a okolna lica ih prate. Koristite ga da podebljate zid, produbite džep ili povisite ispupčenje bez uređivanja skice.","help.solid.pattern.circular":"Ponavlja izabrane objekte oko ose, za zadati broj i ukupni ugao. Koristite ga za krugove vijaka, žbice, rebra hladnjaka i zupce.","help.solid.pattern.path":"Kopira operacije ili tijela duž putanje skice, prema broju i razmaku. Koristite ga za rupe duž zakrivljene ivice ili dijelove duž vodilice.","help.solid.pattern.rectangular":"Ponavlja izabrane objekte u jednom ili dva smjera sa zadatim brojem i razmakom. Koristite ga za redove i mreže rupa, rebara, zatika ili nožica.","help.solid.pipe":"Pravi okruglu cijev duž putanje od kriva skice, punu ili šuplju sa zadatom debljinom zida. Koristite je za cijevi, žice, kablove i šine.","help.solid.press_pull":"Dodaje ili uklanja materijal dok povlačite lice, ili zaobljava ivice dok ih povlačite. Koristite ga za brze izmjene direktno na modelu.","help.solid.remove":"Uklanja izabrana tijela iz dizajna od ove tačke vremenske trake nadalje; raniji koraci ih zadržavaju. Koristite ga da odbacite pomoćno tijelo, npr. alat za rezanje koji vam više ne treba.","help.solid.replace_face":"Premješta izabrana ravna lica na ravan ili na paralelno lice, a tijelo raste ili se smanjuje da ga dosegne. Koristite ga da poravnate lice s drugim dijelom ili pomoćnom ravni.","help.solid.revolve":"Okreće profil skice oko ose i pravi okruglo tijelo. Koristite ga za vratila, dugmad, posude i svaki dio koji je okrugao oko središnje linije.","help.solid.rib":"Dodaje tanak zid duž otvorene krive skice, popunjen do sljedećih lica tijela. Koristite ga da ojačate zidove i uglove, npr. u brizganim ili štampanim dijelovima.","help.solid.scale":"Povećava ili smanjuje izabrana tijela za faktor, jednako u svim smjerovima ili posebno po osi. Koristite ga da promijenite veličinu uvezenog oblika ili uračunate skupljanje.","help.solid.shell":"Izdubljuje tijelo i ostavlja zidove zadate debljine, a može otvoriti lica koja izaberete. Koristite ga za kutije, poklopce i druge tankozidne dijelove.","help.solid.sphere":"Pravi sferu iz poluprečnika ili prečnika oko tačke centra. Koristite je za kugle, ručke i zaobljene krajeve.","help.solid.split_body":"Reže tijelo na zasebna tijela ravni, licem drugog tijela ili linijom skice. Koristite ga za dijelove koji se zasebno štampaju, obrađuju ili boje.","help.solid.split_face":"Dijeli izabrana lica po ravni, licu drugog tijela ili krivama skice, bez rezanja tijela. Koristite ga da dijelu lica date vlastiti nagib, boju ili odmak.","help.solid.sweep":"Povlači profil skice duž putanje i pravi tijelo. Koristite ga za cijevi, šine, ručke i svaki dio konstantnog presjeka koji prati krivu.","help.solid.thread":"Dodaje ISO metrički navoj na cilindrično lice, kao kozmetički navoj ili urezan u tijelo. Koristite ga za vijke, navojne rupe i štampane dijelove s navojem.","help.solid.torus":"Pravi prsten iz velikog poluprečnika oko njegove ose i malog poluprečnika za okrugli presjek. Koristite ga za O-prstenove, ručke i okrugle perle.","help.solid.web":"Dodaje tanak zid duž svake otvorene krive skice, svaki popunjen do sljedećih lica tijela. Koristite ga za mrežu potpornih zidova unutar kućišta i posuda.","help.surface.blend":"Pravi površ koja premošćuje ivice dvaju tijela, tangentnu ili kontinuiranu po zakrivljenosti s oba. Koristite je da dvije površi glatko spojite preko razmaka.","help.surface.boundary":"Pravi površ koja ispunjava petlju od dvije do četiri krive skice, ili mrežu kriva. Koristite je za slobodne panele određene svojim ivicama.","help.surface.extend":"Produžava površ preko njenih ivica, za neku udaljenost ili do ravni ili lica. Koristite ga da se površi preklope prije nego što ih odsiječete ili sašijete.","help.surface.extrude":"Izvlači krive ili profile skice na zadatu udaljenost u površ, samo zidove, bez poklopaca. Koristite ga za tanke zidove i za alate za rezanje ili razdvajanje.","help.surface.fair":"Izglađuje unutrašnjost slobodnih lica dok njihove ivice ostaju na mjestu. Koristite ga da izravnate izbočine i valovite refleksije u površi.","help.surface.loft":"Pravi površ koja redom prolazi kroz dva ili više presjeka, bez poklopaca. Koristite je za ljuske i prelaze između različitih oblika.","help.surface.match":"Ponovo gradi ivicu površi tako da se sastaje s ivicom drugog tijela, uz podudarnu tangentu ili zakrivljenost. Koristite ga da glatko zatvorite šav između dvije površi.","help.surface.offset":"Pravi kopiju lica na udaljenosti duž njihovih normala, kao novo tijelo površi. Koristite ga za omotače, zazore ili drugu stranu zida.","help.surface.patch":"Ispunjava područje skice ili zatvorenu petlju ivica licem, ravnim ili glatko zakrivljenim. Koristite ga da zatvorite rupe u tijelu površi.","help.surface.reverse_normal":"Okreće lica tijela površi, pa njihova vanjska strana gleda na drugu stranu. Koristite ga prije podebljanja ili šivenja kada lica gledaju prema unutra.","help.surface.revolve":"Okreće krive ili profile skice oko ose u površ, bez poklopaca. Koristite ga za okrugle ljuske poput abažura, zdjela i mlaznica.","help.surface.ruled":"Pravi traku pravih linija iz lanca ivica, duž normale lica, tangente ili pod uglom. Koristite ga za zidove s nagibom, odvodne površi i površi razdvajanja.","help.surface.stitch":"Šije tijela površi zajedno duž njihovih zajedničkih ivica, u puno tijelo kada se zatvore. Koristite ga da skup površi pretvorite u jedno tijelo.","help.surface.sweep":"Pomjera krive ili profile skice duž putanje u površ, bez poklopaca. Koristite ga za žljebove, lajsne i druge tanke oblike koji prate putanju.","help.surface.thicken":"Daje tijelu površi debljinu i pretvara ga u puno tijelo. Koristite ga da od površi napravite dijelove pogodne za štampu ili obradu.","help.surface.trim":"Siječe površ ravni, drugom površi ili krivama skice i zadržava stranu koju izaberete. Koristite ga da površi oblikujete prije šivenja.","help.surface.unstitch":"Razdvaja lica tijela u zasebna tijela površi; puno tijelo se raspada na površi. Koristite ga da preradite pojedinačna lica tijela.","help.surface.untrim":"Uklanja rupe iz lica, ili vraća njegovu vanjsku granicu na prirodne granice površi. Koristite ga da nakon odsijecanja vratite cijelu površ.","help.third_party":"Licence trećih strana","help.timeline.compute_all":"Ponovo gradi svaku operaciju na vremenskoj traci od početka. Koristite ga da osvježite model i vidite koje operacije ne uspijevaju.","help.timeline.delete":"Briše izabrane operacije s vremenske trake; brisanje skice briše i operacije napravljene iz nje. Koristite ga da uklonite korak koji više ne želite.","help.timeline.dependents":"Navodi operacije koje bi bile izbrisane zajedno s nekom operacijom i one koje bi bez nje otkazale. Koristite ga prije brisanja ili mijenjanja operacije.","help.timeline.play":"Reprodukuje preostale operacije jednu po jednu, s pauzom od pola sekunde nakon svake ponovne izgradnje. Pokrenite ovu komandu ponovo ili pritisnite Escape da zaustavite; Idi na kraj skače odmah.","help.view.apply":"Okreće prikaz u standardni smjer, npr. sprijeda, odozgo ili izometrijski, ili u sačuvani imenovani prikaz. Koristite ga da model posmatrate iz utvrđenog ugla.","help.view.delete":"Briše sačuvani imenovani prikaz. Model se ne mijenja.","help.view.fit":"Zumira i pomjera prikaz tako da cijeli model, ili izbor, ispuni prikaz. Koristite ga kada model nestane iz vidokruga.","help.view.grid":"Prikazuje ili sakriva mrežu u prozoru prikaza. Koristite je kao vodič za veličinu i orijentaciju tokom modeliranja.","help.view.ground_shadow":"Prikazuje ili sakriva sjenu modela na podlozi. Koristite je da lakše procijenite visinu i položaj.","help.view.home":"Vraća prikaz na početni smjer i uklapa model. Koristite ga da se brzo vratite na poznat prikaz.","help.view.list":"Navodi imenovane prikaze sačuvane u dizajnu. Koristite ga da pronađete prikaz koji ste ranije sačuvali.","help.view.navigate":"Okreće, pomjera ili zumira prikaz u koracima, npr. četvrtinu okreta ulijevo. Koristite ga da kameru pomjerate precizno umjesto povlačenjem.","help.view.navigation_bar":"Prikazuje ili sakriva navigacijsku traku na dnu prozora prikaza. Sakrijte je za više prostora, prikažite je da alatima prikaza pristupate mišem.","help.view.rename":"Daje sačuvanom imenovanom prikazu novi naziv. Sam prikaz ostaje isti.","help.view.save":"Čuva trenutni položaj kamere kao imenovani prikaz u dizajnu. Koristite ga da se kasnije vratite na isti ugao, npr. za snimke ekrana.","help.view.spin":"Neprekidno orbitira prikaz oko modela do sljedećeg klika ili tipke. Koristite ga da model predstavite sa svih strana.","help.view.tool":"Zaključava alat kamere, orbitiranje, pomjeranje ili zumiranje, tako da povlačenje lijevim dugmetom miša pomjera prikaz dok ga ne isključite. Koristite ga na touchpadu ili bez srednjeg dugmeta miša.","help.view.visual_style":"Mijenja način crtanja modela: osjenčeno sa ili bez ivica, žičani model ili sa skrivenim ivicama. Koristite žičani model da vidite unutra, a osjenčeno za čist izgled.","history.sketch_under_constrained":"Nedovoljno ograničeno (stepeni slobode: {count})","history.sketch_under_constrained_one":"Nedovoljno ograničeno ({count} stepen slobode)","hole_presets.confirm_delete":"Potvrdi brisanje","hole_presets.delete":"Izbriši","hole_presets.delete_prompt":"Izbrisati ovu ličnu postavku? Postojeće rupe ostaju nepromijenjene.","hole_presets.full":"Lična biblioteka već sadrži 64 postavke.","hole_presets.invalid_name":"Unesite kratak naziv bez prijeloma reda ili kontrolnih znakova.","hole_presets.invalid_parameters":"Dopunite parametre rupe važećim izrazima razumne dužine.","hole_presets.missing":"Izabrana postavka više nije dostupna.","hole_presets.name":"Naziv postavke","hole_presets.name_exists":"Postavka s ovim nazivom već postoji. Koristite drugi naziv.","hole_presets.name_hint":"Jedinstven naziv","hole_presets.overwrite":"Sačuvaj promjene u izabranoj postavci","hole_presets.preset":"Postavka","hole_presets.recall":"Učitaj","hole_presets.rename":"Preimenuj","hole_presets.save":"Sačuvaj novu","hole_presets.scope":"Sačuvano u vašem profilu za sve projekte.","hole_presets.select":"Izaberite postavku","hole_presets.title":"Lične postavke","hole_presets.unsupported_options":"Ova postavka koristi opcije navoja koje ova verzija ne može učitati.","hole_presets.unsupported_overwrite":"Ova postavka sadrži opcije koje se ne mogu sigurno prepisati.","home.back":"Nazad na {name}","home.crashes":"Izvještaji o rušenju","home.design_workspace":"Dizajn","home.documentation":"Dokumentacija","home.export":"Izvoz","home.export_hint":"Izaberite format za trenutni dizajn.","home.export_json_hint":"Dizajn koji se može uređivati i historija komandi","home.export_mesh_hint":"Mreža za štampu ili dijeljenje","home.export_step_hint":"Precizna geometrija tijela","home.import":"Uvezi…","home.import_hint":"STEP, IGES ili mreža u novi dizajn","home.in_this_browser":"u ovom web pregledniku","home.missing":"nedostaje","home.month_01":"Jan","home.month_02":"Feb","home.month_03":"Mar","home.month_04":"Apr","home.month_05":"Maj","home.month_06":"Jun","home.month_07":"Jul","home.month_08":"Aug","home.month_09":"Sep","home.month_10":"Okt","home.month_11":"Nov","home.month_12":"Dec","home.new_inches":"Novi dizajn, inči","home.new_inches_hint":"Inči · otvara se u Dizajnu","home.new_mm":"Novi dizajn","home.new_mm_hint":"Milimetri · otvara se u Dizajnu","home.open":"Otvori…","home.open_hint":"Dizajn .solidcraft ({shortcut})","home.open_now":"Otvori sada","home.opened_days_ago":"prije {count} dana","home.opened_hours_ago":"prije {count} h","home.opened_just_now":"Upravo sada","home.opened_minutes_ago":"prije {count} min","home.opening":"otvaranje…","home.properties":"Svojstva dizajna","home.recent":"Nedavno","home.recent_empty":"Dizajni koje otvorite ili sačuvate pojavljuju se ovdje.","home.recovery_count":"Dizajni koji se mogu oporaviti: {count}","home.recovery_empty":"Nema dizajna koji se mogu oporaviti.","home.recovery_hint":"SolidCraft se zatvorio prije nego što su ovi dizajni sačuvani.","home.report_issue":"Prijavi problem","home.samples":"Primjeri","home.settings":"Postavke","home.short_date":"{day}. {month}","home.shortcuts":"Prečice na tastaturi","home.start_hint":"Napravite dizajn, otvorite nedavnu datoteku ili istražite primjer.","home.whats_new":"Šta je novo","home.yesterday":"Jučer","install.button_tip":"Instalirajte SolidCraft kao aplikaciju: otvara se u vlastitom prozoru i radi bez interneta","install.dock_1":"Izaberite File › Add to Dock.","install.dock_2":"Kliknite Add.","install.dock_after":"SolidCraft se zatim otvara u vlastitom prozoru iz Docka i radi bez interneta.","install.done":"Gotovo","install.home_screen_1":"Dodirnite Share (u meniju … ako nije na traci s alatima).","install.home_screen_2":"Izaberite Add to Home Screen.","install.home_screen_3":"Dodirnite Add.","install.home_screen_after":"SolidCraft se zatim otvara preko svoje ikone na početnom ekranu, bez Safarijevih traka s alatima, i radi bez interneta.","install.menu":"Instaliraj aplikaciju…","install.steps_intro":"Safari instalira web aplikacije iz svojih menija:","install.title":"Instaliraj SolidCraft","issue.body_label":"Tekst izvještaja","issue.note_changed_while_waiting":"Postavke ili model su se promijenili dok se čekao pregled. Ponovo napravite snimak ekrana da biste ažurirali tehničke detalje za trenutni prikaz.","issue.note_details_kept":"Snimak ekrana je napravljen lokalno. Vaši izmijenjeni tehnički detalji su zadržani: provjerite da li i dalje odgovaraju trenutnom prikazu.","issue.note_details_updated":"Tehnički detalji su ažurirani prema trenutnom prikazu. Snimak ekrana je napravljen lokalno. Pregledajte ga prije nego što ga priložite na GitHubu.","issue.note_image_copied":"Zalijepite sliku u GitHub nacrt ili sačuvajte PNG ako kopiranje slike nije dostupno.","issue.note_opened":"Pregledajte GitHub nacrt i priložite snimak ekrana. Dugme Submit new issue na GitHubu ga objavljuje.","issue.note_opened_copied":"Izvještaj je kopiran. Zalijepite ga u GitHub nacrt, priložite snimak ekrana, a zatim kliknite Submit new issue na GitHubu.","issue.note_removed":"Snimak ekrana je uklonjen iz ovog nacrta.","issue.note_report_copied":"Izvještaj je kopiran. Po potrebi ga zalijepite u GitHub nacrt.","issue.note_save_failed":"Snimak ekrana nije moguće sačuvati: {error}","issue.note_saved":"Snimak ekrana je sačuvan. Priložite PNG u GitHub nacrt.","issue.save_screenshot":"Sačuvaj snimak ekrana…","joint.from_bodies_hint":"Svako izabrano tijelo premješta se u svoju novu komponentu i ostaje gdje jeste.","joint.one_body":"Oba izbora su na {body}. Izaberite drugi na drugom dijelu.","joint.one_component":"Ovi dijelovi su tijela jedne komponente: {bodies}. Spoj pomjera jednu komponentu u odnosu na drugu, pa svaki dio treba svoju komponentu.","joint.rigid_group_one_component":"Sva tijela ({count}) su u jednoj komponenti (ili u samom dizajnu): prvo koristite {command}.","joint.rigid_group_select_components":"Izaberite dvije ili više komponenti.","joint_move.blocked_hint":"Provjerite vrstu spoja (npr. Kruti), učvršćenje, granice spoja i vrijednosti koje pokreću parametri.","joint_move.blocked_title":"Ovaj dio se ne može pomjeriti","joint_move.coarse":"Korak rotacije blizu ose (°)","joint_move.distance":"Udaljenost od početka","joint_move.done":"Gotovo","joint_move.fine":"Korak rotacije dalje od ose (°)","joint_move.fixed":"Ovaj dio nema pomičnu osu spoja.","joint_move.help":"Pomjeri — prevucite strelicu ili prsten. Esc otkazuje trenutno povlačenje.","joint_move.legacy_hint":"Isključite da biste koristili prethodni panel Pomjeri.","joint_move.precision":"Povucite izvan isprekidane vodilje za finu rotaciju.","joint_move.rotation":"Rotacija od početka","joint_move.select":"Izaberite lice ili jedan dio sklopa, a zatim izaberite Pomjeri.","joint_move.settings":"Pomjeranje u sklopu","joint_move.step":"Korak","joint_move.use_handles":"Koristi ručice kretanja spojeva za Pomjeri u sklopu","keymap.command_id":"ID komande","keymap.empty":"Nema odgovarajućih komandi","keymap.use_anyway":"Ipak koristi {key} ovdje","label.move_to_left_side":"Premjesti na lijevu stranu","label.move_to_right_side":"Premjesti na desnu stranu","manage.appearance_hint":"Izaberite izgled za izbor ili prevucite uzorak na tijelo ili lice.","manage.assign_hint":"Izaberite tijela i njihovo pravilo za plastiku.","manage.config_hint":"Uredite redove, kolone i pravila konfiguracije, a zatim aktivirajte ili pregledajte red.","manage.empty":"Nema odgovarajućih redova.","manage.material_hint":"Izaberite tijela i njihov fizički materijal.","manage.parameters_hint":"Uredite izraze i jedinice. Promjene se primjenjuju pritiskom na Enter ili napuštanjem polja.","manage.rules_hint":"Izaberite pravilo za uređivanje ili napravite novo. Potvrdite da sačuvate pravilo.","material.editor.add_property":"Dodaj svojstvo","material.editor.add_source":"Dodaj izvor","material.editor.assigned_density":"Dodijeljena gustina","material.editor.axes":"Ose materijala","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Kopija od {name}","material.editor.density_range":"Dodijeljena gustina mora biti iznad 0 i najviše 1000 g/cm³.","material.editor.designation":"Oznaka","material.editor.duplicate":"Dupliciraj","material.editor.engineering_card":"Kartica inženjerskih svojstava","material.editor.family":"Porodica materijala","material.editor.glass":"Staklo","material.editor.illustrative":"Ilustrativno","material.editor.invalid_property":"Nepodržana vrsta svojstva.","material.editor.isotropic":"Izotropno","material.editor.measurement":"Mjerenje","material.editor.metal":"Metal","material.editor.moisture":"Vlažnost, na suhu masu","material.editor.name_required":"Unesite naziv od 1 do 128 znakova.","material.editor.no_draft":"Nijedan nacrt materijala nije otvoren.","material.editor.number_required":"Unesite konačnu brojčanu vrijednost.","material.editor.orthotropic":"Ortotropno","material.editor.other":"Ostalo","material.editor.polymer":"Polimer","material.editor.preserved_appearance":"Sačuvani izgled","material.editor.public_reference":"Javna referenca","material.editor.reference":"Referenca","material.editor.save_or_discard":"Sačuvajte ili odbacite nacrt materijala prije dodjele materijala.","material.editor.saved":"Materijal je sačuvan. Dodjele tijelima ostaju nepromijenjene.","material.editor.scope":"Sačuvaj sprema ovaj materijal bez dodjele tijelima. Prazna svojstva i uslovi ostaju nepoznati. Gustina s kartice ne mijenja dodijeljenu gustinu ni masu.","material.editor.source_id":"ID izvora","material.editor.source_kind":"Vrsta izvora","material.editor.source_title":"Naslov izvora","material.editor.sources":"Izvori","material.editor.stale":"Ovaj materijal se promijenio dok je nacrt bio otvoren. Odbacite ga i ponovo otvorite prije čuvanja.","material.editor.state":"Stanje materijala","material.editor.strain_rate":"Brzina deformacije","material.editor.symmetry":"Elastična simetrija","material.editor.temperature":"Temperatura","material.editor.unknown_card":"Inženjerska svojstva su nepoznata. Čuvanje može zadržati samo dodijeljenu gustinu i postojeći izgled.","material.editor.user_supplied":"Dao korisnik","material.editor.wood":"Drvo","material.selection.choose":"Izaberite materijal","material.selection.mixed":"Različiti materijali","measure.at":"Na","measure.item":"Stavka {number}","measure.quick_copied":"Mjerenje kopirano","measure.quick_copy":"Kliknite da kopirate mjerenje","measure.quick_edges":"Ivice: {count}","measure.quick_faces":"Lica: {count}","messages.ago_h":"prije {n} h","messages.ago_min":"prije {n} min","messages.ago_s":"prije {n} s","messages.chip_hint":"Kliknite za sve poruke ove sesije","messages.clear":"Očisti","messages.copy_all":"Kopiraj sve","messages.menu":"Poruke…","messages.none":"Još nema poruka.","messages.title":"Poruke","motion.checked_to":"Provjereno samo do koraka {step}: provjeri je ponestalo radnog budžeta","motion.collision":"{a} · {b}: koraci {steps}","motion.delete_key":"Izbriši ključnu vrijednost","motion.duration_hint":"sekunde (prazno: po koraku)","motion.key_here":"Ključna vrijednost ovdje","motion.key_here_hint":"Dodaj ključnu vrijednost u ovom koraku s trenutnom vrijednošću spoja","motion.no_collisions":"Nema sudara tokom studije","motion.plot_quantity":"Broj","motion.step_back":"Korak nazad","motion.step_forward":"Korak naprijed","motion.to_end":"Na kraj","motion.to_start":"Na početak","motion.track_name":"Staza {number}","nav.alias.help":"Shift+Alt+povlačenje lijevim dugmetom orbitira, Shift+Alt+srednjim pomjera, Shift+Alt+desnim zumira; povlačenje srednjim dugmetom također pomjera, a desnim orbitira","nav.blender.help":"Povlačenje srednjim dugmetom orbitira, Shift+srednje pomjera, Ctrl+srednje zumira; povlačenje desnim dugmetom ne dira kameru","nav.free_orbit.help":"Miš i 3D miš rotiraju kroz oba pola i čuvaju nagib. Privlačenje osa tipkom Shift je isključeno.","nav.free_orbit.label":"Slobodno orbitiranje","nav.free_orbit.snap_help":"Miš i 3D miš rotiraju kroz oba pola i čuvaju nagib. Držite Shift tokom povlačenja za orbitiranje da privučete smjer pogleda i nagib.","nav.free_orbit_upright.help":"Povlačenje mišem lijevo-desno okreće model oko vertikalne ose svijeta; povlačenje gore-dolje ga naginje preko vrha bez ograničenja.","nav.free_orbit_upright.label":"Okreći oko vertikalne ose","nav.fusion.help":"Povlačenje srednjim dugmetom pomjera, Shift+srednje orbitira, povlačenje desnim orbitira","nav.hfss.help":"Alt+lijevo povlačenje pomjera prikaz, Shift+Alt+lijevo zumira, Ctrl+lijevo povlačenje na praznom prostoru orbitira","nav.inventor.help":"Povlačenje srednjim dugmetom pomjera, Shift+srednje orbitira, Ctrl+srednje zumira, povlačenje desnim orbitira","nav.maya.help":"Alt+lijevo povlačenje orbitira, Alt+srednje pomjera, Alt+desno zumira; srednje povlačenje također pomjera","nav.openscad.help":"Povlačenje lijevim dugmetom po praznom prostoru orbitira, Shift+povlačenje lijevim bira okvirom, povlačenje geometrije skice je uređuje; povlačenje desnim ili srednjim dugmetom pomjera, Shift+desno ili Shift+srednje zumira","nav.perspective.sketch":"Uređivanje skice koristi ortografski prikaz. Završite skicu da prebacite na perspektivu.","nav.right_drag_orbits.help":"Isključeno: povlačenje desnim 