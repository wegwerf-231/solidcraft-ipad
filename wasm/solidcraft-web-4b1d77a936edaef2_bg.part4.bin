precision mediump float;
// A triangle that fills the whole screen
const vec2[3] TRIANGLE_POS = vec2[](
  vec2( 0.0, -3.0),
  vec2(-3.0,  1.0),
  vec2( 3.0,  1.0)
);
const vec2[3] TRIANGLE_UV = vec2[](
  vec2( 0.5,  1.),
  vec2( -1.0,  -1.0),
  vec2( 2.0,  -1.0)
);
out vec2 uv;
void main() {
  uv = TRIANGLE_UV[gl_VertexID];
  gl_Position = vec4(TRIANGLE_POS[gl_VertexID], 0.0, 1.0);
}#version 300 es
precision mediump float;
in vec2 uv;
uniform sampler2D present_texture;
out vec4 frag;
vec4 linear_to_srgb(vec4 linear) {
    vec3 color_linear = linear.rgb;
    vec3 selector = ceil(color_linear - 0.0031308); // 0 if under value, 1 if over
    vec3 under = 12.92 * color_linear;
    vec3 over = 1.055 * pow(color_linear, vec3(0.41666)) - 0.055;
    vec3 result = mix(under, over, selector);
    return vec4(result, linear.a);
}
void main() {
  frag = linear_to_srgb(texture(present_texture, uv));
}�,␀␀␀␀␀␀␀␀�,␀␀Could not create shader␀�␀a␀␀␀H␀␀@␀␀␀�␀a␀␀␀D␀␀>␀␀␀Could not create shader program␀�␀a␀␀␀B␀␀6␀␀␀need to configure surface before presenting␀␀␀antialias␀␀␀�,␀␀␀␀␀␀␀␀I␀␀Cannot create context options␀␀␀�␀a␀␀␀i␀␀␀␀␀␀webgl2canvas.getContext() returned null; webgl2 not available or canvas already in use␀␀�,␀␀␀␀␀␀␀␀�,␀␀canvas context is not a WebGl2RenderingContext␀␀�␀a␀␀␀Z␀␀␀␀␀␀internal error: entered unreachable code@�␀b␀␀␀�␀␀␀␀␀not implemented␀@�␀b␀␀␀�␀␀␀H␀␀␀Cannot get document␀�␀a␀␀␀�␀␀␀␀␀␀Canvas is not found␀�␀a␀␀␀�␀␀␀␀␀␀�,␀␀␀␀␀␀␀␀�,␀␀Failed to downcast to canvas type␀␀␀�␀a␀␀␀�␀␀␀␀␀␀Cannot query for canvas␀�␀a␀␀␀�␀␀␀␀␀␀UiKitAppKitOrbitalOhosNdkXlibXcbWaylandDrmGbmWin32WinRtWebWebCanvasWebOffscreenCanvasAndroidNdkHaiku␀␀␀␀␀␀␀␀␀␀�,␀␀Elementobj␀␀�␀a␀␀␀�␀␀%␀␀␀�␀a␀␀␀�␀␀*␀␀␀␀␀␀␀␀␀␀␀␀␀�,␀␀AndroidNdkWindowHandlea_native_window␀␀␀␀␀␀␀␀␀␀␀␀␀�,␀␀Objectgenerics␀␀␀␀␀
