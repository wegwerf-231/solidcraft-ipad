evolve","cmd.surface_ruled":"Ruled Surface","cmd.surface_stitch":"Stitch","cmd.surface_sweep":"Surface Sweep","cmd.surface_thicken":"Thicken","cmd.surface_unstitch":"Unstitch","cmd.surface_untrim":"Untrim","cmd.timeline_add":"Add Recorded Feature","cmd.timeline_compute_all":"Compute All","cmd.timeline_copy":"Copy Features","cmd.timeline_dependents":"Feature Dependents","cmd.timeline_export_script":"Export Command Script","cmd.timeline_inspect":"Inspect Feature","cmd.timeline_paste":"Paste Features","cmd.timeline_play":"Play History","cmd.timeline_redefine":"Edit Feature","cmd.timeline_rename":"Rename","cmd.timeline_reorder":"Reorder Feature","cmd.timeline_roll_to":"Roll History Marker","cmd.timeline_rollback":"Move Timeline Marker","cmd.timeline_stop":"Stop History","cmd.timeline_suppress":"Suppress Feature","cmd.view.render_browser":"Render Browser","cmd.view.render_dock":"Move Render Dock","cmd.view.render_focus":"Render Focus View","cmd.view.status_details":"Viewport Status Details","cmd.view.status_items":"Viewport Status Items","cmd.view_ambient_occlusion":"Ambient Occlusion","cmd.view_angle_readout":"View Angles","cmd.view_apply":"Restore Named View","cmd.view_back":"Back View","cmd.view_bottom":"Bottom View","cmd.view_delete":"Delete Named View","cmd.view_fit":"Fit","cmd.view_front":"Front View","cmd.view_graphics_preset":"Graphics Preset","cmd.view_grid":"Grid","cmd.view_ground_shadow":"Ground shadow","cmd.view_home":"Home view","cmd.view_isometric":"Isometric View","cmd.view_left":"Left View","cmd.view_list":"List Named Views","cmd.view_navigate":"Navigate View","cmd.view_navigation_bar":"Navigation bar","cmd.view_next_tab":"Next Tab","cmd.view_normal_to":"Normal to Selection","cmd.view_previous_tab":"Previous Tab","cmd.view_rename":"Rename Named View","cmd.view_render_frame":"Render Frame Guides","cmd.view_right":"Right View","cmd.view_save":"New Named View","cmd.view_shots_strip":"Shots Strip","cmd.view_spin":"Continuous orbit","cmd.view_tool":"Navigation tool","cmd.view_top":"Top View","cmd.view_visual_style":"Visual style","color.copy":"Click to copy color values","color.edit":"Click to edit color","color.gamma":"Showing color values in 0-255 gamma space","color.hex":"Hex","color.hex_help":"Enter #rrggbb or #rrggbbaa; six digits preserve opacity","color.hex_hint":"#rrggbb","color.hue":"Hue","color.linear":"Showing color values in 0-1 linear space","color.recent":"Recent colors","color.recent_help":"Colors you pick in any color field appear here","color.saturation":"Saturation (percent)","color.saturation_value":"Saturation and value","color.selected":"Selected color","color.step_down":"Step down","color.step_up":"Step up","color.value":"Value, the brightness (percent)","config.column_filter_empty":"No matching columns","contact.components_count":"{count} components","contact.enabled_label":"enabled","coupling.gear_1":"Gear 1","coupling.gear_1_pick":"Gear 1 (optional)","coupling.gear_2":"Gear 2","coupling.gear_2_pick":"Gear 2 (optional)","coupling.internal":"Internal gear","coupling.needs_turn_and_slide":"needs a joint that turns and one that slides","coupling.needs_turns":"needs two joints that turn","coupling.not_round":"not a round face","coupling.nut":"Nut","coupling.picked":"picked","coupling.pinion":"Pinion","coupling.pinion_pick":"Pinion (optional)","coupling.pitch":"Pitch","coupling.rack":"Rack","coupling.radius_1":"Radius 1","coupling.radius_2":"Radius 2","crash.announce":"SolidCraft closed unexpectedly or hit an internal error last time. A crash report was saved (Help > Crash Reports…).","crash.copy_folder":"Copy folder path","crash.copy_path":"Copy path","crash.deleted":"Deleted {count} report(s).","crash.detected_time":"Detected {time} UTC","crash.intro":"Crash reports stay on this computer and are never sent anywhere. Report… opens a draft you review before anything is shared.","crash.kind_command":"Internal error in a command","crash.kind_internal":"Internal error","crash.kind_kernel":"Kernel error (recovered)","crash.kind_unclean":"Closed unexpectedly","crash.previous_session":"An earlier SolidCraft session ended unexpectedly or hit an internal error. Reports from unclean exits are detected at startup. See Help > Crash Reports… for details.","crash.replayable":"replayable","crash.report":"Report…","crash.unclean_explanation":"Detected on a later launch; the exact exit time was not recorded. A system shutdown or forced stop can also cause an unclean exit.","delete.and_more":"… and {count} more","diagnostic.empty_boolean_component":"there is no body to cut or intersect in component '{component}'; the tool may overlap '{body}' in component '{other}' — activate that component or pick the body as a target","dialog.bodies_count":"{count} bodies","dialog.clearance_invalid":"the clearance must be a length of 0 or more","dialog.compute":"Compute","dialog.compute_again":"Compute again","dialog.computing":"Computing… {seconds} s","dialog.could_not_be_checked":"could not be checked","dialog.custom_axis":"↖ Custom Axis","dialog.dimension_insert_hint":"Click another driving dimension to insert its name","dialog.dimension_name":"Dimension: {name}","dialog.edit_title":"EDIT {title}","dialog.no_shown_body":"No shown body to change: show one, or choose New Body","dialog.pattern_sketch_not_object":"Pick bodies or features: a sketch is neither. Repeat its curves with the sketch's own Pattern or Mirror, or extrude it first.","dialog.select":"↖ Select","dialog.selected_count":"↖ {count} selected","dialog.selection_guidance":"Select an input to change it. Click selected objects to remove them; Ctrl/Cmd-click also toggles them. Review the preview, then press OK.","dialog.selection_step":"{step} of {total}: Select {input}","dialog.step":"Step","document.changed_on_disk":"{name} changed on disk","document.changed_on_disk_detail":"{name} was changed by another program or computer since you opened or last saved it. Overwrite replaces those changes with yours; Save a Copy keeps both.","document.copy_name":"{name} copy","document.open_anyway":"Open Anyway","document.open_elsewhere":"{name} is already open","document.open_elsewhere_detail":"{name} is open in SolidCraft {app} on {who}, opened {when}. If you both save, one of you loses work. Open it read-only to look at it without saving over it.","document.open_read_only":"Open Read-Only","document.opened_read_only":"Opened read-only: Save asks for a new file","document.overwrite":"Overwrite","document.read_only_save":"This design was opened read-only: save it as a new file","document.save_changes":"Save changes to {name}?","document.save_copy":"Save a Copy…","document.unsaved_changes":"{name} has unsaved changes. If you don't save, they are lost.","drive.rigid":"{joint} is a rigid joint: it holds its parts still, so it has nothing to drive. To let them move, change its type in Edit Joint: Revolute to rotate, Slider to slide, Cylindrical for both.","drive.stopped_by_contact":"Stopped at {value}: {a} would pass through {b}","drive.stopped_by_loop":"Stopped at {value}: the loop through {joint} can't close any further","drive.unconnected":"Moves nothing: {part} is not connected to anything grounded","dxf.cancel_wait":"Waiting for the export to stop…","dxf.cancelled":"DXF export canceled","dxf.cancelling":"Canceling DXF export","dxf.exporting":"Exporting DXF","dxf.invalid_tolerance":"Curve tolerance must be between 0.0001 and 1 mm.","dxf.progress.index":"Preparing surfaces (2/5)","dxf.progress.meshes":"Preparing meshes (1/5)","dxf.progress.occlusion":"Resolving hidden lines (4/5)","dxf.progress.projection":"Projecting geometry (3/5)","dxf.progress.write":"Writing DXF (5/5)","dxf.tolerance":"Curve tolerance","dxf.tolerance_help":"Visible bodies and shown sketches only. Curves use straight segments. Smaller tolerance gives finer curves and uses more time and memory.","each rail's curves must be in one sketch":"each rail's curves must be in one sketch","feature computation ended without a result":"feature computation ended without a result","file.open.drawing_filter":"Designs, CAD files, meshes and drawings","file_load.built":"Built so far: {built} of {total} features.","file_load.converting":"Converting solid {done} of {total}","file_load.inserting":"Inserting geometry","file_load.link_item":"{name} ({done} of {total})","file_load.opening":"Opening design","file_load.preparing_thumbnail":"Preparing the thumbnail...","file_load.preparing_view":"Preparing the view...","file_load.preview_note":"Saved preview. Geometry is being checked before editing.","file_load.reading":"Reading the file...","file_load.reading_percent":"Reading the file... {percent}%","file_load.rebuilding":"Rebuilding feature {done} of {total}","file_load.recovering":"Recovering design","file_load.stopping":"Waiting for the previous operation to stop...","file_load.updating_links":"Updating links","file_load.waiting":"Waiting for file operation","fits the face, e.g. M8":"fits the face, e.g. M8","from the profile":"from the profile","from the rule":"from the rule","help.apache":"Apache license 2.0","help.appearance.assign":"Gives the selected bodies, faces or components a color or a material look, without changing their weight. Use it to tell parts apart or to preview a finish.","help.assembly.bom":"Lists the parts of the design or a component with their counts, by part number, and can save the list as CSV or JSON. Use it as the parts list for ordering and assembly.","help.attributions":"Attributions (ATTRIBUTION.md)","help.build":"Version {version} · commit {commit} · built {date}","help.canvas.decal":"Places an image on a planar face of the model, like a sticker. Use it to show a label, logo or printed pattern on a part.","help.canvas.edit":"Changes a canvas: its position, size, angle, opacity, mirroring, visibility or name. Use it to line up a reference image with the sketch you trace over it.","help.canvas.insert":"Places a PNG or JPEG image on a plane or face as a see-through reference. Use it to trace a photo or drawing in a sketch, with the image scaled to a known size.","help.component.break_link":"Cuts a linked component loose from its design file, keeping its bodies as they are. Use it when the part should no longer follow changes to the original file.","help.component.capture_position":"Keeps the positions of parts you moved by hand, so they become where those parts are. Use it after dragging parts into place that no joint holds.","help.component.create":"Adds a new, empty component to the design, inside the active component unless you choose another parent. Use it to give a new part of an assembly its own place for bodies and sketches.","help.component.finish_edit":"Saves the part you are editing in place, returns to its assembly and updates the assembly from it. Use it when your changes to the linked part are done.","help.component.from_bodies":"Turns each selected body into a component of its own, named after the body. Use it when a design built as loose bodies should become an assembly whose parts can be joined and moved.","help.component.insert_design":"Inserts another saved design as a component linked to its file, with its solid bodies placed as they are there. Use it to reuse a part in an assembly and pick up later changes with Update Links.","help.component.properties":"Shows the volume, mass, centre of mass and moments of inertia of a component, using its bodies' materials. Use it to check weight and balance of an assembly.","help.component.revert_position":"Puts parts you moved by hand back where they were, dropping moves that were not captured. Use it to undo trial moves in an assembly.","help.component.update_links":"Reads the linked design files again and replaces bodies where they changed. Use it after editing a part that this assembly uses.","help.config.configure":"Adds parameters, features, materials or appearances as columns of the configuration table. Use it to build variants of one design, such as sizes of a part.","help.config.preview":"Checks that a row of the configuration table rebuilds, without changing the design or its history. Use it before switching to a variant you are not sure of.","help.config.rules":"Shows the rules of the configuration table, its rows and which row is active. Use it to see how the variants of a design are set up.","help.config.table":"Shows the configuration table: one row per variant, one column per parameter or feature, and whether the design still matches the active row. Use it to review the variants of a design.","help.connect_note":"Restart each assistant to load the SolidCraft server. Each file was backed up as .bak before it changed.","help.connect_title":"Connect AI assistants","help.construct.axis.edge":"Creates a construction axis along a straight edge or sketch line. Use it as the axis for a revolve, a circular pattern or a joint.","help.construct.axis.normal_to_face":"Creates a construction axis through a point, square to a face. Use it as an axis that stands straight out of a surface.","help.construct.axis.through_cylinder":"Creates a construction axis through the centre of a cylinder, cone or torus face, or a circular edge. Use it to turn or pattern features around a round part.","help.construct.axis.two_planes":"Creates a construction axis where two planes or flat faces meet. Use it when the axis you need is the line between two faces.","help.construct.axis.two_points":"Creates a construction axis through two points, vertices or sketch points. Use it for an axis that runs between two known positions.","help.construct.plane.along_path":"Creates a construction plane square to an edge or curve, at a position along it. Use it to sketch a profile for a sweep or a section of a path.","help.construct.plane.at_angle":"Creates a construction plane turned by an angle from a plane or face, about an axis or edge. Use it for sloped sketches, such as an angled bracket.","help.construct.plane.midplane":"Creates a construction plane halfway between two planes or flat faces, or bisecting them where they meet at an angle. Use it as a symmetry plane for mirroring.","help.construct.plane.offset":"Creates a construction plane parallel to a plane or flat face, at a distance or through a point. Use it to sketch at a set height above a face.","help.construct.plane.perpendicular":"Creates a construction plane that holds a line or edge and stands square to a plane or face. Use it to sketch upright on a model along an edge.","help.construct.plane.tangent":"Creates a construction plane that touches a cylinder, cone, sphere or torus at a point. Use it to sketch on the side of a round part.","help.construct.plane.three_points":"Creates a construction plane through three points. Use it for a plane set by positions on the model, such as three corners.","help.construct.plane.two_edges":"Creates a construction plane through two straight edges or lines that lie in one plane. Use it for a plane across a part, such as through two opposite edges.","help.construct.point.along_path":"Creates a construction point at a position along an edge or curve. Use it as a reference partway along a path.","help.construct.point.center":"Creates a construction point at the centre of a circular edge, sketch circle or arc, sphere or torus. Use it as a reference for holes, axes and joints.","help.construct.point.edge_plane":"Creates a construction point where an edge or line passes through a plane or flat face. Use it to mark where a path crosses a plane.","help.construct.point.three_planes":"Creates a construction point where three planes or flat faces meet. Use it as a corner reference, even where the model has no vertex.","help.construct.point.two_edges":"Creates a construction point where two edges or lines meet, or come closest. Use it as a reference at a virtual corner.","help.construct.point.vertex":"Creates a construction point on a vertex or sketch point. Use it as a reference that stays when the sketch or body around it is hidden.","help.contact.check":"Lists the pairs of parts in contact sets that pass through each other in their current position. Use it to find collisions before you drive joints or run a motion study.","help.contact.create":"Groups two or more parts into a contact set, whose bodies are kept from passing through each other while joints move. Use it for parts that should stop when they touch, such as a lever against its stop.","help.contact.disable_all":"Turns contact off, so driven joints and motion studies no longer stop where parts touch. Use it to move parts freely again, or to keep a large assembly responsive.","help.contact.edit":"Changes a contact set: the parts it holds, its name, or whether it is suppressed; it can also delete the set. Use it to adjust which parts are kept from passing through each other.","help.contact.enable_all":"Puts every part of the assembly into one contact set, so no two parts can pass through each other while joints move. Use it for a quick check of a whole mechanism.","help.contact.enable_sets":"Turns contact on for the contact sets you defined, so driven joints and motion studies stop where their parts would pass through each other. Use it to bring your sets back after turning contact off.","help.contact.list":"Lists the contact sets of the design, the parts in each one and whether contact is on. Use it to check how contact is set up before you drive the assembly.","help.document.inspect":"Shows an overview of the design: its components, bodies, sketches, features and parameters. Use it to get your bearings in a design you did not build yourself.","help.document.units":"Changes the units the design shows lengths in, such as mm or inches. The geometry keeps its size; only the display and plain numbers follow.","help.edit.checkpoint":"Remembers the design, the active sketch and the undo history as they are now. Use it before trying something risky that you may want to go back from.","help.edit.restore_checkpoint":"Goes back to a checkpoint, undo history included. Use it to drop everything done since the checkpoint in one step.","help.explode.create":"Creates an exploded view that pushes the parts away from the assembly's centre, or by the moves you set. Use it to show how an assembly goes together, for instructions or presentations.","help.face.delete":"Removes the selected faces and lets the neighboring faces close the gap, or leaves the gap open as a surface. Use it to take off a rounded edge, a hole or a boss that is in the way.","help.file.insert_mesh":"Adds a 3MF, STL, OBJ, PLY or glTF file to the design as mesh bodies in a new component. Use it to place a downloaded or scanned model beside your design as a reference.","help.file.insert_step":"Adds a STEP, IGES, FreeCAD or Rhino file to the design as solid bodies in a new component; an assembly's parts become nested components. Use it to bring in models from suppliers or other CAD programs.","help.file.save_mesh":"Saves bodies as an STL, 3MF or OBJ mesh, with the smoothness of curved faces you choose. Use it to prepare parts for 3D printing or for programs that read meshes.","help.file.send_to_slicer":"Saves the selected bodies as a 3MF file and opens it in the slicer you choose. Use it to go from the model to printing in one step.","help.font_details":"The interface uses egui's built-in fonts (Ubuntu Light and Hack, under the Ubuntu Font Licence and the MIT/Bitstream Vera license; Noto Emoji and the emoji icon font, under the OFL and MIT). Sketch text uses Liberation Sans (SIL OFL 1.1). The Crafting Apps' optional font pack, craft-fonts (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1), is not bundled in SolidCraft builds.","help.fonts":"Fonts","help.frame.member":"Places a profile, such as a tube or an aluminium extrusion, along the lines of a frame sketch, one member per line. Use it to build frames, racks and welded structures.","help.inspect.accessibility":"Colours the faces a tool can reach from one direction, and those it cannot. Use it to check a part for machining or moulding from that side.","help.inspect.center_of_mass":"Shows the centre of mass of bodies, each on its own and all together, at uniform density. Use it to check balance and where a part will tip.","help.inspect.colored_components":"Gives each component its own temporary colour, without changing appearances. Use it to tell the parts of an assembly apart at a glance.","help.inspect.compare":"Compares two bodies and shows where one has material the other does not, with volume and deviation. Use it to check a changed or imported part against the original.","help.inspect.continuity":"Checks how smoothly faces meet along their edges: gaps, kinks or curvature jumps, and shades the seams. Use it to find where surfaces do not join cleanly.","help.inspect.curvature_comb":"Draws combs along curves, edges or faces whose teeth show how strongly they bend. Use it to spot flat spots, kinks and uneven curvature.","help.inspect.curvature_map":"Colours faces by how strongly they curve, red where the radius is small. Use it to find tight spots and to judge how smooth a surface is.","help.inspect.draft":"Colours faces by their draft angle to a pull direction, marking those with too little. Use it to check a part before moulding or casting.","help.inspect.environment_map":"Shows the model with a reflective, mirror-like finish. Use it to judge the flow of surfaces by the way reflections run across them.","help.inspect.interference":"Finds bodies that overlap and shows each overlap with its volume. Use it to check an assembly for parts that collide.","help.inspect.isocurve":"Draws the isoparametric curves of faces, the grid the surface is built on. Use it to see how a surface flows and where it bunches up.","help.inspect.measure":"Measures lengths, distances, angles, areas and radii between what you pick, or the volume and mass of bodies. Use it to check sizes and clearances.","help.inspect.minimum_radius":"Finds the smallest radius of curvature of curves, edges or faces, and where it is. Use it to check that a tool or nozzle can follow the shape.","help.inspect.section":"Cuts the view open along a plane and hatches the cut faces, without changing the model. Use it to look inside parts and assemblies.","help.inspect.zebra":"Shows black and white stripes reflected on the model's faces. Use it to judge smoothness: stripes that break or kink at an edge show a poor transition.","help.joint.as_built":"Joins two parts where they already are, without moving either one, and sets how they may still move. Use it for parts you have already placed in their final position.","help.joint.cam":"Links a turning cam to a follower, so the follower slides or swings as the cam's outline passes under it. Use it for cams, eccentrics and valve drives.","help.joint.create":"Joins two parts at the joint origins you pick and moves the second part into place; the joint type sets how they may still move. Use it to build an assembly whose parts move like the real mechanism.","help.joint.drive":"Sets a joint's angle or distance and moves the parts with it, within its limits; linked joints and closed loops follow. Use it to check that a mechanism moves as intended.","help.joint.gear":"Links two turning joints with a gear ratio, so driving one turns the other. Use it for spur and ring gears, with the ratio from pitch radii or tooth counts.","help.joint.limits":"Sets how far a joint may turn or slide, as a minimum and a maximum, or clears those limits. Use it to keep a hinge, slider or lever within its real range of travel.","help.joint.motion_link":"Couples two joints with a ratio and an offset, so driving one moves the other. Use it for a fixed relation between joints that Gear, Rack and Pinion or Screw do not cover.","help.joint.origin":"Places a named joint origin on a part: at the centre of a face or round end, the middle of an edge, a corner or a point. Use it to prepare where joints attach; one picked on a face follows it when the part changes size.","help.joint.rack_pinion":"Links a turning pinion to a sliding rack, so the rack moves by the length of pitch circle the pinion rolls through. Use it for rack drives, steering and linear stages.","help.joint.reach":"Moves a point on a part toward a target by changing the joints on its chain, within their limits. Use it to pose a mechanism by where its end should be, such as the tip of a robot arm.","help.joint.rigid_group":"Locks the selected parts together as they are, so they move as one. Use it for parts that belong together and have no motion between them.","help.joint.screw":"Links turning and sliding by a pitch, so each turn advances by that distance. Use it for lead screws, bolts and threaded spindles.","help.library.apply":"Applies a material or appearance from a local library file to bodies, faces or components. Use it to reuse materials you saved from another design.","help.library.export":"Saves the design's materials and appearances to a library file. Use it to share them or reuse them in other designs.","help.library.inspect":"Checks a library file and lists its materials and appearances, without changing the design. Use it to see what a library holds before applying it.","help.licences":"Licenses","help.material.assign":"Sets what the selected bodies are made of, such as steel, aluminum or ABS. Use it so that the mass and weight match the real part.","help.material.properties.validate":"Checks a material data card for consistent numbers and missing values. Use it before relying on the data for mass or stiffness.","help.mesh.convert":"Rebuilds a mesh body, such as an STL, as an editable solid with flat and cylindrical faces. Use it to modify imported mechanical parts like a modelled body.","help.mit":"MIT license","help.motion.study":"Sets joint values at steps along a timeline and plays them back as an animation. Use it to watch a mechanism move through a sequence and check clearances along the way.","help.motion.trace":"Traces the path a point on a part follows while a motion study plays or a joint is driven, and keeps it as a 3D sketch curve when you confirm. Use it to see where a mechanism reaches, or to build on its path.","help.notice":"NOTICE","help.occurrence.ground":"Fixes a part in place, or frees it again, so that joints move the other parts around it. Use it for the frame or base that the rest of the assembly is built on.","help.occurrence.move":"Moves an assembly part only along freedoms allowed by its joints. Select a part face, then drag an available arrow or arc.","help.parameters.change":"Opens the table of named values and expressions that drive the dimensions of the design. Use it to change a size in one place and let every feature that uses it follow.","help.parameters.export":"Saves the design's parameters as CSV or JSON. Use it to edit them in a spreadsheet or move them to another design.","help.parameters.graph":"Shows which parameters and features use which others, and any loops or errors among them. Use it to see what a change to a parameter will affect.","help.parameters.import":"Reads parameters from CSV or JSON into the design, all or none of them. Use it to bring in values from a spreadsheet or another design.","help.parameters.move":"Moves a user parameter before or after another in the list. Use it to keep related parameters together.","help.parts.fastener":"Adds a standard screw, bolt, nut, washer, pin or bearing in the size you pick. Placed on a hole, it seats in the hole with a joint, so you need not model fasteners yourself.","help.parts.insert":"Inserts a standard part in the family, size and length you pick. Placed on the rim or wall of a hole, it seats on the hole with a rigid joint.","help.parts.library":"Opens the standard parts: screws, bolts, nuts, washers, set screws, dowel pins and bearings in standard sizes. Use it to add a standard part instead of modelling it yourself.","help.parts.resize":"Changes the size or length of an inserted standard part and rebuilds it; its joints keep it seated. Use it when a screw turns out too long or a hole needs another size.","help.plastic.assign_rule":"Assigns a plastic rule to bodies, so their plastic features take its draft and clearance as defaults. Use it to set up a moulded part once for all its features.","help.plastic.boss":"Adds a screw boss on a face: a post with an optional hole, draft, root fillet and supporting ribs. Use it for screw points in moulded or printed housings.","help.plastic.lip":"Adds a lip or a matching groove along the rim of a shelled body. Use it so that two housing halves locate on each other and close tightly.","help.plastic.manage_rules":"Creates and edits plastic rules: material, wall thickness, radii, clearance and draft. Use them to keep the features of a moulded part consistent.","help.plastic.rest":"Adds a rest on a face: a round or rectangular pad, solid or hollow, with draft. Use it as a support or standoff in a moulded housing.","help.plastic.snap_fit":"Adds a snap-fit hook on a face, with its length, thickness and catch. Use it to clip parts together without screws.","help.pointcloud.insert":"Insert a PLY, XYZ or PTS scan as a point cloud alongside the model. Use it as a reference when building a model from measured data.","help.sheet.convert":"Turns a plate or shelled body of even thickness into a sheet metal body, with bends at the edges you pick. Use it to make an existing part unfoldable.","help.sheet.export_bend_table":"Saves the bend table of a sheet metal body as CSV or JSON: angles, radii and bend positions in the flat. Use it for the press brake or the workshop.","help.sheet.export_dxf":"Saves the flat pattern as a DXF, with outlines, bend lines and optional bend notes. Use it for laser, plasma or waterjet cutting.","help.sheet.flange":"Adds a flange: a base plate from a sketch, a wall along an open sketch contour, or a bent wall on sheet edges. Use it to build up sheet metal parts.","help.sheet.flat_pattern":"Creates the flat pattern of a sheet metal body, with its size, cut-outs and bend lines. Use it to check the blank before you cut it.","help.sheet.fold":"Bends a sheet along a sketch line by an angle and radius. Use it to fold a flat sheet after cutting features into it.","help.sheet.hem":"Folds a sheet edge back on itself. Use it for safe, stiff edges without sharp burrs.","help.sheet.manage_rules":"Creates and edits sheet metal rules: thickness, bend radius, K-factor, reliefs and gaps. Use them to match the material and tools of your workshop.","help.sheet.path_flange":"Adds a chain of flanges along a sheet edge, following an open chain of sketch lines. Use it for profiles such as a U or Z shape in one step.","help.sheet.perforate":"Adds a field of holes over the whole flat sheet, in a staggered or square pattern. Use it for vents, grilles and lighter panels.","help.sheet.refold":"Folds an unfolded sheet metal body back up. Use it after adding features to the flat sheet.","help.sheet.unfold":"Unfolds all bends of a sheet metal body. Use it to add holes or cuts that have to cross a bend, then refold.","help.sketch.arc.center_point":"Draws a circular arc around a centre point, from a start point to an end point. Use it when the arc's centre is known, such as a radius around a hole or a pivot.","help.sketch.arc.tangent":"Draws an arc that starts at the end of a line or arc and continues tangent to it. Use it to carry on a chain with a smooth bend instead of a corner.","help.sketch.arc.three_point":"Draws an arc from a start point to an end point through a third point. Use it when the arc has to pass through given points rather than around a known centre.","help.sketch.arc3d":"Draws an exact circular arc in space through three points, with 3D Sketch on. Use it for bends in paths and guide rails that leave the sketch plane.","help.sketch.auto_constrain":"Adds the constraints the sketch nearly has already, such as horizontal, parallel or coincident, then dimensions it until it is fully defined. Use it to lock a roughly drawn sketch in one step.","help.sketch.auto_constrain_from_datum":"Works like AutoConstrain, but measures the positions from a datum point you pick instead of the origin. Use it when the part is laid out from one reference point, such as a corner or a hole.","help.sketch.blend_curve":"Joins the ends of two curves with a smooth spline that is tangent to both, or also curvature continuous if you choose. Use it to bridge a gap between curves without a kink.","help.sketch.break":"Splits a curve into pieces where other curves cross it, or at points you place on it. Use it when part of a curve needs its own constraint or should be deleted on its own.","help.sketch.cancel":"Leaves the sketch and discards everything changed since it was created or opened for editing. Undo brings the changes back.","help.sketch.centerline":"Switches lines between normal lines and centerlines, axes that profiles leave out. Use a centerline as the axis for a revolve, a mirror or a symmetry constraint.","help.sketch.chamfer.distance_angle":"Bevels the corner between two lines, set by a distance along the first line and an angle. Use it when a drawing gives the chamfer as a length and an angle, such as 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Bevels the corner between two lines the same distance back along both. Use it for the usual 45° chamfer on an outline.","help.sketch.chamfer.two_distance":"Bevels the corner between two lines, set by a separate distance along each line. Use it for chamfers that are not 45°, given as two lengths.","help.sketch.circle.center":"Draws a circle from its centre and its diameter. Use it for holes, bosses and other round features whose centre is known.","help.sketch.circle.three_point":"Draws a circle through three points. Use it when the circle has to pass through given points, for example of existing geometry.","help.sketch.circle.three_tangent":"Draws a circle that touches three lines, circles or arcs. Use it to fit a circle into the space between three curves, such as the inscribed circle of a triangle.","help.sketch.circle.two_point":"Draws a circle from the two ends of its diameter. Use it when the circle's edge points are known rather than its centre.","help.sketch.circle.two_tangent":"Draws a circle of a given size that touches two lines, circles or arcs. Use it for a rounding of fixed radius between two curves.","help.sketch.conic":"Draws a conic curve between two end points, shaped by an apex point and a rho value. Use it for smooth transitions whose fullness you want to tune, from flat to nearly a sharp corner.","help.sketch.constrainer":"Applies the constraint that one or two picked curves nearly have already, such as horizontal, parallel, tangent or equal. Use it to tidy a hand-drawn sketch one relation at a time.","help.sketch.constraint.coincident":"Makes a point lie on another point, a curve or a sketch axis. Use it to close gaps in a profile or to put a point on a line.","help.sketch.constraint.collinear":"Makes two lines lie on one straight line. Use it to line up interrupted edges, such as both sides of a notch.","help.sketch.constraint.concentric":"Gives two circles or arcs the same centre. Use it for rings, counterbores and shafts with shoulders.","help.sketch.constraint.curvature":"Makes two curves that meet at an end point continue with the same curvature (G2). Use it where a tangent join is not smooth enough, for example on visible surfaces.","help.sketch.constraint.equal":"Makes lines the same length, or circles and arcs the same radius. Use it so that one dimension drives several matching features.","help.sketch.constraint.fix":"Fixes points or curves where they are, or frees them again. Use it for geometry that must not move when you drag or solve the sketch.","help.sketch.constraint.horizontal_vertical":"Makes a line, or the line between two points, horizontal or vertical, whichever is closer. Use it to square an outline up to the sketch axes.","help.sketch.constraint.midpoint":"Puts a point on the middle of a line, or makes the midpoints of two lines meet. Use it to centre geometry on an edge.","help.sketch.constraint.parallel":"Makes two lines parallel. Use it for sides that must stay parallel when other dimensions change.","help.sketch.constraint.perpendicular":"Makes two lines meet at a right angle. Use it for square corners between lines that are not on the sketch axes.","help.sketch.constraint.polygon":"Makes a closed chain of lines a regular polygon: equal sides, with every corner on one circle. Use it to make a hand-drawn polygon regular and keep it so.","help.sketch.constraint.symmetry":"Makes two points or curves mirror each other across a line or about a point. Use it to keep a profile symmetric when you change one side.","help.sketch.constraint.tangent":"Makes two curves touch tangentially, such as a line and an arc. Use it for smooth joins without a kink.","help.sketch.construction":"Switches curves between normal geometry and construction geometry, which profiles leave out. Use construction curves as helpers for layout, references and dimensions.","help.sketch.construction_line":"Create an infinite construction line through two points. Use it to lay out a sketch without splitting profiles.","help.sketch.construction_line.angle":"Create an infinite construction line at an angle from sketch X. Pick the point and type the angle, or pick its direction.","help.sketch.construction_line.bisector":"Pick two intersecting straight sketch lines, then choose either angle bisector. The result follows its source lines.","help.sketch.construction_line.horizontal":"Create an infinite horizontal construction line through a point. Its horizontal constraint follows later edits.","help.sketch.construction_line.parallel":"Pick a straight sketch line, then place a parallel infinite construction line. Right-click to choose another reference.","help.sketch.construction_line.perpendicular":"Pick a straight sketch line, then place a perpendicular infinite construction line. Right-click to choose another reference.","help.sketch.construction_line.tangent_at":"Create a tangent at a point on a circle or circular arc, or an endpoint of an open spline or conic. Pick the curve, then its contact point.","help.sketch.construction_line.tangent_external":"Pick a circle or circular arc, then an external point and a tangent solution. The previews show only contacts on the drawn arc.","help.sketch.construction_line.tangent_two":"Pick two circles or circular arcs, then choose a common tangent in the preview. Contacts must lie on the drawn curves.","help.sketch.construction_line.vertical":"Create an infinite vertical construction line through a point. Its vertical constraint follows later edits.","help.sketch.copy":"Copies the selected sketch curves and points, together with the constraints and dimensions among them. Paste them into this sketch or another one.","help.sketch.create":"Starts a new 2D sketch on a plane or on a flat face of the model. Every extrude, revolve and sweep begins with a sketch.","help.sketch.cut":"Copies the selected sketch geometry and deletes it from the sketch, in one undo step. Paste it elsewhere in this sketch or into another one.","help.sketch.dimension":"Adds a driving dimension: a length, distance, angle, radius or diameter, depending on what you pick. Type a value or a parameter name, and the sketch follows it.","help.sketch.edit":"Opens an existing sketch for editing. The features built on it update when you finish the sketch.","help.sketch.ellipse":"Draws an ellipse from its centre, the end of its major axis and a point on its minor side. Use it for oval openings, cams and other elongated round shapes.","help.sketch.equation_curve":"Draws a curve from formulas: x(t) and y(t), or y = f(x), over a range. The formulas can use parameters and the curve follows them: use it for a sine wave, a spiral or a gear tooth's involute.","help.sketch.extend":"Lengthens a line or arc up to the nearest curve in its way, or grows two curves until they meet. Use it to close gaps in a profile after trimming or editing.","help.sketch.fillet":"Rounds the corner where two lines or arcs meet with an arc of a given radius. Several corners rounded together share one radius.","help.sketch.finish":"Leaves the sketch and returns to the model. Its closed profiles are then ready for Extrude, Revolve and other features.","help.sketch.finish_auto_constrain":"Runs AutoConstrain on the sketch, then finishes it. Use it to leave a sketch fully defined in one step.","help.sketch.fit_curves_to_section":"Cuts a mesh or solid body with the sketch plane and fits lines and arcs to the section. Use it to rebuild a scanned or imported part as an editable sketch.","help.sketch.include_3d":"Brings model edges, vertices and curves of other sketches into this sketch as linked references, flattening those off its plane onto it. Use it to build on geometry that does not lie in the sketch plane.","help.sketch.infinite":"Switches lines between normal lines and infinite construction lines that run across the whole view. Use them as layout references that never end too short.","help.sketch.insert_dxf":"Reads the curves of a DXF drawing into a sketch, scaled, turned and placed where you set. Use it to build on a 2D drawing from another program, such as a laser-cut outline.","help.sketch.insert_svg":"Reads the paths of an SVG drawing into a sketch, scaled, turned and placed where you set. Use it to turn a logo or vector outline into curves you can extrude.","help.sketch.inspect":"Opens a report on the open sketch: how many degrees of freedom are left and whether it is fully constrained. Use it to find out what still moves before you finish the sketch.","help.sketch.intersect":"Adds the curves or points where bodies, faces, edges or other sketches cross the sketch plane. They stay linked and follow the model when it changes.","help.sketch.intersection_curve":"Creates 3D curves where two bodies or faces meet, linked to them. Use them as paths or guide rails that follow the model.","help.sketch.isoparametric_curve":"Creates a 3D curve along a face's U or V direction through a point you pick, linked to the face. Use it as a path or split line that follows the surface.","help.sketch.line":"Draws connected lines point by point, as an open chain or a closed outline. It is the basic tool for most profiles.","help.sketch.line.midpoint":"Draws a line from its midpoint out to one end, with the other end mirrored. Use it for lines centred on a point, such as a symmetric edge.","help.sketch.line3d":"Draws connected straight lines between points in space, with 3D Sketch on. Use it for paths and frames that leave the sketch plane.","help.sketch.mirror":"Mirrors sketch curves and points across a line or axis and adds symmetry constraints. Use it to draw half of a symmetric profile and complete it.","help.sketch.move":"Moves or rotates sketch curves and points, or a copy of them. Use it to reposition geometry while keeping its shape and constraints.","help.sketch.offset":"Creates a copy of a chain of curves at a set distance, on one side or both. Use it for walls, outlines and clearances; the distance stays an editable dimension.","help.sketch.paste":"Pastes sketch geometry you copied or cut into the active sketch. Place it at a point or shift it by an offset.","help.sketch.pattern.circular":"Copies sketch geometry around a centre point, over a full circle or a set angle. Use it for bolt circles, spokes and teeth.","help.sketch.pattern.rectangular":"Copies sketch geometry in rows and columns at set spacings. Use it for grids of holes, slots or vents.","help.sketch.point":"Places a sketch point. Use it as a reference for dimensions, constraints, hole centres or later features.","help.sketch.point3d":"Places a point in space, with 3D Sketch on. Use it as a reference for 3D curves and paths.","help.sketch.polygon.circumscribed":"Draws a regular polygon around a circle, sized from its centre to the middle of a side. Use it when the width across flats is known, as for a hex nut.","help.sketch.polygon.edge":"Draws a regular polygon from the two ends of one side. Use it when the length and position of a side are known.","help.sketch.polygon.inscribed":"Draws a regular polygon inside a circle, sized from its centre to a corner. Use it when the size across corners is known.","help.sketch.project":"Brings model edges, faces, vertices and curves of other sketches into this sketch, projected onto its plane. They stay linked and follow the model when it changes.","help.sketch.project_to_surface":"Projects curves of other sketches along this sketch's normal onto a face, as linked 3D curves. Use it to put a logo, split line or path onto a curved surface.","help.sketch.rectangle.center":"Draws a rectangle from its centre and one corner. Use it for outlines centred on a point, such as the origin.","help.sketch.rectangle.rounded":"Draws a rectangle with all four corners rounded to one radius. Use it for plates, lids and openings with rounded corners.","help.sketch.rectangle.three_point":"Draws a rectangle from one edge and a point on the opposite side. Use it for rectangles at an angle to the sketch axes.","help.sketch.rectangle.two_point":"Draws a rectangle from two opposite corners. Use it for the outlines of plates, blocks and pockets.","help.sketch.scale":"Scales sketch curves and points by a factor about a base point. Use it to resize part of a sketch without drawing it again.","help.sketch.slot.arc_center":"Draws a curved slot of a given width along an arc set by its centre, start and end. Use it for adjustment slots around a pivot.","help.sketch.slot.arc_three_point":"Draws a curved slot of a given width along an arc through three points. Use it when the slot's path has to pass through given points.","help.sketch.slot.center_point":"Draws a straight slot of a given width from its centre to the centre of one end arc. Use it for slots centred on a point.","help.sketch.slot.center_to_center":"Draws a straight slot of a given width between the centres of its two end arcs. Use it for slots dimensioned centre to centre, such as adjustment slots for screws.","help.sketch.slot.overall":"Draws a straight slot of a given width from one outer end to the other. Use it when the slot's overall length is what matters.","help.sketch.spline.control_point":"Draws a cubic spline shaped by control points that it does not pass through. Use it for smooth, flowing curves that you shape by moving the points.","help.sketch.spline.control_point_5":"Draws a degree 5 spline shaped by control points. Use it where curves have to join with smoother curvature, for example on visible styled surfaces.","help.sketch.spline.fit_point":"Draws a smooth spline that passes through every point you place, open or closed. Use it to trace a shape through known points.","help.sketch.spline3d":"Draws a smooth curve in space through points, with 3D Sketch on. Use it for sweep paths and cable runs that leave the sketch plane.","help.sketch.spun_profile":"Creates in the sketch plane the outline a body sweeps when it turns about an axis. Use it to get the silhouette of a turned part for a revolve or a drawing.","help.sketch.text":"Writes text in the sketch in a chosen font, height and angle; its words can follow parameters. Extrude or emboss it for labels and lettering.","help.sketch.transform":"Scales, turns and moves sketch geometry about a centre point in one step. Use it to reposition and resize a selection at once.","help.sketch.trim":"Removes the piece of a curve between the nearest crossings around where you click. Use it to clean up overlapping lines into a closed profile.","help.solid.align":"Moves the selected bodies so that a point, face or plane on them meets a point, face or plane elsewhere. Use it to place a part against another one without measuring the offset.","help.solid.boundary_fill":"Makes solids from the regions enclosed by overlapping tool bodies, filling only the regions you pick. Use it to build a shape from the space that several bodies bound together.","help.solid.bounding_solid":"Creates a box that encloses the selected bodies, with an optional margin. Use it to see a part's overall size, or as the stock it is machined from.","help.solid.box":"Creates a box from a length, width and height, from a corner point or centred on a point. Use it for a quick block, a placeholder or a body to cut features into.","help.solid.chamfer":"Cuts the selected edges with a flat bevel of the distance you set. Use it to break sharp edges or to ease the entry of a pin or screw.","help.solid.coil":"Creates a helical body, such as a spring, from a diameter, turns, height or pitch and a round or square section. Use it for springs, coils and helical ridges.","help.solid.combine":"Joins bodies, cuts them out of a target body, or keeps only the volume they share, and can keep the tool bodies. Use it to merge parts, to cut one shape with another or to find where two bodies overlap.","help.solid.cone":"Creates a cone from a base circle and a height, or a truncated cone when the top has a radius too. Use it for tapers, funnels, countersinks and points.","help.solid.cylinder":"Creates a cylinder from a radius or diameter and a height, standing on a point along an axis. Use it for shafts, pins, bosses and round blanks.","help.solid.draft":"Tilts the selected faces by the angle you set, measured from a neutral plane. Use it on molded or cast parts so that they slide out of the mold.","help.solid.emboss":"Raises sketch profiles, such as text or a logo, out of a face, or sinks them into it. Use it for lettering, labels and markings on flat or round faces.","help.solid.extrude":"Pushes a sketch profile into 3D along a distance, adding or removing material. Use it to turn a flat outline into a block, a boss or a pocket.","help.solid.fillet":"Rounds the selected edges with a smooth circular blend of the radius you set. Use it to soften sharp edges for strength, comfort or looks.","help.solid.hole":"Drills a round hole of the diameter you set at a chosen point on a face. Use it for screw clearances, pins and other simple round openings.","help.solid.loft":"Blends a smooth solid between two or more sketch profiles, or from a profile to a point. Use it for transitions, funnels, handles and any shape that changes section along its length.","help.solid.mirror":"Makes a mirrored copy of the selected bodies or features across a plane, and can merge it with the original. Use it for symmetric parts, so that you model one half and get both.","help.solid.move":"Moves or rotates the selected bodies, or a copy of them, by the distance and angle you set. Use it to reposition a body or to make a second one in another place.","help.solid.offset_face":"Pushes the selected faces in or out by the distance you set, and the faces around them follow. Use it to make a wall thicker, a pocket deeper or a boss taller without editing the sketch.","help.solid.pattern.circular":"Repeats the selected objects around an axis, for the count and total angle you set. Use it for bolt circles, spokes, fins and teeth.","help.solid.pattern.path":"Copies features or bodies along a sketch path, by count and spacing. Use it for holes along a curved edge or parts along a rail.","help.solid.pattern.rectangular":"Repeats the selected objects in one or two directions with the count and spacing you set. Use it for rows and grids of holes, ribs, pins or feet.","help.solid.pipe":"Creates a round tube along a path of sketch curves, solid or hollow with a wall thickness. Use it for tubes, wires, cables and rails.","help.solid.press_pull":"Adds or removes material as you drag a face, or rounds edges as you drag them. Use it for quick changes straight on the model.","help.solid.remove":"Takes the selected bodies out of the design from this point in the timeline on; earlier steps keep them. Use it to drop a helper body, such as a cutting tool you no longer need.","help.solid.replace_face":"Moves the selected flat faces onto a plane or onto a parallel face, and the body grows or shrinks to meet it. Use it to bring a face flush with another part or a construction plane.","help.solid.revolve":"Spins a sketch profile around an axis to make a round solid. Use it for shafts, knobs, bowls and any part that is round about a center line.","help.solid.rib":"Adds a thin wall along an open sketch curve, filled out to the next faces of the body. Use it to stiffen walls and corners, for example in moulded or printed parts.","help.solid.scale":"Makes the selected bodies larger or smaller by a factor, the same in every direction or one per axis. Use it to resize an imported shape or to allow for shrinkage.","help.solid.shell":"Hollows out a solid, leaving walls of the thickness you set, and can open the faces you pick. Use it for boxes, covers and other thin-walled parts.","help.solid.sphere":"Creates a sphere from a radius or diameter around a centre point. Use it for balls, knobs and rounded ends.","help.solid.split_body":"Cuts a body into separate bodies with a plane, the face of another body or a sketch line. Use it to make parts that are printed, machined or colored on their own.","help.solid.split_face":"Divides the selected faces along a plane, the face of another body or sketch curves, without cutting the body. Use it to give part of a face its own draft, color or offset.","help.solid.sweep":"Drags a sketch profile along a path to make a solid. Use it for pipes, rails, handles and any part of constant section that follows a curve.","help.solid.thread":"Adds an ISO metric thread to a cylindrical face, either as a cosmetic thread or cut into the body. Use it for bolts, threaded holes and printed screw parts.","help.solid.torus":"Creates a ring from a major radius around its axis and a minor radius for its round section. Use it for O-rings, handles and round beads.","help.solid.web":"Adds a thin wall along each open sketch curve, each filled out to the next faces of the body. Use it for a grid of supporting walls inside housings and trays.","help.surface.blend":"Creates a surface that bridges the edges of two bodies, tangent or curvature continuous to both. Use it to join two surfaces smoothly across a gap.","help.surface.boundary":"Creates a surface filling a loop of two to four sketch curves, or a network of curves. Use it for free-form panels defined by their edges.","help.surface.extend":"Lengthens a surface past its edges, by a distance or up to a plane or face. Use it so that surfaces overlap before you trim or stitch them.","help.surface.extrude":"Pushes sketch curves or profiles along a distance into a surface, walls only, without caps. Use it for thin walls and for cutting or splitting tools.","help.surface.fair":"Smooths the inside of free-form faces while their edges stay put. Use it to even out bumps and wavy reflections in a surface.","help.surface.loft":"Creates a surface that passes through two or more sections in order, without caps. Use it for shells and transitions between different shapes.","help.surface.match":"Rebuilds the edge of a surface so it meets another body's edge, with matching tangent or curvature. Use it to close a seam smoothly between two surfaces.","help.surface.offset":"Creates a copy of faces at a distance along their normals, as a new surface body. Use it for skins, clearances or the other side of a wall.","help.surface.patch":"Fills a sketch region or a closed loop of edges with a face, flat or smoothly curved. Use it to close holes in a surface body.","help.surface.reverse_normal":"Turns faces of a surface body over, so their outside faces the other way. Use it before thickening or stitching when the faces point inward.","help.surface.revolve":"Turns sketch curves or profiles about an axis into a surface, without caps. Use it for round shells such as lampshades, bowls and nozzles.","help.surface.ruled":"Creates a strip of straight lines out from a chain of edges, along the face's normal, tangent or at an angle. Use it for draft walls, run-offs and parting surfaces.","help.surface.stitch":"Sews surface bodies together along their shared edges, into a solid when they close. Use it to turn a set of surfaces into one body.","help.surface.sweep":"Moves sketch curves or profiles along a path into a surface, without caps. Use it for gutters, trims and other thin shapes that follow a path.","help.surface.thicken":"Gives a surface body a thickness, turning it into a solid. Use it to make printable or machinable parts from surfaces.","help.surface.trim":"Cuts a surface with a plane, another surface or sketch curves, and keeps the side you pick. Use it to cut surfaces to shape before stitching.","help.surface.unstitch":"Separates faces of a body into surface bodies of their own; a solid comes apart into surfaces. Use it to rework single faces of a body.","help.surface.untrim":"Removes holes from a face, or restores its outer boundary to the surface's natural bounds. Use it to get back the full surface after a trim.","help.third_party":"Third-party licenses","help.timeline.compute_all":"Rebuilds every feature in the timeline from the start. Use it to refresh the model and to see which features fail.","help.timeline.delete":"Deletes the selected features from the timeline; deleting a sketch also deletes the features built from it. Use it to remove a step that is no longer wanted.","help.timeline.dependents":"Lists the features that would be deleted with a feature, and those that would fail without it. Use it before deleting or changing a feature.","help.timeline.play":"Replay the remaining features one at a time, with a half-second pause after each rebuild. Run this command again or press Escape to stop; Go to end jumps immediately.","help.view.apply":"Turns the view to a standard direction such as front, top or iso, or to a saved named view. Use it to look at the model from a fixed angle.","help.view.delete":"Deletes a saved named view. The model is not changed.","help.view.fit":"Zooms and pans so the whole model, or the selection, fills the view. Use it when the model has gone out of sight.","help.view.grid":"Shows or hides the grid in the viewport. Use it as a size and orientation guide while modelling.","help.view.ground_shadow":"Shows or hides the model's shadow on the ground. Use it to judge height and position more easily.","help.view.home":"Turns the view back to the home direction and fits the model. Use it to get back to a known view quickly.","help.view.list":"Lists the named views saved in the design. Use it to find a view you saved earlier.","help.view.navigate":"Turns, pans or zooms the view by steps, such as a quarter turn left. Use it to move the camera precisely instead of dragging.","help.view.navigation_bar":"Shows or hides the navigation bar at the bottom of the viewport. Hide it for more room, show it to reach the view tools by mouse.","help.view.rename":"Gives a saved named view a new name. The view itself stays the same.","help.view.save":"Saves the current camera position as a named view in the design. Use it to come back to the same angle later, for example for screenshots.","help.view.spin":"Orbits the view around the model continuously until the next click or key. Use it to present a model from all sides.","help.view.tool":"Latches a camera tool, orbit, pan or zoom, so that dragging with the left mouse button moves the view until you switch it off. Use it on a trackpad or without a middle mouse button.","help.view.visual_style":"Switches how the model is drawn: shaded with or without edges, wireframe, or with hidden edges. Use wireframe to see inside, shaded for a clean look.","history.sketch_under_constrained":"Under constrained ({count} degrees of freedom)","history.sketch_under_constrained_one":"Under constrained ({count} degree of freedom)","hole_presets.confirm_delete":"Confirm delete","hole_presets.delete":"Delete","hole_presets.delete_prompt":"Delete this personal preset? Existing holes are unchanged.","hole_presets.full":"The personal library already contains 64 presets.","hole_presets.invalid_name":"Enter a short name without line breaks or control characters.","hole_presets.invalid_parameters":"Complete the hole parameters using valid expressions of reasonable length.","hole_presets.missing":"The selected preset is no longer available.","hole_presets.name":"Preset name","hole_presets.name_exists":"A preset with this name already exists. Use a different name.","hole_presets.name_hint":"A unique name","hole_presets.overwrite":"Save changes to selected preset","hole_presets.preset":"Preset","hole_presets.recall":"Recall","hole_presets.rename":"Rename","hole_presets.save":"Save new","hole_presets.scope":"Saved in your profile for all projects.","hole_presets.select":"Select a preset","hole_presets.title":"Personal presets","hole_presets.unsupported_options":"This preset uses thread options that this version cannot recall.","hole_presets.unsupported_overwrite":"This preset contains options that cannot be overwritten safely.","home.back":"Back to {name}","home.crashes":"Crash reports","home.design_workspace":"Design","home.documentation":"Documentation","home.export":"Export","home.export_hint":"Choose a format for the current design.","home.export_json_hint":"Editable design and command history","home.export_mesh_hint":"Mesh for printing or sharing","home.export_step_hint":"Precise solid geometry","home.import":"Import…","home.import_hint":"STEP, IGES or mesh into a new design","home.in_this_browser":"in this browser","home.missing":"missing","home.month_01":"Jan","home.month_02":"Feb","home.month_03":"Mar","home.month_04":"Apr","home.month_05":"May","home.month_06":"Jun","home.month_07":"Jul","home.month_08":"Aug","home.month_09":"Sep","home.month_10":"Oct","home.month_11":"Nov","home.month_12":"Dec","home.new_inches":"New design, inches","home.new_inches_hint":"Inches · opens in Design","home.new_mm":"New design","home.new_mm_hint":"Millimeters · opens in Design","home.open":"Open…","home.open_hint":"A .sc design ({shortcut})","home.open_now":"Open now","home.opened_days_ago":"{count} days ago","home.opened_hours_ago":"{count} h ago","home.opened_just_now":"Just now","home.opened_minutes_ago":"{count} min ago","home.opening":"opening…","home.properties":"Design properties","home.recent":"Recent","home.recent_empty":"Designs you open or save appear here.","home.recovery_count":"Recoverable designs: {count}","home.recovery_empty":"No recoverable designs.","home.recovery_hint":"SolidCraft closed before these designs were saved.","home.report_issue":"Report an Issue","home.samples":"Samples","home.settings":"Preferences","home.short_date":"{day} {month}","home.shortcuts":"Keyboard shortcuts","home.start_hint":"Create a design, open a recent file, or explore a sample.","home.whats_new":"What's new","home.yesterday":"Yesterday","install.button_tip":"Install SolidCraft as an app: it opens in its own window and works offline","install.dock_1":"Choose File › Add to Dock.","install.dock_2":"Click Add.","install.dock_after":"SolidCraft then opens in its own window from the Dock, and works offline.","install.done":"Done","install.home_screen_1":"Tap Share (in the … menu if it isn't on the toolbar).","install.home_screen_2":"Choose Add to Home Screen.","install.home_screen_3":"Tap Add.","install.home_screen_after":"SolidCraft then opens from its icon on the Home Screen, without Safari's toolbars, and works offline.","install.menu":"Install app…","install.steps_intro":"Safari installs web apps from its own menus:","install.title":"Install SolidCraft","issue.body_label":"Report text","issue.note_changed_while_waiting":"Settings or model changed while waiting for the preview. Retake the screenshot to update the technical details for the current view.","issue.note_details_kept":"Screenshot captured locally. Your edited technical details were kept: check that they still match the current view.","issue.note_details_updated":"Technical details updated to match the current view. Screenshot captured locally. Review it before attaching it on GitHub.","issue.note_image_copied":"Paste the image into the GitHub draft, or save the PNG if image copying is unavailable.","issue.note_opened":"Review the GitHub draft and attach the screenshot. GitHub's Submit new issue button publishes it.","issue.note_opened_copied":"Report copied. Paste into the GitHub draft, attach the screenshot, then click Submit new issue on GitHub.","issue.note_removed":"Screenshot removed from this draft.","issue.note_report_copied":"Report copied. Paste it into the GitHub draft if needed.","issue.note_save_failed":"Could not save screenshot: {error}","issue.note_saved":"Screenshot saved. Attach the PNG in the GitHub draft.","issue.save_screenshot":"Save screenshot…","joint.from_bodies_hint":"Each picked body moves into a new component of its own and stays where it is.","joint.one_body":"Both picks are on {body}. Pick the second one on another part.","joint.one_component":"These parts are bodies of one component: {bodies}. A joint moves one component against another, so each part needs a component of its own.","joint.rigid_group_one_component":"These {count} bodies are all in one component (or in the design itself): use {command} first.","joint.rigid_group_select_components":"Select two or more components.","joint_move.blocked_hint":"Check the joint type (such as Rigid), grounding, joint limits, and parameter-driven values.","joint_move.blocked_title":"Cannot move this part","joint_move.coarse":"Near-axis rotation step (°)","joint_move.distance":"Distance from start","joint_move.done":"Done","joint_move.fine":"Far-axis rotation step (°)","joint_move.fixed":"This part has no movable joint axis.","joint_move.help":"Move — drag an arrow or ring. Esc cancels the current drag.","joint_move.legacy_hint":"Turn off to use the previous Move panel.","joint_move.precision":"Pull outside the dashed guide for fine rotation.","joint_move.rotation":"Rotation from start","joint_move.select":"Select a face or one assembly part, then choose Move.","joint_move.settings":"Assembly Move","joint_move.step":"Step","joint_move.use_handles":"Use joint motion handles for assembly Move","keymap.command_id":"Command ID","keymap.empty":"No matching commands","keymap.use_anyway":"Use {key} here anyway","label.move_to_left_side":"Move to left side","label.move_to_right_side":"Move to right side","manage.appearance_hint":"Choose a look for the selection, or drag a swatch onto a body or face.","manage.assign_hint":"Select bodies and choose their plastic design rule.","manage.config_hint":"Edit configuration rows, columns and rules, then activate or preview a row.","manage.empty":"No matching rows.","manage.material_hint":"Select bodies and choose their physical material.","manage.parameters_hint":"Edit expressions and units. Changes apply on Enter or when leaving a field.","manage.rules_hint":"Choose a rule to edit, or create a new rule. Confirm to save the rule.","material.editor.add_property":"Add property","material.editor.add_source":"Add source","material.editor.assigned_density":"Assigned density","material.editor.axes":"Material axes","material.editor.axes_numeric":"1 / 2 / 3","material.editor.axes_wood":"L / R / T","material.editor.copy_name":"Copy of {name}","material.editor.density_range":"Assigned density must be above 0 and at most 1000 g/cm³.","material.editor.designation":"Designation","material.editor.duplicate":"Duplicate","material.editor.engineering_card":"Engineering property card","material.editor.family":"Material family","material.editor.glass":"Glass","material.editor.illustrative":"Illustrative","material.editor.invalid_property":"Unsupported property type.","material.editor.isotropic":"Isotropic","material.editor.measurement":"Measurement","material.editor.metal":"Metal","material.editor.moisture":"Moisture, dry basis","material.editor.name_required":"Enter a name with 1–128 characters.","material.editor.no_draft":"No material draft is open.","material.editor.number_required":"Enter a finite numeric value.","material.editor.orthotropic":"Orthotropic","material.editor.other":"Other","material.editor.polymer":"Polymer","material.editor.preserved_appearance":"Preserved appearance","material.editor.public_reference":"Public reference","material.editor.reference":"Reference","material.editor.save_or_discard":"Save or discard the material draft before assigning a material.","material.editor.saved":"Material saved. Body assignments are unchanged.","material.editor.scope":"Save stores this material without assigning it to bodies. Blank properties and conditions remain unknown. Card density does not change assigned density or mass.","material.editor.source_id":"Source ID","material.editor.source_kind":"Source type","material.editor.source_title":"Source title","material.editor.sources":"Sources","material.editor.stale":"This material changed while the draft was open. Discard and reopen it before saving.","material.editor.state":"Material state","material.editor.strain_rate":"Strain rate","material.editor.symmetry":"Elastic symmetry","material.editor.temperature":"Temperature","material.editor.unknown_card":"Engineering properties are unknown. Save may keep only the assigned density and existing appearance.","material.editor.user_supplied":"User supplied","material.editor.wood":"Wood","material.selection.choose":"Choose a material","material.selection.mixed":"Different materials","measure.at":"At","measure.item":"Item {number}","measure.quick_copied":"Measurement copied","measure.quick_copy":"Click to copy the measurement","measure.quick_edges":"{count} edges","measure.quick_faces":"{count} faces","messages.ago_h":"{n} h ago","messages.ago_min":"{n} min ago","messages.ago_s":"{n} s ago","messages.chip_hint":"Click for all messages of this session","messages.clear":"Clear","messages.copy_all":"Copy all","messages.menu":"Messages…","messages.none":"No messages yet.","messages.title":"Messages","motion.checked_to":"Checked to step {step} only: the check ran out of its work budget","motion.collision":"{a} · {b}: steps {steps}","motion.delete_key":"Delete key","motion.duration_hint":"seconds (empty: per step)","motion.key_here":"Key here","motion.key_here_hint":"Add a key at this step with the joint's value now","motion.no_collisions":"No collisions over the study","motion.plot_quantity":"Quantity","motion.step_back":"Step back","motion.step_forward":"Step on","motion.to_end":"To the end","motion.to_start":"To the start","motion.track_name":"Track {number}","nav.alias.help":"Shift+Alt+left drag orbits, Shift+Alt+middle pans, Shift+Alt+right zooms; middle drag also pans and right drag orbits","nav.blender.help":"Middle drag orbits, Shift+middle pans, Ctrl+middle zooms; right drag leaves the camera alone","nav.free_orbit.help":"Mouse and 3D mouse rotate through both poles and preserve roll. Shift axis snapping is disabled.","nav.free_orbit.label":"Free orbit","nav.free_orbit.snap_help":"Mouse and 3D mouse rotate through both poles and preserve roll. Hold Shift during an orbit drag to snap the view direction and roll.","nav.free_orbit_upright.help":"Sideways mouse drags spin the model around the world's vertical axis; up and down drags tilt over the top without a limit.","nav.free_orbit_upright.label":"Turn around the vertical axis","nav.fusion.help":"Middle drag pans, Shift+middle orbits, right drag orbits","nav.hfss.help":"Alt+left drag pans, Shift+Alt+left zooms, Ctrl+left drag on empty space orbits","nav.inventor.help":"Middle drag pans, Shift+middle orbits, Ctrl+middle zooms, right drag orbits","nav.maya.help":"Alt+left drag orbits, Alt+middle pans, Alt+right zooms; middle drag also pans","nav.nx.help":"Middle drag orbits, Shift+middle pans (NX's middle + right), Ctrl+middle zooms (NX's middle + left); right drag leaves the camera","nav.openscad.help":"Left drag on empty space orbits, Shift+left drag box-selects, sketch geometry drags edit; right or middle drag pans, Shift+right or Shift+middle drag zooms","nav.perspective.sketch":"Sketch editing uses orthographic view. Finish the sketch to switch perspective.","nav.right_drag_orbits.help":"Off: a right drag leaves the camera alone and the right button only opens the context menu. Picking the SolidWorks mouse mapping turns it off.","nav.right_drag_orbits.label":"Right drag orbits","nav.solidworks.help":"Middle drag orbits, Ctrl+middle pans, Shift+middle zooms, right drag orbits","nav.tinkercad.help":"Right drag orbits, middle or Shift+right drag pans","nav.touchpad.help":"Hold Shift and move the pointer to pan; hold Alt/Option and move it to orbit. No mouse button is needed. Vertical scroll zooms.","nav.touchpad.label":"Touchpad","nav.touchpad.orbit":"Orbit (hold Alt/Option and move; no mouse button)","nav.touchpad.pan":"Pan (hold Shift and move; no mouse button)","nav.touchpad.scroll":"Touchpad uses vertical scroll to zoom. Your two-finger pan setting is kept for other presets.","nav.touchpad.zoom":"Zoom (vertical scroll or pinch)","navbar.agent_chat":"Assistant chat panel","navbar.agent_cursor":"Show agent cursor","navbar.ambient_occlusion":"Ambient occlusion","navbar.assistant":"Assistant","navbar.custom.add_slot":"Add {slot}","navbar.custom.always":"Always visible","navbar.custom.available":"{available} · drag onto the bar, or press Add","navbar.custom.buttons":"Buttons","navbar.custom.compact":"Compact","navbar.custom.count":"{count} of 16 slots","navbar.custom.customise":"Customize navigation bar…","navbar.custom.design":"Design","navbar.custom.duplicate":"This slot is already on the bar.","navbar.custom.edge":"Edge","navbar.custom.edge_bottom":"Bottom","navbar.custom.edge_top":"Top","navbar.custom.fade":"Fade","navbar.custom.full":"Remove a slot to add another.","navbar.custom.hidden_design":"Hidden in Design","navbar.custom.hidden_render":"Hidden in Render","navbar.custom.hide":"Hide navigation bar","navbar.custom.hide_idle":"Hide until hovered","navbar.custom.icon_only":"Icon only","navbar.custom.icon_value":"Icon and value","navbar.custom.icons":"Icons","navbar.custom.idle":"When idle","navbar.custom.intro":"Choose the controls on the bar at the bottom of the 3D view, and in what order. Drag a slot to move it, or drag it off the bar to remove it.","navbar.custom.labels":"Icons and labels","navbar.custom.left":"Move left","navbar.custom.position":"Position","navbar.custom.position_centre":"Center","navbar.custom.position_left":"Left","navbar.custom.position_right":"Right","navbar.custom.preview_as":"Preview as","navbar.custom.regular":"Regular","navbar.custom.remove":"Remove","navbar.custom.remove_bar":"Remove from bar","navbar.custom.render":"Render","navbar.custom.reset":"Reset navigation bar","navbar.custom.reset_default":"Reset to default","navbar.custom.right":"Move right","navbar.custom.select":"No slot selected. Select a slot on the bar to move it, remove it or change how it looks.","navbar.custom.separators_full":"The bar already has four separators.","navbar.custom.show":"Show navigation bar","navbar.custom.shows":"Shows","navbar.custom.size":"Size","navbar.custom.stale":"The bar changed. Select the slot again.","navbar.custom.title":"Navigation bar","navbar.custom.unknown":"This slot is not available.","navbar.description.ambient_occlusion":"Darkens creases and corners to add depth.","navbar.description.display":"Holds the view settings: graphics preset, grid, ground shadow, ambient occlusion and projection.","navbar.description.fit":"Frames the selection, or the whole model if nothing is selected.","navbar.description.grid":"Shows or hides the ground grid.","navbar.description.ground_shadow":"Shows or hides the shadow under the model.","navbar.description.home":"Returns to the isometric view of the whole model.","navbar.description.look_at":"Turns the view to face the selected face, plane or open sketch.","navbar.description.orbit":"Turns the view around the model.","navbar.description.pan":"Slides the view sideways, up or down.","navbar.description.projection":"Switches between orthographic and perspective views.","navbar.description.separator":"A thin line that groups neighboring slots.","navbar.description.spin":"Keeps the view turning until you click or press a key.","navbar.description.visual_style":"Switches how the model is drawn: shaded, wireframe or with hidden edges.","navbar.description.zoom":"Moves the view closer to or further from the model.","navbar.display":"Display","navbar.fit":"Fit","navbar.graphics":"Graphics","navbar.grid":"Grid","navbar.ground_shadow":"Ground shadow","navbar.home":"Home","navbar.later":"Later","navbar.look_at":"Look at","navbar.more":"More","navbar.orbit":"Orbit","navbar.orthographic":"Orthographic","navbar.pan":"Pan","navbar.perspective":"Perspective","navbar.preset":"Preset","navbar.projection":"Projection","navbar.projection_heading":"Projection","navbar.separator":"Separator","navbar.show":"Show","navbar.spin":"Spin","navbar.style.shaded":"Shaded","navbar.style.shaded_with_edges":"Shaded with edges","navbar.style.shaded_with_hidden_edges":"Shaded with hidden edges","navbar.style.wireframe":"Wireframe","navbar.translucent":"Translucent","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Visual style","navbar.zoom":"Zoom","needs two joints":"needs two joints","network.allow_once":"Allow once","network.always_allow":"Always allow this server","network.prompt_detail":"This design links to a file on network location {host}. Opening it connects to that computer and may send your Windows sign-in to it. Only allow servers you trust.","network.prompt_title":"Network location","new configuration":"new configuration","new parameter":"new parameter","no hole":"no hole","no interference":"no interference","no joint that moves yet":"no joint that moves yet","no motion study yet":"no motion study yet","no picture":"no picture","no such joint":"no such joint","none":"none","not a move":"not a move","not a number":"not a number","open a sketch first":"open a sketch first","parameters.apply_live":"Apply each change as you leave its field","parameters.apply_live_tip":"Off: changes wait until Apply or OK, then the design rebuilds once for all of them. Cancel or Escape drops them.","parameters.held":"{count} changes waiting for Apply","parameters.held_hint":"Edit expressions and units. Changes wait for Apply or OK.","parameters.held_one":"1 change waiting for Apply","parts.automatic_name":"automatic","parts.dimension.across_flats":"Across flats","parts.dimension.bore":"Bore","parts.dimension.d":"Nominal diameter","parts.dimension.head_diameter":"Head diameter","parts.dimension.head_height":"Head height","parts.dimension.height":"Height","parts.dimension.inner":"Inner diameter","parts.dimension.outer":"Outer diameter","parts.dimension.pitch":"Pitch","parts.dimension.socket":"Socket size","parts.dimension.socket_depth":"Socket depth","parts.dimension.thickness":"Thickness","parts.dimension.width":"Width","parts.family.bearing":"Deep groove ball bearing (envelope)","parts.family.button_head_cap_screw":"Button head cap screw","parts.family.dowel_pin":"Parallel pin (dowel)","parts.family.hex_bolt":"Hex head bolt / screw","parts.family.hex_nut":"Hex nut","parts.family.set_screw":"Hex socket set screw, flat point","parts.family.socket_head_cap_screw":"Socket head cap screw","parts.family.washer":"Plain washer","parts.holes":"Holes (optional)","parts.placement_hint":"pick one or more holes to seat a part in each, or OK places it at the origin","pattern.alignment_2":"Alignment 2","pattern.alignment_hint":"Counts include the original. Center balances copies; Flip chooses the extra side for even totals.","pattern.direction_1":"Direction 1","pattern.direction_2":"Direction 2","pattern.flip_direction":"Flip direction","perf.click_for_details":"Click for details: frame-time graph, histogram and what the GPU drew","perf.draw_calls":"Draw calls","perf.line_segments":"Line segments","perf.low_1":"1% low","perf.renderer":"Renderer","perf.scene_build":"Scene build","perf.triangles":"Triangles","perf.ui_time":"UI time","perf.viewport":"Viewport","perf.worst":"worst","pick a body or some of its faces":"pick a body or some of its faces","pick a hole to seat it, or OK places it at the origin":"pick a hole to seat it, or OK places it at the origin","pick a planar face":"pick a planar face","pick a plane or a face as the tool":"pick a plane or a face as the tool","pick a size":"pick a size","pick edges of a body":"pick edges of a body","pick edges of one body":"pick edges of one body","pick edges of the holes to remove":"pick edges of the holes to remove","pick faces of one body":"pick faces of one body","pick faces to offset":"pick faces to offset","pick lines of one sketch":"pick lines of one sketch","pick one or two vertices, edges or faces":"pick one or two vertices, edges or faces","pick one plane or face as the tool, or sketch curves":"pick one plane or face as the tool, or sketch curves","pick sections in two or more sketches":"pick sections in two or more sketches","pick sketch curves or edges":"pick sketch curves or edges","pick the face to untrim":"pick the face to untrim","pick the path":"pick the path","pick what to keep":"pick what to keep","pick what to keep of the other surface":"pick what to keep of the other surface","prefs.add_item":"Add the item","prefs.alt_frees_manipulators":"Alt / Option also frees manipulator arrows","prefs.anti_aliasing_amd_dx12":"Anti-aliasing uses 1× because the startup check drew nothing with multisampling and passed at 1×. You can choose another setting above; restart to apply it if the check passes.","prefs.anti_aliasing_note":"Smooths jagged edges.","prefs.applies_on_restart":"Applies on restart","prefs.assistant":"Assistant","prefs.auto_operation":"Choose the operation automatically","prefs.auto_operation_note":"Feature windows pick Join, New Body or Cut from what the new material touches, until you pick one. Off: they keep the operation they open with.","prefs.axes":"Axes","prefs.axis":"Axis","prefs.bodies_folders":"Bodies folders","prefs.bodies_folders_always":"Always","prefs.bodies_folders_never":"Never","prefs.bodies_folders_several":"Several bodies only","prefs.bottom":"Bottom","prefs.bottom_centre":"Bottom center","prefs.bottom_right":"Bottom right","prefs.browser":"Browser","prefs.browser_eye_left":"Eye next to the fold arrow","prefs.browser_eye_left_note":"Browser rows show their show/hide eye next to the fold arrow, as before, instead of in a column at the right end of the rows.","prefs.browser_reveal_on_hover":"Reveal on hover","prefs.browser_show_note":"Shown keeps the browser on screen. Reveal on hover keeps it out of sight until the pointer comes over its place or the thin tab at its left edge, and it stays open while the pointer is inside it or a menu from it is open.","prefs.browser_shown":"Shown","prefs.built_in":"Built in","prefs.button_left":"Left drag","prefs.button_middle":"Middle drag","prefs.button_right":"Right drag","prefs.choose_font":"Choose font file…","prefs.click":"Click","prefs.contact_shading":"Soft contact shading","prefs.contact_shading_note":"Soft shading where parts come close.","prefs.context_menu":"Context menu","prefs.context_menu_ring":"Context menu · hold for the radial menu","prefs.cpu":"CPU (software)","prefs.crash_reports":"Open crash reports…","prefs.crash_reports_note":"Reports are kept on this computer, with the design and commands that reproduce the problem.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Curved surfaces","prefs.curves":"Curved surfaces","prefs.dark_parts_shading":"Keep the shape of dark parts","prefs.dark_parts_shading_help":"Shade the view in linear light with a soft sky fill, so dark faces keep a gradient instead of turning black","prefs.dead_zone_note":"The hatched band is the dead zone: motion inside it is ignored.","prefs.default":"default","prefs.design":"Design defaults","prefs.design_note":"What new designs start with. Open designs keep their own.","prefs.devices":"3D mouse","prefs.dialog_buttons":"Dialog buttons","prefs.dialogs":"Dialogs","prefs.dialogs_edge":"At the view's edge","prefs.dialogs_left_column":"In the left column","prefs.dialogs_note":"Where command dialogs open: docked at the view's edge, or in the left column in place of the browser and the History, which come back as they were when the dialog closes.","prefs.display":"Display","prefs.edges":"Edges and shading","prefs.extend":"Extend","prefs.extra_navigation":"Ctrl+left drag on empty space orbits; hold Space to pan.","prefs.extrude_view_isometric":"Turn the view to isometric when Extrude opens","prefs.extrude_view_return":"Go back to the earlier view when Extrude closes","prefs.follows_os":"Follows the OS","prefs.font":"Font","prefs.font_fallback":"Glyphs the chosen font lacks fall back to the built-in font, so no label shows an empty box.","prefs.font_sample":"The quick brown fox · Ø12.50 mm · 45.0° · 0123456789","prefs.font_unreadable":"The selected font could not be read.","prefs.general":"General","prefs.general_note":"Language, saving and updates.","prefs.gesture_orbit":"Orbit","prefs.gesture_pan":"Pan","prefs.gesture_zoom":"Zoom","prefs.graphics":"Graphics","prefs.graphics_card":"Graphics card","prefs.graphics_card_auto":"Automatic","prefs.graphics_card_missing":"The saved graphics card is unavailable; Automatic is used.","prefs.graphics_card_restart":"Takes effect after restarting SolidCraft. WGPU_ADAPTER_NAME overrides this choice.","prefs.graphics_card_unused":"The saved graphics card was not used for this window; the card in use is shown in Help › About and in the status line. Try Automatic, or set WGPU_ADAPTER_NAME to a unique part of the card's name.","prefs.graphics_note":"Trade speed for smoothness. Each choice shows its effect on a sample.","prefs.graphics_presets_note":"Presets set the choices below together.","prefs.hide_constraint_glyphs_zoomed_out":"Hide constraint glyphs when zoomed out","prefs.hide_constraint_glyphs_zoomed_out_note":"Constraint glyphs leave the view when the sketch is zoomed out far enough that they would clutter it. Off: they stay at a fixed screen size at every zoom.","prefs.history":"History","prefs.history_origin_bodies":"Show origin and bodies at the top","prefs.history_origin_bodies_note":"The History on the left or under the browser starts with the active component's Bodies folder and the Origin, with their eyes and menus as in the browser. The History at the bottom is unchanged.","prefs.history_play_button":"Play History button in the History controls","prefs.history_play_button_note":"Puts Play History between Go back one step and Go forward one step in the History controls. You can also right-click the controls to show or hide it.","prefs.history_sketches":"Sketches","prefs.history_sketches_in_order":"In order","prefs.history_sketches_note":"With Sketches set to Under their feature, the History at the left lists each sketch one level in, under the first feature built from it, whenever it is wide enough for names. The timeline at the bottom always keeps the creation order.","prefs.history_sketches_under_feature":"Under their feature","prefs.hold_stop_snapping":"Hold to stop snapping","prefs.home_fit_size":"Home and Fit size","prefs.home_fit_size_note":"How much of the view the model fills when Home, Fit, an opened design or a navigator view change frames it, whether or not the setting below is on. 100 %: fills the view between the panels, the compass and the navigation bar.","prefs.icons_only":"Icons only","prefs.imported_file":"Imported file","prefs.in_browser":"In browser","prefs.input":"Input","prefs.interface":"Interface","prefs.interface_language":"Interface language","prefs.interface_note":"How SolidCraft looks and where its parts sit.","prefs.interval_minutes":"{n} min","prefs.invert_navigator_arrows":"Invert the view cube rotation arrows","prefs.invert_navigator_arrows_note":"The arrows around the cube orbit the camera the way they point, as in Fusion and Inventor: the arrow on the left points right and swings the camera right. Off: an arrow rotates the cube toward the side it sits on, so the left arrow swings the camera left. The curved roll arrows are not affected.","prefs.keep_work_on_tab_switch":"Keep dialogs and tools open when switching designs","prefs.keep_work_on_tab_switch_note":"Each design tab keeps its open dialog or tool, with what you picked and typed in it, and its toolbar tab. They are there again when you come back to the design. Off: switching designs cancels them and shows the Model tab.","prefs.labels":"Labels","prefs.language_system":"System","prefs.layout":"Layout","prefs.layout_note":"Compact docks panels to the window edges. Browser translucency is available in Floating. Change the Assistant side on the Assistant page.","prefs.left":"Left","prefs.left_click":"Left click","prefs.line_drag_draws_one":"Press and drag draws one line","prefs.line_drag_draws_one_note":"In the Line tool, pressing, dragging and letting go draws one line from the press to the release, and it ends there. Clicks still draw a chain. Off: a drag places a point where it is let go, as a click does.","prefs.line_hover_tangent_arc":"Rest on a line's last point to switch to a tangent arc","prefs.line_hover_tangent_arc_note":"In the Line tool, once a segment is drawn, move away from the chain's last point, come back and hold the pointer still on it: the next click ends a tangent arc, and the same gesture goes back to lines. Off: resting there does nothing.","prefs.linked_designs":"Linked designs","prefs.live_input":"Live input","prefs.live_preview":"Live preview","prefs.logo":"Logo","prefs.logo_accent":"Accent","prefs.logo_theme":"Theme's colors","prefs.max_file_size":"Largest file to open","prefs.max_file_size_design":"Design files","prefs.max_file_size_flag":"This run started with --max-file-size {size}, which applies until SolidCraft closes. These settings apply when it starts without it.","prefs.max_file_size_note":"Defaults: 512 MB and 256 MB; at most 16 GB. Opening a file takes several times its size in memory. A design that keeps a large import may need a higher design file limit to save and reopen.","prefs.max_file_size_step":"STEP and import files","prefs.max_file_size_web":"The web app opens STEP and import files up to 512 MB and designs up to 256 MB: a browser tab can't hold larger files. The desktop app can raise these limits.","prefs.megabytes":"MB","prefs.menu_grid":"Large icons","prefs.menu_list":"List","prefs.menus":"Menus","prefs.minutes":"minutes","prefs.minutes_suffix":" min","prefs.mouse":"Mouse and trackpad","prefs.mouse_heading":"Mouse","prefs.mouse_mapping":"Mouse mapping","prefs.navigation":"Navigation","prefs.navigation_note":"How the mouse, trackpad and 3D mouse move the view.","prefs.navigator_fit":"Fit the model after a navigator view change","prefs.navigator_fit_note":"A face, corner or arrow of the view cube, or an axis of the gizmo, also looks at the middle of the model from the one distance that fits it from every side (its bounding sphere). Home uses the same zoom and centre while this is on, so views chosen after it only turn. Off: the view turns in place, keeping its target and zoom.","prefs.network_host_remove":"Remove","prefs.network_locations":"Allow network locations in designs","prefs.network_locations_note":"Off: a design's linked files on another computer (\\\\server\\share) are opened only from the servers listed here, or after you allow one when asked.","prefs.network_locations_section":"Network locations","prefs.not_on_gpu":"not on this GPU","prefs.on":"On","prefs.opaque":"Opaque","prefs.orbit_snap":"Hold Shift during orbit to snap to an axis.","prefs.orientation":"Orientation","prefs.origin_plane_names":"Origin plane names","prefs.origin_plane_names_note":"Names shown in the browser, dialogs and lists. {top} is XY, {front} is XZ and {right} is YZ, with Z up. Commands, scripts and saved designs keep XY, XZ and YZ.","prefs.overall_speed":"Overall speed","prefs.parameter_list_rows":"Parameter list rows","prefs.parameter_list_rows_tip":"Down arrow in an empty value field lists the parameters, favourites first, up to this many. Fewer keeps the list light in a large design.","prefs.persistent_ribbon_pressed":"Highlight active ribbon commands","prefs.persistent_ribbon_pressed_help":"Highlight ribbon commands while their effects are on. Turn off to keep the previous neutral appearance and command help.","prefs.perspective_fov":"Field of view","prefs.placement":"Placement","prefs.prefer_free_sketch_points":"Prefer movable sketch points when points overlap","prefs.preview_choices":"Preview of your choices","prefs.print_face_highlight":"Print face highlight","prefs.print_face_highlight_tip":"How strongly the print face of a body is tinted and outlined in the view. 0 % shows no highlight.","prefs.profile_active":"Active profile","prefs.profile_applied":"Profile applied.","prefs.profile_changed":"Settings changed since the profile was saved. Save keeps them in it.","prefs.profile_deleted":"Profile deleted.","prefs.profile_export":"Export…","prefs.profile_exported":"Profile exported.","prefs.profile_imported":"Profile imported. Choose it under Active profile to switch to it.","prefs.profile_name_hint":"Profile name, e.g. Laptop","prefs.profile_rename":"Rename","prefs.profile_renamed":"Profile renamed.","prefs.profile_save":"Save","prefs.profile_saved":"Current settings saved to the profile.","prefs.profile_skipped":"Profile applied; {n} setting(s) kept their current value (see the log).","prefs.profiles":"Settings profiles","prefs.profiles_note":"Shortcuts, the toolbar, navigation, the radial menu and interface settings, kept together under a name and switched at once.","prefs.project_options_dialog":"Project options dialog","prefs.project_options_dialog_note":"On: choose Geometry or Bodies and Projection Link before projecting. Off: keep the previous direct-pick workflow.","prefs.quality_default":"default","prefs.quality_fastest":"fastest","prefs.quality_slowest":"slowest","prefs.quality_smoother":"smoother","prefs.quick_measure":"Quick measurement in the view's corner","prefs.quick_measure_note":"The selection's size in the view's bottom right corner: an edge's length, or Ø and R for a round one, a face's area, a point's position, two items' distance and angle, several edges' or faces' total. A click copies it.","prefs.render_previous_geometry_budget":"Use previous Render preview geometry budget","prefs.render_previous_geometry_budget_help":"Restore the previous fixed geometry limit (512 MiB on 64-bit desktop, 128 MiB elsewhere) instead of the device-based budget.","prefs.reports_saved":"{n} saved","prefs.ribbon_click_ends_tool":"Clicking the running tool's button ends it","prefs.ribbon_click_ends_tool_note":"A click on the lit ribbon button of the sketch tool in use ends the tool, so clicks in the view select again. Off: the click starts the tool again.","prefs.ribbon_reveal":"Show search results in the ribbon","prefs.ribbon_reveal_note":"Hovering a result in Search commands shows where the command sits in the ribbon: its tab, its button or its row in a panel's drop-down. A command started from the search blinks there, and a running command from a drop-down marks its panel.","prefs.right_click":"Right click","prefs.saving":"Autosave and recovery","prefs.scale_note":"Also Ctrl + / Ctrl − in the window. Buttons are 28 px at 100%.","prefs.scale_text":"Scale and text","prefs.search":"Search preferences","prefs.search_empty":"No matching preferences","prefs.select":"Select","prefs.select_one_item":"Select one item","prefs.select_other_hidden":"Select hidden geometry with Select Other","prefs.select_other_hidden_help":"On: include hidden bodies, sketches and occluded edges near the pointer. Off: use the original list of visible geometry under the pointer.","prefs.selecting":"Selecting","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift adds only; Ctrl / Cmd toggles","prefs.shift_add_note":"On: Shift adds, Ctrl / Cmd toggles. Off (default): both toggle.","prefs.shortcuts":"Shortcuts","prefs.single_surface_analysis":"Use a single surface analysis","prefs.single_surface_analysis_help":"When off, surface shading and Continuity can stay on together. Turning this on keeps the last analysis started or changed.","prefs.sketch_align_points":"Line up with other sketch points while drawing","prefs.sketch_align_points_note":"While drawing, a point lines up horizontally with one sketch point and vertically with another at the same time, with a dotted guide, and the click keeps both alignments. Off: only with the previous point, one axis at a time.","prefs.sketch_conflict_colour":"Conflicting geometry in the conflict color","prefs.sketch_conflict_colour_note":"While a sketch's constraints conflict, the curves and points a failing constraint holds are drawn in the conflict color too, not only its glyph or dimension. Off: they keep their usual colors.","prefs.sketch_construction_lines":"Extended construction line tools","prefs.sketch_exit_view":"When a sketch ends","prefs.sketch_exit_view.keep":"Keep the current view","prefs.sketch_exit_view.previous":"Return to the previous view","prefs.sketch_exit_view.unless_rotated":"Return unless rotated","prefs.sketch_exit_view_note":"Where the view goes after Finish Sketch, Cancel or a double Esc.","prefs.sketch_face_activates_part":"Sketching on a part's face makes that part active","prefs.sketch_face_activates_part_note":"A sketch started on a face of another component's body activates that component first, so the sketch belongs to it and stays with that part in the browser. The part stays active afterwards. Off: the sketch belongs to the active component.","prefs.sketch_open_look_at":"Turn to face a sketch when it opens","prefs.sketch_open_look_at_note":"Off: creating or editing a sketch leaves the view as it is. Look At faces the sketch when you want it.","prefs.sketch_recent_snap":"Auto snap to recent centers and midpoints","prefs.sketch_recent_snap_note":"While drawing, snap the cursor where the guides of the two most recent circle centers or straight-edge midpoints cross. Off: those guides stay visual and the cursor does not move.","prefs.sketch_selection":"Sketch & selection","prefs.sketch_selection_heading":"Sketch and selection","prefs.sketch_selection_note":"How sketches snap and how clicks select.","prefs.sketch_state_icons":"Sketch icons in the color of their state","prefs.sketch_state_icons_note":"In History and the browser, a sketch's icon takes the color of its state (under constrained, fully constrained or conflicting) and its tooltip names the state. Off: every sketch has the same icon.","prefs.sketch_tab_always":"Keep the Sketch tab shown","prefs.sketch_tab_always_note":"The Sketch tab stays in the ribbon, right after Model, while no sketch is open. Its drawing tools then start a sketch on the selected plane or face, or on the plane you pick next, with the tool ready in it.","prefs.sketch_tracking_guides":"Center and midpoint alignment guides","prefs.sketch_tracking_guides_note":"Hover over a circle center or straight-edge midpoint, then move horizontally or vertically to show a temporary dotted guide.","prefs.sketch_tracking_points":"Alignment guides from end points and corners while drawing","prefs.sketch_tracking_points_note":"While a drawing tool waits for a point, hovering a line or arc end, a rectangle corner or a free point shows the same temporary dotted guide as a center or midpoint. Off: only centers and midpoints.","prefs.sketching":"Sketching","prefs.snap_drawing_note":"While drawing or dragging a sketch point.","prefs.source":"Source","prefs.speed":"Speed","prefs.stand_up_note":"After a STEP or IGES file opens with Z up, offer a quarter turn about X.","prefs.stand_up_unknown":"For files from unknown programs","prefs.stand_up_unknown.ask":"Ask in a dialog","prefs.stand_up_unknown.note":"Show a note","prefs.stand_up_unknown.off":"Don't offer","prefs.stand_up_unknown_note":"How the offer is made when the file's header names no program known to save Y up. A note is shown only when the file seems to lie on its back; Ask in a dialog asks about every such file, as before.","prefs.status_bar":"Status bar","prefs.status_bar_note":"A thin bar along the window's bottom edge shows what is being edited, the open sketch's state in its color and the design's units; a click on the units changes them. The sketch's state then no longer shows in the view's corner.","prefs.status_done":"Done","prefs.status_error":"Error","prefs.status_selected":"Selected","prefs.status_warning":"Warning","prefs.structure.appearance":"Appearance","prefs.structure.appearance_note":"Colors, text and accessibility.","prefs.structure.in_profile":"In profile","prefs.structure.layout":"Layout","prefs.structure.layout_note":"Where the parts of the window sit.","prefs.structure.look":"Look","prefs.structure.measure_pointer":"Measure and pointer","prefs.structure.mouse3d":"3D mouse","prefs.structure.mouse3d_note":"SpaceMouse and SpaceNavigator.","prefs.structure.navigation_note":"Mouse and trackpad. The 3D mouse has its own page.","prefs.structure.profile":"Profile","prefs.structure.profile_edited":"Changed since saved","prefs.structure.profile_hover":"Saved in settings profiles","prefs.structure.scale_percent":"{percent}%","prefs.structure.sketch":"Sketch","prefs.structure.tools":"Tools","prefs.structure.tools_note":"How modeling tools behave.","prefs.structure.work":"Work","prefs.supersampling_brief":"Draws the view larger and filters it down: very crisp, and heavier.","prefs.tab_accent_note":"The accent follows the active tab","prefs.theme_file":"theme file","prefs.theme_file_or_paste":"file or paste","prefs.theme_follow":"Follow a theme file","prefs.theme_follow_error":"Not applied: {error}. The last good theme stays on.","prefs.theme_follow_launch":"Followed for this run only (--theme-file); reloaded whenever another tool rewrites it.","prefs.theme_follow_note":"Reloaded whenever another tool rewrites it. Choosing a theme stops following it.","prefs.theme_follow_off":"Off","prefs.theme_follow_stop":"Stop following","prefs.theme_import_hint":"Click to choose a theme file, drop one here, or press Ctrl+V (Cmd+V on a Mac) with a theme copied","prefs.theme_option_opacity":"Opacity","prefs.theme_option_opacity_help":"Adjust floating panel opacity. A readability floor protects text over viewport colors.","prefs.theme_option_tab_colours":"Tab colors","prefs.theme_option_tab_colours_help":"Use this theme’s panel and viewport colors for each ribbon tab.","prefs.theme_option_tab_fade_ms":"Tab transition","prefs.theme_option_tab_fade_ms_help":"Fade panel and viewport colors when switching tabs. Zero switches instantly.","prefs.theme_options_badge":"Options","prefs.theme_options_more":"More · {count}","prefs.theme_options_reset":"Reset","prefs.theme_options_unavailable":"Unavailable on this device","prefs.theme_paste":"Paste theme","prefs.theme_paste_none":"The clipboard holds no SolidCraft theme","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"now","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Notices","prefs.toggle_item":"Add the item, or take it out again","prefs.toolbar":"Toolbar","prefs.toolbar_tabs":"Toolbar tabs","prefs.top":"Top","prefs.trackpad_zoom_modifier":"Zoom with two-finger scroll while holding","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Hold only this key to zoom at the pointer with vertical scroll. Off keeps the existing scroll behavior.","prefs.trackpad_zoom_modifier.off":"Off","prefs.translucent":"Translucent","prefs.under_browser":"Under browser","prefs.under_cursor":"Under cursor","prefs.units_precision":"Units and precision","prefs.updates":"Updates","prefs.value_boxes_in_view":"Show values beside their handles in the view","prefs.value_boxes_in_view_tip":"A command's value (Distance, Radius…) in a box next to its handle, over the model. Off: you type it in the command window, which takes the keyboard after a pick, and nothing covers the model.","prefs.view":"View behavior","prefs.view_confirm_corner":"OK and Cancel in the view's corner","prefs.view_confirm_corner_note":"While a dialog or a sketch is open, a check and a cross at the top right of the view do what the dialog's OK and Cancel do, or finish and cancel the sketch. The view navigator moves down below them.","prefs.viewport":"Viewport","prefs.viewport_analysis_status":"Show viewport analysis status","prefs.viewport_analysis_status_help":"Show active analyses above the viewport, open their legends from each item, and use Esc to turn off the newest analysis. Turn off to restore corner legends and the previous Esc behaviour.","prefs.viewport_background":"Background","prefs.viewport_background_colour":"Color","prefs.viewport_background_theme":"Theme's gradient","prefs.viewport_section_status":"Show viewport section status","prefs.viewport_section_status_help":"Show the section setting in the viewport. Escape and the active ribbon button turn it off. Disable to keep the previous section controls.","prefs.viewport_status_details":"Live viewport details","prefs.viewport_status_details_help":"Edit active analysis and section settings in standard details cards. Disable to restore read-only analysis keys and the Section dialog.","prefs.viewport_status_summary":"Fold viewport status items","prefs.viewport_status_summary_help":"Fold three or more viewport status items into one summary badge. Disable to keep every item in the full row.","prefs.wheel":"Wheel","prefs.wheel_trackpad":"Wheel and trackpad","prefs.workspace":"Workspace","prefs.zoom_stop_at_model":"Stop zoom at the model","prefs.zoom_stop_at_model_tip":"The 3D mouse and device app zoom toward the surface in the middle of the view; drag-zoom holds the point where the drag began. Off: zoom can pass through the model. Wheel and pinch use Zoom to the cursor separately","prefs.zoom_toward_cursor":"Zoom, toward the cursor","properties.title":"Properties: {name}","recovery.days_ago":"{count} days ago","recovery.detail":"{file} · {features} features · autosaved {when}","recovery.discard_all":"Discard all","recovery.discard_all_detail":"This cannot be undone.","recovery.discard_all_title":"Discard {count} autosaves?","recovery.discard_all_title_one":"Discard 1 autosave?","recovery.hours_ago":"{count} h ago","recovery.just_now":"just now","recovery.min_ago":"{count} min ago","recovery.never_saved":"never saved","render.adaptive_absolute":"Absolute RGB error floor","render.adaptive_coverage":"Coverage error target","render.adaptive_enable":"Allocate samples with independent pilots","render.adaptive_help":"GPU only. Independent pilot samples are discarded, then allocate 16 or more production samples per pixel up to Samples per pixel. RGB and coverage variance guide allocation; rare paths may be missed and capped pixels may remain noisy. The final report counts actual work. No certified noise or time guarantee.","render.adaptive_minimum":"Minimum production samples","render.adaptive_pending":"GPU independent-pilot adaptive allocation and conditional Fresnel strata are available. Certified convergence, rare-event guarantees and CPU adaptive transport remain unavailable.","render.adaptive_pilots":"Pilot samples per pixel","render.adaptive_relative":"Relative RGB error target","render.add_ground":"Add fitted ground to setup","render.advanced_material_scope":"One finite homogeneous GPU medium is available under explicit limits. Density grids, nested glass/volume combinations, subsurface surfaces, displacement, spectral transport and unbound advanced material concepts remain unavailable.","render.aging_add":"Add aging layer","render.aging_airborne":"Airborne dust / participating medium","render.aging_airborne_help":"Airborne dust is a separate finite homogeneous scattering volume. It changes transport and raw EXR, not the surface-aging stack. Existing volume/glass/denoising restrictions remain explicit; no atmosphere is added automatically.","render.aging_all_bodies":"All eligible opaque bodies","render.aging_chips":"Chipped paint","render.aging_class_any":"All opaque material classes","render.aging_class_dielectric":"Nonmetallic surfaces only","render.aging_class_metal":"Metallic surfaces only","render.aging_color":"Layer color · sRGB","render.aging_coverage":"Coverage","render.aging_dust":"Deposited dust","render.aging_empty":"No aging layers: the original surfaces remain unchanged.","render.aging_fading":"Faded coating","render.aging_grime":"Grime & staining","render.aging_help":"Combine up to eight optical layers, in order. Rust and patina are authored appearances, not age/corrosion simulations. Scale is in world millimeters. No geometry, mass or engineering property is changed; glass and passive stages are excluded.","render.aging_metallic":"Layer metallic fraction","render.aging_origin":"Field origin · world mm","render.aging_patina":"Copper-green patina","render.aging_refresh_targets":"Inspect current bodies","render.aging_roughness":"Layer roughness","render.aging_rust":"Oxidized iron / rust","render.aging_scale":"Pattern scale","render.aging_scratches":"Fine scratches","render.aging_target":"Target & coordinates","render.aging_target_help":"A named target must still match its captured index and name. Global masks are world-anchored; they do not follow moving parts. This is neither cavity detection nor true edge wear. Filter the list to reach additional bodies.","render.aging_target_search":"Filter body names","render.aging_upward":"Upward-facing deposition","render.all_controls_help":"Dense inspection of all current controls. Section pages provide focused editing without changing the underlying request.","render.all_shots_label":"All Shots","render.appearance_editor.absorption":"Absorption","render.appearance_editor.base_colour":"Base color","render.appearance_editor.body_reason":"Optical bindings target one whole body. Pick Body to edit these controls.","render.appearance_editor.boundary":"Boundary","render.appearance_editor.box":"Box","render.appearance_editor.choose_image":"Choose image…","render.appearance_editor.closed":"Closed solid","render.appearance_editor.coat":"Clear coat","render.appearance_editor.cpu_reason":"Needs CPU ray tracing.","render.appearance_editor.glass":"Glass and absorption","render.appearance_editor.glass_enable":"Use physical glass on this body","render.appearance_editor.glass_note":"Closed glass uses geometric distance. It cannot share a body with clear coat or maps.","render.appearance_editor.gpu_reason":"Needs GPU path tracing.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Maps","render.appearance_editor.normal":"Normal","render.appearance_editor.normal_strength":"Normal strength","render.appearance_editor.origin":"Origin","render.appearance_editor.recipe":"Recipe","render.appearance_editor.reflection_sampling":"Sampling for all reflective bodies","render.appearance_editor.reflections":"Reflections","render.appearance_editor.remove":"Remove saved","render.appearance_editor.remove_note":"Remove the saved optics from this shot. Geometry and assigned looks are kept.","render.appearance_editor.remove_title":"Remove saved optics?","render.appearance_editor.replace":"Replace this body's saved optics","render.appearance_editor.revalidate":"Revalidate this body","render.appearance_editor.save":"Save these optics","render.appearance_editor.save_reason":"Saving these optics needs physical glass on a current GPU body. Coat and local image maps remain temporary.","render.appearance_editor.saved":"Saved with this shot","render.appearance_editor.saved_state":"These optics are saved with this shot.","render.appearance_editor.