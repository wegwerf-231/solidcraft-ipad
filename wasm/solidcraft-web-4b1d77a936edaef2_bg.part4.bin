n.ground_shadow":"Приказује или сакрива сенку испод модела.","navbar.description.home":"Враћа на изометријски приказ целог модела.","navbar.description.look_at":"Окреће приказ према изабраном лицу, равни или отвореној скици.","navbar.description.orbit":"Окреће приказ око модела.","navbar.description.pan":"Помера приказ у страну, горе или доле.","navbar.description.projection":"Пребацује између ортографског и перспективног приказа.","navbar.description.separator":"Танка линија која групише суседна места.","navbar.description.spin":"Окреће приказ све док не кликнете или притиснете тастер.","navbar.description.visual_style":"Мења начин исцртавања модела: осенчено, жичани модел или са скривеним ивицама.","navbar.description.zoom":"Приближава или удаљава приказ од модела.","navbar.display":"Приказ","navbar.fit":"Уклопи","navbar.graphics":"Графика","navbar.grid":"Мрежа","navbar.ground_shadow":"Сенка на подлози","navbar.home":"Почетни приказ","navbar.later":"Касније","navbar.look_at":"Погледај","navbar.more":"Више","navbar.orbit":"Орбитирање","navbar.orthographic":"Ортографски","navbar.pan":"Померање","navbar.perspective":"Перспективни","navbar.preset":"Подешавање","navbar.projection":"Пројекција","navbar.projection_heading":"Пројекција","navbar.separator":"Разделник","navbar.show":"Прикажи","navbar.spin":"Вртење","navbar.style.shaded":"Осенчено","navbar.style.shaded_with_edges":"Осенчено са ивицама","navbar.style.shaded_with_hidden_edges":"Осенчено са скривеним ивицама","navbar.style.wireframe":"Жичани модел","navbar.translucent":"Провидно","navbar.value_tip":"{name} · {value}","navbar.visual_style":"Визуелни стил","navbar.zoom":"Зумирање","needs two joints":"потребна су два споја","network.allow_once":"Дозволи једном","network.always_allow":"Увек дозволи овај сервер","network.prompt_detail":"Овај дизајн повезује датотеку на мрежној локацији {host}. Отварање се повезује са тим рачунаром и може му послати вашу Windows пријаву. Дозволите само сервере којима верујете.","network.prompt_title":"Мрежна локација","new configuration":"нова конфигурација","new parameter":"нови параметар","no hole":"нема рупе","no interference":"нема преклапања","no joint that moves yet":"још нема споја који се креће","no motion study yet":"још нема студије кретања","no picture":"нема слике","no such joint":"нема таквог споја","none":"ништа","not a move":"није померање","not a number":"није број","open a sketch first":"прво отворите скицу","parameters.apply_live":"Примени сваку измену чим напустите њено поље","parameters.apply_live_tip":"Искључено: измене чекају на Примени или У реду, а затим се дизајн једном поново гради за све њих. Откажи или Esc их одбацује.","parameters.held":"Измена на чекању за Примени: {count}","parameters.held_hint":"Мењајте изразе и јединице. Измене чекају на Примени или У реду.","parameters.held_one":"1 измена на чекању за Примени","parts.automatic_name":"аутоматски","parts.dimension.across_flats":"Отвор кључа","parts.dimension.bore":"Отвор","parts.dimension.d":"Номинални пречник","parts.dimension.head_diameter":"Пречник главе","parts.dimension.head_height":"Висина главе","parts.dimension.height":"Висина","parts.dimension.inner":"Унутрашњи пречник","parts.dimension.outer":"Спољни пречник","parts.dimension.pitch":"Корак","parts.dimension.socket":"Величина гнезда","parts.dimension.socket_depth":"Дубина гнезда","parts.dimension.thickness":"Дебљина","parts.dimension.width":"Ширина","parts.family.bearing":"Куглични лежај са дубоким жлебом (габарит)","parts.family.button_head_cap_screw":"Завртањ са полуоблом главом и унутрашњим шестоугаоником","parts.family.dowel_pin":"Паралелни клин (колчић)","parts.family.hex_bolt":"Завртањ са шестоугаоном главом","parts.family.hex_nut":"Шестоугаона навртка","parts.family.set_screw":"Завртањ без главе са унутрашњим шестоугаоником, равног врха","parts.family.socket_head_cap_screw":"Завртањ са цилиндричном главом и унутрашњим шестоугаоником","parts.family.washer":"Обична подлошка","parts.holes":"Рупе (необавезно)","parts.placement_hint":"изаберите једну или више рупа да у сваку поставите део, или У реду поставља део у исходиште","pattern.alignment_2":"Поравнање 2","pattern.alignment_hint":"Број укључује оригинал. Центар равномерно распоређује копије; Обрни бира додатну страну за парне укупне бројеве.","pattern.direction_1":"Смер 1","pattern.direction_2":"Смер 2","pattern.flip_direction":"Обрни смер","perf.click_for_details":"Кликните за детаље: график времена кадра, хистограм и шта је GPU нацртао","perf.draw_calls":"Позиви цртања","perf.line_segments":"Сегменти линија","perf.low_1":"1% најспоријих","perf.renderer":"Рендерер","perf.scene_build":"Изградња сцене","perf.triangles":"Троуглови","perf.ui_time":"Време интерфејса","perf.viewport":"Прозор приказа","perf.worst":"најгоре","pick a body or some of its faces":"изаберите тело или нека његова лица","pick a hole to seat it, or OK places it at the origin":"изаберите рупу да га поставите или га У реду поставља у исходиште","pick a planar face":"изаберите раванско лице","pick a plane or a face as the tool":"изаберите раван или лице као алат","pick a size":"изаберите величину","pick edges of a body":"изаберите ивице тела","pick edges of one body":"изаберите ивице једног тела","pick edges of the holes to remove":"изаберите ивице рупа за уклањање","pick faces of one body":"изаберите лица једног тела","pick faces to offset":"изаберите лица за одмак","pick lines of one sketch":"изаберите линије једне скице","pick one or two vertices, edges or faces":"изаберите један или два врха, ивице или лица","pick one plane or face as the tool, or sketch curves":"изаберите једну раван или лице као алат, или криве скице","pick sections in two or more sketches":"изаберите пресеке у две или више скица","pick sketch curves or edges":"изаберите криве скице или ивице","pick the face to untrim":"изаберите лице за поништавање одсецања","pick the path":"изаберите путању","pick what to keep":"изаберите шта задржати","pick what to keep of the other surface":"изаберите шта задржати од друге површи","prefs.add_item":"Додај ставку","prefs.alt_frees_manipulators":"Alt / Option такође ослобађа стрелице манипулатора","prefs.anti_aliasing_amd_dx12":"Углађивање ивица користи 1× јер почетна провера није ништа нацртала са вишеструким узорковањем, а прошла је са 1×. Изнад можете изабрати друго подешавање; поново покрените програм да га примените ако провера прође.","prefs.anti_aliasing_note":"Углађује назубљене ивице.","prefs.applies_on_restart":"Примењује се након поновног покретања","prefs.assistant":"Асистент","prefs.auto_operation":"Аутоматски изабери операцију","prefs.auto_operation_note":"Прозори операција бирају Споји, Ново тело или Одузми према томе шта нови материјал додирује, док ви не изаберете једну. Искључено: задржавају операцију са којом се отварају.","prefs.axes":"Осе","prefs.axis":"Оса","prefs.bodies_folders":"Фасцикле тела","prefs.bodies_folders_always":"Увек","prefs.bodies_folders_never":"Никад","prefs.bodies_folders_several":"Само за више тела","prefs.bottom":"Доле","prefs.bottom_centre":"Доле у средини","prefs.bottom_right":"Доле десно","prefs.browser":"Стабло модела","prefs.browser_eye_left":"Око поред стрелице за скупљање","prefs.browser_eye_left_note":"Редови стабла модела приказују око за приказивање/скривање поред стрелице за скупљање, као раније, уместо у колони на десном крају редова.","prefs.browser_reveal_on_hover":"Прикажи при преласку мишем","prefs.browser_show_note":"Приказано држи стабло модела на екрану. Прикажи при преласку мишем га скрива док показивач не дође на његово место или на танак језичак на његовој левој ивици, а остаје отворено док је показивач у њему или док је отворен мени из њега.","prefs.browser_shown":"Приказано","prefs.built_in":"Уграђено","prefs.button_left":"Превлачење левим дугметом","prefs.button_middle":"Превлачење средњим дугметом","prefs.button_right":"Превлачење десним дугметом","prefs.choose_font":"Изабери датотеку фонта…","prefs.click":"Клик","prefs.contact_shading":"Меко сенчење додира","prefs.contact_shading_note":"Меко сенчење где се делови приближавају.","prefs.context_menu":"Контекстни мени","prefs.context_menu_ring":"Контекстни мени · држите за радијални мени","prefs.cpu":"CPU (софтверски)","prefs.crash_reports":"Отвори извештаје о рушењу…","prefs.crash_reports_note":"Извештаји се чувају на овом рачунару, заједно са дизајном и командама које понављају проблем.","prefs.ctrl_cmd":"Ctrl / Cmd","prefs.curved_surfaces":"Закривљене површи","prefs.curves":"Закривљене површи","prefs.dead_zone_note":"Шрафирана трака је мртва зона: кретање унутар ње се занемарује.","prefs.default":"подразумевано","prefs.design":"Подразумевана подешавања дизајна","prefs.design_note":"Са чиме нови дизајни почињу. Отворени дизајни задржавају своје.","prefs.devices":"3D миш","prefs.dialog_buttons":"Дугмад дијалога","prefs.dialogs":"Дијалози","prefs.dialogs_edge":"Уз ивицу приказа","prefs.dialogs_left_column":"У левој колони","prefs.dialogs_note":"Где се отварају дијалози команди: усидрени уз ивицу приказа или у левој колони уместо стабла модела и временске траке, који се враћају какви су били када се дијалог затвори.","prefs.display":"Приказ","prefs.edges":"Ивице и сенчење","prefs.extend":"Продужи","prefs.extra_navigation":"Ctrl + превлачење левим дугметом по празном простору орбитира; држите размакницу за померање.","prefs.follows_os":"Прати оперативни систем","prefs.font":"Фонт","prefs.font_fallback":"Знакови који недостају изабраном фонту приказују се уграђеним фонтом, тако да ниједна ознака не приказује празан квадрат.","prefs.font_sample":"Фијуче ветар у шибљу, леди пасаже и куће иза њих и гунђа · Ø12,50 mm · 45,0° · 0123456789","prefs.font_unreadable":"Изабрани фонт није могуће прочитати.","prefs.general":"Опште","prefs.general_note":"Језик, чување и ажурирања.","prefs.gesture_orbit":"Орбитирање","prefs.gesture_pan":"Померање","prefs.gesture_zoom":"Зумирање","prefs.graphics":"Графика","prefs.graphics_card":"Графичка картица","prefs.graphics_card_auto":"Аутоматски","prefs.graphics_card_missing":"Сачувана графичка картица није доступна; користи се Аутоматски.","prefs.graphics_card_restart":"Ступа на снагу након поновног покретања SolidCraft-а. WGPU_ADAPTER_NAME има предност над овим избором.","prefs.graphics_note":"Жртвујте брзину за глаткоћу. Сваки избор показује свој учинак на примеру.","prefs.graphics_presets_note":"Унапред подешене вредности подешавају све изборе испод одједном.","prefs.hide_constraint_glyphs_zoomed_out":"Сакриј симболе ограничења када је приказ умањен","prefs.hide_constraint_glyphs_zoomed_out_note":"Симболи ограничења нестају из приказа када је скица толико умањена да би је затрпали. Искључено: остају фиксне величине на екрану при сваком зумирању.","prefs.history":"Временска трака","prefs.history_origin_bodies":"Прикажи исходиште и тела на врху","prefs.history_origin_bodies_note":"Временска трака лево или испод стабла модела почиње фасциклом Тела активне компоненте и Исходиштем, са њиховим оком и менијима као у стаблу модела. Временска трака на дну остаје непромењена.","prefs.history_play_button":"Дугме Репродукуј временску траку у контролама временске траке","prefs.history_play_button_note":"Поставља Репродукуј временску траку између Иди један корак уназад и Иди један корак унапред у контролама временске траке. Можете и десним кликом на контроле да га прикажете или сакријете.","prefs.history_sketches":"Скице","prefs.history_sketches_in_order":"По редоследу","prefs.history_sketches_note":"Када је Скице подешено на Испод своје операције, временска трака лево приказује сваку скицу један ниво увучено, испод прве операције направљене из ње, кад год је довољно широка за називе. Временска трака на дну увек задржава редослед настанка.","prefs.history_sketches_under_feature":"Испод своје операције","prefs.hold_stop_snapping":"Држите да искључите привлачење","prefs.icons_only":"Само иконе","prefs.imported_file":"Увезена датотека","prefs.in_browser":"У стаблу модела","prefs.input":"Унос","prefs.interface":"Интерфејс","prefs.interface_language":"Језик интерфејса","prefs.interface_note":"Како SolidCraft изгледа и где су његови делови.","prefs.interval_minutes":"{n} min","prefs.labels":"Ознаке","prefs.layout":"Распоред","prefs.layout_note":"Компактно причвршћује панеле уз ивице прозора. Провидност стабла модела доступна је у опцији Плутајуће. Страну Асистента промените на страници Асистент.","prefs.left":"Лево","prefs.left_click":"Леви клик","prefs.line_drag_draws_one":"Притисак и превлачење цртају једну линију","prefs.line_drag_draws_one_note":"У алату Линија, притисак, превлачење и пуштање цртају једну линију од места притиска до места пуштања и ту се завршава. Кликови и даље цртају ланац. Искључено: превлачење поставља тачку где се пусти, као и клик.","prefs.linked_designs":"Повезани дизајни","prefs.live_input":"Улаз уживо","prefs.live_preview":"Преглед уживо","prefs.logo":"Логотип","prefs.logo_accent":"Акценат","prefs.logo_theme":"Боје теме","prefs.max_file_size":"Највећа датотека за отварање","prefs.max_file_size_design":"Датотеке дизајна","prefs.max_file_size_flag":"Ово покретање је започето са --max-file-size {size}, што важи док се SolidCraft не затвори. Ова подешавања важе када се покрене без тога.","prefs.max_file_size_note":"Подразумевано: 512 MB и 256 MB; највише 16 GB. Отварање датотеке заузима у меморији неколико пута њену величину. Дизајн који садржи велики увоз може захтевати већу границу за датотеке дизајна да би се сачувао и поново отворио.","prefs.max_file_size_step":"STEP и датотеке за увоз","prefs.max_file_size_web":"Веб апликација отвара STEP и датотеке за увоз до 512 MB и дизајне до 256 MB: картица прегледача не може да садржи веће датотеке. Десктоп апликација може да повећа ова ограничења.","prefs.megabytes":"MB","prefs.menu_grid":"Велике иконе","prefs.menu_list":"Списак","prefs.menus":"Менији","prefs.minutes":"минута","prefs.minutes_suffix":" min","prefs.mouse":"Миш и додирна табла","prefs.mouse_heading":"Миш","prefs.mouse_mapping":"Мапирање миша","prefs.navigation":"Навигација","prefs.navigation_note":"Како миш, додирна табла и 3D миш померају приказ.","prefs.network_host_remove":"Уклони","prefs.network_locations":"Дозволи мрежне локације у дизајнима","prefs.network_locations_note":"Искључено: повезане датотеке дизајна на другом рачунару (\\\\server\\share) отварају се само са сервера наведених овде или након што га дозволите када се то затражи.","prefs.network_locations_section":"Мрежне локације","prefs.not_on_gpu":"није доступно на овом GPU-у","prefs.on":"Укључено","prefs.opaque":"Непрозирно","prefs.orbit_snap":"Држите Shift током орбитирања за привлачење на осу.","prefs.orientation":"Оријентација","prefs.origin_plane_names":"Називи равни исходишта","prefs.origin_plane_names_note":"Називи приказани у стаблу модела, дијалозима и листама. {top} је XY, {front} је XZ, а {right} је YZ, са Z нагоре. Команде, скрипте и сачувани дизајни задржавају XY, XZ и YZ.","prefs.overall_speed":"Укупна брзина","prefs.parameter_list_rows":"Редови на списку параметара","prefs.parameter_list_rows_tip":"Стрелица надоле у празном пољу вредности наводи параметре, прво омиљене, до овог броја. Мањи број држи списак лаким у великом дизајну.","prefs.persistent_ribbon_pressed":"Истакни активне команде на траци","prefs.persistent_ribbon_pressed_help":"Истиче команде на траци док су њихови ефекти укључени. Искључите да бисте задржали претходни неутрални изглед и помоћ за команде.","prefs.perspective_fov":"Видно поље","prefs.placement":"Постављање","prefs.prefer_free_sketch_points":"Дај предност покретним тачкама скице када се тачке преклапају","prefs.preview_choices":"Преглед ваших избора","prefs.print_face_highlight":"Истицање површине за штампу","prefs.print_face_highlight_tip":"Колико се јако површина за штампу тела боји и обрубљује у приказу. 0 % не приказује истицање.","prefs.profile_active":"Активни профил","prefs.profile_applied":"Профил је примењен.","prefs.profile_changed":"Подешавања су промењена откако је профил сачуван. Притисните Сачувај да их задржите у њему.","prefs.profile_deleted":"Профил је избрисан.","prefs.profile_export":"Извези…","prefs.profile_exported":"Профил је извезен.","prefs.profile_imported":"Профил је увезен. Изаберите га под Активни профил да бисте прешли на њега.","prefs.profile_name_hint":"Назив профила, нпр. Лаптоп","prefs.profile_rename":"Преименуј","prefs.profile_renamed":"Профил је преименован.","prefs.profile_save":"Сачувај","prefs.profile_saved":"Тренутна подешавања су сачувана у профил.","prefs.profile_skipped":"Профил је примењен; подешавања која су задржала тренутну вредност: {n} (погледајте дневник).","prefs.profiles":"Профили подешавања","prefs.profiles_note":"Пречице, трака са алатима, навигација, радијални мени и подешавања интерфејса, чувани заједно под једним називом и мењани одједном.","prefs.project_options_dialog":"Дијалог опција за Пројектуј","prefs.project_options_dialog_note":"Укључено: пре пројектовања изаберите Геометрија или Тела и Веза пројекције. Искључено: задржава се претходни начин рада са директним избором.","prefs.quality_default":"подразумевано","prefs.quality_fastest":"најбрже","prefs.quality_slowest":"најспорије","prefs.quality_smoother":"глађе","prefs.quick_measure":"Брзо мерење у углу приказа","prefs.quick_measure_note":"Величина избора у доњем десном углу приказа: дужина ивице, или Ø и R за округлу, површина лица, положај тачке, растојање и угао две ставке, збир неколико ивица или лица. Клик га копира.","prefs.render_previous_geometry_budget":"Користи претходни буџет геометрије за преглед у Рендеровању","prefs.render_previous_geometry_budget_help":"Враћа претходно фиксно ограничење геометрије (512 MiB на 64-битним десктоп рачунарима, 128 MiB другде) уместо буџета према уређају.","prefs.reports_saved":"Сачувано: {n}","prefs.ribbon_reveal":"Прикажи резултате претраге на траци","prefs.ribbon_reveal_note":"Задржавање показивача изнад резултата у Претражи команде показује где се команда налази на траци: њену картицу, њено дугме или њен ред у падајућем менију панела. Команда покренута из претраге тамо трепери, а покренута команда из падајућег менија означава свој панел.","prefs.right_click":"Десни клик","prefs.saving":"Аутоматско чување и опоравак","prefs.scale_note":"Такође Ctrl + / Ctrl − у прозору. Дугмад су 28 px при 100%.","prefs.scale_text":"Размера и текст","prefs.search":"Претражи подешавања","prefs.search_empty":"Нема одговарајућих подешавања","prefs.select":"Избор","prefs.select_one_item":"Изабери једну ставку","prefs.select_other_hidden":"Изабери скривену геометрију помоћу Изабери друго","prefs.select_other_hidden_help":"Укључено: обухвата скривена тела, скице и заклоњене ивице у близини показивача. Искључено: користи се изворни списак видљиве геометрије испод показивача.","prefs.selecting":"Бирање","prefs.shift":"Shift","prefs.shift_add_ctrl_toggle":"Shift само додаје; Ctrl / Cmd укључује и искључује","prefs.shift_add_note":"Укључено: Shift додаје, Ctrl / Cmd укључује и искључује. Искључено (подразумевано): оба укључују и искључују.","prefs.shortcuts":"Пречице","prefs.single_surface_analysis":"Користи само једну анализу површи","prefs.single_surface_analysis_help":"Када је искључено, сенчење површи и Континуитет могу остати укључени заједно. Када је укључено, остаје последња покренута или промењена анализа.","prefs.sketch_align_points":"Поравнај са другим тачкама скице током цртања","prefs.sketch_align_points_note":"Током цртања тачка се истовремено поравнава хоризонтално са једном тачком скице и вертикално са другом, уз тачкасти водич, а клик задржава оба поравнања. Искључено: само са претходном тачком, по једна оса.","prefs.sketch_conflict_colour":"Геометрија у сукобу у боји сукоба","prefs.sketch_conflict_colour_note":"Док су ограничења скице у сукобу, криве и тачке које држи ограничење које не успева исцртавају се такође у боји сукоба, а не само његов симбол или кота. Искључено: задржавају уобичајене боје.","prefs.sketch_construction_lines":"Проширени алати за помоћне праве","prefs.sketch_exit_view":"Када се скица заврши","prefs.sketch_exit_view.keep":"Задржи тренутни приказ","prefs.sketch_exit_view.previous":"Врати се на претходни приказ","prefs.sketch_exit_view.unless_rotated":"Врати се осим ако је ротирано","prefs.sketch_exit_view_note":"Куда приказ иде након Заврши скицу, Откажи или двоструког Esc.","prefs.sketch_open_look_at":"Окрени камеру према скици када се отвори","prefs.sketch_open_look_at_note":"Искључено: када направите или измените скицу, приказ остаје онакав какав јесте. Погледај окреће приказ према скици када то желите.","prefs.sketch_recent_snap":"Аутоматски привлачи на недавне центре и средишње тачке","prefs.sketch_recent_snap_note":"Током цртања показивач се привлачи тамо где се секу водичи двају последњих центара кругова или средишњих тачака правих ивица. Искључено: ти водичи служе само за приказ и показивач се не помера.","prefs.sketch_selection":"Скица и избор","prefs.sketch_selection_heading":"Скица и избор","prefs.sketch_selection_note":"Како се скице привлаче и како кликови бирају.","prefs.sketch_state_icons":"Иконе скица у боји њиховог стања","prefs.sketch_state_icons_note":"У временској траци и стаблу модела икона скице добија боју њеног стања (недовољно ограничена, потпуно ограничена или у сукобу), а њен опис при преласку мишем наводи стање. Искључено: свака скица има исту икону.","prefs.sketch_tab_always":"Увек прикажи картицу Скица","prefs.sketch_tab_always_note":"Картица Скица остаје на траци, одмах после картице Модел, док ниједна скица није отворена. Њени алати за цртање тада започињу скицу на изабраној равни или лицу, или на равни коју следећу изаберете, са спремним алатом у њој.","prefs.sketch_tracking_guides":"Водичи за поравнање центра и средишње тачке","prefs.sketch_tracking_guides_note":"Задржите показивач изнад центра круга или средишта праве ивице, па се померите хоризонтално или вертикално да би се приказао привремени тачкасти водич.","prefs.sketch_tracking_points":"Водичи за поравнање од крајњих тачака и углова током цртања","prefs.sketch_tracking_points_note":"Док алат за цртање чека на тачку, задржавање показивача изнад краја линије или лука, угла правоугаоника или слободне тачке приказује исти привремени тачкасти водич као код центра или средишње тачке. Искључено: само центри и средишње тачке.","prefs.sketching":"Скицирање","prefs.snap_drawing_note":"Током цртања или превлачења тачке скице.","prefs.source":"Извор","prefs.speed":"Брзина","prefs.stand_up_note":"Након што се STEP или IGES датотека отвори са Z нагоре, понуди четвртину окрета око X.","prefs.stand_up_unknown":"За датотеке из непознатих програма","prefs.stand_up_unknown.ask":"Питај у дијалогу","prefs.stand_up_unknown.note":"Прикажи напомену","prefs.stand_up_unknown.off":"Не нуди","prefs.stand_up_unknown_note":"Како се понуда даје када заглавље датотеке не наводи ниједан програм за који се зна да чува Y нагоре. Напомена се приказује само када изгледа да датотека лежи на леђима; Питај у дијалогу пита за сваку такву датотеку, као и раније.","prefs.status_bar":"Статусна трака","prefs.status_bar_note":"Уска трака уз доњу ивицу прозора приказује шта се мења, стање отворене скице у њеној боји и јединице дизајна; клик на јединице их мења. Стање скице се тада више не приказује у углу приказа.","prefs.status_done":"Готово","prefs.status_error":"Грешка","prefs.status_selected":"Изабрано","prefs.status_warning":"Упозорење","prefs.supersampling_brief":"Исцртава приказ већим и смањује га филтрирањем: веома оштро и захтевније.","prefs.tab_accent_note":"Нагласна боја прати активну картицу","prefs.theme_file":"датотека теме","prefs.theme_file_or_paste":"датотека или налепљивање","prefs.theme_follow":"Прати датотеку теме","prefs.theme_follow_error":"Није примењено: {error}. Последња исправна тема остаје укључена.","prefs.theme_follow_launch":"Прати се само за ово покретање (--theme-file); поново се учитава кад год је други алат препише.","prefs.theme_follow_note":"Поново се учитава кад год је други алат препише. Избор теме прекида праћење.","prefs.theme_follow_off":"Искључено","prefs.theme_follow_stop":"Престани да пратиш","prefs.theme_import_hint":"Кликните да изаберете датотеку теме, превуците је овде или притисните Ctrl+V (Cmd+V на Mac рачунару) када је тема копирана","prefs.theme_option_opacity":"Непрозирност","prefs.theme_option_opacity_help":"Подесите непрозирност плутајућих панела. Доња граница читљивости штити текст преко боја прозора приказа.","prefs.theme_option_tab_colours":"Боје картица","prefs.theme_option_tab_colours_help":"Користи боје панела и прозора приказа ове теме за сваку картицу на траци.","prefs.theme_option_tab_fade_ms":"Прелаз између картица","prefs.theme_option_tab_fade_ms_help":"Постепено мења боје панела и прозора приказа при промени картице. Нула прелази одмах.","prefs.theme_options_badge":"Опције","prefs.theme_options_more":"Више · {count}","prefs.theme_options_reset":"Ресетуј","prefs.theme_options_unavailable":"Није доступно на овом уређају","prefs.theme_paste":"Налепи тему","prefs.theme_paste_none":"Клипборд не садржи SolidCraft тему","prefs.timeline_half_hour":"−30 min","prefs.timeline_now":"сада","prefs.timeline_quarter_hour":"−15","prefs.toast_place":"Обавештења","prefs.toggle_item":"Додај ставку или је поново уклони","prefs.toolbar":"Трака са алатима","prefs.toolbar_tabs":"Картице траке са алатима","prefs.top":"Горе","prefs.trackpad_zoom_modifier":"Зумирај скроловањем са два прста док држите","prefs.trackpad_zoom_modifier.alt":"⌥ / Alt","prefs.trackpad_zoom_modifier.cmd":"⌘","prefs.trackpad_zoom_modifier.ctrl":"Ctrl","prefs.trackpad_zoom_modifier.help":"Држите само овај тастер да зумирате према показивачу вертикалним скроловањем. Искључено задржава постојеће понашање скроловања.","prefs.trackpad_zoom_modifier.off":"Искључено","prefs.translucent":"Провидно","prefs.under_browser":"Испод стабла модела","prefs.under_cursor":"Испод показивача","prefs.units_precision":"Јединице и прецизност","prefs.updates":"Ажурирања","prefs.value_boxes_in_view":"Прикажи вредности поред њихових ручица у приказу","prefs.value_boxes_in_view_tip":"Вредност команде (Растојање, Полупречник…) у пољу поред њене ручице, преко модела. Искључено: уносите је у прозору команде, који преузима тастатуру након избора, а ништа не прекрива модел.","prefs.view":"Понашање приказа","prefs.view_confirm_corner":"У реду и Откажи у углу приказа","prefs.view_confirm_corner_note":"Док је отворен дијалог или скица, квачица и крстић горе десно у приказу раде исто што и дугмад У реду и Откажи у дијалогу, односно завршавају и отказују скицу. Навигатор приказа помера се испод њих.","prefs.viewport":"Прозор приказа","prefs.viewport_analysis_status":"Прикажи статус анализе у прозору приказа","prefs.viewport_analysis_status_help":"Приказује активне анализе изнад прозора приказа, отвара њихове легенде из сваке ставке, а тастер Esc искључује најновију анализу. Искључите да бисте вратили легенде у угловима и претходно понашање тастера Esc.","prefs.viewport_background":"Позадина","prefs.viewport_background_colour":"Боја","prefs.viewport_background_theme":"Градијент теме","prefs.viewport_section_status":"Прикажи статус пресека у прозору приказа","prefs.viewport_section_status_help":"Приказује подешавање пресека у прозору приказа. Esc и активно дугме на траци га искључују. Искључите да задржите претходне контроле пресека.","prefs.viewport_status_details":"Детаљи прозора приказа уживо","prefs.viewport_status_details_help":"Мењајте подешавања активне анализе и пресека у стандардним картицама са детаљима. Искључите да вратите легенде анализе само за читање и дијалог Пресек.","prefs.viewport_status_summary":"Сажми ставке статуса у прозору приказа","prefs.viewport_status_summary_help":"Сажима три или више ставки статуса у прозору приказа у једну збирну значку. Искључите да свака ставка остане у пуном реду.","prefs.wheel":"Точкић","prefs.wheel_trackpad":"Точкић и додирна табла","prefs.workspace":"Радни простор","prefs.zoom_stop_at_model":"Заустави зумирање на моделу","prefs.zoom_stop_at_model_tip":"3D миш и апликација уређаја зумирају према површини у средини приказа; зумирање превлачењем држи тачку где је превлачење почело. Искључено: зумирање може да прође кроз модел. Точкић и штипање засебно користе Зумирање према показивачу","prefs.zoom_toward_cursor":"Зумирање према показивачу","properties.title":"Својства: {name}","recovery.days_ago":"пре {count} дана","recovery.detail":"{file} · операција: {features} · аутоматски сачувано {when}","recovery.discard_all":"Одбаци све","recovery.discard_all_detail":"Ово се не може поништити.","recovery.discard_all_title":"Одбацити аутоматска чувања ({count})?","recovery.discard_all_title_one":"Одбацити 1 аутоматско чување?","recovery.hours_ago":"пре {count} h","recovery.just_now":"управо сада","recovery.min_ago":"пре {count} min","recovery.never_saved":"никад сачувано","render.adaptive_absolute":"Апсолутни доњи праг RGB грешке","render.adaptive_coverage":"Циљана грешка покривености","render.adaptive_enable":"Расподели узорке са независним пробним узорцима","render.adaptive_help":"Само GPU. Независни пробни узорци се одбацују, а затим се додељује 16 или више продукцијских узорака по пикселу, до вредности Узорака по пикселу. Варијанса RGB-а и покривености усмерава расподелу; ретке путање могу бити пропуштене, а ограничени пиксели могу остати шумовити. Завршни извештај броји стварни рад. Нема потврђене гаранције за шум или време.","render.adaptive_minimum":"Минимални број продукцијских узорака","render.adaptive_pending":"Доступни су GPU адаптивна расподела са независним пробним узорцима и условни Fresnel-ови слојеви. Потврђена конвергенција, гаранције за ретке догађаје и CPU адаптивни транспорт и даље нису доступни.","render.adaptive_pilots":"Пробни узорци по пикселу","render.adaptive_relative":"Циљана релативна RGB грешка","render.add_ground":"Додај прилагођену подлогу у подешавање","render.advanced_material_scope":"Доступан је један коначан хомогени GPU медијум уз изричита ограничења. Мреже густине, угнежђене комбинације стакла и запремине, потповршинско расејање, помак површине, спектрални транспорт и невезани напредни концепти материјала и даље нису доступни.","render.aging_add":"Додај слој старења","render.aging_airborne":"Прашина у ваздуху / медијум који учествује","render.aging_airborne_help":"Прашина у ваздуху је засебна коначна хомогена запремина расејања. Мења транспорт светлости и сирови EXR, а не низ слојева старења површине. Постојећа ограничења за запремину, стакло и уклањање шума остају изричита; атмосфера се не додаје аутоматски.","render.aging_all_bodies":"Сва прикладна непрозирна тела","render.aging_chips":"Ољуштена боја","render.aging_class_any":"Све класе непрозирних материјала","render.aging_class_dielectric":"Само неметалне површине","render.aging_class_metal":"Само металне површине","render.aging_color":"Боја слоја · sRGB","render.aging_coverage":"Покривеност","render.aging_dust":"Наталожена прашина","render.aging_empty":"Нема слојева старења: изворне површине остају непромењене.","render.aging_fading":"Избледели премаз","render.aging_grime":"Прљавштина и мрље","render.aging_help":"Комбинујте до осам оптичких слојева, редом. Рђа и патина су ауторски изгледи, а не симулације старења или корозије. Размера је у светским милиметрима. Не мењају се геометрија, маса нити инжењерска својства; стакло и пасивне сцене су искључени.","render.aging_metallic":"Метални удео слоја","render.aging_origin":"Исходиште поља · светски mm","render.aging_patina":"Бакарнозелена патина","render.aging_refresh_targets":"Прегледај тренутна тела","render.aging_roughness":"Храпавост слоја","render.aging_rust":"Оксидисано гвожђе / рђа","render.aging_scale":"Размера узорка","render.aging_scratches":"Фине огреботине","render.aging_target":"Циљ и координате","render.aging_target_help":"Именовани циљ и даље мора одговарати забележеном индексу и називу. Глобалне маске су везане за свет; не прате покретне делове. Ово није ни откривање шупљина ни стварно трошење ивица. Филтрирајте списак да бисте дошли до додатних тела.","render.aging_target_search":"Филтрирај називе тела","render.aging_upward":"Таложење на површинама окренутим нагоре","render.all_controls_help":"Детаљан преглед свих тренутних контрола. Странице одељака омогућавају усмерено уређивање без мењања основног захтева.","render.all_shots_label":"Сви кадрови","render.appearance_editor.absorption":"Апсорпција","render.appearance_editor.base_colour":"Основна боја","render.appearance_editor.body_reason":"Оптичке везе се односе на једно цело тело. Изаберите Тело да бисте мењали ове контроле.","render.appearance_editor.boundary":"Граница","render.appearance_editor.box":"Кутија","render.appearance_editor.choose_image":"Изабери слику…","render.appearance_editor.closed":"Затворено пуно тело","render.appearance_editor.coat":"Прозирни лак","render.appearance_editor.cpu_reason":"Потребно је CPU праћење зрака.","render.appearance_editor.glass":"Стакло и апсорпција","render.appearance_editor.glass_enable":"Користи физичко стакло на овом телу","render.appearance_editor.glass_note":"Затворено стакло користи геометријско растојање. Не може делити тело са прозирним лаком или мапама.","render.appearance_editor.gpu_reason":"Потребно је GPU праћење путање.","render.appearance_editor.ior":"IOR","render.appearance_editor.maps":"Мапе","render.appearance_editor.normal":"Нормала","render.appearance_editor.normal_strength":"Јачина нормале","render.appearance_editor.origin":"Исходиште","render.appearance_editor.recipe":"Рецепт","render.appearance_editor.reflection_sampling":"Узорковање за сва рефлектујућа тела","render.appearance_editor.reflections":"Рефлексије","render.appearance_editor.remove":"Уклони сачувано","render.appearance_editor.remove_note":"Уклоните сачувану оптику из овог кадра. Геометрија и додељени изгледи се задржавају.","render.appearance_editor.remove_title":"Уклонити сачувану оптику?","render.appearance_editor.replace":"Замени сачувану оптику овог тела","render.appearance_editor.revalidate":"Поново провери ово тело","render.appearance_editor.save":"Сачувај ову оптику","render.appearance_editor.save_reason":"Чување ове оптике захтева физичко стакло на тренутном GPU телу. Лак и локалне мапе слика остају привремени.","render.appearance_editor.saved":"Сачувано са овим кадром","render.appearance_editor.saved_state":"Ова оптика је сачувана са овим кадром.","render.appearance_editor.scatter_reason":"Унутрашње расејање захтева затворену границу пуног тела.","render.appearance_editor.temporary":"Ова оптика је привремена на овој картици. Сачувајте је да остане уз кадар.","render.appearance_editor.thickness":"Дебљина","render.appearance_editor.thickness_reason":"Дебљина се примењује на танке листове; затворено стакло користи геометријско растојање.","render.appearance_editor.thin":"Танак лист","render.appearance_editor.u_repeat":"U понављање","render.appearance_editor.v_repeat":"V понављање","render.appearance_editor.v_up":"V оса текстуре је усмерена нагоре","render.appearance_editor.weight":"Тежина","render.appearance_physics_separate":"Визуелни изглед не додељује густину, топлотне податке нити друга инжењерска својства.","render.appearances":"Изгледи","render.assign_help":"Кликните да примените на избор; превуците за преглед и пустите, или кликните без избора да бојите.","render.availability_native":"Изворни састав; прегледајте пре примене","render.availability_projection":"Подржана пројекција; погледајте опсег и изоставке","render.availability_reference":"Референтни подаци; није аутоматска додела","render.backdrop_alpha_conflict":"Изаберите ову позадину или провидни PNG излаз; рендерер неће тихо занемарити ниједно од та два подешавања.","render.backdrop_enable":"Користи градијентну позадину само за камеру","render.backdrop_first":"Почетна / средишња боја","render.backdrop_help":"Ова позадина у простору екрана не осветљава, не баца сенке, не рефлектује и не представља терен. Искључена је из сировог EXR-а. Геометрија, светла и HDR окружење остају независни.","render.backdrop_horizontal":"Хоризонтални градијент","render.backdrop_radial":"Радијални градијент","render.backdrop_radius":"Полупречник","render.backdrop_second":"Крајња / рубна боја","render.backdrop_vertical":"Вертикални градијент","render.backdrop_x":"Центар X","render.backdrop_y":"Центар Y","render.background":"Позадина сцене","render.background_camera_section":"Позадина камере · PNG приказ","render.background_completed_frozen":"Приказани резултат је замрзнута завршена слика. Измена позадине не исцртава тај резултат поново аутоматски. Користите Поновна градација за промене само на камери или Рендеруј за нову физичку сцену.","render.background_hdr_separate":"Тренутни HDR ресурси осветљавају површине и рефлектују се на њима; не приказују се аутоматски као панорама иза предмета. Промена градијента не ротира и не мења боју осветљења.","render.background_lighting_section":"HDR осветљење · одвојено од позадине камере","render.background_no_alpha_override":"Позадина камере не додаје се тихо провидном излазу. Поновна градација сировог мастера користи забележену покривеност и не примењује поново уклањање шума; изворни EXR остаје непромењен.","render.background_not_light":"Боја позадине служи за приказ, а не као додатни извор светла.","render.background_regrade":"Примени на задржани сирови мастер","render.background_stage_occlusion":"Овај кадар укључује геометрију физичке сцене. Велики под или зид може да испуни кадар и сакрије позадину само за камеру. Намерно очистите сцену или јој промените величину или промените њену физичку рефлексију. Поновна градација не може да уклони забележену геометрију.","render.background_workflow":"Изаберите позадину коју желите: боју или градијент само за камеру, физичку сцену која прима светло или HDR осветљење. Међусобно су независни. Преглед уживо је приказ за моделовање; рендерујте нову слику или поново градирајте задржани мастер да видите завршну обраду камере.","render.base_appearance":"Изглед тела који се може мењати","render.base_apply":"Примени изглед тела","render.base_apply_help":"Једна визуелна додела која се може поништити, за тачно прегледано тело. Постојећи изгледи појединих лица и инжењерски материјали остају одвојени.","render.base_color":"Основна боја · sRGB","render.base_metallic":"Метални удео","render.base_opaque_only":"Овај уређивач чува семантику непрозирних тела. За оптичко пропуштање користите изричите контроле стакла.","render.bloom_enable":"Сјај приказа","render.bloom_help":"Креативни сјај само на излазу из позитивних линеарних светлих делова, раширен кроз три нормализована пролаза кутијастог филтера. Полупречник је у пикселима излаза. Додаје се у линеарној светлости приказа пре sRGB-а; није објектив, волуметријски ефекат нити побољшање конвергенције. Сирови EXR остаје непромењен.","render.bloom_opaque":"Сјај захтева непрозирни излаз. Провидни PNG се одбија, а не спљоштава тихо.","render.bloom_radius":"Полупречник сјаја","render.bloom_strength":"Јачина сјаја","render.bloom_threshold":"Праг линеарних светлих делова","render.browse_capabilities":"Прегледај комплетан каталог могућности","render.browse_environments":"Прегледај изворна HDR окружења","render.browse_looks":"Прегледај…","render.browse_native_scenes":"Прегледај изворне студије","render.browse_physical":"Прегледај физичке референце","render.browse_quality":"Прегледај спецификације квалитета","render.browse_rigs":"Прегледај ауторске поставе светала","render.browse_scene_specs":"Прегледај напредне спецификације сцене","render.browse_surfaces":"Прегледај ауторске површине","render.browser_library":"Библиотека","render.browser_model":"Модел","render.camera_distance":"Растојање од ока до циља","render.camera_exact_help":"Светски милиметри; углови се приказују у степенима, а чувају у радијанима. Навигација користи исту камеру као прозор приказа.","render.camera_fov":"Вертикално видно поље","render.camera_pitch":"Нагиб камере","render.camera_roll":"Ваљање","render.camera_set":"Постави камеру рендеровања","render.camera_target":"Положај циља · mm","render.camera_yaw":"Скретање","render.category_metal":"Метал","render.category_paint":"Фарба","render.category_plastic":"Пластика","render.category_wood":"Дрво","render.check_opaque":"Провидност: само непрозирне површине; алфа позадине је подржана.","render.check_sorted_alpha":"Провидност: апроксимација сортираном алфом.","render.check_transmission":"Провидност: физичко пропуштање.","render.children.absolute_floor":"Апсолутни доњи праг","render.children.adaptive":"Адаптивно","render.children.add_look_reason":"Додајте изглед да бисте мењали да ли је омогућен и његову јачину.","render.children.all_shots":"Сви кадрови","render.children.bloom":"Сјај","render.children.check":"Провера","render.children.check_now":"Провери сада","render.children.chromatic":"Хроматски помак","render.children.compact":"Компактно","render.children.contrast":"Контраст","render.children.copy_image":"Копирај","render.children.copy_job":"Копирај JSON посла","render.children.copy_request":"Копирај JSON захтева","render.children.coverage_error":"Грешка покривености","render.children.cpu":"CPU праћење зрака","render.children.denoise":"Смањи шум на завршеној слици","render.children.depth":"Дубина путање","render.children.distortion":"Изобличење","render.children.edge_samples":"Узорци ивица","render.children.effects_banner":"Ови ефекти захтевају GPU праћење путања. Отварање овога никад не мења методу.","render.children.enable_adaptive":"Омогућите независне пробне узорке да бисте мењали адаптивне границе.","render.children.enable_bloom":"Омогућите сјај да бисте мењали његову јачину, праг и полупречник.","render.children.finishing":"Завршна обрада","render.children.flare":"Одсјај","render.children.fresnel":"Fresnel-ови слојеви","render.children.ghosts":"Духови прстенова","render.children.glass":"Пренос кроз стакло","render.children.go_to":"Иди на {editor}","render.children.grain":"Зрно","render.children.halo":"Ореол","render.children.hdr":"HDR","render.children.keep_master":"Задржи сирови линеарни мастер","render.children.last_result":"Последњи: {number} · {width} × {height} · {phase}","render.children.lens_effects":"Ефекти објектива","render.children.look_summary":"{tone} · изгледи: {count}","render.children.looks":"Креативни изгледи","render.children.memory":"Меморија","render.children.method":"Метода","render.children.minimum":"Минимум","render.children.needs_cpu":"Потребно је CPU праћење зрака. Отварање овога никад не мења методу.","render.children.nested":"Потврђени угнежђени диелектрици","render.children.not_checked":"Није проверено","render.children.path":"Праћење путања","render.children.pilots":"Пробни узорци","render.children.preview":"Подаци прегледа","render.children.progressive_reason":"Изаберите Прогресивно да бисте мењали број узорака и семе.","render.children.radius":"Полупречник","render.children.reflect_depth":"Дубина рефлексије","render.children.reflect_samples":"Узорци рефлексије","render.children.regrade":"Поновна градација","render.children.relative_error":"Релативна грешка","render.children.render":"Рендеровање","render.children.render_shot":"Рендеруј кадар","render.children.renderer":"Рендерер","render.children.renderers":"Рендерери","render.children.request":"Овај захтев","render.children.reset_finishing":"Ресетуј завршну обраду","render.children.review_quality":"Прегледај спецификацију квалитета…","render.children.rgb_gain":"RGB појачање","render.children.samples":"Узорци","render.children.sampling":"Узорковање","render.children.saturation":"Засићеност","render.children.scene_summary":"тела: {bodies} · троуглови: {triangles}","render.children.seed":"Семе","render.children.sharpening":"Изоштравање","render.children.single_image":"Једна слика","render.children.soft_focus":"Меки фокус","render.children.streak":"Пруга","render.children.strength":"Јачина","render.children.studio":"Студио","render.children.threshold":"Праг","render.children.tone":"Тон","render.children.under_hood":"Испод хаубе","render.children.vignette":"Вињета","render.children.workstation":"Радна станица","render.choose_look":"Прво изаберите изглед у Изгледима","render.chromatic_offset":"Хроматски помак ивица","render.clear_stage":"Уклони сачувану сцену","render.copy_request":"Копирај JSON","render.cpu_aa_help":"Просторни узорци: више узорака побољшава ивице и продужава рендеровање.","render.cpu_area_add":"Додај правоугаоно CPU светло","render.cpu_area_editor":"Правоугаона CPU светла","render.cpu_area_editor_help":"Пуни вектори страница у милиметрима; U × V показује према страни која емитује. Ово се разликује од GPU вектора полуивица.","render.cpu_area_full_u":"Пуна страница U · mm","render.cpu_area_full_v":"Пуна страница V · mm","render.cpu_area_samples":"Узорци површинског светла","render.cpu_binding_confirm":"Потврди ово тело","render.cpu_binding_stale":"Сцена се променила. Поново потврдите овај циљ рефлексије пре рендеровања.","render.cpu_body_choose":"Изаберите тело","render.cpu_body_filter":"Филтрирај тела по називу","render.cpu_body_filter_more":"Сузите филтер да видите више тела.","render.cpu_body_missing":"Циљ рефлексије недостаје, скривен је, двосмислен или има назив дужи од 128 бајтова. Поново га изаберите.","render.cpu_budget":"CPU профил ресурса","render.cpu_budget_bodies":"Горња граница тела","render.cpu_budget_compact":"Компактно (стара ограничења)","render.cpu_budget_details":"Ограничења ресурса","render.cpu_budget_help":"Већа ограничења изаберите изричито. Резолуција и узорци се никад не смањују аутоматски.","render.cpu_budget_memory":"Горња граница меморије посла","render.cpu_budget_not_guarantee":"Ово су горње границе пријема, а не резервација RAM-а ни гаранција брзине. Геометрија, филм и задржани прегледи деле меморијски буџет; рендеровање се увек може отказати.","render.cpu_budget_resize":"Нацрт премашује овај CPU профил или његов буџет узорака камере. Изричито прихватите мање димензије или изаберите већи профил.","render.cpu_budget_studio":"Студио (велике слике)","render.cpu_budget_triangles":"Горња граница троуглова","render.cpu_budget_workstation":"Радна станица (захтевне сцене)","render.cpu_captured_hdr":"HDR забележен за ову слику","render.cpu_check_capture_help":"Провера и Покрени потврђују исти сажетак датотеке или користе уграђени HDR. Свака слика задржава свој забележени извор.","render.cpu_check_changed":"Контроле или модел су се променили након ове провере. Поново проверите пре рендеровања.","render.cpu_constant_help":"Константна радијанса видљива је рефлектованим или пропуштеним зрацима. Не даје директно дифузно осветљење.","render.cpu_custom_directions":"Замени подешавање прилагођеним усмереним светлима","render.cpu_direction":"Смер према светлу (X, Y, Z)","render.cpu_directional":"Усмерено светло","render.cpu_directional_add":"Додај усмерено светло","render.cpu_environment":"CPU окружење","render.cpu_environment_background":"Позадина слике остаје одвојена од осветљења окружења.","render.cpu_environment_bounds":"CPU интензитет мора бити 0–64, HDR ротација коначна унутар ±1.000.000 радијана, а HDR узорци 1, 4, 16 или 64.","render.cpu_environment_constant":"Окружење константно за секундарне зраке","render.cpu_environment_none":"Без CPU окружења","render.cpu_environment_samples":"Узорци HDR осветљења","render.cpu_exposure_help":"CPU експозиција мора бити између −16 и 16 EV. GPU експозиција изван тог опсега задржава се док је не промените.","render.cpu_fixed":"Једна слика","render.cpu_hdr_help":"Radiance .hdr, панорама 2:1, до 2048 × 1024 и 16 MiB. CPU захтева изричите sRGB/D65 примарне боје у датотеци; ненаведене примарне боје и EXR се одбијају.","render.cpu_hdr_reflection_help":"HDR храпаве рефлексије захтевају потпуно металне површине тела и лица. Провера пријављује неподржане комбинације.","render.cpu_key_rim":"Главно и рубно","render.cpu_last_check":"Последња CPU провера","render.cpu_light_help":"До осам усмерених светала. Празан прилагођени списак их искључује; избор подешавања враћа његова светла. Боје су линеарни RGB, а интензитет је релативан, не у ватима.","render.cpu_light_intensity":"Релативни интензитет (0–64)","render.cpu_light_minimum":"Минимално растојање за слабљење","render.cpu_light_position":"Светски положај (X, Y, Z)","render.cpu_light_reference":"Референтно растојање за интензитет","render.cpu_light_remove":"Уклони светло","render.cpu_lighting":"Подешавање осветљења","render.cpu_lights":"CPU светла","render.cpu_linear_color":"Линеарна боја (R, G, B)","render.cpu_neutral":"Неутрално","render.cpu_opaque_required":"CPU праћење зрака захтева непрозирну позадину. Искључите Провидна позадина да наставите.","render.cpu_options_pending":"Овај CPU панел још не може да мења емисију, ефекте површине, стакло ни анизотропију. Пре употребе очистите те API опције.","render.cpu_point":"Тачкасто светло","render.cpu_point_add":"Додај тачкасто светло","render.cpu_point_help":"До осам тачкастих светала, додатих изабраном усмереном осветљењу. Растојања су у mm; минимално не сме премашити референтно растојање.","render.cpu_primary_samples":"Узорци ивица по пикселу","render.cpu_progressive":"CPU прогресивно","render.cpu_progressive_help":"Акумулира постојећи CPU интегратор у пролазима од по једног примарног узорка. Изабране рефлексије захтевају један узорак; површинска светла, диелектрици и анизотропија захтевају Једна слика.","render.cpu_progressive_limits":"Највише 1.048.576 пиксела и 16.777.216 израчунавања пиксел × узорак. Промена узорака никад аутоматски не мења величину слике.","render.cpu_progressive_seed":"CPU семе узорковања","render.cpu_progressive_spp":"узорака по пикселу","render.cpu_reflection_add":"Додај храпаву рефлексију","render.cpu_reflection_depth":"Дубина рефлексије (1–8)","render.cpu_reflection_empty":"Ниједно тело није изабрано: рефлексије сцене су искључене.","render.cpu_reflection_help":"Изаберите тела и подесите Искључено, Огледало или Храпаво. Храпаво користи додељену храпавост површине. Више узорака и одбијања продужава време; ово је ограничени спекуларни транспорт, а не глобално осветљење.","render.cpu_reflection_limit":"Подржано је до 64 рефлектована тела.","render.cpu_reflection_mirror":"Огледало","render.cpu_reflection_off":"Искључено","render.cpu_reflection_rough":"Храпаво","render.cpu_reflection_samples":"Узорци рефлексије (1–64)","render.cpu_reflections":"CPU рефлексије","render.cpu_runtime_help":"Бројчана подешавања светла и окружења чувају се са подешавањем. Рефлексије тела и HDR датотеке остају привремене. Постојеће вредности површинских светала и конуса рефлектора се задржавају.","render.cpu_sampling_mode":"CPU режим узорковања","render.cpu_shadows":"Баци сенке","render.cpu_summary":"CPU праћење зрака · рефлексије · HDR · усмерена и тачкаста светла","render.cpu_warm_cool":"Топло и хладно","render.diag_bodies":"Видљива тела","render.diag_job_details":"Забележени детаљи посла","render.diag_last_check":"Последња предпровера","render.diag_memory":"Логичка процена пријема","render.diag_not_implemented":"Изричите границе могућности","render.diag_preflight_details":"Детаљи предпровере","render.diag_request":"Тачан тренутни захтев","render.diag_triangles":"Троуглови","render.discard_continue":"Одбаци нацрт и настави","render.draft_confirm_help":"Тренутни нацрт рендеровања има непримењене измене. Сачувајте их пре пребацивања, изричито их одбаците или наставите измену.","render.draft_confirm_title":"Сачувај измењена подешавања рендеровања","render.effects_gpu_only":"Ови ефекти захтевају GPU праћење путања. Промена странице никад аутоматски не мења рендерер.","render.effects_help":"Комбинујте поређане изгледе боја и ефекте објектива у простору слике. Рендеровање и поновна градација сировог мастера користе иста сачувана подешавања. Сирови EXR остаје непромењен. Ово су изворне уметничке контроле, а не калибрисане емулације објектива или брендираних филмова.","render.effects_reset_lens":"Ресетуј ефекте објектива","render.effects_seed":"Семе узорка","render.emitted_axis":"Оса емитовања","render.env_advanced":"Напредно","render.env_backdrop":"Позадина","render.env_backdrop_pending":"Видљивост окружења и замућење позадине рендерер још не подржава.","render.env_blur":"Замућење","render.env_change":"Промени","render.env_choose_source":"Изаберите окружење у Студијима и окружењима пре измене осветљења.","render.env_clear":"Очисти","render.env_colour":"Боја","render.env_environments":"Окружења","render.env_ground":"Подлога","render.env_ground_pending":"Физичка подлога прима сенке као коначна дифузна површина. Хватање само сенки и рефлексије подлоге још нису подржани.","render.env_intensity":"Интензитет","render.env_invalid_edit":"Неисправна измена окружења.","render.env_physical_ground":"Физичка подлога","render.env_preview_help":"Илустративни узорак сфере; није преглед изабраног окружења.","render.env_reflection":"Рефлексија","render.env_ring_help":"Превуците прстен да ротирате осветљење. Држите Shift за привлачење на 15°.","render.env_rotate":"Ротирај","render.env_set":"Подеси окружење рендера","render.env_shadow_catcher":"Хватач сенки","render.env_show_environment":"Прикажи окружење","render.env_source":"Извор","render.env_stage_details":"Измене подлоге захтевају праћење зрака и један панел подлоге. За остале панеле сцене користите Сцену.","render.env_studios":"Студији","render.environment.albedo":"Албедо","render.environment.atmosphere":"Атмосфера","render.environment.backdrop_note":"Позадину види само камера. Она никад не осветљава, не баца сенке и не рефлектује, а уз провидни излаз се одбија.","render.environment.blur_pending":"Замућење није доступно: рендерер нема подешавање замућења позадине.","render.environment.builtin":"Уграђени HDR","render.environment.check":"Провери датотеку","render.environment.checked":"HDR датотека је проверена. Чување уграђује ове бајтове.","render.environment.choose":"Изабери HDR…","render.environment.constant":"Константно","render.environment.cyclorama":"Циклорама","render.environment.embedded":"Сачувано унутар овог дизајна","render.environment.end":"Крај","render.environment.extinction":"Екстинкција","render.environment.file":"Датотека","render.environment.fit":"Уклопи и сачувај подлогу","render.environment.floor_wall":"Под и зид","render.environment.gap":"Размак зазора","render.environment.gradient":"Градијент","render.environment.gradient_gpu":"Градијентној позадини је потребно GPU праћење путања.","render.environment.ground":"Подлога и сцена","render.environment.hdr":"HDR","render.environment.hdr_file":"HDR датотека","render.environment.horizon":"Хоризонт","render.environment.horizontal":"Хоризонтално","render.environment.keep":"Задржи","render.environment.lighting_samples":"Узорци осветљења","render.environment.margin":"Маргина опсега","render.environment.max":"Макс. границе","render.environment.medium":"Медијум који учествује","render.environment.min":"Мин. границе","render.environment.mode":"Режим","render.environment.needs_gpu":"Потребно је GPU праћење путања.","render.environment.none":"Ништа","render.environment.orientation":"Оријентација и јачина","render.environment.phase":"Фаза","render.environment.primaries":"Неодређене примарне боје тумачи као линеарни sRGB","render.environment.primaries_gpu":"Тумачење неодређених примарних боја захтева GPU праћење путања.","render.environment.radial":"Радијално","render.environment.radial_only":"Центар и полупречник важе за радијални режим.","render.environment.reflectance":"Рефлектанција","render.environment.remove":"Уклони сцену","render.environment.remove_confirm":"Уклонити сачувану сцену?","render.environment.remove_note":"Уклања {count} пасивних панела из овог кадра. Позадина камере остаје.","render.environment.replace":"Потврди замену постојеће сцене","render.environment.rotation_hdr":"Ротација захтева HDR извор за CPU праћење зрака.","render.environment.samples_cpu":"Узорке осветљења одређује GPU буџет праћења путања; ово подешавање захтева CPU праћење зрака.","render.environment.saved_panels":"Сачувани панели {count}","render.environment.sky_ground":"