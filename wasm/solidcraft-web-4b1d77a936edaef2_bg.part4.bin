ender.stage_panels.target":"Mục tiêu","render.stage_panels.use_budget":"Sử dụng ngân sách này","render.stage_panels.use_maps":"Sử dụng bản đồ GPU","render.stage_panels.use_uniform":"Sử dụng diện mạo đồng nhất","render.stage_preview_note":"Xem trước tích hợp · ánh sáng trực tiếp","render.state_completed":"Ảnh đã hoàn tất","render.state_in_progress":"Ảnh đang tạo","render.state_model":"Xem trước mô hình","render.strip_label":"Dải","render.studio_add_area":"Thêm nguồn sáng vùng","render.studio_ambient":"Suất bức xạ môi trường không đổi","render.studio_ambient_rgb":"Suất bức xạ môi trường không đổi (RGB tuyến tính)","render.studio_aperture":"Bán kính khẩu độ","render.studio_area":"Nguồn sáng vùng","render.studio_area_help":"Tối đa bốn hình chữ nhật một mặt. Nửa cạnh trực giao U và V xác định kích thước; U × V hướng về phía chiếu sáng. Tọa độ tính theo milimét không gian thế giới.","render.studio_center":"Tâm X, Y, Z (mm)","render.studio_denoise":"Giảm nhiễu trong ảnh thành phẩm","render.studio_denoise_help":"Bộ lọc cuối cùng bảo toàn cạnh; chi tiết tinh xảo có thể bị làm mềm. Thủy tinh và bề mặt phản xạ gương sắc nét bỏ qua bộ lọc này.","render.studio_direction":"Hướng về phía mặt trời (X, Y, Z)","render.studio_environment":"Môi trường","render.studio_environment_bounds":"Góc xoay môi trường phải hữu hạn trong khoảng ±1.000.000 radian và cường độ từ 0 đến 100.","render.studio_environment_none":"Không có bản đồ môi trường","render.studio_focus":"Khoảng cách lấy nét theo trục","render.studio_half_u":"Nửa cạnh U (mm)","render.studio_half_v":"Nửa cạnh V (mm)","render.studio_hdr":"Tệp Radiance HDR","render.studio_hdr_browse":"Chọn tệp HDR…","render.studio_hdr_help":"Radiance .hdr, toàn cảnh 2:1, tối đa 2048 × 1024. Không hỗ trợ EXR. Giả định màu sắc chỉ áp dụng khi chưa công bố màu cơ bản.","render.studio_hdr_required":"Chọn một tệp .hdr cục bộ.","render.studio_hdr_srgb":"Hiểu các màu cơ bản chưa xác định là sRGB tuyến tính","render.studio_intensity":"Cường độ môi trường","render.studio_lens":"Độ sâu trường ảnh (DOF)","render.studio_lens_perspective":"Độ sâu trường ảnh yêu cầu camera phối cảnh.","render.studio_lighting":"Ánh sáng studio","render.studio_lighting_enable":"Sử dụng ánh sáng studio tùy chỉnh","render.studio_needs_review":"Xem xét phương thức và cài đặt","render.studio_radiance":"Suất bức xạ RGB tuyến tính","render.studio_ready":"Sẵn sàng kiểm tra","render.studio_remove_area":"Xóa nguồn sáng vùng","render.studio_rotation":"Góc xoay môi trường","render.studio_runtime_help":"Cài đặt số của studio và nguồn HDR đã kiểm tra có thể lưu cùng thiết lập. Ghi đè quang học/vật liệu cho khối vẫn là tạm thời và không đổi diện mạo đã lưu.","render.studio_saved":"Thiết lập đã lưu / camera hiện tại","render.studio_sky":"Bầu trời nghệ thuật","render.studio_sky_help":"Dải chuyển màu bầu trời gốc dùng cho chiếu sáng; không phải mô hình khí quyển hiệu chuẩn.","render.studio_sun":"Mặt trời","render.studio_sun_radius":"Bán kính góc","render.studio_tiles_require_gpu":"Studio cần dò đường đi của tia bằng GPU. Chọn GPU trong trình chỉnh Đầu ra.","render.studio_title":"Studio kết xuất","render.studio_tone_map":"Ánh xạ sắc điệu (Tone mapping)","render.studios_environments":"Studio và môi trường","render.subsurface_enable":"Bước đi ngẫu nhiên tán xạ bên trong","render.subsurface_help":"Chỉ dành cho chất điện môi kín. Hệ số tán xạ và hấp thụ RGB là các hệ số riêng biệt trên mỗi mm. Tia sáng tán xạ bên trong hình học thực tế, sau đó khúc xạ hoặc phản xạ tại ranh giới. Hãy tắt bóng đổ thẳng, khử nhiễu bề mặt và thể tích bên ngoài; dùng một phân tầng Fresnel. Đây không phải bộ đổ bóng khuếch tán, lưới mật độ hay vật liệu đo đạc. Môi trường đậm đặc có thể cần nhiều mẫu và độ sâu tia lớn hơn.","render.subsurface_rate":"Tần suất va chạm tán xạ","render.tone_aces_fitted":"ACES khớp","render.tone_reinhard":"Reinhard","render.transmission_scope":"Thủy tinh GPU hỗ trợ các môi trường rời rạc đã xác thực. Không cung cấp môi trường lồng nhau không giới hạn hay ước tính truyền dẫn không nhiễu.","render.transmission_strata":"Số phân tầng Fresnel có điều kiện","render.transmission_strata_help":"Giá trị 1 giữ nguyên chuỗi ban đầu. Giá trị 2 hoặc 4 phân tầng hóa lựa chọn phản xạ/truyền qua đầu tiên của thủy tinh theo định luật Snell và hấp thụ không đổi. Thêm đường truyền tia sẽ tốn nhiều tính toán hơn; đây không phải tính năng khử nhiễu, hỗ trợ môi trường lồng nhau hay đảm bảo tăng tốc kết xuất.","render.tree_add_light":"Thêm đèn","render.tree_add_shot":"Thêm cảnh chụp","render.tree_browser":"Trình duyệt kết xuất","render.tree_by_look":"Theo diện mạo","render.tree_by_object":"Theo đối tượng","render.tree_constant":"Môi trường hằng định","render.tree_default":"Mặc định","render.tree_directional":"Định hướng","render.tree_environment":"Môi trường","render.tree_environment_values":"{rotation}° · {intensity}×","render.tree_face_count":"{count} mặt","render.tree_face_one":"{count} mặt","render.tree_fixed_studio":"Studio cố định","render.tree_hdr":"HDR","render.tree_lights":"Đèn","render.tree_lights_pending":"Chưa có lệnh đèn có tên.","render.tree_mixed":"Hỗn hợp","render.tree_more":"Thêm {count}","render.tree_mute":"Tắt đèn","render.tree_no_environment":"Không có môi trường","render.tree_objects":"Đối tượng","render.tree_output":"Đầu ra","render.tree_point":"Điểm","render.tree_rectangle":"Hình chữ nhật","render.tree_search":"Tìm đối tượng","render.tree_selection":"Vùng chọn kết xuất","render.tree_shots":"Cảnh chụp","render.tree_sky":"Bầu trời","render.tree_solo":"Chỉ hiện một đèn","render.tree_spot":"Đèn rọi","render.tree_sun":"Mặt trời","render.tree_switch":"Chuyển","render.tree_user_one":"{count} đối tượng","render.tree_users":"{count} đối tượng","render.unavailable_preview":"Thiết lập này yêu cầu cấu hình xem trước hiện không khả dụng.","render.unsaved":"Các thay đổi xem trước chưa lưu","render.use_preview":"Sử dụng xem trước tích hợp","render.volume_albedo":"Độ phản xạ khuếch tán tán xạ (Albedo) · RGB tuyến tính","render.volume_anisotropy":"Cos trung bình hàm pha (Anisotropy)","render.volume_enable":"Bật môi trường tham gia (Participating medium)","render.volume_extinction":"Hệ số suy giảm quang học (Extinction)","render.volume_help":"Dò tia GPU bên trong một hộp hữu hạn, với định luật suy giảm Beer và tán xạ HG trên các đường truyền tia camera và gián tiếp. Sử dụng ánh sáng studio/HDR/bầu trời rõ ràng, bao gồm cả suy giảm bóng đổ. Cos pha dương tán xạ về phía trước. Ranh giới thủy tinh và khử nhiễu bề mặt phải được tắt rõ ràng. Hệ số suy giảm bằng 0 giữ nguyên truyền dẫn. Đây không phải khí quyển mặt trăng vật lý, lưới mật độ, phát xạ thể tích, truyền dẫn quang phổ hay đặc tính vật liệu chứng nhận.","render.volume_max":"Ranh giới tối đa · mm thế giới","render.volume_min":"Ranh giới tối thiểu · mm thế giới","render.volume_title":"Thể tích đồng nhất có giới hạn","render.wait_add_light":"chưa hỗ trợ: tạo đèn có tên","render.wait_batch":"chưa hỗ trợ: hàng đợi kết xuất cảnh chụp đã lưu","render.wait_compare":"chưa hỗ trợ: so sánh ảnh được giữ lại","render.wait_paint":"chưa hỗ trợ: chọn sản phẩm và tô diện mạo","render.wait_pick_up":"chưa hỗ trợ: chọn sản phẩm và lấy mẫu diện mạo","render.wait_replace":"chưa hỗ trợ: thay mọi chỗ dùng một diện mạo","render.wait_solo":"chưa hỗ trợ: hiển thị và chỉ hiện một đèn","render.wear_applies_to":"Áp dụng cho","render.wear_layer_count":"{count} lớp","render.wear_layer_one":"{count} lớp","render.wear_layers":"Lớp","render.wear_no_layers":"Không có lớp","render.wear_selected_layer":"Lớp đã chọn","render.wear_title":"Hao mòn","sample.bracket.about":"Mép chấn đáy với các mép chấn cạnh và đường viền gấp cuộn theo quy tắc 2 mm","sample.bracket.name":"Giá đỡ kim loại tấm","sample.enclosure.about":"Hộp làm mỏng vỏ có gờ chắn, vấu bắt vít, gờ đỡ và khớp gài bấm","sample.enclosure.name":"Vỏ hộp nhựa","sample.flange.about":"Moay-ơ và mặt bích với mảng xoay tròn được điều khiển bởi tham số","sample.flange.name":"Mặt bích bắt bu-lông","sample.hinge.about":"Hai cụm chi tiết và một khớp quay, được dẫn động đến 60°","sample.hinge.name":"Cụm bản lề","sample.plate.about":"Tấm tham số với các góc bo tròn, các lỗ và vấu lồi khoét lỗ","sample.plate.name":"Tấm mẫu","sample.vents.about":"Các rãnh then trong mảng chữ nhật: số hàng, số cột và bước rãnh là các tham số","sample.vents.name":"Tấm khe thông gió","search.command_keys":"Enter chạy     Shift+Enter chạy và giữ mở     Esc đóng","search.commands":"Lệnh","search.design":"Trong thiết kế này","search.feature":"Tính năng","search.invalid":"Không hợp lệ","search.keys":"↑ ↓ chọn     Enter chạy     Tab điền tên     Esc đóng","search.no_match":"Không có lệnh nào khớp với '{query}'","search.parameter":"Tham số","search.recent":"Gần đây","search.run":"Chạy lệnh","search.suggest":"Có phải bạn muốn nói {label}?","search.try":"Nhập tên lệnh, một tính năng trong thiết kế này hoặc một tham số. Để chạy lệnh kèm giá trị, hãy nhập mã lệnh và một đối tượng JSON: {example}","search.valid":"Hợp lệ","section.off_hint":"Chưa chọn mặt phẳng: nhấn OK sẽ tắt mặt cắt.","select a direction (an axis, a sketch line or a straight edge) first":"hãy chọn một hướng (một trục, một đường thẳng phác thảo hoặc một cạnh thẳng) trước","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"chọn một hướng (một trục, một đường thẳng phác thảo hoặc một cạnh thẳng) để biên dạng đi theo","select a point on a component":"chọn một điểm trên một thành phần","select a profile, edges or sketch lines first":"hãy chọn một biên dạng, các cạnh hoặc các đường thẳng phác thảo trước","select an axis":"chọn một trục","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"hãy chọn một trục, một cạnh thẳng hoặc cạnh tròn, hoặc một mặt trụ, mặt nón hay mặt xuyến trước","select bodies first":"hãy chọn các thân trước","select components first":"hãy chọn các thành phần trước","select corner points, or the two lines of one corner":"chọn các điểm góc, hoặc hai đường thẳng của một góc","select one corner point, or the two lines of one corner":"chọn một điểm góc, hoặc hai đường thẳng của một góc","select sheet edges first":"hãy chọn các cạnh của tấm trước","select the bend line (a sketch line) first":"hãy chọn đường gập (một đường thẳng phác thảo) trước","select the cam's profile (a sketch profile or the cam's edges)":"chọn biên dạng của cam (một biên dạng phác thảo hoặc các cạnh của cam)","select the corner to cut first":"hãy chọn góc cần cắt trước","select the corners to round first":"hãy chọn các góc cần bo tròn trước","select the fixed face first (a plate's large face)":"hãy chọn mặt cố định trước (mặt lớn của một tấm)","select the frame sketch's lines first":"hãy chọn các đường thẳng của phác thảo khung trước","select the path (sketch lines across the edge)":"chọn đường dẫn (các đường thẳng phác thảo dọc qua cạnh)","select the rim face first":"hãy chọn mặt viền trước","select the sheet edge first":"hãy chọn cạnh của tấm trước","select two components":"chọn hai thành phần","set by the sketch's lines":"xác định bởi các đường của phác thảo","settings.display_quality_note":"Mức độ chi tiết cao hơn giúp hiển thị các mặt cong và cạnh mượt mà hơn nhưng tốn nhiều thời gian tạo lưới hơn. Thiết lập này chỉ thay đổi vùng nhìn, không ảnh hưởng đến thiết kế hay dữ liệu xuất tệp.","settings.double_click_components":"Nhấp đúp vào một thành phần để kích hoạt nó, hoặc chỉnh sửa tại chỗ một thành phần liên kết","settings.frame_rate_details_note":"Bổ sung biểu đồ thời gian các khung hình gần nhất xếp chồng số tam giác đã vẽ, biểu đồ phân bố thời gian khung hình và nội dung GPU đã vẽ. Bấm vào tốc độ khung hình trên khung nhìn để ẩn/hiện.","settings.frame_rate_note":"Hiển thị số khung hình trên giây (FPS) ở góc dưới bên phải khung nhìn.","settings.insert_lists_open_designs":"Chèn thiết kế vào cụm liệt kê trước các thiết kế đang mở ở các thẻ khác","settings.measure_axis_distances":"Hiển thị khoảng cách theo trục X/Y/Z","settings.measure_axis_distances_help":"Hiển thị kích thước thành phần theo các trục tọa độ cùng với khoảng cách tổng thể khi mở công cụ Đo lường.","settings.msaa_applies_on_restart":"Khử răng cưa sẽ áp dụng vào lần khởi động tiếp theo của SolidCraft","settings.msaa_reset":"{setting}: Mức {requested}× không được hỗ trợ bởi thiết bị đồ họa này; đã đặt về {reset}× (hỗ trợ: {supported}).","settings.msaa_unsupported":"Thiết bị đồ họa này không hỗ trợ","settings.reference_geometry_through_bodies":"Hiển thị hình học tham chiếu xuyên qua các khối","settings.reference_geometry_through_bodies_help":"Vẽ các đường bao phác thảo không kích hoạt và mặt phẳng chuẩn nổi trên các khối đã tô bóng","settings.reset_intro":"Các cài đặt sau không hoạt động trên máy tính này và có thể khiến SolidCraft không thể khởi động, vì vậy chúng đã được tự động điều chỉnh:","settings.reset_title":"Cài đặt đã được thay đổi","settings.supersampling_note":"Vẽ khung nhìn ở độ phân giải cao hơn rồi nén lại: giúp các cạnh, đường nét và lưới mượt mà hơn trên màn hình dưới 4K. Tính năng này tiêu tốn tài nguyên GPU: gấp khoảng 2,25 lần số điểm ảnh ở mức 1,5× và 4 lần ở mức 2×.","settings.update_changed_links":"Cập nhật các thiết kế liên kết đã thay đổi khi quay lại một thẻ","settings.window_system_details":"Chi tiết","settings.window_system_note_now":"Áp dụng sau khi khởi động lại. Hiện tại: {now}.","settings.window_system_wayland_limited":"Một số tính năng bị giới hạn trên Wayland gốc.","sheet.flange_type_base":"Cơ sở","sheet.flange_type_contour":"Đường viền","sheet.flange_type_edge":"Cạnh","sheet.no_body":"chưa có khối tấm kim loại: hãy bắt đầu bằng Cánh gập > Cơ sở (Base), hoặc chuyển một tấm phẳng thành tấm kim loại bằng lệnh 'Chuyển thành tấm kim loại' (chọn mặt phẳng lớn của nó)","sheet.personal_rules.confirm_delete":"Xác nhận xóa","sheet.personal_rules.delete":"Xóa","sheet.personal_rules.delete_prompt":"Xóa quy tắc cá nhân này? Các quy tắc đã có trong thiết kế sẽ không thay đổi.","sheet.personal_rules.full":"Thư viện cá nhân đã chứa tối đa 64 quy tắc.","sheet.personal_rules.invalid_name":"Nhập một tên ngắn gọn, không chứa ký tự xuống dòng hoặc ký tự điều khiển.","sheet.personal_rules.invalid_values":"Hãy điền đủ các giá trị của quy tắc: mỗi giá trị phải tính được trong thiết kế này, với độ dày dương và hệ số K từ 0 đến 1.","sheet.personal_rules.missing":"Quy tắc cá nhân đã chọn không còn khả dụng.","sheet.personal_rules.name":"Tên quy tắc","sheet.personal_rules.name_exists":"Quy tắc cá nhân với tên này đã tồn tại. Vui lòng sử dụng tên khác.","sheet.personal_rules.name_hint":"Tên duy nhất","sheet.personal_rules.overwrite":"Lưu các thay đổi vào quy tắc cá nhân đã chọn","sheet.personal_rules.rename":"Đổi tên","sheet.personal_rules.rule":"Quy tắc cá nhân","sheet.personal_rules.save":"Lưu mới","sheet.personal_rules.scope":"Được lưu trong hồ sơ cá nhân của bạn cho tất cả thiết kế.","sheet.personal_rules.select":"Chọn một quy tắc","sheet.personal_rules.title":"Quy tắc cá nhân","sheet.personal_rules.unsupported":"Quy tắc này có các giá trị mà phiên bản hiện tại không thể sử dụng.","shortcut.json_error":"tham số phải là JSON: {error}","shortcut.no_command":"không có lệnh `{id}`; văn bản trước JSON phải là mã lệnh","shortcut.pin":"Ghim lên đầu hộp S","shortcut.unpin":"Bỏ ghim","sketch is missing":"thiếu phác thảo","sketch.degrees_of_freedom":"{count} bậc tự do","sketch.dimension_added_driven":"Bản phác thảo đã xác định kích thước đó, nên nó được thêm vào dưới dạng kích thước tham chiếu","sketch.dimension_applied":"Đã áp dụng kích thước","sketch.dimension_applied_defined":"Đã áp dụng kích thước; đã định nghĩa tham số `{name}`","sketch.dimension_applied_renamed":"Đã áp dụng kích thước; tham số được đặt tên là `{name}`","sketch.dof_left":"Còn {count} bậc tự do","sketch.dof_left_one":"Còn {count} bậc tự do","sketch.draw_curves":"Vẽ dưới dạng {linetype}","sketch.make_selection":"Chuyển đổi vùng chọn sang {linetype}","sketch.open_ends":"Đầu hở: {count}","sketch.status_conflict":"ràng buộc xung đột","sketch.status_fully_constrained":"ràng buộc hoàn toàn","sketch.untied_ends":"Chưa khóa: {count}","sketch_panel.attached":"Gắn vào {body} / {path}","sketch_panel.author":"Vị trí gốc: {path}","sketch_panel.dimension_hint":"Nhập một giá trị hoặc biểu thức, rồi nhấn OK.","sketch_panel.move_hint":"Nhập các khoảng cách và một góc, rồi nhấn OK.","sketch_panel.plane_angle":"{plane}, xoay một góc {angle}","sketch_panel.plane_fixed":"Một mặt phẳng cố định","sketch_panel.plane_flipped":"{plane}, từ phía bên kia","sketch_panel.plane_offset":"{plane}, dời một khoảng {distance}","sketch_panel.plane_origin":"Mặt phẳng {plane}","sketch_panel.redefine_title":"{command}: {name}","sketch_panel.sheet_attachment":"Gắn vào một mặt phẳng của thân khối tấm kim loại; phác thảo sẽ đi theo tấm đó khi tấm thay đổi.","sketch_panel.text_hint":"Sửa văn bản và vị trí của nó, rồi nhấn OK.","sketch_panel.use_plane":"Dùng mặt phẳng {plane}","sketch_text.align_center":"Căn giữa","sketch_text.align_left":"Trái","sketch_text.align_right":"Phải","sketch_text.bold":"In đậm","sketch_text.builtin_font":"{family} (tích hợp sẵn)","sketch_text.formula":"Bắt đầu bằng = để tạo chữ từ các tham số: ='W' + number(Width)","sketch_text.italic":"In nghiêng","sketch_text.loading_fonts":"Đang tìm kiếm các phông chữ đã cài đặt…","sketch_text.no_bold":"Phông chữ tích hợp không có kiểu in đậm: chọn một phông chữ đã cài đặt","sketch_text.on_path":"Văn bản đi theo đường dẫn: đường cong định vị văn bản","sketch_text.path_clear":"Gỡ văn bản khỏi đường cong dẫn","sketch_text.path_hint":"Đường cong phác thảo mà văn bản chạy theo: nhấp vào đây, sau đó chọn đường cong","sketch_text.use_font_file":"Sử dụng tệp phông chữ {path}","solid":"khối đặc","status.editing":"Đang sửa {name}","status.navigation":"Gán chức năng chuột: {mapping}","status.navigation_tip":"Cách chuột di chuyển khung nhìn. Nhấp để chọn cách gán khác","status.under_constrained":"Thiếu ràng buộc ({count} bậc tự do)","status.under_constrained_one":"Thiếu ràng buộc ({count} bậc tự do)","status.units_tip":"Đơn vị của thiết kế. Nhấp để đổi","the angle must be a number":"góc phải là một số","the curves must be in one sketch":"các đường cong phải nằm trong cùng một phác thảo","the direction must be an axis, a sketch line or a straight edge":"hướng phải là một trục, một đường thẳng phác thảo hoặc một cạnh thẳng","the duration must be a number of seconds, 0.001 or more":"thời lượng phải là một số giây, từ 0,001 trở lên","the line's sketch is gone":"phác thảo của đường thẳng không còn nữa","the lines must be in one sketch":"các đường thẳng phải nằm trong cùng một phác thảo","the lines must be in one sketch, not the section's":"các đường thẳng phải nằm trong cùng một phác thảo, không phải phác thảo của mặt cắt","the parts library is empty":"thư viện chi tiết đang trống","the parts library is not available":"thư viện chi tiết tiêu chuẩn hiện không khả dụng","the path curves must be in one other sketch":"các đường cong của đường dẫn phải nằm trong cùng một phác thảo khác","the path's sketch is gone":"phác thảo của đường dẫn không còn nữa","the position must be a number":"vị trí phải là một số","the preview failed":"xem trước không thành công","the profiles and curves must be in one sketch":"các biên dạng và đường cong phải nằm trong cùng một phác thảo","the reference face must be on the edges' body":"mặt tham chiếu phải thuộc thân của các cạnh","the scale must be above 0":"tỷ lệ phải lớn hơn 0","the section's profiles must be in one sketch":"các biên dạng của mặt cắt phải nằm trong cùng một phác thảo","the two origins are on the same component":"hai gốc tọa độ nằm trên cùng một thành phần","thread.automatic_size":"Kích thước tự động","thread.designation":"Ký hiệu ren","thread.direction":"Chiều ren","thread.iso_metric":"Hệ mét ISO","thread.left_hand":"Ren trái","thread.right_hand":"Ren phải","thread.select_size":"Chọn kích thước","timeline.delete_after_marker_one":"Xóa 1 tính năng sau điểm đánh dấu lịch sử","timeline.delete_after_marker_other":"Xóa {count} tính năng sau điểm đánh dấu lịch sử","timeline.delete_folders_tip":"Giữ lại các tính năng và thư mục lồng nhau trong lịch sử","timeline.delete_folders_with_features_tip":"Xóa các thư mục cùng mọi tính năng trong đó và các thư mục lồng bên trong","timeline.delete_many":"Xóa {count} tính năng đã chọn","timeline.edited_rolled_back":"{name} đã thay đổi, nhưng nó nằm sau dấu mốc lịch sử nên chưa được dựng: kéo dấu mốc qua nó để xem kết quả","timeline.feature_error":"Lỗi: {message}","timeline.feature_hint":"Bấm đúp để sửa · kéo rê để đổi thứ tự · bấm chuột phải để xem thêm","timeline.feature_rolled_back":"Đã lùi lại: nằm sau dấu mốc lịch sử nên chưa được dựng","timeline.feature_warning":"Cảnh báo: {message}","timeline.group":"Thư mục tính năng mới","timeline.move_many":"Di chuyển các mục trong lịch sử thiết kế","timeline.move_to_group":"Chuyển tính năng vào thư mục","timeline.rename_group":"Đổi tên thư mục tính năng","timeline.reorder_many":"Sắp xếp lại các tính năng","timeline.suppress_features":"Bỏ kích hoạt các tính năng","timeline.suppress_folders_tip":"Bỏ kích hoạt hoặc kích hoạt lại mọi tính năng trong các thư mục và các thư mục lồng bên trong","timeline.ungroup":"Xóa thư mục tính năng","timeline.unsuppress_features":"Kích hoạt lại các tính năng","to the face":"tới bề mặt","to the next face":"tới bề mặt tiếp theo","toolbar.customize_note":"Thẻ {tab}. Đánh dấu một lệnh để tạo nút trên thanh công cụ. Bạn cũng có thể kéo một hàng trong danh sách thả xuống của bảng lên thanh công cụ, kéo một nút ra khỏi thanh công cụ để gỡ bỏ, hoặc dùng biểu tượng ghim trên hàng trong danh sách thả xuống.","toolbar.image":"HÌNH ẢNH","toolbar.render":"KẾT XUẤT","toolbar.render_appearance":"DIỆN MẠO","toolbar.render_camera":"CAMERA","toolbar.render_environment":"MÔI TRƯỜNG","toolbar.render_lighting":"CHIẾU SÁNG","toolbar.render_lights":"ĐÈN","toolbar.render_result":"KẾT QUẢ","toolbar.render_scene":"BỐI CẢNH","toolbar.render_stage":"GIAI ĐOẠN","toolbar.render_studio":"XƯỞNG","trace.points":"{count} điểm dọc theo đường dẫn","trace.stopped_by_contact":"Kết thúc tại mẫu {sample}: {a} sẽ xuyên qua {b}","trace.stopped_by_loop":"Kết thúc tại mẫu {sample}: vòng lặp qua {joint} không thể khép kín thêm được nữa","trim by sketch curves, or by one plane or face":"cắt tỉa bằng các đường cong phác thảo, hoặc bằng một mặt phẳng hay một mặt","ui.1_degree_of_freedom":"1 bậc tự do","ui.3d_mouse_axes_reassigned":"Các trục được gán lại trong Tùy chọn, và điều đó vẫn áp dụng cùng với hiệu chuẩn này.","ui.3d_mouse_button":"Nút {number}","ui.3d_mouse_button_nothing":"Không có","ui.3d_mouse_button_settings":"Cài đặt chuột 3D","ui.3d_mouse_buttons":"Nút","ui.3d_mouse_buttons_hint":"Nhấn một nút trên chuột 3D để tìm nó ở đây, rồi chọn chức năng.","ui.3d_mouse_buttons_no_device":"Kết nối chuột 3D để chọn chức năng cho các nút của nó.","ui.3d_mouse_buttons_reset":"Khôi phục nút mặc định","ui.3d_mouse_calibrate":"Hiệu chuẩn…","ui.3d_mouse_calibrate_tip":"Di chuyển núm điều khiển theo yêu cầu của cửa sổ để SolidCraft biết mỗi trục của chuột 3D này đi theo hướng nào và xa bao nhiêu. Được lưu cho chuột 3D này.","ui.3d_mouse_calibrate_title":"Hiệu chuẩn chuột 3D","ui.3d_mouse_calibrate_wait":"Hãy di chuyển chuột 3D một lần để SolidCraft nhận ra nó.","ui.3d_mouse_calibrated":"Đã hiệu chuẩn","ui.3d_mouse_calibration":"Hiệu chuẩn chuột 3D","ui.3d_mouse_calibration_done":"Xong. Hãy lưu để dùng mỗi khi chuột 3D này được kết nối.","ui.3d_mouse_calibration_no_response":"Một trục hầu như không di chuyển nên không thể hiệu chuẩn. Hãy bắt đầu lại và di chuyển núm điều khiển xa hơn mỗi lần.","ui.3d_mouse_circles_help":"Các vòng tròn cho thấy thiết bị gửi gì sau khi hiệu chuẩn. Mô hình thử cho thấy khung nhìn làm gì với nó, sau đảo chiều, tốc độ và gán trục.","ui.3d_mouse_dead_zone":"Vùng chết","ui.3d_mouse_dead_zone_tip":"Núm điều khiển phải di chuyển bao xa thì khung nhìn mới di chuyển, tính theo tỷ lệ hành trình tối đa. Hãy tăng giá trị này nếu khung nhìn bị trôi khi núm đang đứng yên.","ui.3d_mouse_denied":"SolidCraft thấy một chuột 3D nhưng không được phép đọc nó. Xem ghi chú thiết lập chuột 3D để biết quy tắc udev.","ui.3d_mouse_denied_short":"Đã thấy, nhưng không đọc được","ui.3d_mouse_driven_by":"Chuyển động đã hiệu chuẩn nào của thiết bị điều khiển trục này. Chọn chuyển động mà trục khác đang dùng sẽ hoán đổi hai trục.","ui.3d_mouse_driven_by_label":"điều khiển bởi","ui.3d_mouse_driver":"Trình điều khiển chuột 3D","ui.3d_mouse_driver_auto":"Tự động","ui.3d_mouse_driver_direct":"Trực tiếp (hidraw)","ui.3d_mouse_driver_fallback":"Tạm thời đọc qua spacenavd: không mở được chính thiết bị.","ui.3d_mouse_driver_only_direct":"Đang đọc thiết bị trực tiếp; spacenavd không chạy","ui.3d_mouse_driver_only_spacenavd":"Đang đọc qua spacenavd, cách duy nhất có sẵn","ui.3d_mouse_forget":"Xóa hiệu chuẩn","ui.3d_mouse_ghost_left_viewport":"Khung nhìn bên trái","ui.3d_mouse_ghost_left_window":"Cửa sổ bên trái","ui.3d_mouse_ghost_position":"Vị trí","ui.3d_mouse_ghost_right_viewport":"Khung nhìn bên phải","ui.3d_mouse_hint":"Di chuyển và xoay khung nhìn đồng thời; môi trường phác thảo chỉ sử dụng dời khung nhìn và thu phóng.","ui.3d_mouse_kind_cap":"Trở về giữa","ui.3d_mouse_kind_question":"Đây là loại chuột 3D nào?","ui.3d_mouse_kind_trackball":"Bi xoay","ui.3d_mouse_looks_like_cap":"Giá trị giữ nguyên khi bạn giữ, giống thiết bị kiểu “Trở về giữa”.","ui.3d_mouse_looks_like_trackball":"Giá trị trở về ngay khi bạn ngừng di chuyển, giống bi xoay.","ui.3d_mouse_motion_rotation_x":"Xoay X","ui.3d_mouse_motion_rotation_y":"Xoay Y","ui.3d_mouse_motion_rotation_z":"Xoay Z","ui.3d_mouse_motion_translation_x":"Tịnh tiến X","ui.3d_mouse_motion_translation_y":"Tịnh tiến Y","ui.3d_mouse_motion_translation_z":"Tịnh tiến Z","ui.3d_mouse_navigate":"Điều hướng bằng chuột 3D","ui.3d_mouse_none":"Không tìm thấy chuột 3D","ui.3d_mouse_not_calibrated":"Chưa hiệu chuẩn","ui.3d_mouse_offer":"Hiệu chuẩn chuột 3D sẽ sửa các trục bị hoán đổi hoặc đảo ngược và chỉnh tốc độ cũng như cảm giác.","ui.3d_mouse_offer_never":"Không hiện lại","ui.3d_mouse_offer_swap":"Chuyển sang Hidraw (điều khiển trực tiếp)","ui.3d_mouse_orbit":"Quỹ đạo","ui.3d_mouse_orbit_classic":"Cổ điển","ui.3d_mouse_orbit_tip":"Theo dấu: chuột 3D xoay khung nhìn quanh phần mô hình ở giữa khung nhìn lúc bắt đầu xoay, được đánh dấu bằng một quả cầu mờ. Cổ điển: quanh tâm khung nhìn","ui.3d_mouse_orbit_traced":"Theo dấu","ui.3d_mouse_reading":"Giá trị đọc","ui.3d_mouse_reset_axes":"Đặt lại phép gán trục","ui.3d_mouse_reset_view":"Đặt lại khung nhìn","ui.3d_mouse_restore":"Khôi phục mặc định chuột 3D","ui.3d_mouse_restore_ask":"Đặt cài đặt chuột 3D về mặc định? Hiệu chuẩn và gán nút được giữ nguyên.","ui.3d_mouse_section":"Chuột 3D","ui.3d_mouse_show_in_view":"Hiện chuột 3D trong khung nhìn 3D","ui.3d_mouse_show_in_view_tip":"Hình chuột 3D của bạn ở góc dưới bên trái, chuyển động theo bạn.","ui.3d_mouse_sketch_orbit":"Xoay bản phác thảo bằng chuột 3D","ui.3d_mouse_sketch_orbit_tip":"Chuột 3D cũng xoay khung nhìn khi bản phác thảo đang mở và được nhìn thẳng, như chuột thường. Tắt: chỉ di chuyển và thu phóng bản phác thảo cho đến khi bạn nghiêng khung nhìn.","ui.3d_mouse_skip":"Thiết bị của tôi không làm được điều này","ui.3d_mouse_skip_tip":"Bỏ qua chuyển động này theo cả hai chiều; việc hiệu chuẩn sẽ không dùng nó.","ui.3d_mouse_speed":"Tốc độ chuột 3D","ui.3d_mouse_step_lift":"Nâng núm điều khiển lên, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_press":"Nhấn núm điều khiển xuống, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_pull":"Kéo núm điều khiển về phía bạn, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_push":"Đẩy núm điều khiển ra xa bạn, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_rest":"Bỏ tay khỏi núm điều khiển và để yên.","ui.3d_mouse_step_rest_trackball":"Bỏ tay khỏi viên bi và để yên.","ui.3d_mouse_step_ring_clockwise":"Xoay vòng cuộn theo chiều kim đồng hồ vài nấc.","ui.3d_mouse_step_ring_counterclockwise":"Xoay vòng cuộn ngược chiều kim đồng hồ vài nấc.","ui.3d_mouse_step_roll_away":"Lăn viên bi ra xa bạn vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_roll_left":"Lăn viên bi sang trái vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_roll_right":"Lăn viên bi sang phải vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_roll_toward":"Lăn viên bi về phía bạn vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_slide_left":"Trượt núm điều khiển sang trái, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_slide_right":"Trượt núm điều khiển sang phải, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_spin_clockwise":"Xoay viên bi theo chiều kim đồng hồ vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_spin_counterclockwise":"Xoay viên bi ngược chiều kim đồng hồ vài lần, rồi để nó dừng lại.","ui.3d_mouse_step_tilt_away":"Nghiêng phần trên núm điều khiển ra xa bạn (cạnh gần bạn nhất nâng lên), giữ nguyên, rồi thả ra.","ui.3d_mouse_step_tilt_left":"Nghiêng núm điều khiển sang trái (cạnh trái hạ xuống), giữ nguyên, rồi thả ra.","ui.3d_mouse_step_tilt_right":"Nghiêng núm điều khiển sang phải (cạnh phải hạ xuống), giữ nguyên, rồi thả ra.","ui.3d_mouse_step_tilt_toward":"Nghiêng phần trên núm điều khiển về phía bạn (cạnh gần bạn nhất hạ xuống), giữ nguyên, rồi thả ra.","ui.3d_mouse_step_touch":"Đặt tay lên núm điều khiển nhưng không đẩy.","ui.3d_mouse_step_twist_clockwise":"Xoay núm điều khiển theo chiều kim đồng hồ, giữ nguyên, rồi thả ra.","ui.3d_mouse_step_twist_counterclockwise":"Xoay núm điều khiển ngược chiều kim đồng hồ, giữ nguyên, rồi thả ra.","ui.3d_mouse_switch_cap":"Hiệu chuẩn theo kiểu trở về giữa","ui.3d_mouse_switch_trackball":"Hiệu chuẩn như bi xoay","ui.3d_mouse_use_direct":"Dùng trình điều khiển trực tiếp","ui.3d_mouse_use_direct_tip":"Đọc chuột 3D trực tiếp (hidraw) thay vì qua spacenavd.","ui.3d_mouse_view_axis":"Trục khung nhìn","ui.3d_mouse_view_off":"Tắt","ui.3d_mouse_view_off_tip":"Hồ sơ của trình điều khiển chuột 3D tắt trục này, nên chuyển động của nó không làm khung nhìn di chuyển. Chọn chuyển động của trục khác ở đây sẽ hoán đổi hai trục, và chuyển động đó không còn di chuyển khung nhìn.","ui.3d_mouse_view_orbit_sideways":"Xoay quanh trái / phải","ui.3d_mouse_view_orbit_up_down":"Xoay quanh lên / xuống","ui.3d_mouse_view_pan_sideways":"Kéo trái / phải","ui.3d_mouse_view_pan_up_down":"Kéo lên / xuống","ui.3d_mouse_view_roll":"Lăn","ui.3d_mouse_view_unmapped":"Trục {n}","ui.3d_mouse_view_zoom":"Thu phóng","ui.3d_mouse_waiting":"Đang chờ chuyển động","ui.3d_mouse_wiggle":"Nếu bạn đã cắm một chiếc, hãy lắc nhẹ nó.","ui.3d_sketch":"3D Phác thảo","ui.activate":"Kích hoạt","ui.active_component":"Cụm chi tiết đang kích hoạt","ui.add_configuration":"Thêm cấu hình","ui.add_parameter":"Thêm tham số","ui.agent_chat":"Trò chuyện với AI Agent","ui.agent_chat_add":"Đính kèm tệp","ui.agent_chat_add_file":"Chọn một tệp…","ui.agent_chat_allow":"Cho phép","ui.agent_chat_allow_once":"Cho phép một lần","ui.agent_chat_allowed":"Đã cho phép","ui.agent_chat_answered":"Câu trả lời: {option}","ui.agent_chat_approval":"Cho phép AI thực hiện thao tác này?","ui.agent_chat_attach_selection":"Đính kèm phần chọn","ui.agent_chat_attach_selection_tip":"Gửi các đối tượng đang chọn trong mô hình (mặt, cạnh, tính năng, khối) kèm tin nhắn để trợ lý hiểu rõ đối tượng bạn muốn xử lý","ui.agent_chat_attach_view":"Đính kèm góc nhìn","ui.agent_chat_attach_view_tip":"Gửi kèm hình ảnh góc nhìn hiện tại trong tin nhắn","ui.agent_chat_attachable":"Hình ảnh, PDF, văn bản và tệp CAD","ui.agent_chat_auth_agent":"Đăng nhập với {name}","ui.agent_chat_auth_env":"Thiết lập {vars} trong biến môi trường của bạn rồi khởi động lại SolidCraft.","ui.agent_chat_auth_needed":"AI Agent yêu cầu bạn đăng nhập. Bạn đăng nhập trực tiếp với dịch vụ của AI; SolidCraft không bao giờ thấy mật khẩu hay khóa API của bạn.","ui.agent_chat_auth_none":"AI Agent không cung cấp phương thức đăng nhập tại đây: hãy đăng nhập theo hướng dẫn của dịch vụ đó.","ui.agent_chat_auth_retry":"Tôi đã đăng nhập: kết nối lại","ui.agent_chat_auth_terminal":"Chạy lệnh này trong cửa sổ dòng lệnh, sau đó nhấp Kết nối lại:","ui.agent_chat_auth_title":"Đăng nhập vào AI Agent","ui.agent_chat_cancel":"Hủy bỏ","ui.agent_chat_cannot_start":"Đã cài đặt nhưng không khởi động được: {error}","ui.agent_chat_changes":"Thay đổi: {n}, trong 1 bước hoàn tác","ui.agent_chat_changes_n":"{n} thay đổi","ui.agent_chat_changes_of":"{n}/{limit} thay đổi","ui.agent_chat_choose_model":"Chọn mô hình","ui.agent_chat_close":"Đóng","ui.agent_chat_command":"Lệnh của AI Agent","ui.agent_chat_connect":"Kết nối","ui.agent_chat_copy":"Sao chép","ui.agent_chat_ctx_bodies":"Khối","ui.agent_chat_ctx_elements":"Phần tử","ui.agent_chat_ctx_features":"Tính năng","ui.agent_chat_ctx_more":"+{n} mục khác","ui.agent_chat_ctx_other":"Khác","ui.agent_chat_custom_hint":"Bất kỳ chương trình nào hỗ trợ giao thức Agent Client Protocol qua stdin và stdout. Không chạy qua shell hệ thống.","ui.agent_chat_denied":"Đã từ chối","ui.agent_chat_deny":"Từ chối","ui.agent_chat_desktop_only":"Tính năng trò chuyện với tác tử yêu cầu ứng dụng máy tính (Desktop).","ui.agent_chat_detecting":"Đang tìm kiếm AI Agent…","ui.agent_chat_dock":"Ghim vào bảng điều khiển bên","ui.agent_chat_dock_left":"Ghim sang bên trái","ui.agent_chat_dock_right":"Ghim sang bên phải","ui.agent_chat_drop_hint":"Thả tệp vào đây để đính kèm vào tin nhắn tiếp theo","ui.agent_chat_edit":"Chỉnh sửa","ui.agent_chat_exited":"Tác tử đã dừng.","ui.agent_chat_failed_start":"AI Agent không thể khởi động: {error}","ui.agent_chat_file_cad_not_read":"{name}: tệp CAD được nhập vào thiết kế, không đọc nội dung","ui.agent_chat_file_empty_picture":"{name}: tệp ảnh trống","ui.agent_chat_file_error":"{name}: {error}","ui.agent_chat_file_heic":"{name}: hình ảnh định dạng HEIC không thể đọc tại đây; hãy xuất sang JPEG hoặc PNG trước","ui.agent_chat_file_importing":"Đang nhập vào thiết kế…","ui.agent_chat_file_kinds":"{name}: có thể đính kèm ảnh (PNG, JPEG, GIF, WebP, BMP, TIFF), tệp văn bản (kể cả SVG) và tệp CAD (STEP, IGES, FreeCAD, Rhino, STL, 3MF, OBJ, glTF)","ui.agent_chat_file_loading":"Đang đọc tệp…","ui.agent_chat_file_not_a_file":"{name}: không phải là tệp hợp lệ","ui.agent_chat_file_not_a_picture":"{name}: không phải là tệp ảnh","ui.agent_chat_file_not_utf8":"{name}: không phải văn bản chuẩn UTF-8","ui.agent_chat_file_picture_too_big":"{name}: tệp ảnh tối đa {max} MB","ui.agent_chat_file_text_too_big":"{name}: tệp văn bản tối đa {max} KB","ui.agent_chat_file_too_large":"{name}: kích thước quá lớn","ui.agent_chat_file_too_large_to_send":"{name}: quá lớn để gửi, ngay cả khi đã thu nhỏ","ui.agent_chat_file_unreadable_picture":"{name}: định dạng ảnh không thể đọc","ui.agent_chat_files":"Tệp đính kèm: {files}","ui.agent_chat_files_left_out":"Tối đa {max} tệp đính kèm trong một tin nhắn; đã bỏ qua: {files}","ui.agent_chat_files_loading":"Đang chờ đọc các tệp đính kèm","ui.agent_chat_files_max":"Tối đa {max} tệp trong một tin nhắn","ui.agent_chat_flatpak_none_found":"Không tìm thấy tác tử lập trình nào. Theo mặc định, hộp cát Flatpak không thấy các tác tử được cài trong thư mục nhà của bạn và không có quyền truy cập mạng. Để cho phép Claude Code và bộ điều hợp ACP của nó được cài qua nvm hoặc trong ~/.local/bin, hãy chạy lệnh này trong terminal, rồi khởi động lại SolidCraft. Lệnh cấp quyền truy cập các chương trình và tệp đăng nhập được liệt kê, cùng quyền truy cập mạng:","ui.agent_chat_import_failed":"{name}: nhập tệp thất bại: {error}","ui.agent_chat_intro":"Trò chuyện với tác tử lập trình (AI agent) bạn đang dùng hoặc một điểm cuối mô hình bạn chọn. AI thao tác trên thiết kế đang mở thông qua các công cụ của SolidCraft: các thay đổi hiển thị ngay khi thực hiện và có thể hoàn tác theo từng bước cho mỗi tin nhắn. Các thao tác AI được phép thực hiện mà không cần hỏi được đặt trong Tùy chọn cài đặt > AI.","ui.agent_chat_key_in_env":"đã đặt khóa","ui.agent_chat_last_missing":"Tác tử dùng gần nhất ({agent}) không còn khả dụng. Hãy chọn một tác tử rồi nhấn “Thử lại”.","ui.agent_chat_left":"Trái","ui.agent_chat_limit":"AI Agent đã đạt giới hạn {limit} thay đổi cho một tin nhắn. Hãy gửi tin nhắn tiếp theo để tiếp tục.","ui.agent_chat_login_found":"đã tìm thấy thông tin đăng nhập","ui.agent_chat_minimize":"Thu nhỏ thành thanh công cụ","ui.agent_chat_mode_all":"Tất cả","ui.agent_chat_mode_ask":"Hỏi","ui.agent_chat_mode_edits":"Chỉnh sửa","ui.agent_chat_model_no_tools":"{model} không thể sử dụng các công cụ của SolidCraft nên chỉ có thể trò chuyện. Hãy chọn mô hình có hỗ trợ công cụ.","ui.agent_chat_model_tip":"Mô hình AI đang sử dụng. Lựa chọn của bạn sẽ được ghi nhớ cho Agent này.","ui.agent_chat_new":"Cuộc trò chuyện mới","ui.agent_chat_new_confirm":"Bắt đầu cuộc trò chuyện mới? Cuộc trò chuyện hiện tại sẽ bị xóa.","ui.agent_chat_next_picture":"Ảnh kế tiếp","ui.agent_chat_no_cli":"Không tìm thấy solidcraft-cli cạnh ứng dụng, vì vậy AI Agent không thể truy cập thiết kế.","ui.agent_chat_no_control":"Điểm cuối trò chuyện của tác tử không thể khởi động, vì vậy AI Agent không thể truy cập thiết kế.","ui.agent_chat_no_images":"AI Agent này không hỗ trợ tiếp nhận hình ảnh","ui.agent_chat_no_picture":"Không có hình ảnh trong bộ nhớ tạm","ui.agent_chat_no_tool_call":"Mô hình không sử dụng các công cụ của SolidCraft nên thiết kế không thay đổi. Hãy chọn mô hình hỗ trợ gọi công cụ; xem mục Mô hình cục bộ trong hướng dẫn trò chuyện AI.","ui.agent_chat_none_found":"Không tìm thấy tác tử lập trình nào. Hãy cài đặt một trong các tác tử sau, rồi nhấn Làm mới:","ui.agent_chat_none_found_short":"Không tìm thấy tác tử nào","ui.agent_chat_not_installed":"Chưa cài đặt","ui.agent_chat_not_signed_in":"chưa đăng nhập","ui.agent_chat_open_settings":"Mở tùy chọn cài đặt","ui.agent_chat_own_window":"Cửa sổ riêng","ui.agent_chat_paste_picture":"Dán hình ảnh","ui.agent_chat_permission":"AI Agent yêu cầu thực thi: {title}","ui.agent_chat_pick":"AI Agent","ui.agent_chat_pick_context":"Chọn ngữ cảnh","ui.agent_chat_pick_context_tip":"Chọn các mặt, cạnh, tính năng và khối trong mô hình để trợ lý kiểm tra, sau đó bấm OK","ui.agent_chat_placeholder":"Yêu cầu AI Agent chỉnh sửa mô hình thiết kế…","ui.agent_chat_placeholder_busy":"Xếp hàng tin nhắn khi AI Agent hoàn thành (Ctrl+Enter: gửi ngay)","ui.agent_chat_pop_out":"Mở trong cửa sổ riêng để bạn có thể di chuyển sang màn hình khác","ui.agent_chat_previous_picture":"Ảnh trước","ui.agent_chat_privacy":"Không có dữ liệu nào được gửi đi bất cứ đâu ngoại trừ tới tác tử bạn chạy, theo tài khoản của chính bạn.","ui.agent_chat_privacy_note":"SolidCraft không gửi bất kỳ dữ liệu nào ra ngoài: AI Agent giao tiếp trực tiếp với dịch vụ bằng tài khoản của bạn. SolidCraft không bao giờ thấy hay lưu khóa/mật khẩu.","ui.agent_chat_provider_models":"{count} mô hình","ui.agent_chat_provider_other":"Khác","ui.agent_chat_provider_tip":"Nhà cung cấp có các mô hình hiển thị trong danh sách tiếp theo.","ui.agent_chat_queue":"Hàng đợi","ui.agent_chat_queue_full":"Quá nhiều tin nhắn đang chờ: hãy xóa bớt hoặc chờ AI hoàn thành.","ui.agent_chat_queued":"Đã vào hàng đợi","ui.agent_chat_queued_stopped":"Đã xếp hàng (đã dừng, chưa gửi)","ui.agent_chat_refresh":"Làm mới","ui.agent_chat_refused":"Không được phép đối với tác tử: {reason}","ui.agent_chat_reinstall":"{agent} đã được cài đặt ({program}) nhưng không khởi động khi SolidCraft kiểm tra: {error}\nBản cài đặt có thể chưa hoàn tất, hoặc dành cho loại máy tính khác. Hãy cài lại bằng `{install}`, kiểm tra rằng nó in ra phiên bản trong terminal, rồi nhấn Làm mới.","ui.agent_chat_remove":"Xóa khỏi hàng đợi","ui.agent_chat_remove_file":"Bỏ tệp này khỏi tin nhắn","ui.agent_chat_remove_imported":"Gỡ khỏi tin nhắn này; chi tiết vẫn nằm trong thiết kế (sử dụng Hoàn tác để xóa)","ui.agent_chat_reply_cut_off":"Câu trả lời đã chạm giới hạn độ dài trước khi xong nên có thể chưa đầy đủ. Hãy yêu cầu AI Agent tiếp tục, hoặc trả lời ngắn hơn.","ui.agent_chat_reply_declined":"Mô hình đã từ chối trả lời tin nhắn này.","ui.agent_chat_retry":"Thử lại","ui.agent_chat_right":"Phải (Hình chiếu cạnh)","ui.agent_chat_save":"Lưu","ui.agent_chat_send":"Gửi","ui.agent_chat_send_now":"Gửi ngay","ui.agent_chat_send_now_tip":"Dừng bước hiện tại của tác tử và gửi tin nhắn này ngay (Ctrl+Enter)","ui.agent_chat_setup_body":"SolidCraft giao tiếp với một tác nhân lập trình được cài đặt trên máy tính này. Chọn một tác nhân trong Tùy chọn cài đặt › AI.","ui.agent_chat_setup_title":"Thiết lập trợ lý","ui.agent_chat_side":"Vị trí bảng trò chuyện AI","ui.agent_chat_signed_in":"đã đăng nhập","ui.agent_chat_state_auth":"Cần đăng nhập","ui.agent_chat_state_busy":"Đang xử lý…","ui.agent_chat_state_exited":"Tác tử đã dừng","ui.agent_chat_state_failed":"Kết nối thất bại","ui.agent_chat_state_off":"Chưa kết nối","ui.agent_chat_state_ready":"Sẵn sàng","ui.agent_chat_state_starting":"Đang khởi động…","ui.agent_chat_stop":"Dừng","ui.agent_chat_stop_tip":"Dừng tác tử và mọi tác vụ nó đã bắt đầu","ui.agent_chat_stop_turn_tip":"Dừng tác tử (Esc). Tin nhắn trong hàng đợi vẫn được giữ nguyên.","ui.agent_chat_turn_limit":"Số thay đổi tối đa mỗi tin nhắn","ui.agent_chat_turn_unlimited":"Không giới hạn","ui.agent_chat_undo_changes":"Hoàn tác các thay đổi này","ui.agent_chat_undo_label":"Trò chuyện AI: {message}","ui.agent_chat_undone":"(hoàn tácne)","ui.agent_chat_view_attached":"Đã đính kèm góc nhìn","ui.agent_chat_waiting":"Đang chờ bạn","ui.agent_cursor":"Con trỏ AI","ui.agent_cursor_speed":"Tốc độ con trỏ AI","ui.agent_off_thread":"Giữ giao diện phản hồi mượt mà khi agent AI thực thi lệnh","ui.agent_off_thread_note":"Các lệnh tốn thời gian của agent (từ bảng AI hoặc MCP client) được tính toán song song ngoài luồng cửa sổ: bạn vẫn có thể xoay và kiểm tra vùng nhìn, và có thể dừng lệnh bất cứ lúc nào từ thẻ trạng thái trong khung nhìn. Khi tắt: mỗi lệnh sẽ chạy trên luồng cửa sổ và cửa sổ sẽ phải chờ cho đến khi hoàn thành.","ui.ai_add":"Thêm","ui.ai_add_agent":"Thêm AI Agent…","ui.ai_add_agent_title":"Thêm AI Agent","ui.ai_add_anthropic":"API tương thích Anthropic","ui.ai_add_api":"API tương thích OpenAI","ui.ai_add_custom":"Lệnh tùy chỉnh","ui.ai_add_endpoint":"Endpoint API","ui.ai_add_installed":"Tác tử đã cài đặt","ui.ai_add_installed_note":"Mục riêng của bạn cho một tác tử đã cài đặt, ví dụ với các tham số bổ sung. Các tác tử đã cài đặt sẽ được liệt kê riêng.","ui.ai_added":"đã thêm","ui.ai_agent_mode_tip":"Chế độ riêng của tác tử: các công cụ riêng của nó (shell dòng lệnh, sửa tệp) tuân theo chế độ này. Các công cụ của SolidCraft tuân theo quyền hạn trong Tùy chọn cài đặt > AI.","ui.ai_agents":"Danh sách AI Agent","ui.ai_always_allow":"Luôn cho phép","ui.ai_always_allow_tip":"Luôn cho phép công cụ {tool} cho Agent này từ nay về sau, không cần hỏi lại","ui.ai_always_allowed":"Luôn được phép","ui.ai_always_allowed_none":"Chưa có quyền nào được đặt luôn cho phép. Các câu trả lời 'Luôn cho phép' bạn chọn trong phần trò chuyện sẽ hiển thị tại đây.","ui.ai_auto_allowed":"Tự động cho phép: {title} ({why})","ui.ai_auto_mode":"cài đặt quyền hạn của bạn","ui.ai_auto_ours":"SolidCraft tự kiểm tra các công cụ nội bộ của mình","ui.ai_auto_remembered":"bạn đã chọn Luôn cho phép","ui.ai_bad_url":"Nhập địa chỉ URL bắt đầu bằng http:// hoặc https://","ui.ai_base_url":"URL cơ sở","ui.ai_button":"AI","ui.ai_command_hint":"my-agent --acp","ui.ai_copy_suffix":"sao chép","ui.ai_custom_url":"URL tùy chỉnh","ui.ai_default":"Mặc định","ui.ai_edit":"Sửa","ui.ai_edit_agent_title":"Sửa AI Agent","ui.ai_edit_gone":"AI Agent này đã bị xóa nên không có gì để lưu.","ui.ai_edit_tip":"Đổi tên, lệnh hoặc endpoint của AI Agent này. Khóa đã lưu vẫn được ẩn.","ui.ai_http_busy":"điểm cuối đang bận hoặc vượt quá giới hạn; vui lòng thử lại sau","ui.ai_http_key":"điểm cuối từ chối khóa API: hãy kiểm tra trong Tùy chọn cài đặt > AI","ui.ai_http_not_found":"không tìm thấy điểm cuối hoặc mô hình: hãy kiểm tra URL cơ sở và tên mô hình","ui.ai_http_too_large":"cuộc trò chuyện quá lớn đối với điểm cuối này; hãy bắt đầu cuộc trò chuyện mới","ui.ai_key":"Khóa API","ui.ai_key_hint":"tùy chọn; lưu trữ bảo mật trong chuỗi khóa hệ thống","ui.ai_key_keep_hint":"để trống để giữ khóa đã lưu","ui.ai_key_needs_https":"Khóa chỉ được gửi qua HTTPS, hoặc trực tiếp trên máy tính này.","ui.ai_key_note":"Được lưu an toàn trong Keychain hệ thống, không lưu trong cài đặt của SolidCraft. Để trống nếu dùng máy chủ cục bộ.","ui.ai_keychain_error":"Chuỗi khóa hệ thống từ chối: {error}","ui.ai_kind":"Loại","ui.ai_mode_all":"Cho phép tất cả","ui.ai_mode_all_note":"Không yêu cầu xác nhận trước. Báo cáo sự cố và các thư mục giới hạn vẫn được bảo vệ.","ui.ai_mode_all_warning":"Tác tử có thể lưu, ghi đè, xuất tệp và thay thế thiết kế của bạn mà không cần hỏi. Chỉ sử dụng chế độ này với tác tử bạn tin tưởng và trên các thiết kế đã được lưu.","ui.ai_mode_ask":"Hỏi mỗi lần","ui.ai_mode_ask_note":"Mọi thay đổi đối với thiết kế và mọi thao tác tệp đều cần bạn xác nhận Cho phép.","ui.ai_mode_edits":"Tự động cho phép chỉnh sửa mô hình","ui.ai_mode_edits_note":"Các lệnh tạo mô hình sẽ chạy mà không cần hỏi; các hành động lưu, mở, xuất và các thao tác tệp hoặc hủy hoại khác vẫn sẽ hỏi ý kiến bạn.","ui.ai_mode_global":"Theo cài đặt bên trên","ui.ai_model":"Mô hình AI","ui.ai_model_hint":"qwen3:14b","ui.ai_modes_scope":"Các cài đặt này áp dụng cho các công cụ của SolidCraft. Công cụ riêng của tác tử (shell hệ thống, chỉnh sửa tệp) tuân theo chế độ riêng của tác tử, được chọn trên thanh tiêu đề bảng điều khiển trò chuyện.","ui.ai_name":"Tên","ui.ai_name_hint":"AI Agent của tôi","ui.ai_need_command":"Nhập lệnh khởi chạy AI Agent","ui.ai_need_model":"Nhập tên mô hình AI","ui.ai_no_answer":"AI Agent không phản hồi kịp thời gian chờ","ui.ai_no_http":"Bản dựng này không thể kết nối tới các điểm cuối API","ui.ai_no_keychain":"Chuỗi khóa hệ thống không khả dụng nên không thể lưu khóa. Máy chủ cục bộ không cần khóa vẫn hoạt động bình thường.","ui.ai_panel":"Bảng điều khiển","ui.ai_permissions":"Quyền hạn","ui.ai_preset":"Mẫu cấu hình sẵn","ui.ai_protocol":"Giao thức","ui.ai_reasoning_effort":"Mức độ suy luận","ui.ai_reasoning_effort_field_hint":"trống = mặc định của nhà cung cấp","ui.ai_reasoning_effort_hint":"Tùy chọn. Được gửi tới điểm cuối dưới dạng `reasoning_effort`; các giá trị được chấp nhận khác nhau tùy nhà cung cấp (ví dụ: `low`, `high` hoặc `max`). Giá trị bạn đặt ở đây không bao giờ bị SolidCraft thay thế. Để trống để không gửi gì và giữ mặc định của nhà cung cấp.","ui.ai_remove":"Xóa","ui.ai_request_timed_out":"Mô hình phản hồi lâu hơn {seconds} giây. Bạn có thể tăng thời gian chờ yêu cầu cho điểm cuối này trong Tùy chọn › Trợ lý.","ui.ai_request_timeout":"Thời gian chờ yêu cầu","ui.ai_request_timeout_hint":"Thời gian tối đa cho một yêu cầu tới điểm cuối này, từ 30 giây đến 1 giờ. Hãy tăng giá trị này đối với mô hình cục bộ xử lý chậm.","ui.ai_reset":"Đặt lại","ui.ai_save":"Lưu","ui.ai_settings":"AI cài đặt…","ui.ai_show_features":"Hiển thị các tính năng AI","ui.ai_show_features_note":"Trò chuyện với tác tử: bảng điều khiển nơi tác tử lập trình hoặc điểm cuối mô hình thao tác trên thiết kế đang mở. Tắt: ẩn nút AI, phím tắt, menu và bảng điều khiển, không tìm kiếm hay khởi chạy tác tử.","ui.ai_switch_tip":"Chuyển đổi AI Agent cho cuộc hội thoại này","ui.ai_test":"Kiểm tra","ui.ai_test_acp_ok":"Phản hồi: {agent}","ui.ai_test_acp_tip":"Khởi động nhanh AI Agent để tạo phiên làm việc; sau đó đóng lại","ui.ai_test_answered":"Đã kết nối: {model} đã phản hồi","ui.ai_test_anthropic_tip":"Gửi một tin nhắn ngắn đến endpoint để kiểm tra kết nối","ui.ai_test_api_tip":"Yêu cầu điểm cuối cung cấp danh sách mô hình","ui.ai_test_no_model":"Đã kết nối: tìm thấy {count} mô hình, nhưng không có {model}","ui.ai_test_ok":"Đã kết nối: tìm thấy {count} mô hình","ui.ai_testing":"Đang kiểm tra…","ui.ai_tool_arguments":"Đối số","ui.ai_tool_details":"Chi tiết","ui.ai_tool_done":"hoàn thành","ui.ai_tool_failed":"thất bại","ui.ai_tool_result":"Kết quả","ui.ai_tool_running":"đang chạy","ui.ai_tool_sum_bodies_one":"{count} thân khối","ui.ai_tool_sum_bodies_other":"{count} thân khối","ui.ai_tool_sum_by":"theo {value}","ui.ai_tool_sum_edge