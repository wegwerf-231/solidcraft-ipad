_point":"Oblouková drážka ze 3 bodů","cmd.sketch_slot_center_point":"Drážka ze středu","cmd.sketch_slot_center_to_center":"Drážka střed–střed","cmd.sketch_slot_overall":"Drážka celkovou délkou","cmd.sketch_snap":"Přichytávání","cmd.sketch_solve":"Vyřešit náčrt","cmd.sketch_spline3d":"3D splajn","cmd.sketch_spline_control_point":"Splajn řídicími body","cmd.sketch_spline_control_point_5":"Splajn řídicími body (stupeň 5)","cmd.sketch_spline_fit_point":"Splajn procházející body","cmd.sketch_spline_insert_point":"Přidat bod splajnu","cmd.sketch_spline_reverse":"Obrátit směr splajnu","cmd.sketch_spun_profile":"Rotační obrys","cmd.sketch_toggle_diameter":"Přepnout poloměr / průměr","cmd.sketch_toggle_driven":"Přepnout řízenou kótu","cmd.sketch_transform":"Transformovat","cmd.sketch_trim_path":"Oříznout podél cesty","cmd.solid_align":"Zarovnat","cmd.solid_boundary_fill":"Vyplnění hranicemi","cmd.solid_bounding_solid":"Obalové těleso","cmd.solid_emboss":"Reliéf","cmd.solid_move":"Posunout/kopírovat","cmd.solid_offset_face":"Odsadit plochu","cmd.solid_press_pull":"Tlačit/táhnout","cmd.solid_remove":"Odstranit","cmd.solid_replace_face":"Nahradit plochu","cmd.solid_rib":"Žebro","cmd.solid_split_face":"Rozdělit plochu","cmd.solid_web":"Výztuha","cmd.surface_blend":"Přechodová plocha","cmd.surface_boundary":"Plocha z hranic","cmd.surface_extrude":"Vysunutí plochy","cmd.surface_fair":"Vyhladit plochu","cmd.surface_fillet":"Zaoblení ploch","cmd.surface_loft":"Plocha spojením profilů","cmd.surface_match":"Napojit plochu","cmd.surface_offset":"Odsadit povrch","cmd.surface_patch":"Záplata","cmd.surface_reverse_normal":"Obrátit normálu","cmd.surface_revolve":"Rotace plochy","cmd.surface_ruled":"Přímková plocha","cmd.surface_stitch":"Sešít","cmd.surface_sweep":"Tažení plochy","cmd.surface_thicken":"Zesílit","cmd.surface_unstitch":"Rozešít","cmd.surface_untrim":"Zrušit oříznutí","cmd.timeline_add":"Přidat zaznamenaný prvek","cmd.timeline_compute_all":"Přepočítat vše","cmd.timeline_copy":"Kopírovat prvky","cmd.timeline_dependents":"Závislé prvky","cmd.timeline_export_script":"Exportovat skript příkazů","cmd.timeline_inspect":"Prozkoumat prvek","cmd.timeline_paste":"Vložit prvky","cmd.timeline_play":"Přehrát historii","cmd.timeline_redefine":"Upravit prvek","cmd.timeline_rename":"Přejmenovat","cmd.timeline_reorder":"Změnit pořadí prvku","cmd.timeline_roll_to":"Přesunout značku historie","cmd.timeline_rollback":"Přesunout značku časové osy","cmd.timeline_stop":"Zastavit historii","cmd.timeline_suppress":"Potlačit prvek","cmd.view.render_browser":"Prohlížeč renderu","cmd.view.render_dock":"Přesunout panel renderu","cmd.view.render_focus":"Soustředěný pohled na render","cmd.view.status_details":"Podrobnosti stavu pohledu","cmd.view.status_items":"Stavové položky pohledu","cmd.view_ambient_occlusion":"Okolní zastínění","cmd.view_angle_readout":"Úhly pohledu","cmd.view_apply":"Obnovit pojmenovaný pohled","cmd.view_back":"Pohled zezadu","cmd.view_bottom":"Pohled zespodu","cmd.view_delete":"Smazat pojmenovaný pohled","cmd.view_fit":"Přizpůsobit","cmd.view_front":"Pohled zepředu","cmd.view_graphics_preset":"Předvolba grafiky","cmd.view_grid":"Mřížka","cmd.view_ground_shadow":"Stín na podložce","cmd.view_home":"Výchozí pohled","cmd.view_isometric":"Izometrický pohled","cmd.view_left":"Pohled zleva","cmd.view_list":"Seznam pojmenovaných pohledů","cmd.view_navigate":"Navigovat pohled","cmd.view_navigation_bar":"Navigační lišta","cmd.view_next_tab":"Další karta","cmd.view_normal_to":"Kolmo k výběru","cmd.view_previous_tab":"Předchozí karta","cmd.view_rename":"Přejmenovat pojmenovaný pohled","cmd.view_render_frame":"Vodítka rámce renderu","cmd.view_right":"Pohled zprava","cmd.view_save":"Nový pojmenovaný pohled","cmd.view_shots_strip":"Pás záběrů","cmd.view_spin":"Nepřetržité otáčení","cmd.view_tool":"Navigační nástroj","cmd.view_top":"Pohled shora","cmd.view_visual_style":"Vizuální styl","color.copy":"Kliknutím zkopírujete hodnoty barvy","color.edit":"Kliknutím upravíte barvu","color.gamma":"Hodnoty barvy v gama prostoru 0–255","color.hex":"Hex","color.hex_help":"Zadejte #rrggbb nebo #rrggbbaa; šest číslic zachová neprůhlednost","color.hex_hint":"#rrggbb","color.hue":"Odstín","color.linear":"Hodnoty barvy v lineárním prostoru 0–1","color.saturation_value":"Sytost a jas","color.selected":"Vybraná barva","config.column_filter_empty":"Žádné odpovídající sloupce","contact.components_count":"Počet komponent: {count}","contact.enabled_label":"povoleno","coupling.gear_1":"Kolo 1","coupling.gear_1_pick":"Kolo 1 (volitelné)","coupling.gear_2":"Kolo 2","coupling.gear_2_pick":"Kolo 2 (volitelné)","coupling.internal":"Vnitřní ozubení","coupling.needs_turn_and_slide":"vyžaduje jeden otočný a jeden posuvný kloub","coupling.needs_turns":"vyžaduje dva otočné klouby","coupling.not_round":"není kruhová plocha","coupling.nut":"Matice","coupling.picked":"vybráno","coupling.pinion":"Pastorek","coupling.pinion_pick":"Pastorek (volitelné)","coupling.pitch":"Stoupání","coupling.rack":"Hřeben","coupling.radius_1":"Poloměr 1","coupling.radius_2":"Poloměr 2","crash.announce":"SolidCraft se minule neočekávaně zavřel nebo narazil na vnitřní chybu. Zpráva o selhání byla uložena (Nápověda > Zprávy o selhání…).","crash.copy_folder":"Kopírovat cestu ke složce","crash.copy_path":"Kopírovat cestu","crash.deleted":"Smazáno zpráv: {count}.","crash.detected_time":"Zjištěno {time} UTC","crash.intro":"Zprávy o selhání zůstávají v tomto počítači a nikam se neodesílají. Příkaz Nahlásit… otevře koncept, který před sdílením zkontrolujete.","crash.kind_command":"Vnitřní chyba v příkazu","crash.kind_internal":"Vnitřní chyba","crash.kind_kernel":"Chyba jádra (obnoveno)","crash.kind_unclean":"Neočekávaně zavřeno","crash.previous_session":"Předchozí relace SolidCraftu skončila neočekávaně nebo narazila na vnitřní chybu. Zprávy o nekorektním ukončení se zjišťují při spuštění. Podrobnosti viz Nápověda > Zprávy o selhání…","crash.replayable":"lze přehrát","crash.report":"Nahlásit…","crash.unclean_explanation":"Zjištěno při pozdějším spuštění; přesný čas ukončení nebyl zaznamenán. Nekorektní ukončení může způsobit i vypnutí systému nebo vynucené zastavení.","delete.and_more":"… a další ({count})","diagnostic.empty_boolean_component":"v komponentě '{component}' není žádné těleso k vyjmutí ani k průniku; nástroj se může překrývat s tělesem '{body}' v komponentě '{other}' — aktivujte tuto komponentu nebo vyberte těleso jako cíl","dialog.bodies_count":"Počet těles: {count}","dialog.clearance_invalid":"vůle musí být délka 0 nebo větší","dialog.compute":"Vypočítat","dialog.compute_again":"Vypočítat znovu","dialog.computing":"Výpočet… {seconds} s","dialog.could_not_be_checked":"nelze zkontrolovat","dialog.custom_axis":"↖ Vlastní osa","dialog.dimension_insert_hint":"Dvojklikem na jiný řídicí kótu vložíte jeho název","dialog.dimension_name":"Kóta: {name}","dialog.edit_title":"UPRAVIT {title}","dialog.no_shown_body":"Není zobrazeno žádné těleso ke změně: zobrazte nějaké nebo zvolte Nové těleso","dialog.select":"↖ Vybrat","dialog.selected_count":"↖ Vybráno: {count}","dialog.selection_guidance":"Vstup změníte jeho výběrem. Kliknutím na vybraný objekt jej odeberete; Ctrl/Cmd+klik výběr také přepíná. Zkontrolujte náhled a stiskněte OK.","dialog.selection_step":"{step} z {total}: Vyberte {input}","dialog.step":"Krok","document.changed_on_disk":"Soubor {name} byl změněn na disku","document.changed_on_disk_detail":"Soubor {name} byl od jeho otevření nebo posledního uložení změněn jiným programem nebo počítačem. Přepsat nahradí tyto změny těmi vašimi; Uložit kopii zachová obojí.","document.copy_name":"{name} kopie","document.open_anyway":"Přesto otevřít","document.open_elsewhere":"Soubor {name} je již otevřen","document.open_elsewhere_detail":"Soubor {name} je otevřen v aplikaci SolidCraft {app} na {who}, otevřeno {when}. Pokud oba uložíte, jeden z vás přijde o práci. Otevřete jej jen pro čtení, abyste si jej mohli prohlédnout bez přepsání.","document.open_read_only":"Otevřít jen pro čtení","document.opened_read_only":"Otevřeno jen pro čtení: Uložit se zeptá na nový soubor","document.overwrite":"Přepsat","document.read_only_save":"Tento návrh byl otevřen jen pro čtení: uložte jej jako nový soubor","document.save_changes":"Uložit změny v {name}?","document.save_copy":"Uložit kopii…","document.unsaved_changes":"{name} obsahuje neuložené změny. Pokud je neuložíte, budou ztraceny.","drive.rigid":"{joint} je pevný kloub: drží své díly na místě, takže není co pohánět. Aby se mohly pohybovat, změňte jeho typ v Upravit kloub: Otočný pro otáčení, Posuvný pro posuv, Válcový pro obojí.","drive.stopped_by_contact":"Zastaveno na {value}: {a} by prošlo skrz {b}","drive.stopped_by_loop":"Zastaveno na {value}: smyčku přes {joint} už nelze dále uzavřít","drive.unconnected":"Nic se nepohne: {part} není spojeno s ničím ukotveným","dxf.cancel_wait":"Čekání na zastavení exportu…","dxf.cancelled":"Export DXF zrušen","dxf.cancelling":"Rušení exportu DXF","dxf.exporting":"Export do DXF","dxf.invalid_tolerance":"Tolerance křivek musí být mezi 0,0001 a 1 mm.","dxf.progress.index":"Příprava ploch (2/5)","dxf.progress.meshes":"Příprava sítí (1/5)","dxf.progress.occlusion":"Řešení skrytých čar (4/5)","dxf.progress.projection":"Promítání geometrie (3/5)","dxf.progress.write":"Zápis DXF (5/5)","dxf.tolerance":"Tolerance křivek","dxf.tolerance_help":"Pouze viditelná tělesa a zobrazené náčrty. Křivky jsou nahrazeny úsečkami. Menší tolerance dává jemnější křivky, ale zabere více času a paměti.","each rail's curves must be in one sketch":"křivky každé vodicí křivky musí být v jednom náčrtu","feature computation ended without a result":"výpočet prvku skončil bez výsledku","file.open.drawing_filter":"Návrhy, soubory CAD, sítě a výkresy","file_load.built":"Dosud sestaveno: {built} z {total} prvků.","file_load.converting":"Převod tělesa {done} z {total}","file_load.inserting":"Vkládání geometrie","file_load.link_item":"{name} ({done} z {total})","file_load.opening":"Otevírání návrhu","file_load.preparing_thumbnail":"Příprava náhledu...","file_load.preparing_view":"Příprava pohledu...","file_load.preview_note":"Uložený náhled. Před úpravami se kontroluje geometrie.","file_load.reading":"Čtení souboru...","file_load.reading_percent":"Čtení souboru... {percent} %","file_load.rebuilding":"Přestavba prvku {done} z {total}","file_load.recovering":"Obnova návrhu","file_load.stopping":"Čekání na zastavení předchozí operace...","file_load.updating_links":"Aktualizace odkazů","file_load.waiting":"Čekání na operaci se souborem","fits the face, e.g. M8":"odpovídá ploše, např. M8","from the profile":"z profilu","from the rule":"z pravidla","help.apache":"Licence Apache 2.0","help.appearance.assign":"Přiřadí vybraným tělesům, plochám nebo komponentám barvu nebo vzhled materiálu, aniž by se změnila jejich hmotnost. Hodí se k rozlišení dílů nebo k náhledu povrchové úpravy.","help.assembly.bom":"Vypíše díly návrhu nebo komponenty s jejich počty podle čísla dílu a může seznam uložit jako CSV nebo JSON. Použijte ho jako soupis dílů pro objednávání a montáž.","help.attributions":"Uvedení autorství (ATTRIBUTION.md)","help.build":"Verze {version} · commit {commit} · sestaveno {date}","help.canvas.decal":"Umístí obrázek na rovinnou plochu modelu jako nálepku. Hodí se k zobrazení štítku, loga nebo potištěného vzoru na dílu.","help.canvas.edit":"Změní plátno: jeho polohu, velikost, úhel, neprůhlednost, zrcadlení, viditelnost nebo název. Hodí se k zarovnání referenčního obrázku s náčrtem, který podle něj obkreslujete.","help.canvas.insert":"Umístí obrázek PNG nebo JPEG na rovinu nebo plochu jako průhlednou referenci. Hodí se k obkreslení fotografie nebo výkresu v náčrtu, přičemž obrázek má zadanou známou velikost.","help.component.break_link":"Odpojí propojenou komponentu od souboru návrhu a ponechá její tělesa beze změny. Použijte to, když už má díl přestat sledovat změny původního souboru.","help.component.capture_position":"Zachová polohy dílů, které jste přesunuli ručně, takže se stanou jejich novými polohami. Použijte to po přetažení dílů na místa, kde je žádný kloub nedrží.","help.component.create":"Přidá do návrhu novou prázdnou komponentu, a to do aktivní komponenty, pokud nezvolíte jinou nadřazenou. Použijte to, aby nový díl sestavy měl vlastní místo pro tělesa a náčrty.","help.component.finish_edit":"Uloží díl upravovaný na místě, vrátí se do jeho sestavy a aktualizuje sestavu podle něj. Použijte ho, až jsou vaše změny propojeného dílu hotové.","help.component.from_bodies":"Změní každé vybrané těleso na samostatnou komponentu pojmenovanou podle tělesa. Použijte to, když se návrh vytvořený z volných těles má stát sestavou, jejíž díly lze spojovat a přesouvat.","help.component.insert_design":"Vloží jiný uložený návrh jako komponentu propojenou s jeho souborem, s tělesy umístěnými tak, jak jsou v něm. Použijte to k opětovnému použití dílu v sestavě a k převzetí pozdějších změn příkazem Aktualizovat odkazy.","help.component.properties":"Zobrazí objem, hmotnost, těžiště a momenty setrvačnosti komponenty podle materiálů jejích těles. Použijte to ke kontrole hmotnosti a vyvážení sestavy.","help.component.revert_position":"Vrátí ručně přesunuté díly na původní místo a zahodí přesuny, které nebyly zachyceny. Použijte to k vrácení zkušebních přesunů v sestavě.","help.component.update_links":"Znovu načte propojené soubory návrhů a nahradí tělesa, která se změnila. Použijte to po úpravě dílu, který tato sestava používá.","help.config.configure":"Přidá parametry, prvky, materiály nebo vzhledy jako sloupce tabulky konfigurací. Použijte to k vytvoření variant jednoho návrhu, například velikostí dílu.","help.config.preview":"Ověří, že se řádek tabulky konfigurací přestaví, aniž by změnil návrh nebo jeho historii. Použijte to před přepnutím na variantu, u které si nejste jisti.","help.config.rules":"Zobrazí pravidla tabulky konfigurací, její řádky a to, který řádek je aktivní. Použijte to, abyste viděli, jak jsou varianty návrhu nastaveny.","help.config.table":"Zobrazí tabulku konfigurací: jeden řádek na variantu, jeden sloupec na parametr nebo prvek a informaci, zda návrh stále odpovídá aktivnímu řádku. Použijte to ke kontrole variant návrhu.","help.connect_note":"Restartujte každého asistenta, aby se načetl server SolidCraft. Každý soubor byl před změnou zálohován jako .bak.","help.connect_title":"Připojit AI asistenty","help.construct.axis.edge":"Vytvoří konstrukční osu podél přímé hrany nebo úsečky náčrtu. Použijte ji jako osu pro rotaci, kruhové pole nebo kloub.","help.construct.axis.normal_to_face":"Vytvoří konstrukční osu procházející bodem a kolmou k ploše. Použijte ji jako osu, která vychází přímo z povrchu.","help.construct.axis.through_cylinder":"Vytvoří konstrukční osu středem válcové, kuželové nebo anuloidní plochy, nebo kruhové hrany. Použijte to k otáčení prvků nebo jejich rozmístění v poli kolem kulatého dílu.","help.construct.axis.two_planes":"Vytvoří konstrukční osu tam, kde se protínají dvě roviny nebo rovinné plochy. Použijte to, když je potřebná osa průsečnicí dvou ploch.","help.construct.axis.two_points":"Vytvoří konstrukční osu procházející dvěma body, vrcholy nebo body náčrtu. Použijte ji pro osu vedoucí mezi dvěma známými polohami.","help.construct.plane.along_path":"Vytvoří konstrukční rovinu kolmou k hraně nebo křivce v zadané poloze podél ní. Použijte to k náčrtu profilu pro tažení nebo příčného řezu podél cesty.","help.construct.plane.at_angle":"Vytvoří konstrukční rovinu natočenou o úhel od roviny nebo plochy kolem osy nebo hrany. Použijte ji pro šikmé náčrty, například u úhlového držáku.","help.construct.plane.midplane":"Vytvoří konstrukční rovinu uprostřed mezi dvěma rovinami nebo rovinnými plochami, nebo rovinu půlící jejich úhel, když se protínají pod úhlem. Použijte ji jako rovinu souměrnosti pro zrcadlení.","help.construct.plane.offset":"Vytvoří konstrukční rovinu rovnoběžnou s rovinou nebo rovinnou plochou ve zvolené vzdálenosti nebo procházející bodem. Použijte ji k náčrtu v dané výšce nad plochou.","help.construct.plane.perpendicular":"Vytvoří konstrukční rovinu, která obsahuje přímku nebo hranu a je kolmá k rovině nebo ploše. Použijte ji k náčrtu kolmo na model podél hrany.","help.construct.plane.tangent":"Vytvoří konstrukční rovinu, která se v bodě dotýká válce, kužele, koule nebo anuloidu. Použijte ji k náčrtu na boku kulatého dílu.","help.construct.plane.three_points":"Vytvoří konstrukční rovinu procházející třemi body. Použijte ji pro rovinu danou polohami na modelu, například třemi rohy.","help.construct.plane.two_edges":"Vytvoří konstrukční rovinu procházející dvěma přímými hranami nebo úsečkami, které leží v jedné rovině. Použijte ji pro rovinu napříč dílem, například vedenou dvěma protilehlými hranami.","help.construct.point.along_path":"Vytvoří konstrukční bod v zadané poloze podél hrany nebo křivky. Použijte ho jako referenci někde uprostřed cesty.","help.construct.point.center":"Vytvoří konstrukční bod ve středu kruhové hrany, kružnice nebo oblouku náčrtu, koule nebo anuloidu. Použijte ho jako referenci pro otvory, osy a klouby.","help.construct.point.edge_plane":"Vytvoří konstrukční bod tam, kde hrana nebo úsečka prochází rovinou nebo rovinnou plochou. Použijte ho k označení místa, kde cesta protíná rovinu.","help.construct.point.three_planes":"Vytvoří konstrukční bod tam, kde se protínají tři roviny nebo rovinné plochy. Použijte ho jako referenci rohu i tam, kde model žádný vrchol nemá.","help.construct.point.two_edges":"Vytvoří konstrukční bod tam, kde se dvě hrany nebo úsečky protínají nebo si jsou nejblíže. Použijte ho jako referenci ve virtuálním rohu.","help.construct.point.vertex":"Vytvoří konstrukční bod ve vrcholu nebo v bodě náčrtu. Použijte ho jako referenci, která zůstane, i když se náčrt nebo těleso kolem něj skryje.","help.contact.check":"Vypíše dvojice dílů v sadách kontaktů, které se v aktuální poloze navzájem prostupují. Použijte to k nalezení kolizí dříve, než začnete pohánět klouby nebo spustíte studii pohybu.","help.contact.create":"Seskupí dva nebo více dílů do sady kontaktů, jejíž tělesa se při pohybu kloubů nesmějí prostupovat. Použijte to pro díly, které se mají při dotyku zastavit, například páku o její zarážku.","help.contact.disable_all":"Vypne kontakt, takže poháněné klouby a studie pohybu se už nezastavují tam, kde se díly dotýkají. Použijte to, aby se díly zase mohly pohybovat volně, nebo aby velká sestava zůstala svižná.","help.contact.edit":"Změní sadu kontaktů: díly v ní, její název nebo zda je potlačená; sadu lze také smazat. Použijte to k úpravě toho, které díly se nesmějí prostupovat.","help.contact.enable_all":"Vloží všechny díly sestavy do jedné sady kontaktů, takže se žádné dva díly nemohou při pohybu kloubů prostupovat. Použijte to pro rychlou kontrolu celého mechanismu.","help.contact.enable_sets":"Zapne kontakt pro vámi definované sady kontaktů, takže poháněné klouby a studie pohybu se zastaví tam, kde by se jejich díly prostoupily. Použijte to k obnovení svých sad po vypnutí kontaktu.","help.contact.list":"Vypíše sady kontaktů návrhu, díly v každé z nich a informaci, zda je kontakt zapnutý. Použijte to ke kontrole nastavení kontaktu před poháněním sestavy.","help.document.inspect":"Zobrazí přehled návrhu: jeho komponenty, tělesa, náčrty, prvky a parametry. Použijte to, abyste se zorientovali v návrhu, který jste nevytvořili sami.","help.document.units":"Změní jednotky, ve kterých návrh zobrazuje délky, například mm nebo palce. Geometrie si zachová velikost; řídí se jimi jen zobrazení a holá čísla.","help.edit.checkpoint":"Zapamatuje si návrh, aktivní náčrt a historii vrácení zpět tak, jak jsou nyní. Použijte to před zkoušením něčeho riskantního, od čeho se možná budete chtít vrátit.","help.edit.restore_checkpoint":"Vrátí se ke kontrolnímu bodu, včetně historie vrácení zpět. Použijte to k zahození všeho, co se od kontrolního bodu udělalo, jedním krokem.","help.explode.create":"Vytvoří rozložený pohled, který odsune díly od středu sestavy nebo o zadané posuny. Použijte to k ukázce, jak se sestava skládá, pro návody nebo prezentace.","help.face.delete":"Odstraní vybrané plochy a nechá sousední plochy uzavřít mezeru, nebo mezeru ponechá otevřenou jako plochu. Hodí se k odstranění zaoblené hrany, otvoru nebo nálitku, které překážejí.","help.file.insert_mesh":"Přidá soubor 3MF, STL, OBJ, PLY nebo glTF do návrhu jako síťová tělesa v nové komponentě. Použijte to k umístění staženého nebo naskenovaného modelu vedle návrhu jako reference.","help.file.insert_step":"Přidá soubor STEP, IGES, FreeCAD nebo Rhino do návrhu jako plná tělesa v nové komponentě; díly sestavy se stanou vnořenými komponentami. Použijte to k převzetí modelů od dodavatelů nebo z jiných CAD programů.","help.file.save_mesh":"Uloží tělesa jako síť STL, 3MF nebo OBJ s vámi zvolenou hladkostí zakřivených ploch. Použijte to k přípravě dílů pro 3D tisk nebo pro programy, které čtou sítě.","help.file.send_to_slicer":"Uloží vybraná tělesa jako soubor 3MF a otevře jej ve zvoleném sliceru. Použijte to k přechodu od modelu k tisku jedním krokem.","help.font_details":"Rozhraní používá vestavěná písma egui (Ubuntu Light a Hack pod licencemi Ubuntu Font Licence a MIT/Bitstream Vera; Noto Emoji a písmo ikon emoji pod licencemi OFL a MIT). Text náčrtu používá Liberation Sans (SIL OFL 1.1). Volitelný balíček písem craft-fonts od The Crafting Apps (BIZ UDPGothic, Shippori Mincho, BIZ UDMincho, Noto Sans CJK SC, Noto Sans Arabic; SIL OFL 1.1) není součástí sestavení SolidCraft.","help.fonts":"Písma","help.frame.member":"Umístí profil, například trubku nebo hliníkový profil, podél úseček náčrtu rámu, jeden prvek na každou úsečku. Použijte to k vytváření rámů, regálů a svařovaných konstrukcí.","help.inspect.accessibility":"Obarví plochy, ke kterým se nástroj dostane z jednoho směru, a ty, ke kterým ne. Použijte to ke kontrole dílu pro obrábění nebo lisování z této strany.","help.inspect.center_of_mass":"Zobrazí těžiště těles, každého zvlášť i všech dohromady, při rovnoměrné hustotě. Použijte to ke kontrole vyvážení a místa, kde se díl převrátí.","help.inspect.colored_components":"Dá každé komponentě vlastní dočasnou barvu, aniž by změnil vzhledy. Použijte to k rychlému rozlišení dílů sestavy.","help.inspect.compare":"Porovná dvě tělesa a ukáže, kde jedno má materiál, který druhé nemá, s objemem a odchylkou. Použijte to ke kontrole změněného nebo importovaného dílu proti originálu.","help.inspect.continuity":"Zkontroluje, jak hladce plochy navazují podél hran: mezery, zlomy nebo skoky křivosti, a spoje obarví. Použijte to k nalezení míst, kde se povrchy nespojují čistě.","help.inspect.curvature_comb":"Nakreslí hřebeny podél křivek, hran nebo ploch, jejichž zuby ukazují, jak silně se ohýbají. Použijte to k odhalení plochých míst, zlomů a nerovnoměrné křivosti.","help.inspect.curvature_map":"Obarví plochy podle toho, jak silně jsou zakřivené, červeně tam, kde je poloměr malý. Použijte to k nalezení těsných míst a k posouzení hladkosti povrchu.","help.inspect.draft":"Obarví plochy podle jejich úhlu úkosu vůči směru vyjímání a označí ty s příliš malým úkosem. Použijte to ke kontrole dílu před lisováním nebo odléváním.","help.inspect.environment_map":"Zobrazí model s odrazivým, zrcadlovým povrchem. Použijte to k posouzení průběhu ploch podle toho, jak po nich probíhají odrazy.","help.inspect.interference":"Najde tělesa, která se překrývají, a ukáže každé překrytí s jeho objemem. Použijte to ke kontrole sestavy, zda v ní nejsou kolidující díly.","help.inspect.isocurve":"Nakreslí izoparametrické křivky ploch, tedy mřížku, na které je povrch postaven. Použijte to k zobrazení toho, jak povrch plyne a kde se zhušťuje.","help.inspect.measure":"Změří délky, vzdálenosti, úhly, obsahy a poloměry mezi vybranými objekty, nebo objem a hmotnost těles. Použijte to ke kontrole rozměrů a vůlí.","help.inspect.minimum_radius":"Najde nejmenší poloměr křivosti křivek, hran nebo ploch a místo, kde se nachází. Použijte to ke kontrole, zda tvar dokáže sledovat nástroj nebo tryska.","help.inspect.section":"Rozřízne pohled podél roviny a vyšrafuje řezné plochy, aniž by změnil model. Použijte to k nahlédnutí dovnitř dílů a sestav.","help.inspect.zebra":"Zobrazí na plochách modelu odražené černobílé pruhy. Použijte to k posouzení hladkosti: pruhy, které se na hraně přeruší nebo zlomí, ukazují špatný přechod.","help.joint.as_built":"Spojí dva díly tam, kde už jsou, aniž by některý přesunul, a nastaví, jak se mohou dál pohybovat. Použijte to pro díly, které jste už umístili do konečné polohy.","help.joint.cam":"Spojí otáčející se vačku se zdvihátkem, které se posouvá nebo kývá podle toho, jak pod ním prochází obrys vačky. Použijte to pro vačky, excentry a rozvody ventilů.","help.joint.create":"Spojí dva díly ve zvolených počátcích kloubu a přesune druhý díl na místo; typ kloubu určuje, jak se mohou dál pohybovat. Použijte to k sestavení sestavy, jejíž díly se pohybují jako skutečný mechanismus.","help.joint.drive":"Nastaví úhel nebo vzdálenost kloubu a pohne s ním díly v rámci jeho limitů; propojené klouby a uzavřené smyčky ho následují. Použijte to ke kontrole, zda se mechanismus pohybuje, jak má.","help.joint.gear":"Spojí dva otáčející se klouby převodovým poměrem, takže pohon jednoho otáčí druhým. Použijte to pro čelní a vnitřní ozubená kola; poměr se vezme z poloměrů roztečných kružnic nebo z počtu zubů.","help.joint.limits":"Nastaví, jak daleko se kloub smí otočit nebo posunout, jako minimum a maximum, nebo tyto limity zruší. Použijte to, aby závěs, posuvný člen nebo páka zůstaly ve svém skutečném rozsahu pohybu.","help.joint.motion_link":"Spojí dva klouby poměrem a posunutím, takže pohon jednoho pohne druhým. Použijte to pro pevný vztah mezi klouby, který nepokrývají Ozubený převod, Hřeben a pastorek ani Šroubový pohyb.","help.joint.origin":"Umístí na díl pojmenovaný počátek kloubu: do středu plochy nebo kulatého konce, do poloviny hrany, do rohu nebo do bodu. Použijte to k přípravě míst, kde se klouby upevní; počátek zvolený na ploše ji sleduje, když se díl změní co do velikosti.","help.joint.rack_pinion":"Spojí otáčející se pastorek s posuvným hřebenem tak, že se hřeben posune o délku roztečné kružnice, po které se pastorek odvalí. Použijte to pro hřebenové pohony, řízení a lineární stolky.","help.joint.reach":"Přesune bod na dílu k cíli změnou kloubů na jeho řetězci v rámci jejich limitů. Použijte to k nastavení polohy mechanismu podle toho, kde má být jeho konec, například hrot ramene robota.","help.joint.rigid_group":"Pevně spojí vybrané díly tak, jak jsou, takže se pohybují jako jeden. Použijte to pro díly, které k sobě patří a nemají mezi sebou žádný pohyb.","help.joint.screw":"Spojí otáčení a posuv stoupáním, takže každé otočení posune díl o tuto vzdálenost. Použijte to pro pohybové šrouby, šrouby a závitová vřetena.","help.library.apply":"Použije materiál nebo vzhled ze souboru místní knihovny na tělesa, plochy nebo komponenty. Použijte to k opětovnému použití materiálů uložených z jiného návrhu.","help.library.export":"Uloží materiály a vzhledy návrhu do souboru knihovny. Použijte to ke sdílení nebo k jejich opětovnému použití v jiných návrzích.","help.library.inspect":"Zkontroluje soubor knihovny a vypíše jeho materiály a vzhledy, aniž by změnil návrh. Použijte to, abyste před použitím viděli, co knihovna obsahuje.","help.licences":"Licence","help.material.assign":"Určí, z čeho jsou vybraná tělesa vyrobena, například z oceli, hliníku nebo ABS. Hodí se k tomu, aby hmotnost a tíha odpovídaly skutečnému dílu.","help.material.properties.validate":"Zkontroluje kartu dat materiálu na shodu čísel a chybějící hodnoty. Použijte to dříve, než se na data spolehnete při výpočtu hmotnosti nebo tuhosti.","help.mesh.convert":"Přestaví síťové těleso, například STL, na upravitelné plné těleso s rovinnými a válcovými plochami. Použijte to k úpravě importovaných strojních dílů jako modelovaného tělesa.","help.mit":"Licence MIT","help.motion.study":"Nastaví hodnoty kloubů v krocích na časové ose a přehraje je jako animaci. Použijte to ke sledování pohybu mechanismu v posloupnosti a ke kontrole vůlí po cestě.","help.motion.trace":"Sleduje dráhu, kterou opisuje bod na dílu při přehrávání studie pohybu nebo při poháněném kloubu, a po potvrzení ji uloží jako křivku 3D náčrtu. Použijte to k zobrazení dosahu mechanismu nebo k vytváření dalších prvků na jeho dráze.","help.notice":"NOTICE","help.occurrence.ground":"Ukotví díl na místě, nebo ho znovu uvolní, aby klouby pohybovaly ostatními díly kolem něj. Použijte to pro rám nebo základnu, na které je zbytek sestavy postaven.","help.occurrence.move":"Posouvá díl sestavy jen v těch stupních volnosti, které povolují jeho klouby. Vyberte plochu dílu a pak táhněte za dostupnou šipku nebo oblouk.","help.parameters.change":"Otevře tabulku pojmenovaných hodnot a výrazů, které řídí rozměry návrhu. Hodí se ke změně rozměru na jednom místě, kterou převezmou všechny prvky, jež jej používají.","help.parameters.export":"Uloží parametry návrhu jako CSV nebo JSON. Použijte to k jejich úpravě v tabulkovém procesoru nebo k přenosu do jiného návrhu.","help.parameters.graph":"Ukáže, které parametry a prvky používají které jiné, a případné smyčky nebo chyby mezi nimi. Použijte to, abyste viděli, co změna parametru ovlivní.","help.parameters.import":"Načte parametry z CSV nebo JSON do návrhu, buď všechny, nebo žádný z nich. Použijte to k převzetí hodnot z tabulky nebo jiného návrhu.","help.parameters.move":"Přesune uživatelský parametr před jiný nebo za jiný v seznamu. Použijte to, aby související parametry zůstaly pohromadě.","help.parts.fastener":"Přidá normalizovaný šroub, svorník, matici, podložku, kolík nebo ložisko ve zvolené velikosti. Po umístění na otvor se do něj pomocí kloubu usadí, takže spojovací prvky nemusíte modelovat sami.","help.parts.insert":"Vloží normalizovaný díl ve zvolené řadě, velikosti a délce. Po umístění na okraj nebo stěnu otvoru se na otvor usadí pevným kloubem.","help.parts.library":"Otevře normalizované díly: šrouby, svorníky, matice, podložky, stavěcí šrouby, kolíky a ložiska v normalizovaných velikostech. Použijte to k přidání normalizovaného dílu místo jeho vlastního modelování.","help.parts.resize":"Změní velikost nebo délku vloženého normalizovaného dílu a přestaví jej; jeho klouby ho drží usazený. Použijte to, když se ukáže, že je šroub příliš dlouhý nebo že otvor potřebuje jinou velikost.","help.plastic.assign_rule":"Přiřadí tělesům pravidlo pro plasty, takže jejich plastové prvky přebírají jeho úkos a vůli jako výchozí hodnoty. Použijte to k nastavení lisovaného dílu jednou pro všechny jeho prvky.","help.plastic.boss":"Přidá na plochu nálitek pro šroub: sloupek s volitelným otvorem, úkosem, zaoblením u paty a podpůrnými žebry. Použijte to pro šroubové body v lisovaných nebo tištěných krytech.","help.plastic.lip":"Přidá osazení nebo odpovídající drážku podél okraje tělesa vytvořeného skořepinou. Použijte to, aby se dvě poloviny krytu navzájem zaměřily a těsně se zavřely.","help.plastic.manage_rules":"Vytvoří a upraví pravidla pro plasty: materiál, tloušťku stěny, poloměry, vůli a úkos. Použijte je k tomu, aby prvky lisovaného dílu byly jednotné.","help.plastic.rest":"Přidá na plochu opěrku: kulatou nebo obdélníkovou podložku, plnou nebo dutou, s úkosem. Použijte ji jako podporu nebo distanční sloupek v lisovaném krytu.","help.plastic.snap_fit":"Přidá na plochu zacvakávací hák se zadanou délkou, tloušťkou a západkou. Použijte to k sepnutí dílů bez šroubů.","help.pointcloud.insert":"Vložte sken PLY, XYZ nebo PTS jako mračno bodů vedle modelu. Použijte ho jako referenci při tvorbě modelu z naměřených dat.","help.sheet.convert":"Změní desku nebo těleso se skořepinou stejné tloušťky na plechové těleso s ohyby na zvolených hranách. Použijte to, aby šel existující díl rozvinout.","help.sheet.export_bend_table":"Uloží tabulku ohybů plechového tělesa jako CSV nebo JSON: úhly, poloměry a polohy ohybů v rozvinu. Použijte to pro ohraňovací lis nebo dílnu.","help.sheet.export_dxf":"Uloží rozvin jako DXF s obrysy, čarami ohybů a volitelnými poznámkami k ohybům. Použijte to pro řezání laserem, plazmou nebo vodním paprskem.","help.sheet.flange":"Přidá přírubu: základní desku z náčrtu, stěnu podél otevřené kontury náčrtu nebo ohnutou stěnu na hranách plechu. Použijte to k vytváření plechových dílů.","help.sheet.flat_pattern":"Vytvoří rozvin plechového tělesa s jeho velikostí, výřezy a čárami ohybů. Použijte to ke kontrole polotovaru před řezáním.","help.sheet.fold":"Ohne plech podél úsečky náčrtu o zadaný úhel a poloměr. Použijte to k ohnutí plochého plechu poté, co do něj vyřežete prvky.","help.sheet.hem":"Přehne okraj plechu zpět na sebe. Použijte to pro bezpečné, tuhé okraje bez ostrých otřepů.","help.sheet.manage_rules":"Vytvoří a upraví pravidla pro plech: tloušťku, poloměr ohybu, K-faktor, odlehčení a mezery. Použijte je, aby odpovídala materiálu a nástrojům vaší dílny.","help.sheet.path_flange":"Přidá řetěz přírub podél hrany plechu podle otevřeného řetězce úseček náčrtu. Použijte to pro profily, například tvar U nebo Z, jedním krokem.","help.sheet.perforate":"Přidá pole otvorů přes celý plochý plech ve střídavém nebo čtvercovém rozložení. Použijte to pro větrací otvory, mřížky a odlehčené panely.","help.sheet.refold":"Znovu ohne rozvinuté plechové těleso zpět. Použijte to po přidání prvků do plochého plechu.","help.sheet.unfold":"Rozvine všechny ohyby plechového tělesa. Použijte to k přidání otvorů nebo výřezů, které musí překračovat ohyb, a pak plech znovu ohněte.","help.sketch.arc.center_point":"Nakreslí kruhový oblouk kolem středu, od počátečního bodu ke koncovému. Použijte to, když je střed oblouku známý, například poloměr kolem otvoru nebo čepu.","help.sketch.arc.tangent":"Nakreslí oblouk, který začíná na konci úsečky nebo oblouku a pokračuje tečně k němu. Použijte to k pokračování řetězce hladkým ohybem místo rohu.","help.sketch.arc.three_point":"Nakreslí oblouk od počátečního bodu ke koncovému přes třetí bod. Použijte to, když oblouk musí procházet zadanými body, a ne kolem známého středu.","help.sketch.arc3d":"Nakreslí přesný kruhový oblouk v prostoru třemi body, se zapnutým 3D náčrtem. Použijte to pro ohyby cest a vodicích drah, které opouštějí rovinu náčrtu.","help.sketch.auto_constrain":"Přidá vazby, které náčrt už skoro má, například vodorovnost, rovnoběžnost nebo totožnost, a pak jej okótuje, dokud není plně určen. Použijte to k zamknutí zhruba nakresleného náčrtu jedním krokem.","help.sketch.auto_constrain_from_datum":"Funguje jako Automatické vazby, ale polohy měří od zvoleného referenčního bodu místo počátku. Použijte to, když je díl rozvržen od jednoho referenčního bodu, například rohu nebo otvoru.","help.sketch.blend_curve":"Spojí konce dvou křivek hladkým splajnem, který je tečný k oběma, nebo na přání i spojitý v křivosti. Použijte to k překlenutí mezery mezi křivkami bez zlomu.","help.sketch.break":"Rozdělí křivku na části tam, kde ji kříží jiné křivky, nebo v bodech, které na ni umístíte. Použijte to, když část křivky potřebuje vlastní vazbu nebo se má smazat samostatně.","help.sketch.cancel":"Opustí náčrt a zahodí vše, co se změnilo od jeho vytvoření nebo otevření k úpravám. Zpět změny vrátí.","help.sketch.centerline":"Přepíná úsečky mezi běžnými úsečkami a osami, které profily vynechávají. Použijte osu jako osu rotace, zrcadlení nebo vazby symetrie.","help.sketch.chamfer.distance_angle":"Zkosí roh mezi dvěma úsečkami podle vzdálenosti podél první úsečky a úhlu. Použijte to, když výkres udává sražení jako délku a úhel, například 2 mm × 30°.","help.sketch.chamfer.equal_distance":"Zkosí roh mezi dvěma úsečkami ve stejné vzdálenosti zpět podél obou. Použijte to pro obvyklé sražení 45° na obrysu.","help.sketch.chamfer.two_distance":"Zkosí roh mezi dvěma úsečkami podle samostatné vzdálenosti podél každé úsečky. Použijte to pro sražení jiná než 45°, zadaná dvěma délkami.","help.sketch.circle.center":"Nakreslí kružnici ze středu a průměru. Použijte to pro otvory, nálitky a jiné kulaté prvky se známým středem.","help.sketch.circle.three_point":"Nakreslí kružnici procházející třemi body. Použijte to, když kružnice musí procházet zadanými body, například existující geometrie.","help.sketch.circle.three_tangent":"Nakreslí kružnici, která se dotýká tří úseček, kružnic nebo oblouků. Použijte to k vložení kružnice do prostoru mezi tři křivky, například jako vepsanou kružnici trojúhelníku.","help.sketch.circle.two_point":"Nakreslí kružnici ze dvou konců jejího průměru. Použijte to, když jsou známé body na okraji kružnice, a ne její střed.","help.sketch.circle.two_tangent":"Nakreslí kružnici zadané velikosti, která se dotýká dvou úseček, kružnic nebo oblouků. Použijte to pro zaoblení pevným poloměrem mezi dvěma křivkami.","help.sketch.conic":"Nakreslí kuželosečku mezi dvěma koncovými body, tvarovanou vrcholovým bodem a hodnotou rho. Použijte to pro hladké přechody, jejichž plnost chcete doladit, od ploché až po téměř ostrý roh.","help.sketch.constrainer":"Použije vazbu, kterou jedna nebo dvě vybrané křivky už skoro mají, například vodorovnost, rovnoběžnost, tečnost nebo rovnost. Použijte to k uspořádání ručně nakresleného náčrtu po jedné vazbě.","help.sketch.constraint.coincident":"Umístí bod na jiný bod, křivku nebo osu náčrtu. Použijte to k zavření mezer v profilu nebo k umístění bodu na úsečku.","help.sketch.constraint.collinear":"Umístí dvě úsečky na jednu přímku. Použijte to k zarovnání přerušených hran, například obou stran zářezu.","help.sketch.constraint.concentric":"Dá dvěma kružnicím nebo obloukům stejný střed. Použijte to pro kroužky, záhlubky a hřídele s osazením.","help.sketch.constraint.curvature":"Zajistí, aby dvě křivky, které se setkávají v koncovém bodě, pokračovaly se stejnou křivostí (G2). Použijte to tam, kde tečné napojení není dost hladké, například na viditelných plochách.","help.sketch.constraint.equal":"Vyrovná délky úseček, nebo poloměry kružnic a oblouků. Použijte to, aby jeden rozměr řídil několik shodných prvků.","help.sketch.constraint.fix":"Zafixuje body nebo křivky tam, kde jsou, nebo je znovu uvolní. Použijte to pro geometrii, která se nesmí pohnout při tažení nebo řešení náčrtu.","help.sketch.constraint.horizontal_vertical":"Učiní úsečku, nebo spojnici dvou bodů, vodorovnou nebo svislou, podle toho, co je blíže. Použijte to k zarovnání obrysu s osami náčrtu.","help.sketch.constraint.midpoint":"Umístí bod doprostřed úsečky, nebo spojí středy dvou úseček. Použijte to k vystředění geometrie na hraně.","help.sketch.constraint.parallel":"Učiní dvě úsečky rovnoběžnými. Použijte to pro strany, které mají zůstat rovnoběžné při změně jiných rozměrů.","help.sketch.constraint.perpendicular":"Zajistí, aby se dvě úsečky protínaly v pravém úhlu. Použijte to pro pravoúhlé rohy mezi úsečkami, které neleží na osách náčrtu.","help.sketch.constraint.polygon":"Změní uzavřený řetězec úseček na pravidelný mnohoúhelník: stejné strany, všechny rohy na jedné kružnici. Použijte to, aby se ručně nakreslený mnohoúhelník stal pravidelným a zůstal takový.","help.sketch.constraint.symmetry":"Zajistí, aby dva body nebo křivky byly symetrické podle přímky nebo podle bodu. Použijte to, aby profil zůstal symetrický při změně jedné strany.","help.sketch.constraint.tangent":"Zajistí, aby se dvě křivky dotýkaly tečně, například úsečka a oblouk. Použijte to pro hladká napojení bez zlomu.","help.sketch.construction":"Přepíná křivky mezi běžnou geometrií a konstrukční geometrií, kterou profily vynechávají. Použijte konstrukční křivky jako pomocné prvky pro rozvržení, reference a kóty.","help.sketch.construction_line":"Vytvoří nekonečnou konstrukční přímku procházející dvěma body. Použijte ji k rozvržení náčrtu bez rozdělování profilů.","help.sketch.construction_line.angle":"Vytvoří nekonečnou konstrukční přímku pod úhlem od osy X náčrtu. Vyberte bod a zadejte úhel, nebo vyberte jeho směr.","help.sketch.construction_line.bisector":"Vyberte dvě protínající se přímé úsečky náčrtu a pak jednu ze dvou os úhlu. Výsledek sleduje své zdrojové úsečky.","help.sketch.construction_line.horizontal":"Vytvoří nekonečnou vodorovnou konstrukční přímku procházející bodem. Její vodorovná vazba platí i při pozdějších úpravách.","help.sketch.construction_line.parallel":"Vyberte přímou úsečku náčrtu a pak umístěte rovnoběžnou nekonečnou konstrukční přímku. Jinou referenci vyberete kliknutím pravým tlačítkem.","help.sketch.construction_line.perpendicular":"Vyberte přímou úsečku náčrtu a pak umístěte kolmou nekonečnou konstrukční přímku. Jinou referenci vyberete kliknutím pravým tlačítkem.","help.sketch.construction_line.tangent_at":"Vytvoří tečnu v bodě kružnice nebo kruhového oblouku, případně v koncovém bodě otevřeného splajnu nebo kuželosečky. Vyberte křivku a pak bod dotyku.","help.sketch.construction_line.tangent_external":"Vyberte kružnici nebo kruhový oblouk, pak vnější bod a řešení tečny. Náhledy ukazují jen body dotyku na nakresleném oblouku.","help.sketch.construction_line.tangent_two":"Vyberte dvě kružnice nebo kruhové oblouky a pak v náhledu zvolte společnou tečnu. Body dotyku musí ležet na nakreslených křivkách.","help.sketch.construction_line.vertical":"Vytvoří nekonečnou svislou konstrukční přímku procházející bodem. Její svislá vazba platí i při pozdějších úpravách.","help.sketch.copy":"Zkopíruje vybrané křivky a body náčrtu spolu s vazbami a kótami mezi nimi. Vložte je do tohoto náčrtu nebo do jiného.","help.sketch.create":"Zahájí nový 2D náčrt na rovině nebo na rovinné ploše modelu. Každé vysunutí, rotace a tažení začíná náčrtem.","help.sketch.cut":"Zkopíruje vybranou geometrii náčrtu a smaže ji z náčrtu, vše jedním krokem vrácení zpět. Vložte ji jinam v tomto náčrtu nebo do jiného.","help.sketch.dimension":"Přidá řídicí kótu: délku, vzdálenost, úhel, poloměr nebo průměr podle toho, co vyberete. Zadejte hodnotu nebo název parametru a náčrt ji následuje.","help.sketch.edit":"Otevře existující náčrt k úpravám. Prvky na něm postavené se aktualizují, když náčrt dokončíte.","help.sketch.ellipse":"Nakreslí elipsu ze středu, konce hlavní osy a bodu na vedlejší straně. Použijte to pro oválné otvory, vačky a jiné protáhlé oblé tvary.","help.sketch.equation_curve":"Nakreslí křivku podle vzorců: x(t) a y(t), nebo y = f(x), v zadaném rozsahu. Vzorce mohou používat parametry a křivka se podle nich mění: použijte ji pro sinusovku, spirálu nebo evolventu zubu ozubeného kola.","help.sketch.extend":"Prodlouží úsečku nebo oblouk až k nejbližší křivce v cestě, nebo prodlouží dvě křivky, dokud se nesetkají. Použijte to k zavření mezer v profilu po oříznutí nebo úpravách.","help.sketch.fillet":"Zaoblí roh, kde se setkávají dvě úsečky nebo oblouky, obloukem zadaného poloměru. Více rohů zaoblených společně sdílí jeden poloměr.","help.sketch.finish":"Opustí náčrt a vrátí se k modelu. Jeho uzavřené profily jsou pak připraveny pro Vysunutí, Rotaci a další prvky.","help.sketch.finish_auto_constrain":"Spustí Automatické vazby na náčrtu a pak jej dokončí. Použijte to k opuštění plně určeného náčrtu jedním krokem.","help.sketch.fit_curves_to_section":"Protne síťové nebo plné těleso rovinou náčrtu a proloží řez úsečkami a oblouky. Použijte to k přestavbě naskenovaného nebo importovaného dílu jako upravitelného náčrtu.","help.sketch.include_3d":"Přenese hrany modelu, vrcholy a křivky jiných náčrtů do tohoto náčrtu jako propojené reference, přičemž ty mimo jeho rovinu do ní zploští. Použijte to k tvorbě na geometrii, která neleží v rovině náčrtu.","help.sketch.infinite":"Přepíná úsečky mezi běžnými úsečkami a nekonečnými konstrukčními přímkami, které vedou přes celý pohled. Použijte je jako referenční čáry rozvržení, které nikdy nekončí příliš brzy.","help.sketch.insert_dxf":"Načte křivky výkresu DXF do náčrtu, ve zvoleném měřítku, natočení a poloze. Použijte to k navázání na 2D výkres z jiného programu, například obrys pro řezání laserem.","help.sketch.insert_svg":"Načte cesty výkresu SVG do náčrtu, ve zvoleném měřítku, natočení a poloze. Použijte to k přeměně loga nebo vektorového obrysu na křivky, které lze vysunout.","help.sketch.inspect":"Otevře zprávu o otevřeném náčrtu: kolik stupňů volnosti zbývá a zda je plně zavazbený. Použijte to ke zjištění, co se ještě hýbe, než náčrt dokončíte.","help.sketch.intersect":"Přidá křivky nebo body, kde tělesa, plochy, hrany nebo jiné náčrty protínají rovinu náčrtu. Zůstanou propojené a sledují model, když se změní.","help.sketch.intersection_curve":"Vytvoří 3D křivky tam, kde se setkávají dvě tělesa nebo plochy, propojené s nimi. Použijte je jako cesty nebo vodicí dráhy, které sledují model.","help.sketch.isoparametric_curve":"Vytvoří 3D křivku ve směru U nebo V plochy bodem, který vyberete, propojenou s plochou. Použijte ji jako cestu nebo dělicí čáru, která sleduje povrch.","help.sketch.line":"Kreslí spojené úsečky bod po bodu, jako otevřený řetězec nebo uzavřený obrys. Je to základní nástroj pro většinu profilů.","help.sketch.line.midpoint":"Nakreslí úsečku od jejího středu k jednomu konci, přičemž druhý konec se zrcadlí. Použijte to pro úsečky vystředěné na bod, například souměrnou hranu.","help.sketch.line3d":"Nakreslí spojené přímé úsečky mezi body v prostoru, se zapnutým 3D náčrtem. Použijte to pro cesty a rámy, které opouštějí rovinu náčrtu.","help.sketch.mirror":"Zrcadlí křivky a body náčrtu podle přímky nebo osy a přidá vazby symetrie. Použijte to k nakreslení poloviny symetrického profilu a jeho doplnění.","help.sketch.move":"Přesune nebo otočí křivky a body náčrtu, nebo jejich kopii. Použijte to k přemístění geometrie při zachování jejího tvaru a vazeb.","help.sketch.offset":"Vytvoří kopii řetězce křivek v zadané vzdálenosti, na jedné straně nebo na obou. Použijte to pro stěny, obrysy a vůle; vzdálenost zůstává upravitelnou kótou.","help.sketch.paste":"Vloží do aktivního náčrtu geometrii náčrtu, kterou jste zkopírovali nebo vyjmuli. Umístěte ji do bodu nebo ji posuňte o odsazení.","help.sketch.pattern.circular":"Zkopíruje geometrii náčrtu kolem středu, po celém kruhu nebo o zadaný úhel. Použijte to pro roztečné kružnice šroubů, paprsky a zuby.","help.sketch.pattern.rectangular":"Zkopíruje geometrii náčrtu v řádcích a sloupcích v zadaných roztečích. Použijte to pro mřížky otvorů, drážek nebo větracích otvorů.","help.sketch.point":"Umístí bod náčrtu. Použijte ho jako referenci pro kóty, vazby, středy otvorů nebo pozdější prvky.","help.sketch.point3d":"Umístí bod v prostoru, se zapnutým 3D náčrtem. Použijte ho jako referenci pro 3D křivky a cesty.","help.sketch.polygon.circumscribed":"Nakreslí pravidelný mnohoúhelník kolem kružnice, velikost se určuje od středu ke středu strany. Použijte to, když je známé rozevření klíče, například u šestihranné matice.","help.sketch.polygon.edge":"Nakreslí pravidelný mnohoúhelník ze dvou konců jedné strany. Použijte to, když je známá délka a poloha strany.","help.sketch.polygon.inscribed":"Nakreslí pravidelný mnohoúhelník do kružnice, velikost se určuje od středu k rohu. Použijte to, když je známá velikost přes rohy.","help.sketch.project":"Přenese hrany modelu, plochy, vrcholy a křivky jiných náčrtů do tohoto náčrtu, promítnuté do jeho roviny. Zůstanou propojené a sledují model, když se změní.","help.sketch.project_to_surface":"Promítne křivky jiných náčrtů ve směru normály tohoto náčrtu na plochu jako propojené 3D křivky. Použijte to k umístění loga, dělicí čáry nebo cesty na zakřivený povrch.","help.sketch.rectangle.center":"Nakreslí obdélník ze středu a jednoho rohu. Použijte to pro obrysy vystředěné na bod, například počátek.","help.sketch.rectangle.rounded":"Nakreslí obdélník se všemi čtyřmi rohy zaoblenými jedním poloměrem. Použijte to pro desky, víka a otvory se zaoblenými rohy.","help.sketch.rectangle.three_point":"Nakreslí obdélník z jedné hrany a bodu na protější straně. Použijte to pro obdélníky pootočené vůči osám náčrtu.","help.sketch.rectangle.two_point":"Nakreslí obdélník ze dvou protilehlých rohů. Použijte to pro obrysy desek, bloků a kapes.","help.sketch.scale":"Změní měřítko křivek a bodů náčrtu zadaným činitelem kolem základního bodu. Použijte to ke změně velikosti části náčrtu bez nového kreslení.","help.sketch.slot.arc_center":"Nakreslí zakřivenou drážku zadané šířky podél oblouku daného středem, začátkem a koncem. Použijte to pro stavěcí drážky kolem čepu.","help.sketch.slot.arc_three_point":"Nakreslí zakřivenou drážku zadané šířky podél oblouku procházejícího třemi body. Použijte to, když dráha drážky musí procházet zadanými body.","help.sketch.slot.center_point":"Nakreslí přímou drážku zadané šířky od jejího středu ke středu oblouku jednoho konce. Použijte to pro drážky vystředěné na bod.","help.sketch.slot.center_to_center":"Nakreslí přímou drážku zadané šířky mezi středy jejích dvou koncových oblouků. Použijte to pro drážky kótované střed–střed, například stavěcí drážky pro šrouby.","help.sketch.slot.overall":"Nakreslí přímou drážku zadané šířky od jednoho vnějšího konce k druhému. Použijte to, když záleží na celkové délce drážky.","help.sketch.spline.control_point":"Nakreslí kubický splajn tvarovaný řídicími body, kterými neprochází. Použijte to pro hladké, plynulé křivky, které tvarujete přesouváním bodů.","help.sketch.spline.control_point_5":"Nakreslí splajn stupně 5 tvarovaný řídicími body. Použijte to tam, kde se křivky musí napojit s hladší křivostí, například na viditelných tvarových plochách.","help.sketch.spline.fit_point":"Nakreslí hladký splajn, který prochází každým bodem, který umístíte, otevřený nebo uzavřený. Použijte to k obkreslení tvaru přes známé body.","help.sketch.spline3d":"Nakreslí hladkou křivku v prostoru body, se zapnutým 3D náčrtem. Použijte to pro cesty tažení a vedení kabelů, které opouštějí rovinu náčrtu.","help.sketch.spun_profile":"Vytvoří v rovině náčrtu obrys, který těleso opíše při otáčení kolem osy. Použijte to k získání siluety soustruženého dílu pro rotaci nebo výkres.","help.sketch.text":"Napíše do náčrtu text zvoleným písmem, výškou a úhlem; jeho slova mohou sledovat parametry. Vysuňte jej nebo z něj vytvořte reliéf pro štítky a nápisy.","help.sketch.transform":"Změní měřítko, otočí a přesune geometrii náčrtu kolem středu jedním krokem. Použijte to k přemístění a změně velikosti výběru najednou.","help.sketch.trim":"Odstraní část křivky mezi nejbližšími průsečíky kolem místa, kam kliknete. Použijte to k vyčištění překrývajících se úseček do uzavřeného profilu.","help.solid.align":"Posune vybraná tělesa tak, aby se bod, plocha nebo rovina na nich setkala s bodem, plochou nebo rovinou jinde. Hodí se k přiložení dílu k jinému bez měření odsazení.","help.solid.boundary_fill":"Vytvoří tělesa z oblastí uzavřených překrývajícími se nástrojovými tělesy, přičemž vyplní jen oblasti, které vyberete. Použijte to k vytvoření tvaru z prostoru, který společně ohraničuje několik těles.","help.solid.bounding_solid":"Vytvoří kvádr, který obklopuje vybraná tělesa, s volitelným okrajem. Použijte to k zobrazení celkové velikosti dílu nebo jako polotovar, ze kterého se obrábí.","help.solid.box":"Vytvoří kvádr z délky, šířky a výšky, z rohového bodu nebo vystředěný na bod. Použijte to pro rychlý blok, zástupný díl nebo těleso, do kterého se řežou prvky.","help.solid.chamfer":"Zkosí vybrané hrany plochým sražením o zadanou vzdálenost. Hodí se k otupení ostrých hran nebo ke snadnějšímu zasunutí kolíku či šroubu.","help.solid.coil":"Vytvoří šroubovicové těleso, například pružinu, z průměru, počtu závitů, výšky nebo stoupání a kulatého či čtvercového průřezu. Použijte to pro pružiny, cívky a šroubovicové výstupky.","help.solid.combine":"Sjednotí tělesa, vyjme je z cílového tělesa nebo ponechá jen společný objem; nástrojová tělesa lze ponechat. Hodí se ke slučování dílů, k vyříznutí jednoho tvaru druhým nebo k nalezení místa, kde se dvě tělesa překrývají.","help.solid.cone":"Vytvoří kužel z kruhové základny a výšky, nebo komolý kužel, pokud má poloměr i horní strana. Použijte to pro zúžení, nálevky, kuželové záhlubky a hroty.","help.solid.cylinder":"Vytvoří válec z poloměru nebo průměru a výšky, stojící na bodě podél osy. Použijte to pro hřídele, kolíky, nálitky a kulaté polotovary.","help.solid.draft":"Nakloní vybrané plochy o zadaný úhel měřený od neutrální roviny. Hodí se u lisovaných či odlévaných dílů, aby šly snadno vyjmout z formy.","help.solid.emboss":"Vytáhne profily náčrtu, například text nebo logo, z plochy ven, nebo je do ní zahloubí. Použijte to pro nápisy, štítky a značení na rovných nebo kulatých plochách.","help.solid.extrude":"Vysune profil náčrtu do 3D o zadanou vzdálenost a přidá nebo odebere materiál. Hodí se k přeměně plochého obrysu na kvádr, nálitek nebo vybrání.","help.solid.fillet":"Zaoblí vybrané hrany hladkým kruhovým přechodem o zadaném poloměru. Hodí se ke zjemnění ostrých hran kvůli pevnosti, pohodlí nebo vzhledu.","help.solid.hole":"Vyvrtá kruhový otvor zadaného průměru ve zvoleném bodě plochy. Hodí se pro průchozí otvory pro šrouby, kolíky a další jednoduché kruhové otvory.","help.solid.loft":"Vytvoří hladké těleso mezi dvěma či více profily náčrtu, nebo od profilu k bodu. Hodí se pro přechody, nálevky, rukojeti a každý tvar, jehož průřez se po délce mění.","help.solid.mirror":"Vytvoří zrcadlenou kopii vybraných těles nebo prvků podle roviny a může ji sloučit s originálem. Hodí se pro souměrné díly: vymodelujete jednu polovinu a získáte obě.","help.solid.move":"Posune nebo otočí vybraná tělesa, případně jejich kopii, o zadanou vzdálenost a úhel. Hodí se ke změně polohy tělesa nebo k vytvoření dalšího tělesa na jiném místě.","help.solid.offset_face":"Posune vybrané plochy dovnitř nebo ven o zadanou vzdálenost a okolní plochy je následují. Hodí se k zesílení stěny, prohloubení vybrání nebo zvýšení nálitku bez úprav náčrtu.","help.solid.pattern.circular":"Opakuje vybrané objekty kolem osy v zadaném počtu a celkovém úhlu. Hodí se pro roztečné kružnice šroubů, paprsky, žebra a zuby.","help.solid.pattern.path":"Zkopíruje prvky nebo tělesa podél cesty náčrtu podle počtu a rozteče. Použijte to pro otvory podél zakřivené hrany nebo díly podél kolejnice.","help.solid.pattern.rectangular":"Zopakuje vybrané objekty v jednom nebo dvou směrech podle zadaného počtu a rozteče. Použijte to pro řady a mřížky otvorů, žeber, kolíků nebo patek.","help.solid.pipe":"Vytvoří kulatou trubku podél cesty z křivek náčrtu, plnou nebo dutou se zadanou tloušťkou stěny. Použijte to pro trubky, dráty, kabely a kolejnice.","help.solid.press_pull":"Přidá nebo odebere materiál při tažení plochy, případně zaoblí hrany při jejich tažení. Použijte to pro rychlé úpravy přímo na modelu.","help.solid.remove":"Odebere vybraná tělesa z návrhu od tohoto místa na časové ose; dřívější kroky je zachovají. Použijte to k odstranění pomocného tělesa, například řezného nástroje, který už nepotřebujete.","help.solid.replace_face":"Přesune vybrané rovinné plochy do roviny nebo na rovnoběžnou plochu a těleso se natáhne či zmenší, aby na ni dosáhlo. Použijte to, aby plocha lícovala s jiným dílem nebo konstrukční rovinou.","help.solid.revolve":"Otočí profil náčrtu kolem osy a vytvoří rotační těleso. Použijte to pro hřídele, knoflíky, misky a každý díl, který je souměrný kolem osy.","help.solid.rib":"Přidá tenkou stěnu podél otevřené křivky náčrtu, vyplněnou až k nejbližším plochám tělesa. Použijte to k vyztužení stěn a rohů, například u lisovaných nebo tištěných dílů.","help.solid.scale":"Zvětší nebo zmenší vybraná tělesa o zadaný činitel, stejný ve všech směrech nebo zvlášť pro každou osu. Použijte to ke změně velikosti importovaného tvaru nebo k započtení smrštění.","help.solid.shell":"Vytvoří z tělesa skořepinu se stěnami zadané tloušťky a může otevřít vybrané plochy. Použijte to pro krabice, kryty a jiné tenkostěnné díly.","help.solid.sphere":"Vytvoří kouli z poloměru nebo průměru kolem středu. Použijte to pro kuličky, knoflíky a zaoblené konce.","help.solid.split_body":"Rozdělí těleso na samostatná tělesa rovinou, plochou jiného tělesa nebo úsečkou náčrtu. Použijte to pro díly, které se tisknou, obrábějí nebo barví zvlášť.","help.solid.split_face":"Rozdělí vybrané plochy podél roviny, plochy jiného tělesa nebo křivek náčrtu, aniž by těleso rozřízlo. Použijte to, aby část plochy měla vlastní úkos, barvu nebo odsazení.","help.solid.sweep":"Protáhne profil náčrtu po cestě a vytvoří těleso. Použijte to pro trubky, lišty, rukojeti a každý díl s konstantním průřezem, který sleduje křivku.","help.solid.thread":"Přidá metrický závit ISO na válcovou plochu, buď jako kosmetický závit, nebo vyříznutý do tělesa. Použijte to pro šrouby, závitové otvory a tištěné šroubové díly.","help.solid.torus":"Vytvoří anuloid, tedy prstenec, z hlavního poloměru kolem jeho osy a vedlejšího poloměru jeho kulatého průřezu. Použijte to pro O-kroužky, držadla a kulaté korálky.","help.solid.web":"Přidá tenkou stěnu podél každé otevřené křivky náčrtu, každou vyplněnou až k nejbližším plochám tělesa. Použijte to pro mřížku podpůrných stěn uvnitř krytů a táců.","help.surface.blend":"Vytvoří plochu, která překlenuje hrany dvou těles, tečně nebo spojitě v křivosti k oběma. Použijte to k hladkému spojení dvou ploch přes mezeru.","help.surface.boundary":"Vytvoří plochu vyplňující smyčku dvou až čtyř křivek náčrtu, nebo síť křivek. Použijte to pro volné panely dané svými hranami.","help.surface.extend":"Prodlouží plochu za její hrany o vzdálenost nebo až k rovině či ploše. Použijte to, aby se plochy před oříznutím nebo sešitím překrývaly.","help.surface.extrude":"Vysune křivky nebo profily náčrtu o vzdálenost do plochy, jen stěny, bez čel. Použijte to pro tenké stěny a pro řezné či dělicí nástroje.","help.surface.fair":"Vyhladí vnitřek volných ploch, zatímco jejich hrany zůstanou na místě. Použijte to k vyrovnání nerovností a vlnitých odrazů na ploše.","help.surface.loft":"Vytvoří plochu, která prochází dvěma nebo více průřezy v pořadí, bez čel. Použijte to pro skořepiny a přechody mezi různými tvary.","help.surface.match":"Přestaví hranu plochy tak, aby se setkala s hranou jiného tělesa, se shodnou tečností nebo křivostí. Použijte to k hladkému uzavření spoje mezi dvěma plochami.","help.surface.offset":"Vytvoří kopii ploch ve vzdálenosti podél jejich normál jako nové plošné těleso. Použijte to pro povlaky, vůle nebo druhou stranu stěny.","help.surface.patch":"Vyplní oblast náčrtu nebo uzavřenou smyčku hran plochou, rovnou nebo hladce zakřivenou. Použijte to k uzavření děr v plošném tělese.","help.surface.reverse_normal":"Obrátí plochy plošného tělesa, takže jejich vnější strana směřuje na druhou stranu. Použijte to před zesílením nebo sešitím, když plochy míří dovnitř.","help.surface.revolve":"Otočí křivky nebo profily náčrtu kolem osy do plochy, bez čel. Použijte to pro kulaté skořepiny, například stínidla, mísy a trysky.","help.surface.ruled":"Vytvoří pás přímek vycházejících z řetězce hran, podél normály plochy, tečně nebo pod úhlem. Použijte to pro úkosové stěny, náběhy a dělicí plochy.","help.surface.stitch":"Sešije plošná tělesa podél sdílených hran a pokud se uzavřou, vznikne těleso. Použijte to k přeměně množiny ploch na jedno těleso.","help.surface.sweep":"Posune křivky nebo profily náčrtu po cestě do plochy, bez čel. Použijte to pro žlaby, lišty a jiné tenké tvary, které sledují cestu.","help.surface.thicken":"Dá plošnému tělesu tloušťku a změní je na těleso. Použijte to k vytvoření tisknutelných nebo obrobitelných dílů z ploch.","help.surface.trim":"Řízne plochu rovinou, jinou plochou nebo křivkami náčrtu a ponechá stranu, kterou vyberete. Použijte to k oříznutí ploch do tvaru před sešitím.","help.surface.unstitch":"Odděluje plochy tělesa do samostatných plošných těles; těleso se rozpadne na plochy. Použijte to k úpravě jednotlivých ploch tělesa.","help.surface.untrim":"Odstraní z plochy otvory, nebo obnoví její vnější hranici na přirozené meze povrchu. Použijte to k získání celé plochy zpět po oříznutí.","help.third_party":"Licence třetích stran","help.timeline.compute_all":"Přepočítá všechny prvky na časové ose od začátku. Použijte to k obnovení modelu a ke zjištění, které prvky selhávají.","help.timeline.delete":"Smaže vybrané prvky z časové osy; smazáním náčrtu se smažou i prvky z něj vytvořené. Použijte to k odstranění kroku, který už nechcete.","help.timeline.dependents":"Vypíše prvky, které by se smazaly spolu s prvkem, a ty, které by bez něj selhaly. Použijte to před smazáním nebo změnou prvku.","help.timeline.play":"Přehraje zbývající prvky jeden po druhém s půlsekundovou pauzou po každém přestavění. Spuštěním tohoto příkazu znovu nebo stisknutím Escape přehrávání zastavíte; Přejít na konec skočí okamžitě.","help.view.apply":"Natočí pohled do standardního směru, například zepředu, shora nebo izometricky, nebo do uloženého pojmenovaného pohledu. Použijte to k prohlížení modelu z pevného úhlu.","help.view.delete":"Smaže uložený pojmenovaný pohled. Model se nezmění.","help.view.fit":"Přiblíží a posune pohled tak, aby celý model nebo výběr vyplnil pohled. Použijte to, když model zmizel z dohledu.","help.view.grid":"Zobrazí nebo skryje mřížku v pohledu. Použijte ji jako vodítko velikosti a orientace při modelování.","help.view.ground_shadow":"Zobrazí nebo skryje stín modelu na podložce. Použijte to k snazšímu posouzení výšky a polohy.","help.view.home":"Vrátí pohled do výchozího směru a přizpůsobí model. Použijte to k rychlému návratu do známého pohledu.","help.view.list":"Vypíše pojmenované pohledy uložené v návrhu. Použijte to k nalezení dříve uloženého pohledu.","help.view.navigate":"Natočí, posune nebo přiblíží pohled po krocích, například o čtvrt otáčky doleva. Použijte to k přesnému pohybu kamery místo tažení.","help.view.navigation_bar":"Zobrazí nebo skryje navigační lištu ve spodní části pohledu. Skryjte ji pro více místa, zobrazte ji pro přístup k nástrojům pohledu myší.","help.view.rename":"Dá uloženému pojmenovanému pohledu nový název. Samotný pohled zůstane stejný.","help.view.save":"Uloží aktuální polohu kamery jako pojmenovaný pohled v návrhu. Použijte to k pozdějšímu návratu ke stejnému úhlu, například pro snímky obrazovky.","help.view.spin":"Otáčí pohled kolem modelu nepřetržitě až do dalšího kliknutí nebo stisku klávesy. Použijte to k prezentaci modelu ze všech stran.","help.view.tool":"Zapne nástroj kamery, otáčení, posun nebo přiblížení, takže tažení levým tlačítkem myši pohybuje pohledem, dokud jej nevypnete. Použijte to na trackpadu nebo bez prostředního tlačítka myši.","help.view.visual_style":"Přepne způsob zobrazení modelu: stínovaný s hranami nebo bez nich, drátový model, nebo se skrytými hranami. Použijte drátový model pro pohled dovnitř, stínovaný pro čistý vzhled.","history.sketch_under_constrained":"Nedourčeno (stupňů volnosti: {count})","history.sketch_under_constrained_one":"Nedourčeno ({count} stupeň volnosti)","hole_presets.confirm_delete":"Potvrdit smazání","hole_presets.delete":"Smazat","hole_presets.delete_prompt":"Smazat tuto osobní předvolbu? Existující otvory se nezmění.","hole_presets.full":"Osobní knihovna už obsahuje 64 předvoleb.","hole_presets.invalid_name":"Zadejte krátký název bez zalomení řádků a řídicích znaků.","hole_presets.invalid_parameters":"Doplňte parametry otvoru platnými výrazy rozumné délky.","hole_presets.missing":"Vybraná předvolba už není k dispozici.","hole_presets.name":"Název předvolby","hole_presets.name_exists":"Předvolba s tímto názvem už existuje. Zvolte jiný název.","hole_presets.name_hint":"Jedinečný název","hole_presets.overwrite":"Uložit změny do vybrané předvolby","hole_presets.preset":"Předvolba","hole_presets.recall":"Načíst","hole_presets.rename":"Přejmenovat","hole_presets.save":"Uložit jako novou","hole_presets.scope":"Uloženo ve vašem profilu pro všechny projekty.","hole_presets.select":"Vyberte předvolbu","hole_presets.title":"Osobní předvolby","hole_presets.unsupported_options":"Tato předvolba používá možnosti závitu, které tato verze nedokáže načíst.","hole_presets.unsupported_overwrite":"Tato předvolba obsahuje možnosti, které nelze bezpečně přepsat.","home.back":"Zpět na {name}","home.crashes":"Hlášení o pádech","home.design_workspace":"Návrh","home.documentation":"Dokumentace","home.export":"Exportovat","home.export_hint":"Vyberte formát pro aktuální návrh.","home.export_json_hint":"Upravitelný návrh a historie příkazů","home.export_mesh_hint":"Síť pro tisk nebo sdílení","home.export_step_hint":"Přesná geometrie tělesa","home.import":"Importovat…","home.import_hint":"STEP, IGES nebo síť do nového návrhu","home.in_this_browser":"v tomto prohlížeči","home.missing":"chybí","home.month_01":"led","home.month_02":"úno","home.month_03":"bře","home.month_04":"dub","home.month_05":"kvě","home.month_06":"čer","home.month_07":"čvc","home.month_08":"srp","home.month_09":"zář","home.month_10":"říj","home.month_11":"lis","home.month_12":"pro","home.new_inches":"Nový návrh v palcích","home.new_inches_hint":"Palce · otevře se v pracovním prostoru Návrh","home.new_mm":"Nový návrh","home.new_mm_hint":"Milimetry · otevře se v pracovním prostoru Návrh","home.open":"Otevřít…","home.open_hint":"Návrh ve formátu .sc ({shortcut})","home.open_now":"Otevřít nyní","home.opened_days_ago":"Před {count} dny","home.opened_hours_ago":"Před {count} h","home.opened_just_now":"Právě teď","home.opened_minutes_ago":"Před {count} min","home.opening":"otevírání…","home.properties":"Vlastnosti návrhu","home.recent":"Nedávné","home.recent_empty":"Zde se zobrazí návrhy, které otevřete nebo uložíte.","home.recovery_count":"Návrhy k obnovení: {count}","home.recovery_empty":"Žádné návrhy k obnovení.","home.recovery_hint":"SolidCraft se zavřel před uložením těchto návrhů.","home.report_issue":"Nahlásit problém","home.samples":"Ukázky","home.settings":"Nastavení","home.short_date":"{day}. {month}","home.shortcuts":"Klávesové zkratky","home.start_hint":"Vytvořte návrh, otevřete nedávný soubor nebo prozkoumejte ukázku.","home.whats_new":"Co je nového","home.yesterday":"Včera","install.button_tip":"Nainstalovat SolidCraft jako aplikaci: otevře se ve vlastním okně a funguje i offline","install.dock_1":"Zvolte Soubor › Přidat do Docku.","install.dock_2":"Klikněte na Přidat.","install.dock_after":"SolidCraft se pak otevírá z Docku ve vlastním okně a funguje i offline.","install.done":"Hotovo","install.home_screen_1":"Klepněte na Sdílet (v nabídce …, pokud není na liště).","install.home_screen_2":"Zvolte Přidat na plochu.","install.home_screen_3":"Klepněte na Přidat.","install.home_screen_after":"SolidCraft se pak otevírá ikonou na ploše bez lišt Safari a funguje i offline.","install.menu":"Nainstalovat aplikaci…","install.steps_intro":"Safari instaluje webové aplikace z vlastních nabídek:","install.title":"Instalace SolidCraftu","issue.body_label":"Text hlášení","issue.note_changed_while_waiting":"Nastavení nebo model se změnily během čekání na náhled. Pořiďte snímek obrazovky znovu, aby se technické údaje aktualizovaly podle aktuálního pohledu.","issue.note_details_kept":"Snímek obrazovky byl pořízen lokálně. Vaše upravené technické údaje byly zachovány: zkontrolujte, zda stále odpovídají aktuálnímu pohledu.","issue.note_details_updated":"Technické údaje byly aktualizovány podle aktuálního pohledu. Snímek obrazovky byl pořízen lokálně. Před připojením na GitHub ho zkontrolujte.","issue.note_image_copied":"Vložte obrázek do konceptu na GitHubu, nebo uložte PNG, pokud kopírování obrázku není dostupné.","issue.note_opened":"Zkontrolujte koncept na GitHubu a připojte snímek obrazovky. Hlášení zveřejníte tlačítkem Submit new issue na GitHubu.","issue.note_opened_copied":"Hlášení bylo zkopírováno. Vložte je do konceptu na GitHubu, připojte snímek obrazovky a klikněte na Submit new issue na GitHubu.","issue.note_removed":"Snímek obrazovky byl z konceptu odebrán.","issue.note_report_copied":"Hlášení bylo zkopírováno. V případě potřeby je vložte do konceptu na GitHubu.","issue.note_save_failed":"Snímek obrazovky se nepodařilo uložit: {error}","issue.note_saved":"Snímek obrazovky byl uložen. Připojte PNG v konceptu na GitHubu.","issue.s