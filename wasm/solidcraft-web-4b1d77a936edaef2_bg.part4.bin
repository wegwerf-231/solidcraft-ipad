btitle_studio":"אולפן מובנה · חל על הסצנה כולה","render.stage_panels.subtitle_uniform":"קירוב אחיד · אינו חומר שנמדד","render.stage_panels.surfaces":"משטחים","render.stage_panels.surfaces_references":"משטחים וייחוסים","render.stage_panels.target":"יעד","render.stage_panels.use_budget":"שימוש בתקציב זה","render.stage_panels.use_maps":"שימוש במפות GPU","render.stage_panels.use_uniform":"שימוש במראה אחיד","render.stage_preview_note":"תצוגה מקדימה משולבת · אור ישיר","render.state_completed":"תמונה שהושלמה","render.state_in_progress":"תמונה בתהליך","render.state_model":"תצוגת מודל","render.strip_label":"סרגל","render.studio_add_area":"הוספת אור שטח","render.studio_ambient":"קרינת סביבה קבועה","render.studio_ambient_rgb":"קרינת סביבה קבועה (RGB ליניארי)","render.studio_aperture":"רדיוס הצמצם","render.studio_area":"אור שטח","render.studio_area_help":"עד ארבעה מלבנים חד־צדדיים. חצאי הצלעות הניצבים U ו־V קובעים את הגודל; U × V פונה אל הצד המואר. הקואורדינטות במילימטרים של מרחב העולם.","render.studio_center":"מרכז X, Y, Z (mm)","render.studio_denoise":"הפחתת רעש בתמונה הסופית","render.studio_denoise_help":"מסנן סופי שמתחשב בקצוות; פרטים עדינים עלולים להתרכך. זכוכית ומשטחים ספקולריים חדים עוקפים את המסנן.","render.studio_direction":"כיוון אל השמש (X, Y, Z)","render.studio_environment":"סביבה","render.studio_environment_bounds":"סיבוב הסביבה חייב להיות סופי בטווח ±1,000,000 רדיאנים והעוצמה בין 0 ל־100.","render.studio_environment_none":"ללא מפת סביבה","render.studio_focus":"מרחק מיקוד צירי","render.studio_half_u":"חצי צלע U (mm)","render.studio_half_v":"חצי צלע V (mm)","render.studio_hdr":"קובץ Radiance HDR","render.studio_hdr_browse":"בחירת HDR…","render.studio_hdr_help":"קובץ Radiance בתבנית .hdr, פנורמה 2:1, עד 2048 × 1024. EXR אינו זמין. הנחת הצבע חלה רק כשצבעי היסוד אינם מוגדרים.","render.studio_hdr_required":"יש לבחור קובץ .hdr מקומי.","render.studio_hdr_srgb":"פירוש צבעי יסוד לא מוגדרים כ־sRGB ליניארי","render.studio_intensity":"עוצמת הסביבה","render.studio_lens":"עומק שדה","render.studio_lens_perspective":"עומק שדה דורש מצלמה פרספקטיבית.","render.studio_lighting":"תאורת סטודיו","render.studio_lighting_enable":"שימוש בתאורת סטודיו מותאמת","render.studio_needs_review":"יש לסקור את השיטה וההגדרות","render.studio_radiance":"קרינת RGB ליניארית","render.studio_ready":"מוכן לבדיקה","render.studio_remove_area":"הסרת אור השטח","render.studio_rotation":"סיבוב הסביבה","render.studio_runtime_help":"ניתן לשמור עם ההגדרה את הגדרות הסטודיו המספריות ואת מקורות ה־HDR שנבדקו. דריסות אופטיות ודריסות חומר של גופים נשארות זמניות ואינן משנות את המראים השמורים.","render.studio_saved":"הגדרה שמורה / מצלמה נוכחית","render.studio_sky":"שמיים אמנותיים","render.studio_sky_help":"מדרג שמיים מקורי לתאורה; לא מודל אטמוספרי מכויל.","render.studio_sun":"שמש","render.studio_sun_radius":"רדיוס זוויתי","render.studio_tiles_require_gpu":"סטודיו דורש מעקב נתיב במעבד הגרפי. בחר GPU בעורך הפלט.","render.studio_title":"סטודיו הדמיה","render.studio_tone_map":"מיפוי גוונים","render.studios_environments":"סטודיו וסביבות","render.subsurface_enable":"הילוך אקראי לפיזור פנימי","render.subsurface_help":"לדיאלקטרי סגור בלבד. פיזור ובליעת RGB הם מקדמים נפרדים לכל mm. המסלולים מתפזרים בתוך הגאומטריה בפועל, ואז נשברים או מוחזרים בגבול. יש לבטל העברת צל ישרה, הסרת רעש משטחית ונפח חיצוני; ולהשתמש בשכבת פרנל אחת. אינו שיידר דיפוזיה, אינו רשת צפיפות ואינו חומר מדוד. תווך צפוף עשוי לדרוש יותר דגימות ועומק מסלול.","render.subsurface_rate":"קצב התנגשויות הפיזור","render.tone_aces_fitted":"ACES מותאם","render.tone_reinhard":"ריינהרד","render.transmission_scope":"זכוכית GPU תומכת בתווכים נפרדים מאושרים. תווכים מקוננים ללא הגבלה ומעריך העברה ללא רעש אינם מסופקים.","render.transmission_strata":"שכבות פרנל מותנות","render.transmission_strata_help":"1 שומר על הזרם המקורי. 2 או 4 תת־מסלולים מרבדים את בחירת ההחזרה או ההעברה הראשונה בזכוכית, וחוקי סנל והבליעה אינם משתנים. יותר מסלולים דורשים יותר עבודה; זו אינה הסרת רעש, אינה תמיכה בתווכים מקוננים ואינה הבטחה להדמיה מהירה יותר.","render.tree_add_light":"הוסף אור","render.tree_add_shot":"הוסף צילום","render.tree_browser":"דפדפן רינדור","render.tree_by_look":"לפי מראה","render.tree_by_object":"לפי אובייקט","render.tree_constant":"סביבה קבועה","render.tree_default":"ברירת מחדל","render.tree_directional":"כיווני","render.tree_environment":"סביבה","render.tree_environment_values":"{rotation}° · {intensity}×","render.tree_face_count":"{count} פאות","render.tree_face_one":"פאה {count}","render.tree_fixed_studio":"סטודיו קבוע","render.tree_hdr":"HDR","render.tree_lights":"אורות","render.tree_lights_pending":"פקודות אורות בעלי שם עדיין אינן זמינות.","render.tree_mixed":"מעורב","render.tree_more":"{count} נוספים","render.tree_mute":"השתק אור","render.tree_no_environment":"ללא סביבה","render.tree_objects":"אובייקטים","render.tree_output":"פלט","render.tree_point":"נקודתי","render.tree_rectangle":"מלבן","render.tree_search":"חיפוש אובייקטים","render.tree_selection":"בחירת רינדור","render.tree_shots":"צילומים","render.tree_sky":"שמיים","render.tree_solo":"בידוד אור","render.tree_spot":"זרקור","render.tree_sun":"שמש","render.tree_switch":"החלף","render.tree_user_one":"אובייקט {count}","render.tree_users":"{count} אובייקטים","render.unavailable_preview":"הגדרה זו מבקשת פרופיל תצוגה מקדימה שאינו זמין.","render.unsaved":"שינויים בתצוגה המקדימה שלא נשמרו","render.use_preview":"שימוש בתצוגה המקדימה המובנית","render.volume_albedo":"אלבדו פיזור · RGB ליניארי","render.volume_anisotropy":"קוסינוס ממוצע של פונקציית הפאזה","render.volume_enable":"הפעלת תווך משתתף","render.volume_extinction":"מקדם הכחדה","render.volume_help":"העברה ב־GPU בתוך תיבה סופית אחת, עם הנחתת בר ופיזור HG במסלולי המצלמה ובמסלולים עקיפים. משתמש בתאורת סטודיו, HDR או שמיים מפורשת, כולל הנחתת צל. קוסינוס פאזה חיובי מפזר קדימה. יש לבטל במפורש גבולות זכוכית והסרת רעש משטחית. הכחדה אפס משאירה את ההעברה ללא שינוי. אינו אטמוספרה ירחית פיזיקלית, אינו רשת צפיפות, אינו פליטה נפחית, אינו העברה ספקטרלית ואינו תכונת חומר מאושרת.","render.volume_max":"גבולות מרביים · mm בעולם","render.volume_min":"גבולות מזעריים · mm בעולם","render.volume_title":"נפח הומוגני תחום","render.wait_add_light":"לא נתמך עדיין: יצירת אורות בעלי שם","render.wait_batch":"לא נתמך עדיין: תור רינדור של צילומים שמורים","render.wait_compare":"לא נתמך עדיין: השוואת תמונות שנשמרו","render.wait_paint":"לא נתמך עדיין: בחירת מוצר וצביעת מראה","render.wait_pick_up":"לא נתמך עדיין: בחירת מוצר ודגימת מראה","render.wait_replace":"לא נתמך עדיין: החלפת כל השימושים במראה","render.wait_solo":"לא נתמך עדיין: נראות אורות ובידוד","render.wear_applies_to":"חל על","render.wear_layer_count":"{count} שכבות","render.wear_layer_one":"שכבה {count}","render.wear_layers":"שכבות","render.wear_no_layers":"אין שכבות","render.wear_selected_layer":"שכבה נבחרת","render.wear_title":"בלאי","sample.bracket.about":"אוגן בסיס עם אוגני קצה וקיפול חוזר, לפי כלל של 2 mm","sample.bracket.name":"תושבת פח","sample.enclosure.about":"קופסה עם קליפה, שפה, בליטות לברגים, משען ותפס הצמדה","sample.enclosure.name":"מארז פלסטיק","sample.flange.about":"רכזת ואוגן עם מערך מעגלי הנשלט על ידי פרמטר","sample.flange.name":"אוגן מוברג","sample.hinge.about":"שני רכיבים ומפרק סיבובי, מונעים ל־60°","sample.hinge.name":"הרכבת ציר","sample.plate.about":"לוח פרמטרי עם עיגולי פינות, חורים ובליטה קדוחה","sample.plate.name":"לוח לדוגמה","sample.vents.about":"חריצים במערך מלבני: מספר השורות, מספר העמודות והפסיעה הם פרמטרים","sample.vents.name":"לוח אוורור","search.command_keys":"Enter הרצה     Shift+Enter הרצה והשארה פתוח     Esc סגירה","search.commands":"פקודות","search.design":"בתכן זה","search.feature":"פיצ'ר","search.invalid":"לא תקין","search.keys":"↑ ↓ בחירה     Enter הרצה     Tab השלמת שם     Esc סגירה","search.no_match":"אין פקודה שתואמת את '{query}'","search.parameter":"פרמטר","search.recent":"אחרונים","search.run":"הרצת פקודה","search.suggest":"האם הכוונה ל־{label}?","search.try":"יש להקליד שם פקודה, פיצ'ר בתכן זה או פרמטר. כדי להריץ פקודה עם ערכים, יש להקליד את המזהה שלה ואובייקט JSON: {example}","search.valid":"תקין","section.off_hint":"לא נבחר מישור: אישור מכבה את החתך.","select a direction (an axis, a sketch line or a straight edge) first":"יש לבחור תחילה כיוון (ציר, קו סקיצה או מקצוע ישר)","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"יש לבחור כיוון (ציר, קו סקיצה או מקצוע ישר) שהפרופיל ילך לאורכו","select a point on a component":"יש לבחור נקודה על רכיב","select a profile, edges or sketch lines first":"יש לבחור תחילה פרופיל, מקצועות או קווי סקיצה","select an axis":"יש לבחור ציר","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"יש לבחור תחילה ציר, מקצוע ישר או מעגלי, או פאה של גליל, חרוט או טורוס","select bodies first":"יש לבחור גופים תחילה","select components first":"יש לבחור רכיבים תחילה","select corner points, or the two lines of one corner":"יש לבחור נקודות פינה, או את שני הקווים של פינה אחת","select one corner point, or the two lines of one corner":"יש לבחור נקודת פינה אחת, או את שני הקווים של פינה אחת","select sheet edges first":"יש לבחור תחילה מקצועות של הפח","select the bend line (a sketch line) first":"יש לבחור תחילה את קו הכיפוף (קו סקיצה)","select the cam's profile (a sketch profile or the cam's edges)":"יש לבחור את הפרופיל של הפיקה (פרופיל סקיצה או מקצועות הפיקה)","select the corner to cut first":"יש לבחור תחילה את הפינה לחיתוך","select the corners to round first":"יש לבחור תחילה את הפינות לעיגול","select the fixed face first (a plate's large face)":"יש לבחור תחילה את הפאה הקבועה (הפאה הגדולה של לוח)","select the frame sketch's lines first":"יש לבחור תחילה את קווי סקיצת המסגרת","select the path (sketch lines across the edge)":"יש לבחור את המסלול (קווי סקיצה על פני המקצוע)","select the rim face first":"יש לבחור תחילה את פאת השפה","select the sheet edge first":"יש לבחור תחילה את מקצוע הפח","select two components":"יש לבחור שני רכיבים","set by the sketch's lines":"נקבע לפי קווי הסקיצה","settings.display_quality_note":"ברמות עדינות יותר, פאות ומקצועות מעוקלים מוצגים חלקים יותר ויצירת הרשת אורכת זמן רב יותר. רק אזור התצוגה משתנה, לא התכן ולא קובצי הייצוא.","settings.double_click_components":"לחיצה כפולה על רכיב מפעילה אותו, או עורכת רכיב מקושר במקומו","settings.frame_rate_details_note":"מוסיף גרף של זמני התמונות האחרונות עם המשולשים שצוירו מעליו, היסטוגרמה של זמני התמונות ואת מה שה־GPU צייר. לחיצה על קצב התמונות בתצוגה מציגה או מסתירה אותם.","settings.frame_rate_note":"הצגת מספר הפריימים לשנייה בפינה הימנית התחתונה של התצוגה. כל עוד האפשרות פעילה, התצוגה מצוירת מחדש ברציפות.","settings.insert_lists_open_designs":"הוספת תכן מציגה קודם את התכנים הפתוחים בלשוניות אחרות","settings.measure_axis_distances":"הצגת מרחקי X/Y/Z","settings.measure_axis_distances_help":"הצגת המרחקים לאורך צירי העולם לצד המרחק הכולל כשכלי המדידה פתוח.","settings.msaa_applies_on_restart":"החלקת הקצוות תחול בהפעלה הבאה של SolidCraft","settings.msaa_reset":"{setting}: {requested}× אינו נתמך בהתקן הגרפי הזה; הערך הוא כעת {reset}× (נתמכים: {supported}).","settings.msaa_unsupported":"לא נתמך בהתקן הגרפי הזה","settings.reference_geometry_through_bodies":"הצגת גאומטריית ייחוס דרך גופים","settings.reference_geometry_through_bodies_help":"ציור קווי מתאר של סקיצות לא פעילות ומישורי ייחוס מעל גופים מוצללים","settings.reset_intro":"ההגדרות האלה לא פועלות במחשב הזה והיו מונעות מ־SolidCraft לעלות, ולכן הן שונו:","settings.reset_title":"ההגדרות שונו","settings.supersampling_note":"התצוגה מצוירת ברזולוציה גבוהה יותר ומסוננת כלפי מטה: מקצוות, קווים ורשת חלקים יותר במסכים שמתחת ל־4K. הדבר צורך זמן GPU: בערך 2.25× פיקסלים ב־1.5×, ו־4× ב־2×.","settings.update_changed_links":"עדכון תכנים מקושרים שהשתנו כשלשונית מוצגת שוב","settings.window_system_details":"פרטים","settings.window_system_note_now":"ייכנס לתוקף אחרי הפעלה מחדש. כעת: {now}.","settings.window_system_wayland_limited":"חלק מהתכונות מוגבלות ב־Wayland מקורי.","sheet.flange_type_base":"בסיס","sheet.flange_type_contour":"מתאר","sheet.flange_type_edge":"מקצוע","sheet.no_body":"אין גוף פח: יש להתחיל אחד עם אוגן > בסיס, או להמיר לוח לפח עם המרה לפח (יש לבחור את הפאה השטוחה הגדולה שלו)","sheet.personal_rules.confirm_delete":"אישור מחיקה","sheet.personal_rules.delete":"מחיקה","sheet.personal_rules.delete_prompt":"למחוק את הכלל האישי הזה? כללים שכבר נמצאים בתכנים לא ישתנו.","sheet.personal_rules.full":"הספרייה האישית כבר מכילה 64 כללים.","sheet.personal_rules.invalid_name":"יש להזין שם קצר ללא מעברי שורה או תווי בקרה.","sheet.personal_rules.invalid_values":"יש להשלים את ערכי הכלל: כל ערך צריך להיות ניתן לחישוב בתכן זה, עם עובי חיובי ומקדם K בין 0 ל־1.","sheet.personal_rules.missing":"הכלל האישי שנבחר כבר אינו זמין.","sheet.personal_rules.name":"שם הכלל","sheet.personal_rules.name_exists":"כבר קיים כלל אישי בשם הזה. יש להשתמש בשם אחר.","sheet.personal_rules.name_hint":"שם ייחודי","sheet.personal_rules.overwrite":"שמירת השינויים בכלל האישי שנבחר","sheet.personal_rules.rename":"שינוי שם","sheet.personal_rules.rule":"כלל אישי","sheet.personal_rules.save":"שמירה כחדש","sheet.personal_rules.scope":"נשמרים בפרופיל שלך לכל התכנים.","sheet.personal_rules.select":"בחירת כלל","sheet.personal_rules.title":"כללים אישיים","sheet.personal_rules.unsupported":"לכלל הזה יש ערכים שהגרסה הזו אינה יכולה להשתמש בהם.","shortcut.json_error":"הפרמטרים חייבים להיות JSON: {error}","shortcut.no_command":"אין פקודה `{id}`; הטקסט שלפני ה־JSON חייב להיות מזהה פקודה","shortcut.pin":"הצמדה לראש תיבת S","shortcut.unpin":"ביטול הצמדה","sketch is missing":"הסקיצה חסרה","sketch.degrees_of_freedom":"{count} דרגות חופש","sketch.dimension_added_driven":"הסקיצה כבר קובעת את המידה הזו, ולכן היא נוספה כמידה מונעת (מידת ייחוס)","sketch.dimension_applied":"המידה הוחלה","sketch.dimension_applied_defined":"המידה הוחלה; הפרמטר `{name}` הוגדר","sketch.dimension_applied_renamed":"המידה הוחלה; שם הפרמטר הוא כעת `{name}`","sketch.dof_left":"נותרו {count} דרגות חופש","sketch.dof_left_one":"נותרה {count} דרגת חופש","sketch.draw_curves":"שרטוט כ־{linetype}","sketch.make_selection":"המרת הבחירה ל־{linetype}","sketch.open_ends":"קצוות פתוחים: {count}","sketch.status_