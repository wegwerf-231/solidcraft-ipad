ine","render.stage_panels.surfaces_references":"Površine i reference","render.stage_panels.target":"Cilj","render.stage_panels.use_budget":"Upotrijebi ovaj proračun","render.stage_panels.use_maps":"Upotrijebi GPU mape","render.stage_panels.use_uniform":"Upotrijebi jednoliko","render.stage_preview_note":"Integrirani pregled · izravno svjetlo","render.state_completed":"Dovršena slika","render.state_in_progress":"Slika u izradi","render.state_model":"Pregled modela","render.strip_label":"Traka","render.studio_add_area":"Dodaj površinsko svjetlo","render.studio_ambient":"Konstantna radijancija okruženja","render.studio_ambient_rgb":"Konstantna radijancija okruženja (linearni RGB)","render.studio_aperture":"Polumjer otvora blende","render.studio_area":"Površinsko svjetlo","render.studio_area_help":"Do četiri jednostrana pravokutnika. Ortogonalni polurubovi U i V određuju veličinu; U × V gleda prema osvijetljenoj strani. Koordinate su u svjetskim milimetrima.","render.studio_center":"Središte X, Y, Z (mm)","render.studio_denoise":"Smanji šum na dovršenoj slici","render.studio_denoise_help":"Završni filtar koji čuva rubove; fini detalji mogu omekšati. Staklo i oštre spekularne površine zaobilaze filtar.","render.studio_direction":"Smjer prema suncu (X, Y, Z)","render.studio_environment":"Okruženje","render.studio_environment_bounds":"Rotacija okruženja mora biti konačna unutar ±1.000.000 radijana, a intenzitet između 0 i 100.","render.studio_environment_none":"Nema mape okruženja","render.studio_focus":"Osna udaljenost fokusa","render.studio_half_u":"Polurub U (mm)","render.studio_half_v":"Polurub V (mm)","render.studio_hdr":"Radiance HDR datoteka","render.studio_hdr_browse":"Odaberi HDR…","render.studio_hdr_help":"Radiance .hdr, panorama 2:1, do 2048 × 1024. EXR nije dostupan. Pretpostavka o boji vrijedi samo kad primarne boje nisu navedene.","render.studio_hdr_required":"Odaberite lokalnu .hdr datoteku.","render.studio_hdr_srgb":"Tumači nenavedene primarne boje kao linearni sRGB","render.studio_intensity":"Intenzitet okruženja","render.studio_lens":"Dubinska oštrina","render.studio_lens_perspective":"Dubinska oštrina zahtijeva perspektivnu kameru.","render.studio_lighting":"Studijsko osvjetljenje","render.studio_lighting_enable":"Upotrijebi prilagođeno studijsko osvjetljenje","render.studio_needs_review":"Pregledaj metodu i postavke","render.studio_radiance":"Linearna RGB radijancija","render.studio_ready":"Spremno za provjeru","render.studio_remove_area":"Ukloni površinsko svjetlo","render.studio_rotation":"Rotacija okruženja","render.studio_runtime_help":"Brojčane postavke studija i provjereni HDR izvori mogu se spremiti s postavkom. Optička nadjačavanja i nadjačavanja materijala tijela ostaju privremena i ne mijenjaju spremljene izglede.","render.studio_saved":"Spremljena postavka / trenutna kamera","render.studio_sky":"Umjetničko nebo","render.studio_sky_help":"Izvorni gradijent neba za osvjetljenje; nije kalibrirani model atmosfere.","render.studio_sun":"Sunce","render.studio_sun_radius":"Kutni polumjer","render.studio_tiles_require_gpu":"Studiji zahtijevaju GPU praćenje putanja. Odaberite GPU u uređivaču izlaza.","render.studio_title":"Studio za renderiranje","render.studio_tone_map":"Mapiranje tonova","render.studios_environments":"Studiji i okruženja","render.subsurface_enable":"Nasumični hod unutarnjeg raspršenja","render.subsurface_help":"Samo zatvoreni dielektrik. Raspršenje i RGB apsorpcija zasebni su koeficijenti po mm. Putanje se raspršuju unutar stvarne geometrije, a zatim se lome ili odbijaju na granici. Onemogućite propuštanje pravih sjena, uklanjanje šuma površine i vanjski volumen; upotrijebite jedan Fresnelov sloj. Nije difuzijski shader, mreža gustoće niti izmjereni materijal. Gusti mediji mogu zahtijevati više uzoraka i veću dubinu putanje.","render.subsurface_rate":"Stopa sudara raspršenja","render.tone_aces_fitted":"ACES fitted","render.tone_reinhard":"Reinhard","render.transmission_scope":"GPU staklo podržava potvrđene razdvojene medije. Neograničeni ugniježđeni mediji i procjenitelj propuštanja bez šuma nisu dostupni.","render.transmission_strata":"Uvjetni Fresnelovi slojevi","render.transmission_strata_help":"1 čuva izvorni tok. 2 ili 4 podputanje raslojavaju prvi odabir refleksije ili propuštanja na staklu, uz nepromijenjene Snellove zakone i zakone apsorpcije. Više putanja znači više posla; ovo nije uklanjanje šuma, podrška za ugniježđene medije niti obećanje bržeg renderiranja.","render.tree_add_light":"Dodaj svjetlo","render.tree_add_shot":"Dodaj kadar","render.tree_browser":"Stablo renderiranja","render.tree_by_look":"Po izgledu","render.tree_by_object":"Po objektu","render.tree_constant":"Konstantno okruženje","render.tree_default":"Zadano","render.tree_directional":"Usmjereno","render.tree_environment":"Okruženje","render.tree_environment_values":"{rotation}° · {intensity}×","render.tree_face_count":"Lica: {count}","render.tree_face_one":"{count} lice","render.tree_fixed_studio":"Fiksni studio","render.tree_hdr":"HDR","render.tree_lights":"Svjetla","render.tree_lights_pending":"Naredbe za imenovana svjetla još nisu dostupne.","render.tree_mixed":"Miješano","render.tree_more":"još {count}","render.tree_mute":"Isključi svjetlo","render.tree_no_environment":"Nema okruženja","render.tree_objects":"Objekti","render.tree_output":"Izlaz","render.tree_point":"Točkasto","render.tree_rectangle":"Pravokutnik","render.tree_search":"Pretraži objekte","render.tree_selection":"Renderiraj odabir","render.tree_shots":"Kadrovi","render.tree_sky":"Nebo","render.tree_solo":"Samo ovo svjetlo","render.tree_spot":"Reflektor","render.tree_sun":"Sunce","render.tree_switch":"Prebaci","render.tree_user_one":"{count} objekt","render.tree_users":"Objekata: {count}","render.unavailable_preview":"Ova postavka traži nedostupan profil pregleda.","render.unsaved":"Nespremljene promjene pregleda","render.use_preview":"Upotrijebi integrirani pregled","render.volume_albedo":"Albedo raspršenja · linearni RGB","render.volume_anisotropy":"Srednji kosinus faze","render.volume_enable":"Omogući medij koji sudjeluje","render.volume_extinction":"Koeficijent ekstinkcije","render.volume_help":"GPU prijenos unutar jedne konačne kutije, s Beerovim slabljenjem i HG raspršenjem na putanjama kamere i neizravnim putanjama. Koristi izričito studijsko/HDR/nebesko osvjetljenje, uključujući slabljenje sjena. Pozitivan kosinus faze raspršuje naprijed. Granice stakla i uklanjanje šuma površine moraju se izričito onemogućiti. Nulta ekstinkcija ne mijenja prijenos. Nije fizička lunarna atmosfera, mreža gustoće, volumetrijska emisija, spektralni prijenos niti potvrđeno svojstvo materijala.","render.volume_max":"Maksimalne granice · svjetski mm","render.volume_min":"Minimalne granice · svjetski mm","render.volume_title":"Ograničeni homogeni volumen","render.wait_add_light":"još nije podržano: izrada imenovanih svjetala","render.wait_batch":"još nije podržano: red čekanja za renderiranje spremljenih kadrova","render.wait_compare":"još nije podržano: usporedba zadržanih slika","render.wait_paint":"još nije podržano: odabir proizvoda i bojenje izgledom","render.wait_pick_up":"još nije podržano: odabir proizvoda i preuzimanje izgleda","render.wait_replace":"još nije podržano: zamjena svih upotreba izgleda","render.wait_solo":"još nije podržano: kontrole vidljivosti svjetala i samo jednog svjetla","render.wear_applies_to":"Primjenjuje se na","render.wear_layer_count":"Slojeva: {count}","render.wear_layer_one":"{count} sloj","render.wear_layers":"Slojevi","render.wear_no_layers":"Nema slojeva","render.wear_selected_layer":"Odabrani sloj","render.wear_title":"Habanje","sample.bracket.about":"Osnovna prirubnica s rubnim prirubnicama i porubom prema pravilu od 2 mm","sample.bracket.name":"Limeni nosač","sample.enclosure.about":"Izdubljena kutija s usnom, ispustima za vijke, osloncem i škljocajućim spojem","sample.enclosure.name":"Plastično kućište","sample.flange.about":"Glavčina i prirubnica s kružnim nizom koji pokreće parametar","sample.flange.name":"Prirubnica s vijcima","sample.hinge.about":"Dvije komponente i rotacijski spoj, pokrenut do 60°","sample.hinge.name":"Sklop šarke","sample.plate.about":"Parametarska ploča sa zaobljenjima, provrtima i izbušenim ispustom","sample.plate.name":"Primjer ploče","sample.vents.about":"Utori u pravokutnom nizu: retci, stupci i korak su parametri","sample.vents.name":"Ploča za ventilaciju","search.command_keys":"Enter pokreni     Shift+Enter pokreni i ostavi otvoreno     Esc zatvori","search.commands":"Naredbe","search.design":"U ovom dizajnu","search.feature":"Značajka","search.invalid":"Nije valjano","search.keys":"↑ ↓ odaberi     Enter pokreni     Tab dopuni naziv     Esc zatvori","search.no_match":"Nijedna naredba ne odgovara upitu '{query}'","search.parameter":"Parametar","search.recent":"Nedavno","search.run":"Pokreni naredbu","search.suggest":"Jeste li mislili {label}?","search.try":"Upišite naziv naredbe, značajku u ovom dizajnu ili parametar. Kako biste pokrenuli naredbu s vrijednostima, upišite njezin id i JSON objekt: {example}","search.valid":"Valjano","section.off_hint":"Nije odabrana ravnina: U redu isključuje presjek.","select a direction (an axis, a sketch line or a straight edge) first":"prvo odaberite smjer (os, liniju skice ili ravan brid)","select a direction (an axis, a sketch line or a straight edge) for the profile to follow":"odaberite smjer (os, liniju skice ili ravan brid) po kojem će se profil povlačiti","select a point on a component":"odaberite točku na komponenti","select a profile, edges or sketch lines first":"prvo odaberite profil, bridove ili linije skice","select an axis":"odaberite os","select an axis, a straight or circular edge, or a cylinder, cone or torus face first":"prvo odaberite os, ravan ili kružni brid ili lice valjka, stošca ili torusa","select bodies first":"prvo odaberite tijela","select components first":"najprije odaberite komponente","select corner points, or the two lines of one corner":"odaberite točke kutova ili dvije linije jednog kuta","select one corner point, or the two lines of one corner":"odaberite jednu točku kuta ili dvije linije jednog kuta","select sheet edges first":"prvo odaberite bridove lima","select the bend line (a sketch line) first":"prvo odaberite liniju savijanja (liniju skice)","select the cam's profile (a sketch profile or the cam's edges)":"odaberite profil brijega (profil skice ili bridove brijega)","select the corner to cut first":"prvo odaberite kut koji se reže","select the corners to round first":"prvo odaberite kutove za zaobljenje","select the fixed face first (a plate's large face)":"prvo odaberite fiksno lice (veliko lice ploče)","select the frame sketch's lines first":"prvo odaberite linije skice okvira","select the path (sketch lines across the edge)":"odaberite putanju (linije skice preko brida)","select the rim face first":"prvo odaberite lice oboda","select the sheet edge first":"prvo odaberite brid lima","select two components":"odaberite dvije komponente","set by the sketch's lines":"određeno linijama skice","settings.display_quality_note":"Samo prikaz. Dizajni i izvozi nisu pogođeni.","settings.double_click_components":"Dvaput kliknite komponentu kako biste je aktivirali ili uredili povezanu komponentu na mjestu","settings.frame_rate_details_note":"Dodaje graf vremena posljednjih okvira s brojem iscrtanih trokuta, histogram vremena okvira i što je GPU iscrtao. Kliknite broj okvira u sekundi u prikazu kako biste ih prikazali ili sakrili.","settings.frame_rate_note":"Prikazuje broj okvira u sekundi u donjem desnom kutu prikaza.","settings.insert_lists_open_designs":"Umetni dizajn najprije navodi dizajne otvorene u drugim karticama","settings.measure_axis_distances":"Prikaži udaljenosti X/Y/Z","settings.measure_axis_distances_help":"Prikazuj komponente udaljenosti po svjetskim osima uz ukupnu udaljenost dok je Mjerenje otvoreno.","settings.msaa_applies_on_restart":"Zaglađivanje rubova primjenjuje se pri sljedećem pokretanju SolidCrafta","settings.msaa_reset":"{setting}: {requested}× nije podržano na ovom grafičkom uređaju; sada je {reset}× (podržano: {supported}).","settings.msaa_unsupported":"Nije podržano na ovom grafičkom uređaju","settings.reference_geometry_through_bodies":"Prikaži referentnu geometriju kroz tijela","settings.reference_geometry_through_bodies_help":"Crtaj neaktivne konture skica i referentne ravnine preko osjenčanih tijela","settings.reset_intro":"Ove postavke ne rade na ovom računalu i spriječile bi pokretanje SolidCrafta, pa su promijenjene:","settings.reset_title":"Postavke su promijenjene","settings.supersampling_note":"Iscrtava prikaz u višoj razlučivosti i smanjuje ga filtriranjem: glađi rubovi, linije i mreža na zaslonima ispod 4K. Troši GPU vrijeme: oko 2,25× piksela pri 1,5× i 4× pri 2×.","settings.update_changed_links":"Ažuriraj promijenjene povezane dizajne kad se vratite na karticu","settings.window_system_details":"Pojedinosti","settings.window_system_note_now":"Primjenjuje se nakon ponovnog pokretanja. Sada: {now}.","settings.window_system_wayland_limited":"Neke su funkcije ograničene na izvornom Waylandu.","sheet.flange_type_base":"Osnova","sheet.flange_type_contour":"Kontura","sheet.flange_type_edge":"Brid","sheet.no_body":"nema limenog tijela: izradite ga pomoću Prirubnica > Osnova ili pretvorite ploču u lim pomoću Pretvori u lim (odaberite njezino veliko ravno lice)","sheet.personal_rules.confirm_delete":"Potvrdi brisanje","sheet.personal_rules.delete":"Izbriši","sheet.personal_rules.delete_prompt":"Izbrisati ovo osobno pravilo? Pravila koja su već u dizajnima ostaju nepromijenjena.","sheet.personal_rules.full":"Osobna biblioteka već sadrži 64 pravila.","sheet.personal_rules.invalid_name":"Unesite kratak naziv bez prijeloma redaka ili kontrolnih znakova.","sheet.personal_rules.invalid_values":"Dovršite vrijednosti pravila: svaka se mora moći izračunati u ovom dizajnu, uz pozitivnu debljinu i K-faktor o