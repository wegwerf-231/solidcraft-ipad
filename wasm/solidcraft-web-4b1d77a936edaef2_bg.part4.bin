ardno","ui.start":"Početak","ui.start_over":"Počni ispočetka","ui.start_page":"Početna stranica","ui.step_values":"Mijenjaj vrijednosti tipkama sa strelicama i točkićem","ui.step_values_tip":"U polju vrijednosti u koje upisujete, Gore/Dolje mijenjaju običan broj za 1 (Shift: 10, Alt: 0,1), kao i točkić miša iznad polja. Izrazi ostaju kako su upisani.","ui.stitch_tolerance_hint":"usko","ui.stretch":"Rastegni","ui.supersampling":"Nadsemplovanje (SSAA)","ui.supersampling_adaptive":"Samo kada prikaz miruje","ui.supersampling_off":"Isključeno (1×)","ui.suppress":"Potisni","ui.suppress_auto_snap":"Isključi automatsko privlačenje tokom crtanja / povlačenja","ui.suppress_auto_snap_note":"Podrazumijevano: Ctrl/Cmd ili Alt/Option svaki isključuju privlačenje u skici. Izaberite jednu tipku da to suzite.","ui.sweep":"Povlačenje","ui.sweep_follow_direction":"Prati smjer","ui.sweep_keep_as_drawn":"Zadrži kako je nacrtano","ui.sweep_turn_with_path":"Okreći s putanjom","ui.symmetric":"Simetrično","ui.symmetry":"Simetrija","ui.system":"Sistem","ui.tab_assemble":"Sklopi","ui.tab_manage":"Upravljanje","ui.tab_sheet_metal":"Lim","ui.tab_view":"Prikaz","ui.tab_weldments":"Zavarene konstrukcije","ui.tangent":"Tangentno","ui.taper_angle":"Ugao suženja","ui.tapped":"S navojem","ui.text":"Tekst","ui.theme":"Tema","ui.thickness":"Debljina","ui.thread":"Navoj","ui.tie_ends":"Poveži","ui.tie_ends_tip":"Ograniči sve nepovezane krajeve","ui.timeline_bottom":"Vremenska traka na dnu","ui.timeline_left_note":"Okomita vremenska traka nalazi se lijevo od stabla modela. Nazive operacija uključite ili isključite na traci.","ui.timeline_left_sidebar":"Lijeva bočna traka","ui.tip_angle":"Ugao vrha","ui.to_object":"Do objekta","ui.tool_direction":"Smjer alata","ui.toolbar_tabs_hidden":"Sve kartice trake s alatima su skrivene. Kliknite + ili kliknite desnim dugmetom ovdje da prikažete jednu.","ui.top":"Odozgo","ui.top_diameter":"Gornji prečnik","ui.top_radius":"Gornji poluprečnik","ui.torus":"Torus","ui.to